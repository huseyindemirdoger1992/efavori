{
    "security.workspace.trust.untrustedFiles": "open",
    "claudeCode.preferredLocation": "panel",

    // Dosya Kaydetme
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 3000,

    // Genel Editor
    "editor.wordWrap": "on",
    "editor.fontLigatures": false,
    "editor.fontVariations": false,

    // Git
    "git.enableSmartCommit": true,
    "git.autofetch": true,
    "explorer.confirmDelete": false,

    // ⚡ KRİTİK: Format Ayarları
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnPaste": true,
    "editor.trimAutoWhitespace": true,

    // ⚡ KRİTİK: Dosya Temizleme
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "files.insertFinalNewline": true,

    // ⚡ KRİTİK: Otomatik kayıt sırasında kod düzeltme
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },

    // HTML Formatı (Razor içindeki HTML için ÖNEMLİ)
    "html.format.enable": true,
    "html.format.maxPreserveNewLines": 0, // ⚡ TÜM BOŞ SATIRLARI SİL
    "html.format.indentInnerHtml": true,
    "html.format.wrapAttributes": "auto",
    "html.format.wrapLineLength": 120,
    "html.format.templating": true,
    "html.format.unformatted": null,
    "html.format.contentUnformatted": "pre,code,textarea",
    "html.format.extraLiners": "", // ⚡ Ekstra satır ekleme

    // CSS Formatı
    "css.format.maxPreserveNewLines": 0, // ⚡ CSS'te de boş satır silme

    // JavaScript Formatı
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.formatOnSave": true
    },

    // CSS Dosyaları
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.formatOnSave": true
    },

    // ⚡ RAZOR (.cshtml) - EN ÖNEMLİ BÖLÜM
    "[aspnetcorerazor]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "editor.formatOnType": false,
        "files.trimTrailingWhitespace": true,
        // ⚡ Razor dosyalarında da HTML formatter'ı aktif et
        "html.format.enable": true
    },

    // HTML Dosyaları
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
        "editor.formatOnSave": true
    },

    // ⚡ C# (.cs) Dosyaları
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "files.trimTrailingWhitespace": true
    },

    // C# Formatter Ayarları
    "csharp.format.enable": true,
    "csharp.format.enableEditorConfigSupport": true,

    // OmniSharp (C# Dev Kit)
    "omnisharp.enableEditorConfigSupport": true,
    "omnisharp.enableRoslynAnalyzers": true,

    // ⚡ Razor Formatter (Microsoft.AspNetCore.Razor.VSCode)
    "razor.format.enable": true,
    "razor.format.codeBlockBraceOnNextLine": false,

    // Debugging
    "debug.breakpointsView.presentation": "tree",

    // Ek Yardımcılar
    "editor.rulers": [120],
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active"
}
