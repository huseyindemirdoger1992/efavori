@using api
@using api.tr
@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

<Notification @ref="notificationRef" />

@{
    var roads = new List<(string icon, string Name, string Url)>
                                    {
                                    ("fa fa-globe","efavori", $"/"),
                                    ("fa fa-building","Mağza/İşletme Yönetimi", "javascript:void(0)"),
                                    ("fa fa-plus","Yeni Ekle", "javascript:void(0)")
                                    };
}
<razor._Shared.BreadCrumbLinksUrl roads=roads />

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}

@if (Users is not null)
{

}

<div class="col-md-4 mb-3">
    <label class="form-label text-white"><i class="fa fa-globe"></i> Ülkeniz</label>
    <select class="form-select bg-transparent text-white border-light-3" @onchange="OnCountrySelected">
        <option value="0">Ülke Seçiniz</option>
        @foreach (var country in _Countries)
        {
            <option value="@country.id">@country.name</option>
        }
    </select>
</div>
<div class="col-md-4 mb-3">
    <label class="form-label text-white"><i class="fa fa-map"></i> Eyalet/İl</label>
    <select class="form-select bg-transparent text-white border-light-3" @onchange="OnStateSelected" disabled="@(!_States.Any())">
        <option value="0">@(_States.Any() ? "İl Seçiniz" : "---")</option>
        @foreach (var state in _States)
        {
            <option value="@state.id">@state.name</option>
        }
    </select>
</div>
<div class="col-md-4 mb-3">
    <label class="form-label text-white"><i class="fa fa-building-o"></i> Şehir</label>
    <select class="form-select bg-transparent text-white border-light-3" disabled="@(!_Cities.Any())">
        <option value="0">@(_Cities.Any() ? "Şehir Seçiniz" : "---")</option>
        @foreach (var city in _Cities)
        {
            <option value="@city.id">@city.name</option>
        }
    </select>
</div>

@code {

    private const string PAGE = "DataManager";

    [Parameter] public Users? use { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;

    private bool _isLoading;
    private CancellationTokenSource? _searchCts;

    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _isProcessing;

    private List<Users>? Users { get; set; } = new();

    private List<Country> _Countries = new();
    private List<States> _States = new();
    private List<Cities> _Cities = new();

    private Notification? notificationRef;

    protected async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int countryId);
        _States.Clear();
        _Cities.Clear();

        if (countryId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _States = await db.States.AsNoTracking()
                .Where(s => s.country_id == countryId)
                .OrderBy(s => s.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int stateId);
        _Cities.Clear();

        if (stateId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _Cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == stateId)
                .OrderBy(c => c.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;

        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;

        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleGlobalDataChange;

        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;

        var shouldRefresh = entityName == "Users";

        if (shouldRefresh)
        {
            await InvokeAsync(async () =>
            {
                await LoadData(null);
                StateHasChanged();
            });
        }
    }

    protected virtual async Task LoadData(string? search)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(1000, token);

            if (_isLoading) return;
            _isLoading = true;
            using var db = await DbFactory.CreateDbContextAsync();
            _Countries = await db.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync();
            StateHasChanged();

            var result = await StateHub.GetOrLoadAsync("DataManager_Main", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query = db.Users.AsNoTracking().Where(u => u.IsActive == true);

                if (!string.IsNullOrWhiteSpace(search))
                {
                    query = query.Where(u =>
                        u.FirstName.Contains(search) ||
                        u.LastName.Contains(search));
                }

                var users = await query
                    .OrderByDescending(u => u.RegistrationDate)
                    .ToListAsync(token);

                return new { Users = users };

            }, token);

            if (result != null && !token.IsCancellationRequested)
                Users = result.Users;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    protected async Task AddUser(Users newUser)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            newUser.RegistrationDate = DateTime.UtcNow;
            db.Users.Add(newUser);
            await db.SaveChangesAsync(_cts.Token);

            await StateHub.NotifyDataChanged("Users");

            await Logger.TakeIt(newUser.Id, PAGE, "AddUser");

            await ShowNotification("success", "Başarılı", "Kullanıcı başarıyla eklendi.", null);
            await JS.InvokeVoidAsync("eval", $"$('#Modal_{null}').modal('hide')");
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "AddUser",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Kullanıcı eklenirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    protected async Task UpdateUser(Users updatedUser)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            db.Users.Update(updatedUser);
            await db.SaveChangesAsync(_cts.Token);

            await StateHub.NotifyDataChanged("Users");

            await Logger.TakeIt(updatedUser.Id, PAGE, "UpdateUser");

            await ShowNotification("success", "Başarılı", "Kullanıcı başarıyla güncellendi.", null);
            await JS.InvokeVoidAsync("eval", $"$('#Modal_{null}').modal('hide')");
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "UpdateUser",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Kullanıcı güncellenirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    protected async Task DeleteUser(int userId)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var user = await db.Users.FindAsync(new object[] { userId }, _cts.Token);
            if (user != null)
            {
                db.Users.Remove(user);
                await db.SaveChangesAsync(_cts.Token);

                await StateHub.NotifyDataChanged("Users");

                await Logger.TakeIt(use?.Id, PAGE, "DeleteUser");

                await ShowNotification("success", "Başarılı", "Kullanıcı başarıyla silindi.", null);
                await JS.InvokeVoidAsync("eval", $"$('#Modal_{null}').modal('hide')");
            }
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "DeleteUser",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Kullanıcı silinirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    protected async Task BulkImport(List<Users> users)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var now = DateTime.UtcNow;
            foreach (var user in users)
                user.RegistrationDate = now;

            db.Users.AddRange(users);
            await db.SaveChangesAsync(_cts.Token);

            await StateHub.NotifyDataChanged("Users");

            await Logger.TakeIt(use?.Id, PAGE, $"BulkImport ({users.Count} kayıt)");

            await ShowNotification("success", "Başarılı", $"{users.Count} kayıt başarıyla içe aktarıldı.", null);
            await JS.InvokeVoidAsync("eval", $"$('#Modal_{null}').modal('hide')");
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "BulkImport",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Toplu içe aktarma sırasında bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    public async Task CopyText(string textInfo)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            if (string.IsNullOrEmpty(textInfo))
            {
                await ShowNotification("warning", "Uyarı", "Kopyalanacak içerik bulunamadı.", null);
            }
            else
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", textInfo);
                await ShowNotification("success", "Başarılı", "İçerik başarıyla kopyalandı.", null);
            }
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "CopyText",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", $"Kopyalama işlemi başarısız: {ex.Message}", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
}
