@code {
    [Parameter]
    public List<(string icon, string Name, string Url)> roads { get; set; } = new();
}
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                @if (roads != null)
                {
                    @foreach (var item in roads)
                    {
                        // Listenin son elemanı olup olmadığını kontrol edelim
                        bool isLast = (item == roads.LastOrDefault());

                        <li class="breadcrumb-item @(isLast ? "active" : "")" aria-current="@(isLast ? "page" : "")">
                            @if (isLast)
                            {
                                <a href="javascript:void(0)">
                                    <i class="@item.icon"></i>
                                    @item.Name
                                </a>
                            }
                            else
                            {
                                <a href="@item.Url">
                                    <i class="@item.icon"></i>
                                    @item.Name
                                </a>
                            }
                        </li>
                    }
                }
            </ol>
        </nav>
    </div>
</div>