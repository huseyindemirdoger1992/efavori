@using data
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@code {
    [Parameter] public Users? use { get; set; }

    private _ApplicationConnectionDb? db;
    private string MenuSelected = "Customer";
    private bool _isUpdating = false;

    protected override async Task OnInitializedAsync()
    {
        db = await DbFactory.CreateDbContextAsync();
    }

    protected override void OnParametersSet()
    {
        if (use != null && !_isUpdating)
        {
            MenuSelected = use.HeaderMenuType ?? "Customer";
        }
    }

    private async Task MenuTravel(string value)
    {
        if (use == null || _isUpdating) return;
        if (MenuSelected == value) return;

        try
        {
            _isUpdating = true;
            MenuSelected = value;
            use.HeaderMenuType = value;

            // Önce UI'ı bir kere tetikleyelim ki donma hissi olmasın
            StateHasChanged();

            // Mevcut 'db' değişkenini kullanmak yerine yeni bir context oluşturuyoruz
            using var context = await DbFactory.CreateDbContextAsync();

            // Mevcut 'use' nesnesini bu yeni context'e tanıtıyoruz
            context.Entry(use).State = EntityState.Modified;

            await context.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            // Loglama için de yeni bir context kullanmak en güvenlisi
            await LogError(ex);
        }
        finally
        {
            _isUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LogError(Exception ex)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var lg = new Logs
            {
                Title = "Header Menu Hatası",
                Date = DateTime.Now,
                Exception = ex.Message
            };
            context.Logs.Add(lg);
            await context.SaveChangesAsync();
        }
        catch { /* Log hatası uygulamayı durdurmasın */ }
    }

    public async ValueTask DisposeAsync() => await (db?.DisposeAsync() ?? ValueTask.CompletedTask);
}

