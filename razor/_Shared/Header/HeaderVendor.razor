</style>

<script>
    function toggleWinMenu() {
        const bar = document.getElementById('winMenuBar');
        const overlay = document.getElementById('winOverlay');
        const icon = document.getElementById('winIcon');

        if (bar && window.innerWidth < 992) {
            const isActive = bar.classList.toggle('active');
            overlay.classList.toggle('active');

            if (isActive) {
                icon.className = 'bx bx-chevron-down';
                document.body.style.overflow = 'hidden'; // Arka plan kaymasın
            } else {
                icon.className = 'bx bx-chevron-up';
                document.body.style.overflow = '';
            }
        }
    }
</script>

