            height: 5px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
            margin-bottom: 8px;
            transition: 0.3s;
        }
        /* Menü İçeriği Animasyonu */
        .windows-menu {
            flex-direction: column;
            padding: 20px;
            gap: 12px;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.4s ease 0.1s; /* Gecikmeli içerik animasyonu */
            pointer-events: none;
        }

        .windows-menu-bar.active .windows-menu {
            opacity: 1;
            transform: translateY(0);
            pointer-events: all;
        }

        .windows-menu li a {
            padding: 15px 20px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.05);
