<style>
    /* ===== MASAÜSTÜ TEMEL YAPI ===== */
    .windows-menu-bar {
        position: sticky;
        top: 60px;
        left: 0;
        right: 0;
        z-index: 1;
        background: rgba(255, 255, 255, 0.1);
