    }

        .windows-menu li a {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            opacity: 0.8;
            transition: 0.3s;
        }

    /* ===== MOBİL ÖZEL (Cam Efekti ve Akıcı Animasyon) ===== */
    @@media (max-width: 991px) {
        .windows-menu-bar {
            position: fixed;
            top: auto;
            bottom: 0;
            left: 0 !important;
            right: 0;
            margin-left: 0 !important;
            background: rgba(20, 20, 20, 0.7); /* Şeffaf koyu zemin */
            backdrop-filter: blur(25px) saturate(180%); /* Cam efekti derinliği */
            -webkit-backdrop-filter: blur(25px) saturate(180%);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 25px 25px 0 0;
            height: 60px; /* Kapalıyken yükseklik */
            padding: 0;
            overflow: hidden;
            box-shadow: 0 -10px 40px rgba(0,0,0,0.4);
            z-index: 2000;
            /* Açılış animasyonu için transition */
            transition: height 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.1), background 0.5s ease;
        }
            /* Menü Aktifken */
            .windows-menu-bar.active {
                height: 75vh; /* Ekranın %75'ini kaplar */
                background: rgba(30, 30, 30, 0.85);
                overflow-y: auto;
