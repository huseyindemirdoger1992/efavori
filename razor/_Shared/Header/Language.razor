@using Microsoft.AspNetCore.Components.Web
@using data
@inject NavigationManager NavManager

@rendermode InteractiveServer

@code {
    [Parameter]
    public Users? _use { get; set; }

    // Mevcut dili belirle (kullanıcı veya URL'den)
    private string CurrentLanguage => _use?.Language ?? GetCurrentCultureFromUrl();

    // URL'den mevcut dil kodunu al
    private string GetCurrentCultureFromUrl()
    {
        var uri = new Uri(NavManager.Uri);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length > 0)
        {
            var firstSegment = segments[0].ToLower();
            if (new[] { "tr", "az", "de", "en", "es", "fr", "hi", "pt", "ru", "zh" }.Contains(firstSegment))
            {
                return firstSegment;
            }
        }
        return "en"; // Varsayılan
    }

    // Dil koduna göre bayrak ikonunu seç
    private string FlagPath => CurrentLanguage switch
    {
        "az" => "az.svg",
        "de" => "de.svg",
        "en" => "gb.svg",
        "es" => "es.svg",
        "fr" => "fr.svg",
        "hi" => "in.svg",
        "pt" => "pt.svg",
        "ru" => "ru.svg",
        "zh" => "cn.svg",
        _ => "tr.svg"
    };

    private async Task SelectLanguage(string langCode)
    {
        if (_use != null)
        {
            try
            {
                // 1. Veritabanında güncelleme yap
                using var db = new _ApplicationConnectionDb();
                _use.Language = langCode;
                db.Users.Update(_use);
                await db.SaveChangesAsync();

                // 2. Sayfayı tamamen yenileyerek değişiklikleri her yerde uygula
                // NavManager.Uri mevcut adresi verir, forceLoad: true ise F5 etkisi yaratır.
                NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
            }
            catch (Exception ex)
            {
                Logs logs = new Logs();
                logs.Title = "Dil değiştirmehatası";
                logs.Exception = ex.Message;
                logs.Date = DateTime.Now;
                using var db = new _ApplicationConnectionDb();
                db.Logs.Add(logs);
                await db.SaveChangesAsync();
            }
        }
    }

    // Oturum açmamış kullanıcılar için URL tabanlı dil değiştirme
    private void ChangeLanguageByUrl(string langCode)
    {
        var uri = new Uri(NavManager.Uri);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();

        // İlk segment bir dil kodu mu kontrol et
        var supportedCultures = new[] { "tr", "az", "de", "en", "es", "fr", "hi", "pt", "ru", "zh" };
        if (segments.Count > 0 && supportedCultures.Contains(segments[0].ToLower()))
        {
            segments[0] = langCode; // Mevcut dil kodunu değiştir
        }
        else
        {
            segments.Insert(0, langCode); // Dil kodu yoksa ekle
        }

        var newPath = "/" + string.Join("/", segments) + uri.Query;
        NavManager.NavigateTo(newPath, forceLoad: true);
    }
}
@if (_use != null)
{
    <li class="nav-item dropdown dropdown-laungauge d-sm-flex">
        <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="javascript:void(0)" data-bs-toggle="dropdown" aria-expanded="false">
