@using api
@implements IDisposable
@inject VisitorService ZiyaretciTakipci

@ZiyaretciTakipci.AktifSayisi

@code {
    private string _myId = Guid.NewGuid().ToString();
    private bool _isOnline = true;
    private CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        // İlk giriş sinyali
        ZiyaretciTakipci.SinyalVer(_myId);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Arka plan döngüsünü başlat
            _ = KalpAtisiDongusu();
        }
    }

    private async Task KalpAtisiDongusu()
    {
        try
        {
            while (!_cts.Token.IsCancellationRequested)
            {
                // Sunucuya "hala buradayım" sinyali gönder
                ZiyaretciTakipci.SinyalVer(_myId);

                // Arayüzü güncelle (AktifSayisi değişmiş olabilir)
                await InvokeAsync(StateHasChanged);

                // 2 saniye bekle
                await Task.Delay(2000, _cts.Token);
            }
        }
        catch (TaskCanceledException)
        {
            // Sayfa kapandı, normal bir durum
        }
    }

    public void Dispose()
    {
        // Döngüyü durdur
        _cts.Cancel();
        _cts.Dispose();

        // Listeden hemen sil (Temizlik döngüsünü bekleme)
        ZiyaretciTakipci.Ayrildi(_myId);
    }
}