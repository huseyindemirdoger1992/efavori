@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@code {
    [Parameter] public object? use { get; set; }

    [Parameter] public string? Type { get; set; } = "info";
    [Parameter] public string? Title { get; set; } = "SİSTEM";
    [Parameter] public string? Text { get; set; } = "İşlem başarıyla tamamlandı.";
    [Parameter] public string? ImageUrl { get; set; } = "https://picsum.photos/120";

    public async Task Launch(string? type = null, string? title = null, string? text = null, string? image = null)
    {
        await JSRuntime.InvokeVoidAsync("dxtrV2_Notify",
            title ?? Title,
            text ?? Text,
            image ?? ImageUrl,
            type ?? Type);
    }
}

@*
   NOT: Host elementi BURADA render edilmiyor — JS tarafında document.body'ye
   eklenmektedir. Sebep: Blazor render ağacındaki herhangi bir ata element
   transform/filter/backdrop-filter/perspective/will-change/contain/isolation
   veya position+z-index taşıdığı anda YENİ STACKING CONTEXT oluşturur ve
   içerideki host'un z-index'i ne kadar büyük olursa olsun, o context'in
   dışına çıkamaz. Bootstrap modal'ı body'nin direkt çocuğu olduğu için
   ata context'inin ÜZERİNE biner. Çözüm: host'u DOM portal pattern ile
   doğrudan body'nin çocuğu yapmak.
*@

<style>
    /* ═══════════════════════════════════════════
           DXTR V3 · ULTRA — Notification System
           Blazor-safe · Modal-proof · Responsive
        ═══════════════════════════════════════════ */

    #dxtr-v3-toaster-host {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        /* Bootstrap modal z-index: 1055 / modal-backdrop: 1050.
               Tooltip/popover: 1080-1090. Bunların hepsinin üstünde olmalı. */
        z-index: 2147483647;
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 400px;
        max-width: calc(100vw - 3rem);
        pointer-events: none;
        /* Host body'nin direkt çocuğu olduğundan artık isolation/contain
               gerekmez — kaldırıldı (kendisi de stacking context yaratıyordu;
               sorun değildi ama ihtiyaç da yok). */
    }

    /* Tablet */
    @@media (max-width: 768px) and (min-width: 481px) {
        #dxtr-v3-toaster-host {
            top: 1rem;
            right: 1rem;
            width: 360px;
        }
    }

    /* Mobil — ekranın tam ortası */
    @@media (max-width: 480px) {
        #dxtr-v3-toaster-host {
            top: 50% !important;
            left: 50% !important;
            right: auto !important;
            bottom: auto !important;
            transform: translate(-50%, -50%) !important;
            width: calc(100vw - 2.5rem);
            max-width: 360px;
            align-items: center;
        }
    }

    /* ── Kart ── */
    .dxtr-v3-toast-node {
        pointer-events: auto;
        position: relative;
        width: 100%;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
        color: #fff;
        /* Transparan cam efekti */
        background: rgba(5, 5, 9, 0.28);
        backdrop-filter: blur(12px) saturate(1.8) brightness(1.05);
        -webkit-backdrop-filter: blur(12px) saturate(1.8) brightness(1.05);
        /* Giriş başlangıcı */
        opacity: 0;
        transform: perspective(1000px) rotateX(-12deg) translateY(-20px) scale(0.94);
        transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.55s ease;
    }

        /* Üst ince parlama şeridi */
        .dxtr-v3-toast-node::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1.5px;
            opacity: 0.85;
        }

        /* Alt yansıma ışıması */
        .dxtr-v3-toast-node::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 15%;
            right: 15%;
            height: 1px;
            opacity: 0.35;
        }

        /* ── info ── */
        .dxtr-v3-toast-node.info {
            border: 1px solid rgba(0, 229, 255, 0.2);
            box-shadow: 0 8px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(0,229,255,0.05) inset;
        }

            .dxtr-v3-toast-node.info::before {
                background: linear-gradient(90deg, transparent, #00e5ff 50%, transparent);
            }

            .dxtr-v3-toast-node.info::after {
                background: linear-gradient(90deg, transparent, #00e5ff, transparent);
            }

            .dxtr-v3-toast-node.info.v3-active {
                box-shadow: 0 12px 56px rgba(0,0,0,0.8), 0 0 40px rgba(0,229,255,0.06);
            }

        /* ── success ── */
        .dxtr-v3-toast-node.success {
            border: 1px solid rgba(0, 255, 136, 0.2);
            box-shadow: 0 8px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(0,255,136,0.05) inset;
        }

            .dxtr-v3-toast-node.success::before {
                background: linear-gradient(90deg, transparent, #00ff88 50%, transparent);
            }

            .dxtr-v3-toast-node.success::after {
                background: linear-gradient(90deg, transparent, #00ff88, transparent);
            }

            .dxtr-v3-toast-node.success.v3-active {
                box-shadow: 0 12px 56px rgba(0,0,0,0.8), 0 0 40px rgba(0,255,136,0.06);
            }

        /* ── warning ── */
        .dxtr-v3-toast-node.warning {
            border: 1px solid rgba(255, 204, 0, 0.2);
            box-shadow: 0 8px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,204,0,0.05) inset;
        }

            .dxtr-v3-toast-node.warning::before {
                background: linear-gradient(90deg, transparent, #ffcc00 50%, transparent);
            }

            .dxtr-v3-toast-node.warning::after {
                background: linear-gradient(90deg, transparent, #ffcc00, transparent);
            }

            .dxtr-v3-toast-node.warning.v3-active {
                box-shadow: 0 12px 56px rgba(0,0,0,0.8), 0 0 40px rgba(255,204,0,0.06);
            }

        /* ── danger ── */
        .dxtr-v3-toast-node.danger {
            border: 1px solid rgba(255, 68, 102, 0.2);
            box-shadow: 0 8px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,68,102,0.05) inset;
        }

            .dxtr-v3-toast-node.danger::before {
                background: linear-gradient(90deg, transparent, #ff4466 50%, transparent);
            }

            .dxtr-v3-toast-node.danger::after {
                background: linear-gradient(90deg, transparent, #ff4466, transparent);
            }

            .dxtr-v3-toast-node.danger.v3-active {
                box-shadow: 0 12px 56px rgba(0,0,0,0.8), 0 0 40px rgba(255,68,102,0.06);
            }

        /* Aktif */
        .dxtr-v3-toast-node.v3-active {
            opacity: 1;
            transform: perspective(1000px) rotateX(0deg) translateY(0) scale(1);
        }

        /* Çıkış */
        .dxtr-v3-toast-node.v3-exit {
            opacity: 0 !important;
            transform: scale(0.84) translateX(28px);
            filter: blur(6px);
            pointer-events: none;
            transition: opacity 0.38s ease, transform 0.38s ease, filter 0.38s ease;
        }

    /* Mobil: 3D yok, sade scale */
    @@media (max-width: 480px) {
        .dxtr-v3-toast-node {
            transform: scale(0.88);
        }

            .dxtr-v3-toast-node.v3-active {
                transform: scale(1);
            }

            .dxtr-v3-toast-node.v3-exit {
                transform: scale(0.84);
            }
    }

    /* ── Scan-line hologram efekti ── */
    .dxtr-v3-scan {
        position: absolute;
        inset: 0;
        border-radius: 20px;
        pointer-events: none;
        overflow: hidden;
    }

        .dxtr-v3-scan::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 35%;
            top: -35%;
            background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.022), transparent);
            animation: dxtr-v3-scanline 3.5s linear infinite;
        }

    @@keyframes dxtr-v3-scanline {
        to {
            top: 135%;
        }
    }

    /* ── İkon kutusu ── */
    .dxtr-v3-media {
        flex-shrink: 0;
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .dxtr-v3-media::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            border: 1px solid rgba(255,255,255,0.07);
        }

    .info .dxtr-v3-media {
        background: rgba(0, 229, 255, 0.09);
    }

    .success .dxtr-v3-media {
        background: rgba(0, 255, 136, 0.09);
    }

    .warning .dxtr-v3-media {
        background: rgba(255, 204, 0, 0.09);
    }

    .danger .dxtr-v3-media {
        background: rgba(255, 68, 102, 0.09);
    }

    .dxtr-v3-media svg {
        width: 26px;
        height: 26px;
    }

    .info .dxtr-v3-media svg {
        stroke: #00e5ff;
    }

    .success .dxtr-v3-media svg {
        stroke: #00ff88;
    }

    .warning .dxtr-v3-media svg {
        stroke: #ffcc00;
    }

    .danger .dxtr-v3-media svg {
        stroke: #ff4466;
    }

    /* ── İçerik ── */
    .dxtr-v3-content {
        flex: 1;
        padding-right: 25px;
        text-align: left;
        min-width: 0;
    }

    /* Başlık */
    .dxtr-v3-title {
        display: block;
        font-weight: 800;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 2px;
        opacity: 0.95;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: rgba(255,255,255,0.95);
    }

    .info .dxtr-v3-title {
        color: #00e5ff;
    }

    .success .dxtr-v3-title {
        color: #00ff88;
    }

    .warning .dxtr-v3-title {
        color: #ffcc00;
    }

    .danger .dxtr-v3-title {
        color: #ff4466;
    }

    /* Açıklama */
    .dxtr-v3-desc {
        font-size: 0.88rem;
        color: #ffffff;
        line-height: 1.3;
        margin: 0;
        font-weight: 400;
    }

    /* ── Kapat butonu ── */
    .dxtr-v3-close {
        background: transparent;
        border: none;
        color: rgba(255,255,255,0.5);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.4rem;
        position: absolute;
        top: 8px;
        right: 8px;
        transition: all 0.2s;
        line-height: 1;
    }

        .dxtr-v3-close:hover {
            color: #fff;
            background: rgba(255,255,255,0.1);
        }

    /* ── Progress bar ── */
    .dxtr-v3-timer-wrapper {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: rgba(255,255,255,0.03);
    }

    .dxtr-v3-timer-bar {
        height: 100%;
        width: 100%;
        transform-origin: left;
        transform: scaleX(1);
        transition: transform 4200ms linear;
    }

    .info .dxtr-v3-timer-bar {
        background: #00e5ff;
        box-shadow: 0 0 8px #00e5ff;
    }

    .success .dxtr-v3-timer-bar {
        background: #00ff88;
        box-shadow: 0 0 8px #00ff88;
    }

    .warning .dxtr-v3-timer-bar {
        background: #ffcc00;
        box-shadow: 0 0 8px #ffcc00;
    }

    .danger .dxtr-v3-timer-bar {
        background: #ff4466;
        box-shadow: 0 0 8px #ff4466;
    }
</style>


<script>
    (function () {
        if (window.__dxtrV3Loaded) return;
        window.__dxtrV3Loaded = true;

        var ICONS = {
            info: '<svg viewBox="0 0 24 24" fill="none" stroke="#00e5ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
            success: '<svg viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
            warning: '<svg viewBox="0 0 24 24" fill="none" stroke="#ffcc00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
            danger: '<svg viewBox="0 0 24 24" fill="none" stroke="#ff4466" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>'
        };

        // ═══════════════════════════════════════════
        // HOST'U body'NİN DİREKT ÇOCUĞU YAP (DOM PORTAL)
        // ───────────────────────────────────────────
        // Host nerede render edilirse edilsin, modal'ın üstünde durabilmesi
        // için DOM ağacında body'nin direkt çocuğu OLMAK ZORUNDA. Aksi halde
        // herhangi bir ata transform/filter/contain ile stacking context
        // yaratırsa z-index hapsedilir ve modal (body altı) üste biner.
        // ═══════════════════════════════════════════
        function ensureHost() {
            var host = document.getElementById('dxtr-v3-toaster-host');
            if (!host) {
                host = document.createElement('div');
                host.id = 'dxtr-v3-toaster-host';
                document.body.appendChild(host);
            } else if (host.parentElement !== document.body) {
                // Razor herhangi bir nedenle host'u tekrar render etmişse,
                // body altına geri taşı.
                document.body.appendChild(host);
            }
            return host;
        }

        // İlk kez DOM hazırsa hemen, değilse hazırlanınca host'u kur
        if (document.body) {
            ensureHost();
        } else {
            document.addEventListener('DOMContentLoaded', ensureHost, { once: true });
        }

        window.dxtrV2_Notify = function (title, msg, _img, type) {
            var status = type || 'info';
            var host = ensureHost();
            if (!host) return;

            var toast = document.createElement('div');
            toast.className = 'dxtr-v3-toast-node ' + status;
            toast.innerHTML = `
                <div class="dxtr-v3-media">${ICONS[status]}</div>
                <div class="dxtr-v3-content">
                    <span class="dxtr-v3-title">${title}</span>
                    <p class="dxtr-v3-desc">${msg}</p>
                </div>
                <button class="dxtr-v3-close">&times;</button>
                <div class="dxtr-v3-timer-wrapper"><div class="dxtr-v3-timer-bar"></div></div>
            `;

            // YENİ GELENİ ÜSTE EKLE (Eskiler aşağı kayar)
            host.prepend(toast);

            var autoTimer;
            function dismiss() {
                if (!toast.parentElement) return;
                toast.classList.remove('v3-active');
                toast.classList.add('v3-exit');
                setTimeout(() => { if (toast.parentElement) toast.remove(); }, 500);
            }

            toast.querySelector('.dxtr-v3-close').onclick = dismiss;

            // Animasyonu başlat
            requestAnimationFrame(() => {
                setTimeout(() => {
                    toast.classList.add('v3-active');
                    var bar = toast.querySelector('.dxtr-v3-timer-bar');
                    if (bar) bar.style.transform = 'scaleX(0)';
                }, 10);
            });

            autoTimer = setTimeout(dismiss, 4000);

            // Hover kontrolü
            toast.onmouseenter = () => {
                clearTimeout(autoTimer);
                var bar = toast.querySelector('.dxtr-v3-timer-bar');
                if (bar) {
                    bar.style.transition = 'none';
                    bar.style.transform = window.getComputedStyle(bar).transform;
                }
            };

            toast.onmouseleave = () => {
                var bar = toast.querySelector('.dxtr-v3-timer-bar');
                if (bar) {
                    bar.style.transition = 'transform 1000ms linear';
                    bar.style.transform = 'scaleX(0)';
                }
                autoTimer = setTimeout(dismiss, 1000);
            };
        };
    })();
</script>
