@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using api.tr
@using razor._Shared
@implements IAsyncDisposable

<div class="container-fluid p-3">

    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h3 class="mb-2">
                    <i class="fa fa-tasks"></i> Yazılım Görev Panosu
                </h3>
                @if (use?.UsersType == "Admin" || use?.UsersType == "Employee")
                {
                    <button class="btn btn-primary btn-sm" @onclick="() => ShowAddTaskModal()" disabled="@IsButtonProcessing("add")">
                        <i class="fa fa-plus"></i> Yeni Görev
                    </button>
                }
                else
                {
                    <button class="btn btn-secondary btn-sm" disabled>
                        <i class="fa fa-plus"></i> Yeni Görev
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 row-cols-1 row-cols-md-3 row-cols-lg-5">

        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0"><i class="fa fa-plus-circle"></i> Yeni (@GetTaskCountByStatus("NewTasks"))</h6>
                </div>
                <div class="card-body p-2 kanban-column bg-primary bg-opacity-10 text-dark"
                     @ondrop="@(() => HandleDrop("NewTasks"))"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true">
                    @foreach (var task in GetTasksByStatus("NewTasks"))
                    {
                        <div class="task-card mb-2 bg-danger bg-opacity-25"
                             draggable="true"
                             @ondragstart="@(() => HandleDragStart(task.Id))"
                             @onclick="@(() => ShowTaskDetail(task))">
                            <h6 class="text-light">@(task.TaskTitle ?? "Başlıksız Görev")</h6>

                            @if (!string.IsNullOrWhiteSpace(task.TaskDescription))
                            {
                                <p class="small text-light mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @task.TaskDescription
                                </p>
                            }
                            <hr class="text-light" />
                            <div class="mb-2">
                                <span class="badge @GetPriorityBadgeClass(task.Priority) priority-badge" style="width: 100%;">@(task.Priority ?? "Orta")</span>
                            </div>
                            <hr class="text-warning" />
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-light bg-danger badge" style="width: 100%;">
                                    <i class="fa fa-calendar me-1"></i>
                                    Başlangıç:
                                    @(task.DateCreatedAt.ToString("dd.MM.yyyy") ?? "-")
                                </small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-light bg-success badge" style="width: 100%;">
                                    <i class="fa fa-calendar me-1"></i>
                                    Bitiş:
                                    @(task.TargetDate?.ToString("dd.MM.yyyy") ?? "-")
                                </small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-warning bg-light badge" style="width: 100%;">
                                    <i class="fa fa-clock-o me-1"></i>
                                    Kalan:
                                    <span id="timer-@(task.Id)" data-target="@task.TargetDate?.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        -
                                    </span>
                                </small>
                            </div>
                            <hr class="text-info" />
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-light" style="width: 100%;">
                                    <i class="fa fa-user me-1"></i>
                                    @{
                                        var userName = GetUserName(task.PersonInChargeUserId);
                                        userName = string.IsNullOrWhiteSpace(userName) ? "Atanmamış" : userName;
                                    }
                                    <span class="text-light">@userName</span>
                                </small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

