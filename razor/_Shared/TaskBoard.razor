<!-- Add/Edit Task Modal -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingTask?.Id == Guid.Empty ? "Yeni Görev" : "Görevi Düzenle")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Görev Başlığı</label>
                        <input type="text" class="form-control" @bind="editingTask.TaskTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="3" @bind="editingTask.TaskDescription"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Öncelik</label>
                            <select class="form-select" @bind="editingTask.Priority">
                                <option value="Düşük">Düşük</option>
                                <option value="Orta">Orta</option>
                                <option value="Yüksek">Yüksek</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hedef Tarih</label>
                            <input type="date" class="form-control" @bind="editingTask.TargetDate" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sorumlu Kişi</label>
                        <select class="form-select" @bind="selectedPersonInCharge">
                            <option value="">Seçiniz...</option>

                            @foreach (var user in adminUsers)
                            {
                                <option value="@user.Id">@user.FirstName @user.LastName</option>
                            }

                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveTask" disabled="@IsButtonProcessing("save")">
                        @if (IsButtonProcessing("save"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Task Detail Modal -->
@if (showDetailModal && selectedTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@selectedTask.TaskTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetailModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Durum:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetStatusText(selectedTask.Status)
                            </span>
                        </div>
                        <div class="col-md-6">
                            <strong>Öncelik:</strong>
                            <span class="badge @GetPriorityBadgeClass(selectedTask.Priority)">
                                @selectedTask.Priority
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>Açıklama:</strong>
                        <textarea class="form-control bg-light" rows="3" disabled>@(selectedTask.TaskDescription ?? "Açıklama yok")</textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Oluşturulma:</strong>
                            <p>@selectedTask.DateCreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Hedef Tarih:</strong>
                            <p>@(selectedTask.TargetDate?.ToString("dd.MM.yyyy") ?? "-")</p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>Sorumlu Kişi:</strong>
                        <p>@GetUserName(selectedTask.PersonInChargeUserId)</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Yeni Not Ekle:</strong></label>
                        @if (use?.UsersType == "Admin" || use?.UsersType == "Employee")
                        {
                            <textarea class="form-control" rows="2" @bind="newNote"></textarea>
                        }
                        else
                        {
                            <textarea class="form-control" rows="2" disabled></textarea>
                        }
                    </div>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            @onclick="AddNote"
                            disabled="@IsButtonProcessing("addNote")"
                            style="width: 100%;">

                        @if (IsButtonProcessing("addNote"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="fa fa-comments"></i>
                        }
                        Not Ekle
                    </button>
                    <hr class="my-3" />
                    @if (taskNotes != null && taskNotes.Any())
                    {
                        <div class="mb-3">
                            <strong>Notlar:</strong>
                            <div class="mt-2" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var note in taskNotes.OrderByDescending(n => n.NoteCreatedAt))
                                {
                                    <div class="alert alert-light p-2 mb-2">
                                        <small class="text-light">@note.NoteCreatedAt?.ToString("dd.MM.yyyy HH:mm")</small>
                                        <p class="mb-0 mt-1 text-warning">@note.Note</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailModal">Kapat</button>
                    @if (use?.UsersType == "Admin" || use?.UsersType == "Employee")
                    {
                        <button type="button" class="btn btn-warning" @onclick="() => EditTask(selectedTask)">
                            <i class="fa fa-edit"></i> Düzenle
                        </button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteTask" disabled="@IsButtonProcessing("delete")">
                            @if (IsButtonProcessing("delete"))
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="fa fa-trash"></i> Sil
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" disabled>
                            Not Ekle
                        </button>
                        <button type="button" class="btn btn-warning" disabled>
                            <i class="fa fa-edit"></i> Düzenle
                        </button>
                        <button type="button" class="btn btn-danger" disabled>
                            <i class="fa fa-trash"></i> Sil
                        </button>
                    }

                </div>
            </div>
        </div>
    </div>
}


<Notification @ref="notificationRef" />

@code {
    [Parameter] public Users? use { get; set; }

    #region Services
    [Inject] protected IDbContextFactory<_ApplicationConnectionDb> DbFactory { get; init; } = default!;
    [Inject] protected NavigationManager Navigation { get; init; } = default!;
    [Inject] protected IJSRuntime JS { get; init; } = default!;
    [Inject] protected TakeLogs Logger { get; init; } = default!;
    [Inject] protected EmailSender ApiEmailSender { get; init; } = default!;
    [Inject] protected TakeLogs ApiTakeLogs { get; init; } = default!;
    [Inject] protected UserInfos ApiUserInfos { get; init; } = default!;
    #endregion

    #region State Management
    private Notification? notificationRef;
    private readonly CancellationTokenSource _cts = new();
    private readonly SemaphoreSlim _dbLock = new(1, 1);
    private bool _disposed;
    #endregion

    #region Data
    private List<data.TaskStatus> tasks = new();
    private List<Users> adminUsers = new();
    private List<TaskNotes> taskNotes = new();
    private Guid? draggedTaskId;
    private bool showModal = false;
    private bool showDetailModal = false;
    private data.TaskStatus? editingTask;
    private data.TaskStatus? selectedTask;
    private string targetDateString = DateTime.Now.AddDays(7).ToString("yyyy-MM-dd");
    private string selectedPersonInCharge = "";
    private string newNote = "";
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _ = StartAutoRefreshLoop(TimeSpan.FromSeconds(5));
    }

    private async Task StartAutoRefreshLoop(TimeSpan interval)
    {
        using var timer = new PeriodicTimer(interval);
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (!showModal && !showDetailModal)
                {
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        await _cts.CancelAsync();
        _cts.Dispose();
        _dbLock.Dispose();
        GC.SuppressFinalize(this);
    }
    #endregion

    #region Button Management
    private readonly Dictionary<string, bool> _processingStates = new();
    protected bool IsButtonProcessing(string key) => _processingStates.GetValueOrDefault(key, false);

    private async Task<bool> RunWithStateAsync(string key, Func<Task> action, bool useDbLock = false)
    {
        if (IsButtonProcessing(key)) return false;

        if (useDbLock) await _dbLock.WaitAsync(_cts.Token);

        try
        {
            _processingStates[key] = true;
            StateHasChanged();

            await action();
            return true;
        }
        catch (OperationCanceledException) { return false; }
        catch (Exception ex)
        {
            await LogError(key, ex);
            if (useDbLock) await ShowNotification("error", "Hata", "İşlem başarısız oldu.", null);
            return false;
        }
        finally
        {
            _processingStates[key] = false;
            if (useDbLock) _dbLock.Release();
            StateHasChanged();
        }
    }

    private async Task<bool> ExecuteWithLock(string key, Func<Task> action)
    {
        return await RunWithStateAsync(key, action, useDbLock: true);
    }
    #endregion

    #region Helpers
    private async Task LogError(string action, Exception ex)
    {
        try
        {
            await Logger.TakeIt(
                userId: use?.Id,
                PageNameSpaceTitle: GetType().Name,
                action: action,
                exception: ex.Message,
                stackTrace: ex.StackTrace
            );
        }
        catch { }
    }

    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }

    private string GetUserName(Guid? userId)
    {
        if (userId == null) return "Atanmamış";
        var user = adminUsers.FirstOrDefault(u => u.Id == userId);
        return user != null ? $"{user.FirstName} {user.LastName}" : "Bilinmiyor";
    }

    private string GetStatusText(string? status)
    {
        return status switch
        {
            "NewTasks" => "Yeni Görevler",
            "ToBeDone" => "Yapılacak",
            "InProcess" => "İşlemde",
            "InEditing" => "Düzenlemede",
            "Completed" => "Tamamlandı",
            _ => "Bilinmiyor"
        };
    }

    private string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "ToBeDone" => "bg-light text-light",
            "InProcess" => "bg-primary text-dark",
            "InEditing" => "bg-info text-dark",
            "Completed" => "bg-success text-light",
            _ => "bg-light  text-light"
        };
    }

    private string GetPriorityBadgeClass(string? priority)
    {
        return priority switch
        {
            "Yüksek" => "bg-danger text-dark",
            "Orta" => "bg-warning text-dark",
            "Düşük" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }
    #endregion

    #region Data Operations
    protected async Task LoadData()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var query = db.TaskStatus.AsQueryable();

            // Kullanıcı bilgisi kontrolü ve filtreleme
            if (use != null && use.Id != Guid.Empty)
            {
                if (use.UsersType == "Admin")
                {
                    // Admin → AssignedByUserId kendi Id'sine eşit olanlar
                    query = query.Where(t => t.AssignedByUserId == use.Id);
                }
                else if (use.UsersType == "Employee")
                {
                    // Employee → PersonInChargeUserId kendi Id'sine eşit olanlar
                    query = query.Where(t => t.PersonInChargeUserId == use.Id);
                }
                // Diğer kullanıcı tipleri için filtre yok (tümü gelir)
            }
            // use null/boş ise filtre uygulanmaz, tüm TaskStatus gelir

            tasks = await query
                .AsNoTracking()
                .OrderBy(t => t.DateCreatedAt)
                .ToListAsync(_cts.Token);

            // ---- USERS ----
            adminUsers = await db.Users
                .AsNoTracking()
                .Where(u => u.UsersType == "Employee" || u.UsersType == "Admin")
                .OrderBy(u => u.FirstName)
                .ThenBy(u => u.LastName)
                .ToListAsync(_cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await LogError(nameof(LoadData), ex);
        }
    }

    private List<data.TaskStatus> GetTasksByStatus(string status)
    {
        return tasks.Where(t => t.Status == status).ToList();
    }

    private int GetTaskCountByStatus(string status)
    {
        return tasks.Count(t => t.Status == status);
    }
    #endregion

    #region Drag and Drop
    private void HandleDragStart(Guid taskId)
    {
        draggedTaskId = taskId;
    }

    private async Task HandleDrop(string newStatus)
    {
        if (use != null && (use.UsersType == "Employee" || use.UsersType == "Admin"))
        {
            if (draggedTaskId == null) return;

            await ExecuteWithLock(nameof(HandleDrop), async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

                var task = await db.TaskStatus.FirstOrDefaultAsync(t => t.Id == draggedTaskId, _cts.Token);
                if (task == null) return;

                var oldStatus = task.Status;
                task.Status = newStatus;

                // Durum tarihlerini güncelle
                switch (newStatus)
                {
                    case "NewTasks":
                        task.DateToBeDone = DateTime.Now;
                        break;
                    case "ToBeDone":
                        task.DateToBeDone = DateTime.Now;
                        break;
                    case "InProcess":
                        task.DateInProcess = DateTime.Now;
                        break;
                    case "InEditing":
                        task.DateInEditing = DateTime.Now;
                        break;
                    case "Completed":
                        task.DateCompleted = DateTime.Now;
                        break;
                }

                db.TaskStatus.Update(task);
                await db.SaveChangesAsync(_cts.Token);

                await ShowNotification("success", "Başarılı", $"Görev '{GetStatusText(newStatus)}' durumuna taşındı.", null);
                await LoadData();
            });
        }
        else
        {
            await ShowNotification("danger", "Hata", $"Görev yetki dışı olduğundan gerçekleştirilmedi", null);
        }

        draggedTaskId = null;
    }
    #endregion

    #region Modal Operations
    private void ShowAddTaskModal()
    {
        editingTask = new data.TaskStatus
        {
            Id = Guid.NewGuid(),
            Status = "NewTasks",
            Priority = "Orta",
            AssignedByUserId = use?.Id,
            PersonInChargeUserId = use?.Id,
            DateCreatedAt = DateTime.Now,
            DateToBeDone = DateTime.Now
        };
        targetDateString = DateTime.Now.AddDays(7).ToString("yyyy-MM-dd");
        selectedPersonInCharge = "";
        showModal = true;
    }

    private void EditTask(data.TaskStatus task)
    {
        editingTask = new data.TaskStatus
        {
            Id = task.Id,
            TaskTitle = task.TaskTitle,
            TaskDescription = task.TaskDescription,
            Priority = task.Priority,
            Status = task.Status,
            TargetDate = task.TargetDate,
            PersonInChargeUserId = task.PersonInChargeUserId,
            AssignedByUserId = task.AssignedByUserId,
            DateCreatedAt = task.DateCreatedAt
        };
        targetDateString = task.TargetDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.AddDays(7).ToString("yyyy-MM-dd");
        selectedPersonInCharge = task.PersonInChargeUserId?.ToString() ?? "";
        showDetailModal = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingTask = null;
    }

    private async Task ShowTaskDetail(data.TaskStatus task)
    {
        selectedTask = task;
        await LoadTaskNotes(task.Id);
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedTask = null;
        newNote = "";
    }

    private async Task LoadTaskNotes(Guid taskId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            taskNotes = await db.TaskNotes
                .AsNoTracking()
                .Where(n => n.TaskStatusId == taskId)
                .ToListAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            await LogError(nameof(LoadTaskNotes), ex);
        }
    }
    #endregion

    #region CRUD Operations
    private async Task SaveTask()
    {
        if (editingTask == null) return;

        await ExecuteWithLock("save", async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            if (!string.IsNullOrEmpty(selectedPersonInCharge) && Guid.TryParse(selectedPersonInCharge, out var personId))
            {
                editingTask.PersonInChargeUserId = personId;
            }

            if (DateTime.TryParse(targetDateString, out var targetDate))
            {
                editingTask.TargetDate = targetDate;
            }

            var existingTask = await db.TaskStatus.FirstOrDefaultAsync(t => t.Id == editingTask.Id, _cts.Token);

            if (existingTask == null)
            {
                db.TaskStatus.Add(editingTask);
                await ShowNotification("success", "Başarılı", "Görev oluşturuldu.", null);
            }
            else
            {
                existingTask.TaskTitle = editingTask.TaskTitle;
                existingTask.TaskDescription = editingTask.TaskDescription;
                existingTask.Priority = editingTask.Priority;
                existingTask.TargetDate = editingTask.TargetDate;
                existingTask.PersonInChargeUserId = editingTask.PersonInChargeUserId;

                db.TaskStatus.Update(existingTask);
                await ShowNotification("success", "Başarılı", "Görev güncellendi.", null);
            }

            await db.SaveChangesAsync(_cts.Token);
            await LoadData();
            CloseModal();
        });
    }

    private async Task DeleteTask()
    {
        if (selectedTask == null) return;

        await ExecuteWithLock("delete", async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var task = await db.TaskStatus.FirstOrDefaultAsync(t => t.Id == selectedTask.Id, _cts.Token);
            if (task != null)
            {
                // İlgili notları da sil
                var notes = await db.TaskNotes.Where(n => n.TaskStatusId == task.Id).ToListAsync(_cts.Token);
                db.TaskNotes.RemoveRange(notes);

                db.TaskStatus.Remove(task);
                await db.SaveChangesAsync(_cts.Token);

                await ShowNotification("success", "Başarılı", "Görev silindi.", null);
                await LoadData();
                CloseDetailModal();
            }
        });
    }

    private async Task AddNote()
    {
        if (selectedTask == null) return;

        await ExecuteWithLock("addNote", async () =>
        {
            if (string.IsNullOrEmpty(newNote) || string.IsNullOrWhiteSpace(newNote))
            {
                await ShowNotification("danger", "Hata", "Not alanı boş olduğu için eklenemedi.", null);
            }
            else
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

                var note = new TaskNotes
                {
                    Id = Guid.NewGuid(),
                    TaskStatusId = selectedTask.Id,
                    UserId = use?.Id ?? Guid.NewGuid(),
                    Note = newNote,
                    NoteCreatedAt = DateTime.Now
                };

                db.TaskNotes.Add(note);
                await db.SaveChangesAsync(_cts.Token);

                await ShowNotification("success", "Başarılı", "Not eklendi.", null);
                await LoadTaskNotes(selectedTask.Id);
                newNote = "";
            }

        });
    }
    #endregion
}
