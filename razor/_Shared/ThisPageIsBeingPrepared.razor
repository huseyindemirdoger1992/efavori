    private async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out _selectedCountryId);
        _selectedStateId = 0;
        _states.Clear();
        _cities.Clear();

        if (_editModel != null)
        {
            _editModel.Country = _countries.FirstOrDefault(c => c.id == _selectedCountryId)?.name;
            _editModel.State = null;
            _editModel.Cities = null;
        }

        if (_selectedCountryId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                _states = await db.States.AsNoTracking()
                    .Where(s => s.country_id == _selectedCountryId)
                    .OrderBy(s => s.name).ToListAsync(_cts.Token);
            }
            catch (Exception ex) { await LogError("OnCountrySelected", ex); }
        }
        StateHasChanged();
    }

    private async Task OnStateSelected(ChangeEventArgs e)
