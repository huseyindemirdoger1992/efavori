@rendermode InteractiveServer
<razor._Shared.Notification @ref="notificationRef" />

<button type="button"
        class="btn btn-light shadow btn-action"
        style="width:100%;"
        @onclick="Action"
        disabled="@Btn_isProcessing_01">

    <i class="fa @(Btn_isProcessing_01 ? "fa-spinner fa-spin" : "fa-sign-in")"></i>
    <span>@(Btn_isProcessing_01 ? "Yükleniyor..." : "Giriş Yap")</span>

</button>