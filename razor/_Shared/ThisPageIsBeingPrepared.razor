        int.TryParse(e.Value?.ToString(), out _selectedStateId);
        _cities.Clear();

        if (_editModel != null)
        {
            _editModel.State = _states.FirstOrDefault(s => s.id == _selectedStateId)?.name;
            _editModel.Cities = null;
