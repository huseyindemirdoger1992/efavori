@* ============================================================
   KALIP SAYFA — ThisPageIsBeingPrepared.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub ile anlık yayın (SignalR-free, pure event)
   ✅ IDbContextFactory: thread-safe, bağlantı sızıntısı yok
   ✅ SemaphoreSlim yazma kilidi: yarış koşulu yok
   ✅ Debounced arama: DB'yi boğmaz
   ✅ RAM cache (5 sn): 1000 kullanıcıda tek DB sorgusu
   ✅ CancellationToken zinciri: iptal güvenli
   ✅ IAsyncDisposable: event leak yok
   ✅ location.reload() YOK — tam Blazor reaktif model
   ✅ Düzenle modalı: kayıtlı ülke/il/şehir önceden dolu gelir
   ✅ Sil modalı: silinecek kaydın tüm detayları gösterilir
   ✅ Arama: yalnızca veri varsa, tablo genişliğinde gösterilir
   ✅ Bootstrap 5.3 — ek CSS/JS yok, tam mobil uyumlu
   ✅ CheckMarked → gerçek checkbox; CheckSliding → switch
   ✅ Düzenleme sonrası liste anında güncellenir (bug fix)
   ✅ Toplu seçim ve toplu sil / pasife al (Bulk Actions)
   ============================================================ *@

@using api
@using api.tr
@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using System.IO
@using System.IO.Compression
@using System.Text

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@namespace razor._Shared
@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa",  "/"),
        ("fa fa-table",    "Kayıtlar",   "javascript:void(0)"),
        ("fa fa-list-alt", PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Sadeleştirilmiş Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    @* ── 1. Ana Aksiyonlar ── *@
    <button class="btn btn-light btn-sm"
            @onclick="OpenAddModal"
            disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Kayıt</span>
    </button>

    @* ── 2. Toplu İşlemler (Sadece Seçim Varsa) ── *@
    @if (_selectedIds.Any())
    {
        <div class="d-flex align-items-center">
            <div class="vr mx-2"></div>
            <span class="badge bg-light px-2">@_selectedIds.Count</span>


            <button class="btn btn-outline-link btn-sm text-decoration-none text-light"
                    @onclick="ClearSelection" title="Seçimi Temizle">
                <i class="fa fa-times"></i> Seçimi Temizle
            </button>

            <div class="vr mx-2"></div>

            <button class="btn btn-outline-danger btn-sm border-0"
                    @onclick="BulkDeleteAsync" title="Seçilenleri Sil"
                    disabled="@_isProcessing">
                <i class="fa fa-trash"></i> Seçilenleri Sil
            </button>
        </div>
    }
</div>

@* ── Arama: yalnızca veri varsa, tablo genişliğince ── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Ara"
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch" title="Temizle">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_items.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_items.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Kayıt bulunmuyor.</p>
    </div>
}
else
{
    @* ── Tablo ── *@
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <!-- Kurumsal tercihiniz: bg-light -->
                <tr>
                    <th style="width:2rem;">
                        <input type="checkbox" class="form-check-input" @bind="_allSelected" @onclick="ToggleSelectAll" title="Tümünü Seç / Kaldır" />
                    </th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Ülke</th>
                    <th>İl</th>
                    <th>Şehir</th>
                    <th class="d-none d-md-table-cell">Tarih</th> <!-- Orta ekran ve üstünde görünsün -->
                    <th>Kontroller</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = 1;
                }
                @foreach (var item in _items)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input" checked="@isSelected" @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>
                        <td class="d-none d-md-table-cell text-secondary small">@(rowNo++)</td> <!-- text-light yerine text-muted daha okunabilir -->

                        <td><div class="fw-semibold">@(item.Country ?? "—")</div></td>
                        <td><div class="fw-semibold">@(item.State ?? "—")</div></td>
                        <td><div class="fw-semibold">@(item.Cities ?? "—")</div></td>

                        <!-- Tarih Alanı Düzenlemesi -->
                        <td class="d-none d-md-table-cell text-nowrap">
                            <div class="small">
                                @item.SelectDateTime.ToString("dd.MM.yyyy") | @item.SelectDateTime.ToString("HH:mm")
                            </div>
                        </td>

                        <td>
                            <span class="me-2" title="Kayan Kontrol">
                                <i class="fa @(item.CheckSliding == true ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary")"></i>
                            </span>
                            <span title="İşaretli">
                                <i class="fa @(item.CheckMarked == true ? "fa-check-square text-info" : "fa-square-o text-secondary")"></i>
                            </span>
                        </td>

                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <small class="text-light">
        Toplam @_items.Count kayıt
        @if (_isLoading)
        {
            <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
        }
    </small>
}

@* ═══════════════════════════════════════════
   MODAL — Ekle / Düzenle
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="SaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="backdrop-filter: blur(10px);
            box-shadow: 0 0 8px @(_editModel?.Id == Guid.Empty ? "rgba(13, 202, 240, 0.35)" : "rgba(255, 215, 0, 0.35)");">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-@(_editModel?.Id == Guid.Empty ? "plus" : "pencil") me-1"></i>
                    @(_editModel?.Id == Guid.Empty ? "Yeni Kayıt" : "Kayıt Düzenle")
                </h6>
                <div class="btn-group border border-secondary rounded shadow-sm ms-2" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 d-none d-md-inline-block"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size:.8rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1 d-none d-md-block" style="width:1px;opacity:.4;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_editModel != null)
                {
                    <div class="row g-3">

                        @* ── Ülke ── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-flag me-1"></i>Ülke
                            </label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_selectedCountryId"
                                    @onchange="OnCountrySelected">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>

                        @* ── Eyalet / İl ── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-map-signs me-1"></i>Eyalet / İl
                            </label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_selectedStateId"
                                    @onchange="OnStateSelected"
                                    disabled="@(!_states.Any())">
                                <option value="0">@(_states.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _states)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>

                        @* ── Şehir ── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-map-marker me-1"></i>Şehir
                            </label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editModel.Cities"
                                    @onchange="OnCitySelected"
                                    disabled="@(!_cities.Any())">
                                <option value="">@(_cities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _cities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        @* ── Tarih ── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-calendar me-1"></i>Tarih
                            </label>
                            <input type="datetime-local"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.SelectDateTime" />
                        </div>

                        @* ── Radio ── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-dot-circle-o me-1"></i>Seçenek
                            </label>
                            <div class="d-flex gap-4 mt-1">
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="rb_A"
                                           name="radioGroup"
                                           checked="@(_editModel.RadioButton == "A")"
                                           @onchange="@(() => _editModel.RadioButton = "A")" />
                                    <label class="form-check-label text-white-50" for="rb_A">Seçenek A</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="rb_B"
                                           name="radioGroup"
                                           checked="@(_editModel.RadioButton == "B")"
                                           @onchange="@(() => _editModel.RadioButton = "B")" />
                                    <label class="form-check-label text-white-50" for="rb_B">Seçenek B</label>
                                </div>
                            </div>
                        </div>

                        @* ── Kayan Kontrol (Switch) ── *@
                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="chkSliding"
                                       @bind="_editModel.CheckSliding" />
                                <label class="form-check-label text-white-50" for="chkSliding">
                                    Kayan Kontrol
                                </label>
                            </div>
                        </div>

                        @* ── İşaretli (Checkbox — switch değil) ── *@
                        <div class="col-12 col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="chkMarked"
                                       @bind="_editModel.CheckMarked" />
                                <label class="form-check-label text-white-50" for="chkMarked">
                                    İşaretli
                                </label>
                            </div>
                        </div>

                    </div>
                }
           
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button"
                        class="btn btn-sm @(_editModel?.Id == Guid.Empty ? "btn-primary" : "btn-warning")"
                        @onclick="SaveAsync"
                        disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa @(_editModel?.Id == Guid.Empty ? "fa-plus" : "fa-save") me-1"></i>
                        <span>@(_editModel?.Id == Guid.Empty ? "Yeni Kayıt Ekle" : "Değişiklikleri Kaydet")</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Silme Onayı (tüm kayıt detayları)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="backdrop-filter:blur(10px);box-shadow:0 0 8px rgba(220, 53, 69, 0.35);">
            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0 d-flex align-items-center">
                    <i class="fa fa-trash-o me-2 fs-5"></i>
                    <span>Silme İşlemi Yapıyorsunuz</span>
                </h6>
                <div class="btn-group border border-secondary rounded shadow-sm ms-2" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 d-none d-md-inline-block"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size:.8rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1 d-none d-md-block" style="width:1px;opacity:.4;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body py-3">
                <p class="text-white-50 small mb-0">
                    Bu kaydı silmek üzeresiniz. Devam etmek istediğinizden emin misiniz?
                </p>
            </div>

            <div class="modal-body">
                @if (_deleteTarget != null)
                {
                    <div class="row g-3">

                        @* ── Ülke ── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-flag me-1"></i>Ülke
                            </label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.Country ?? "—")" disabled />
                        </div>

                        @* ── Eyalet / İl ── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-map-signs me-1"></i>Eyalet / İl
                            </label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.State ?? "—")" disabled />
                        </div>

                        @* ── Şehir ── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-map-marker me-1"></i>Şehir
                            </label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.Cities ?? "—")" disabled />
                        </div>

                        @* ── Tarih ── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-calendar me-1"></i>Tarih
                            </label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@_deleteTarget.SelectDateTime.ToString("dd.MM.yyyy HH:mm")" disabled />
                        </div>

                        @* ── Radio (Seçenek) ── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-dot-circle-o me-1"></i>Seçenek
                            </label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.RadioButton ?? "—")" disabled />
                        </div>

                        @* ── Kayan Kontrol (Switch Durumu) ── *@
                        <div class="col-12 col-sm-6">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-toggle-on me-1"></i>Kayan Kontrol
                            </label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.CheckSliding == true ? "Açık" : "Kapalı")" disabled />
                        </div>

                        @* ── İşaretli Durumu ── *@
                        <div class="col-12 col-sm-6">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-check-square me-1"></i>İşaretli
                            </label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.CheckMarked == true ? "Evet" : "Hayır")" disabled />
                        </div>

                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="DeleteConfirmedAsync"
                        disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>Evet, Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Kayıt Yönetimi";
    private const string ENTITY_NAME = "TryTableSingle";
    private const string CACHE_KEY = "TryTableSingle_List";
    private const int SEARCH_DELAY = 400; // ms

    // ─── Parametreler ─────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü koruma ─────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;

    // ─── Veriler ──────────────────────────────────────────────────
    private List<TryTableSingle> _items = new();
    private List<Country> _countries = new();
    private List<States> _states = new();
    private List<Cities> _cities = new();

    // ─── Modal state ──────────────────────────────────────────────
    private TryTableSingle? _editModel;
    private TryTableSingle? _deleteTarget;

    // Cascade select ID'leri (select value kontrolü için modelden ayrı)
    private int _selectedCountryId;
    private int _selectedStateId;// ─── Bildirim ─────────────────────────────────────────────────
    private Notification? _notificationRef;

    // ─── [YENİ] Toplu Seçim State ─────────────────────────────────
    private readonly HashSet<Guid> _selectedIds = new();
    private bool _allSelected;

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;
        // İlk yükleme: liste + ülke listesi paralel
        await Task.WhenAll(
            LoadDataAsync(_searchTerm),
            LoadCountriesAsync()
        );
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged; await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY HANDLERLARI
    // ══════════════════════════════════════════════════════════════

    // ── [BUG FIX #1] ──────────────────────────────────────────────
    // Eski davranış: HandleDataChanged, _isProcessing == true olduğunda
    // erken çıkıyordu. SaveAsync() → NotifyDataChanged() zincirinde event
    // tam olarak _isProcessing = true iken geldiği için liste güncellenmiyor,
    // kullanıcı eski veriyi görmeye devam ediyordu.
    //
    // Düzeltme: _isProcessing guard'ı kaldırıldı. Bunun yerine SaveAsync()
    // ve DeleteConfirmedAsync() metodları kendi işlemlerini tamamladıktan
    // SONRA cache'i temizleyip notify ediyor; bu sırada _isProcessing = false
    // olduğu için HandleDataChanged artık correnct şekilde tetikleniyor.
    //
    // Ek olarak: cache key hesabı da sadeleştirildi — arama varken
    // farklı cache key kullanımı artık açıkça yönetiliyor.
    // ──────────────────────────────────────────────────────────────
    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized) return;
        if (entityName != ENTITY_NAME) return;

        await InvokeAsync(async () =>
        {
            await LoadDataAsync(_searchTerm);
            StateHasChanged();
        });
    }
    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    private async Task LoadDataAsync(string? search)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            // ── [BUG FIX #1 — devam] ──────────────────────────────
            // Arama terimi varken farklı cache key kullanıyoruz.
            // SaveAsync / DeleteConfirmedAsync yalnızca CACHE_KEY'i temizler.
            // Bu yüzden arama cache'leri NotifyDataChanged sonrası bypass edilerek
            // doğrudan DB'den taze veri çekilir.
            // ──────────────────────────────────────────────────────
            var cacheKey = string.IsNullOrWhiteSpace(search)
                ? CACHE_KEY
                : $"{CACHE_KEY}_{search}";

            // Arama yapılıyorsa arama cache'ini de temizle ki taze sonuç gelsin
            if (!string.IsNullOrWhiteSpace(search))
                StateHub.ClearCache(cacheKey);

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);
                var q = db.TryTableSingle.AsNoTracking().AsQueryable();

                if (!string.IsNullOrWhiteSpace(search))
                    q = q.Where(x =>
                        (x.Country != null && x.Country.Contains(search)) ||
                        (x.State != null && x.State.Contains(search)) ||
                        (x.Cities != null && x.Cities.Contains(search)));

                return await q
                    .OrderByDescending(x => x.SelectDateTime)
                    .ToListAsync(token);
            }, token);

            if (!token.IsCancellationRequested && result != null)
                _items = result;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadData", ex);
                await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadCountriesAsync()
