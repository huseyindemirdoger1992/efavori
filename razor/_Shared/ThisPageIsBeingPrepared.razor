    private async Task SaveAsync()
    {
        if (_isProcessing || _editModel == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            bool isNew = _editModel.Id == Guid.Empty;

            if (isNew)
            {
                _editModel.Id = Guid.NewGuid();
                _editModel.GetDateTime = DateTime.UtcNow;
                db.TryTableSingle.Add(_editModel);
            }
            else
            {
                var existing = await db.TryTableSingle
                    .FindAsync(new object[] { _editModel.Id }, _cts.Token);

                if (existing == null)
                {
                    await Notify("warning", "Uyarı", "Kayıt artık mevcut değil.");
                    return;
                }

                existing.Country = _editModel.Country;
                existing.State = _editModel.State;
                existing.Cities = _editModel.Cities;
                existing.CheckSliding = _editModel.CheckSliding;
                existing.CheckMarked = _editModel.CheckMarked;
                existing.RadioButton = _editModel.RadioButton;
                existing.SelectDateTime = _editModel.SelectDateTime;
                db.TryTableSingle.Update(existing);
            }

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("SaveModal");
            _editModel = null;

            // ── [BUG FIX #1 — kilit noktası] ──────────────────────
            // _isProcessing önce false yapılır, SONRA cache temizlenip
            // notify edilir. Böylece HandleDataChanged tetiklendiğinde
            // guard koşulu (_isProcessing) artık false'tur ve liste
            // doğru biçimde yeniden yüklenir.
            // ──────────────────────────────────────────────────────
            _isProcessing = false;
            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);

            await Logger.TakeIt(use?.Id, PAGE_TITLE, isNew ? "Add" : "Update");
            await Notify("success", "Başarılı", isNew ? "Kayıt eklendi." : "Kayıt güncellendi.");
        }
        catch (Exception ex)
        {
            await LogError("SaveAsync", ex);
            await Notify("danger", "Hata", "Kayıt sırasında sorun oluştu.");
        }
        finally
        {
            // _isProcessing zaten true → false akışı yukarıda yönetildi.
            // Hata durumunda burada sıfırlanır.
            if (_isProcessing)
            {
                _isProcessing = false;
                StateHasChanged();
            }
            _writeLock.Release();
        }
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.TryTableSingle
                .FindAsync(new object[] { _deleteTarget.Id }, _cts.Token);

            if (entity != null)
            {
                db.TryTableSingle.Remove(entity);
                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("DeleteModal");

            // ── [BUG FIX #1 — aynı sıra garantisi] ───────────────
            _isProcessing = false;
            _deleteTarget = null;
            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);

            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Delete");
            await Notify("success", "Silindi", "Kayıt başarıyla silindi.");
        }
        catch (Exception ex)
        {
            await LogError("DeleteAsync", ex);
            await Notify("danger", "Hata", "Silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing)
            {
                _isProcessing = false;
                StateHasChanged();
            }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // [YENİ] TOPLU SEÇİM (Bulk Selection)
    // ══════════════════════════════════════════════════════════════

    private void ToggleRowSelection(Guid id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);

        _allSelected = _items.Count > 0 && _items.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (_allSelected)
            _selectedIds.Clear();
        else
            foreach (var item in _items)
                _selectedIds.Add(item.Id);

        // _allSelected, @onclick tetiklenmeden önce eski değerdeydi;
        // seçim durumuna göre tekrar hesaplıyoruz.
        _allSelected = _items.Count > 0 && _items.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _allSelected = false;
        StateHasChanged();
    }

    // ══════════════════════════════════════════════════════════════
    // [YENİ] TOPLU İŞLEMLER (Bulk Actions)
    // SemaphoreSlim kilidi + ExecuteDeleteAsync / ExecuteUpdateAsync
    // ══════════════════════════════════════════════════════════════

    /// <summary>
    /// Seçili kayıtları toplu siler.
    /// ExecuteDeleteAsync → tek SQL DELETE, satır satır EF takibi yok.
    /// </summary>
    private async Task BulkDeleteAsync()
    {
        if (_isProcessing || !_selectedIds.Any()) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            await db.TryTableSingle
                .Where(x => ids.Contains(x.Id))
                .ExecuteDeleteAsync(_cts.Token);

            _selectedIds.Clear();
            _allSelected = false;

            _isProcessing = false;
            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);

            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkDelete ({ids.Count})");
            await Notify("success", "Silindi", $"{ids.Count} kayıt silindi.");
        }
        catch (Exception ex)
        {
            await LogError("BulkDelete", ex);
            await Notify("danger", "Hata", "Toplu silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing)
            {
                _isProcessing = false;
                StateHasChanged();
            }
            _writeLock.Release();
        }
    }

    /// <summary>
    /// Seçili kayıtları pasife alır (CheckSliding = false).
    /// ExecuteUpdateAsync → tek SQL UPDATE, nesne takibi yok.
    /// </summary>
    private static void WriteZipEntry(ZipArchive zip, string path, string content)
    {
        var entry = zip.CreateEntry(path, CompressionLevel.Optimal);
        using var w = new StreamWriter(entry.Open(), new UTF8Encoding(false));
        w.Write(content);
    }

    /// <summary>
    /// Tek hücre XML'i üretir (InlineString — SharedStrings gerektirmez).
    /// colIndex: 1-tabanlı
    /// </summary>
    private static string XlsxCell(string value, int colIndex, int rowIndex, int styleIdx)
    {
        var colLetter = GetColumnLetter(colIndex);
        var escaped = XmlEscape(value);
        return $"<c r=\"{colLetter}{rowIndex}\" t=\"inlineStr\" s=\"{styleIdx}\">" +
               $"<is><t>{escaped}</t></is></c>";
    }

    private static string GetColumnLetter(int col)
    {
        var sb = new StringBuilder();
        while (col > 0)
        {
            col--;
            sb.Insert(0, (char)('A' + col % 26));
            col /= 26;
        }
        return sb.ToString();
    }

    private static string XmlEscape(string value) =>
        value.Replace("&", "&amp;")
             .Replace("<", "&lt;")
             .Replace(">", "&gt;")
             .Replace("\"", "&quot;")
             .Replace("'", "&apos;");

