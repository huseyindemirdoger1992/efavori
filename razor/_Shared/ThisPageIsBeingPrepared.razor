@rendermode InteractiveServer
@inject razor._Shared.tr.Media.FileUploadService FileService

<div class="container-fluid py-4">
    <div class="card bg-transparent border border-light-3 shadow-sm mb-4">
        <div class="card-header bg-dark-transparent border-light-3">
            <h2 class="text-white mb-0">
                <i class="fa fa-cloud-upload me-2"></i>Medya Yönetimi
            </h2>
        </div>
        <div class="card-body">
            @if (use != null)
            {
                <!-- Dosya Yükleme -->
                <div class="mb-4">
                    <h5 class="text-white mb-3">
                        <i class="fa fa-upload me-2"></i>Dosya Yükle
                    </h5>
                    <razor._Shared.tr.Media.Upload use="@use" />
                </div>

                <hr class="border-light-3" />

                <!-- Tekli Seçim -->
                <div class="mb-4">
                    <h5 class="text-white mb-3">
                        <i class="fa fa-hand-pointer-o me-2"></i>Tekli Resim Seçimi
                    </h5>
                    <razor._Shared.tr.Media.List use="@use" IsMultiSelect="false" />
                </div>

                <hr class="border-light-3" />

                <!-- Çoklu Seçim -->
                <div class="mb-4">
                    <h5 class="text-white mb-3">
                        <i class="fa fa-check-square-o me-2"></i>Çoklu Resim Seçimi
                    </h5>
                    <razor._Shared.tr.Media.List use="@use" IsMultiSelect="true" />
                </div>
            }
        </div>
    </div>

    <!-- Seçilen Dosyaları Gösterme Alanı -->
    <div class="row">
        <!-- Tekli Seçim Sonucu -->
        <div class="col-lg-6 mb-4">
            <div class="card bg-transparent border border-light-3 shadow-sm">
                <div class="card-header bg-dark-transparent border-light-3">
                    <h5 class="text-white mb-0">
                        <i class="fa fa-image me-2"></i>Seçilen Resim (Tekli)
                    </h5>
                </div>
                <div class="card-body">
                    @if (selectedSingleFile != null)
                    {
                        <div class="text-center">
                            @{
                                var ext = selectedSingleFile.FileExtensionType?.ToLower() ?? "";
                                var isImage = IsImageFile(ext);
                            }

                            @if (isImage)
                            {
                                <div class="mb-3">
                                    <img src="@selectedSingleFile.FileUrl"
                                         class="img-fluid rounded shadow"
                                         style="max-height: 400px; object-fit: contain;"
                                         alt="@selectedSingleFile.FileName" />
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-dark rounded mb-3" style="height: 200px;">
                                    <i class="fa fa-file fa-5x text-white-50"></i>
                                </div>
                            }

                            <div class="alert alert-info bg-dark-transparent border-light-3 text-white">
                                <h6 class="mb-2">
                                    <i class="fa fa-file-o me-2"></i>@selectedSingleFile.FileName
                                </h6>
                                <div class="small text-white-50">
                                    <div><strong>Tür:</strong> @selectedSingleFile.FileExtensionType</div>
                                    <div><strong>Boyut:</strong> @FormatFileSize(selectedSingleFile.CompressedSize ?? selectedSingleFile.OriginalSize ?? 0)</div>
                                    <div><strong>Tarih:</strong> @selectedSingleFile.CreatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-outline-light" @onclick="CopySingleFileUrl">
                                        <i class="fa fa-copy me-1"></i>URL Kopyala
                                    </button>
                                    <button class="btn btn-sm btn-outline-light" @onclick="OpenSingleFileInNewTab">
                                        <i class="fa fa-external-link me-1"></i>Yeni Sekmede Aç
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-image fa-3x text-white-50 mb-3"></i>
                            <p class="text-white-50 mb-0">Henüz resim seçilmedi</p>
                            <small class="text-white-50">Yukarıdaki listeden bir resim seçin</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Çoklu Seçim Sonucu -->
        <div class="col-lg-6 mb-4">
            <div class="card bg-transparent border border-light-3 shadow-sm">
                <div class="card-header bg-dark-transparent border-light-3 d-flex justify-content-between align-items-center">
                    <h5 class="text-white mb-0">
                        <i class="fa fa-images me-2"></i>Seçilen Resimler (Çoklu)
                        @if (selectedMultipleFiles.Count > 0)
                        {
                            <span class="badge bg-primary ms-2">@selectedMultipleFiles.Count</span>
                        }
                    </h5>
                    @if (selectedMultipleFiles.Count > 0)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="ClearMultipleSelection">
                            <i class="fa fa-times me-1"></i>Temizle
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (selectedMultipleFiles.Count > 0)
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @foreach (var file in selectedMultipleFiles)
                            {
                                var ext = file.FileExtensionType?.ToLower() ?? "";
                                var isImage = IsImageFile(ext);

                                <div class="col">
                                    <div class="card bg-dark-transparent border-light-3 h-100">
                                        <div class="position-relative">
                                            @if (isImage)
                                            {
                                                <img src="@file.FileUrl"
                                                     class="card-img-top"
                                                     style="height: 150px; object-fit: cover;"
                                                     alt="@file.FileName" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center bg-dark" style="height: 150px;">
                                                    <i class="fa fa-file fa-3x text-white-50"></i>
                                                </div>
                                            }
                                            <div class="position-absolute top-0 end-0 m-2">
                                                <span class="badge bg-primary">
                                                    <i class="fa fa-check"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="card-body p-2">
                                            <h6 class="card-title text-white small text-truncate mb-1" title="@file.FileName">
                                                @file.FileName
                                            </h6>
                                            <div class="text-white-50" style="font-size: 0.75rem;">
                                                <div>@FormatFileSize(file.CompressedSize ?? file.OriginalSize ?? 0)</div>
                                            </div>
                                        </div>
                                        <div class="card-footer p-2 bg-dark-transparent border-light-3">
                                            <div class="btn-group w-100" role="group">
                                                <button class="btn btn-sm btn-outline-light"
                                                        @onclick="() => OpenFileInNewTab(file.FileUrl)"
                                                        title="Yeni Sekmede Aç">
                                                    <i class="fa fa-external-link"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-light"
                                                        @onclick="() => CopyFileUrl(file.FileUrl)"
                                                        title="URL Kopyala">
                                                    <i class="fa fa-copy"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Toplu İşlemler -->
                        <div class="mt-3 pt-3 border-top border-light-3">
                            <div class="d-flex gap-2 flex-wrap justify-content-center">
                                <button class="btn btn-outline-light" @onclick="CopyAllUrls">
                                    <i class="fa fa-copy me-1"></i>Tüm URL'leri Kopyala
                                </button>
                                <button class="btn btn-outline-light" @onclick="DownloadAllInfo">
                                    <i class="fa fa-download me-1"></i>Bilgileri İndir
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-images fa-3x text-white-50 mb-3"></i>
                            <p class="text-white-50 mb-0">Henüz resim seçilmedi</p>
                            <small class="text-white-50">Yukarıdaki listeden birden fazla resim seçin</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<razor._Shared.Notification @ref="notificationRef" />

<style>
    .bg-dark-transparent {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    .border-light-3 {
        border-color: rgba(255, 255, 255, 0.3) !important;
    }
</style>

@code {

    private Data.Media? selectedSingleFile;
    private List<Data.Media> selectedMultipleFiles = new();

    private razor._Shared.Notification? notificationRef;

    private readonly string[] imageExtensions = { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tiff", ".tif", ".heic", ".heif", ".raw", ".svg", ".ico", ".tga", ".avif" };
    private readonly string[] videoExtensions = { ".mp4", ".mov", ".avi", ".mkv", ".wmv", ".flv", ".webm", ".mpeg", ".mpg" };
    private readonly string[] audioExtensions = { ".mp3", ".wav", ".ogg", ".m4a", ".flac", ".aac", ".wma", ".opus" };
    private readonly string[] documentExtensions = { ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".rtf", ".odt" };
    protected override void OnInitialized()
    {
        // FileService olaylarına abone ol
        FileService.OnFileSelected += HandleSingleFileSelected;
        FileService.OnSelectionChanged += HandleMultipleFilesSelected;
    }

    private void HandleSingleFileSelected(Data.Media media)
    {
        selectedSingleFile = media;
        InvokeAsync(StateHasChanged);
    }

    private void HandleMultipleFilesSelected(List<Data.Media> files)
    {
        selectedMultipleFiles = new List<Data.Media>(files);
        InvokeAsync(StateHasChanged);
    }

    private void ClearMultipleSelection()
    {
        FileService.ClearSelection();
    }

    private bool IsImageFile(string ext) => imageExtensions.Contains(ext);

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    // Tekli Dosya İşlemleri
    private async Task CopySingleFileUrl()
    {
        if (selectedSingleFile?.FileUrl != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", $"https://efavori.com{selectedSingleFile.FileUrl}");
            await ShowNotification("Başarılı", "URL kopyalandı", "success");
        }
    }

    private async Task OpenSingleFileInNewTab()
    {
        if (selectedSingleFile?.FileUrl != null)
        {
            await JSRuntime.InvokeVoidAsync("open", selectedSingleFile.FileUrl, "_blank");
        }
    }

    // Çoklu Dosya İşlemleri
    private async Task OpenFileInNewTab(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
    }

    private async Task CopyFileUrl(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", $"https://efavori.com{url}");
            await ShowNotification("Başarılı", "URL kopyalandı", "success");
        }
    }

    private async Task CopyAllUrls()
    {
        if (selectedMultipleFiles.Count > 0)
        {
            var urls = string.Join("\n", selectedMultipleFiles.Select(f => $"https://efavori.com{f.FileUrl}"));
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", urls);
            await ShowNotification("Başarılı", $"{selectedMultipleFiles.Count} URL kopyalandı", "success");
        }
    }

    private async Task DownloadAllInfo()
    {
        if (selectedMultipleFiles.Count > 0)
        {
            var info = string.Join("\n\n", selectedMultipleFiles.Select(f =>
                $"Dosya: {f.FileName}\n" +
                $"Tür: {f.FileExtensionType}\n" +
                $"Boyut: {FormatFileSize(f.CompressedSize ?? f.OriginalSize ?? 0)}\n" +
                $"Tarih: {f.CreatedAt?.ToLocalTime():dd.MM.yyyy HH:mm}\n" +
                $"URL: https://efavori.com{f.FileUrl}"
            ));

            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", info);
            await ShowNotification("Başarılı", "Dosya bilgileri kopyalandı", "success");
        }
    }

    private async Task ShowNotification(string title, string message, string type)
    {
        if (notificationRef != null)
        {
            await notificationRef.Launch(type, title, message, null);
        }
    }

    public void Dispose()
    {
        FileService.OnFileSelected -= HandleSingleFileSelected;
        FileService.OnSelectionChanged -= HandleMultipleFilesSelected;
    }
}

@inject IJSRuntime JSRuntime


