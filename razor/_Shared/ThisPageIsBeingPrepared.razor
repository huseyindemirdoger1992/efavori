@using Microsoft.AspNetCore.Components;

@code {
    private string _currentInput = "0";
    private string _previousInput = string.Empty;
    private string _operation = string.Empty;
    private bool _isNewInput = true;

    protected string Display => _currentInput;

    protected IReadOnlyList<CalculatorButton> Buttons { get; } = new List<CalculatorButton>
    {
        new("C", "C", "btn-danger"),
        new("±", "±", "btn-secondary"),
        new("%", "%", "btn-secondary"),
        new("÷", "/", "btn-warning"),

        new("7", "7", "btn-outline-dark"),
        new("8", "8", "btn-outline-dark"),
        new("9", "9", "btn-outline-dark"),
        new("×", "*", "btn-warning"),

        new("4", "4", "btn-outline-dark"),
        new("5", "5", "btn-outline-dark"),
        new("6", "6", "btn-outline-dark"),
        new("-", "-", "btn-warning"),

        new("1", "1", "btn-outline-dark"),
        new("2", "2", "btn-outline-dark"),
        new("3", "3", "btn-outline-dark"),
        new("+", "+", "btn-warning"),

        new("0", "0", "btn-outline-dark"),
        new(".", ".", "btn-outline-dark"),
        new("<i class='fa fa-backspace'></i>", "⌫", "btn-secondary"),
        new("=", "=", "btn-success")
    };

    protected void OnButtonClick(string value)
    {
        switch (value)
        {
            case "C":
                Clear();
                break;
            case "±":
                ToggleSign();
                break;
            case "%":
                CalculatePercentage();
                break;
            case "⌫":
                Backspace();
                break;
            case "=":
                Calculate();
                break;
            case "+" or "-" or "*" or "/":
                SetOperation(value);
                break;
            case ".":
                AppendDecimal();
                break;
            default:
                AppendDigit(value);
                break;
        }
    }

    private void Clear()
    {
        _currentInput = "0";
        _previousInput = string.Empty;
        _operation = string.Empty;
        _isNewInput = true;
    }

    private void ToggleSign()
    {
        if (_currentInput != "0")
        {
            _currentInput = _currentInput.StartsWith('-')
                ? _currentInput[1..]
                : $"-{_currentInput}";
        }
    }

    private void CalculatePercentage()
    {
        if (double.TryParse(_currentInput, out var number))
        {
            _currentInput = (number / 100).ToString("G");
        }
    }

    private void Backspace()
    {
        _currentInput = _currentInput.Length > 1
            ? _currentInput[..^1]
            : "0";
    }

    private void SetOperation(string op)
    {
        if (!string.IsNullOrEmpty(_previousInput) && !_isNewInput)
        {
            Calculate();
        }
        _previousInput = _currentInput;
        _operation = op;
        _isNewInput = true;
    }

    private void AppendDecimal()
    {
        if (_isNewInput)
        {
            _currentInput = "0.";
            _isNewInput = false;
        }
        else if (!_currentInput.Contains('.'))
        {
            _currentInput += ".";
        }
    }

    private void AppendDigit(string digit)
    {
        _currentInput = _isNewInput
            ? digit
            : _currentInput + digit;
        _isNewInput = false;
    }

    private void Calculate()
    {
        if (string.IsNullOrEmpty(_previousInput) || string.IsNullOrEmpty(_operation))
            return;

        if (!double.TryParse(_previousInput, out var prev) ||
            !double.TryParse(_currentInput, out var curr))
            return;

        var result = _operation switch
        {
            "+" => prev + curr,
            "-" => prev - curr,
            "*" => prev * curr,
            "/" when curr != 0 => prev / curr,
            "/" => double.NaN,
            _ => curr
        };

        _currentInput = double.IsNaN(result) ? "Hata" : result.ToString("G");
        _previousInput = string.Empty;
        _operation = string.Empty;
        _isNewInput = true;
    }

    protected sealed record CalculatorButton(string Label, string Value, string CssClass);
}


<div class="card shadow-sm" style="max-width: 320px;">
    <div class="card-header bg-primary text-white">
        <i class="fa fa-calculator me-2"></i>Hesap Makinası
    </div>
    <div class="card-body">
        <div class="form-control text-end mb-3 fs-4 bg-light" style="min-height: 50px;">
            @Display
        </div>

        <div class="row g-2">
            @foreach (var btn in Buttons)
            {
                <div class="col-3">
                    <button class="btn @btn.CssClass w-100 py-2" @onclick="() => OnButtonClick(btn.Value)">
                        @btn.Label
                    </button>
                </div>
            }
        </div>
    </div>
</div>