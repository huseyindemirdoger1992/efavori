@* ============================================================
   ThisPageIsBeingPrepared.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub — anlık broadcast, debounce, RAM cache
   ❌ GlobalSecurityProvider KALDIRILDI (şifreleme yok)
   ✅ TakeLogs — tüm CRUD aksiyonları loglanır
   ✅ Ayrı Ekle / Düzenle / Sil modalleri
   ✅ Seçilenleri Sil → önce onay modali (sayı + liste)
   ✅ 5'li sayfalama
   ✅ Basit, performanslı, kötü sunucuda bile binlerce kullanıcıya cevap
   ============================================================ *@
@using data
@using data.Owned;
@using data._Carts;
@using data._Categories;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;

@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<data._ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    // Bu alanı kesinlikle SİLME. Kullanılsın veya kullanılmasın, global state'den dil bilgisini almak ve yönlendirme yapmak için gereklidir.
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    // NavigationManager.NavigateTo($@"/{use?.Language.ToLower()}/Admin/Store/List/", true); Dil bilgisini global state'den alarak yönlendirme yapar.
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa",  "/"),
        ("fa fa-table",    "Kayıtlar",   "javascript:void(0)"),
        ("fa fa-list-alt", PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    <button class="btn btn-light btn-sm" @onclick="OpenAddModal" disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Kayıt</span>
    </button>

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light">@_selectedIds.Count seçili</span>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Seçimi Temizle
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-danger btn-sm border-0"
                @onclick="OpenBulkDeleteModal"
                disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Ara"
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_allItems.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Kayıt bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2rem;">
                        <input type="checkbox" class="form-check-input"
                               checked="@_allSelected"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Ülke</th>
                    <th>İl</th>
                    <th>Şehir</th>
                    <th class="d-none d-md-table-cell">Tarih</th>
                    <th>Kontroller</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>
                        <td class="d-none d-md-table-cell text-secondary small">@(rowNo++)</td>
                        <td><div class="fw-semibold">@item.Country</div></td>
                        <td><div class="fw-semibold">@item.State</div></td>
                        <td><div class="fw-semibold">@item.Cities</div></td>
                        <td class="d-none d-md-table-cell text-nowrap">
                            <div class="small">@item.SelectDateTime.ToString("dd.MM.yyyy") | @item.SelectDateTime.ToString("HH:mm")</div>
                        </td>
                        <td>
                            <span class="me-2" title="Kayan Kontrol">
                                <i class="fa @(item.CheckSliding == true ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary")"></i>
                            </span>
                            <span title="İşaretli">
                                <i class="fa @(item.CheckMarked == true ? "fa-check-square text-info" : "fa-square-o text-secondary")"></i>
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_allItems.Count kayıt
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                    </li>

                    @for (int p = 1; p <= _totalPages; p++)
                    {
                        var pg = p;
                        <li class="page-item @(_currentPage == pg ? "active" : "")">
                            <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                    @onclick="() => GoToPage(pg)">
                                @pg
                            </button>
                        </li>
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Ekle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="AddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-plus me-1"></i>Yeni Kayıt
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam     Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>

                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_addModel != null)
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addCountryId"
                                    @onchange="e => OnCountryChanged(e, true)">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addStateId"
                                    @onchange="e => OnStateChanged(e, true)"
                                    disabled="@(!_addStates.Any())">
                                <option value="0">@(_addStates.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _addStates)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addModel.Cities"
                                    @onchange="e => OnCityChanged(e, true)"
                                    disabled="@(!_addCities.Any())">
                                <option value="">@(_addCities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _addCities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-calendar me-1"></i>Tarih</label>
                            <input type="datetime-local"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_addModel.SelectDateTime" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-dot-circle-o me-1"></i>Seçenek</label>
                            <div class="d-flex gap-4 mt-1">
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="add_rb_A" name="addRadio"
                                           checked="@(_addModel.RadioButton == "A")"
                                           @onchange="@(() => _addModel.RadioButton = "A")" />
                                    <label class="form-check-label text-white-50" for="add_rb_A">Seçenek A</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="add_rb_B" name="addRadio"
                                           checked="@(_addModel.RadioButton == "B")"
                                           @onchange="@(() => _addModel.RadioButton = "B")" />
                                    <label class="form-check-label text-white-50" for="add_rb_B">Seçenek B</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="add_chkSliding" @bind="_addModel.CheckSliding" />
                                <label class="form-check-label text-white-50" for="add_chkSliding">Kayan Kontrol</label>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="add_chkMarked" @bind="_addModel.CheckMarked" />
                                <label class="form-check-label text-white-50" for="add_chkMarked">İşaretli</label>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="AddAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-plus me-1"></i><span>Yeni Kayıt Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Düzenle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
