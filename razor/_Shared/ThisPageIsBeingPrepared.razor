@using api
@using api.tr
@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-globe",    "efavori",                  "/"),
        ("fa fa-eye", "Web Siteye Genel Bakış",  "javascript:void(0)"),
        ("fa fa-inbox",     "Bilgi Dağarcıkları", "javascript:void(0)")
    };
}


@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center py-5">
        <div class="spinner-border text-light" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
        <span class="ms-3 text-white">Veriler yükleniyor...</span>
    </div>
}
else
{
    <!-- ===== SATIR 1: Kullanıcı · Mağaza · Ürün ===== -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-2 row-cols-xl-3 g-3 mb-3">

        <!-- Kullanıcı Kartı -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-users me-1"></i> Kullanıcılar
                            </p>
                            <h4 class="my-1 text-white">@Users!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@Users.Count(u => u.RegistrationDate?.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@Users.Count(u => u.RegistrationDate >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@Users.Count(u => u.RegistrationDate >= _monthStart)</strong></span>
                            </div>
                            <div class="mt-2 small text-white opacity-75">
                                <i class="fa fa-circle text-success me-1" style="font-size:10px"></i> Aktif: <strong>@Users.Count(u => u.IsActive == true)</strong>
                                &nbsp;|&nbsp;
                                <i class="fa fa-circle text-warning me-1" style="font-size:10px"></i> Pasif: <strong>@Users.Count(u => u.IsActive != true)</strong>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mağaza Kartı -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-shopping-bag me-1"></i> Mağazalar
                            </p>
                            <h4 class="my-1 text-white">@Store!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@Store.Count(u => u.CreatedAt?.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@Store.Count(u => u.CreatedAt >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@Store.Count(u => u.CreatedAt >= _monthStart)</strong></span>
                            </div>
                            <div class="mt-2 small text-white opacity-75">
                                <i class="fa fa-check-circle text-success me-1"></i> Onaylı: <strong>@Store.Count(u => u.IsActiveStateAdmin == true)</strong>
                                &nbsp;|&nbsp;
                                <i class="fa fa-clock-o text-warning me-1"></i> Bekleyen: <strong>@Store.Count(u => u.AdminPermissionPending == true)</strong>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-shopping-bag"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ürün Kartı -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-cube me-1"></i> Ürünler
                            </p>
                            <h4 class="my-1 text-white">@Product!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@Product.Count(u => u.CreatedAt.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@Product.Count(u => u.CreatedAt >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@Product.Count(u => u.CreatedAt >= _monthStart)</strong></span>
                            </div>
                            <div class="mt-2 small text-white opacity-75">
                                <i class="fa fa-toggle-on text-success me-1"></i> Aktif: <strong>@Product.Count(u => u.IsActive)</strong>
                                &nbsp;|&nbsp;
                                <i class="fa fa-star text-warning me-1"></i> Öne Çıkan: <strong>@Product.Count(u => u.IsFeatured)</strong>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-cube"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== SATIR 2: Gönderi · Yazı · Medya ===== -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-2 row-cols-xl-3 g-3 mb-3">

        <!-- Gönderi Kartı -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-paper-plane-o me-1"></i> Gönderiler
                            </p>
                            <h4 class="my-1 text-white">@Posts!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@Posts.Count(u => u.CreatedDate.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@Posts.Count(u => u.CreatedDate >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@Posts.Count(u => u.CreatedDate >= _monthStart)</strong></span>
                            </div>
                            <div class="mt-2 small text-white opacity-75">
                                <i class="fa fa-user text-info me-1"></i> Kullanıcı: <strong>@Posts.Count(u => u.IsUser)</strong>
                                &nbsp;|&nbsp;
                                <i class="fa fa-store text-warning me-1"></i> Mağaza: <strong>@Posts.Count(u => !u.IsUser)</strong>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-paper-plane-o"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Yazı Kartı -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-file-text-o me-1"></i> Makaleler
                            </p>
                            <h4 class="my-1 text-white">@Article!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            @{
                                // Article'da CreatedDate yok; Meta.CreatedAt veya Interaction üzerinden değil,
                                // veri modeline göre tarih alanı eklenmesi önerilir.
                                // Şimdilik sadece toplam ve kullanıcı/mağaza ayrımı gösteriliyor.
                            }
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span class="opacity-50 fst-italic">Tarih alanı modele eklenmesi önerilir</span>
                            </div>
                            <div class="mt-2 small text-white opacity-75">
                                <i class="fa fa-user text-info me-1"></i> Kullanıcı: <strong>@Article.Count(u => u.IsUser)</strong>
                                &nbsp;|&nbsp;
                                <i class="fa fa-building text-warning me-1"></i> Mağaza: <strong>@Article.Count(u => !u.IsUser)</strong>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-file-text-o"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medya Kartı -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-photo me-1"></i> Medya Dosyaları
                            </p>
                            <h4 class="my-1 text-white">@Media!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@Media.Count(u => u.CreatedAt?.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@Media.Count(u => u.CreatedAt >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@Media.Count(u => u.CreatedAt >= _monthStart)</strong></span>
                            </div>
                            <div class="mt-2 small text-white opacity-75">
                                @{
                                    var totalMb = Media.Sum(m => m.OriginalSize ?? 0) / 1_048_576.0;
                                    var compMb = Media.Sum(m => m.CompressedSize ?? 0) / 1_048_576.0;
                                }
                                <i class="fa fa-hdd-o text-info me-1"></i> Orijinal: <strong>@totalMb.ToString("N1") MB</strong>
                                &nbsp;|&nbsp;
                                <i class="fa fa-compress text-success me-1"></i> Sıkıştırılmış: <strong>@compMb.ToString("N1") MB</strong>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-photo"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== SATIR 3: Giriş Denemeleri ===== -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-2 row-cols-xl-3 g-3 mb-3">

        <!-- Toplam Giriş -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-sign-in me-1"></i> Giriş Denemeleri
                            </p>
                            <h4 class="my-1 text-white">@LoginTry!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@LoginTry.Count(u => u.AttemptDate?.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@LoginTry.Count(u => u.AttemptDate >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@LoginTry.Count(u => u.AttemptDate >= _monthStart)</strong></span>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-sign-in"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Başarılı Giriş -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-check-circle me-1"></i> Başarılı Girişler
                            </p>
                            <h4 class="my-1 text-white">@LoginTry!.Count(l => l.IsSuccessful == true) <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@LoginTry.Count(u => u.IsSuccessful == true && u.AttemptDate?.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@LoginTry.Count(u => u.IsSuccessful == true && u.AttemptDate >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@LoginTry.Count(u => u.IsSuccessful == true && u.AttemptDate >= _monthStart)</strong></span>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Başarısız Giriş -->
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-times-circle me-1"></i> Başarısız Girişler
                            </p>
                            <h4 class="my-1 text-white">@LoginTry!.Count(l => l.IsSuccessful != true) <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@LoginTry.Count(u => u.IsSuccessful != true && u.AttemptDate?.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@LoginTry.Count(u => u.IsSuccessful != true && u.AttemptDate >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@LoginTry.Count(u => u.IsSuccessful != true && u.AttemptDate >= _monthStart)</strong></span>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-times-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== SATIR 4: Sistem Logları ===== -->
    <div class="row row-cols-1 row-cols-md-1 row-cols-xl-1 g-3 mb-3">
        <div class="col">
            <div class="card radius-10 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 text-white fw-semibold">
                                <i class="fa fa-list-alt me-1"></i> Sistem Logları
                            </p>
                            <h4 class="my-1 text-white">@Logs!.Count <small class="fs-6 fw-normal opacity-75">toplam</small></h4>
                            <hr class="border-light opacity-25 my-2" />
                            <div class="d-flex flex-wrap gap-3 small text-white opacity-90">
                                <span><i class="fa fa-calendar-check-o me-1"></i> Bugün: <strong>@Logs.Count(u => u.Date?.Date == DateTime.Today)</strong></span>
                                <span><i class="fa fa-calendar me-1"></i> Bu Hafta: <strong>@Logs.Count(u => u.Date >= _weekStart)</strong></span>
                                <span><i class="fa fa-calendar-o me-1"></i> Bu Ay: <strong>@Logs.Count(u => u.Date >= _monthStart)</strong></span>
                            </div>
                            <div class="mt-2 small text-white opacity-75">
                                <i class="fa fa-exclamation-triangle text-danger me-1"></i> Hatalı: <strong>@Logs.Count(u => u.Exception != null)</strong>
                                &nbsp;|&nbsp;
                                <i class="fa fa-check text-success me-1"></i> Temiz: <strong>@Logs.Count(u => u.Exception == null)</strong>
                            </div>
                        </div>
                        <div class="widgets-icons bg-light-transparent text-white ms-3">
                            <i class="fa fa-list-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {

    private const string PAGE = "DataManager";

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;

    private bool _isLoading;
    private CancellationTokenSource? _searchCts;

    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _isProcessing;

    // --- Tarih Aralıkları (UTC) ---
    private static DateTime _weekStart => DateTime.UtcNow.Date.AddDays(-(int)DateTime.UtcNow.DayOfWeek);
    private static DateTime _monthStart => new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);

    // --- Veri Listeleri ---
    private List<Users> Users { get; set; } = new();
    private List<Store> Store { get; set; } = new();
    private List<Product> Product { get; set; } = new();
    private List<Posts> Posts { get; set; } = new();
    private List<Article> Article { get; set; } = new();
    private List<LoginTry> LoginTry { get; set; } = new();
    private List<Data.Media> Media { get; set; } = new();
    private List<Logs> Logs { get; set; } = new();

    private List<Country> _Countries = new();
    private List<States> _States = new();
    private List<Cities> _Cities = new();

    private Notification? notificationRef;

    protected async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int countryId);
        _States.Clear();
        _Cities.Clear();

        if (countryId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _States = await db.States.AsNoTracking()
                .Where(s => s.country_id == countryId)
                .OrderBy(s => s.name)
                .ToListAsync();
        }
        StateHasChanged();
    }

    protected async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int stateId);
        _Cities.Clear();

        if (stateId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _Cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == stateId)
                .OrderBy(c => c.name)
                .ToListAsync();
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;

        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;

        await LoadData();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleGlobalDataChange;

        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;

        var shouldRefresh = entityName is "Users" or "Store" or "Product"
                                       or "Posts" or "Article" or "LoginTry"
                                       or "Media" or "Logs";
        if (shouldRefresh)
        {
            await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
        }
    }

    protected virtual async Task LoadData()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (_isLoading) return;
            _isLoading = true;

            using var db = await DbFactory.CreateDbContextAsync();
            _Countries = await db.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync();
            StateHasChanged();

            var result = await StateHub.GetOrLoadAsync("DataManager_Main", async () =>
            {
                await using var dbCtx = await DbFactory.CreateDbContextAsync(token);

                var users = await dbCtx.Users.AsNoTracking()
                    .Where(u => u.IsDeleted != true && u.IsActive == true)
                    .OrderByDescending(u => u.RegistrationDate)
                    .ToListAsync(token);

                var stores = await dbCtx.Stores.AsNoTracking()
                    .Where(u => u.IsDeleted!.IsDeletedStatu != true)
                    .OrderByDescending(u => u.CreatedAt)
                    .ToListAsync(token);

                var products = await dbCtx.Product.AsNoTracking()
                    .Where(u => u.IsDeleted!.IsDeletedStatu != true)
                    .OrderByDescending(u => u.CreatedAt)
                    .ToListAsync(token);

                var posts = await dbCtx.Posts.AsNoTracking()
                    .Where(u => u.IsDeleted!.IsDeletedStatu != true)
                    .ToListAsync(token);

                var articles = await dbCtx.Article.AsNoTracking()
                    .Where(u => u.IsDeleted!.IsDeletedStatu != true)
                    .ToListAsync(token);

                var loginTries = await dbCtx.LoginTry.AsNoTracking()
                    .ToListAsync(token);

                var media = await dbCtx.Media.AsNoTracking()
                    .Where(m => m.IsDeletedStatu != true)
                    .ToListAsync(token);

                var logs = await dbCtx.Logs.AsNoTracking()
                    .OrderByDescending(l => l.Date)
                    .ToListAsync(token);

                return new
                {
                    Users = users,
                    Store = stores,
                    Products = products,
                    Posts = posts,
                    Articles = articles,
                    LoginTry = loginTries,
                    Media = media,
                    Logs = logs
                };

            }, token);

            if (result != null && !token.IsCancellationRequested)
            {
                Users = result.Users;
                Store = result.Store;
                Product = result.Products;
                Posts = result.Posts;
                Article = result.Articles;
                LoginTry = result.LoginTry;
                Media = result.Media;
                Logs = result.Logs;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await Logger.TakeIt(null, PAGE, "LoadData",
                exception: ex.Message,
                stackTrace: ex.StackTrace);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }
}
