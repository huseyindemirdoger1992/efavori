        _cities.Clear();

        await ShowModal("SaveModal");
    }

    /// <summary>
    /// Düzenle: kayıtlı ülke/il/şehir string değerlerinden ID'leri çözerek
    /// cascade select'leri önceden doldurur. Kullanıcı modalı açtığında
    /// seçimler zaten doğru yerde gelir.
    /// </summary>
    private async Task OpenEditModal(TryTableSingle item)
    {
        _editModel = new TryTableSingle
        {
            Id = item.Id,
            Country = item.Country,
            State = item.State,
            Cities = item.Cities,
            CheckSliding = item.CheckSliding,
            CheckMarked = item.CheckMarked,
            RadioButton = item.RadioButton,
            SelectDateTime = item.SelectDateTime,
            GetDateTime = item.GetDateTime
        };

        await PreloadCascadeForEdit(item.Country, item.State);
        await ShowModal("SaveModal");
    }

    /// <summary>
    /// Kayıtlı ülke/il adlarından ID'leri bularak eyalet ve şehir
    /// listelerini DB'den yükler. Böylece select elementleri doğru
    /// değeri gösterir.
    /// </summary>
    private async Task PreloadCascadeForEdit(string? countryName, string? stateName)
    {
        _selectedCountryId = 0;
        _selectedStateId = 0;
        _states.Clear();
        _cities.Clear();

        if (string.IsNullOrWhiteSpace(countryName)) return;

        // Ülkeyi isimden bul
        var country = _countries.FirstOrDefault(c =>
            string.Equals(c.name, countryName, StringComparison.OrdinalIgnoreCase));

        if (country == null) return;
        _selectedCountryId = country.id;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Eyaletleri yükle
            _states = await db.States.AsNoTracking()
                .Where(s => s.country_id == _selectedCountryId)
                .OrderBy(s => s.name).ToListAsync(_cts.Token);

            if (string.IsNullOrWhiteSpace(stateName)) return;

            // Eyaleti isimden bul
            var state = _states.FirstOrDefault(s =>
                string.Equals(s.name, stateName, StringComparison.OrdinalIgnoreCase));

            if (state == null) return;
            _selectedStateId = state.id;

            // Şehirleri yükle
            _cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == _selectedStateId)
                .OrderBy(c => c.name).ToListAsync(_cts.Token);
        }
        catch (Exception ex) { await LogError("PreloadCascade", ex); }
    }

