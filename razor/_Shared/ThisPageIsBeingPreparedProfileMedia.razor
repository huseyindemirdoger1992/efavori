<div class="modal fade" id="modalGalleryList" tabindex="-1"
     data-bs-backdrop="false" data-bs-keyboard="false"
     style="z-index: 1080;">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark border border-light-3">
            <div class="modal-header border-light-3">
                <h6 class="modal-title text-white">
                    <i class="fa fa-picture-o me-2 text-info"></i>Galeri Görseli Seç
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded overflow-hidden" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 d-flex align-items-center justify-content-center"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran" style="padding: 0.5rem 0.75rem;">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>

                    <div class="vr bg-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                    <button type="button" class="btn btn-sm border-0 d-flex align-items-center justify-content-center"
                            @onclick="CloseMediaModal" style="padding: 0.5rem 0.75rem;">
                        <span class="btn-close btn-close-white" style="font-size: 0.65rem; padding: 0;"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <Upload use="use" />
                <hr class="border-light-3 my-3" />

                @* ─── Galeri seçim grid'i (parent yönetiminde) ───────────────
                   List bileşeni yerine burada kendi grid'imizi render ediyoruz.
                   Sebep: List bileşeni FileService üzerinden referans tabanlı
                   "Contains" karşılaştırması yapıyor; bizim _galleryFiles
                   instance'larımız ile List'in mediaItems instance'ları farklı
                   DbContext'lerden geldiği için "Seçildi" rozetleri tutmuyordu.
                   Burada Id bazlı karşılaştırma kullanıyoruz → daha önce seçilen
                   medyalar binlerce öğe arasında doğru şekilde işaretlenir.
                   ─────────────────────────────────────────────────────────── *@
                @if (_activeMediaSlot == "gallery")
                {
                    @* Arama kutusu *@
                    <div class="input-group input-group-sm mb-3">
                        <span class="input-group-text bg-dark-transparent border-light-3 text-white-50">
                            <i class="fa fa-search"></i>
                        </span>
                        <input type="text"
                               class="form-control bg-dark-transparent border-light-3 text-white"
                               placeholder="Ara..."
                               value="@_gallerySearch"
                               @oninput="OnGallerySearchInput" />
                        @if (!string.IsNullOrWhiteSpace(_gallerySearch))
                        {
                            <button class="btn btn-outline-light border-light-3" type="button"
                                    @onclick="ClearGallerySearch">
                                <i class="fa fa-times"></i>
                            </button>
                        }
                    </div>

                    @if (_galleryLoading)
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
                            <p class="mt-2 text-light small">Yükleniyor...</p>
                        </div>
                    }
                    else if (!_galleryFilteredMedia.Any())
                    {
                        <div class="text-center py-5 text-white-50">
                            <i class="fa fa-folder-open fa-3x mb-3 d-block"></i>
                            <p class="mb-0">@(string.IsNullOrWhiteSpace(_gallerySearch) ? "Henüz medya yok" : "Sonuç bulunamadı")</p>
                        </div>
                    }
                    else
                    {
                        var selectedIdSet = _galleryFiles.Select(g => g.Id).ToHashSet();
                        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
                            @foreach (var m in _galleryFilteredMedia.Take(_galleryDisplayCount))
                            {
                                var isSel = selectedIdSet.Contains(m.Id);
                                <div class="col">
                                    <div class="card bg-dark-transparent border-light-3 h-100 overflow-hidden shadow-sm position-relative @(isSel ? "border-primary shadow" : "")"
                                         style="cursor:pointer;"
                                         @onclick="() => ToggleGalleryItem(m)">
                                        @if (isSel)
                                        {
                                            <div class="position-absolute top-0 end-0 m-2" style="z-index:10;">
                                                <span class="badge bg-primary">
                                                    <i class="fa fa-check"></i> Seçildi
                                                </span>
                                            </div>
                                        }

                                        @{
                                            var ext = m.FileExtensionType?.ToLower() ?? "";
                                            var isImg = IsGalleryImage(ext);
                                            var isVid = IsGalleryVideo(ext);
                                        }

                                        @if (isImg)
                                        {
                                            <img src="@m.FileUrl"
                                                 style="height:150px;object-fit:cover;width:100%;"
                                                 alt="@m.FileName"
                                                 loading="lazy" />
                                        }
                                        else if (isVid)
                                        {
                                            <div class="position-relative" style="height:150px;background:#000;">
                                                <video class="w-100 h-100" style="object-fit:cover;">
                                                    <source src="@m.FileUrl" type="@m.ContentType">
                                                </video>
                                                <div class="position-absolute top-50 start-50 translate-middle">
                                                    <i class="fa fa-play-circle fa-3x text-white opacity-75"></i>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center bg-dark text-white-50" style="height:150px;">
                                                <i class="fa fa-file-o fa-4x"></i>
                                            </div>
                                        }

                                        <div class="card-body p-2">
                                            <div class="text-white small text-truncate fw-bold" title="@m.FileName">
                                                <i class="fa fa-file-text-o me-1 text-info"></i>@m.FileName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (_galleryDisplayCount < _galleryFilteredMedia.Count)
                        {
                            <div class="text-center mt-3">
                                <button class="btn btn-outline-light btn-sm px-4"
                                        @onclick="() => _galleryDisplayCount += 15">
                                    <i class="fa fa-arrow-down me-1"></i>Daha Fazla Göster
                                </button>
                            </div>
                        }
                    }
                }
            </div>
            <div class="modal-footer border-light-3">
                <span class="text-white-50 small me-auto">@_galleryFiles.Count görsel seçildi</span>
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="CloseMediaModal">
                    <i class="fa fa-check me-1"></i>Seçimi Onayla
                </button>
            </div>
        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Kayıt Yönetimi";
    private const string ENTITY_NAME = "ThisPageIsBeingPreparedProfileMedia";
    private const string CACHE_KEY = "ThisPageIsBeingPreparedProfileMedia_List";
    private const int SEARCH_DELAY = 500;
    private const int PAGE_SIZE = 5;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Profil Kapak Görseli ─────────────────────────────────────
    private Data.Media? _profileMedia;
    private Data.Media? _coverMedia;
    private string _activeMediaSlot = string.Empty;

    // ─── Galeri (çoklu seçim) ─────────────────────────────────────
    private List<Data.Media> _galleryFiles = new();

    // ─── Galeri seçim grid'i (parent yönetiminde) ─────────────────
    // List bileşeni yerine kendi grid'imizi kullanıyoruz; sebep:
    // List bileşeninin "Contains" karşılaştırması referans tabanlı,
    // bizim instance'larımız farklı DbContext'lerden geldiği için
    // referans eşleşmesi tutmuyor → daha önce seçilen medyalar
    // rozetlenmiyordu. Kendi grid'imizde Id bazlı karşılaştırma yapıyoruz.
    private List<Data.Media> _galleryAllMedia = new();
    private List<Data.Media> _galleryFilteredMedia = new();
    private string _gallerySearch = string.Empty;
    private int _galleryDisplayCount = 15;
    private bool _galleryLoading;

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;

    // ─── Veriler ──────────────────────────────────────────────────
    private List<TryTableSingle> _allItems = new();
    private List<Country> _countries = new();

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;
    private List<TryTableSingle> _pagedItems = new();

    // ─── Ekle modal state ─────────────────────────────────────────
    private TryTableSingle? _addModel;
    private int _addCountryId;
    private int _addStateId;
    private List<States> _addStates = new();
    private List<Cities> _addCities = new();

    // ─── Düzenle modal state ──────────────────────────────────────
    private TryTableSingle? _editModel;
    private int _editCountryId;
    private int _editStateId;
    private List<States> _editStates = new();
    private List<Cities> _editCities = new();

    // ─── Sil modal state ──────────────────────────────────────────
    private TryTableSingle? _deleteTarget;

    // ─── Toplu Sil state ──────────────────────────────────────────
    private readonly HashSet<Guid> _selectedIds = new();
    private bool _allSelected;
    private List<TryTableSingle> _bulkDeletePreview = new();

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI: Şifre çöz (null-safe, hata durumunda orijinal döner)
    // ══════════════════════════════════════════════════════════════

    private static string? Decrypt(string? value)
    {
        if (string.IsNullOrEmpty(value)) return value;
        var result = GlobalSecurityProvider.Decrypt(value);
        // Hata mesajı kontrolü: şifrelenmemiş eski veri de okunabilsin
        return result?.StartsWith("Hata:") == true ? value : result;
    }

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;
        FileService.OnFileSelected += HandleSingleFileSelected;
        // OnSelectionChanged aboneliği KALDIRILDI: galeri seçimi artık parent grid'i
        // tarafından Id bazlı yönetiliyor; FileService'in çoklu seçim event'ine
        // ihtiyaç kalmadı.
        // OnFileUploaded: Upload bileşeni galeri modali içinde duruyor; modal açıkken
        // yeni dosya yüklenirse grid'i yenileyip yeni medyayı göstermek için dinliyoruz.
        FileService.OnFileUploaded += HandleGalleryFileUploaded;

        await Task.WhenAll(
            LoadDataAsync(_searchTerm),
            LoadCountriesAsync()
        );
    }

    // Upload bileşeninden yeni dosya geldiğinde galeri grid'i açıksa listeyi yenile.
    private void HandleGalleryFileUploaded()
    {
        if (_activeMediaSlot != "gallery") return;
        InvokeAsync(async () =>
        {
            await LoadGalleryAllMediaAsync();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        FileService.OnFileSelected -= HandleSingleFileSelected;
        FileService.OnFileUploaded -= HandleGalleryFileUploaded;
        // OnSelectionChanged aboneliği OnInitializedAsync'te de kurulmuyor; abonelik kaldırma yok.
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;

        await InvokeAsync(async () =>
        {
            await LoadDataAsync(_searchTerm);
            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    private async Task LoadDataAsync(string? search)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            // Arama varsa cache kullanma — her sorguda taze veri
            string cacheKey = string.IsNullOrWhiteSpace(search) ? CACHE_KEY : $"{CACHE_KEY}_{search}";
            if (!string.IsNullOrWhiteSpace(search))
                StateHub.ClearCache(cacheKey);

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);
                var q = db.TryTableSingle.AsNoTracking().AsQueryable();

                // Soft Delete filtresi: silinmiş kayıtlar listede görünmez
                // (IsDeleted owned entity — IsDeletedStatu null veya false olanlar gösterilir)
                q = q.Where(x => x.IsDeleted == null || x.IsDeleted.IsDeletedStatu == null || x.IsDeleted.IsDeletedStatu == false);

                // Arama: şifreli alanlar DB'de şifreli olduğundan
                // tam liste çekilip bellek içi filtreleme yapılır.
                // (Ülke/il/şehir şifreli — DB'de LIKE çalışmaz)
                return await q.OrderByDescending(x => x.SelectDateTime).ToListAsync(token);
            }, token);

            if (token.IsCancellationRequested || result == null) return;

            // Bellek içi arama (şifreli alanlar çözülerek)
            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim();
                result = result.Where(x =>
                    Contains(Decrypt(x.Country), s) ||
                    Contains(Decrypt(x.State), s) ||
                    Contains(Decrypt(x.Cities), s)
                ).ToList();
            }

            _allItems = result;
            ApplyPaging(1);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadData", ex);
                await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void ApplyPaging(int page)
    {
        _totalPages = Math.Max(1, (int)Math.Ceiling(_allItems.Count / (double)PAGE_SIZE));
        _currentPage = Math.Clamp(page, 1, _totalPages);
        _pagedItems = _allItems.Skip((_currentPage - 1) * PAGE_SIZE).Take(PAGE_SIZE).ToList();
    }

    private void GoToPage(int page)
    {
        ApplyPaging(page);
        StateHasChanged();
    }

    private async Task LoadCountriesAsync()
    {
        try
        {
            _countries = await StateHub.GetOrLoadAsync("Countries_All", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.Country.AsNoTracking()
                    .OrderBy(c => c.name).ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadCountries", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // CASCADE SELECT (isAdd=true → Ekle modali, false → Düzenle)
    // ══════════════════════════════════════════════════════════════

    private async Task OnCountryChanged(ChangeEventArgs e, bool isAdd)
    {
        int.TryParse(e.Value?.ToString(), out var countryId);
        var name = _countries.FirstOrDefault(c => c.id == countryId)?.name;

        if (isAdd)
        {
            _addCountryId = countryId;
            _addStateId = 0;
            _addStates.Clear();
            _addCities.Clear();
            if (_addModel != null) { _addModel.Country = name; _addModel.State = null; _addModel.Cities = null; }
        }
        else
        {
            _editCountryId = countryId;
            _editStateId = 0;
            _editStates.Clear();
            _editCities.Clear();
            if (_editModel != null) { _editModel.Country = name; _editModel.State = null; _editModel.Cities = null; }
        }

        if (countryId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var states = await db.States.AsNoTracking()
                    .Where(s => s.country_id == countryId)
                    .OrderBy(s => s.name).ToListAsync(_cts.Token);

                if (isAdd) _addStates = states;
                else _editStates = states;
            }
            catch (Exception ex) { await LogError("OnCountryChanged", ex); }
        }
        StateHasChanged();
    }

    private async Task OnStateChanged(ChangeEventArgs e, bool isAdd)
    {
        int.TryParse(e.Value?.ToString(), out var stateId);
        var states = isAdd ? _addStates : _editStates;
        var name = states.FirstOrDefault(s => s.id == stateId)?.name;

        if (isAdd)
        {
            _addStateId = stateId;
            _addCities.Clear();
            if (_addModel != null) { _addModel.State = name; _addModel.Cities = null; }
        }
        else
        {
            _editStateId = stateId;
            _editCities.Clear();
            if (_editModel != null) { _editModel.State = name; _editModel.Cities = null; }
        }

        if (stateId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var cities = await db.Cities.AsNoTracking()
                    .Where(c => c.state_id == stateId)
                    .OrderBy(c => c.name).ToListAsync(_cts.Token);

                if (isAdd) _addCities = cities;
                else _editCities = cities;
            }
            catch (Exception ex) { await LogError("OnStateChanged", ex); }
        }
        StateHasChanged();
    }

    private void OnCityChanged(ChangeEventArgs e, bool isAdd)
    {
        var city = e.Value?.ToString();
        if (isAdd) { if (_addModel != null) _addModel.Cities = city; }
        else { if (_editModel != null) _editModel.Cities = city; }
    }

