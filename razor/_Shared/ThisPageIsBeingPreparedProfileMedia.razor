    private async Task OpenAddModal()
    {
        _addModel = new TryTableSingle { Id = Guid.Empty, SelectDateTime = DateTime.UtcNow, GetDateTime = DateTime.UtcNow };
        _addCountryId = 0;
        _addStateId = 0;
        _addStates.Clear();
        _addCities.Clear();

        // Profil/Kapak medyasını sıfırla (önceki açılıştan kalan seçimler taşmasın)
        _profileMedia = null;
        _coverMedia = null;
        _galleryFiles.Clear();
        _activeMediaSlot = string.Empty;

        await ShowModal("AddModal");
    }

    private async Task OpenEditModal(TryTableSingle item)
    {
        // Şifreli alanları çözerek modele yaz
        _editModel = new TryTableSingle
        {
            Id = item.Id,
            Country = Decrypt(item.Country),
            State = Decrypt(item.State),
            Cities = Decrypt(item.Cities),
            RadioButton = Decrypt(item.RadioButton),
            CheckSliding = item.CheckSliding,
            CheckMarked = item.CheckMarked,
            SelectDateTime = item.SelectDateTime,
            GetDateTime = item.GetDateTime,
            // Owned entity — değerleriyle birlikte yeni instance taşı (referans paylaşmamak için)
            ProfileCoverGallery = item.ProfileCoverGallery == null ? null : new ProfileCoverGallery
            {
                ProfileImagePath = item.ProfileCoverGallery.ProfileImagePath,
                CoverImagePath = item.ProfileCoverGallery.CoverImagePath
            }
        };

        _editCountryId = 0;
        _editStateId = 0;
        _editStates.Clear();
        _editCities.Clear();

        // Profil/Kapak görsellerini UI state'ine geri yükle
        _profileMedia = string.IsNullOrWhiteSpace(_editModel.ProfileCoverGallery?.ProfileImagePath)
            ? null
            : new Data.Media { FileUrl = _editModel.ProfileCoverGallery!.ProfileImagePath, FileName = "Profil" };

        _coverMedia = string.IsNullOrWhiteSpace(_editModel.ProfileCoverGallery?.CoverImagePath)
            ? null
            : new Data.Media { FileUrl = _editModel.ProfileCoverGallery!.CoverImagePath, FileName = "Kapak" };

        _activeMediaSlot = string.Empty;

        // Mevcut galeri kayıtlarını DB'den yükle (ItemGallery → Media join)
        _galleryFiles = await LoadGalleryAsync(item.Id);

        // Cascade preload
        if (!string.IsNullOrWhiteSpace(_editModel.Country))
        {
            var country = _countries.FirstOrDefault(c =>
                string.Equals(c.name, _editModel.Country, StringComparison.OrdinalIgnoreCase));

            if (country != null)
            {
                _editCountryId = country.id;
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                    _editStates = await db.States.AsNoTracking()
                        .Where(s => s.country_id == _editCountryId)
                        .OrderBy(s => s.name).ToListAsync(_cts.Token);

                    if (!string.IsNullOrWhiteSpace(_editModel.State))
                    {
                        var state = _editStates.FirstOrDefault(s =>
                            string.Equals(s.name, _editModel.State, StringComparison.OrdinalIgnoreCase));

                        if (state != null)
                        {
                            _editStateId = state.id;
                            _editCities = await db.Cities.AsNoTracking()
                                .Where(c => c.state_id == _editStateId)
                                .OrderBy(c => c.name).ToListAsync(_cts.Token);
                        }
                    }
                }
                catch (Exception ex) { await LogError("OpenEditModal_Preload", ex); }
            }
        }

        await ShowModal("EditModal");
    }

