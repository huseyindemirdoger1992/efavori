@* ============================================================
   ThisPageIsBeingPrepared.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub — anlık broadcast, debounce, RAM cache
   ✅ GlobalSecurityProvider — Country/State/Cities/RadioButton şifreli
   ✅ TakeLogs — tüm CRUD aksiyonları loglanır
   ✅ Ayrı Ekle / Düzenle / Sil modalleri
   ✅ Seçilenleri Sil → önce onay modali (sayı + liste)
   ✅ 5'li sayfalama
   ✅ Basit, performanslı, kötü sunucuda bile binlerce kullanıcıya cevap
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using razor._Shared.tr.Media

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
@inject FileUploadService FileService

@namespace razor._Shared
@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa",  "/"),
        ("fa fa-table",    "Kayıtlar",   "javascript:void(0)"),
        ("fa fa-list-alt", PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    <button class="btn btn-light btn-sm" @onclick="OpenAddModal" disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Kayıt</span>
    </button>

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light">@_selectedIds.Count seçili</span>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Seçimi Temizle
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-danger btn-sm border-0"
                @onclick="OpenBulkDeleteModal"
                disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Ara"
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_allItems.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Kayıt bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2rem;">
                        <input type="checkbox" class="form-check-input"
                               checked="@_allSelected"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Profil</th>
                    <th>Kapak</th>
                    <th>Ülke</th>
                    <th>İl</th>
                    <th>Şehir</th>
                    <th class="d-none d-md-table-cell">Tarih</th>
                    <th>Kontroller</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>
                        <td class="d-none d-md-table-cell text-secondary small">@(rowNo++)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ProfileCoverGallery?.ProfileImagePath))
                            {
                                <img src="@item.ProfileCoverGallery!.ProfileImagePath"
                                     class="rounded-circle border border-secondary"
                                     style="width:42px;height:42px;object-fit:cover;"
                                     alt="Profil" />
                            }
                            else
                            {
                                <img src="https://efavori.com/_files/main/NoImage.png"
                                     class="rounded-circle border border-secondary"
                                     style="width:42px;height:42px;object-fit:cover;"
                                     alt="Profil" />
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ProfileCoverGallery?.CoverImagePath))
                            {
                                <img src="@item.ProfileCoverGallery!.CoverImagePath"
                                     class="rounded border border-secondary"
                                     style="width:72px;height:42px;object-fit:cover;"
                                     alt="Kapak" />
                            }
                            else
                            {
                                <img src="https://efavori.com/_files/main/NoImage.png"
                                     class="rounded border border-secondary"
                                     style="width:72px;height:42px;object-fit:cover;"
                                     alt="Kapak" />
                            }
                        </td>
                        <td><div class="fw-semibold">@(Decrypt(item.Country))</div></td>
                        <td><div class="fw-semibold">@(Decrypt(item.State))</div></td>
                        <td><div class="fw-semibold">@(Decrypt(item.Cities))</div></td>
                        <td class="d-none d-md-table-cell text-nowrap">
                            <div class="small">@item.SelectDateTime.ToString("dd.MM.yyyy") | @item.SelectDateTime.ToString("HH:mm")</div>
                        </td>
                        <td>
                            <span class="me-2" title="Kayan Kontrol">
                                <i class="fa @(item.CheckSliding == true ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary")"></i>
                            </span>
                            <span title="İşaretli">
                                <i class="fa @(item.CheckMarked == true ? "fa-check-square text-info" : "fa-square-o text-secondary")"></i>
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_allItems.Count kayıt
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                    </li>

                    @for (int p = 1; p <= _totalPages; p++)
                    {
                        var pg = p;
                        <li class="page-item @(_currentPage == pg ? "active" : "")">
                            <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                    @onclick="() => GoToPage(pg)">
                                @pg
                            </button>
                        </li>
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Ekle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="AddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-plus me-1"></i>Yeni Kayıt
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam     Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>

                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_addModel != null)
                {
                    <!-- Kapak Fotoğrafı -->
                    <div class="position-relative">
                        @if (_coverMedia is not null)
                        {
                            <img src="@_coverMedia.FileUrl"
                                 class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="@_coverMedia.FileName">
                        }
                        else
                        {
                            <img src="https://efavori.com/_files/main/NoImage.png"
                                 class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="Kapak Fotoğrafı">
                        }
                        <div class="position-absolute bottom-0 end-0 m-3">
                            <button type="button" class="btn btn-outline-primary btn-sm fw-bold shadow-sm border-0 text-dark"
                                    @onclick='() => OpenMediaModal("cover")'>
                                <i class="fa fa-camera me-2"></i>Kapak Fotoğrafını Düzenle
                            </button>
                        </div>
                    </div>
                    <!-- Profil Fotoğrafı -->
                    <div class="card-body px-4 pt-0">
                        <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end" style="margin-top: -100px;">
                            <div class="position-relative">
                                @if (_profileMedia is not null)
                                {
                                    <img src="@_profileMedia.FileUrl"
                                         class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                         width="168" height="168" style="object-fit: cover;" alt="@_profileMedia.FileName">
                                }
                                else
                                {
                                    <img src="https://efavori.com/_files/main/NoImage.png"
                                         class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                         width="168" height="168" style="object-fit: cover;" alt="No Image">
                                }
                                <button type="button"
                                        class="btn btn-outline-light border-0 btn-sm rounded-circle position-absolute bottom-0 end-0 mb-2 me-1 shadow d-flex align-items-center justify-content-center"
                                        style="width: 36px; height: 36px;"
                                        @onclick='() => OpenMediaModal("profile")'>
                                    <i class="fa fa-camera text-dark" style="margin-left:5px;"></i>
                                </button>
                            </div>
                        </div>
                    </div>


                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addCountryId"
                                    @onchange="e => OnCountryChanged(e, true)">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addStateId"
                                    @onchange="e => OnStateChanged(e, true)"
                                    disabled="@(!_addStates.Any())">
                                <option value="0">@(_addStates.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _addStates)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addModel.Cities"
                                    @onchange="e => OnCityChanged(e, true)"
                                    disabled="@(!_addCities.Any())">
                                <option value="">@(_addCities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _addCities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-calendar me-1"></i>Tarih</label>
                            <input type="datetime-local"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_addModel.SelectDateTime" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-dot-circle-o me-1"></i>Seçenek</label>
                            <div class="d-flex gap-4 mt-1">
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="add_rb_A" name="addRadio"
                                           checked="@(_addModel.RadioButton == "A")"
                                           @onchange="@(() => _addModel.RadioButton = "A")" />
                                    <label class="form-check-label text-white-50" for="add_rb_A">Seçenek A</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="add_rb_B" name="addRadio"
                                           checked="@(_addModel.RadioButton == "B")"
                                           @onchange="@(() => _addModel.RadioButton = "B")" />
                                    <label class="form-check-label text-white-50" for="add_rb_B">Seçenek B</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="add_chkSliding" @bind="_addModel.CheckSliding" />
                                <label class="form-check-label text-white-50" for="add_chkSliding">Kayan Kontrol</label>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="add_chkMarked" @bind="_addModel.CheckMarked" />
                                <label class="form-check-label text-white-50" for="add_chkMarked">İşaretli</label>
                            </div>
                        </div>

                        @* ─── Galeri ─── *@
                        <div class="col-12">
                            <hr class="border-secondary my-1" />
                            <label class="form-label text-white-50 small mb-2">
                                <i class="fa fa-picture-o me-1"></i>Galeri
                                @if (_galleryFiles.Any())
                                {
                                    <span class="badge bg-primary ms-1">@_galleryFiles.Count</span>
                                }
                            </label>
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 mb-2"
                                    @onclick="OpenGalleryModal">
                                <i class="fa fa-folder-open-o me-1"></i>Medyadan Seç
                            </button>
                            @if (_galleryFiles.Any())
                            {
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var m in _galleryFiles.ToList())
                                    {
                                        <div class="position-relative">
                                            <img src="@m.FileUrl" class="rounded border border-secondary"
                                                 style="width:65px;height:65px;object-fit:cover;" alt="@m.FileName" />
                                            <button type="button"
                                                    class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center border-0"
                                                    style="width:20px;height:20px;font-size:0.7rem;margin-top:-5px;margin-right:-5px;"
                                                    @onclick="() => _galleryFiles.Remove(m)">
                                                <i class="fa fa-times text-white" style="margin-left:5px"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="AddAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-plus me-1"></i><span>Yeni Kayıt Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Düzenle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(255,215,0,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-pencil me-1"></i>Kayıt Düzenle
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam     Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>

                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_editModel != null)
                {
                    <!-- Kapak Fotoğrafı -->
                    <div class="position-relative">
                        @if (_coverMedia is not null)
                        {
                            <img src="@_coverMedia.FileUrl"
                                 class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="@_coverMedia.FileName">
                        }
                        else
                        {
                            <img src="https://efavori.com/_files/main/NoImage.png"
                                 class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="Kapak Fotoğrafı">
                        }
                        <div class="position-absolute bottom-0 end-0 m-3">
                            <button type="button" class="btn btn-outline-primary btn-sm fw-bold shadow-sm border-0 text-dark"
                                    @onclick='() => OpenMediaModal("cover")'>
                                <i class="fa fa-camera me-2"></i>Kapak Fotoğrafını Düzenle
                            </button>
                        </div>
                    </div>
                    <!-- Profil Fotoğrafı -->
                    <div class="card-body px-4 pt-0">
                        <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end" style="margin-top: -100px;">
                            <div class="position-relative">
                                @if (_profileMedia is not null)
                                {
                                    <img src="@_profileMedia.FileUrl"
                                         class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                         width="168" height="168" style="object-fit: cover;" alt="@_profileMedia.FileName">
                                }
                                else
                                {
                                    <img src="https://efavori.com/_files/main/NoImage.png"
                                         class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                         width="168" height="168" style="object-fit: cover;" alt="No Image">
                                }
                                <button type="button"
                                        class="btn btn-outline-light border-0 btn-sm rounded-circle position-absolute bottom-0 end-0 mb-2 me-1 shadow d-flex align-items-center justify-content-center"
                                        style="width: 36px; height: 36px;"
                                        @onclick='() => OpenMediaModal("profile")'>
                                    <i class="fa fa-camera text-dark" style="margin-left:5px;"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editCountryId"
                                    @onchange="e => OnCountryChanged(e, false)">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editStateId"
                                    @onchange="e => OnStateChanged(e, false)"
                                    disabled="@(!_editStates.Any())">
                                <option value="0">@(_editStates.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _editStates)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editModel.Cities"
                                    @onchange="e => OnCityChanged(e, false)"
                                    disabled="@(!_editCities.Any())">
                                <option value="">@(_editCities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _editCities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-calendar me-1"></i>Tarih</label>
                            <input type="datetime-local"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.SelectDateTime" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-dot-circle-o me-1"></i>Seçenek</label>
                            <div class="d-flex gap-4 mt-1">
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="edit_rb_A" name="editRadio"
                                           checked="@(_editModel.RadioButton == "A")"
                                           @onchange="@(() => _editModel.RadioButton = "A")" />
                                    <label class="form-check-label text-white-50" for="edit_rb_A">Seçenek A</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="edit_rb_B" name="editRadio"
                                           checked="@(_editModel.RadioButton == "B")"
                                           @onchange="@(() => _editModel.RadioButton = "B")" />
                                    <label class="form-check-label text-white-50" for="edit_rb_B">Seçenek B</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="edit_chkSliding" @bind="_editModel.CheckSliding" />
                                <label class="form-check-label text-white-50" for="edit_chkSliding">Kayan Kontrol</label>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="edit_chkMarked" @bind="_editModel.CheckMarked" />
                                <label class="form-check-label text-white-50" for="edit_chkMarked">İşaretli</label>
                            </div>
                        </div>

                        @* ─── Galeri ─── *@
                        <div class="col-12">
                            <hr class="border-secondary my-1" />
                            <label class="form-label text-white-50 small mb-2">
                                <i class="fa fa-picture-o me-1"></i>Galeri
                                @if (_galleryFiles.Any())
                                {
                                    <span class="badge bg-primary ms-1">@_galleryFiles.Count</span>
                                }
                            </label>
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 mb-2"
                                    @onclick="OpenGalleryModal">
                                <i class="fa fa-folder-open-o me-1"></i>Medyadan Seç
                            </button>
                            @if (_galleryFiles.Any())
                            {
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var m in _galleryFiles.ToList())
                                    {
                                        <div class="position-relative">
                                            <img src="@m.FileUrl" class="rounded border border-secondary"
                                                 style="width:65px;height:65px;object-fit:cover;" alt="@m.FileName" />
                                            <button type="button"
                                                    class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center border-0"
                                                    style="width:20px;height:20px;font-size:0.7rem;margin-top:-5px;margin-right:-5px;"
                                                    @onclick="() => _galleryFiles.Remove(m)">
                                                <i class="fa fa-times text-white" style="margin-left:5px"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-warning btn-sm"
                        @onclick="UpdateAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-save me-1"></i><span>Değişiklikleri Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Tekli Sil (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>Silme İşlemi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam     Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>

                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-white-50 small mb-3">Bu kaydı silmek istediğinizden emin misiniz?</p>
                @if (_deleteTarget != null)
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(Decrypt(_deleteTarget.Country) ?? "—")" disabled />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(Decrypt(_deleteTarget.State) ?? "—")" disabled />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(Decrypt(_deleteTarget.Cities) ?? "—")" disabled />
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="DeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>Evet, Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Toplu Sil Onayı (Ayrı Modal)
   Seçilen kayıtların sayısı ve listesi gösterilir
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="BulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>
                    Toplu Silme — @_selectedIds.Count kayıt seçildi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam     Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>

                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-warning small mb-3">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    Aşağıdaki <strong>@_selectedIds.Count</strong> kayıt kalıcı olarak silinecek. Bu işlem geri alınamaz.
                </p>

                @if (_bulkDeletePreview.Any())
                {
                    <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                        <table class="table table-sm table-dark table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th class="small">#</th>
                                    <th class="small">Ülke</th>
                                    <th class="small">İl</th>
                                    <th class="small">Şehir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int n = 1;
                                }
                                @foreach (var item in _bulkDeletePreview)
                                {
                                    <tr>
                                        <td class="small text-secondary">@(n++)</td>
                                        <td class="small">@(Decrypt(item.Country) ?? "—")</td>
                                        <td class="small">@(Decrypt(item.State) ?? "—")</td>
                                        <td class="small">@(Decrypt(item.Cities) ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"
                        @onclick="() => _bulkDeletePreview.Clear()">
                    <i class="fa fa-arrow-left me-1"></i>Vazgeç
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="BulkDeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>@_selectedIds.Count Kaydı Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

