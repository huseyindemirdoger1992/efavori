    // ══════════════════════════════════════════════════════════════
    // CRUD — Ekle
    // ══════════════════════════════════════════════════════════════

    private async Task AddAsync()
    {
        if (_isProcessing || _addModel == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            // Şifrele
            _addModel.Country = GlobalSecurityProvider.Encrypt(_addModel.Country ?? "");
            _addModel.State = GlobalSecurityProvider.Encrypt(_addModel.State ?? "");
            _addModel.Cities = GlobalSecurityProvider.Encrypt(_addModel.Cities ?? "");
            _addModel.RadioButton = GlobalSecurityProvider.Encrypt(_addModel.RadioButton ?? "");

            _addModel.Id = Guid.NewGuid();
            _addModel.UserId = use.Id;
            _addModel.GetDateTime = DateTime.UtcNow;

            // Profil/Kapak görsel yollarını owned entity'ye yaz
            _addModel.ProfileCoverGallery = new ProfileCoverGallery
            {
                ProfileImagePath = _profileMedia?.FileUrl,
                CoverImagePath = _coverMedia?.FileUrl
            };

            // Soft Delete owned entity'sini başlat (yeni kayıt — silinmemiş durumda)
            _addModel.IsDeleted = new IsDeleted
            {
                IsDeletedStatu = false,
                DeletedAtDate = null
            };

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.TryTableSingle.Add(_addModel);
            await db.SaveChangesAsync(_cts.Token);

            // Galeri kayıtlarını ItemGallery tablosuna ekle
            if (_galleryFiles.Any())
            {
                var galleryItems = _galleryFiles.Select(m => new ItemGallery
                {
                    UserId = use!.Id,
                    ItemId = _addModel.Id,
                    ItemType = "Gallery",
                    MediaId = m.Id,
                    ItemAddDate = DateTime.UtcNow,
                    IsDelete = false
                }).ToList();

                await db.ItemGallery.AddRangeAsync(galleryItems, _cts.Token);
                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("AddModal");
            _addModel = null;
            _profileMedia = null;
            _coverMedia = null;
            _galleryFiles.Clear();
            _isProcessing = false;

            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Add");
            await Notify("success", "Başarılı", "Kayıt eklendi.");
        }
        catch (Exception ex)
        {
            await LogError("AddAsync", ex);
            await Notify("danger", "Hata", "Kayıt sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Güncelle
    // ══════════════════════════════════════════════════════════════

    private async Task UpdateAsync()
    {
        if (_isProcessing || _editModel == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.TryTableSingle.FindAsync(new object[] { _editModel.Id }, _cts.Token);

            if (existing == null)
            {
                await Notify("warning", "Uyarı", "Kayıt artık mevcut değil.");
                return;
            }

            // Şifrele ve güncelle
            existing.Country = GlobalSecurityProvider.Encrypt(_editModel.Country ?? "");
            existing.State = GlobalSecurityProvider.Encrypt(_editModel.State ?? "");
            existing.Cities = GlobalSecurityProvider.Encrypt(_editModel.Cities ?? "");
            existing.RadioButton = GlobalSecurityProvider.Encrypt(_editModel.RadioButton ?? "");
            existing.CheckSliding = _editModel.CheckSliding;
            existing.CheckMarked = _editModel.CheckMarked;
            existing.SelectDateTime = _editModel.SelectDateTime;

            // Profil/Kapak görsel yollarını owned entity'ye yaz
            existing.ProfileCoverGallery = new ProfileCoverGallery
            {
                ProfileImagePath = _profileMedia?.FileUrl,
                CoverImagePath = _coverMedia?.FileUrl
            };

            // Galeri: TryTableSingle.IsDeleted mantığıyla tutarlı SOFT DELETE.
            // Mevcut (silinmemiş) ItemGallery kayıtları kalıcı olarak silinmez;
            // sadece IsDelete = true olarak işaretlenir (audit izi korunur).
            // Yeniden seçilen MediaId'ler için daha önce soft delete edilmiş kayıt varsa
            // o satır yeniden aktive edilir (yeni satır oluşturmak yerine) — bu hem
            // tablonun şişmesini önler hem de geçmiş izini bozmaz.
            var oldGallery = await db.ItemGallery
                .Where(g => g.ItemId == existing.Id && g.ItemType == "Gallery")
                .ToListAsync(_cts.Token);

            var selectedMediaIds = _galleryFiles.Select(m => m.Id).ToHashSet();

            // Artık seçili olmayan, aktif kayıtları soft delete et
            foreach (var g in oldGallery)
            {
                var stillSelected = g.MediaId.HasValue && selectedMediaIds.Contains(g.MediaId.Value);

                if (!stillSelected && g.IsDelete != true)
                {
                    // Aktif → silindi
                    g.IsDelete = true;
                }
                else if (stillSelected && g.IsDelete == true)
                {
                    // Daha önce soft delete edilmiş ama tekrar seçildi → yeniden aktive et
                    g.IsDelete = false;
                    g.ItemAddDate = DateTime.UtcNow;
                }
            }

            // Sadece DB'de hiç kaydı olmayan (ne aktif ne soft-deleted) yeni MediaId'ler eklenir
            var existingMediaIds = oldGallery
                .Where(g => g.MediaId.HasValue)
                .Select(g => g.MediaId!.Value)
                .ToHashSet();

            var trulyNewMedia = _galleryFiles
                .Where(m => !existingMediaIds.Contains(m.Id))
                .ToList();

            if (trulyNewMedia.Any())
            {
                var newGallery = trulyNewMedia.Select(m => new ItemGallery
                {
                    UserId = use!.Id,
                    ItemId = existing.Id,
                    ItemType = "Gallery",
                    MediaId = m.Id,
                    ItemAddDate = DateTime.UtcNow,
                    IsDelete = false
                }).ToList();

                await db.ItemGallery.AddRangeAsync(newGallery, _cts.Token);
            }

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("EditModal");
            _editModel = null;
            _profileMedia = null;
            _coverMedia = null;
            _galleryFiles.Clear();
            _isProcessing = false;

            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Update");
            await Notify("success", "Başarılı", "Kayıt güncellendi.");
        }
        catch (Exception ex)
        {
            await LogError("UpdateAsync", ex);
            await Notify("danger", "Hata", "Güncelleme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Tekli Sil
    // ══════════════════════════════════════════════════════════════

    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.TryTableSingle.FindAsync(new object[] { _deleteTarget.Id }, _cts.Token);

            if (entity != null)
            {
                // Bağlı galeri kayıtlarını soft delete et (ItemGallery.IsDelete = true)
                var galleryItems = await db.ItemGallery
                    .Where(g => g.ItemId == entity.Id && g.ItemType == "Gallery" && g.IsDelete != true)
                    .ToListAsync(_cts.Token);

                foreach (var g in galleryItems)
                    g.IsDelete = true;

                // Ana kaydı soft delete et (IsDeleted owned entity)
                entity.IsDeleted ??= new IsDeleted();
                entity.IsDeleted.IsDeletedStatu = true;
                entity.IsDeleted.DeletedAtDate = DateTime.UtcNow;

                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("DeleteModal");
            _deleteTarget = null;
            _isProcessing = false;

            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Delete");
            await Notify("success", "Silindi", "Kayıt başarıyla silindi.");
        }
        catch (Exception ex)
        {
            await LogError("DeleteAsync", ex);
            await Notify("danger", "Hata", "Silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Sil
    // ══════════════════════════════════════════════════════════════

    private async Task BulkDeleteConfirmedAsync()
    {
        if (_isProcessing || !_selectedIds.Any()) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();
            var count = ids.Count;

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var now = DateTime.UtcNow;

            // Bağlı galeri kayıtlarını toplu soft delete (ItemGallery.IsDelete = true)
            await db.ItemGallery
                .Where(g => ids.Contains(g.ItemId!.Value) && g.ItemType == "Gallery" && g.IsDelete != true)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(g => g.IsDelete, true),
                    _cts.Token);

            // Ana kayıtları toplu soft delete (IsDeleted owned entity alanları)
            await db.TryTableSingle
                .Where(x => ids.Contains(x.Id))
                .ExecuteUpdateAsync(s => s
                    .SetProperty(x => x.IsDeleted!.IsDeletedStatu, true)
                    .SetProperty(x => x.IsDeleted!.DeletedAtDate, now),
                    _cts.Token);

            _selectedIds.Clear();
            _allSelected = false;
            _bulkDeletePreview.Clear();

            await HideModal("BulkDeleteModal");
            _isProcessing = false;

            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkDelete ({count})");
            await Notify("success", "Silindi", $"{count} kayıt silindi.");
        }
        catch (Exception ex)
        {
            await LogError("BulkDelete", ex);
            await Notify("danger", "Hata", "Toplu silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // TOPLU SEÇİM
    // ══════════════════════════════════════════════════════════════

    private void ToggleRowSelection(Guid id)
    {
        if (!_selectedIds.Remove(id)) _selectedIds.Add(id);
        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (_allSelected)
            _selectedIds.Clear();
        else
            foreach (var item in _allItems)
                _selectedIds.Add(item.Id);

        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _allSelected = false;
        StateHasChanged();
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI
    // ══════════════════════════════════════════════════════════════

    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    // Resim seçim modalini açar — dış modal (AddModal/EditModal) açık kalır,
    // backdrop=false + manuel z-index sayesinde Bootstrap'in "diğerini kapat" davranışı tetiklenmez
    private async Task OpenMediaModal(string slot)
    {
        _activeMediaSlot = slot;
        var modalId = slot == "cover" ? "modalCoverList" : "modalProfileList";
        await ShowModal(modalId);
    }

    // Galeri modalini açar (çoklu seçim).
    //
    // Artık FileService event'lerine bağlı değiliz; modal içindeki grid
    // doğrudan _galleryAllMedia üzerinden render olur ve "Seçildi" rozeti
    // _galleryFiles'taki Id'lere göre Id bazlı eşleştirme ile çizilir.
    private async Task OpenGalleryModal()
    {
        _activeMediaSlot = "gallery";
        _gallerySearch = string.Empty;
        _galleryDisplayCount = 15;

        // Kullanıcının tüm medyalarını yükle (modal her açıldığında taze veri)
        await LoadGalleryAllMediaAsync();

        await ShowModal("modalGalleryList");
    }

    // Kullanıcının tüm medyalarını DB'den çeker (galeri grid'i için).
    private async Task LoadGalleryAllMediaAsync()
    {
        if (use == null) return;
        _galleryLoading = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _galleryAllMedia = await db.Media
                .AsNoTracking()
                .Where(m => m.IsDeletedStatu != true && m.UserId == use.Id)
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync(_cts.Token);
            ApplyGalleryFilter();
        }
        catch (Exception ex) { await LogError("LoadGalleryAllMedia", ex); }
        finally
        {
            _galleryLoading = false;
            StateHasChanged();
        }
    }

    // Arama kutusu inputu — anlık filtre.
    private void OnGallerySearchInput(ChangeEventArgs e)
    {
        _gallerySearch = e.Value?.ToString() ?? string.Empty;
        _galleryDisplayCount = 15;
        ApplyGalleryFilter();
    }

    // Arama kutusunu temizler ve filtreyi yeniden uygular.
    private void ClearGallerySearch()
    {
        _gallerySearch = string.Empty;
        _galleryDisplayCount = 15;
        ApplyGalleryFilter();
    }

    // _galleryAllMedia'yı _gallerySearch'e göre filtreleyip _galleryFilteredMedia'ya yazar.
    private void ApplyGalleryFilter()
    {
        if (string.IsNullOrWhiteSpace(_gallerySearch))
        {
            _galleryFilteredMedia = _galleryAllMedia.ToList();
        }
        else
        {
            var s = _gallerySearch.Trim();
            _galleryFilteredMedia = _galleryAllMedia
                .Where(m => m.FileName != null && m.FileName.Contains(s, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // Galeri grid'inde bir karta tıklanınca: Id bazlı toggle.
    private void ToggleGalleryItem(Data.Media m)
    {
        var existing = _galleryFiles.FirstOrDefault(x => x.Id == m.Id);
        if (existing != null)
        {
            _galleryFiles.Remove(existing);
        }
        else
        {
            _galleryFiles.Add(m);
        }
    }

    // Görsel/video uzantı yardımcıları (galeri grid'i için).
    private static readonly string[] _galleryImageExt =
        { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tiff", ".tif", ".heic", ".heif", ".svg", ".ico", ".avif" };
    private static readonly string[] _galleryVideoExt =
        { ".mp4", ".mov", ".avi", ".mkv", ".wmv", ".flv", ".webm", ".mpeg", ".mpg" };

    private static bool IsGalleryImage(string ext) => _galleryImageExt.Contains(ext);
    private static bool IsGalleryVideo(string ext) => _galleryVideoExt.Contains(ext);

    private async Task CloseMediaModal()
    {
        // Slot'a göre doğru modalı kapat
        var modalId = _activeMediaSlot switch
        {
            "cover" => "modalCoverList",
            "gallery" => "modalGalleryList",
            _ => "modalProfileList"
        };
        await HideModal(modalId);
        _activeMediaSlot = string.Empty;
    }

    // Tekli seçim handler — FileService.OnFileSelected event'inden tetiklenir.
    // Aktif slot'a göre profil veya kapak medyasını set eder.
    private void HandleSingleFileSelected(Data.Media media)
    {
        switch (_activeMediaSlot)
        {
            case "profile": _profileMedia = media; break;
            case "cover": _coverMedia = media; break;
            default: return;
        }
        InvokeAsync(StateHasChanged);
    }

    // Mevcut kayda ait galeri görsellerini DB'den yükler (ItemGallery → Media join)
    private async Task<List<Data.Media>> LoadGalleryAsync(Guid itemId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var mediaIds = await db.ItemGallery
                .Where(g => g.ItemId == itemId && g.ItemType == "Gallery" && g.IsDelete != true)
                .Select(g => g.MediaId)
                .ToListAsync(_cts.Token);

            if (!mediaIds.Any()) return new();

            return await db.Media
                .Where(m => mediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                .ToListAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            await LogError("LoadGalleryAsync", ex);
            return new();
        }
    }

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://picsum.photos/120");
    }

    private async Task LogError(string action, Exception ex)
    {
        try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); }
        catch { }
    }
}
