@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using api
@using data
@using Data
@using Microsoft.JSInterop
@using api.tr
@using data._Shared
@using razor._Shared
@inject IJSRuntime JSRuntime
@code {
    [Parameter]
    public Users? _use { get; set; }
    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<header>
    <div class="topbar align-items-center">
        <nav class="navbar navbar-expand gap-3">

            <div class="mobile-toggle-menu">
                <i class='bx bx-menu'></i>
            </div>

            <div class="search-bar flex-grow-1 d-none d-md-block">
                <form action="/@culture/Public/Search/Wanted/" method="post" class="position-relative search-bar-box">
                    <input type="search" name="SearchWantedText" id="site-search-desktop"
                           class="form-control search-control pe-5"
                           placeholder="Ara"
                           autocomplete="off">
                    <button type="submit" class="btn position-absolute top-50 translate-middle-y end-0 border-0 bg-transparent">
                        <i class="fa fa-search text-dark"></i>
                    </button>
                    <span class="position-absolute top-50 search-close translate-middle-y" style="right: 45px; cursor: pointer;">
                        <i class='bx bx-x'></i>
                    </span>
                </form>
            </div>

            <div class="top-menu ms-auto">
                <ul class="navbar-nav align-items-center gap-1">
                    <LogOutTimer _use="@_use" />
                    @*
                     <Language _use="@_use" />
                    *@
                    <Infos use="@_use" />
                    <ShortCuts _use="@_use" />
                    <ShopCart use="@_use" />

                    <li class="nav-item d-md-none">
                        <a class="nav-link"
                           data-bs-toggle="collapse"
                           data-bs-target="#mobileSearchBar"
                           aria-expanded="false"
                           aria-controls="mobileSearchBar"
                           href="#">
                            <i class="fa fa-search"></i>
                        </a>
                    </li>
                </ul>
            </div>

            <ProfileMenu _use="@_use" />

        </nav>

        <div class="collapse d-md-none" id="mobileSearchBar">
            <div class="px-3 pb-2 pt-1">
                <form action="/@culture/Public/Search/Wanted/" method="post" class="position-relative search-bar-box">
                    <input type="search" name="SearchWantedText" id="site-search-mobile"
                           class="form-control search-control pe-5"
                           placeholder="Ara"
                           autocomplete="off">
                    <button type="submit" class="btn position-absolute top-50 translate-middle-y end-0 border-0 bg-transparent">
                        <i class="fa fa-search text-dark"></i>
                    </button>
                    <span class="position-absolute top-50 search-close translate-middle-y" style="right: 45px; cursor: pointer;">
                        <i class='bx bx-x'></i>
                    </span>
                </form>
            </div>
        </div>

    </div>
</header>