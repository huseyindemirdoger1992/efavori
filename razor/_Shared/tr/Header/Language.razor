﻿@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Localization
@using Microsoft.EntityFrameworkCore
@using data
@inject NavigationManager NavManager
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject IJSRuntime JS

@rendermode InteractiveServer

@code {
    [Parameter]
    public Users? _use { get; set; }

    private static readonly string[] SupportedCultures = ["tr", "az", "de", "en", "es", "fr", "hi", "pt", "ru", "zh"];

    private static readonly Dictionary<string, (string Flag, string Name)> LanguageInfo = new()
    {
        ["tr"] = ("tr.svg", "Türkçe"),
        ["az"] = ("az.svg", "Azərbaycan (Hazırlanıyor...)"),
        ["de"] = ("de.svg", "Deutsch (Hazırlanıyor...)"),
        ["en"] = ("gb.svg", "English (Hazırlanıyor...)"),
        ["es"] = ("es.svg", "Español (Hazırlanıyor...)"),
        ["fr"] = ("fr.svg", "Français (Hazırlanıyor...)"),
        ["hi"] = ("in.svg", "हिन्दी (Hazırlanıyor...)"),
        ["pt"] = ("pt.svg", "Português (Hazırlanıyor...)"),
        ["ru"] = ("ru.svg", "Русский (Hazırlanıyor...)"),
        ["zh"] = ("cn.svg", "中文 (Hazırlanıyor...)")
    };

    private string CurrentLanguage => _use?.Language ?? GetCurrentCultureFromUrl();

    private string FlagPath => LanguageInfo.TryGetValue(CurrentLanguage, out var info) ? info.Flag : "tr.svg";

    private string GetCurrentCultureFromUrl()
    {
        var uri = new Uri(NavManager.Uri);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length > 0 && SupportedCultures.Contains(segments[0].ToLower()))
        {
            return segments[0].ToLower();
        }
        return "en";
    }

    private async Task SelectLanguage(string langCode)
    {
        if (_use != null)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                _use.Language = langCode;
                db.Users.Update(_use);
                await db.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                await LogErrorAsync(ex, "Dil değiştirme hatası");
            }
        }

        // Yeni URL'yi hesapla
        var newUrl = GetNewLanguageUrl(langCode);

        // Cookie kaydet ve sayfayı JavaScript ile yenile (tek seferde)
        await JS.InvokeVoidAsync("setLanguageAndRedirect", langCode, newUrl);
    }

    private string GetNewLanguageUrl(string langCode)
    {
        var uri = new Uri(NavManager.Uri);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();

        if (segments.Count > 0 && SupportedCultures.Contains(segments[0].ToLower()))
        {
            segments[0] = langCode;
        }
        else
        {
            segments.Insert(0, langCode);
        }

        return "/" + string.Join("/", segments) + uri.Query;
    }

    private async Task LogErrorAsync(Exception ex, string title)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Logs.Add(new Logs
            {
                Title = title,
                Exception = ex.Message,
                Date = DateTime.Now
            });
            await db.SaveChangesAsync();
        }
        catch
        {
            // Loglama hatası sessizce geçilir
        }
    }
}

<li class="nav-item dropdown dropdown-laungauge d-sm-flex">
    <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="javascript:void(0)"
       data-bs-toggle="dropdown" aria-expanded="false">
        <img src="/assets/flags/1x1/@FlagPath" width="22" alt="@CurrentLanguage">
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
        @foreach (var lang in LanguageInfo)
        {
            <li>
                <button type="button" class="dropdown-item d-flex align-items-center py-2"
                        @onclick="() => SelectLanguage(lang.Key)">
                    <img src="/assets/flags/1x1/@lang.Value.Flag" width="20" alt="@lang.Value.Name">
                    <span class="ms-2">@lang.Value.Name</span>
                </button>
            </li>
        }
    </ul>
</li>