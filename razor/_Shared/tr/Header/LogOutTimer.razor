@rendermode InteractiveServer
@using data
@using data.Owned;
@using data._Carts;
@using data._Categories;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;


@using System.Timers
@using System.Globalization
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject IJSRuntime JS

@if (IsActive)
{
    <li class="nav-item dropdown dropdown-large">
        <a class="nav-link dropdown-toggle dropdown-toggle-nocaret position-relative"
           href="#" data-bs-toggle="modal" data-bs-target="#LogOutTimerInfo" style="padding: 10px;">
            <span id="timer-display"
                  class="position-absolute top-50 start-50 translate-middle badge rounded-pill bg-dark text-danger"
                  style="font-size: 0.65rem; z-index: 2; pointer-events: none;">
                @TimeDisplay
            </span>
        </a>
    </li>
}

@code {
    [Parameter] public Users? _use { get; set; }

    private Timer? _timer;
    private int _timeLeft;
    private int _initialTime;
    private DotNetObjectReference<LogOutTimer>? _objRef;
    private bool _jsInitialized;
    private bool _disposed;

    // LogOutTimer değeri null, 0 veya negatifse bileşen tamamen pasif kalır
    private bool IsActive => _use?.LogOutTimer is > 0;

    private string culture => CultureInfo.CurrentCulture.TwoLetterISOLanguageName;

    private string TimeDisplay => $"{_timeLeft / 60}:{(_timeLeft % 60):D2}";

    // ═══════════════════════════════════════════════════════════════
    // LIFECYCLE
    // ═══════════════════════════════════════════════════════════════

    protected override void OnInitialized()
    {
        if (!IsActive) return;

        _initialTime = _use!.LogOutTimer!.Value;
        _timeLeft = _initialTime;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsActive || _jsInitialized || _disposed) return;

        _jsInitialized = true;

        try
        {
            // JS fonksiyonlarını enjekte et (inline <script> Blazor'da çalışmaz)
            await JS.InvokeVoidAsync("eval", LogoutTimerJs);

            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("logoutTimerHelper.initialize", _objRef);

            StartTimer();
        }
        catch (JSDisconnectedException)
        {
            // Circuit zaten kapanmış — sessizce geç
        }
        catch (ObjectDisposedException)
        {
            // Component dispose olmuş
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // TIMER
    // ═══════════════════════════════════════════════════════════════

    private void StartTimer()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.AutoReset = true;
        _timer.Enabled = true;
    }

    private async void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (_disposed) return;

        _timeLeft--;

        if (_timeLeft <= 0)
        {
            _timer?.Stop();

            try
            {
                await InvokeAsync(() =>
                {
                    NavManager.NavigateTo($"/{culture}/Account/Logout", forceLoad: true);
                });
            }
            catch (ObjectDisposedException) { }
        }
        else
        {
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
        }
    }

    [JSInvokable]
    public void ResetTimer()
    {
        if (_disposed) return;
        _timeLeft = _initialTime;
    }

    // ═══════════════════════════════════════════════════════════════
    // DISPOSE
    // ═══════════════════════════════════════════════════════════════

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        if (_timer != null)
        {
            _timer.Elapsed -= OnTimerElapsed;
            _timer.Dispose();
            _timer = null;
        }

        if (_objRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("logoutTimerHelper.dispose");
            }
            catch
            {
                // Circuit kapalı veya JS erişilemez — sessizce geç
            }

            _objRef.Dispose();
            _objRef = null;
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // JS — Blazor component içinde <script> çalışmaz,
    //       OnAfterRenderAsync'te eval ile enjekte ediyoruz.
    // ═══════════════════════════════════════════════════════════════

    private const string LogoutTimerJs = """
        if (!window.logoutTimerHelper) {
            window.logoutTimerHelper = {
                dotNetRef: null,
                events: ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click', 'wheel'],
                _throttle: null,

                handleActivity: function () {
                    // Throttle: Her 2 saniyede en fazla 1 çağrı (performans)
                    if (window.logoutTimerHelper._throttle) return;
                    window.logoutTimerHelper._throttle = setTimeout(function () {
                        window.logoutTimerHelper._throttle = null;
                    }, 2000);

                    if (window.logoutTimerHelper.dotNetRef) {
                        window.logoutTimerHelper.dotNetRef.invokeMethodAsync('ResetTimer');
                    }
                },

                initialize: function (dotNetReference) {
                    // Önceki dinleyicileri temizle (yeniden bağlantı durumu)
                    window.logoutTimerHelper.dispose();
                    window.logoutTimerHelper.dotNetRef = dotNetReference;
                    window.logoutTimerHelper.events.forEach(function (event) {
                        document.addEventListener(event, window.logoutTimerHelper.handleActivity, true);
                    });
                },

                dispose: function () {
                    window.logoutTimerHelper.events.forEach(function (event) {
                        document.removeEventListener(event, window.logoutTimerHelper.handleActivity, true);
                    });
                    window.logoutTimerHelper.dotNetRef = null;
                    if (window.logoutTimerHelper._throttle) {
                        clearTimeout(window.logoutTimerHelper._throttle);
                        window.logoutTimerHelper._throttle = null;
                    }
                }
            };
        }
    """;
}
