@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using data
@using Microsoft.AspNetCore.Components;
@using Microsoft.JSInterop;
@using System.Net.Http;
@using System.Net.Http.Json;
@using System.Threading.Tasks;
@using System.Globalization
@code {
    [Parameter]
    public Users? _use { get; set; }
    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
@if (_use != null)
{
    <div class="user-box dropdown px-3">
        <a class="d-flex align-items-center nav-link dropdown-toggle gap-3 dropdown-toggle-nocaret" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="/assets/images/icons/UserAvatar.gif" class="user-img" alt="user avatar">
            <div class="user-info">
                <p class="user-name mb-0">@_use.FirstName @_use.LastName</p>
                <p class="designattion mb-0">@_use.ContactInformation.Email</p>
            </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <div class="dropdown-divider mb-0"></div>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center" href="/@culture/Account/Logout/">
                    <i class="bx bx-log-out-circle"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </div>
}
else
{
    <div class="user-box px-3">
        <a class="d-flex align-items-center nav-link gap-3"
           href="javascript:void(0)"
           data-bs-toggle="modal"
           data-bs-target="#loginModal">
            <img src="/assets/images/icons/UserAvatar.gif" class="user-img" alt="user avatar">
            <div class="user-info">
                <p class="user-name mb-0">Kayıt/Giriş</p>
                <p class="designation mb-0">Hoş Geldiniz</p>
            </div>
        </a>
    </div>
}

