                            <span style="font-size:0.9rem;">Güvenlik</span>
                        </a>
                    </li>

                    <li><div class="dropdown-divider"></div></li>

                    <li>
                        <h6 class="dropdown-header d-flex align-items-center text-secondary opacity-75 px-3 pt-3 pb-2">
                            <i class="fa fa-headphones fa-fw me-2"></i>
