               href="#"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
            <img src="@(string.IsNullOrEmpty(_use.ProfileCoverGallery?.ProfileImagePath)
                                                                                      ? "/assets/images/icons/UserAvatar.gif"
                                                                                      : _use.ProfileCoverGallery.ProfileImagePath)"
                 class="user-img bg-light"
                 alt="user avatar">
            <div class="user-info">
                <p class="user-name mb-0">@_use.FirstName @_use.LastName</p>
                <p class="designattion mb-0">@_use.ContactInformation.Email</p>
