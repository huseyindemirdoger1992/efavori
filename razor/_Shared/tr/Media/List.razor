@using Microsoft.EntityFrameworkCore
@using Data
@using Microsoft.Extensions.DependencyInjection
@using System.Threading.Tasks
@using data
@inject IJSRuntime JSRuntime
@inject IServiceScopeFactory ScopeFactory
@rendermode InteractiveServer
@inject FileUploadService FileService
<razor._Shared.Notification @ref="notificationRef" />

<div class="card bg-transparent border border-light-3 shadow-none">
    <div class="card-body">
        <!-- Search Bar -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="input-group">
                    <span class="input-group-text bg-dark-transparent border-light-3 text-white-50">
                        <i class="fa fa-search"></i>
                    </span>
                    <input type="text"
                           class="form-control bg-dark-transparent border-light-3 text-white"
                           placeholder="Ara..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           @onkeyup="OnSearchChanged" />
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <button class="btn btn-outline-light border-light-3" type="button" @onclick="ClearSearch">
                            <i class="fa fa-times"></i>
                        </button>
                    }
                </div>
            </div>
        </div>



        <!-- Media Grid -->
        @if (isLoading && !mediaItems.Any())
        {
            <div class="text-center py-5">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
            </div>
        }
        else if (!mediaItems.Any())
        {
            <div class="text-center py-5">
                <i class="fa fa-folder-open fa-3x text-white-50 mb-3"></i>
                <p class="text-white-50">@(string.IsNullOrWhiteSpace(searchQuery) ? "Henüz dosya yüklenmemiş" : "Sonuç bulunamadı")</p>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
                @foreach (var media in mediaItems.Take(displayedItemsCount))
                {
                    var isSelected = IsMultiSelect == true && selectedFiles.Contains(media);
                    var cardClass = isSelected ? "shadow" : "";

                    <div class="col">
                        <div class="card bg-dark-transparent border-light-3 h-100 overflow-hidden shadow-sm position-relative media-card @cardClass">
                            <!-- Selection Badge -->
                            @if (IsMultiSelect == true && isSelected)
                            {
                                <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
                                    <span class="badge bg-primary">
                                        <i class="fa fa-check"></i>
                                    </span>
                                </div>
                            }


                            <div class="position-relative media-preview"
                                 style="cursor: pointer;"
                                 @onclick=" (IsMultiSelect ?? false) ? () =>HandleMediaClick(media) : () =>SelectSingleFile(media)"
                                 data-bs-dismiss="@(!(IsMultiSelect ?? false) ? "modal" : null)">

                                @{
                                    var ext = media.FileExtensionType?.ToLower() ?? "";
                                    var isImage = IsImageFile(ext);
                                    var isVideo = IsVideoFile(ext);
                                    var isAudio = IsAudioFile(ext);
                                    var isDocument = IsDocumentFile(ext);
                                }

                                @if (isImage)
                                {
                                    <img src="@media.FileUrl"
                                         class="card-img-top lazy-load"
                                         style="height: 150px; object-fit: cover;"
                                         alt="@media.FileName"
                                         loading="lazy" />
                                }
                                else if (isVideo)
                                {
                                    <div class="position-relative" style="height: 150px; background: #000;">
                                        <video class="w-100 h-100" style="object-fit: cover;">
                                            <source src="@media.FileUrl" type="@media.ContentType">
                                        </video>
                                        <div class="position-absolute top-50 start-50 translate-middle">
                                            <i class="fa fa-play-circle fa-3x text-white opacity-75"></i>
                                        </div>
                                    </div>
                                }
                                else if (isAudio)
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-dark text-white-50" style="height: 150px;">
                                        <i class="fa fa-file-audio-o fa-4x"></i>
                                    </div>
                                }
                                else if (isDocument)
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-dark text-white-50" style="height: 150px;">
                                        @GetDocumentIcon(ext)
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-dark text-white-50" style="height: 150px;">
                                        <i class="fa fa-file-archive-o fa-4x"></i>
                                    </div>
                                }
                            </div>

                            <div class="card-body p-2">
                                <div class="text-white small text-truncate mb-1 fw-bold" title="@media.FileName">
                                    <i class="fa fa-file-text-o me-1 text-info"></i>@media.FileName
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between align-items-center opacity-75 text-white" style="font-size: 0.65rem;">
                                    <span><i class="fa fa-hdd-o me-1"></i>@FormatFileSize(media.CompressedSize ?? media.OriginalSize ?? 0)</span>
                                    <span><i class="fa fa-calendar me-1"></i>@media.CreatedAt?.ToLocalTime().ToString("dd.MM.yy")</span>
                                </div>
                            </div>

                            @if (IsMultiSelect == true)
                            {
                                <div class="px-2 pb-2">
                                    <button type="button"
                                            class="btn btn-sm w-100 p-1 @(isSelected ? "btn-primary" : "btn-outline-light")"
                                            @onclick="() => ToggleSelection(media)">
                                        <i class="fa @(isSelected ? "fa-check-square-o" : "fa-square-o") me-1"></i>
                                        @(isSelected ? "Seçildi" : "Seç")
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="px-2 pb-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-light w-100 p-1"
                                            data-bs-dismiss="modal" aria-label="Close"
                                            @onclick="() => SelectSingleFile(media)">
                                        <i class="fa fa-hand-pointer-o me-1"></i>Seç
                                    </button>
                                </div>
                            }

                            <div class="card-footer bg-dark-transparent border-light-3 p-1">
                                <div class="btn-group w-100" role="group">
                                    <button type="button" class="btn btn-sm btn-outline-light border-0" @onclick="() => ShowDetail(media)" title="Detay">
                                        <i class="fa fa-info-circle"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm btn-outline-light border-0" @onclick="() => ShowEditModal(media)" title="Düzenle">
                                        <i class="fa fa-edit"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm btn-outline-light border-0" @onclick="() => OpenInNewTab(media.OrjFileUrl)" title="Aç">
                                        <i class="fa fa-external-link"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm btn-outline-light border-0" @onclick="() => CopyLink(media.OrjFileUrl)" title="Kopyala">
                                        <i class="fa fa-copy"></i>
                                    </button>

                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger border-0" @onclick="() => ShowDeleteModal(media)" title="Sil" style="width:100%;">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Load More Button -->
            @if (displayedItemsCount < filteredTotalCount)
            {
                <div class="text-center mt-4">
                    <button class="btn btn-outline-light px-4" @onclick="LoadMore" disabled="@isLoadingMore">
                        @if (isLoadingMore)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="fa fa-arrow-down me-2"></i>Daha Fazla Göster (15 Tane Daha)
                    </button>
                    <div class="text-white-50 small mt-2">
                        Gösterilen: @displayedItemsCount / @filteredTotalCount
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Detail Modal -->
@if (showDetailModal && selectedMedia != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-light-3">
                <div class="modal-header border-light-3">
                    <h5 class="modal-title">
                        <i class="fa fa-info-circle me-2"></i>Dosya Detayları
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDetailModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            @{
                                var ext = selectedMedia.FileExtensionType?.ToLower() ?? "";
                                var isImage = IsImageFile(ext);
                            }
                            @if (isImage)
                            {
                                <img src="@selectedMedia.FileUrl" class="img-fluid rounded" alt="@selectedMedia.FileName" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-secondary rounded" style="height: 300px;">
                                    <i class="fa fa-file fa-5x text-white-50"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <table class="table table-dark table-borderless">
                                <tbody>
                                    <tr>
                                        <th class="text-white-50">Dosya Adı:</th>
                                        <td>@selectedMedia.FileName</td>
                                    </tr>
                                    <tr>
                                        <th class="text-white-50">Dosya Türü:</th>
                                        <td>@selectedMedia.FileExtensionType</td>
                                    </tr>
                                    <tr>
                                        <th class="text-white-50">Boyut:</th>
                                        <td>@FormatFileSize(selectedMedia.CompressedSize ?? selectedMedia.OriginalSize ?? 0)</td>
                                    </tr>
                                    <tr>
                                        <th class="text-white-50">Oluşturulma:</th>
                                        <td>@selectedMedia.CreatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <th class="text-white-50">Bağlantı:</th>
                                        <td class="text-break">
                                            <small>https://efavori.com@selectedMedia.FileUrl</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-light-3">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailModal">
                        <i class="fa fa-times me-1"></i>Kapat
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit Modal -->
@if (showEditModal && selectedMedia != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-light-3">
                <div class="modal-header border-light-3">
                    <h5 class="modal-title">
                        <i class="fa fa-edit me-2"></i>Dosya Adını Düzenle
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50">Dosya Adı</label>
                        <input type="text" class="form-control bg-dark-transparent border-light-3 text-white" @bind="editFileName" />
                    </div>
                </div>
                <div class="modal-footer border-light-3">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">
                        <i class="fa fa-times me-1"></i>İptal
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="SaveFileName" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="fa fa-save me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Modal -->
@if (showDeleteModal && selectedMedia != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-light-3">
                <div class="modal-header border-light-3">
                    <h5 class="modal-title">
                        <i class="fa fa-exclamation-triangle me-2 text-danger"></i>Dosyayı Sil
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Bu dosyayı silmek istediğinize emin misiniz?</p>
                    <div class="alert alert-warning bg-dark-transparent border-warning">
                        <strong>@selectedMedia.FileName</strong>
                    </div>
                </div>
                <div class="modal-footer border-light-3">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">
                        <i class="fa fa-times me-1"></i>İptal
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteFile" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="fa fa-trash me-1"></i>Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .bg-dark-transparent {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    .border-light-3 {
        border-color: rgba(255, 255, 255, 0.3) !important;
    }

    .media-card {
        transition: all 0.3s ease;
    }

        .media-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.5) !important;
        }

    .media-preview {
        overflow: hidden;
    }

    .lazy-load {
        transition: opacity 0.3s ease;
    }
</style>

@code {
    private razor._Shared.Notification? notificationRef;
    private List<Media> mediaItems = new();
    private List<Media> selectedFiles = new();
    private Media? selectedMedia;

    private string searchQuery = string.Empty;
    private System.Threading.Timer? searchDebounceTimer;
    private int displayedItemsCount = 15;
    private int filteredTotalCount = 0;

    private bool isLoading = true;
    private bool isLoadingMore = false;
    private bool isSaving = false;
    private bool isDeleting = false;

    private bool showDetailModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private string editFileName = string.Empty;

    private readonly string[] imageExtensions = { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tiff", ".tif", ".heic", ".heif", ".raw", ".svg", ".ico", ".tga", ".avif" };
    private readonly string[] videoExtensions = { ".mp4", ".mov", ".avi", ".mkv", ".wmv", ".flv", ".webm", ".mpeg", ".mpg" };
    private readonly string[] audioExtensions = { ".mp3", ".wav", ".ogg", ".m4a", ".flac", ".aac", ".wma", ".opus" };
    private readonly string[] documentExtensions = { ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".rtf", ".odt" };

    protected override async Task OnInitializedAsync()
    {
        // FileService olaylarına abone ol
        if (IsMultiSelect == true)
        {
            FileService.OnSelectionChanged += HandleSelectionChanged;
        }
        else
        {
            FileService.OnFileSelected += HandleSingleFileSelected;
        }

        FileService.OnFileUploaded += HandleFileUploaded;

        await LoadMedia();
    }

    private void HandleSelectionChanged(List<Media> files)
    {
        selectedFiles = new List<Media>(files);
        StateHasChanged();
    }

    private void HandleSingleFileSelected(Media media)
    {
        selectedMedia = media;
        StateHasChanged();
    }

    private void HandleFileUploaded()
    {
        _ = LoadMedia();
    }

    private void HandleMediaClick(Media media)
    {
        if (IsMultiSelect == true)
        {
            ToggleSelection(media);
        }
        else
        {
            ShowDetail(media);
        }
    }

    private void SelectSingleFile(Media media)
    {
        FileService.SelectFile(media);
        _ = ShowNotification("Başarılı", $"{media.FileName} seçildi", "success");
    }

    private void ToggleSelection(Media media)
    {
        FileService.ToggleFileSelection(media);
    }

    private async Task LoadMedia()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<_ApplicationConnectionDb>();

            var query = dbContext.Media
                .Where(m => m.IsDeletedStatu != true && m.UserId == use.Id);

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(m => m.FileName!.Contains(searchQuery));
            }

            filteredTotalCount = await query.CountAsync();
            mediaItems = await query
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            await ShowNotification("Hata", $"Dosyalar yüklenirken hata oluştu: {ex.Message}", "danger");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchChanged()
    {
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                displayedItemsCount = 15;
                await LoadMedia();
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        searchQuery = string.Empty;
        displayedItemsCount = 15;
        await LoadMedia();
    }

    private async Task LoadMore()
    {
        isLoadingMore = true;
        StateHasChanged();

        await Task.Delay(300);
        displayedItemsCount += 15;

        isLoadingMore = false;
        StateHasChanged();
    }

    private bool IsImageFile(string ext) => imageExtensions.Contains(ext);
    private bool IsVideoFile(string ext) => videoExtensions.Contains(ext);
    private bool IsAudioFile(string ext) => audioExtensions.Contains(ext);
    private bool IsDocumentFile(string ext) => documentExtensions.Contains(ext);

    private RenderFragment GetDocumentIcon(string ext) => ext switch
    {
        ".pdf" => @<i class="fa fa-file-pdf-o fa-4x"></i>,
        ".doc" or ".docx" => @<i class="fa fa-file-word-o fa-4x"></i>,
        ".xls" or ".xlsx" => @<i class="fa fa-file-excel-o fa-4x"></i>,
        ".ppt" or ".pptx" => @<i class="fa fa-file-powerpoint-o fa-4x"></i>,
        ".txt" or ".rtf" => @<i class="fa fa-file-text-o fa-4x"></i>,
        _ => @<i class="fa fa-file-o fa-4x"></i>
    };

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private void ShowDetail(Media media)
    {
        selectedMedia = media;
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedMedia = null;
    }

    private void ShowEditModal(Media media)
    {
        selectedMedia = media;
        editFileName = media.FileName ?? "";
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        selectedMedia = null;
        editFileName = string.Empty;
    }

    private async Task SaveFileName()
    {
        if (selectedMedia == null || string.IsNullOrWhiteSpace(editFileName))
        {
            await ShowNotification("Uyarı", "Dosya adı boş olamaz", "warning");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<_ApplicationConnectionDb>();

            var media = await dbContext.Media.FindAsync(selectedMedia.Id);
            if (media != null)
            {
                media.FileName = editFileName;
                await dbContext.SaveChangesAsync();

                selectedMedia.FileName = editFileName;
                var index = mediaItems.FindIndex(m => m.Id == selectedMedia.Id);
                if (index >= 0)
                {
                    mediaItems[index].FileName = editFileName;
                }

                await ShowNotification("Başarılı", "Dosya adı güncellendi", "success");
                CloseEditModal();
            }
        }
        catch (Exception ex)
        {
            await ShowNotification("Hata", $"Dosya adı güncellenirken hata oluştu: {ex.Message}", "danger");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteModal(Media media)
    {
        selectedMedia = media;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        selectedMedia = null;
    }

    private async Task DeleteFile()
    {
        if (selectedMedia == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<_ApplicationConnectionDb>();

            var media = await dbContext.Media.FindAsync(selectedMedia.Id);
            if (media != null)
            {
                media.IsDeletedStatu = true;
                media.DeletedAtDate = DateTime.UtcNow;
                await dbContext.SaveChangesAsync();

                mediaItems.RemoveAll(m => m.Id == selectedMedia.Id);
                filteredTotalCount--;

                await ShowNotification("Başarılı", "Dosya silindi", "success");
                CloseDeleteModal();
            }
        }
        catch (Exception ex)
        {
            await ShowNotification("Hata", $"Dosya silinirken hata oluştu: {ex.Message}", "danger");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private async Task OpenInNewTab(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
    }

    private async Task CopyLink(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", $"https://efavori.com{url}");
            await ShowNotification("Başarılı", "Bağlantı kopyalandı", "success");
        }
    }

    private async Task ShowNotification(string title, string message, string type)
    {
        if (notificationRef != null)
        {
            await notificationRef.Launch(type, title, message, null);
        }
    }

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();

        if (IsMultiSelect == true)
        {
            FileService.OnSelectionChanged -= HandleSelectionChanged;
        }
        else
        {
            FileService.OnFileSelected -= HandleSingleFileSelected;
        }

        FileService.OnFileUploaded -= HandleFileUploaded;
    }
}
