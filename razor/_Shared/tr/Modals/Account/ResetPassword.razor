@rendermode InteractiveServer
<razor._Shared.Notification @ref="notificationRef" />
<!-- Şifre Yenileme Modalı -->
<div class="modal fade" id="resetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-white">
                    <i class="fa fa-key"></i> Şifre Yenile
                </h5>
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#loginModal">
                    <i class="fa fa-sign-in"></i> Giriş Yap
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label"><i class="fa fa-at"></i> E-posta</label>
                    <input type="email" class="form-control" placeholder="E-posta adresiniz" @bind="EmailResPas" />
                </div>
                @if (IsSendRessPassCode == true)
                {
                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-shield"></i> Doğrulama Kodu</label>
                        <input type="email" class="form-control" placeholder="E-postanıza gelen doğrulama kodunuz" @bind="RessPassCode" />
                    </div>
                    <button type="button"
                            class="@(IsButtonProcessing("UserResPasCodeIsOk") ? "btn btn-light colored" : "btn btn-light")"
                            style="width:100%;"
                            @onclick='async () => await HandleButtonClick("UserResPasCodeIsOk", UserResPasCodeIsOk)'
                            disabled="@IsButtonProcessing("UserResPasCodeIsOk")">
                        <i class="fa @(IsButtonProcessing("UserResPasCodeIsOk") ? "fa-circle-o-notch fa-spin" : "fa-check-circle")"></i>
                        <span>@(IsButtonProcessing("UserResPasCodeIsOk") ? "Doğrulanıyor..." : "Kodu Onayla")</span>
                    </button>
                    <script>
                                                function startCountdown(buttonId, durationInSeconds) {
                            const button = document.getElementById(buttonId);
                            if (!button) return;

                            // Başlangıç değerlerini sakla (Geri sayım bitince eski haline dönmek için)
                            const originalContent = button.innerHTML;
                            let timeLeft = durationInSeconds;

                            // Butonu devre dışı bırak
                            button.disabled = true;

                            const timer = setInterval(() => {
                                if (timeLeft <= 0) {
                                    // Süre bittiğinde her şeyi eski haline getir
                                    clearInterval(timer);
                                    button.innerHTML = originalContent;
                                    button.disabled = false;
                                } else {
                                    // Buton içeriğini güncelle (İkonu koruyarak veya sadece metinle)
                                    button.innerHTML = `<i class="fa fa-clock-o"></i> <span>Tekrar gönder (${timeLeft}s)</span>`;
                                    timeLeft--;
                                }
                            }, 1000);
                        }
                    </script>
                }
            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button"
                        id="IsSendRessPassCode"
                        class="@(IsButtonProcessing("LoginButton") ? "btn btn-light colored" : "btn btn-light")"
                        style="width:100%;"
                        @onclick='async () => await HandleButtonClick("LoginButton", Action)'
                        disabled="@IsButtonProcessing("LoginButton")">
                    <i class="fa @(IsButtonProcessing("LoginButton") ? "fa-refresh fa-spin" : "fa-key")"></i>
                    <span>@(IsButtonProcessing("LoginButton") ? $"{BtnIsSecand}" : "Şifre sıfırlama kodu gönder")</span>
                </button>
            </div>
        </div>
    </div>
</div>