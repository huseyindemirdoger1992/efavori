@rendermode InteractiveServer
<razor._Shared.Notification @ref="notificationRef" />
<!-- Şifre Yenileme Modalı -->
<div class="modal fade" id="resetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-white">
                    <i class="fa fa-key"></i> Şifre Yenile
                </h5>
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#loginModal">
                    <i class="fa fa-sign-in"></i> Giriş Yap
                </button>
            </div>
            <div class="modal-body">
                @if (IsResPasCodeOk != true)
                {
                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-at"></i> E-posta</label>
                        <input type="email" class="form-control" placeholder="E-posta adresiniz" @bind="ResetPassEmailAddress" />
                    </div>
                }
                @if (IsSendRessPassCode == true && IsResPasCodeOk != true)
                {
                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-shield"></i> Doğrulama Kodu</label>
                        <input type="number" class="form-control" placeholder="E-postanıza gelen doğrulama kodunuz" @bind="RessPassCode" />
                    </div>
                    <button type="button"
                            class="@(IsButtonProcessing("UserResPasCodeIsOk") ? "btn btn-light colored" : "btn btn-light")"
                            style="width:100%;"
                            @onclick='async () => await HandleButtonClick("UserResPasCodeIsOk", UserResPasCodeIsOk)'
                            disabled="@IsButtonProcessing("UserResPasCodeIsOk")">
                        <i class="fa @(IsButtonProcessing("UserResPasCodeIsOk") ? "fa-circle-o-notch fa-spin" : "fa-check-circle")"></i>
                        <span>@(IsButtonProcessing("UserResPasCodeIsOk") ? "Doğrulanıyor..." : "Kodu Onayla")</span>
                    </button>
                }
                @if (IsResPasCodeOk == true)
                {
                    <div class="mb-3" style="margin-top:12px;">
                        <label class="form-label"><i class="fa fa-key"></i> Yeni Şifreniz</label>
                        <input type="text"
                               class="form-control"
                               placeholder="Yeni Şifrenizi Belirleyebilirsiniz"
                               id="NewPasswordInput"
                               @bind="NewPassword"
                               }' />
                        <span style="margin-top:12px; display: block;">
                            <p>Yeni şifreniz aşağıdaki kriterleri sağlamalıdır:</p>
                            <ul id="password-criteria" style="list-style: none; padding-left: 0;">
                                <li id="len"><span class="status-icon"></span> En az 8 karakter</li>
                                <li id="upper"><span class="status-icon"></span> Büyük harf (A-Z)</li>
                                <li id="lower"><span class="status-icon"></span> Küçük harf (a-z)</li>
                                <li id="num"><span class="status-icon"></span> Rakam (0-9)</li>
                                <li id="spec"><span class="status-icon"></span> Özel karakter (!, #, $, vb.)</li>
                            </ul>
                        </span>

                        <style>
                            /* Başlangıçta gri renk */
                            #password-criteria li {
                                color: #fff5f5;
                                transition: all 0.3s ease;
                            }

                                /* Kural gerçekleşince yeşil renk */
                                #password-criteria li.valid {
                                    color: #c7ffc8;
                                    font-weight: bold;
                                }

                                    /* Tik işareti ekleme */
                                    #password-criteria li.valid .status-icon::before {
                                        content: '✔ ';
                                        margin-right: 5px;
                                    }
                        </style>
                        <script>
                                document.getElementById('NewPasswordInput').addEventListener('input', function () {
                                const password = this.value;

                                const criteria = {
                                    len: password.length >= 8,
                                    upper: /[A-Z]/.test(password),
                                    lower: /[a-z]/.test(password),
                                    num: /[0-9]/.test(password),
                                    spec: /[!@@#$%^&*(),.?":{}|<>]/.test(password)
                                };

                                // Her bir kuralı kontrol et ve sınıfı güncelle
                                Object.keys(criteria).forEach(key => {
                                    const element = document.getElementById(key);
                                    if (criteria[key]) {
                                        element.classList.add('valid');
                                    } else {
                                        element.classList.remove('valid');
                                    }
                                });
                            });
                        </script>

                        <button type="button"
                                id="IsSendRessPassCode"
                                class="@(IsButtonProcessing("UserResPasCodeIsOkAction") ? "btn btn-light colored" : "btn btn-light")"
                                style="width:100%;"
                                @onclick='async () => await HandleButtonClick("UserResPasCodeIsOkAction", UserResPasCodeIsOkAction)'
                                disabled="@IsButtonProcessing("UserResPasCodeIsOkAction")">
                            <i class="fa @(IsButtonProcessing("UserResPasCodeIsOkAction") ? "fa-refresh fa-spin" : "fa-key")"></i>
                            <span>@(IsButtonProcessing("UserResPasCodeIsOkAction") ? $"Kaydediliyor..." : "Yeni Şifreyi Kaydet")</span>
                        </button>
                    </div>
                }
            </div>
            <div class="modal-footer border-top border-secondary">
                @if (IsResPasCodeOk != true)
                {
                    <button type="button"
                            id="IsSendRessPassCode"
                            class="@(IsButtonProcessing("LoginButton") ? "btn btn-light colored" : "btn btn-light")"
                            style="width:100%;"
                            @onclick='async () => await HandleButtonClick("LoginButton", Action)'
                            disabled="@IsButtonProcessing("LoginButton")">
                        <i class="fa @(IsButtonProcessing("LoginButton") ? "fa-refresh fa-spin" : "fa-key")"></i>
                        <span>@(IsButtonProcessing("LoginButton") ? $"{BtnIsSecand} Sonra tekrar gönderebilirsiniz" : "Şifre sıfırlama kodu gönder")</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>