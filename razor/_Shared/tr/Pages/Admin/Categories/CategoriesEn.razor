    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Sil
    // ══════════════════════════════════════════════════════════════

    private async Task BulkDeleteConfirmedAsync()
    {
        if (_isProcessing || !_selectedIds.Any()) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var allIds = new HashSet<int>(_selectedIds);
            foreach (var id in _selectedIds.ToList())
            {
                var descendants = await GetDescendantIdsAsync(db, id, _cts.Token);
                foreach (var d in descendants) allIds.Add(d);
            }

            var count = allIds.Count;

            await db.CategoriesEn
                .Where(x => allIds.Contains(x.Id))
                .ExecuteDeleteAsync(_cts.Token);

            _selectedIds.Clear();
            _allSelected = false;
            _bulkDeletePreview.Clear();

            await HideModal("BulkDeleteModal");
            _isProcessing = false;

            InvalidateCaches();
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkDelete ({count})");
            await Notify("success", "Silindi", $"{count} kategori silindi.");
        }
        catch (Exception ex)
        {
            await LogError("BulkDelete", ex);
            await Notify("danger", "Hata", "Toplu silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI: Alt Ağaç ID'leri (BFS)
    // ══════════════════════════════════════════════════════════════

    private async Task<HashSet<int>> GetDescendantIdsAsync(
        _ApplicationConnectionDb db, int parentId, CancellationToken token)
    {
        var allDescendants = new HashSet<int>();
        var currentLevel = new List<int> { parentId };
        int safe = 0;

        while (currentLevel.Any() && safe < 20)
        {
            var children = await db.CategoriesEn
                .AsNoTracking()
                .Where(x => x.ParentCategoryId != null && currentLevel.Contains(x.ParentCategoryId.Value))
                .Select(x => x.Id)
                .ToListAsync(token);

            if (!children.Any()) break;

            foreach (var c in children) allDescendants.Add(c);
            currentLevel = children;
            safe++;
        }

        return allDescendants;
    }

