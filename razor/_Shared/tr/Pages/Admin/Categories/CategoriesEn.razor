    private async Task SearchParentCategoriesAsync(string term, bool isMove)
    {
        _typeaheadCts?.Cancel();
        _typeaheadCts?.Dispose();
        _typeaheadCts = new CancellationTokenSource();
        var token = _typeaheadCts.Token;

        try
        {
            if (string.IsNullOrWhiteSpace(term))
            {
                if (isMove) { _moveParentSearchResults.Clear(); _showMoveParentDropdown = false; }
                else { _parentSearchResults.Clear(); _showParentDropdown = false; }
                StateHasChanged();
                return;
            }

            await Task.Delay(300, token);
            if (token.IsCancellationRequested) return;

            await using var db = await DbFactory.CreateDbContextAsync(token);
            var s = term.Trim();

            var q = db.CategoriesEn.AsNoTracking()
                .Where(x => x.Name != null && x.Name.Contains(s));

            if (isMove && _moveTarget != null)
            {
                var excludeIds = await GetDescendantIdsAsync(db, _moveTarget.Id, token);
                excludeIds.Add(_moveTarget.Id);
                q = q.Where(x => !excludeIds.Contains(x.Id));
            }

            var results = await q.OrderBy(x => x.Name).Take(TYPEAHEAD_LIMIT).ToListAsync(token);

            foreach (var r in results)
            {
                if (!_pathCache.ContainsKey(r.Id))
                    await LoadSinglePathAsync(db, r, token);
            }

            if (isMove) { _moveParentSearchResults = results; _showMoveParentDropdown = results.Any(); }
            else { _parentSearchResults = results; _showParentDropdown = results.Any(); }

            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { await LogError("SearchParent", ex); }
    }

    private async Task LoadSinglePathAsync(_ApplicationConnectionDb db, data.CategoriesEn item, CancellationToken token)
    {
        var parts = new List<string>();
        var currentId = item.ParentCategoryId;
        int safe = 0;

        while (currentId != null && safe < 10)
        {
            var parent = await db.CategoriesEn
                .AsNoTracking()
                .Where(x => x.Id == currentId)
                .Select(x => new { x.Id, x.Name, x.ParentCategoryId })
                .FirstOrDefaultAsync(token);

            if (parent == null) break;
            parts.Insert(0, parent.Name ?? "?");
            currentId = parent.ParentCategoryId;
            safe++;
        }

        _pathCache[item.Id] = parts.Any() ? string.Join(" › ", parts) : "Kök";
        _depthCache[item.Id] = parts.Count + 1;
    }

    /// <summary>
    /// Belirtilen kategorinin kök atasındaki DepartmentName'i bulur.
    /// Eğer yoksa en üst parent'ın Name'ini döner.
    /// </summary>
    private async Task<string?> ResolveRootDepartmentAsync(_ApplicationConnectionDb db, int? parentId, CancellationToken token)
    {
        if (parentId == null) return null;

        data.CategoriesEn? root = null;
        var currentId = parentId;
        int safe = 0;

        while (currentId != null && safe < 15)
        {
            var cat = await db.CategoriesEn
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == currentId, token);

            if (cat == null) break;
            root = cat;
            currentId = cat.ParentCategoryId;
            safe++;
        }

        // Kök atanın DepartmentName'i varsa döner, yoksa Name'ini döner
        return root?.DepartmentName ?? root?.Name;
    }

