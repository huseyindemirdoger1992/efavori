    private async Task AddAsync()
    {
        if (_isProcessing || _addModel == null) return;

        if (string.IsNullOrWhiteSpace(_addModel.Name))
        {
            await Notify("warning", "Uyarı", "Kategori adı zorunludur.");
            return;
        }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var trimmedName = _addModel.Name!.Trim();

            // Mükerrer kontrolü
            var exists = await db.CategoriesEn.AnyAsync(x =>
                x.ParentCategoryId == _addModel.ParentCategoryId &&
                x.Name == trimmedName, _cts.Token);

            if (exists)
            {
                await Notify("warning", "Uyarı", "Bu seviyede aynı isimde kategori zaten var.");
                return;
            }

            _addModel.Name = trimmedName;

            // DepartmentName otomatik devralma
            if (string.IsNullOrWhiteSpace(_addModel.DepartmentName))
            {
                if (_addModel.ParentCategoryId != null)
                {
                    _addModel.DepartmentName = await ResolveRootDepartmentAsync(db, _addModel.ParentCategoryId, _cts.Token)
                                               ?? trimmedName;
                }
                else
                {
                    _addModel.DepartmentName = trimmedName;
                }
            }
            else
            {
                _addModel.DepartmentName = _addModel.DepartmentName.Trim();
            }

            db.CategoriesEn.Add(_addModel);
            await db.SaveChangesAsync(_cts.Token);

            await HideModal("AddModal");
            _addModel = null;
            _addParentSelected = null;
            _autoInheritedDepartment = null;
            _isProcessing = false;

            InvalidateCaches();
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Add");
            await Notify("success", "Başarılı", "Kategori eklendi.");
        }
        catch (Exception ex)
        {
            await LogError("AddAsync", ex);
            await Notify("danger", "Hata", "Kayıt sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

