        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Kategori Yönetimi";
    private const string ENTITY_NAME = "CategoriesEn";
    private const string CACHE_KEY = "CategoriesEn_List";
    private const int SEARCH_DELAY = 400;
    private const int PAGE_SIZE = 25;
    private const int TYPEAHEAD_LIMIT = 15;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _typeaheadCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;

    // ─── İstatistikler ────────────────────────────────────────────
    private int _statTotal;
    private int _statRootCount;
    private int _statMaxDepth;

    // ─── Navigasyon ──────────────────────────────────────────────
    private int? _currentParentId;
    private List<data.CategoriesEn> _breadcrumbs = new();

    // ─── Veriler ──────────────────────────────────────────────────
    private List<data.CategoriesEn> _pagedItems = new();
    private int _totalCount;

    // ─── Cache ────────────────────────────────────────────────────
    private Dictionary<int, int> _childCountCache = new();
    private Dictionary<int, string> _pathCache = new();
    private Dictionary<int, int> _depthCache = new();

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;

    // ─── Ekle modal ───────────────────────────────────────────────
    private data.CategoriesEn? _addModel;
    private data.CategoriesEn? _addParentSelected;
    private string _parentSearchTerm = string.Empty;
    private List<data.CategoriesEn> _parentSearchResults = new();
    private bool _showParentDropdown;
    private string? _autoInheritedDepartment;

    // ─── Düzenle modal ────────────────────────────────────────────
    private data.CategoriesEn? _editModel;

    // ─── Taşı modal ───────────────────────────────────────────────
    private data.CategoriesEn? _moveTarget;
    private data.CategoriesEn? _moveParentSelected;
    private string _moveParentSearchTerm = string.Empty;
    private List<data.CategoriesEn> _moveParentSearchResults = new();
    private bool _showMoveParentDropdown;

    // ─── Sil modal ────────────────────────────────────────────────
    private data.CategoriesEn? _deleteTarget;
    private int _deleteChildCount;
    private int _deleteTotalDescendants;

    // ─── Toplu Sil ────────────────────────────────────────────────
    private readonly HashSet<int> _selectedIds = new();
    private bool _allSelected;
    private List<data.CategoriesEn> _bulkDeletePreview = new();

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;

        await Task.WhenAll(
            LoadDataAsync(),
            LoadStatsAsync()
        );
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _typeaheadCts?.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;

        await InvokeAsync(async () =>
        {
            _childCountCache.Clear();
            _pathCache.Clear();
            _depthCache.Clear();
            StateHub.ClearCache(CACHE_KEY);
            await Task.WhenAll(LoadDataAsync(), LoadStatsAsync());
            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // İSTATİSTİKLER
    // ══════════════════════════════════════════════════════════════

    private async Task LoadStatsAsync()
    {
        try
        {
            var stats = await StateHub.GetOrLoadAsync("CategoriesEn_Stats", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

                var total = await db.CategoriesEn.CountAsync(_cts.Token);
                var rootCount = await db.CategoriesEn.CountAsync(x => x.ParentCategoryId == null, _cts.Token);

                // Maks derinlik hesapla (BFS ile)
                int maxDepth = 0;
                if (total > 0)
                {
                    var currentLevel = await db.CategoriesEn
                        .AsNoTracking()
                        .Where(x => x.ParentCategoryId == null)
                        .Select(x => x.Id)
                        .ToListAsync(_cts.Token);

                    while (currentLevel.Any() && maxDepth < 30)
                    {
                        maxDepth++;
                        currentLevel = await db.CategoriesEn
                            .AsNoTracking()
                            .Where(x => x.ParentCategoryId != null && currentLevel.Contains(x.ParentCategoryId.Value))
                            .Select(x => x.Id)
                            .ToListAsync(_cts.Token);
                    }
                }

                return new { Total = total, RootCount = rootCount, MaxDepth = maxDepth };
            }, _cts.Token);

            if (stats != null)
            {
                _statTotal = stats.Total;
                _statRootCount = stats.RootCount;
                _statMaxDepth = stats.MaxDepth;
            }
        }
        catch (Exception ex) { await LogError("LoadStats", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME (Server-Side Sayfalama)
    // ══════════════════════════════════════════════════════════════

    private async Task LoadDataAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(_searchTerm))
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(token);
            var q = db.CategoriesEn.AsNoTracking().AsQueryable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var s = _searchTerm.Trim();

                // Girilen terimin sayı olup olmadığını kontrol ediyoruz
                bool isNumeric = int.TryParse(s, out int parsedId);

                q = q.Where(x =>
                    // Metin tabanlı aramalar
                    (x.Name != null && x.Name.Contains(s)) ||
                    (x.DepartmentName != null && x.DepartmentName.Contains(s)) ||

                    // Sayısal aramalar (Sadece aranan terim sayıysa çalışır)
                    (isNumeric && x.Id == parsedId) ||
                    (isNumeric && x.ExternalId == parsedId) ||
                    (isNumeric && x.ParentCategoryId == parsedId)
                );
            }
            else
            {
                q = _currentParentId == null
                    ? q.Where(x => x.ParentCategoryId == null)
                    : q.Where(x => x.ParentCategoryId == _currentParentId);
            }

            _totalCount = await q.CountAsync(token);
            _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PAGE_SIZE));
            _currentPage = Math.Clamp(_currentPage, 1, _totalPages);

            _pagedItems = await q
                .OrderBy(x => x.Name)
                .Skip((_currentPage - 1) * PAGE_SIZE)
                .Take(PAGE_SIZE)
                .ToListAsync(token);

            await LoadChildCountsAsync(db, token);

            if (!string.IsNullOrWhiteSpace(_searchTerm))
                await LoadPathsAndDepthsAsync(db, token);

            _allSelected = _pagedItems.Count > 0 && _pagedItems.All(i => _selectedIds.Contains(i.Id));
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadData", ex);
                await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadChildCountsAsync(_ApplicationConnectionDb db, CancellationToken token)
    {
        var ids = _pagedItems.Select(x => x.Id).ToList();
        if (!ids.Any()) return;

        var counts = await db.CategoriesEn
            .AsNoTracking()
            .Where(x => x.ParentCategoryId != null && ids.Contains(x.ParentCategoryId.Value))
            .GroupBy(x => x.ParentCategoryId!.Value)
            .Select(g => new { ParentId = g.Key, Count = g.Count() })
            .ToListAsync(token);

        foreach (var c in counts)
            _childCountCache[c.ParentId] = c.Count;

        foreach (var id in ids)
            _childCountCache.TryAdd(id, 0);
    }

    /// <summary>
    /// Arama sonuçlarının üst yol + derinlik bilgisini toplu yükler.
    /// </summary>
    private async Task LoadPathsAndDepthsAsync(_ApplicationConnectionDb db, CancellationToken token)
    {
        var neededParentIds = new HashSet<int>();
        foreach (var item in _pagedItems)
        {
            if (_pathCache.ContainsKey(item.Id)) continue;
            if (item.ParentCategoryId != null)
                neededParentIds.Add(item.ParentCategoryId.Value);
        }

        if (!neededParentIds.Any())
        {
            foreach (var item in _pagedItems)
            {
                _pathCache.TryAdd(item.Id, "Kök");
                _depthCache.TryAdd(item.Id, 1);
            }
            return;
        }

        // Tüm parent zincirini toplu yükle (max 10 derinlik)
        var allParents = new Dictionary<int, data.CategoriesEn>();
        var toLoad = neededParentIds.ToList();
        int depth = 0;

        while (toLoad.Any() && depth < 10)
        {
            var loaded = await db.CategoriesEn
                .AsNoTracking()
                .Where(x => toLoad.Contains(x.Id))
                .ToListAsync(token);

            var nextLoad = new List<int>();
            foreach (var p in loaded)
            {
                if (!allParents.ContainsKey(p.Id))
                {
                    allParents[p.Id] = p;
                    if (p.ParentCategoryId != null && !allParents.ContainsKey(p.ParentCategoryId.Value))
                        nextLoad.Add(p.ParentCategoryId.Value);
                }
            }
            toLoad = nextLoad;
            depth++;
        }

        foreach (var item in _pagedItems)
        {
            if (_pathCache.ContainsKey(item.Id)) continue;

            var parts = new List<string>();
            var currentId = item.ParentCategoryId;
            int safe = 0;

            while (currentId != null && safe < 10)
            {
                if (allParents.TryGetValue(currentId.Value, out var parent))
                {
                    parts.Insert(0, parent.Name ?? "?");
                    currentId = parent.ParentCategoryId;
                }
                else break;
                safe++;
            }

            _pathCache[item.Id] = parts.Any() ? string.Join(" › ", parts) : "Kök";
            _depthCache[item.Id] = parts.Count + 1;
        }
    }

    private int GetCachedChildCount(int id) =>
        _childCountCache.TryGetValue(id, out var count) ? count : 0;

    private string GetCachedPath(int id) =>
        _pathCache.TryGetValue(id, out var path) ? path : "";

    private int GetCachedDepth(int id) =>
        _depthCache.TryGetValue(id, out var d) ? d : (_breadcrumbs.Count + 1);

    // ══════════════════════════════════════════════════════════════
    // NAVİGASYON
    // ══════════════════════════════════════════════════════════════

    private async Task NavigateToParent(int? parentId)
    {
        _currentParentId = parentId;
        _currentPage = 1;
        _searchTerm = string.Empty;
        _selectedIds.Clear();
        _allSelected = false;

        await BuildBreadcrumbsAsync(parentId);
        await LoadDataAsync();
    }

    private async Task BuildBreadcrumbsAsync(int? targetId)
    {
        _breadcrumbs.Clear();
        if (targetId == null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var currentId = targetId;
            int safe = 0;

            while (currentId != null && safe < 15)
            {
                var cat = await db.CategoriesEn
                    .AsNoTracking()
                    .FirstOrDefaultAsync(x => x.Id == currentId, _cts.Token);

                if (cat == null) break;
                _breadcrumbs.Insert(0, cat);
                currentId = cat.ParentCategoryId;
                safe++;
            }
        }
        catch (Exception ex) { await LogError("BuildBreadcrumbs", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // SAYFALAMA
    // ══════════════════════════════════════════════════════════════

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadDataAsync();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (_totalPages <= 7)
        {
            for (int i = 1; i <= _totalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        int start = Math.Max(2, _currentPage - 2);
        int end = Math.Min(_totalPages - 1, _currentPage + 2);

        if (start > 2) pages.Add(-1);
        for (int i = start; i <= end; i++) pages.Add(i);
        if (end < _totalPages - 1) pages.Add(-1);

        pages.Add(_totalPages);
        return pages;
    }

