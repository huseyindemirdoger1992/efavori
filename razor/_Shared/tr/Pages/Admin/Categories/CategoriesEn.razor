                                <button class="btn btn-sm btn-outline-danger border-0 p-0 px-1" @onclick="ClearMoveParent" title="Kök seviyeye taşı">
                                    <i class="fa fa-times"></i>
                                </button>
                            }
                        </div>

                        @if (_moveParentSelected != null)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-folder text-warning"></i>
                                <span class="text-light fw-semibold">@_moveParentSelected.Name</span>
                                <small class="text-info d-none d-sm-inline">@GetCachedPath(_moveParentSelected.Id)</small>
                            </div>
                        }
                        else
                        {
                            <span class="text-info"><i class="fa fa-home me-1"></i>Kök seviye</span>
                        }

                        <div class="position-relative mt-2">
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Hedef kategori ara..."
                                   value="@_moveParentSearchTerm"
                                   @oninput="OnMoveParentSearchInput"
                                   @onfocus="() => _showMoveParentDropdown = _moveParentSearchResults.Any()" />

                            @if (_showMoveParentDropdown && _moveParentSearchResults.Any())
                            {
                                <div class="position-absolute w-100 border border-secondary rounded-bottom bg-dark shadow"
                                     style="z-index:1060; max-height:200px; overflow-y:auto;">
                                    @foreach (var cat in _moveParentSearchResults)
                                    {
                                        <button class="btn btn-sm btn-dark w-100 text-start border-0 py-1 px-2"
                                                @onclick="() => SelectMoveParent(cat)">
                                            <i class="fa fa-folder text-warning me-1"></i>
                                            <span>@cat.Name</span>
                                            <small class="text-info ms-2">@GetCachedPath(cat.Id)</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-info py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-info btn-sm"
                        @onclick="MoveConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Taşınıyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-arrows me-1"></i><span>Taşı</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

