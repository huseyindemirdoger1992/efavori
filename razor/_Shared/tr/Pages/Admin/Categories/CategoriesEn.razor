    // ══════════════════════════════════════════════════════════════
    // CRUD — Taşı
    // ══════════════════════════════════════════════════════════════

    private async Task MoveConfirmedAsync()
    {
        if (_isProcessing || _moveTarget == null) return;

        var newParentId = _moveParentSelected?.Id;

        if (newParentId == _moveTarget.Id)
        {
            await Notify("warning", "Uyarı", "Kategori kendisine taşınamaz.");
            return;
        }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            if (newParentId != null)
            {
                var descendants = await GetDescendantIdsAsync(db, _moveTarget.Id, _cts.Token);
                if (descendants.Contains(newParentId.Value))
                {
                    await Notify("warning", "Uyarı", "Döngüsel bağımlılık! Bir kategori kendi alt kategorisine taşınamaz.");
                    return;
                }
            }

            var entity = await db.CategoriesEn.FindAsync(new object[] { _moveTarget.Id }, _cts.Token);
            if (entity == null)
            {
                await Notify("warning", "Uyarı", "Kayıt artık mevcut değil.");
                return;
            }

            entity.ParentCategoryId = newParentId;

            // Taşınan kategorinin DepartmentName'ini yeni kökten otomatik güncelle
            var newDept = newParentId != null
                ? await ResolveRootDepartmentAsync(db, newParentId, _cts.Token)
                : entity.Name;

            if (!string.IsNullOrWhiteSpace(newDept))
                entity.DepartmentName = newDept;

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("MoveModal");
            _moveTarget = null;
            _moveParentSelected = null;
            _isProcessing = false;

            InvalidateCaches();
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Move");
            await Notify("success", "Başarılı", "Kategori taşındı.");
        }
        catch (Exception ex)
        {
            await LogError("MoveAsync", ex);
            await Notify("danger", "Hata", "Taşıma sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

