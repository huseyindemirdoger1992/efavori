@* ============================================================
   CategoriesEnList.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub — anlık broadcast, debounce, RAM cache
   ✅ TakeLogs — tüm CRUD aksiyonları loglanır
   ✅ Ayrı Ekle / Düzenle / Sil / Taşı modalleri (modal-lg)
   ✅ Seçilenleri Sil → önce onay modali (sayı + liste)
   ✅ Server-side sayfalama (20.000+ kayıt performansı)
   ✅ Lazy-load ağaç navigasyonu (tüm derinlikleri destekler)
   ✅ Breadcrumb + derinlik göstergesi
   ✅ DepartmentName otomatik devralma (kök atadan)
   ✅ İstatistik kartları (toplam, kök, bu seviye, derinlik)
   ✅ Typeahead üst kategori seçici
   ✅ Basit, performanslı, kötü sunucuda bile binlerce kullanıcıya cevap
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa",        "/"),
        ("fa fa-table",    "Kayıtlar",         "javascript:void(0)"),
        ("fa fa-sitemap", "CategoriesEn " + PAGE_TITLE,         "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── İstatistik Kartları ─── *@
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="border border-secondary rounded p-2 bg-dark text-center">
            <div class="text-info fw-bold fs-5">@_statTotal</div>
            <div class="text-white-50 small">Toplam Kategori</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="border border-secondary rounded p-2 bg-dark text-center">
            <div class="text-warning fw-bold fs-5">@_statRootCount</div>
            <div class="text-white-50 small">Kök Kategori</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="border border-secondary rounded p-2 bg-dark text-center">
            <div class="text-success fw-bold fs-5">@_totalCount</div>
            <div class="text-white-50 small">
                @if (_currentParentId != null)
                {
                    <span>Bu Seviyede</span>
                }
                else if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <span>Arama Sonucu</span>
                }
                else
                {
                    <span>Kök Seviye</span>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="border border-secondary rounded p-2 bg-dark text-center">
            <div class="text-danger fw-bold fs-5">@_statMaxDepth</div>
            <div class="text-white-50 small">Maks. Derinlik</div>
        </div>
    </div>
</div>

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    <button class="btn btn-light btn-sm" @onclick="OpenAddModal" disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Kategori</span>
    </button>

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light">@_selectedIds.Count seçili</span>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Temizle
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-danger btn-sm border-0"
                @onclick="OpenBulkDeleteModal"
                disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Kategori veya departman ara..."
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── Ağaç Navigasyonu ─── *@
<div class="d-flex align-items-center flex-wrap gap-1 mb-2 p-2 rounded border border-secondary bg-dark">
    <button class="btn btn-sm @(_currentParentId == null && string.IsNullOrWhiteSpace(_searchTerm) ? "btn-info" : "btn-outline-info") border-0"
            @onclick="() => NavigateToParent(null)">
        <i class="fa fa-home me-1"></i>Kök
    </button>

    @for (int i = 0; i < _breadcrumbs.Count; i++)
    {
        var crumb = _breadcrumbs[i];
        var depth = i + 1;
        <i class="fa fa-chevron-right text-secondary small"></i>
        <button class="btn btn-sm @(crumb.Id == _currentParentId ? "btn-info" : "btn-outline-info") border-0"
                @onclick="() => NavigateToParent(crumb.Id)">
            <span class="badge bg-dark border border-secondary me-1 small" style="font-size:0.65rem;">L@depth</span>
            @crumb.Name
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <i class="fa fa-chevron-right text-secondary small"></i>
        <span class="badge bg-warning text-dark">
            <i class="fa fa-search me-1"></i>"@_searchTerm"
        </span>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <span>"@_searchTerm" ile eşleşen kategori bulunamadı.</span>
            }
            else
            {
                <span>Bu seviyede kategori bulunmuyor.</span>
            }
        </p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2rem;">
                        <input type="checkbox" class="form-check-input"
                               checked="@_allSelected"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Kategori Adı</th>
                    <th class="d-none d-md-table-cell">Departman</th>
                    <th class="d-none d-lg-table-cell" style="width:5rem;">Ext.ID</th>
                    <th class="text-center" style="width:4.5rem;">Alt</th>
                    @if (!string.IsNullOrWhiteSpace(_searchTerm))
                    {
                        <th class="d-none d-md-table-cell">Konum</th>
                    }
                    <th class="text-end" style="width:8rem;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    var childCount = GetCachedChildCount(item.Id);
                    var depthLevel = _breadcrumbs.Count + 1;
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>
                        <td class="d-none d-md-table-cell text-secondary small">@(rowNo++)</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (childCount > 0)
                                {
                                    <button class="btn btn-sm btn-outline-info border-0 p-0 px-1"
                                            @onclick="() => NavigateToParent(item.Id)"
                                            title="@childCount alt kategoriye git">
                                        <i class="fa fa-folder text-warning"></i>
                                    </button>
                                }
                                else
                                {
                                    <i class="fa fa-tag text-secondary" style="opacity:0.4;"></i>
                                }
                                <div>
                                    <span class="fw-semibold">@item.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(_searchTerm))
                                    {
                                        <span class="badge bg-dark border border-secondary ms-1" style="font-size:0.6rem;">L@(GetCachedDepth(item.Id))</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="d-none d-md-table-cell">
                            @if (!string.IsNullOrWhiteSpace(item.DepartmentName))
                            {
                                <span class="badge bg-secondary bg-opacity-25 text-light small">@item.DepartmentName</span>
                            }
                            else
                            {
                                <span class="text-secondary small">—</span>
                            }
                        </td>
                        <td class="d-none d-lg-table-cell text-secondary small">
                            @(item.ExternalId?.ToString() ?? "—")
                        </td>
                        <td class="text-center">
                            @if (childCount > 0)
                            {
                                <button class="btn btn-sm btn-outline-info border-0 p-0"
                                        @onclick="() => NavigateToParent(item.Id)"
                                        title="Alt kategorilere git">
                                    <span class="badge bg-info">@childCount</span>
                                </button>
                            }
                            else
                            {
                                <span class="text-secondary small">0</span>
                            }
                        </td>
                        @if (!string.IsNullOrWhiteSpace(_searchTerm))
                        {
                            <td class="d-none d-md-table-cell">
                                <small class="text-info">@GetCachedPath(item.Id)</small>
                            </td>
                        }
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenMoveModal(item)" title="Taşı">
                                <i class="fa fa-arrows"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_totalCount kayıt
            @if (_currentParentId != null)
            {
                <span class="text-info ms-1">(bu seviyede)</span>
            }
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                    </li>

                    @foreach (var pg in GetPageNumbers())
                    {
                        var p = pg;
                        @if (p == -1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link bg-dark text-secondary border-secondary">…</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item @(_currentPage == p ? "active" : "")">
                                <button class="page-link @(_currentPage == p ? "" : "bg-dark text-light") border-secondary"
                                        @onclick="() => GoToPage(p)">
                                    @p
                                </button>
                            </li>
                        }
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Yeni Kategori Ekle
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="AddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-plus me-1"></i>Yeni Kategori
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_addModel != null)
                {
                    @* ─── Üst Kategori Bilgisi (kart) ─── *@
                    <div class="mb-3 p-2 rounded border border-secondary bg-dark">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-white-50 d-block"><i class="fa fa-level-up me-1"></i>Üst Kategori</small>
                                @if (_addParentSelected != null)
                                {
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <i class="fa fa-folder text-warning"></i>
                                        <span class="text-light fw-semibold">@_addParentSelected.Name</span>
                                        <small class="text-info d-none d-sm-inline">@GetCachedPath(_addParentSelected.Id)</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-info mt-1 d-block"><i class="fa fa-home me-1"></i>Kök seviye (en üst)</span>
                                }
                            </div>
                            @if (_addParentSelected != null)
                            {
                                <button class="btn btn-sm btn-outline-danger border-0" @onclick="ClearAddParent" title="Kök seviyeye al">
                                    <i class="fa fa-times"></i>
                                </button>
                            }
                        </div>

                        @* ─── Üst Kategori Değiştir (typeahead) ─── *@
                        <div class="position-relative mt-2">
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Farklı bir üst kategori seç..."
                                   value="@_parentSearchTerm"
                                   @oninput="OnParentSearchInput"
                                   @onfocus="() => _showParentDropdown = _parentSearchResults.Any()" />

                            @if (_showParentDropdown && _parentSearchResults.Any())
                            {
                                <div class="position-absolute w-100 border border-secondary rounded-bottom bg-dark shadow"
                                     style="z-index:1060; max-height:200px; overflow-y:auto;">
                                    @foreach (var cat in _parentSearchResults)
                                    {
                                        <button class="btn btn-sm btn-dark w-100 text-start border-0 py-1 px-2"
                                                @onclick="() => SelectAddParent(cat)">
                                            <i class="fa fa-folder text-warning me-1"></i>
                                            <span>@cat.Name</span>
                                            <small class="text-info ms-2">@GetCachedPath(cat.Id)</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Kategori Adı <span class="text-danger">*</span></label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Yeni kategori adını giriniz"
                                   @bind="_addModel.Name" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">
                                <i class="fa fa-building me-1"></i>Departman Adı
                                <i class="fa fa-magic text-info ms-1" title="Otomatik devralınır"></i>
                            </label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="@(_autoInheritedDepartment ?? "Otomatik atanır")"
                                   @bind="_addModel.DepartmentName" />
                            @if (!string.IsNullOrWhiteSpace(_autoInheritedDepartment))
                            {
                                <small class="text-info mt-1 d-block">
                                    <i class="fa fa-magic me-1"></i>Boş bırakırsanız otomatik: <strong>@_autoInheritedDepartment</strong>
                                </small>
                            }
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-external-link me-1"></i>External ID</label>
                            <input type="number"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Opsiyonel (CSV kaynağı)"
                                   @bind="_addModel.ExternalId" />
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="AddAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-plus me-1"></i><span>Kategori Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Düzenle
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-edit me-1"></i>Kategori Düzenle
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_editModel != null)
                {
                    @* ─── Konum Bilgisi (salt okunur) ─── *@
                    <div class="mb-3 p-2 rounded border border-secondary bg-dark">
                        <div class="d-flex align-items-start justify-content-between">
                            <div>
                                <small class="text-white-50"><i class="fa fa-sitemap me-1"></i>Konum</small>
                                <div class="text-info mt-1 small">
                                    @if (_editModel.ParentCategoryId != null)
                                    {
                                        <span>@GetCachedPath(_editModel.Id) › <strong>@_editModel.Name</strong></span>
                                    }
                                    else
                                    {
                                        <i class="fa fa-home me-1"></i><strong>@_editModel.Name</strong> <span class="text-white-50">(kök)</span>
                                    }
                                </div>
                            </div>
                            <span class="badge bg-dark border border-info text-info">L@(GetCachedDepth(_editModel.Id))</span>
                        </div>
                        <small class="text-white-50 d-block mt-1">
                            <i class="fa fa-info-circle me-1"></i>Konumu değiştirmek için <strong>Taşı</strong> butonunu kullanın.
                        </small>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Kategori Adı <span class="text-danger">*</span></label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.Name" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-building me-1"></i>Departman Adı</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.DepartmentName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-external-link me-1"></i>External ID</label>
                            <input type="number"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.ExternalId" />
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-warning btn-sm"
                        @onclick="UpdateAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-save me-1"></i><span>Değişiklikleri Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Taşı
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="MoveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-info"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-info py-2">
                <h6 class="modal-title text-info mb-0">
                    <i class="fa fa-arrows me-1"></i>Kategori Taşı
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
