    private async Task OnTreeFilterInput(ChangeEventArgs e)
    {
        _treeFilter = e.Value?.ToString() ?? string.Empty;
        _treeFilterCts?.Cancel();
        _treeFilterCts?.Dispose();
        _treeFilterCts = new CancellationTokenSource();
        var token = _treeFilterCts.Token;
        try
        {
            await Task.Delay(SEARCH_DELAY, token); // debounce
            if (token.IsCancellationRequested) return;
            RecomputeTreeFilter();
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    private void ClearTreeFilter()
    {
        _treeFilter = string.Empty;
        _treeMatched.Clear();
        _treeVisible.Clear();
        StateHasChanged();
    }

    // Filtre: ada uyan düğümleri bul, ardından onların ATA ve TORUNLARINI görünür yap.
    private void RecomputeTreeFilter()
    {
        _treeMatched.Clear();
        _treeVisible.Clear();

        var term = _treeFilter?.Trim();
        if (string.IsNullOrWhiteSpace(term)) return;

        foreach (var n in _nodes.Values)
        {
            var tr = n.NameTr ?? string.Empty;
            var en = n.NameEn ?? string.Empty;
            if (tr.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                en.Contains(term, StringComparison.OrdinalIgnoreCase))
                _treeMatched.Add(n.Id);
        }

        foreach (var id in _treeMatched)
        {
            _treeVisible.Add(id);

            // Ataları görünür yap (kök yola kadar) + otomatik aç
            var guard = new HashSet<Guid>();
            var cur = _nodes.TryGetValue(id, out var self) ? self.ParentId : null;
            while (cur is Guid pid && pid != Guid.Empty && _nodes.ContainsKey(pid) && guard.Add(pid))
            {
                _treeVisible.Add(pid);
                _expanded.Add(pid);
                cur = _nodes[pid].ParentId;
            }

            // Torunları görünür yap (eşleşenin altındaki tüm ağaç)
            CollectDescendants(id, _treeVisible);
        }
    }

