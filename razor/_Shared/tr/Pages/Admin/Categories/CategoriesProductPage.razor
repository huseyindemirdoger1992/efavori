    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;

        // Önce hafif parent ağacını yükle (Path çözümü için), sonra ilk sayfayı çek.
        await LoadNodesAsync();
        await LoadPageAsync(1, _searchTerm);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _parentSearchCts?.Dispose();
        _treeFilterCts?.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;

        await InvokeAsync(async () =>
        {
            // Yazma sonrası: hafif ağacı tazele + mevcut sayfayı yeniden çek
            await LoadNodesAsync(forceReload: true);
            await LoadPageAsync(_currentPage, _searchTerm);
            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // HAFİF AĞAÇ YÜKLEME (Path/parent çözümü için)
    // Sadece Id/ParentId/NameEn/NameTr — 50k kayıtta bile küçük.
    // Cache'lenir; yalnızca yazma işlemlerinden sonra tazelenir.
    // ══════════════════════════════════════════════════════════════

    private async Task LoadNodesAsync(bool forceReload = false)
    {
        try
        {
            if (forceReload) StateHub.ClearCache(NODES_CACHE_KEY);

            var nodes = await StateHub.GetOrLoadAsync(NODES_CACHE_KEY, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.CategoriesProduct.AsNoTracking()
                    .Where(x => x.IsDeleted == null
                             || x.IsDeleted.IsDeletedStatu == null
                             || x.IsDeleted.IsDeletedStatu == false)
                    .Select(x => new Node
                    {
                        Id = x.Id,
                        ParentId = x.ParentId,
                        NameEn = x.Categories!.NameEn,
                        NameTr = x.Categories!.NameTr,
                        IsActive = x.IsActive,
                        ShowInMenu = x.ShowInMenu,
                        AiAttributesIsOk = x.AiAttributesIsOk
                    })
                    .ToListAsync(_cts.Token);
            }, _cts.Token) ?? new List<Node>();

            _nodes = nodes.ToDictionary(n => n.Id, n => n);
            RebuildTreeIndex();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { await LogError("LoadNodes", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // AĞAÇ İNDEKSİ — ParentId → çocuklar (TR ada göre sıralı)
    // Hafif ağaç her tazelendiğinde yeniden kurulur. Render O(1) okur.
    // ══════════════════════════════════════════════════════════════
    private void RebuildTreeIndex()
    {
        _childrenByParent = _nodes.Values
            .GroupBy(n => (n.ParentId == null || n.ParentId == Guid.Empty) ? Guid.Empty : n.ParentId!.Value)
            .ToDictionary(
                g => g.Key,
                g => g.OrderBy(n => string.IsNullOrWhiteSpace(n.NameTr) ? n.NameEn : n.NameTr,
                                   StringComparer.OrdinalIgnoreCase).ToList());

        // İlk yüklemede kök düğümleri otomatik aç (kullanıcı hemen dalları görsün)
        if (!_treeExpandInit)
        {
            _treeExpandInit = true;
            foreach (var root in GetChildren(null)) _expanded.Add(root.Id);
        }

        // Filtre aktifse görünürlük kümesini yeniden hesapla
        if (!string.IsNullOrWhiteSpace(_treeFilter)) RecomputeTreeFilter();
    }

    // Bir düğümün (veya kökün) doğrudan çocuklarını döndürür.
    // Filtre aktifse yalnızca görünür olanlar süzülür.
    private List<Node> GetChildren(Guid? parentId)
    {
        var key = (parentId == null || parentId == Guid.Empty) ? Guid.Empty : parentId.Value;
        if (!_childrenByParent.TryGetValue(key, out var list)) return _emptyNodes;
        if (string.IsNullOrWhiteSpace(_treeFilter)) return list;
        return list.Where(n => _treeVisible.Contains(n.Id)).ToList();
    }
    private static readonly List<Node> _emptyNodes = new();

    // ══════════════════════════════════════════════════════════════
    // SAYFA YÜKLEME — sadece görünen 20 kayıt DB'den çekilir
    // Arama DB tarafında (EF.Functions.Like), Skip/Take DB tarafında.
    // ══════════════════════════════════════════════════════════════

    private async Task LoadPageAsync(int page, string? search)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            // Debounce: kullanıcı yazarken her tuşta değil, durunca ara (~250ms)
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(token);

            var q = db.CategoriesProduct.AsNoTracking()
                .Where(x => x.IsDeleted == null
                         || x.IsDeleted.IsDeletedStatu == null
                         || x.IsDeleted.IsDeletedStatu == false);

            // Sunucu tarafı arama: 10 dil adı + 10 slug + Path üzerinde LIKE.
            // Şifreleme olmadığı için DB'de doğrudan aranabiliyor.
            if (!string.IsNullOrWhiteSpace(search))
            {
                var like = $"%{search.Trim()}%";
                q = q.Where(x =>
                    EF.Functions.Like(x.Path!, like) ||
                    EF.Functions.Like(x.Categories!.NameTr, like) ||
                    EF.Functions.Like(x.Categories!.NameEn, like) ||
                    EF.Functions.Like(x.Categories!.NameAz, like) ||
                    EF.Functions.Like(x.Categories!.NameDe, like) ||
                    EF.Functions.Like(x.Categories!.NameEs, like) ||
                    EF.Functions.Like(x.Categories!.NameFr, like) ||
                    EF.Functions.Like(x.Categories!.NameHi, like) ||
                    EF.Functions.Like(x.Categories!.NamePt, like) ||
                    EF.Functions.Like(x.Categories!.NameRu, like) ||
                    EF.Functions.Like(x.Categories!.NameZh, like) ||
                    EF.Functions.Like(x.Categories!.SlugTr!, like) ||
                    EF.Functions.Like(x.Categories!.SlugEn!, like) ||
                    EF.Functions.Like(x.Categories!.SlugAz!, like) ||
                    EF.Functions.Like(x.Categories!.SlugDe!, like) ||
                    EF.Functions.Like(x.Categories!.SlugEs!, like) ||
                    EF.Functions.Like(x.Categories!.SlugFr!, like) ||
                    EF.Functions.Like(x.Categories!.SlugHi!, like) ||
                    EF.Functions.Like(x.Categories!.SlugPt!, like) ||
                    EF.Functions.Like(x.Categories!.SlugRu!, like) ||
                    EF.Functions.Like(x.Categories!.SlugZh!, like));
            }

            // Önce toplam sayı (sayfalama için)
            _totalCount = await q.CountAsync(token);
            _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PAGE_SIZE));
            _currentPage = Math.Clamp(page, 1, _totalPages);

            if (token.IsCancellationRequested) return;

            // Sadece görünen 20 kaydı çek
            _pagedItems = await q
                .OrderByDescending(x => x.CreatedDate)
                .Skip((_currentPage - 1) * PAGE_SIZE)
                .Take(PAGE_SIZE)
                .ToListAsync(token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadPage", ex);
                await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        await LoadPageAsync(page, _searchTerm);
    }

    // Sayfa numaraları penceresi (çok sayfada tümünü basmamak için)
    private IEnumerable<int> GetPageWindow()
    {
        const int window = 5;
        int start = Math.Max(1, _currentPage - window / 2);
        int end = Math.Min(_totalPages, start + window - 1);
        start = Math.Max(1, end - window + 1);
        for (int p = start; p <= end; p++) yield return p;
    }

