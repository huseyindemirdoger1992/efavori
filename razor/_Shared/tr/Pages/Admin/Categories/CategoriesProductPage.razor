    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Düzenle (Aktif / Menüde Göster / AI Durumu)
    // Yalnızca "apply" işaretli alanlar yazılır. Her alan kendi
    // ExecuteUpdateAsync çağrısıyla set edilir (koşullu, izlemesiz, hızlı).
    // ══════════════════════════════════════════════════════════════

    private async Task BulkEditConfirmedAsync()
    {
        if (_isProcessing || !_selectedIds.Any()) return;
        if (!(_bulkApplyActive || _bulkApplyMenu || _bulkApplyAi)) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();
            var count = ids.Count;
            var now = DateTime.UtcNow;
            var changed = new List<string>();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            if (_bulkApplyActive)
            {
                var val = _bulkValActive;
                await db.CategoriesProduct
                    .Where(x => ids.Contains(x.Id))
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(x => x.IsActive, val)
                        .SetProperty(x => x.UpdatedDate, now),
                        _cts.Token);
                changed.Add($"Aktif={(val ? "Evet" : "Hayır")}");
            }

            if (_bulkApplyMenu)
            {
                var val = _bulkValMenu;
                await db.CategoriesProduct
                    .Where(x => ids.Contains(x.Id))
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(x => x.ShowInMenu, val)
                        .SetProperty(x => x.UpdatedDate, now),
                        _cts.Token);
                changed.Add($"Menü={(val ? "Evet" : "Hayır")}");
            }

            if (_bulkApplyAi)
            {
                var val = _bulkValAi;
                await db.CategoriesProduct
                    .Where(x => ids.Contains(x.Id))
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(x => x.AiAttributesIsOk, val)
                        .SetProperty(x => x.UpdatedDate, now),
                        _cts.Token);
                changed.Add($"AI={AiStateToString(val)}");
            }

            _selectedIds.Clear();
            _allSelected = false;

            await HideModal("BulkEditModal");
            _isProcessing = false;

            StateHub.ClearCache(NODES_CACHE_KEY);
            await LoadNodesAsync(forceReload: true);
            await LoadPageAsync(_currentPage, _searchTerm);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkEdit ({count}) [{string.Join(", ", changed)}]");
            await Notify("success", "Güncellendi", $"{count} kayıt güncellendi.");
        }
        catch (Exception ex)
        {
            await LogError("BulkEdit", ex);
            await Notify("danger", "Hata", "Toplu düzenleme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // TOPLU SEÇİM
    // ══════════════════════════════════════════════════════════════

    // NOT: Sunucu tarafı sayfalamada "tümünü seç" yalnızca GÖRÜNEN sayfayı (20 kayıt)
    // kapsar. Seçim sayfalar arası korunur (HashSet), böylece farklı sayfalardan
    // seçip toplu silinebilir.
    private void ToggleRowSelection(Guid id)
    {
        if (!_selectedIds.Remove(id)) _selectedIds.Add(id);
        _allSelected = _pagedItems.Count > 0 && _pagedItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        var pageIds = _pagedItems.Select(i => i.Id).ToList();
        bool pageFullySelected = pageIds.Count > 0 && pageIds.All(_selectedIds.Contains);

        if (pageFullySelected)
            foreach (var id in pageIds) _selectedIds.Remove(id); // görünen sayfayı seçimden çıkar
        else
            foreach (var id in pageIds) _selectedIds.Add(id);    // görünen sayfayı seç

        _allSelected = _pagedItems.Count > 0 && _pagedItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _allSelected = false;
        StateHasChanged();
    }

