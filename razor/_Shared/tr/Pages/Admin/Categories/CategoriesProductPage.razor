@* ============================================================
   CategoriesProductManagement.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub — anlık broadcast, debounce, RAM cache
   ✅ ŞİFRELEME YOK — veriler yalın haliyle DB'ye yazılır/okunur
   ✅ TakeLogs — tüm CRUD aksiyonları loglanır
   ✅ Ayrı Ekle / Düzenle / Sil modalleri
   ✅ Seçilenleri Sil → önce onay modali (sayı + liste)
   ✅ 20'li sayfalama + arama (10 dil ad + slug üzerinde)
   ✅ 10 dil (TR, EN, AZ, DE, ES, FR, HI, PT, RU, ZH) form + DB
   ✅ Path alanı otomatik: İngilizce (En) hiyerarşik format
        (Örn: "Sports & Outdoors > Team Sports > Football Equipment")
   ✅ AiAttributesIsOk (bool?) CRUD ile yönetilebilir
   ✅ Soft delete korunur (IsDeleted owned)
   ============================================================ *@
@using data
@using data.Owned;
@using data._Categories;
@using data._Users;

@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    // Bu alanı kesinlikle SİLME. Kullanılsın veya kullanılmasın, global state'den dil bilgisini almak ve yönlendirme yapmak için gereklidir.
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    // NavigationManager.NavigateTo($@"/{use?.Language.ToLower()}/Admin/Categories/List/", true); Dil bilgisini global state'den alarak yönlendirme yapar.
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",       "Ana Sayfa",  "/"),
        ("fa fa-sitemap",    "Kategoriler","javascript:void(0)"),
        ("fa fa-list-alt",   PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    <button class="btn btn-light btn-sm" @onclick="OpenAddModal" disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Kategori</span>
    </button>

    <div class="vr mx-1"></div>

    @* ─── Görünüm modu: Ağaç / Liste ─── *@
    <div class="btn-group btn-group-sm" role="group" aria-label="Görünüm modu">
        <button type="button"
                class="btn @(_viewMode == ViewMode.Tree ? "btn-info text-dark" : "btn-outline-info")"
                @onclick="() => SetViewMode(ViewMode.Tree)"
                title="Hiyerarşik Ağaç Yapısı">
            <i class="fa fa-sitemap"></i>
            <span class="d-none d-sm-inline ms-1">Ağaç</span>
        </button>
        <button type="button"
                class="btn @(_viewMode == ViewMode.List ? "btn-info text-dark" : "btn-outline-info")"
                @onclick="() => SetViewMode(ViewMode.List)"
                title="Liste (Sayfalı)">
            <i class="fa fa-list"></i>
            <span class="d-none d-sm-inline ms-1">Liste</span>
        </button>
    </div>

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light">@_selectedIds.Count seçili</span>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Seçimi Temizle
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-info btn-sm border-0"
                @onclick="OpenBulkEditModal"
                disabled="@_isProcessing">
            <i class="fa fa-sliders"></i> Seçilenleri Düzenle
        </button>

        <button class="btn btn-outline-danger btn-sm border-0"
                @onclick="OpenBulkDeleteModal"
                disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
@if (_viewMode == ViewMode.List)
{
    <div class="input-group input-group-sm mb-2">
        <span class="input-group-text bg-transparent border-secondary text-white">
            <i class="fa fa-search"></i>
        </span>
        <input type="text"
               class="form-control bg-transparent text-light border-secondary"
               placeholder="Kategori adı / slug ara"
               value="@_searchTerm"
               @oninput="OnSearchInput" />
        @if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                <i class="fa fa-times"></i>
            </button>
        }
    </div>
}
else
{
    <div class="input-group input-group-sm mb-2">
        <span class="input-group-text bg-transparent border-secondary text-white">
            <i class="fa fa-search"></i>
        </span>
        <input type="text"
               class="form-control bg-transparent text-light border-secondary"
               placeholder="Ağaçta filtrele (ad üzerinde) — eşleşenler ve üst dalları gösterilir"
               value="@_treeFilter"
               @oninput="OnTreeFilterInput" />
        @if (!string.IsNullOrWhiteSpace(_treeFilter))
        {
            <button class="btn btn-outline-secondary" @onclick="ClearTreeFilter">
                <i class="fa fa-times"></i>
            </button>
        }
        <button class="btn btn-outline-info" @onclick="ExpandAllTree" title="Tümünü Aç">
            <i class="fa fa-plus-square-o"></i>
        </button>
        <button class="btn btn-outline-info" @onclick="CollapseAllTree" title="Tümünü Kapat">
            <i class="fa fa-minus-square-o"></i>
        </button>
    </div>
}

@* ═══════════════════════════════════════════════════════════
   İÇERİK — HİYERARŞİK AĞAÇ YAPISI (Tree)
   ═══════════════════════════════════════════════════════════ *@
@if (_viewMode == ViewMode.Tree)
{
    @if (_nodes.Count == 0)
    {
        <div class="text-center py-5 text-light">
            <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
            <p class="mb-0">Kayıt bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="rounded-3 border p-2" style="background:rgba(0,0,0,0.15);">
            <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                <small class="text-light">
                    <i class="fa fa-sitemap text-info me-1"></i>
                    Toplam @_nodes.Count kategori
                    @if (_selectedIds.Any())
                    {
                        <span class="badge bg-info text-dark ms-1">@_selectedIds.Count seçili</span>
                    }
                </small>
                @if (!string.IsNullOrWhiteSpace(_treeFilter))
                {
                    <small class="text-warning"><i class="fa fa-filter me-1"></i>@_treeVisible.Count eşleşme</small>
                }
            </div>

            <ul class="list-unstyled mb-0 tree-root">
                @foreach (var root in GetChildren(null))
                {
                    @RenderTreeNode(root, 0)
                }
            </ul>
        </div>
    }
}
@* ─── İçerik — LİSTE (Sayfalı) ─── *@
else if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && _totalCount == 0)
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Kayıt bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2rem;">
                        <input type="checkbox" class="form-check-input"
                               checked="@_allSelected"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Kategori (TR)</th>
                    <th class="d-none d-lg-table-cell">Üst Kategori</th>
                    <th class="d-none d-xl-table-cell">Path (En)</th>
                    @*                     <th class="d-none d-md-table-cell">Tarih</th>
 *@
                    <th>Kontroller</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>
                        <td class="d-none d-md-table-cell text-secondary small">@(rowNo++)</td>
                        <td>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.Categories?.NameTr) ? "—" : item.Categories!.NameTr)</div>
                            <div class="small text-warning">@(string.IsNullOrWhiteSpace(item.Categories?.NameEn) ? "" : item.Categories!.NameEn)</div>
                        </td>
                        <td class="d-none d-lg-table-cell">
                            <span class="small">@GetParentName(item.ParentId)</span>
                        </td>
                        <td class="d-none d-xl-table-cell">
                            <span class="small text-light" title="@item.Path">@(string.IsNullOrWhiteSpace(item.Path) ? "—" : item.Path)</span>
                        </td>
                        @*                         <td class="d-none d-md-table-cell text-nowrap">
                            <div class="small">@item.CreatedDate.ToString("dd.MM.yyyy") | @item.CreatedDate.ToString("HH:mm")</div>
                        </td> *@
                        <td class="align-middle">
                            <div class="d-flex align-items-center gap-2">
                                <!-- Aktif Durumu -->
                                <span title="Aktif">
                                    <i class="fa @(item.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary")"></i>
                                </span>

                                <!-- Menüde Göster -->
                                <span title="Menüde Göster">
                                    <i class="fa @(item.ShowInMenu ? "fa-eye text-info" : "fa-eye-slash text-secondary")"></i>
                                </span>

                                <!-- AI Özellikleri -->
                                <span title="AI Özellikleri">
                                    @{
                                        var aiOk = item.AiAttributesIsOk;
                                    }
                                    <i class="fa @(aiOk == true ? "fa-check-circle text-success" : aiOk == false ? "fa-times-circle text-danger" : "fa-question-circle text-secondary")"></i>
                                </span>
                            </div>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_totalCount kayıt
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                    </li>

                    @foreach (var pg in GetPageWindow())
                    {
                        <li class="page-item @(_currentPage == pg ? "active" : "")">
                            <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                    @onclick="() => GoToPage(pg)">
                                @pg
                            </button>
                        </li>
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Ekle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="AddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-plus me-1"></i>Yeni Kategori
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_addModel != null)
                {
                    @ModalForm(_addModel, _addParentId, true)
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="AddAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-plus me-1"></i><span>Yeni Kategori Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Düzenle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(255,215,0,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-pencil me-1"></i>Kategori Düzenle
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_editModel != null)
                {
                    @ModalForm(_editModel, _editParentId, false)
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-warning btn-sm"
                        @onclick="UpdateAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-save me-1"></i><span>Değişiklikleri Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Tekli Sil (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>Silme İşlemi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-white-50 small mb-3">Bu kategoriyi silmek istediğinizden emin misiniz?</p>
                @if (_deleteTarget != null)
                {
                    var childCount = _nodes.Values.Count(x => x.ParentId == _deleteTarget.Id);
                    if (childCount > 0)
                    {
                        <div class="alert alert-warning py-2 small">
                            <i class="fa fa-exclamation-triangle me-1"></i>
                            Bu kategorinin <strong>@childCount</strong> alt kategorisi var. Silmeden önce alt kategorileri kontrol edin.
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Kategori (TR)</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(string.IsNullOrWhiteSpace(_deleteTarget.Categories?.NameTr) ? "—" : _deleteTarget.Categories!.NameTr)" disabled />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-globe me-1"></i>Kategori (EN)</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(string.IsNullOrWhiteSpace(_deleteTarget.Categories?.NameEn) ? "—" : _deleteTarget.Categories!.NameEn)" disabled />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-sitemap me-1"></i>Path (En)</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(string.IsNullOrWhiteSpace(_deleteTarget.Path) ? "—" : _deleteTarget.Path)" disabled />
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="DeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>Evet, Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Toplu Düzenle (Aktif / Menüde Göster / AI Durumu)
   ─────────────────────────────────────────────────────────
   Her alan için "Değiştirme / Uygula" seçeneği. Yalnızca
   "uygula" işaretlenen alanlar seçili kayıtlara yazılır.
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="BulkEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-info"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-info py-2">
                <h6 class="modal-title text-info mb-0">
                    <i class="fa fa-sliders me-2"></i>
                    Toplu Düzenle — @_selectedIds.Count kayıt seçildi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-white-50 small mb-3">
                    <i class="fa fa-info-circle me-1"></i>
                    Yalnızca <strong>"Uygula"</strong> işaretlenen alanlar, seçili
                    <strong>@_selectedIds.Count</strong> kategoriye yazılır. Diğer alanlar olduğu gibi kalır.
                </p>

                @* ── Aktif ── *@
                <div class="d-flex align-items-center justify-content-between border border-secondary rounded p-2 mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="bulk_apply_active"
                               checked="@_bulkApplyActive"
                               @onchange="e => _bulkApplyActive = (bool)(e.Value ?? false)" />
                        <label class="form-check-label text-white" for="bulk_apply_active">
                            <i class="fa fa-toggle-on text-success me-1"></i>Aktiflik Durumu
                        </label>
                    </div>
                    <div class="form-check form-switch @(_bulkApplyActive ? "" : "opacity-50")">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="bulk_val_active" disabled="@(!_bulkApplyActive)"
                               checked="@_bulkValActive"
                               @onchange="e => _bulkValActive = (bool)(e.Value ?? false)" />
                        <label class="form-check-label text-white-50" for="bulk_val_active">
                            @(_bulkValActive ? "Aktif" : "Pasif")
                        </label>
                    </div>
                </div>

                @* ── Menüde Göster ── *@
                <div class="d-flex align-items-center justify-content-between border border-secondary rounded p-2 mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="bulk_apply_menu"
                               checked="@_bulkApplyMenu"
                               @onchange="e => _bulkApplyMenu = (bool)(e.Value ?? false)" />
                        <label class="form-check-label text-white" for="bulk_apply_menu">
                            <i class="fa fa-eye text-info me-1"></i>Menüde Göster
                        </label>
                    </div>
                    <div class="form-check form-switch @(_bulkApplyMenu ? "" : "opacity-50")">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="bulk_val_menu" disabled="@(!_bulkApplyMenu)"
                               checked="@_bulkValMenu"
                               @onchange="e => _bulkValMenu = (bool)(e.Value ?? false)" />
                        <label class="form-check-label text-white-50" for="bulk_val_menu">
                            @(_bulkValMenu ? "Gösteriliyor" : "Gizli")
                        </label>
                    </div>
                </div>

                @* ── AI Özellik Durumu ── *@
                <div class="d-flex align-items-center justify-content-between border border-secondary rounded p-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="bulk_apply_ai"
                               checked="@_bulkApplyAi"
                               @onchange="e => _bulkApplyAi = (bool)(e.Value ?? false)" />
                        <label class="form-check-label text-white" for="bulk_apply_ai">
                            <i class="fa fa-magic text-warning me-1"></i>AI Özellik Durumu
                        </label>
                    </div>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary @(_bulkApplyAi ? "" : "opacity-50")"
                            style="width:auto;" disabled="@(!_bulkApplyAi)"
                            value="@AiStateToString(_bulkValAi)"
                            @onchange="e => _bulkValAi = StringToAiState(e.Value?.ToString())">
                        <option value="null">Beklemede (null)</option>
                        <option value="false">İşlenmedi (false)</option>
                        <option value="true">Tamamlandı (true)</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer border-top border-info py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Vazgeç
                </button>
                <button type="button" class="btn btn-info btn-sm text-dark"
                        @onclick="BulkEditConfirmedAsync"
                        disabled="@(_isProcessing || !(_bulkApplyActive || _bulkApplyMenu || _bulkApplyAi))">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Uygulanıyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-check me-1"></i><span>@_selectedIds.Count Kayda Uygula</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Toplu Sil Onayı (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="BulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>
                    Toplu Silme — @_selectedIds.Count kayıt seçildi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-warning small mb-3">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    Aşağıdaki <strong>@_selectedIds.Count</strong> kategori silinecek. Bu işlem soft delete olarak işaretlenir.
                </p>

                @if (_bulkDeletePreview.Any())
                {
                    <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                        <table class="table table-sm table-dark table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th class="small">#</th>
                                    <th class="small">Kategori (TR)</th>
                                    <th class="small">Kategori (EN)</th>
                                    <th class="small">Path (En)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int n = 1;
                                }
                                @foreach (var item in _bulkDeletePreview)
                                {
                                    <tr>
                                        <td class="small text-warning">@(n++)</td>
                                        <td class="small">@(string.IsNullOrWhiteSpace(item.NameTr) ? "—" : item.NameTr)</td>
                                        <td class="small">@(string.IsNullOrWhiteSpace(item.NameEn) ? "—" : item.NameEn)</td>
                                        <td class="small text-info">@BuildEnPath(item.Id)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"
                        @onclick="() => _bulkDeletePreview.Clear()">
                    <i class="fa fa-arrow-left me-1"></i>Vazgeç
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="BulkDeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>@_selectedIds.Count Kaydı Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   AĞAÇ DÜĞÜMÜ — özyinelemeli (recursive) render
   Her düğüm: aç/kapa oku, seçim kutusu, ad, işlemler.
   Alt dallar yalnızca düğüm açıkken (_expanded) render edilir.
   ═══════════════════════════════════════════ *@
<style>
    .tree-root, .tree-root ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .tree-root .tree-row {
            transition: background-color .12s ease;
            border-radius: .375rem;
        }

            .tree-root .tree-row:hover {
                background-color: rgba(13,202,240,0.10);
            }

            .tree-root .tree-row.tree-selected {
                background-color: rgba(13,202,240,0.18);
            }

        .tree-root .tree-toggle {
            width: 1.25rem;
            text-align: center;
            cursor: pointer;
            user-select: none;
        }

        /* Alt dallar, üst kategorinin İÇİNDE (girintili) render edilir.
           Sol kenardaki kılavuz çizgi, bu dalların hangi kategoriye ait
           olduğunu görsel olarak vurgular. */
        .tree-root .tree-children {
            margin-left: 1.1rem;
            padding-left: .65rem;
            border-left: 2px solid rgba(13,202,240,0.30);
        }
        /* Açık (genişletilmiş) düğümün kendi satırını hafifçe vurgula ki
           hangi düğümün alt ağacına bakıldığı belli olsun. */
        .tree-root .tree-row.tree-open {
            background-color: rgba(13,202,240,0.06);
            box-shadow: inset 2px 0 0 rgba(13,202,240,0.55);
        }

        .tree-root .tree-status i {
            font-size: .9rem;
        }
</style>
@{
    RenderFragment RenderTreeNode(Node node, int depth) =>
    @<text>
        @{
            var children = GetChildren(node.Id);
            var hasChildren = children.Count > 0;
            var isExpanded = _expanded.Contains(node.Id) || !string.IsNullOrWhiteSpace(_treeFilter);
            var isOpen = hasChildren && isExpanded;
            var isSel = _selectedIds.Contains(node.Id);
            var trName = string.IsNullOrWhiteSpace(node.NameTr) ? (string.IsNullOrWhiteSpace(node.NameEn) ? "—" : node.NameEn) : node.NameTr;
            var enName = string.IsNullOrWhiteSpace(node.NameEn) ? "" : node.NameEn;
            var isMatch = !string.IsNullOrWhiteSpace(_treeFilter) && _treeMatched.Contains(node.Id);
        }
        <li>
            <div class="tree-row d-flex align-items-center gap-1 py-1 px-1 @(isSel ? "tree-selected" : "") @(isOpen ? "tree-open" : "")">

                @* Aç / Kapa oku (yaprak düğümde boşluk) *@
                @if (hasChildren)
                {
                    <span class="tree-toggle text-info" @onclick="() => ToggleExpand(node.Id)">
                        <i class="fa @(isExpanded ? "fa-caret-down" : "fa-caret-right")"></i>
                    </span>
                }
                else
                {
                    <span class="tree-toggle text-secondary"><i class="fa fa-circle" style="font-size:.35rem;opacity:.4;"></i></span>
                }

                @* Seçim kutusu *@
                <input type="checkbox" class="form-check-input mt-0"
                       checked="@isSel"
                       @onchange="() => ToggleRowSelection(node.Id)" />

                @* Klasör ikonu *@
                <i class="fa @(hasChildren ? (isExpanded ? "fa-folder-open text-warning" : "fa-folder text-warning") : "fa-tag text-info") ms-1"></i>

                @* Ad (TR öncelik) + EN alt bilgi *@
                <span class="ms-1 flex-grow-1 text-truncate">
                    <span class="fw-semibold @(isMatch ? "text-info" : "text-white")">@trName</span>
                    @if (!string.IsNullOrWhiteSpace(enName))
                    {
                        <span class="small text-warning ms-2">@enName</span>
                    }
                    @if (hasChildren)
                    {
                        <span class="badge bg-secondary ms-2" style="font-size:.65rem;">@children.Count</span>
                    }
                </span>

                @* Durum göstergeleri: Aktif / Menüde Göster / AI Özellik Durumu *@
                <span class="tree-status d-flex align-items-center gap-2 me-1">
                    <span title="Aktif">
                        <i class="fa @(node.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary")"></i>
                    </span>
                    <span title="Menüde Göster">
                        <i class="fa @(node.ShowInMenu ? "fa-eye text-info" : "fa-eye-slash text-secondary")"></i>
                    </span>
                    <span title="AI Özellikleri">
                        <i class="fa @(node.AiAttributesIsOk == true ? "fa-check-circle text-success" : node.AiAttributesIsOk == false ? "fa-times-circle text-danger" : "fa-question-circle text-secondary")"></i>
                    </span>
                </span>

                @* İşlemler *@
                <span class="text-nowrap">
                    <button class="btn btn-outline-success btn-sm border-0 py-0 px-1"
                            @onclick="() => OpenAddModalWithParent(node.Id)" title="Alt Kategori Ekle">
                        <i class="fa fa-plus"></i>
                    </button>
                    <button class="btn btn-outline-warning btn-sm border-0 py-0 px-1"
                            @onclick="() => OpenEditModalById(node.Id)" title="Düzenle">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button class="btn btn-outline-danger btn-sm border-0 py-0 px-1"
                            @onclick="() => OpenDeleteModalById(node.Id)" title="Sil">
                        <i class="fa fa-trash"></i>
                    </button>
                </span>
            </div>

            @* Alt dallar — üst kategorinin İÇİNDE, girintili ve kılavuz çizgili *@
            @if (isOpen)
            {
                <ul class="tree-children">
                    @foreach (var child in children)
                    {
                        @RenderTreeNode(child, depth + 1)
                    }
                </ul>
            }
        </li>
    </text>;
}

@* ═══════════════════════════════════════════
   ORTAK FORM — Ekle/Düzenle modallerinde kullanılır
   isAdd=true → ekle, false → düzenle
   ═══════════════════════════════════════════ *@
@{
    RenderFragment ModalForm(CategoriesProduct model, Guid? currentParentId, bool isAdd) =>
    @<div>
        <div class="row g-3">

            @* ── Üst Kategori (aranabilir typeahead — 50k kayıt için DB tarafı arama) ── *@
            <div class="col-12 col-md-12 position-relative">
                <label class="form-label text-white-50 small"><i class="fa fa-level-up me-1"></i>Üst Kategori</label>

                @* Seçili üst kategori rozeti *@
                @{
                    var pid = isAdd ? _addParentId : _editParentId;
                }
                @if (pid.HasValue && pid.Value != Guid.Empty)
                {
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-info text-dark text-truncate" style="max-width:100%;" title="@BuildEnPath(pid.Value)">
                            <i class="fa fa-sitemap me-1"></i>@BuildEnPath(pid.Value)
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 p-0 px-1"
                                @onclick="() => ClearParentSelection(isAdd)" title="Üst kategoriyi kaldır">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div><span class="badge bg-light"><i class="fa fa-folder-o me-1"></i>Kök Kategori (üst yok)</span></div>
                }

                @* Arama kutusu *@
                <input type="text"
                       class="form-control form-control-sm bg-dark text-white border-secondary"
                       placeholder="Üst kategori ara (ad / path)..."
                       value="@_parentSearchTerm"
                       @oninput="e => OnParentSearchInput(e, model.Id)" />

                @* Sonuç listesi (yalnızca arama varken) *@
                @if (_parentSearching)
                {
                    <div class="border border-secondary rounded mt-1 p-2 bg-black text-center">
                        <i class="fa fa-spinner fa-spin text-info"></i>
                        <span class="small text-light ms-1">Aranıyor...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_parentSearchTerm))
                {
                    <div class="border border-secondary rounded mt-1 bg-black" style="max-height:220px;overflow-y:auto;">
                        @if (_parentResults.Count == 0)
                        {
                            <div class="p-2 small text-warning text-center">Eşleşen üst kategori yok.</div>
                        }
                        else
                        {
                            @foreach (var opt in _parentResults)
                            {
                                <button type="button"
                                        class="btn btn-sm w-100 text-start text-light border-0 rounded-0 border-bottom border-secondary px-2 py-1"
                                        @onclick="() => SelectParent(opt.Id, isAdd)">
                                    <i class="fa fa-sitemap text-info me-1"></i>@opt.Label
                                </button>
                            }
                            @if (_parentResultsTruncated)
                            {
                                <div class="p-1 small text-warning text-center border-top border-secondary">
                                    İlk @PARENT_SEARCH_LIMIT sonuç gösteriliyor — aramayı daraltın.
                                </div>
                            }
                        }
                    </div>
                }
                <small class="text-secondary d-block mt-1">Path alanı üst kategoriye göre otomatik oluşturulur.</small>
            </div>

            @* ── Path önizleme (salt-okunur) ── *@
            <div class="col-12 col-md-12">
                <label class="form-label text-white-50 small"><i class="fa fa-sitemap me-1"></i>Path (En) — Otomatik</label>
                <input type="text" readonly
                       class="form-control form-control-sm bg-black text-info border-secondary"
                       value="@BuildPathPreview(model, currentParentId)" />
            </div>

            @* ── Durum kontrolleri ── *@
            <div class="col-12">
                <div class="d-flex flex-wrap gap-4 mt-1">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="@(isAdd ? "add" : "edit")_isActive"
                               checked="@model.IsActive"
                               @onchange="e => model.IsActive = (bool)(e.Value ?? false)" />
                        <label class="form-check-label text-white-50" for="@(isAdd ? "add" : "edit")_isActive">Aktif</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="@(isAdd ? "add" : "edit")_showInMenu"
                               checked="@model.ShowInMenu"
                               @onchange="e => model.ShowInMenu = (bool)(e.Value ?? false)" />
                        <label class="form-check-label text-white-50" for="@(isAdd ? "add" : "edit")_showInMenu">Menüde Göster</label>
                    </div>
                    <div>
                        <label class="form-label text-white-50 small mb-0 me-2"><i class="fa fa-magic me-1"></i>AI Özellik Durumu</label>
                        <select class="form-select form-select-sm bg-dark text-white border-secondary d-inline-block" style="width:auto;"
                                value="@AiStateToString(model.AiAttributesIsOk)"
                                @onchange="e => model.AiAttributesIsOk = StringToAiState(e.Value?.ToString())">
                            <option value="null">Beklemede (null)</option>
                            <option value="false">İşlenmedi (false)</option>
                            <option value="true">Tamamlandı (true)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <hr class="border-secondary my-3" />

        @* ── Kategori Adları (10 dil) ── *@
        <h6 class="text-info small mb-2"><i class="fa fa-tags me-1"></i>Kategori Adları (10 Dil)</h6>
        <div class="row g-2">
            @foreach (var lang in _langs)
            {
                <div class="col-12 col-md-6 col-lg-6">
                    <label class="form-label text-white-50 small mb-1">@lang.Flag @lang.Label</label>
                    <input type="text"
                           class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="@lang.Label adı"
                           value="@lang.GetName(model.Categories!)"
                           @onchange="async e => await OnNameChangedAsync(model, lang, e.Value?.ToString() ?? string.Empty)" />
                </div>
            }
        </div>

        <hr class="border-secondary my-3" />

        @* ── SEO Slug (10 dil) ── *@
        <h6 class="text-info small mb-2"><i class="fa fa-link me-1"></i>SEO Slug (10 Dil — opsiyonel)</h6>
        <div class="row g-2">
            @foreach (var lang in _langs)
            {
                <div class="col-12 col-md-6 col-lg-6">
                    <label class="form-label text-white-50 small mb-1">@lang.Flag @lang.Label</label>
                    <input type="text"
                           class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="@lang.Code.ToLower() slug"
                           value="@lang.GetSlug(model.Categories!)"
                           @onchange="e => lang.SetSlug(model.Categories!, e.Value?.ToString())" />
                </div>
            }
        </div>
    </div>;
}

@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Ürün Kategori Yönetimi";
    private const string ENTITY_NAME = "CategoriesProduct";
    // Hafif parent/Path ağacının cache anahtarı (tek sefer yüklenir, yazmada tazelenir)
    private const string NODES_CACHE_KEY = "CategoriesProduct_Nodes";
    private const int SEARCH_DELAY = 250; // ~saniyenin 1/4'ü — yazma durunca ara
    private const int PAGE_SIZE = 20;
    // Üst kategori typeahead: her aramada DB'den en fazla bu kadar sonuç getirilir.
    private const int PARENT_SEARCH_LIMIT = 20;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;

    // ─── Görünüm modu (Ağaç / Liste) ──────────────────────────────
    private enum ViewMode { Tree, List }
    private ViewMode _viewMode = ViewMode.Tree; // varsayılan: hiyerarşik ağaç

    // ─── Ağaç durumu ──────────────────────────────────────────────
    // Açık düğümler (aç/kapa). Kök düğümler ilk yüklemede otomatik açılır.
    private readonly HashSet<Guid> _expanded = new();
    private bool _treeExpandInit; // kökleri bir kez otomatik açmak için
    // Ağaç filtresi: ad üzerinde arama; eşleşenler + üst dalları görünür.
    private string _treeFilter = string.Empty;
    private CancellationTokenSource? _treeFilterCts;
    private readonly HashSet<Guid> _treeMatched = new(); // filtreye doğrudan uyanlar
    private readonly HashSet<Guid> _treeVisible = new(); // eşleşen + atalar + torunlar
    // ParentId → çocuklar (ada göre sıralı) — ağaç render'ı için bir kez kurulur.
    private Dictionary<Guid, List<Node>> _childrenByParent = new();

    // ─── Veriler ──────────────────────────────────────────────────
    // Yalnızca GÖRÜNEN sayfa (20 kayıt) DB'den tam entity olarak çekilir.
    private List<CategoriesProduct> _pagedItems = new();

    // Path/parent çözümü için HAFİF ağaç sözlüğü.
    // 50k kayıtta bile küçük: sadece Id, ParentId, NameEn, NameTr taşınır.
    // Cache'te tutulur, yalnızca yazma işlemlerinden sonra tazelenir.
    private sealed class Node
    {
        public Guid Id;
        public Guid? ParentId;
        public string? NameEn;
        public string? NameTr;
        public bool IsActive;
        public bool ShowInMenu;
        public bool? AiAttributesIsOk;
    }
    private Dictionary<Guid, Node> _nodes = new();

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _totalCount = 0; // sunucudan gelen toplam kayıt sayısı (filtreye göre)

    // ─── Ekle modal state ─────────────────────────────────────────
    private CategoriesProduct? _addModel;
    private Guid? _addParentId;

    // ─── Düzenle modal state ──────────────────────────────────────
    private CategoriesProduct? _editModel;
    private Guid? _editParentId;

    // ─── Üst kategori typeahead state (Ekle/Düzenle ortak) ────────
    // 50k kayıt native <select>'e basılmadığından burada yalnızca aktif
    // arama sonuçları (max PARENT_SEARCH_LIMIT) tutulur.
    private string _parentSearchTerm = string.Empty;
    private bool _parentSearching;
    private bool _parentResultsTruncated;
    private List<(Guid Id, string Label)> _parentResults = new();
    private CancellationTokenSource? _parentSearchCts;

    // ─── Sil modal state ──────────────────────────────────────────
    private CategoriesProduct? _deleteTarget;

    // ─── Toplu Sil state ──────────────────────────────────────────
    private readonly HashSet<Guid> _selectedIds = new();
