    private async Task AddAsync()
    {
        if (_isProcessing || _addModel == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            _addModel.Id = Guid.NewGuid();
            _addModel.ParentId = _addParentId;
            _addModel.CreatedDate = DateTime.UtcNow;
            _addModel.UpdatedDate = null;
            _addModel.Categories ??= new Categories();

            // Soft delete: yeni kayıt aktif başlasın
            _addModel.IsDeleted = new IsDeleted { IsDeletedStatu = false, DeletedAtDate = null };

            // Otomatik Path (En hiyerarşik) — lookup'a ekleyip hesapla
            _addModel.Path = ComputeFinalPath(_addModel);

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.CategoriesProduct.Add(_addModel);
            await db.SaveChangesAsync(_cts.Token);

            await HideModal("AddModal");
            _addModel = null;
            _addParentId = null;
            _isProcessing = false;

            StateHub.ClearCache(NODES_CACHE_KEY);
            await LoadNodesAsync(forceReload: true);
            await LoadPageAsync(1, _searchTerm);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Add");
            await Notify("success", "Başarılı", "Kategori eklendi.");
        }
        catch (Exception ex)
        {
            await LogError("AddAsync", ex);
            await Notify("danger", "Hata", "Kayıt sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Güncelle
    // ══════════════════════════════════════════════════════════════

    private async Task UpdateAsync()
    {
        if (_isProcessing || _editModel == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.CategoriesProduct.FindAsync(new object[] { _editModel.Id }, _cts.Token);

            if (existing == null)
            {
                await Notify("warning", "Uyarı", "Kayıt artık mevcut değil.");
                return;
            }

            // Yalın güncelle (şifreleme yok)
            existing.ParentId = _editParentId;
            existing.IsActive = _editModel.IsActive;
            existing.ShowInMenu = _editModel.ShowInMenu;
            existing.AiAttributesIsOk = _editModel.AiAttributesIsOk;
            existing.UpdatedDate = DateTime.UtcNow;

            var cat = existing.Categories ??= new Categories();
            var src = _editModel.Categories ?? new Categories();
            cat.NameTr = src.NameTr; cat.NameEn = src.NameEn; cat.NameAz = src.NameAz; cat.NameDe = src.NameDe;
            cat.NameEs = src.NameEs; cat.NameFr = src.NameFr; cat.NameHi = src.NameHi; cat.NamePt = src.NamePt;
            cat.NameRu = src.NameRu; cat.NameZh = src.NameZh;
            cat.SlugTr = src.SlugTr; cat.SlugEn = src.SlugEn; cat.SlugAz = src.SlugAz; cat.SlugDe = src.SlugDe;
            cat.SlugEs = src.SlugEs; cat.SlugFr = src.SlugFr; cat.SlugHi = src.SlugHi; cat.SlugPt = src.SlugPt;
            cat.SlugRu = src.SlugRu; cat.SlugZh = src.SlugZh;

            // Hafif ağacı güncel modelle senkronla (isim/parent değişimi Path'e yansısın)
            _editModel.ParentId = _editParentId;
            _nodes[existing.Id] = new Node
            {
                Id = existing.Id,
                ParentId = _editParentId,
                NameEn = cat.NameEn,
                NameTr = cat.NameTr
            };

            // Bu kategorinin ve tüm alt ağacın Path'lerini yeniden yaz
            existing.Path = BuildEnPath(existing.Id);
            existing.ParentId = _editParentId;
            await RewriteSubtreePathsAsync(db, existing.Id, _cts.Token);

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("EditModal");
            _editModel = null;
            _editParentId = null;
            _isProcessing = false;

            StateHub.ClearCache(NODES_CACHE_KEY);
            await LoadNodesAsync(forceReload: true);
            await LoadPageAsync(_currentPage, _searchTerm);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Update");
            await Notify("success", "Başarılı", "Kategori güncellendi.");
        }
        catch (Exception ex)
        {
            await LogError("UpdateAsync", ex);
            await Notify("danger", "Hata", "Güncelleme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

