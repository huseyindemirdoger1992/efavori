    // ══════════════════════════════════════════════════════════════
    // ÜST KATEGORİ TYPEAHEAD — DB tarafı, aranabilir, sayfalı
    // 50k kaydın tamamını basmak yerine kullanıcının yazdığı terimle
    // DB'de LIKE arayıp yalnızca ilk PARENT_SEARCH_LIMIT sonucu getirir.
    // Kendisi ve alt ağacı (döngü engeli) sonuçlardan çıkarılır.
    // ══════════════════════════════════════════════════════════════

    private async Task OnParentSearchInput(ChangeEventArgs e, Guid selfId)
    {
        _parentSearchTerm = e.Value?.ToString() ?? string.Empty;
        await SearchParentOptionsAsync(_parentSearchTerm, selfId);
    }

    private async Task SearchParentOptionsAsync(string? term, Guid selfId)
    {
        _parentSearchCts?.Cancel();
        _parentSearchCts?.Dispose();
        _parentSearchCts = new CancellationTokenSource();
        var token = _parentSearchCts.Token;

        // Boş arama: sonuç listesini kapat
        if (string.IsNullOrWhiteSpace(term))
        {
            _parentResults = new();
            _parentResultsTruncated = false;
            _parentSearching = false;
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(SEARCH_DELAY, token); // debounce
            if (token.IsCancellationRequested) return;

            _parentSearching = true;
            StateHasChanged();

            // Döngü engeli: kendisi + alt ağacı hariç (hafif ağaçtan çözülür)
            var banned = new HashSet<Guid>();
            if (selfId != Guid.Empty)
            {
                banned.Add(selfId);
                CollectDescendants(selfId, banned);
            }

            var like = $"%{term.Trim()}%";

            await using var db = await DbFactory.CreateDbContextAsync(token);

            // DB tarafı: silinmemiş + 10 dil ad + Path üzerinde LIKE.
            // banned küçük bir küme olduğundan Contains ile dışlanır.
            // Yalnızca Id çekilir; etiket (Path) hafif ağaçtan üretilir → ucuz.
            var ids = await db.CategoriesProduct.AsNoTracking()
                .Where(x => (x.IsDeleted == null
                          || x.IsDeleted.IsDeletedStatu == null
                          || x.IsDeleted.IsDeletedStatu == false)
                         && !banned.Contains(x.Id)
                         && (EF.Functions.Like(x.Path!, like) ||
                             EF.Functions.Like(x.Categories!.NameTr, like) ||
                             EF.Functions.Like(x.Categories!.NameEn, like) ||
                             EF.Functions.Like(x.Categories!.NameAz, like) ||
                             EF.Functions.Like(x.Categories!.NameDe, like) ||
                             EF.Functions.Like(x.Categories!.NameEs, like) ||
                             EF.Functions.Like(x.Categories!.NameFr, like) ||
                             EF.Functions.Like(x.Categories!.NameHi, like) ||
                             EF.Functions.Like(x.Categories!.NamePt, like) ||
                             EF.Functions.Like(x.Categories!.NameRu, like) ||
                             EF.Functions.Like(x.Categories!.NameZh, like)))
                .OrderBy(x => x.Path)
                .Select(x => x.Id)
                .Take(PARENT_SEARCH_LIMIT + 1) // +1 → "daha fazla var mı" tespiti
                .ToListAsync(token);

            if (token.IsCancellationRequested) return;

            _parentResultsTruncated = ids.Count > PARENT_SEARCH_LIMIT;
            _parentResults = ids
                .Take(PARENT_SEARCH_LIMIT)
                .Select(id => (Id: id, Label: BuildEnPath(id))) // etiket hafif ağaçtan
                .OrderBy(x => x.Label, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested) await LogError("SearchParentOptions", ex);
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _parentSearching = false;
                StateHasChanged();
            }
        }
    }

