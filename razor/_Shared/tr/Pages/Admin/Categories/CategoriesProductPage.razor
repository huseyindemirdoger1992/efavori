    // Bir kategorinin tüm alt ağacını toplar (döngü engeli için)
    private void CollectDescendants(Guid id, HashSet<Guid> acc)
    {
        foreach (var child in _nodes.Values.Where(x => x.ParentId == id))
        {
            if (acc.Add(child.Id))
                CollectDescendants(child.Id, acc);
        }
    }

    // Verilen kategorinin İngilizce (En) hiyerarşik Path'ini oluşturur.
    // Örn: "Sports & Outdoors > Team Sports > Football Equipment"
    private string BuildEnPath(Guid id)
    {
        var parts = new List<string>();
        var guard = new HashSet<Guid>();
        var current = id;

        while (current != Guid.Empty && _nodes.TryGetValue(current, out var node) && guard.Add(current))
        {
            var en = node.NameEn;
            if (string.IsNullOrWhiteSpace(en)) en = node.NameTr; // EN yoksa TR'ye düş
            parts.Insert(0, string.IsNullOrWhiteSpace(en) ? "?" : en!.Trim());

            if (node.ParentId == null || node.ParentId == Guid.Empty) break;
            current = node.ParentId.Value;
        }

        return string.Join(" > ", parts);
    }

    // Modal formunda canlı Path önizlemesi: seçili parent + mevcut EN adı
    private string BuildPathPreview(CategoriesProduct model, Guid? parentId)
    {
        var self = model.Categories?.NameEn;
        if (string.IsNullOrWhiteSpace(self)) self = model.Categories?.NameTr;
        self = string.IsNullOrWhiteSpace(self) ? "?" : self!.Trim();

        if (parentId == null || parentId == Guid.Empty) return self;

        var parentPath = _nodes.ContainsKey(parentId.Value) ? BuildEnPath(parentId.Value) : "";
        return string.IsNullOrWhiteSpace(parentPath) ? self : $"{parentPath} > {self}";
    }

    // Kaydetmeden hemen önce nihai Path'i hesaplar (ağaca güncel self'i ekleyerek).
    private string ComputeFinalPath(CategoriesProduct model)
    {
        // Geçici node: kendi güncel halini de ağaca dahil et ki isim/parent değişikliği yansısın
        _nodes[model.Id] = new Node
        {
            Id = model.Id,
            ParentId = model.ParentId,
            NameEn = model.Categories?.NameEn,
            NameTr = model.Categories?.NameTr
        };
        return BuildEnPath(model.Id);
    }

    // ── Bir parent'ı değiştiğinde: kendisi ve tüm alt ağacın Path'lerini yeniden yaz ──
    // Yalnızca etkilenen alt ağaç DB'den çekilip güncellenir (tüm tablo değil).
    private async Task RewriteSubtreePathsAsync(_ApplicationConnectionDb db, Guid rootId, CancellationToken token)
    {
        var affected = new HashSet<Guid> { rootId };
        CollectDescendants(rootId, affected);

        // rootId zaten çağıran tarafça güncellendiği için burada onu atlıyoruz.
        var childIds = affected.Where(x => x != rootId).ToList();
        if (childIds.Count == 0) return;

        var tracked = await db.CategoriesProduct
            .Where(x => childIds.Contains(x.Id))
            .ToListAsync(token);

        foreach (var entity in tracked)
        {
            var newPath = BuildEnPath(entity.Id);
            if (entity.Path != newPath)
            {
                entity.Path = newPath;
                entity.UpdatedDate = DateTime.UtcNow;
            }
        }
    }

