    // ══════════════════════════════════════════════════════════════
    // SLUG OTOMASYONU (10 dil)
    // ─────────────────────────────────────────────────────────────
    // Bir dilin ADI değiştiğinde, o dile ait SEO slug alanını otomatik doldurur.
    // Kural: slug'ı yalnızca boşken VEYA kullanıcının el ile değiştirmediği
    //        (önceki addan otomatik türetilmiş) durumda güncelle. Böylece
    //        kullanıcının manuel yazdığı slug korunur.
    // Benzersizlik: DB'de aynı slug varsa "slug_1", "slug_2", ... şeklinde
    //        1'den başlayıp benzersiz olana kadar 1'er artırılır.
    // ══════════════════════════════════════════════════════════════

    // Model.Id → (langCode → en son otomatik üretilmiş slug). Kullanıcının
    // el ile mi yazdığını, yoksa bizim mi türettiğimizi ayırt etmek için.
    private readonly Dictionary<(Guid, string), string> _autoSlugTrack = new();

    private async Task OnNameChangedAsync(CategoriesProduct model, LangDef lang, string newName)
    {
        // 1) Adı yaz
        lang.SetName(model.Categories!, newName);

        // 2) Slug otomasyonu — mevcut slug'ı oku
        var currentSlug = lang.GetSlug(model.Categories!) ?? string.Empty;
        var trackKey = (model.Id, lang.Code);
        var lastAuto = _autoSlugTrack.TryGetValue(trackKey, out var la) ? la : null;

        // Slug boşsa VEYA en son bizim ürettiğimiz değerse → yeniden üret.
        // Kullanıcı el ile farklı bir slug yazmışsa dokunma.
        bool mayOverwrite = string.IsNullOrWhiteSpace(currentSlug)
                            || (lastAuto != null && currentSlug == lastAuto);

        if (!mayOverwrite) return;

        var baseSlug = Slugify(newName);
        if (string.IsNullOrWhiteSpace(baseSlug))
        {
            // Ad temizlenmişse slug'ı da temizle (yalnızca otomatikse)
            if (mayOverwrite) { lang.SetSlug(model.Categories!, null); _autoSlugTrack.Remove(trackKey); }
            return;
        }

        // 3) DB'de benzersiz olana kadar "_X" ekle (X: 1'den artan)
        var uniqueSlug = await MakeUniqueSlugAsync(lang.Code, baseSlug, model.Id);

        lang.SetSlug(model.Categories!, uniqueSlug);
        _autoSlugTrack[trackKey] = uniqueSlug;
        StateHasChanged();
    }

    // Metni URL-dostu slug'a çevirir: küçük harf, aksan/diakritik temizliği,
    // Türkçe özel karakter eşleme, alfasayısal dışını "-" ile birleştirme.
    private static string Slugify(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;

        var text = input.Trim().ToLowerInvariant();

        // Türkçe/yaygın özel karakter eşlemeleri (kültür-bağımsız, güvenli)
        var sb = new System.Text.StringBuilder(text.Length);
        foreach (var ch in text)
        {
            switch (ch)
            {
                case 'ı': case 'i': sb.Append('i'); break;
                case 'ğ': sb.Append('g'); break;
                case 'ü': sb.Append('u'); break;
                case 'ş': sb.Append('s'); break;
                case 'ö': sb.Append('o'); break;
                case 'ç': sb.Append('c'); break;
                case 'ä': sb.Append('a'); break;
                case 'ß': sb.Append("ss"); break;
                case 'ñ': sb.Append('n'); break;
                case 'á': case 'à': case 'â': case 'ã': sb.Append('a'); break;
                case 'é': case 'è': case 'ê': sb.Append('e'); break;
                case 'í': case 'ì': case 'î': sb.Append('i'); break;
                case 'ó': case 'ò': case 'ô': case 'õ': sb.Append('o'); break;
                case 'ú': case 'ù': case 'û': sb.Append('u'); break;
                default: sb.Append(ch); break;
            }
        }

        // Unicode aksanlarını ayıklama (kalan diakritikler için)
        var normalized = sb.ToString().Normalize(System.Text.NormalizationForm.FormD);
        var clean = new System.Text.StringBuilder(normalized.Length);
        foreach (var ch in normalized)
        {
            var cat = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch);
            if (cat == System.Globalization.UnicodeCategory.NonSpacingMark) continue;

            if (char.IsLetterOrDigit(ch)) clean.Append(ch);
            else clean.Append('-'); // ayraç/boşluk/noktalama → tire
        }

        // Fazla tireleri sadeleştir
        var slug = System.Text.RegularExpressions.Regex.Replace(clean.ToString(), "-{2,}", "-");
        return slug.Trim('-');
    }

    // DB'de aynı slug var mı diye kontrol eder; varsa base_1, base_2, ...
    // benzersiz olana kadar dener. selfId (düzenlemede kendi kaydı) hariç tutulur.
    private async Task<string> MakeUniqueSlugAsync(string langCode, string baseSlug, Guid selfId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var candidate = baseSlug;
            int suffix = 1;

            while (await SlugExistsAsync(db, langCode, candidate, selfId, _cts.Token))
            {
                candidate = $"{baseSlug}_{suffix}";
                suffix++;
            }
            return candidate;
        }
        catch (Exception ex)
        {
            await LogError("MakeUniqueSlug", ex);
            return baseSlug; // hata olursa en azından temel slug'ı ver
        }
    }

    // İlgili dil sütununda bu slug var mı? (silinmemiş + kendisi hariç)
    private static Task<bool> SlugExistsAsync(
        _ApplicationConnectionDb db, string langCode, string slug, Guid selfId, CancellationToken token)
    {
        var q = db.CategoriesProduct.AsNoTracking()
            .Where(x => (x.IsDeleted == null
                      || x.IsDeleted.IsDeletedStatu == null
                      || x.IsDeleted.IsDeletedStatu == false)
                     && x.Id != selfId);

        q = langCode switch
        {
            "TR" => q.Where(x => x.Categories!.SlugTr == slug),
            "EN" => q.Where(x => x.Categories!.SlugEn == slug),
            "AZ" => q.Where(x => x.Categories!.SlugAz == slug),
            "DE" => q.Where(x => x.Categories!.SlugDe == slug),
            "ES" => q.Where(x => x.Categories!.SlugEs == slug),
            "FR" => q.Where(x => x.Categories!.SlugFr == slug),
            "HI" => q.Where(x => x.Categories!.SlugHi == slug),
            "PT" => q.Where(x => x.Categories!.SlugPt == slug),
            "RU" => q.Where(x => x.Categories!.SlugRu == slug),
            "ZH" => q.Where(x => x.Categories!.SlugZh == slug),
            _ => q.Where(x => false)
        };

        return q.AnyAsync(token);
    }

