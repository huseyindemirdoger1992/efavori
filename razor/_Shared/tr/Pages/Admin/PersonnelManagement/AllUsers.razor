    private async Task OpenEditModal(Guid id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            _editUser = await db.Users.FirstOrDefaultAsync(x => x.Id == id, _cts.Token);
            if (_editUser == null) { await Notify("warning", "Uyarı", "Kullanıcı bulunamadı."); return; }

            _editProfile = await db.UserProfiles.FirstOrDefaultAsync(x => x.UserId == id, _cts.Token);
            if (_editProfile == null)
            {
                _editProfile = new UserProfiles { UserId = id };
                db.UserProfiles.Add(_editProfile);
                await db.SaveChangesAsync(_cts.Token);
            }
            _editProfile.ContactInformation ??= new ContactInformation();

            _editSettings = await db.UserSettings.FirstOrDefaultAsync(x => x.UserId == id, _cts.Token);
            if (_editSettings == null)
            {
                _editSettings = new UserSettings { UserId = id };
                db.UserSettings.Add(_editSettings);
                await db.SaveChangesAsync(_cts.Token);
            }

            _editPrivacy = await db.UserPrivacySettings.FirstOrDefaultAsync(x => x.UserId == id, _cts.Token);
            if (_editPrivacy == null)
            {
                _editPrivacy = new UserPrivacySettings { UserId = id };
                db.UserPrivacySettings.Add(_editPrivacy);
                await db.SaveChangesAsync(_cts.Token);
            }

            await ShowModal("EditModal");
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "OpenEdit");
        }
        catch (Exception ex)
        {
            await LogError("OpenEditModal", ex);
            await Notify("danger", "Hata", "Kullanıcı açılırken sorun oluştu.");
        }
    }

    private async Task OpenDeleteModal(UserRow row, bool restore)
