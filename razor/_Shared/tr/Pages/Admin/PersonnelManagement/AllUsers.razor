@* ============================================================
   UsersList.razor
   ─────────────────────────────────────────────────────────────
   ✅ Kapsamlı Kullanıcı Yönetimi — GÜNCEL ENTİTY YAPISINA UYARLANMIŞ
   ✅ Sunucu tarafı sayfalama (her sayfada 10 kayıt)
   ✅ Arama (UserProfiles.FirstName/LastName + Users.Email)
   ✅ Silinenleri göster/gizle (soft delete)
   ✅ Sekmeli "Düzenle" modalı — güncel entity yapısı:
        • Temel: Users (hesap durumu, tip, satıcı yetkisi) + UserProfiles (ad/soyad/bio)
        • Tercih: UserSettings (dil, para birimi, bildirim)
        • İletişim: UserProfiles.ContactInformation (owned)
        • Sosyal: UserProfiles.ContactInformation (owned — sosyal medya alanları)
        • Gizlilik: UserPrivacySettings (PrivacyAudience enum'ları)
        • Medya: UserProfiles.AvatarMediaId / CoverMediaId
   ✅ Parola bu panelde gösterilmez / değiştirilmez (UserSecurity ayrı)
   ============================================================ *@
@using data
@using data.Owned;
@using data._Attribute;
@using data._Carts;
@using data._Categories;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;

@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<data._ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",  "Ana Sayfa",  "/"),
        ("fa fa-users", "Yönetim",    "javascript:void(0)"),
        ("fa fa-user",  PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button class="btn btn-light btn-sm" @onclick="RefreshAsync" disabled="@_isLoading">
        <i class="fa fa-refresh me-sm-1 @(_isLoading ? "fa-spin" : "")"></i>
        <span class="d-none d-sm-inline">Yenile</span>
    </button>
    <div class="vr mx-1"></div>
    <span class="badge bg-light text-light"><i class="fa fa-users me-1"></i>@_totalCount kullanıcı</span>
    <div class="vr mx-1"></div>
    <div class="form-check form-switch text-light small mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="showDeleted"
               checked="@_includeDeleted" @onchange="ToggleIncludeDeleted" />
        <label class="form-check-label" for="showDeleted">Silinenleri göster</label>
    </div>
</div>

<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white"><i class="fa fa-search"></i></span>
    <input type="text" class="form-control bg-transparent text-light border-secondary"
           placeholder="Ad, soyad veya e-posta ara" value="@_searchTerm" @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch"><i class="fa fa-times"></i></button>
    }
</div>

@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && _totalCount == 0)
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Kullanıcı bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Ad Soyad</th>
                    <th class="d-none d-lg-table-cell">E-posta</th>
                    <th class="d-none d-md-table-cell">Tip</th>
                    <th class="text-center">Durum</th>
                    <th class="d-none d-md-table-cell">Kayıt</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var row in _pagedItems)
                {
                    var u = row.User;
                    var isDeleted = u.IsDeleted?.IsDeletedStatu == true;
                    <tr class="@(isDeleted ? "table-secondary opacity-75" : "")">
                        <td class="d-none d-md-table-cell text-light small">@(rowNo++)</td>
                        <td>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(row.FullName) ? "—" : row.FullName)</div>
                            <div class="small text-light text-truncate" style="max-width:12rem;">@u.Id</div>
                        </td>
                        <td class="d-none d-lg-table-cell small text-truncate" style="max-width:16rem;">
                            @(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)
                        </td>
                        <td class="d-none d-md-table-cell">
                            <span class="badge @(u.UserType == UserType.SuperAdmin ? "bg-primary" : "bg-light")">@u.UserType</span>
                        </td>
                        <td class="text-center">
                            @if (isDeleted)
                            {
                                <span class="badge bg-dark border border-secondary text-light"><i class="fa fa-trash"></i> Silinmiş</span>
                            }
                            else if (u.AccountStatus == UserAccountStatus.Active)
                            {
                                <span class="badge bg-success-subtle text-success"><i class="fa fa-check"></i> Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning"><i class="fa fa-pause"></i> @u.AccountStatus</span>
                            }
                        </td>
                        <td class="d-none d-md-table-cell text-nowrap small">@u.RegistrationDateUtc.ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(u.Id)" title="Düzenle">
                                <i class="fa fa-cog"></i><span class="d-none d-xl-inline ms-1">Ayarlar</span>
                            </button>
                            @if (isDeleted)
                            {
                                <button class="btn btn-outline-success btn-sm" @onclick="() => OpenDeleteModal(row, restore: true)" title="Geri Al">
                                    <i class="fa fa-undo"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(row, restore: false)" title="Sil">
                                    <i class="fa fa-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_totalCount kayıt · Sayfa @_currentPage / @_totalPages
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>
        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0 flex-nowrap">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary" @onclick="() => GoToPage(1)"><i class="fa fa-angle-double-left"></i></button>
                    </li>
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary" @onclick="() => GoToPage(_currentPage - 1)"><i class="fa fa-chevron-left"></i></button>
                    </li>
                    @foreach (var pg in _pageWindow)
                    {
                        <li class="page-item @(_currentPage == pg ? "active" : "")">
                            <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary" @onclick="() => GoToPage(pg)">@pg</button>
                        </li>
                    }
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary" @onclick="() => GoToPage(_currentPage + 1)"><i class="fa fa-chevron-right"></i></button>
                    </li>
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary" @onclick="() => GoToPage(_totalPages)"><i class="fa fa-angle-double-right"></i></button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══ MODAL — Kapsamlı Düzenleme (Sekmeli) ═══ *@
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content bg-dark border border-warning" style="box-shadow:0 0 8px rgba(255,193,7,0.35);">
            <div class="modal-header border-bottom border-warning py-2">
                <h6 class="modal-title text-warning mb-0">
                    <i class="fa fa-cog me-1"></i>Kullanıcı Ayarları
                    @if (_editProfile != null && !string.IsNullOrWhiteSpace(_editProfile.FirstName))
                    {
                        <span class="text-white-50 small ms-2">— @_editProfile.FirstName @_editProfile.LastName</span>
                    }
                </h6>
                <button type="button" class="btn btn-sm text-danger border-0" data-bs-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>
            <div class="modal-body">
                @if (_editUser != null && _editProfile != null)
                {
                    <ul class="nav nav-pills nav-fill mb-3 small flex-nowrap overflow-auto">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-basic" type="button"><i class="fa fa-id-card me-1"></i>Temel</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-prefs" type="button"><i class="fa fa-sliders me-1"></i>Tercih</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-contact" type="button"><i class="fa fa-address-book me-1"></i>İletişim</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-social" type="button"><i class="fa fa-share-alt me-1"></i>Sosyal</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-privacy" type="button"><i class="fa fa-lock me-1"></i>Gizlilik</button></li>
                    </ul>
                    <div class="tab-content">

                        @* ═══ TEMEL ═══ *@
                        <div class="tab-pane fade show active" id="tab-basic">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label text-white-50 small">Ad</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editProfile.FirstName" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label text-white-50 small">Soyad</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editProfile.LastName" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label text-white-50 small">Kullanıcı Adı</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editProfile.Username" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label text-white-50 small">Görünen Ad</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editProfile.DisplayName" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label text-white-50 small">Bio</label>
                                    <textarea class="form-control form-control-sm bg-dark text-white border-secondary" rows="2" @bind="_editProfile.Bio"></textarea>
                                </div>
                                <div class="col-12"><hr class="border-secondary my-1" /></div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-white-50 small">Hesap Durumu</label>
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editUser.AccountStatus">
                                        @foreach (var s in Enum.GetValues<UserAccountStatus>())
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-white-50 small">Kullanıcı Tipi</label>
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editUser.UserType">
                                        @foreach (var t in Enum.GetValues<UserType>())
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-white-50 small">Satıcı Yetkisi</label>
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editUser.VendorCapability">
                                        @foreach (var v in Enum.GetValues<VendorCapability>())
                                        {
                                            <option value="@v">@v</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-white-50 small">Profil Görünürlüğü</label>
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editProfile.ProfileVisibility">
                                        @foreach (var pv in Enum.GetValues<ProfileVisibility>())
                                        {
                                            <option value="@pv">@pv</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-white-50 small">E-posta</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editUser.Email" />
                                </div>
                                <div class="col-12 col-md-4 d-flex align-items-end gap-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" checked="@_editUser.IsEmployee" @onchange="e => _editUser.IsEmployee = Cb(e)" />
                                        <label class="form-check-label text-white-50">Çalışan</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="alert alert-secondary bg-transparent border-secondary text-white-50 small mb-0 py-2">
                                        <i class="fa fa-shield me-1"></i>Güvenlik: Parola bu panelden görüntülenemez ve değiştirilemez.
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ═══ TERCİH (UserSettings) ═══ *@
                        <div class="tab-pane fade" id="tab-prefs">
                            @if (_editSettings != null)
                            {
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label text-white-50 small">Dil</label>
                                        <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editSettings.Language">
                                            @foreach (var l in Enum.GetValues<Language>())
                                            {
                                                <option value="@l">@l</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label text-white-50 small">Para Birimi</label>
                                        <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editSettings.Currency">
                                            @foreach (var c in Enum.GetValues<CurrencyCode>())
                                            {
                                                <option value="@c">@c</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label text-white-50 small">Saat Dilimi</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editSettings.TimeZoneId" placeholder="Europe/Istanbul" />
                                    </div>
                                    <div class="col-12"><hr class="border-secondary my-1" /><small class="text-white-50">Bildirim Ayarları</small></div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@_editSettings.EmailNotificationsEnabled" @onchange="e => _editSettings.EmailNotificationsEnabled = Cb(e)" />
                                            <label class="form-check-label text-white-50 small">E-posta</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@_editSettings.PushNotificationsEnabled" @onchange="e => _editSettings.PushNotificationsEnabled = Cb(e)" />
                                            <label class="form-check-label text-white-50 small">Push</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@_editSettings.SmsNotificationsEnabled" @onchange="e => _editSettings.SmsNotificationsEnabled = Cb(e)" />
                                            <label class="form-check-label text-white-50 small">SMS</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@_editSettings.PersonalizedAdsEnabled" @onchange="e => _editSettings.PersonalizedAdsEnabled = Cb(e)" />
                                            <label class="form-check-label text-white-50 small">Kişisel Reklam</label>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {

                                <p class="text-light small">Tercih kaydı bulunamadı.</p>
                            }
                        </div>

                        @* ═══ İLETİŞİM (ContactInformation owned) ═══ *@
                        <div class="tab-pane fade" id="tab-contact">
                            @{
                                var contact = _editProfile?.ContactInformation;
                            }
                            @if (contact != null)
                            {
                                <div class="row g-3">
                                    <div class="col-12 col-md-8">
                                        <label class="form-label text-white-50 small">İletişim E-postası</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="contact.Email" />
                                    </div>
                                    <div class="col-6 col-md-2 d-flex align-items-end">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@(contact.IsActiveEmail ?? false)" @onchange="e => contact.IsActiveEmail = Cb(e)" />
                                            <label class="form-check-label text-white-50">Aktif</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-2 d-flex align-items-end">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@contact.PhoneEmailConfirmed" @onchange="e => contact.PhoneEmailConfirmed = Cb(e)" />
                                            <label class="form-check-label text-white-50">Onaylı</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label text-white-50 small">Ülke Kodu</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="contact.CountryPhoneCode" placeholder="+90" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label text-white-50 small">Telefon</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="contact.PhoneNumber" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label text-white-50 small">Tam Telefon</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="contact.FullPhoneNumber" />
                                    </div>
                                    <div class="col-6 col-md-3 d-flex align-items-end gap-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@(contact.IsActivePhoneNumber ?? false)" @onchange="e => contact.IsActivePhoneNumber = Cb(e)" />
                                            <label class="form-check-label text-white-50">Aktif</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label text-white-50 small">Web Sitesi</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="contact.UserWebSite" />
                                    </div>
                                </div>
                            }
                        </div>

                        @* ═══ SOSYAL MEDYA ═══ *@
                        <div class="tab-pane fade" id="tab-social">
                            @{
                                var sc = _editProfile?.ContactInformation;
                            }
                            @if (sc != null)
                            {
                                <p class="text-white-50 small mb-2">Soldaki anahtar aktiflik, kutu ise hesap bilgisini belirtir.</p>
                                <div class="row g-2">
                                    @foreach (var f in SocialFields(sc))
                                    {
                                        <div class="col-12 col-md-6">
                                            <label class="form-label text-white-50 small mb-1">@f.Label</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-dark border-secondary">
                                                    <input type="checkbox" checked="@(f.GetActive() ?? false)" @onchange="e => f.SetActive(Cb(e))" />
                                                </span>
                                                <input class="form-control bg-dark text-white border-secondary"
                                                       value="@f.GetValue()" @oninput="e => f.SetValue(e.Value?.ToString())" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @* ═══ GİZLİLİK (UserPrivacySettings) ═══ *@
                        <div class="tab-pane fade" id="tab-privacy">
                            @if (_editPrivacy != null)
                            {
                                <div class="row g-2">
                                    @foreach (var f in PrivacyFields(_editPrivacy))
                                    {
                                        <div class="col-12 col-sm-6 col-md-4">
                                            <label class="form-label text-white-50 small mb-1">@f.Label</label>
                                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                                    value="@((byte)f.Get())" @onchange="e => f.Set(Enum.Parse<PrivacyAudience>(e.Value?.ToString() ??" 1"))">
                                                @foreach (var pa in Enum.GetValues<PrivacyAudience>())
                                                {
                                                    <option value="@pa">@pa</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                    <div class="col-12"><hr class="border-secondary my-1" /></div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@_editPrivacy.ShowLastSeen" @onchange="e => _editPrivacy.ShowLastSeen = Cb(e)" />
                                            <label class="form-check-label text-white-50 small">Son görülme</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" checked="@_editPrivacy.ShowOnlineStatus" @onchange="e => _editPrivacy.ShowOnlineStatus = Cb(e)" />
                                            <label class="form-check-label text-white-50 small">Çevrimiçi durumu</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div class="form-check form-switch">
