    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleDataChanged;
        await LoadPageAsync(1);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;
        await InvokeAsync(async () =>
        {
            StateHub.ClearCache(USER_INDEX_KEY);
            await LoadPageAsync(_currentPage);
            StateHasChanged();
        });
    }

    // ════════════════════════════════════════
    // VERİ YÜKLEME
    // ════════════════════════════════════════

    private async Task LoadPageAsync(int page, bool debounce = false)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        var search = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();

        try
        {
            if (debounce) await Task.Delay(SEARCH_DELAY, token);
            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(token);

            var query = db.Users.AsNoTracking().AsQueryable();

            if (!_includeDeleted)
                query = query.Where(u => u.IsDeleted == null || u.IsDeleted.IsDeletedStatu == null || u.IsDeleted.IsDeletedStatu == false);

            if (search != null)
            {
                var matchedIds = await GetMatchingUserIdsAsync(search, token);
                query = query.Where(u => matchedIds.Contains(u.Id));
            }

            _totalCount = await query.CountAsync(token);
            _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PAGE_SIZE));
            _currentPage = Math.Clamp(page, 1, _totalPages);
            BuildPageWindow();

            var users = await query
                .OrderByDescending(u => u.RegistrationDateUtc)
                .Skip((_currentPage - 1) * PAGE_SIZE)
                .Take(PAGE_SIZE)
                .ToListAsync(token);

            if (token.IsCancellationRequested) return;

            // Profil bilgilerini çek (ad/soyad için)
            var userIds = users.Select(u => u.Id).ToList();
            var profiles = await db.UserProfiles.AsNoTracking()
                .Where(p => userIds.Contains(p.UserId))
                .ToListAsync(token);

            var profileDict = profiles.ToDictionary(p => p.UserId);

            _pagedItems = users.Select(u =>
            {
                var p = profileDict.GetValueOrDefault(u.Id);
                var name = p != null ? $"{p.FirstName} {p.LastName}".Trim() : null;
                return new UserRow
                {
                    User = u,
                    FullName = string.IsNullOrWhiteSpace(name) ? null : name,
                    Email = u.Email
                };
            }).ToList();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadPage", ex);
                await Notify("danger", "Hata", "Kullanıcılar yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested) { _isLoading = false; StateHasChanged(); }
        }
    }

    private async Task<List<Guid>> GetMatchingUserIdsAsync(string search, CancellationToken token)
    {
        var index = await StateHub.GetOrLoadAsync(USER_INDEX_KEY, async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync(token);

            var userData = await db.Users.AsNoTracking()
                .Select(u => new { u.Id, u.Email })
                .ToListAsync(token);

            var profileData = await db.UserProfiles.AsNoTracking()
                .Select(p => new { p.UserId, p.FirstName, p.LastName })
                .ToListAsync(token);

            var profileDict = profileData.ToDictionary(p => p.UserId);

            return userData.Select(u =>
            {
                var p = profileDict.GetValueOrDefault(u.Id);
                var hay = string.Join(" ", p?.FirstName, p?.LastName, u.Email);
                return new UserIndexEntry { Id = u.Id, Haystack = hay };
            }).ToList();
        }, token) ?? new List<UserIndexEntry>();

        return index
            .Where(e => e.Haystack?.Contains(search, StringComparison.OrdinalIgnoreCase) == true)
            .Select(e => e.Id).ToList();
    }

    private void BuildPageWindow()
    {
        int start = Math.Max(1, _currentPage - PAGE_WINDOW / 2);
        int end = Math.Min(_totalPages, start + PAGE_WINDOW - 1);
        start = Math.Max(1, end - PAGE_WINDOW + 1);
        _pageWindow = Enumerable.Range(start, end - start + 1).ToList();
    }

    private async Task GoToPage(int page) => await LoadPageAsync(page);
    private async Task RefreshAsync() { StateHub.ClearCache(USER_INDEX_KEY); await LoadPageAsync(_currentPage); }
    private async Task ToggleIncludeDeleted(ChangeEventArgs e) { _includeDeleted = Cb(e); await LoadPageAsync(1); }
    private async Task OnSearchInput(ChangeEventArgs e) { _searchTerm = e.Value?.ToString() ?? ""; await LoadPageAsync(1, debounce: true); }
    private async Task ClearSearch() { _searchTerm = ""; await LoadPageAsync(1); }

