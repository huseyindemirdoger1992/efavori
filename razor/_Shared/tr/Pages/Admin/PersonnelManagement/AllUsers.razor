    // ══════════════════════════════════════════════════════════════
    // MODAL AÇMA
    // ══════════════════════════════════════════════════════════════

    private async Task OpenEditModal(Guid id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var u = await db.Users.AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == id, _cts.Token);

            if (u == null)
            {
                await Notify("warning", "Uyarı", "Kullanıcı bulunamadı.");
                return;
            }

            // Şifreli alanları çöz, owned tabloları null ise oluştur
            u.FirstName = Decrypt(u.FirstName);
            u.LastName = Decrypt(u.LastName);
            u.UserSponsorEmail = Decrypt(u.UserSponsorEmail);
            u.Language = Decrypt(u.Language);
            u.Currency = Decrypt(u.Currency);
            u.UsersType = Decrypt(u.UsersType);
            u.BackgroundImagePath = Decrypt(u.BackgroundImagePath);

            u.ContactInformation ??= new ContactInformation();
            u.IsPrivateOrPublic ??= new IsPrivateOrPublic();
            u.ProfileCoverGallery ??= new ProfileCoverGallery();
            u.UserRolesAccessPermissions ??= new UserRolesAccessPermissions();
            u.IsDeleted ??= new IsDeleted { IsDeletedStatu = false };

            _editModel = u;
            await ShowModal("EditModal");
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "OpenEdit");
        }
        catch (Exception ex)
        {
            await LogError("OpenEditModal", ex);
            await Notify("danger", "Hata", "Kullanıcı açılırken sorun oluştu.");
        }
    }

    private async Task OpenDeleteModal(UserRow row, bool restore)
    {
        _deleteTarget = row;
        _restoreMode = restore;
        await ShowModal("DeleteModal");
    }

    // ══════════════════════════════════════════════════════════════
    // KAYDET — tüm ayarları yeniden şifreleyerek
    // ══════════════════════════════════════════════════════════════

    private async Task SaveAsync()
    {
        if (_isProcessing || _editModel == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.Users.FindAsync(new object[] { _editModel.Id }, _cts.Token);

            if (existing == null)
            {
                await Notify("warning", "Uyarı", "Kullanıcı artık mevcut değil.");
                return;
            }

            var m = _editModel;

            // ── Şifreli skaler alanlar (Password'e DOKUNULMAZ) ──
            existing.FirstName = Enc(m.FirstName);
            existing.LastName = Enc(m.LastName);
            existing.UserSponsorEmail = Enc(m.UserSponsorEmail);
            existing.Language = Enc(m.Language);
            existing.Currency = Enc(m.Currency);
            existing.UsersType = Enc(m.UsersType);
            existing.BackgroundImagePath = Enc(m.BackgroundImagePath);

            // ── Düz metin / değer alanları ──
            existing.WorkstationEmployeeGroupId = m.WorkstationEmployeeGroupId;
            existing.UserIsEmployee = m.UserIsEmployee;
            existing.DateOfBirth = m.DateOfBirth;
            existing.RegistrationDate = m.RegistrationDate;
            existing.AccountActivationMailStatu = m.AccountActivationMailStatu;
            existing.AccountActivationMailCode = m.AccountActivationMailCode;
            existing.AccountPasswordResetMailCode = m.AccountPasswordResetMailCode;
            existing.AccountActivationMailDeadline = m.AccountActivationMailDeadline;
            existing.IsActive = m.IsActive;
            existing.IsActiveVendorStatu = m.IsActiveVendorStatu;
            existing.TermsOfUse = m.TermsOfUse;

            // ── Owned tablolar (düz metin) — tüm değerleri ata ──
            existing.ContactInformation = m.ContactInformation;
            existing.IsPrivateOrPublic = m.IsPrivateOrPublic;
            existing.ProfileCoverGallery = m.ProfileCoverGallery;
            existing.UserRolesAccessPermissions = m.UserRolesAccessPermissions;
            // IsDeleted durumunu bu modalda değiştirmiyoruz (silme ayrı akış)

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("EditModal");
            _editModel = null;
            _isProcessing = false;

            StateHub.ClearCache(USER_INDEX_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Update");
            await Notify("success", "Başarılı", "Tüm ayarlar kaydedildi.");
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("SaveAsync", ex);
            await Notify("danger", "Hata", "Kaydetme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // SİL / GERİ AL (soft delete)
    // ══════════════════════════════════════════════════════════════

    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.Users.FindAsync(new object[] { _deleteTarget.User.Id }, _cts.Token);

            if (existing != null)
            {
                existing.IsDeleted = new IsDeleted
                {
                    IsDeletedStatu = !_restoreMode,
                    DeletedAtDate = _restoreMode ? null : DateTime.UtcNow
                };
                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("DeleteModal");
            _deleteTarget = null;
            _isProcessing = false;

            StateHub.ClearCache(USER_INDEX_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, _restoreMode ? "Restore" : "SoftDelete");
            await Notify("success", _restoreMode ? "Geri Alındı" : "Silindi",
                _restoreMode ? "Kullanıcı geri alındı." : "Kullanıcı silindi olarak işaretlendi.");
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("DeleteConfirmed", ex);
            await Notify("danger", "Hata", "İşlem sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI
    // ══════════════════════════════════════════════════════════════

    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://picsum.photos/120");
    }

    private async Task LogError(string action, Exception ex)
    {
        try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); }
        catch { }
    }
}
