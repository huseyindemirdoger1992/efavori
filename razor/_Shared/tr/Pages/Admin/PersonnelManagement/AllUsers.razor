@* ═══ MODAL — Sil / Geri Al ═══ *@
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border @(_restoreMode ? "border-success" : "border-danger")">
            <div class="modal-header border-bottom @(_restoreMode ? "border-success" : "border-danger") py-2">
                <h6 class="modal-title @(_restoreMode ? "text-success" : "text-danger") mb-0">
                    <i class="fa @(_restoreMode ? "fa-undo" : "fa-trash-o") me-2"></i>@(_restoreMode ? "Geri Alma" : "Silme") İşlemi
                </h6>
                <button type="button" class="btn btn-sm text-danger border-0" data-bs-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>
            <div class="modal-body text-light">
                @if (_deleteTarget != null)
                {
                    <p class="mb-1">
                        <strong>@(_deleteTarget.FullName ?? _deleteTarget.Email ?? _deleteTarget.User.Id.ToString())</strong>
