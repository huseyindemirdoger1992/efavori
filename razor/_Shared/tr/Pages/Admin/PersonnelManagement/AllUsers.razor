                    </p>
                    <p class="small text-light mb-0">Bu işlem veritabanından kalıcı silme yapmaz.</p>
                }
            </div>
            <div class="modal-footer border-top @(_restoreMode ? "border-success" : "border-danger") py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn @(_restoreMode ? "btn-success" : "btn-danger") btn-sm" @onclick="DeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>İşleniyor...</span>
                    }
                    else
                    {

                        <i class="fa @(_restoreMode ? "fa-undo" : "fa-trash") me-1"></i><span>@(_restoreMode ? "Geri Al" : "Sil")</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

