    // ════════════════════════════════════════
    // KAYDET — 4 ayrı tablo güncellenir
    // ════════════════════════════════════════

    private async Task SaveAsync()
    {
        if (_isProcessing || _editUser == null || _editProfile == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Users güncelle
            var existingUser = await db.Users.FindAsync(new object[] { _editUser.Id }, _cts.Token);
            if (existingUser == null) { await Notify("warning", "Uyarı", "Kullanıcı artık mevcut değil."); return; }

            existingUser.AccountStatus = _editUser.AccountStatus;
            existingUser.UserType = _editUser.UserType;
            existingUser.VendorCapability = _editUser.VendorCapability;
            existingUser.Email = _editUser.Email;
            existingUser.NormalizedEmail = _editUser.Email.Trim().ToUpperInvariant();
            existingUser.IsEmployee = _editUser.IsEmployee;

            // UserProfiles güncelle
            var existingProfile = await db.UserProfiles.FirstOrDefaultAsync(x => x.UserId == _editUser.Id, _cts.Token);
            if (existingProfile != null)
            {
                existingProfile.FirstName = _editProfile.FirstName;
                existingProfile.LastName = _editProfile.LastName;
                existingProfile.Username = _editProfile.Username;
                existingProfile.NormalizedUsername = (_editProfile.Username ?? "").Trim().ToLowerInvariant();
                existingProfile.DisplayName = _editProfile.DisplayName;
                existingProfile.Bio = _editProfile.Bio;
                existingProfile.ProfileVisibility = _editProfile.ProfileVisibility;
                existingProfile.ContactInformation = _editProfile.ContactInformation ?? new ContactInformation();
            }

            // UserSettings güncelle
            if (_editSettings != null)
            {
                var existingSettings = await db.UserSettings.FirstOrDefaultAsync(x => x.UserId == _editUser.Id, _cts.Token);
                if (existingSettings != null)
                {
                    existingSettings.Language = _editSettings.Language;
                    existingSettings.Currency = _editSettings.Currency;
                    existingSettings.TimeZoneId = _editSettings.TimeZoneId;
                    existingSettings.EmailNotificationsEnabled = _editSettings.EmailNotificationsEnabled;
                    existingSettings.PushNotificationsEnabled = _editSettings.PushNotificationsEnabled;
                    existingSettings.SmsNotificationsEnabled = _editSettings.SmsNotificationsEnabled;
                    existingSettings.PersonalizedAdsEnabled = _editSettings.PersonalizedAdsEnabled;
                }
            }

            // UserPrivacySettings güncelle
            if (_editPrivacy != null)
            {
                var existingPrivacy = await db.UserPrivacySettings.FirstOrDefaultAsync(x => x.UserId == _editUser.Id, _cts.Token);
                if (existingPrivacy != null)
                {
                    existingPrivacy.WhoCanMessage = _editPrivacy.WhoCanMessage;
                    existingPrivacy.WhoCanSendFriendRequest = _editPrivacy.WhoCanSendFriendRequest;
                    existingPrivacy.WhoCanFollow = _editPrivacy.WhoCanFollow;
                    existingPrivacy.WhoCanVoiceCall = _editPrivacy.WhoCanVoiceCall;
                    existingPrivacy.WhoCanVideoCall = _editPrivacy.WhoCanVideoCall;
                    existingPrivacy.WhoCanComment = _editPrivacy.WhoCanComment;
                    existingPrivacy.WhoCanTag = _editPrivacy.WhoCanTag;
                    existingPrivacy.WhoCanMention = _editPrivacy.WhoCanMention;
                    existingPrivacy.WhoCanShareMyPosts = _editPrivacy.WhoCanShareMyPosts;
                    existingPrivacy.WhoCanSeeFollowerList = _editPrivacy.WhoCanSeeFollowerList;
                    existingPrivacy.WhoCanSeeFollowingList = _editPrivacy.WhoCanSeeFollowingList;
                    existingPrivacy.WhoCanSeeFriendList = _editPrivacy.WhoCanSeeFriendList;
                    existingPrivacy.WhoCanSeeBirthDate = _editPrivacy.WhoCanSeeBirthDate;
                    existingPrivacy.WhoCanSeeEmail = _editPrivacy.WhoCanSeeEmail;
                    existingPrivacy.WhoCanSeePhone = _editPrivacy.WhoCanSeePhone;
                    existingPrivacy.WhoCanSeeLocation = _editPrivacy.WhoCanSeeLocation;
                    existingPrivacy.ShowLastSeen = _editPrivacy.ShowLastSeen;
                    existingPrivacy.ShowOnlineStatus = _editPrivacy.ShowOnlineStatus;
                    existingPrivacy.SendReadReceipts = _editPrivacy.SendReadReceipts;
                    existingPrivacy.ShowFollowerCount = _editPrivacy.ShowFollowerCount;
                    existingPrivacy.AllowContentDownload = _editPrivacy.AllowContentDownload;
                }
            }

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("EditModal");
            _editUser = null; _editProfile = null; _editSettings = null; _editPrivacy = null;
            _isProcessing = false;

            StateHub.ClearCache(USER_INDEX_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Update");
            await Notify("success", "Başarılı", "Tüm ayarlar kaydedildi.");
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("SaveAsync", ex);
            await Notify("danger", "Hata", "Kaydetme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ════════════════════════════════════════
    // SİL / GERİ AL
    // ════════════════════════════════════════

    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.Users.FindAsync(new object[] { _deleteTarget.User.Id }, _cts.Token);

            if (existing != null)
            {
                existing.IsDeleted = new IsDeleted
                {
                    IsDeletedStatu = !_restoreMode,
                    DeletedAtDate = _restoreMode ? null : DateTime.UtcNow
                };

                if (_restoreMode)
                    existing.AccountStatus = UserAccountStatus.Active;
                else
                    existing.AccountStatus = UserAccountStatus.PendingDeletion;

                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("DeleteModal");
            _deleteTarget = null;
            _isProcessing = false;

            StateHub.ClearCache(USER_INDEX_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, _restoreMode ? "Restore" : "SoftDelete");
            await Notify("success", _restoreMode ? "Geri Alındı" : "Silindi",
                _restoreMode ? "Kullanıcı geri alındı." : "Kullanıcı silindi olarak işaretlendi.");
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("DeleteConfirmed", ex);
            await Notify("danger", "Hata", "İşlem sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ════════════════════════════════════════
    // YARDIMCI
    // ════════════════════════════════════════

    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval", $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval", $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://picsum.photos/120");
    }

    private async Task LogError(string action, Exception ex)
    {
        try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); } catch { }
    }
}
