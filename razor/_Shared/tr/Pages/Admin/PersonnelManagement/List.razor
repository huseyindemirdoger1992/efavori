@using data

<div class="col-12">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="example2" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Adı</th>
                            <th>Soyadı</th>
                            <th>Tür</th>
                            <th>Kayıt Tarihi</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Users == null)
                        {
                            <p>Yükleniyor...</p>
                        }
                        else
                        {
                            @foreach (Users user in Users) 
                            {
                                <tr>
                                    <td>@user.FirstName</td>
                                    <td>@user.LastName</td>
                                    <td>@user.UsersType</td>
                                    <td>@user.RegistrationDate</td>
                                    <td>

                                        <button class="btn btn-secondary btn-sm" data-bs-toggle="modal"
                                                data-bs-target="#Edit_@user.Id">
                                            <i class="fa fa-plus"></i> Yeni Görev
                                        </button>

                                        <div class="modal fade" id="Edit_@user.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                                                    <div class="modal-header border-bottom border-secondary">
                                                        <h5 class="modal-title text-white">
                                                            <i class="fa fa-sign-in"></i> Oturum Aç
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">


                                                        <div class="col-md-12 mb-12">
                                                            <label class="form-label">Kullanıcı Tipi</label>
                                                            <select class="form-select" @bind="UsersType">
                                                                <option value="">...</option>
                                                                <option value="SuperAdmin">SuperAdmin</option>
                                                                <option value="Admin">Admin</option>
                                                                <option value="Employee">Employee</option>
                                                                <option value="Vendor">Vendor</option>
                                                                <option value="Customer">Customer</option>
                                                            </select>
                                                        </div>


                                                    </div>
                                                    <div class="modal-footer border-top border-secondary">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>

                                                        <button type="button"
                                                                class="@(_isProcessing ? "btn btn-primary colored" : "btn btn-primary")"
                                                                style="width:150px;"
                                                                @onclick="async () => await UpdateUser(user)"
                                                                disabled="@_isProcessing">
                                                            <i class="fa @(_isProcessing ? "fa-refresh fa-spin" : "fa-save")"></i>
                                                            <span>@(_isProcessing ? "Kaydediliyor..." : "Kaydet")</span>
                                                        </button>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
