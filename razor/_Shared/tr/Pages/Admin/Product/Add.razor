                <button class="nav-link text-start d-flex align-items-center gap-2 mb-2 border" data-bs-toggle="pill" data-bs-target="#s5" type="button"><span class="badge rounded-pill bg-light text-dark">5</span><span><span class="d-block fw-semibold">Stok &amp; Kargo</span><small class="opacity-75">Depo, desi</small></span></button>
                <button class="nav-link text-start d-flex align-items-center gap-2 mb-2 border" data-bs-toggle="pill" data-bs-target="#s6" type="button"><span class="badge rounded-pill bg-light text-dark">6</span><span><span class="d-block fw-semibold">Medya</span><small class="opacity-75">Görsel, video, dosya</small></span></button>
                <button class="nav-link text-start d-flex align-items-center gap-2 mb-2 border" data-bs-toggle="pill" data-bs-target="#s7" type="button"><span class="badge rounded-pill bg-light text-dark">7</span><span><span class="d-block fw-semibold">SEO &amp; Pazaryeri</span><small class="opacity-75">Önizleme, kanal, onay</small></span></button>
            </div>
        </div>

