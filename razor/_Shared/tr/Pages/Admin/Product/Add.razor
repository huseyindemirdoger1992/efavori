    // ══════════════════════════════════════════════════════════════

    private void OnCategorySearch(ChangeEventArgs e)
    {
        _categorySearchTerm = e.Value?.ToString() ?? "";
        if (_categorySearchTerm.Length < 2)
        {
            _categorySearchResults.Clear();
            return;
        }

        var term = _categorySearchTerm.Trim();
        _categorySearchResults = _allCategories
            .Where(c => c.Name != null && c.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.DepartmentName).ThenBy(c => c.Name)
            .Take(30).ToList();
    }

    private void ToggleCategory(CategoriesTr cat)
    {
        if (_selectedCategoryIds.Contains(cat.Id))
        {
            _selectedCategoryIds.Remove(cat.Id);
            if (_primaryCategoryId == cat.Id)
                _primaryCategoryId = _selectedCategoryIds.FirstOrDefault();
        }
        else
        {
            _selectedCategoryIds.Add(cat.Id);
            if (_primaryCategoryId == 0) _primaryCategoryId = cat.Id;
        }
    }

    // ══════════════════════════════════════════════════════════════
    // ÖZELLİK (ATTRIBUTE) YÖNETİMİ
    // ══════════════════════════════════════════════════════════════

    private void AddSelectedAttribute()
    {
        if (_selectedAttributeToAdd == Guid.Empty) return;
        var attr = _availableAttributes.FirstOrDefault(a => a.Id == _selectedAttributeToAdd);
        if (attr == null || _selectedAttributes.Any(a => a.Id == attr.Id)) return;

        _selectedAttributes.Add(attr);
        _selectedValueIds.TryAdd(attr.Id, new HashSet<Guid>());
        _newValueInputs.TryAdd(attr.Id, "");
        _selectedAttributeToAdd = Guid.Empty;

        // Değerleri yükle
        _ = LoadAttributeValuesAsync(attr.Id);
    }

    private async Task LoadAttributeValuesAsync(Guid attributeId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var values = await db.ProductAttributeValues.AsNoTracking()
                .Where(v => v.AttributeId == attributeId
                         && (v.UserId == null || v.UserId == use!.Id)
                         && (v.IsDeleted == null || v.IsDeleted.IsDeletedStatu == null || v.IsDeleted.IsDeletedStatu == false))
                .OrderBy(v => v.SortOrder).ThenBy(v => v.Value)
                .ToListAsync(_cts.Token);

            _attributeValuesMap[attributeId] = values;
            StateHasChanged();
        }
        catch (Exception ex) { await LogError("LoadAttrValues", ex); }
    }

    private void RemoveAttribute(Guid attrId)
    {
        _selectedAttributes.RemoveAll(a => a.Id == attrId);
        _selectedValueIds.Remove(attrId);
        _attributeValuesMap.Remove(attrId);
        _newValueInputs.Remove(attrId);
        _variants.Clear();
    }

    private void ToggleAttributeValue(Guid attrId, Guid valueId)
    {
        if (!_selectedValueIds.ContainsKey(attrId)) _selectedValueIds[attrId] = new();
        if (!_selectedValueIds[attrId].Remove(valueId))
            _selectedValueIds[attrId].Add(valueId);
    }

    private async Task CreateNewAttribute()
    {
        if (string.IsNullOrWhiteSpace(_newAttributeName)) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            var attr = new ProductAttributes
            {
                UserId = use!.Id,
                Name = _newAttributeName.Trim(),
                AttributeType = _newAttributeType,
                IsDeleted = new IsDeleted { IsDeletedStatu = false }
            };

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.ProductAttributes.Add(attr);
            await db.SaveChangesAsync(_cts.Token);

            _availableAttributes.Add(attr);
            _selectedAttributes.Add(attr);
            _selectedValueIds.TryAdd(attr.Id, new HashSet<Guid>());
            _attributeValuesMap.TryAdd(attr.Id, new List<ProductAttributeValues>());
            _newValueInputs.TryAdd(attr.Id, "");

            _newAttributeName = string.Empty;
            StateHub.ClearCache($"ProductAttributes_{use.Id}");

            await Notify("success", "Başarılı", $"'{attr.Name}' özelliği oluşturuldu.");
        }
        catch (Exception ex) { await LogError("CreateAttribute", ex); await Notify("danger", "Hata", "Özellik oluşturulamadı."); }
        finally { _writeLock.Release(); }
    }

    private async Task AddNewValueAsync(Guid attrId)
    {
        if (!_newValueInputs.ContainsKey(attrId) || string.IsNullOrWhiteSpace(_newValueInputs[attrId])) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            var attr = _selectedAttributes.FirstOrDefault(a => a.Id == attrId);
            var val = new ProductAttributeValues
            {
                AttributeId = attrId,
                UserId = use!.Id,
                Value = _newValueInputs[attrId].Trim(),
                ColorCode = attr?.AttributeType == "Color" ? _newColorCode : null,
                IsDeleted = new IsDeleted { IsDeletedStatu = false }
            };

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.ProductAttributeValues.Add(val);
            await db.SaveChangesAsync(_cts.Token);

            if (!_attributeValuesMap.ContainsKey(attrId)) _attributeValuesMap[attrId] = new();
            _attributeValuesMap[attrId].Add(val);
            _selectedValueIds[attrId].Add(val.Id);
            _newValueInputs[attrId] = "";
        }
        catch (Exception ex) { await LogError("AddAttrValue", ex); }
        finally { _writeLock.Release(); }
    }

    // ══════════════════════════════════════════════════════════════
    // VARYANT ÜRETİMİ (Kartezyen Çarpım)
    // ══════════════════════════════════════════════════════════════

    private void GenerateVariants()
    {
        _variants.Clear();

        var attrGroups = _selectedAttributes
            .Where(a => _selectedValueIds.ContainsKey(a.Id) && _selectedValueIds[a.Id].Any())
            .Select(a => new
            {
                AttrId = a.Id,
                ValueIds = _selectedValueIds[a.Id].ToList()
            }).ToList();

        if (!attrGroups.Any()) return;

        // Kartezyen çarpım
        var combos = new List<Dictionary<Guid, Guid>>();
        combos.Add(new Dictionary<Guid, Guid>());

        foreach (var group in attrGroups)
        {
            var newCombos = new List<Dictionary<Guid, Guid>>();
            foreach (var existing in combos)
            {
                foreach (var valId in group.ValueIds)
                {
                    var combo = new Dictionary<Guid, Guid>(existing) { [group.AttrId] = valId };
                    newCombos.Add(combo);
                }
            }
            combos = newCombos;
        }

        foreach (var combo in combos)
        {
            var displayParts = new List<string>();
            foreach (var kv in combo)
            {
                var valObj = _attributeValuesMap.ContainsKey(kv.Key)
                    ? _attributeValuesMap[kv.Key].FirstOrDefault(x => x.Id == kv.Value) : null;
                displayParts.Add(valObj?.Value ?? "?");
            }

            _variants.Add(new VariantVM
            {
                AttributeValueMap = combo,
                DisplayName = string.Join(" / ", displayParts)
            });
        }
    }

    private void ToggleAllVariants(ChangeEventArgs e)
    {
        var val = e.Value is bool b ? b : false;
        foreach (var v in _variants) v.IsActive = val;
    }

