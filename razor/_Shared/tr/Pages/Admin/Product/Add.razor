    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    private async Task LoadUserStoresAsync()
    {
        try
        {
            _userStores = await StateHub.GetOrLoadAsync($"AddProduct_Stores_{use?.Id}", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.Stores.AsNoTracking()
                    .Where(s => s.UserId == use!.Id
                             && s.IsActiveStateAdmin == true
                             && (s.IsDeleted == null || s.IsDeleted.IsDeletedStatu == null || s.IsDeleted.IsDeletedStatu == false))
                    .OrderBy(s => s.Name).ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadUserStores", ex); }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            _allCategories = await StateHub.GetOrLoadAsync("Categories_All", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.CategoriesTr.AsNoTracking().ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadCategories", ex); }
    }

    private async Task LoadAttributesAsync()
    {
        try
        {
            _availableAttributes = await StateHub.GetOrLoadAsync($"ProductAttributes_{use?.Id}", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.ProductAttributes.AsNoTracking()
                    .Where(a => (a.UserId == null || a.UserId == use!.Id)
                             && (a.IsDeleted == null || a.IsDeleted.IsDeletedStatu == null || a.IsDeleted.IsDeletedStatu == false))
                    .OrderBy(a => a.SortOrder).ThenBy(a => a.Name)
                    .ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadAttributes", ex); }
    }

    private async Task LoadWarehousesAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _userWarehouses = await db.Warehouse.AsNoTracking()
                .Where(w => w.UserId == use!.Id && w.IsActive
                         && (w.IsDeleted == null || w.IsDeleted.IsDeletedStatu == null || w.IsDeleted.IsDeletedStatu == false))
                .OrderByDescending(w => w.IsDefault).ThenBy(w => w.CreatedAt)
                .ToListAsync(_cts.Token);
        }
        catch (Exception ex) { await LogError("LoadWarehouses", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // ADIM NAVİGASYONU
    // ══════════════════════════════════════════════════════════════

    private void GoToStep(int step) { if (step <= _currentStep) _currentStep = step; }
    private void PrevStep() { if (_currentStep > 0) _currentStep--; }

    private async Task NextStep()
    {
        // Adım validasyonu
        if (_currentStep == 0)
        {
            if (_selectedStoreId == Guid.Empty) { await Notify("warning", "Uyarı", "Lütfen bir mağaza seçiniz."); return; }
            if (!_selectedCategoryIds.Any()) { await Notify("warning", "Uyarı", "Lütfen en az bir kategori seçiniz."); return; }
        }
        else if (_currentStep == 1)
        {
            if (string.IsNullOrWhiteSpace(_product.Name)) { await Notify("warning", "Uyarı", "Ürün adı boş bırakılamaz."); return; }
        }
        else if (_currentStep == 2 && _product.ProductType == "Variable")
        {
            if (!_variants.Any(v => v.IsActive)) { await Notify("warning", "Uyarı", "Lütfen en az bir aktif varyant oluşturunuz."); return; }
        }

        if (_currentStep < _steps.Length - 1) _currentStep++;
    }

