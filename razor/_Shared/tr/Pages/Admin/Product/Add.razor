                    <div class="col-md-4"><label class="form-label">Kaynak Tipi</label><select class="form-select"><option>CSV</option><option>XML</option><option>JSON</option><option>RestApi</option><option>SoapApi</option><option>Amazon</option><option>Alibaba</option><option>Ebay</option><option>MercadoLibre</option><option>Jd</option><option>Trendyol</option><option>Hepsiburada</option><option>N11</option><option>CicekSepeti</option><option>Etsy</option><option>Shopify</option><option>WooCommerce</option></select></div>
                    <div class="col-md-2"><label class="form-label">Ayraç</label><input class="form-control" value=";"></div>
                    <div class="col-md-2"><label class="form-label">Karakter Seti</label><input class="form-control" value="UTF-8"></div>
                    <div class="col-md-6"><label class="form-label">Kaynak URL <small class="text-muted">(API/feed)</small></label><input type="url" class="form-control" placeholder="https://…"></div>
