                                        <div class="card-body">
                                            <select class="form-select"><option selected>Marka seçin…</option><option>Samsung</option><option>LG</option><option>Sony</option></select>
                                            <div class="collapse mt-3" id="newBrand">
                                                <div class="row g-2">
                                                    <div class="col-6"><label class="form-label small">Marka Adı</label><input class="form-control form-control-sm" placeholder="Samsung"></div>
                                                    <div class="col-6"><label class="form-label small">Slug</label><input class="form-control form-control-sm" placeholder="samsung"></div>
                                                    <div class="col-12"><label class="form-label small">Web Sitesi</label><input class="form-control form-control-sm" placeholder="https://…"></div>
                                                    <div class="col-12"><label class="form-label small">Açıklama</label><input class="form-control form-control-sm" placeholder="Marka açıklaması"></div>
