    // FİYAT & STOK YARDIMCI
    // ══════════════════════════════════════════════════════════════

    private void EnsureVariantPrice(Guid tempId)
    {
        _variantPrices.TryAdd(tempId, new PriceVM());
    }

    private void EnsureStockEntry(Guid itemId, Guid warehouseId)
    {
        _stockEntries.TryAdd((itemId, warehouseId), new StockVM());
    }

    private void ApplyBulkPrices()
    {
        foreach (var v in _variants.Where(x => x.IsActive))
        {
            EnsureVariantPrice(v.TempId);
            if (_bulkPrice.HasValue) _variantPrices[v.TempId].Price = _bulkPrice;
            if (_bulkComparePrice.HasValue) _variantPrices[v.TempId].CompareAtPrice = _bulkComparePrice;
            if (_bulkCostPrice.HasValue) _variantPrices[v.TempId].CostPrice = _bulkCostPrice;
        }
    }

    private void ApplyBulkStock()
    {
        foreach (var v in _variants.Where(x => x.IsActive))
        {
            foreach (var wh in _userWarehouses)
            {
                EnsureStockEntry(v.TempId, wh.Id);
                _stockEntries[(v.TempId, wh.Id)].Quantity = _bulkStockQty;
            }
        }
    }

