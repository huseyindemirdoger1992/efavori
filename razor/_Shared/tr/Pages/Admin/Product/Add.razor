                                <div class="col-6 col-md-2"><input type="radio" class="btn-check" name="ptype" id="ptVariant"><label class="btn btn-outline-primary w-100 py-2" for="ptVariant"><i class="fa fa-sliders d-block mb-1"></i>Varyantlı</label></div>
                                <div class="col-6 col-md-2"><input type="radio" class="btn-check" name="ptype" id="ptDigital"><label class="btn btn-outline-primary w-100 py-2" for="ptDigital"><i class="fa fa-download d-block mb-1"></i>Dijital</label></div>
                                <div class="col-6 col-md-2"><input type="radio" class="btn-check" name="ptype" id="ptService"><label class="btn btn-outline-primary w-100 py-2" for="ptService"><i class="fa fa-cog d-block mb-1"></i>Hizmet</label></div>
                                <div class="col-6 col-md-2"><input type="radio" class="btn-check" name="ptype" id="ptBundle"><label class="btn btn-outline-primary w-100 py-2" for="ptBundle"><i class="fa fa-gift d-block mb-1"></i>Paket</label></div>
