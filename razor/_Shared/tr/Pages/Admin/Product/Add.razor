                                <div class="col-md-4"><label class="form-label fw-semibold">Stok Kodu (SKU)</label><div class="input-group input-group-lg"><span class="input-group-text"><i class="fa fa-barcode"></i></span><input type="text" class="form-control" placeholder="SMS-OLED-55"></div></div>
