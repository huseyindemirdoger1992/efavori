                        <div><span class="me-3 small text-muted"><i class="fa fa-clock-o me-1"></i>Son çalıştırma: —</span><button class="btn btn-primary btn-sm"><i class="fa fa-bolt me-1"></i>Dosya Seç &amp; İçe Aktar</button></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- ===================== SOL ADIM RAYI (7 pills) ===================== -->
        <div class="col-lg-3">
            <div class="nav flex-column nav-pills position-sticky top-0" role="tablist" aria-orientation="vertical">
                <button class="nav-link active text-start d-flex align-items-center gap-2 mb-2 border" data-bs-toggle="pill" data-bs-target="#s1" type="button"><span class="badge rounded-pill bg-light text-dark">1</span><span><span class="d-block fw-semibold">Temel Bilgiler</span><small class="opacity-75">Tip, kategori, marka</small></span></button>
                <button class="nav-link text-start d-flex align-items-center gap-2 mb-2 border" data-bs-toggle="pill" data-bs-target="#s2" type="button"><span class="badge rounded-pill bg-light text-dark">2</span><span><span class="d-block fw-semibold">Açıklama &amp; Özellikler</span><small class="opacity-75">İçerik, spesifikasyon</small></span></button>
