    private void GenerateSlug()
    {
        if (string.IsNullOrWhiteSpace(_product.Name)) return;
        _seoSlug = _product.Name.Trim().ToLowerInvariant()
            .Replace("ş", "s").Replace("ı", "i").Replace("ğ", "g").Replace("ü", "u").Replace("ö", "o").Replace("ç", "c")
            .Replace("Ş", "s").Replace("İ", "i").Replace("Ğ", "g").Replace("Ü", "u").Replace("Ö", "o").Replace("Ç", "c")
            .Replace(" ", "-").Replace("--", "-");

        // Alfanumerik ve tire dışındakileri kaldır
        _seoSlug = new string(_seoSlug.Where(c => char.IsLetterOrDigit(c) || c == '-').ToArray());

        if (string.IsNullOrWhiteSpace(_seoMetaTitle))
            _seoMetaTitle = _product.Name;
    }

    private void AddSpecRow() => _specifications.Add(new SpecVM());

    // ══════════════════════════════════════════════════════════════
    // KAYDET — Tek Transaction
    // ══════════════════════════════════════════════════════════════

    private async Task SaveProductAsync()
    {
        if (_isProcessing) return;

        // ── Son validasyon ──
        var errors = new List<string>();
        if (_selectedStoreId == Guid.Empty) errors.Add("Mağaza seçilmedi.");
        if (!_selectedCategoryIds.Any()) errors.Add("Kategori seçilmedi.");
        if (string.IsNullOrWhiteSpace(_product.Name)) errors.Add("Ürün adı boş bırakılamaz.");
        if (_product.ProductType == "Standard" && (_stdPrice == null || _stdPrice <= 0)) errors.Add("Satış fiyatı girilmedi.");
        if (_product.ProductType == "Variable" && !_variants.Any(v => v.IsActive)) errors.Add("En az bir aktif varyant gereklidir.");

        if (errors.Any())
        {
            await Notify("danger", "Eksik Bilgiler", string.Join(" • ", errors));
            return;
        }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // ──────────────────────────────────────
            // 1. ÜRÜN KAYDI
            // ──────────────────────────────────────
            _product.Id = Guid.NewGuid();
            _product.UserId = use!.Id;
            _product.StoreId = _selectedStoreId;
            _product.Status = "Draft";
            _product.CreatedAt = DateTime.UtcNow;
            _product.IsDeleted = new IsDeleted { IsDeletedStatu = false };

            db.Products.Add(_product);

            // ──────────────────────────────────────
            // 2. KATEGORİ EŞLEŞMELERİ
            // ──────────────────────────────────────
            foreach (var catId in _selectedCategoryIds)
            {
                db.ProductCategoryMappings.Add(new ProductCategoryMappings
                {
                    ProductId = _product.Id,
                    CategoryId = catId,
                    IsPrimary = catId == _primaryCategoryId
                });
            }

            // ──────────────────────────────────────
            // 3. ÖZELLİK EŞLEŞMELERİ
            // ──────────────────────────────────────
            foreach (var attr in _selectedAttributes)
            {
                db.ProductAttributeMappings.Add(new ProductAttributeMappings
                {
                    ProductId = _product.Id,
                    AttributeId = attr.Id,
                    IsVariantAttribute = _product.ProductType == "Variable",
                    IsDeleted = new IsDeleted { IsDeletedStatu = false }
                });
            }

            // ──────────────────────────────────────
            // 4. VARYANTLAR (Variable ürünler)
            // ──────────────────────────────────────
            var variantIdMap = new Dictionary<Guid, Guid>(); // TempId → gerçek Id

            if (_product.ProductType == "Variable")
            {
                foreach (var v in _variants.Where(x => x.IsActive))
                {
                    var variant = new ProductVariants
                    {
                        Id = Guid.NewGuid(),
                        ProductId = _product.Id,
                        UserId = use.Id,
                        SKU = v.SKU,
                        Barcode = v.Barcode,
                        IsActive = true,
                        IsDeleted = new IsDeleted { IsDeletedStatu = false }
                    };

                    variantIdMap[v.TempId] = variant.Id;
                    db.ProductVariants.Add(variant);

                    // Varyant ↔ Attribute değer eşleşmesi
                    foreach (var kv in v.AttributeValueMap)
                    {
                        db.ProductVariantAttributeMappings.Add(new ProductVariantAttributeMappings
                        {
                            VariantId = variant.Id,
                            AttributeId = kv.Key,
                            AttributeValueId = kv.Value
                        });
                    }
                }
            }

            // ──────────────────────────────────────
            // 5. FİYATLAR
            // ──────────────────────────────────────
            // bu alan doldurulacak

            // ──────────────────────────────────────
            // 6. STOKLAR
            // ──────────────────────────────────────
            foreach (var entry in _stockEntries)
            {
                var (itemId, warehouseId) = entry.Key;
                var stock = entry.Value;
                if (stock.Quantity <= 0 && !stock.TrackStock) continue;

                Guid? realVariantId = null;
                if (itemId != Guid.Empty)
                    realVariantId = variantIdMap.GetValueOrDefault(itemId);

                db.ProductStocks.Add(new ProductStocks
                {
                    ProductId = _product.Id,
                    VariantId = itemId == Guid.Empty ? null : realVariantId,
                    WarehouseId = warehouseId,
                    UserId = use.Id,
                    Quantity = stock.Quantity,
                    LowStockThreshold = stock.LowStockThreshold,
                    TrackStock = stock.TrackStock,
                    IsDeleted = new IsDeleted { IsDeletedStatu = false }
                });
            }

            // ──────────────────────────────────────
            // 7. GALERİ (ItemGallery)
            // ──────────────────────────────────────
            // Ürün ana galerisi
            foreach (var media in _productGalleryFiles)
            {
                db.ItemGallery.Add(new ItemGallery
                {
                    UserId = use.Id,
                    ItemId = _product.Id,
                    ItemType = "ProductGallery",
                    MediaId = media.Id,
                    ItemAddDate = DateTime.UtcNow,
                    IsDelete = false
                });
            }

            // Varyant galerileri
            foreach (var kv in _variantGalleryFiles)
            {
                if (!variantIdMap.ContainsKey(kv.Key)) continue;
                var realVarId = variantIdMap[kv.Key];
                foreach (var media in kv.Value)
                {
                    db.ItemGallery.Add(new ItemGallery
                    {
                        UserId = use.Id,
                        ItemId = realVarId,
                        ItemType = "VariantGallery",
                        MediaId = media.Id,
                        ItemAddDate = DateTime.UtcNow,
                        IsDelete = false
                    });
                }
            }

            // ──────────────────────────────────────
            // 8. SEO
            // ──────────────────────────────────────
            if (!string.IsNullOrWhiteSpace(_seoSlug) || !string.IsNullOrWhiteSpace(_seoMetaTitle))
            {
                db.ProductSeo.Add(new ProductSeo
                {
                    ProductId = _product.Id,
                    UserId = use.Id,
                    Slug = _seoSlug,
                    MetaTitle = _seoMetaTitle,
                    MetaDescription = _seoMetaDescription,
                    MetaKeywords = _seoMetaKeywords,
                    IsDeleted = new IsDeleted { IsDeletedStatu = false }
                });
            }

            // ──────────────────────────────────────
            // 9. TEKNİK ÖZELLİKLER
            // ──────────────────────────────────────
            int specOrder = 0;
            foreach (var spec in _specifications.Where(s => !string.IsNullOrWhiteSpace(s.Key)))
            {
                db.ProductSpecifications.Add(new ProductSpecifications
                {
                    ProductId = _product.Id,
                    UserId = use.Id,
                    GroupName = spec.GroupName,
                    Key = spec.Key,
                    Value = spec.Value,
                    SortOrder = specOrder++,
                    IsDeleted = new IsDeleted { IsDeletedStatu = false }
                });
            }

            // ──────────────────────────────────────
            // 10. TEK TRANSACTION KAYIT
            // ──────────────────────────────────────
            await db.SaveChangesAsync(_cts.Token);

            // Başarı
            StateHub.ClearCache($"AddProduct_Stores_{use.Id}");
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use.Id, PAGE_TITLE, "AddProduct");
            await Notify("success", "Başarılı", "Ürün başarıyla eklendi!");

            // Yeni ürün eklemek için formu sıfırla
            ResetForm();
        }
        catch (Exception ex)
        {
            await LogError("SaveProduct", ex);
            await Notify("danger", "Hata", "Ürün kaydedilirken sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    private void ResetForm()
    {
        _product = new Products();
        _selectedStoreId = Guid.Empty;
        _selectedCategoryIds.Clear();
        _primaryCategoryId = 0;
        _categorySearchTerm = string.Empty;
        _categorySearchResults.Clear();
        _selectedAttributes.Clear();
        _selectedValueIds.Clear();
        _newValueInputs.Clear();
        _variants.Clear();
        _variantPrices.Clear();
        _stockEntries.Clear();
        _productGalleryFiles.Clear();
        _variantGalleryFiles.Clear();
        _seoSlug = _seoMetaTitle = _seoMetaDescription = _seoMetaKeywords = null;
        _specifications.Clear();
        _stdPrice = _stdComparePrice = _stdCostPrice = null;
        _currentStep = 0;
        _isProcessing = false;
        StateHasChanged();
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI
