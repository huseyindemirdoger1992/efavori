                                                                <div class="collapse show ms-3 border-start ps-2" id="c-oled">
                                                                    <div class="d-flex align-items-center"><span class="flex-grow-1"><i class="fa fa-tag text-muted me-1"></i>55&quot; OLED</span><button class="btn btn-sm btn-outline-primary py-0">Seç</button></div>
                                                                    <div class="d-flex align-items-center mt-1"><span class="flex-grow-1"><i class="fa fa-tag text-muted me-1"></i>65&quot; OLED</span><button class="btn btn-sm btn-outline-primary py-0">Seç</button></div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                                <li class="mt-1">
                                                    <a class="d-inline-flex align-items-center gap-1 text-decoration-none text-dark" data-bs-toggle="collapse" href="#c-ev"><i class="fa fa-caret-right"></i> <i class="fa fa-folder text-warning"></i> Ev &amp; Yaşam</a>
                                                    <div class="collapse ms-3 border-start ps-2" id="c-ev"><div class="d-flex align-items-center"><span class="flex-grow-1"><i class="fa fa-tag text-muted me-1"></i>Mobilya › Oturma › Koltuk › Köşe Koltuk</span><button class="btn btn-sm btn-outline-primary py-0">Seç</button></div></div>
                                                </li>
                                                <li class="mt-1">
                                                    <a class="d-inline-flex align-items-center gap-1 text-decoration-none text-dark" data-bs-toggle="collapse" href="#c-mod"><i class="fa fa-caret-right"></i> <i class="fa fa-folder text-warning"></i> Moda</a>
                                                    <div class="collapse ms-3 border-start ps-2" id="c-mod"><div class="d-flex align-items-center"><span class="flex-grow-1"><i class="fa fa-tag text-muted me-1"></i>Kadın › Giyim › Elbise › Günlük</span><button class="btn btn-sm btn-outline-primary py-0">Seç</button></div></div>
                                                </li>
