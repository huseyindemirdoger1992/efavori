                                        <tr><td><select class="form-select form-select-sm"><option>Ekran Boyutu</option><option>Çözünürlük</option><option>Panel Tipi</option></select></td><td><div class="input-group input-group-sm"><input class="form-control" value="55"><span class="input-group-text">inç</span></div></td><td><input type="number" class="form-control form-control-sm" value="0"></td><td><button class="btn btn-sm btn-outline-danger"><i class="fa fa-trash-o"></i></button></td></tr>
                                        <tr><td><input class="form-control form-control-sm" placeholder="Serbest ad (CustomName)"></td><td><input class="form-control form-control-sm" placeholder="Serbest değer (CustomValue)"></td><td><input type="number" class="form-control form-control-sm" value="1"></td><td><button class="btn btn-sm btn-outline-danger"><i class="fa fa-trash-o"></i></button></td></tr>
