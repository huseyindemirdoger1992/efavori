    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedStoreId = id;
            _product.StoreId = id;

            // Mağaza değiştiğinde depoları filtrele
            if (id != Guid.Empty)
                await LoadWarehousesAsync();
        }
    }

