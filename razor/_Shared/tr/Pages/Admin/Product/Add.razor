                    <div class="card border shadow-sm">
                        <div class="card-header bg-light py-3"><h6 class="mb-0"><i class="fa fa-info-circle text-primary me-2"></i>Temel Bilgiler &amp; Sınıflandırma</h6></div>
                        <div class="card-body">

                            <!-- Products.ProductType -->
