        _product.Name = e.Value?.ToString() ?? string.Empty;
        // Kullanıcı slug'a manuel dokunmadıysa otomatik üret
        if (string.IsNullOrWhiteSpace(_product.UniqueNameSlug) || _slugAuto)
        {
            _product.UniqueNameSlug = Slugify(_product.Name);
            _slugAuto = true;
