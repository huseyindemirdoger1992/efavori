    private void InitPreview()
    {
        _pvHeroOverride = null;
        _pvSelected.Clear();
        if (_product.ProductIsVariant)
        {
            var def = _variants.FirstOrDefault(v => v.Variant.IsDefault) ?? _variants.FirstOrDefault();
            if (def != null)
                foreach (var (attrId, valueId) in def.Combo)
                    _pvSelected[attrId] = valueId;
        }
