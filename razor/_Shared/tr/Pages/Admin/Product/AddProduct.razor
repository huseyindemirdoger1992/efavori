    private async Task OpenMediaModalCommon()
    {
        _mediaSearch = string.Empty;
        _mediaDisplayCount = 15;
        await LoadUserMediaAsync();
        await ShowModal("modalMediaPicker");
    }

    private async Task LoadUserMediaAsync()
    {
        if (use == null) return;
        _mediaLoading = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _allMedia = await db.Media.AsNoTracking()
                .Where(m => m.IsDeletedStatu != true && m.UserId == use.Id)
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync(_cts.Token);
            ApplyMediaFilter();
        }
        catch (Exception ex) { await LogError("LoadUserMedia", ex); }
        finally { _mediaLoading = false; StateHasChanged(); }
    }

    private void OnMediaSearchInput(ChangeEventArgs e)
    {
        _mediaSearch = e.Value?.ToString() ?? string.Empty;
        _mediaDisplayCount = 15;
        ApplyMediaFilter();
    }

    private void ClearMediaSearch()
    {
        _mediaSearch = string.Empty;
        _mediaDisplayCount = 15;
        ApplyMediaFilter();
    }

    private void ApplyMediaFilter()
    {
        if (string.IsNullOrWhiteSpace(_mediaSearch))
            _filteredMedia = _allMedia.ToList();
        else
        {
            var s = _mediaSearch.Trim();
            _filteredMedia = _allMedia
                .Where(m => m.FileName != null && m.FileName.Contains(s, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // Grid'de bir medyaya tıklanınca slot'a göre davran
    private async Task OnMediaClicked(Data.Media m)
    {
        switch (_activeMediaSlot)
        {
            case "main":
                _mainImage = m;
                await CloseMediaPicker();
                break;
            case "variant":
                if (_activeVariantIndex >= 0 && _activeVariantIndex < _variants.Count)
                    _variants[_activeVariantIndex].Image = m;
                await CloseMediaPicker();
                break;
            case "gallery":
                var existing = _galleryFiles.FirstOrDefault(x => x.Id == m.Id);
                if (existing != null) _galleryFiles.Remove(existing);
                else _galleryFiles.Add(m);
                StateHasChanged();
                break;
        }
    }

    private async Task CloseMediaPicker()
    {
        await HideModal("modalMediaPicker");
        _activeMediaSlot = string.Empty;
        _activeVariantIndex = -1;
    }

    // Upload bileşeninden tekli seçim event'i (yedek mekanizma)
    private void HandleSingleFileSelected(Data.Media media)
    {
        switch (_activeMediaSlot)
        {
            case "main": _mainImage = media; break;
            case "variant":
                if (_activeVariantIndex >= 0 && _activeVariantIndex < _variants.Count)
                    _variants[_activeVariantIndex].Image = media;
                break;
        }
        InvokeAsync(StateHasChanged);
    }

    // Upload bileşeninden yeni dosya geldiğinde modal açıksa grid'i yenile
    private void HandleMediaUploaded()
    {
        if (string.IsNullOrEmpty(_activeMediaSlot)) return;
        InvokeAsync(async () => await LoadUserMediaAsync());
    }

    // ══════════════════════════════════════════════════════════════
    // WIZARD GEZİNME + DOĞRULAMA
    // ══════════════════════════════════════════════════════════════

    private void GoToStep(int step)
    {
        // İleri atlamaya izin verme; sadece geri/aynı adıma izinli
        if (step <= _currentStep) { _currentStep = step; StateHasChanged(); }
    }

    private async Task NextStep()
    {
        if (!ValidateStep(_currentStep, out var msg))
        {
            await Notify("warning", "Eksik Bilgi", msg);
            return;
        }
        if (_currentStep < _steps.Count) _currentStep++;
        if (_currentStep == _steps.Count) { ValidateAll(); InitPreview(); }
        StateHasChanged();
    }

    private void PrevStep()
    {
        if (_currentStep > 1) _currentStep--;
        StateHasChanged();
    }

    private bool ValidateStep(int step, out string message)
    {
        message = string.Empty;
        switch (step)
        {
            case 1:
                if (_product.StoreId == Guid.Empty) { message = "Lütfen bir mağaza seçin."; return false; }
                if (_selectedCategory == null) { message = "Lütfen bir kategori seçin."; return false; }
                return true;
            case 2:
                if (string.IsNullOrWhiteSpace(_product.Name)) { message = "Ürün adı zorunludur."; return false; }
                if (string.IsNullOrWhiteSpace(_product.UniqueNameSlug)) { message = "URL (slug) zorunludur."; return false; }
                if (_slugState == SlugState.Taken) { message = "Bu URL (slug) ile kayıtlı bir ürün zaten var. Lütfen farklı bir URL girin."; return false; }
                return true;
            case 3:
                if (_product.ProductIsVariant)
                {
                    if (!_attributes.Any() || _attributes.Any(a => !a.Values.Any()))
                    { message = "Her varyant özelliği için en az bir değer girin."; return false; }
                    if (!_variants.Any())
                    { message = "Kombinasyonları oluşturun (Kombinasyonları Oluştur butonu)."; return false; }
                }
                return true;
            default:
                return true;
        }
    }

    private void ValidateAll()
    {
        _validationErrors.Clear();
        if (_product.StoreId == Guid.Empty) _validationErrors.Add("Mağaza seçilmedi.");
        if (_selectedCategory == null) _validationErrors.Add("Kategori seçilmedi.");
        if (string.IsNullOrWhiteSpace(_product.Name)) _validationErrors.Add("Ürün adı boş.");
        if (string.IsNullOrWhiteSpace(_product.UniqueNameSlug)) _validationErrors.Add("URL (slug) boş.");
        if (_slugState == SlugState.Taken) _validationErrors.Add("Bu URL (slug) ile kayıtlı bir ürün zaten var. Farklı bir URL girin.");

        if (_product.ProductIsVariant)
        {
            if (!_variants.Any()) _validationErrors.Add("Varyant oluşturulmadı.");
            if (_variants.Any(v => v.Pricing.PriceTL <= 0)) _validationErrors.Add("Bazı varyantların TL fiyatı 0.");
        }
        else
        {
            if (_basePricing.PriceTL <= 0) _validationErrors.Add("Taban TL fiyatı girilmedi.");
        }
    }

    // ══════════════════════════════════════════════════════════════
    // KAYIT — Tüm zincir tek transaction içinde
    // ══════════════════════════════════════════════════════════════

    private async Task SaveAsync()
    {
        if (_isProcessing) return;
        ValidateAll();
        if (_validationErrors.Any())
        {
            await Notify("warning", "Eksik Bilgi", "Lütfen önizlemedeki uyarıları giderin.");
            return;
        }
        if (use == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            // ── Son güvenlik kontrolü: aynı URL (slug) ile kayıt varsa izin verme ──
            var slug = _product.UniqueNameSlug?.Trim();
            if (!string.IsNullOrWhiteSpace(slug) && await SlugExistsAsync(slug!, _cts.Token))
            {
                _slugState = SlugState.Taken;
                if (!_validationErrors.Contains("Bu URL (slug) ile kayıtlı bir ürün zaten var. Farklı bir URL girin."))
                    _validationErrors.Add("Bu URL (slug) ile kayıtlı bir ürün zaten var. Farklı bir URL girin.");
                await Notify("danger", "URL Çakışması", "Bu URL (slug) ile kayıtlı bir ürün zaten var. Kayıt yapılmadı.");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            await using var tx = await db.Database.BeginTransactionAsync(_cts.Token);

            // ── 1) Ana ürün ──
            _product.Id = _product.Id == Guid.Empty ? Guid.NewGuid() : _product.Id;
            _product.UserId = use.Id;
            _product.CategoryId = _selectedCategory?.Id;
            _product.SpecificationsJson = BuildSpecsJson();
            _product.IsDeleted = new IsDeleted { IsDeletedStatu = false };

            if (!_product.ProductIsVariant)
                _product.ImagePath = _mainImage?.FileUrl;

            db.ProductCreateRequest.Add(_product);

            if (!_product.ProductIsVariant)
            {
                // ── Basit ürün taban fiyatı ──
                _basePricing.Id = Guid.NewGuid();
                _basePricing.UserId = use.Id;
                _basePricing.StoreId = _product.StoreId;
                _basePricing.ProductId = _product.Id;
                _basePricing.VariantId = null;
                _basePricing.IsDeleted = new IsDeleted { IsDeletedStatu = false };
                db.ProductPricingCreateRequest.Add(_basePricing);
            }
            else
            {
                // ── 2) Özellikler (sadece yeni olanlar) ──
                foreach (var avm in _attributes)
                {
                    avm.Attr.UserId = use.Id;
                    avm.Attr.StoreId = _product.StoreId;
                    if (!avm.IsExisting)
                    {
                        avm.Attr.IsDeleted = new IsDeleted { IsDeletedStatu = false };
                        db.ProductAttributeCreateRequest.Add(avm.Attr);
                    }

                    // ── 3) Değerler (yeni özelliklerin değerleri her zaman; mevcut özelliğe
                    //        eklenen yeni değerler için Id'si DB'de yoksa eklenir) ──
                    foreach (var val in avm.Values)
                    {
                        val.UserId = use.Id;
                        val.StoreId = _product.StoreId;
                        val.AttributeId = avm.Attr.Id;
                        // Yeni değer mi? (mevcut özellikse, DB'de zaten olabilecek değerleri
                        // ayırmak için Id'leri client'ta üretildiğinden burada hepsi yeni sayılır;
                        // mevcut özellik + mevcut değer senaryosunda değerler tekrar oluşturulmaz
                        // istenirse IsExisting değer bazında genişletilebilir.)
                        if (!avm.IsExisting || !_existingAttributeValueIds.Contains(val.Id))
                        {
                            val.IsDeleted = new IsDeleted { IsDeletedStatu = false };
                            db.ProductAttributeValueCreateRequest.Add(val);
                        }
                    }
                }

                // ── 4) Varyantlar + ── 5) Varyant-Değer eşleşmeleri + ── 6) Fiyatlar ──
                foreach (var vm in _variants)
                {
                    vm.Variant.Id = vm.Variant.Id == Guid.Empty ? Guid.NewGuid() : vm.Variant.Id;
                    vm.Variant.UserId = use.Id;
                    vm.Variant.StoreId = _product.StoreId;
                    vm.Variant.ProductId = _product.Id;
                    vm.Variant.ImagePath = vm.Image?.FileUrl;
                    vm.Variant.IsDeleted = new IsDeleted { IsDeletedStatu = false };
                    db.ProductVariantCreateRequest.Add(vm.Variant);

                    foreach (var (attrId, valueId) in vm.Combo)
                    {
                        db.ProductVariantValueCreateRequest.Add(new ProductVariantValueCreateRequest
                        {
                            Id = Guid.NewGuid(),
                            UserId = use.Id,
                            StoreId = _product.StoreId,
                            VariantId = vm.Variant.Id,
                            AttributeId = attrId,
                            AttributeValueId = valueId,
                            IsDeleted = new IsDeleted { IsDeletedStatu = false }
                        });
                    }

                    vm.Pricing.Id = Guid.NewGuid();
                    vm.Pricing.UserId = use.Id;
                    vm.Pricing.StoreId = _product.StoreId;
                    vm.Pricing.ProductId = _product.Id;
                    vm.Pricing.VariantId = vm.Variant.Id;
                    vm.Pricing.IsDeleted = new IsDeleted { IsDeletedStatu = false };
                    db.ProductPricingCreateRequest.Add(vm.Pricing);
                }

                // Taban (varsayılan) fiyat da kaydedilsin (VariantId = null)
                if (_basePricing.PriceTL > 0 || _basePricing.PriceUSD > 0)
                {
                    _basePricing.Id = Guid.NewGuid();
                    _basePricing.UserId = use.Id;
                    _basePricing.StoreId = _product.StoreId;
                    _basePricing.ProductId = _product.Id;
                    _basePricing.VariantId = null;
                    _basePricing.IsDeleted = new IsDeleted { IsDeletedStatu = false };
                    db.ProductPricingCreateRequest.Add(_basePricing);
                }
            }

            await db.SaveChangesAsync(_cts.Token);

            // ── 7) Galeri (ItemGallery) ──
            if (_galleryFiles.Any())
            {
                var galleryItems = _galleryFiles.Select(m => new ItemGallery
                {
                    Id = Guid.NewGuid(),
                    UserId = use.Id,
                    ItemId = _product.Id,
                    ItemType = "ProductGallery",
                    MediaId = m.Id,
                    ItemAddDate = DateTime.UtcNow,
                    IsDelete = false
                }).ToList();
                await db.ItemGallery.AddRangeAsync(galleryItems, _cts.Token);
                await db.SaveChangesAsync(_cts.Token);
            }

            await tx.CommitAsync(_cts.Token);

            StateHub.ClearCache("CategoriesTr_All");
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use.Id, PAGE_TITLE, "Add", $"ProductId={_product.Id}");
            await Notify("success", "Başarılı", "Ürün başarıyla kaydedildi.");

            ResetForm();
        }
        catch (Exception ex)
        {
            await LogError("SaveAsync", ex);
            await Notify("danger", "Hata", "Ürün kaydedilirken bir sorun oluştu.");
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            _writeLock.Release();
        }
    }

    // Mevcut özelliğe ait, DB'de zaten kayıtlı değerlerin Id'leri (tekrar eklenmesin diye)
    private readonly HashSet<Guid> _existingAttributeValueIds = new();

    private string? BuildSpecsJson()
    {
        var rows = _specs.Where(s => !string.IsNullOrWhiteSpace(s.Key)).ToList();
        if (!rows.Any()) return null;
        var dict = rows.ToDictionary(s => s.Key, s => s.Value);
        return System.Text.Json.JsonSerializer.Serialize(dict);
    }

    private void ResetForm()
    {
        var keepStore = _product.StoreId;
        _product = new ProductCreateRequest { IsActive = true, ProductIsVariant = false, StoreId = keepStore };
        _basePricing = new ProductPricingCreateRequest();
        _selectedCategory = null;
        _catL1 = null;
        _catL2 = null;
        _categorySearch = string.Empty;
        _filteredCategories = new();
        _catResults = new();
        _catResultTotal = 0;
        _catActiveIndex = -1;
        _slugState = SlugState.None;
        _pvHeroOverride = null;
        _pvSelected.Clear();
        _specs.Clear();
        _attributes.Clear();
        _variants.Clear();
        _mainImage = null;
        _galleryFiles.Clear();
        _validationErrors.Clear();
        _slugAuto = true;
        _currentStep = 1;
    }

