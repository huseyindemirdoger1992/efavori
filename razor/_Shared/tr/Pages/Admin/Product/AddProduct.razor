    // Galeri/varyant küçük resmine tıklanınca büyük görsel olur
    private void PvSelectGallery(string url) => _pvHeroOverride = url;

    // Bir varyant değeri tıklanınca seçimi güncelle ve varyant görselini öne çıkar
    private void PvSelectValue(Guid attrId, Guid valueId)
    {
        _pvSelected[attrId] = valueId;
        _pvHeroOverride = null; // galeri override'ı kaldır ki varyant görseli görünsün
    }

    // Seçili değerlere tam uyan varyantı bul
    private VariantVm? PvResolveVariant()
    {
        if (!_product.ProductIsVariant || !_variants.Any()) return null;
        var defAttrs = _attributes
            .Where(a => a.Attr.IsVariantDefining && a.Values.Any())
            .Select(a => a.Attr.Id)
            .ToList();
        if (!defAttrs.Any()) return null;

        return _variants.FirstOrDefault(v =>
            defAttrs.All(aid => _pvSelected.TryGetValue(aid, out var vid)
                && v.Combo.Any(c => c.attrId == aid && c.valueId == vid)));
    }

    // Büyük görsel kaynağı: galeri tıklaması > seçili varyant görseli > varsayılan varyant > ana görsel > ilk galeri
    private string PvHeroUrl()
    {
        const string noImg = "https://efavori.com/_files/main/NoImage.png";
        if (!string.IsNullOrWhiteSpace(_pvHeroOverride)) return _pvHeroOverride!;

        if (_product.ProductIsVariant)
        {
            var v = PvResolveVariant();
            if (!string.IsNullOrWhiteSpace(v?.Image?.FileUrl)) return v!.Image!.FileUrl!;

            var def = _variants.FirstOrDefault(x => x.Variant.IsDefault) ?? _variants.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(def?.Image?.FileUrl)) return def!.Image!.FileUrl!;
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(_mainImage?.FileUrl)) return _mainImage!.FileUrl!;
        }

        return _galleryFiles.FirstOrDefault()?.FileUrl ?? noImg;
    }

    // Küçük resim şeridi: ana görsel + galeri + (varyantlı ise) varyant görselleri
    private List<string> PvThumbs()
    {
        var list = new List<string>();
        if (!_product.ProductIsVariant && !string.IsNullOrWhiteSpace(_mainImage?.FileUrl))
            list.Add(_mainImage!.FileUrl!);

        foreach (var g in _galleryFiles)
            if (!string.IsNullOrWhiteSpace(g.FileUrl)) list.Add(g.FileUrl!);

        if (_product.ProductIsVariant)
            foreach (var v in _variants)
                if (!string.IsNullOrWhiteSpace(v.Image?.FileUrl)) list.Add(v.Image!.FileUrl!);

        return list.Distinct().Take(10).ToList();
    }

    // Önizlemede gösterilecek fiyat (seçili varyanta göre)
    private ProductPricingCreateRequest PvPrice()
    {
        if (_product.ProductIsVariant)
        {
            var v = PvResolveVariant();
            return v?.Pricing
                ?? _variants.FirstOrDefault(x => x.Variant.IsDefault)?.Pricing
                ?? _variants.FirstOrDefault()?.Pricing
                ?? _basePricing;
        }
        return _basePricing;
    }

