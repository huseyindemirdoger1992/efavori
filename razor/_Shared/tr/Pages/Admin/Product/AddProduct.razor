    private void AddAttribute()
    {
        var name = _newAttrName?.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        if (_attributes.Any(a => string.Equals(a.Attr.Name, name, StringComparison.OrdinalIgnoreCase))) return;

        // Mevcut bir özellikle birebir eşleşiyor mu? → tekrar kullan
        var existing = _existingAttributes.FirstOrDefault(a => string.Equals(a.Name, name, StringComparison.OrdinalIgnoreCase));

        var vm = new AttributeVm();
        if (existing != null)
        {
            vm.IsExisting = true;
            vm.Attr = new ProductAttributeCreateRequest
            {
                Id = existing.Id,
                UserId = existing.UserId,
                StoreId = existing.StoreId,
                Name = existing.Name,
                Code = existing.Code,
                DisplayType = existing.DisplayType,
                IsVariantDefining = true,
                DisplayOrder = existing.DisplayOrder
            };
        }
        else
        {
            vm.Attr = new ProductAttributeCreateRequest
            {
                Name = name!,
                Code = Slugify(name!),
                DisplayType = _newAttrDisplayType,
                IsVariantDefining = true,
                DisplayOrder = _newAttrOrder
            };
        }
        _attributes.Add(vm);

        _newAttrName = string.Empty;
        _newAttrDisplayType = "text";
        _newAttrOrder = 0;
    }

    private void RemoveAttribute(AttributeVm avm)
    {
        _attributes.Remove(avm);
        _variants.Clear();   // değişen yapı → yeniden üret gerekir
    }

    private void AddValue(AttributeVm avm)
    {
        var text = avm.NewValueText?.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;
        if (avm.Values.Any(v => string.Equals(v.Value, text, StringComparison.OrdinalIgnoreCase))) return;

        avm.Values.Add(new ProductAttributeValueCreateRequest
        {
            AttributeId = avm.Attr.Id,
            Value = text!,
            ColorHex = avm.Attr.DisplayType == "color" ? avm.NewValueColor : null,
            DisplayOrder = avm.Values.Count
        });
        avm.NewValueText = string.Empty;
        avm.NewValueColor = "#000000";
    }

    private void RemoveValue(AttributeVm avm, ProductAttributeValueCreateRequest val)
    {
        avm.Values.Remove(val);
        _variants.Clear();
    }

    private int PossibleCombinationCount()
    {
        var defining = _attributes.Where(a => a.Attr.IsVariantDefining && a.Values.Any()).ToList();
        if (!defining.Any()) return 0;
        var count = 1;
        foreach (var a in defining) count *= a.Values.Count;
        return count;
    }

    private void GenerateVariants()
    {
        var defining = _attributes.Where(a => a.Attr.IsVariantDefining && a.Values.Any()).ToList();
        if (!defining.Any()) { _variants.Clear(); return; }

        // Kartezyen çarpım
        var combos = new List<List<(Guid attrId, ProductAttributeValueCreateRequest val)>> { new() };
        foreach (var attr in defining)
        {
            var next = new List<List<(Guid, ProductAttributeValueCreateRequest)>>();
            foreach (var c in combos)
                foreach (var v in attr.Values)
                {
                    var nc = new List<(Guid, ProductAttributeValueCreateRequest)>(c) { (attr.Attr.Id, v) };
                    next.Add(nc);
                }
            combos = next;
        }

        // Mevcut düzenlemeleri imza ile koru
        var oldBySig = _variants.ToDictionary(v => v.Signature, v => v);
        var newList = new List<VariantVm>();

        foreach (var combo in combos)
        {
            var comboIds = combo.Select(x => (x.attrId, x.val.Id)).ToList();
            var sig = string.Join("|", comboIds.OrderBy(c => c.attrId).Select(c => $"{c.attrId}:{c.Item2}"));
            var title = string.Join(" / ", combo.Select(x => x.val.Value));

            if (oldBySig.TryGetValue(sig, out var existingVm))
            {
                existingVm.Variant.VariantTitle = title;
                newList.Add(existingVm);
            }
            else
            {
                newList.Add(new VariantVm
                {
                    Combo = comboIds,
                    Variant = new ProductVariantCreateRequest
                    {
                        VariantTitle = title,
                        StockQuantity = 0,
                        DisplayOrder = newList.Count,
                        IsDefault = newList.Count == 0
                    },
                    Pricing = new ProductPricingCreateRequest()
                });
            }
        }

        // En az bir varsayılan kalsın
        if (newList.Any() && !newList.Any(v => v.Variant.IsDefault))
            newList[0].Variant.IsDefault = true;

        _variants = newList;
    }

    private void SetDefaultVariant(int index)
    {
        for (int i = 0; i < _variants.Count; i++)
            _variants[i].Variant.IsDefault = (i == index);
    }

