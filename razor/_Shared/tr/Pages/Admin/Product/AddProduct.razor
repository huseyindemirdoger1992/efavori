@* ============================================================
   AddProduct.razor
   ─────────────────────────────────────────────────────────────
   ✅ Kullanıcı bilgisi otomatik ([Parameter] Users use)
   ✅ Sadece ADMIN ONAYLI mağazalar seçilebilir (IsActiveStateAdmin == true)
   ✅ CategoriesTr üzerinde anlık (debounce'suz/hızlı) arama + seçim
   ✅ Basit ürün VE varyantlı ürün (Renk/Beden vb. kombinasyon üretimi)
   ✅ 4 para birimi fiyatlandırma (TL / USD / EUR / AZN) + indirimli fiyat
   ✅ Ana görsel + Galeri + Varyant görseli (mevcut medya kütüphanesinden seçim)
   ✅ Adım adım sihirbaz + profesyonel ürün önizleme (inceleme) ekranı
   ✅ Tek transaction içinde tüm kayıt zinciri (Product → Attribute → Value
      → Variant → VariantValue → Pricing → Gallery)
   ✅ TakeLogs ile loglama, GlobalStateHub cache temizleme, Notification
   ─────────────────────────────────────────────────────────────
   NOT: DbSet adlarının sınıf adlarıyla aynı olduğu varsayıldı
   (mevcut sayfadaki db.TryTableSingle deseniyle tutarlı). Projende
   DbSet adları farklıysa (örn. db.Products) sadece o satırları değiştir.
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using razor._Shared.tr.Media
@using System.Text
@using System.Text.RegularExpressions

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
@inject FileUploadService FileService

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",        "Ana Sayfa",   "/"),
        ("fa fa-shopping-bag","Ürünler",     "javascript:void(0)"),
        ("fa fa-plus-square", PAGE_TITLE,    "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ═══════════════════════════════════════════
   ADIM GÖSTERGESİ (WIZARD STEPPER)
   ═══════════════════════════════════════════ *@
<div class="card border  mb-3">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            @foreach (var step in _steps)
            {
                var isActive = step.No == _currentStep;
                var isDone = step.No < _currentStep;
                <div class="d-flex align-items-center flex-fill" style="min-width: 120px;">
                    <button type="button"
                            class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 @(isActive ? "btn-primary" : isDone ? "btn-success" : "btn-outline-light")"
                            style="width: 38px; height: 38px;"
                            @onclick="() => GoToStep(step.No)"
                            title="@step.Title">
                        @if (isDone)
                        {
                            <i class="fa fa-check" style="margin-left:5px;"></i>
                        }
                        else
                        {
                            <i class="fa @step.Icon" style="margin-left:5px;"></i>
                        }
                    </button>
                    <div class="ms-2 d-none d-lg-block">
                        <div class="small fw-bold @(isActive ? "text-white" : isDone ? "text-light" : "text-white-50")">@step.Title</div>
                        <div class="text-white-50" style="font-size: 0.7rem;">Adım @step.No</div>
                    </div>
                    @if (step.No < _steps.Count)
                    {
                        <div class="flex-fill mx-2 d-none d-lg-block" style="height: 2px; background: @(isDone ? "#198754" : "#495057");"></div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   ADIM İÇERİĞİ
   ═══════════════════════════════════════════ *@
<div class="card border  mb-3" style="box-shadow:0 0 8px rgba(13,202,240,0.20);">
    <div class="card-body">

        @* ─────────────────────────────────────────
           ADIM 1 — MAĞAZA & KATEGORİ
           ───────────────────────────────────────── *@
        @if (_currentStep == 1)
        {
            <h6 class="text-white border-bottom  pb-2 mb-3">
                <i class="fa fa-shopping-cart me-2 text-info"></i>Mağaza ve Kategori
            </h6>

            @* Kullanıcı bilgisi (otomatik) *@
            <div class="alert border  text-white-50 small d-flex align-items-center mb-3">
                <i class="fa fa-user-circle-o fa-lg me-2 text-info"></i>
                <div>
                    Ürün ekleyen:
                    <span class="text-white fw-bold">@($"{use?.FirstName} {use?.LastName}".Trim())</span>
                    <span class="ms-1">(@(use?.ContactInformation?.Email ?? "—"))</span>
                </div>
            </div>

            @* Mağaza seçimi *@
            <label class="form-label text-white-50 small"><i class="fa fa-building-o me-1"></i>Hangi mağaza için ekliyorsunuz? <span class="text-danger">*</span></label>
            @if (_loadingStores)
            {
                <div class="text-center py-3"><i class="fa fa-spinner fa-spin text-info"></i> <span class="text-white-50 small">Mağazalar yükleniyor...</span></div>
            }
            else if (!_approvedStores.Any())
            {
                <div class="alert alert-warning border border-warning text-warning small">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    Admin tarafından onaylanmış aktif bir mağazanız bulunmuyor. Ürün ekleyebilmek için önce mağazanızın onaylanması gerekir.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-2">
                    @foreach (var s in _approvedStores)
                    {
                        var selected = _product.StoreId == s.Id;
                        <div class="col">
                            <div class="card h-100 @(selected ? "border-primary" : "")"
                                 style="cursor:pointer; @(selected ? "box-shadow:0 0 8px rgba(13,110,253,0.5);" : "")"
                                 @onclick="() => SelectStore(s)">
                                <div class="card-body py-3 d-flex align-items-center">
                                    <img src="@(string.IsNullOrWhiteSpace(s.ProfileCoverGallery?.ProfileImagePath) ? "https://efavori.com/_files/main/NoImage.png" : s.ProfileCoverGallery!.ProfileImagePath)"
                                         class="rounded-circle border  me-3"
                                         style="width:48px;height:48px;object-fit:cover;" alt="@s.Name" />
                                    <div class="flex-fill overflow-hidden">
                                        <div class="text-white fw-bold text-truncate">@s.Name</div>
                                        <div class="text-success small"><i class="fa fa-check-circle me-1"></i>Onaylı</div>
                                    </div>
                                    @if (selected)
                                    {
                                        <i class="fa fa-check-circle fa-lg text-primary"></i>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <hr class=" my-4" />

            @* Kategori — profesyonel arama (tüm ağaç) + gözatma (Miller kolonları) *@
            <label class="form-label text-white-50 small"><i class="fa fa-sitemap me-1"></i>Kategori <span class="text-danger">*</span></label>

            @if (_selectedCategory != null)
            {
                <div class="d-flex align-items-center justify-content-between border border-success rounded p-2 mb-2">
                    <div class="text-white">
                        <i class="fa fa-folder-open-o text-success me-2"></i>
                        <span class="fw-bold">@_selectedCategory.Name</span>
                        @if (!string.IsNullOrWhiteSpace(_selectedCategory.DepartmentName))
                        {
                            <span class="badge bg-light ms-2">@_selectedCategory.DepartmentName</span>
                        }
                        <div class="text-white-50 small mt-1"><i class="fa fa-share me-1"></i>@CategoryPath(_selectedCategory)</div>
                    </div>
                    <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearCategory" title="Seçimi temizle">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            }

            @if (_loadingCategories)
            {
                <div class="text-center py-3"><i class="fa fa-spinner fa-spin text-info"></i> <span class="text-white-50 small">Kategoriler yükleniyor...</span></div>
            }
            else
            {
                @* ── Arama kutusu (col-12) ── *@
                <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text bg-transparent text-white"><i class="fa fa-search"></i></span>
                    <input type="text"
                           class="form-control bg-transparent text-light"
                           placeholder="Kategori ara — tüm seviyelerde arar (örn: korkuluk, telefon kılıfı)"
                           value="@_categorySearch"
                           @oninput="OnCategorySearchInput"
                           @onkeydown="OnSearchKeyDown"
                           autocomplete="off" />
                    @if (!string.IsNullOrWhiteSpace(_categorySearch))
                    {
                        <button class="btn btn-outline-light" type="button" @onclick="ClearCategorySearch" title="Aramayı temizle">
                            <i class="fa fa-times"></i>
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_categorySearch))
                {
                    @* ── ARAMA MODU: tüm ağaçta düz sonuç listesi (tam yol + vurgu) ── *@
                    @if (!_catResults.Any())
                    {
                        <div class="text-white-50 small py-3 text-center border rounded">
                            <i class="fa fa-search me-1"></i>"@_categorySearch" için sonuç bulunamadı. Farklı bir kelime deneyin.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-white-50 small">
                                <i class="fa fa-list-ul me-1"></i>@_catResultTotal sonuç
                                @if (_catResultTotal > _catResults.Count)
                                {
                                    <span>· ilk @_catResults.Count gösteriliyor, aramayı daraltın</span>
                                }
                            </span>
                            <span class="text-white-50" style="font-size:0.7rem;"><i class="fa fa-keyboard-o me-1"></i>↑ ↓ gez · Enter seç · Esc temizle</span>
                        </div>
                        <div class="list-group" style="max-height:340px;overflow-y:auto;">
                            @for (int i = 0; i < _catResults.Count; i++)
                            {
                                var idx = i;
                                var c = _catResults[idx];
                                var hasChildren = CatChildren(c.Id).Any();
                                <button type="button"
                                        class="list-group-item list-group-item-action bg-transparent text-white py-2 @(idx == _catActiveIndex ? "active" : "")"
                                        @onclick="() => SelectFromSearch(c)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-semibold"><i class="fa fa-folder-o text-info me-2"></i>@Highlight(c.Name, _categorySearch)</span>
                                        @if (hasChildren)
                                        {
                                            <span class="badge bg-light ms-2" title="Alt kategorileri olan bir grup"><i class="fa fa-folder me-1"></i>grup</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary ms-2" title="Alt kategorisi olmayan uç (yaprak) kategori"><i class="fa fa-tag me-1"></i>uç</span>
                                        }
                                    </div>
                                    <div class="text-white-50 small mt-1"><i class="fa fa-share me-1"></i>@CategoryPath(c)</div>
                                </button>
                            }
                        </div>
                        <div class="text-white-50 small mt-1"><i class="fa fa-info-circle me-1"></i>Bir sonucu seçtiğinizde gözatma kutuları o kategorinin konumuna göre açılır; istersen orada ince ayar yapabilirsin.</div>
                    }
                }
                else
                {
                    @* ── GÖZATMA MODU: 3 sütunlu (Miller) drill-down ── *@
                    <div class="row g-2">
                        @* 1. kutu — Ana kategoriler *@
                        <div class="col-4">
                            <div class="card h-100">
                                <div class="card-header py-1 px-2 small text-white-50 d-flex justify-content-between align-items-center">
                                    <span><i class="fa fa-folder-o me-1 text-info"></i>Ana Kategori</span>
                                    <span class="badge bg-light">@CatLevel1().Count</span>
                                </div>
                                <div class="list-group list-group-flush" style="max-height:300px;overflow-y:auto;">
                                    @foreach (var c in CatLevel1())
                                    {
                                        var act = _catL1?.Id == c.Id;
                                        <button type="button"
                                                class="list-group-item list-group-item-action bg-transparent text-white d-flex justify-content-between align-items-center py-2 @(act ? "active" : "")"
                                                @onclick="() => SelectCatLevel(1, c)">
                                            <span class="text-truncate">@c.Name</span>
                                            @if (CatChildren(c.Id).Any())
                                            {
                                                <i class="fa fa-angle-right ms-1 text-white-50"></i>
                                            }
                                        </button>
                                    }
                                    @if (!CatLevel1().Any())
                                    {
                                        <div class="text-white-50 small p-2"><i class="fa fa-info-circle me-1"></i>Kategori yok.</div>
                                    }
                                </div>
                            </div>
                        </div>

                        @* 2. kutu — Alt kategori *@
                        <div class="col-4">
                            <div class="card h-100">
                                <div class="card-header py-1 px-2 small text-white-50 d-flex justify-content-between align-items-center">
                                    <span><i class="fa fa-folder-o me-1 text-info"></i>Alt Kategori</span>
                                    <span class="badge bg-light">@CatLevel2().Count</span>
                                </div>
                                <div class="list-group list-group-flush" style="max-height:300px;overflow-y:auto;">
                                    @if (_catL1 == null)
                                    {
                                        <div class="text-white-50 small p-2"><i class="fa fa-arrow-left me-1"></i>Önce ana kategori seçin.</div>
                                    }
                                    else
                                    {
                                        @foreach (var c in CatLevel2())
                                        {
                                            var act = _catL2?.Id == c.Id;
                                            <button type="button"
                                                    class="list-group-item list-group-item-action bg-transparent text-white d-flex justify-content-between align-items-center py-2 @(act ? "active" : "")"
                                                    @onclick="() => SelectCatLevel(2, c)">
                                                <span class="text-truncate">@c.Name</span>
                                                @if (CatChildren(c.Id).Any())
                                                {
                                                    <i class="fa fa-angle-right ms-1 text-white-50"></i>
                                                }
                                            </button>
                                        }
                                        @if (!CatLevel2().Any())
                                        {
                                            <div class="text-white-50 small p-2"><i class="fa fa-info-circle me-1"></i>Alt kategori yok.</div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        @* 3. kutu — Alt-alt kategori *@
                        <div class="col-4">
                            <div class="card h-100">
                                <div class="card-header py-1 px-2 small text-white-50 d-flex justify-content-between align-items-center">
                                    <span><i class="fa fa-folder-o me-1 text-info"></i>Alt-Alt Kategori</span>
                                    <span class="badge bg-light">@CatLevel3().Count</span>
                                </div>
                                <div class="list-group list-group-flush" style="max-height:300px;overflow-y:auto;">
                                    @if (_catL2 == null)
                                    {
                                        <div class="text-white-50 small p-2"><i class="fa fa-arrow-left me-1"></i>Önce alt kategori seçin.</div>
                                    }
                                    else
                                    {
                                        @foreach (var c in CatLevel3())
                                        {
                                            var act = _selectedCategory?.Id == c.Id;
                                            <button type="button"
                                                    class="list-group-item list-group-item-action bg-transparent text-white d-flex justify-content-between align-items-center py-2 @(act ? "active" : "")"
                                                    @onclick="() => SelectCatLevel(3, c)">
                                                <span class="text-truncate">@c.Name</span>
                                            </button>
                                        }
                                        @if (!CatLevel3().Any())
                                        {
                                            <div class="text-white-50 small p-2"><i class="fa fa-info-circle me-1"></i>Alt-alt kategori yok.</div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-white-50 small mt-2"><i class="fa fa-info-circle me-1"></i>Aramak için yukarıdaki kutuyu kullanın ya da kategorilere tıklayarak gezinin. Kategori 1, 2 veya 3 derinlikte olabilir.</div>
                }
            }
        }

        @* ─────────────────────────────────────────
           ADIM 2 — TEMEL BİLGİLER
           ───────────────────────────────────────── *@
        else if (_currentStep == 2)
        {
            <h6 class="text-white border-bottom  pb-2 mb-3">
                <i class="fa fa-info-circle me-2 text-info"></i>Temel Ürün Bilgileri
            </h6>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label text-white-50 small">Ürün Adı <span class="text-danger">*</span> <span class="text-white-50">(SEO başlığı, 50-60 karakter)</span></label>
                    <input type="text" maxlength="120"
                           class="form-control form-control-sm text-white "
                           placeholder="Örn: iPhone 18 Pro Max 256GB Titanyum Mavi"
                           value="@_product.Name"
                           @oninput="OnNameInput" />
                    <div class="text-end text-white-50" style="font-size:0.7rem;">@(_product.Name?.Length ?? 0) karakter</div>
                </div>

                <div class="col-12">
                    <label class="form-label text-white-50 small">URL (Slug) <span class="text-danger">*</span></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text text-white-50 ">/urun/</span>
                        <input type="text"
                               class="form-control text-white @(_slugState == SlugState.Taken ? "is-invalid" : _slugState == SlugState.Available ? "is-valid" : "")"
                               value="@_product.UniqueNameSlug"
                               @oninput="OnSlugInput" />
                        <button class="btn btn-outline-light" type="button" @onclick="RegenerateSlug" title="Ürün adından yeniden üret">
                            <i class="fa fa-refresh"></i>
                        </button>
                    </div>
                    @if (_slugState == SlugState.Checking)
                    {
                        <div class="small text-white-50 mt-1"><i class="fa fa-spinner fa-spin me-1"></i>URL kontrol ediliyor...</div>
                    }
                    else if (_slugState == SlugState.Taken)
                    {
                        <div class="small text-danger mt-1"><i class="fa fa-times-circle me-1"></i>Bu URL (slug) ile kayıtlı bir ürün zaten var. Lütfen farklı bir URL girin.</div>
                    }
                    else if (_slugState == SlugState.Available)
                    {
                        <div class="small text-success mt-1"><i class="fa fa-check-circle me-1"></i>Bu URL kullanılabilir, kayıt için uygun.</div>
                    }
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label text-white-50 small">Marka</label>
                    <input type="text"
                           class="form-control form-control-sm text-white "
                           placeholder="Örn: Apple"
                           @bind="_product.Brand" @bind:event="oninput" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label text-white-50 small">AI SEO Anahtar Kelimeleri</label>
                    <input type="text"
                           class="form-control form-control-sm text-white "
                           placeholder="virgülle ayırın"
                           @bind="_product.AiSeoKeywords" @bind:event="oninput" />
                </div>

                <div class="col-12">
                    <label class="form-label text-white-50 small">Kısa Açıklama <span class="text-white-50">(meta description, 140-160 karakter)</span></label>
                    <textarea rows="2" maxlength="300"
                              class="form-control form-control-sm text-white "
                              placeholder="Arama motorlarında görünecek kısa açıklama"
                              @bind="_product.Description" @bind:event="oninput"></textarea>
                    <div class="text-end text-white-50" style="font-size:0.7rem;">@(_product.Description?.Length ?? 0) karakter</div>
                </div>

                <div class="col-12">
                    <label class="form-label text-white-50 small">Detaylı Açıklama <span class="text-white-50">(HTML destekli)</span></label>
                    <textarea rows="6"
                              class="form-control form-control-sm text-white "
                              placeholder="Ürün sayfasındaki tam açıklama..."
                              @bind="_product.Content" @bind:event="oninput"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label text-white-50 small">Teknik Özellikler (varyant oluşturmayan)</label>
                    <button class="btn btn-outline-light btn-sm w-100 mb-2" type="button" @onclick="AddSpec">
                        <i class="fa fa-plus me-1"></i>Özellik Satırı Ekle
                    </button>
                    @if (_specs.Any())
                    {
                        @foreach (var spec in _specs)
                        {
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" class="form-control text-white " placeholder="Anahtar (Örn: Depolama)" @bind="spec.Key" @bind:event="oninput" />
                                <input type="text" class="form-control text-white " placeholder="Değer (Örn: 512 GB)" @bind="spec.Value" @bind:event="oninput" />
                                <button class="btn btn-outline-danger " type="button" @onclick="() => _specs.Remove(spec)"><i class="fa fa-trash"></i></button>
                            </div>
                        }
                    }
                </div>

                <div class="col-12 col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="chkActive" @bind="_product.IsActive" />
                        <label class="form-check-label text-white-50" for="chkActive"><i class="fa fa-power-off me-1"></i>Satışta (Aktif)</label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="chkFeatured" @bind="_product.IsFeatured" />
                        <label class="form-check-label text-white-50" for="chkFeatured"><i class="fa fa-star me-1"></i>Vitrinde Öne Çıkar</label>
                    </div>
                </div>
            </div>
        }

        @* ─────────────────────────────────────────
           ADIM 3 — ÜRÜN TİPİ & VARYANTLAR
           ───────────────────────────────────────── *@
        else if (_currentStep == 3)
        {
            <h6 class="text-white border-bottom  pb-2 mb-3">
                <i class="fa fa-cubes me-2 text-info"></i>Ürün Tipi
            </h6>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <div class="card @(!_product.ProductIsVariant ? "border-primary" : "")" style="cursor:pointer;"
                         @onclick="() => SetVariantMode(false)">
                        <div class="card-body d-flex align-items-center">
                            <i class="fa fa-cube fa-2x me-3 @(!_product.ProductIsVariant ? "text-primary" : "text-white-50")"></i>
                            <div>
                                <div class="text-white fw-bold">Basit Ürün</div>
                                <div class="text-white-50 small">Tek SKU, tek stok, tek fiyat</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card @(_product.ProductIsVariant ? "border-primary" : "")" style="cursor:pointer;"
                         @onclick="() => SetVariantMode(true)">
                        <div class="card-body d-flex align-items-center">
                            <i class="fa fa-cubes fa-2x me-3 @(_product.ProductIsVariant ? "text-primary" : "text-white-50")"></i>
                            <div>
                                <div class="text-white fw-bold">Varyantlı Ürün</div>
                                <div class="text-white-50 small">Renk / Beden vb. kombinasyonlar</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!_product.ProductIsVariant)
            {
                @* ── BASİT ÜRÜN ── *@
                <h6 class="text-white-50 small mt-3 mb-2"><i class="fa fa-barcode me-1"></i>Stok Bilgileri</h6>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label text-white-50 small">SKU (Stok Kodu)</label>
                        <input type="text" class="form-control form-control-sm text-white " @bind="_product.SKU" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label text-white-50 small">Barkod (GTIN/EAN/UPC)</label>
                        <input type="text" class="form-control form-control-sm text-white " @bind="_product.Barcode" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label text-white-50 small">Stok Adedi</label>
                        <input type="number" min="0" class="form-control form-control-sm text-white " @bind="_product.StockQuantity" @bind:event="oninput" />
                    </div>
                    <div class="col-12">
                        <label class="form-label text-white-50 small">Ana Görsel</label>
                        <div class="d-flex align-items-center gap-3">
                            <img src="@(_mainImage?.FileUrl ?? "https://efavori.com/_files/main/NoImage.png")"
                                 class="rounded border " style="width:90px;height:90px;object-fit:cover;" alt="Ana görsel" />
                            <button class="btn btn-outline-light btn-sm" type="button" @onclick='() => OpenMediaPicker("main")'>
                                <i class="fa fa-picture-o me-1"></i>Görsel Seç
                            </button>
                            @if (_mainImage != null)
                            {
                                <button class="btn btn-outline-danger btn-sm border-0" type="button" @onclick="() => _mainImage = null"><i class="fa fa-times"></i></button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* ── VARYANTLI ÜRÜN ── *@
                <h6 class="text-white-50 small mt-3 mb-2"><i class="fa fa-tags me-1"></i>Varyant Özellikleri</h6>

                @* Mevcut / yeni özellik ekleme *@
                <div class="card  mb-3">
                    <div class="card-body py-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-4">
                                <label class="form-label text-white-50 small">Özellik Adı</label>
                                <input list="existingAttrList" type="text"
                                       class="form-control form-control-sm text-white "
                                       placeholder="Örn: Renk, Beden"
                                       @bind="_newAttrName" @bind:event="oninput" />
                                <datalist id="existingAttrList">
                                    @foreach (var ea in _existingAttributes)
                                    {
                                        <option value="@ea.Name"></option>
                                    }
                                </datalist>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label text-white-50 small">Gösterim Tipi</label>

                                <select class="form-select form-select-sm text-white" @bind="_newAttrDisplayType">

                                    <optgroup class="bg-dark text-light" label="📝 Temel Veri Tipleri">
                                        <option value="text">Metin</option>
                                        <option value="textarea">Uzun Metin</option>
                                        <option value="number">Sayı</option>
                                        <option value="decimal">Ondalıklı Sayı</option>
                                        <option value="boolean">Evet / Hayır</option>
                                        <option value="single_select">Tek Seçim</option>
                                        <option value="multi_select">Çoklu Seçim</option>
                                        <option value="date">Tarih</option>
                                        <option value="datetime">Tarih Saat</option>
                                        <option value="time">Saat</option>
                                        <option value="color">Renk</option>
                                        <option value="image">Resim</option>
                                        <option value="file">Dosya</option>
                                        <option value="url">URL</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="📏 Boyut / Ölçü">
                                        <option value="length">Uzunluk</option>
                                        <option value="width">Genişlik</option>
                                        <option value="height">Yükseklik</option>
                                        <option value="depth">Derinlik</option>
                                        <option value="diameter">Çap</option>
                                        <option value="radius">Yarıçap</option>
                                        <option value="thickness">Kalınlık</option>
                                        <option value="dimension">Boyutlar</option>
                                        <option value="distance">Mesafe</option>
                                        <option value="area">Alan</option>
                                        <option value="volume">Hacim</option>
                                        <option value="angle">Açı</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="⚖️ Ağırlık / Kapasite">
                                        <option value="weight">Ağırlık</option>
                                        <option value="mass">Kütle</option>
                                        <option value="capacity">Kapasite</option>
                                        <option value="density">Yoğunluk</option>
                                        <option value="flow">Akış Oranı</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="📦 Paketleme / Adet">
                                        <option value="quantity">Adet</option>
                                        <option value="piece">Parça Sayısı</option>
                                        <option value="pack">Paket Sayısı</option>
                                        <option value="unit">Birim</option>
                                        <option value="box_count">Koli Sayısı</option>
                                        <option value="pallet_count">Palet Sayısı</option>
                                        <option value="minimum_order">Minimum Sipariş</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="👕 Giyim / Moda">
                                        <option value="size">Beden</option>
                                        <option value="shoe_size">Ayakkabı Numarası</option>
                                        <option value="waist_size">Bel Ölçüsü</option>
                                        <option value="chest_size">Göğüs Ölçüsü</option>
                                        <option value="neck_size">Yaka Ölçüsü</option>
                                        <option value="sleeve_length">Kol Uzunluğu</option>
                                        <option value="fit">Kalıp</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="🎨 Görünüm / Tasarım">
                                        <option value="material">Materyal</option>
                                        <option value="pattern">Desen</option>
                                        <option value="texture">Doku</option>
                                        <option value="finish">Yüzey Kaplama</option>
                                        <option value="style">Stil</option>
                                        <option value="shape">Şekil</option>
                                        <option value="transparency">Şeffaflık</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="💻 Elektronik / Teknoloji">
                                        <option value="storage">Depolama</option>
                                        <option value="ram">RAM</option>
                                        <option value="screen_size">Ekran Boyutu</option>
                                        <option value="resolution">Çözünürlük</option>
                                        <option value="refresh_rate">Yenileme Hızı</option>
                                        <option value="battery_capacity">Batarya Kapasitesi</option>
                                        <option value="power">Güç</option>
                                        <option value="voltage">Voltaj</option>
                                        <option value="current">Akım</option>
                                        <option value="frequency">Frekans</option>
                                        <option value="energy">Enerji</option>
                                        <option value="connector_type">Bağlantı Tipi</option>
                                        <option value="wireless">Kablosuz Özelliği</option>
                                        <option value="network_speed">Ağ Hızı</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="🚗 Araç / Motor">
                                        <option value="engine_volume">Motor Hacmi</option>
                                        <option value="horsepower">Beygir Gücü</option>
                                        <option value="torque">Tork</option>
                                        <option value="rpm">RPM</option>
                                        <option value="fuel_consumption">Yakıt Tüketimi</option>
                                        <option value="tank_capacity">Yakıt Kapasitesi</option>
                                        <option value="gearbox">Şanzıman</option>
                                        <option value="traction">Çekiş</option>
                                        <option value="speed">Hız</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="🌡️ Fiziksel Özellikler">
                                        <option value="temperature">Sıcaklık</option>
                                        <option value="humidity">Nem</option>
                                        <option value="pressure">Basınç</option>
                                        <option value="force">Kuvvet</option>
                                        <option value="hardness">Sertlik</option>
                                        <option value="viscosity">Viskozite</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="🔊 Ses / Işık">
                                        <option value="sound_level">Ses Seviyesi</option>
                                        <option value="frequency_sound">Ses Frekansı</option>
                                        <option value="brightness">Parlaklık</option>
                                        <option value="lumen">Lumen</option>
                                        <option value="lux">Lux</option>
                                        <option value="color_temperature">Renk Sıcaklığı</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="📡 Ağ / Veri">
                                        <option value="bandwidth">Bant Genişliği</option>
                                        <option value="transfer_rate">Transfer Hızı</option>
                                        <option value="download_speed">İndirme Hızı</option>
                                        <option value="upload_speed">Yükleme Hızı</option>
                                        <option value="latency">Gecikme</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="⏳ Zaman / Ömür">
                                        <option value="duration">Süre</option>
                                        <option value="lifetime">Ömür</option>
                                        <option value="warranty">Garanti</option>
                                        <option value="expiration">Son Kullanma Süresi</option>
                                        <option value="production_time">Üretim Süresi</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="💰 Finans">
                                        <option value="currency">Para Birimi</option>
                                        <option value="price">Fiyat</option>
                                        <option value="discount">İndirim</option>
                                        <option value="percentage">Yüzde</option>
                                        <option value="tax">Vergi</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="🪑 Mobilya / Ev">
                                        <option value="seat_count">Kişi Sayısı</option>
                                        <option value="assembly">Kurulum Durumu</option>
                                        <option value="room_size">Oda Boyutu</option>
                                        <option value="load_capacity">Taşıma Kapasitesi</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="🔧 Endüstriyel / Teknik">
                                        <option value="load_capacity">Yük Kapasitesi</option>
                                        <option value="production_capacity">Üretim Kapasitesi</option>
                                        <option value="efficiency">Verimlilik</option>
                                        <option value="consumption">Tüketim</option>
                                        <option value="working_pressure">Çalışma Basıncı</option>
                                    </optgroup>

                                    <optgroup class="bg-dark text-light" label="⚙️ Özel">
                                        <option value="custom">Özel Alan</option>
                                    </optgroup>

                                </select>

                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label text-white-50 small">Sıra</label>
                                <input type="number" min="0" class="form-control form-control-sm text-white " @bind="_newAttrOrder" />
                            </div>
                            <div class="col-12 col-md-3">
                                <button class="btn btn-info btn-sm w-100" type="button" @onclick="AddAttribute">
                                    <i class="fa fa-plus me-1"></i>Özellik Ekle
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @* Eklenmiş özellikler ve değerleri *@
                @if (!_attributes.Any())
                {
                    <div class="text-white-50 small py-2"><i class="fa fa-info-circle me-1"></i>Henüz varyant özelliği eklenmedi. En az bir özellik ve değer ekleyin.</div>
                }
                else
                {
                    @foreach (var avm in _attributes)
                    {
                        <div class="card  mb-2">
                            <div class="card-header  d-flex justify-content-between align-items-center py-2">
                                <span class="text-white fw-bold">
                                    <i class="fa fa-tag me-1 text-info"></i>@avm.Attr.Name
                                    <span class="badge bg-light ms-1">@avm.Attr.DisplayType</span>
                                    @if (avm.IsExisting)
                                    {
                                        <span class="badge bg-success ms-1" title="Mevcut özellik tekrar kullanılıyor">mevcut</span>
                                    }
                                </span>
                                <button class="btn btn-outline-danger btn-sm border-0" type="button" @onclick="() => RemoveAttribute(avm)"><i class="fa fa-trash"></i></button>
                            </div>
                            <div class="card-body py-2">
                                @* Değer ekleme *@
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col">
                                        <input type="text" class="form-control form-control-sm text-white "
                                               placeholder="Değer (Örn: Kırmızı, XL)"
                                               @bind="avm.NewValueText" @bind:event="oninput"
                                               @onkeydown="@(e => { if (e.Key == "Enter") AddValue(avm); })" />
                                    </div>
                                    @if (avm.Attr.DisplayType == "color")
                                    {
                                        <div class="col-auto">
                                            <input type="color" class="form-control form-control-sm form-control-color " @bind="avm.NewValueColor" />
                                        </div>
                                    }
                                    <div class="col-auto">
                                        <button class="btn btn-outline-info btn-sm" type="button" @onclick="() => AddValue(avm)">
                                            <i class="fa fa-plus"></i> Değer
                                        </button>
                                    </div>
                                </div>
                                @* Değer rozetleri (düzenlenebilir) *@
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var val in avm.Values)
                                    {
                                        <div class="d-inline-flex align-items-center border rounded ps-2 pe-1 py-1" style="background:rgba(255,255,255,0.06);">
                                            @if (avm.Attr.DisplayType == "color")
                                            {
                                                <input type="color"
                                                       class="form-control form-control-color form-control-sm border-0 p-0 me-1"
                                                       style="width:24px;height:24px;min-width:24px;background:transparent;cursor:pointer;"
                                                       @bind="val.ColorHex" />
                                            }
                                            <input type="text"
                                                   class="form-control form-control-sm text-white border-0 bg-transparent p-0 px-1"
                                                   style="min-width:64px;width:auto;"
                                                   @bind="val.Value" @bind:event="oninput"
                                                   title="Değeri düzenleyin; ardından 'Kombinasyonları Oluştur' ile güncelleyin" />
                                            <i class="fa fa-times ms-1 me-1 text-danger" style="cursor:pointer;" @onclick="() => RemoveValue(avm, val)"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="text-white-50 small mt-2"><i class="fa fa-info-circle me-1"></i>Bir değeri düzenledikten sonra güncel başlık ve kombinasyonlar için tekrar oluşturun.</div>
                    <button class="btn btn-primary btn-sm w-100 mt-1" type="button" @onclick="GenerateVariants">
                        <i class="fa fa-cogs me-1"></i>Kombinasyonları Oluştur (@PossibleCombinationCount() adet)
                    </button>
                }

                @* Üretilen varyantlar tablosu *@
                @if (_variants.Any())
                {
                    <hr class=" my-3" />
                    <h6 class="text-white-50 small mb-2"><i class="fa fa-list me-1"></i>Varyantlar (@_variants.Count)</h6>
                    <div class="table-responsive rounded border ">
                        <table class="table table-dark table-hover align-middle mb-0 small">
                            <thead class="bg-light">
                                <tr>
                                    <th>Görsel</th>
                                    <th>Kombinasyon</th>
                                    <th>SKU</th>
                                    <th>Barkod</th>
                                    <th style="width:90px;">Stok</th>
                                    <th style="width:60px;">Varsay.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < _variants.Count; i++)
                                {
                                    var vi = i;
                                    var vm = _variants[vi];
                                    <tr>
                                        <td>
                                            <img src="@(vm.Image?.FileUrl ?? "https://efavori.com/_files/main/NoImage.png")"
                                                 class="rounded border " style="width:42px;height:42px;object-fit:cover;cursor:pointer;"
                                                 @onclick='() => OpenVariantImage(vi)' title="Görsel seç" />
                                        </td>
                                        <td class="text-white">@vm.Variant.VariantTitle</td>
                                        <td><input type="text" class="form-control form-control-sm text-white " @bind="vm.Variant.SKU" @bind:event="oninput" /></td>
                                        <td><input type="text" class="form-control form-control-sm text-white " @bind="vm.Variant.Barcode" @bind:event="oninput" /></td>
                                        <td><input type="number" min="0" class="form-control form-control-sm text-white " @bind="vm.Variant.StockQuantity" @bind:event="oninput" /></td>
                                        <td class="text-center">
                                            <input type="radio" name="defaultVariant" class="form-check-input"
                                                   checked="@vm.Variant.IsDefault"
                                                   @onchange="() => SetDefaultVariant(vi)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-white-50 small mt-1"><i class="fa fa-info-circle me-1"></i>Diğer para birimleri "Fiyatlandırma" adımında her varyant için ayrıca girilebilir; boş bırakılan varyant fiyatları taban fiyattan doldurulur.</div>
                }
            }
        }

        @* ─────────────────────────────────────────
           ADIM 4 — FİYATLANDIRMA
           ───────────────────────────────────────── *@
        else if (_currentStep == 4)
        {
            <h6 class="text-white border-bottom  pb-2 mb-3">
                <i class="fa fa-money me-2 text-info"></i>Fiyatlandırma
            </h6>

            @if (!_product.ProductIsVariant)
            {
                <div class="text-white-50 small mb-2">Basit ürün için taban fiyatlar:</div>
                @RenderPricingInputs(_basePricing)
            }
            else
            {
                <div class="text-white-50 small mb-2">Önce tüm varyantlara uygulanacak taban fiyatı girip dağıtabilir, sonra istediğiniz varyantı tek tek düzenleyebilirsiniz.</div>
                <div class="card  mb-3">
                    <div class="card-header  text-white py-2"><i class="fa fa-files-o me-1"></i>Taban Fiyat (tüm varyantlara uygula)</div>

                    <div class="col-12 col-md-12">
                        <div class="card shadow-sm bg-light">
                            <div class="card-body py-2">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold">Döviz Kurları</span>
                                    <small class="text-secondary" id="lastUpdate">Yükleniyor...</small>
                                </div>

                                <div class="d-flex justify-content-between text-center">
                                    <div class="flex-fill">
                                        <div class="text-primary fw-bold">USD</div>
                                        <div class="fw-semibold" id="usd">-</div>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="text-info fw-bold">EUR</div>
                                        <div class="fw-semibold" id="eur">-</div>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="text-warning fw-bold">AZN</div>
                                        <div class="fw-semibold" id="azn">-</div>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="text-light fw-bold">TRY</div>
                                        <div class="fw-semibold" id="try">-</div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <script>
                                    async function loadRates() {
                                        const lastUpdateEl = document.getElementById("lastUpdate");
                                        try {
                                            const res = await fetch("https://open.er-api.com/v6/latest/USD");
                                            if (!res.ok) throw new Error("API hatası");
                                            const data = await res.json();

                                            const r = data.rates;
                                            document.getElementById("usd").innerText = "1.0000";
                                            document.getElementById("eur").innerText = (r.EUR || 0).toFixed(4);
                                            document.getElementById("azn").innerText = (r.AZN || 0).toFixed(4);
                                            document.getElementById("try").innerText = (r.TRY || 0).toFixed(4);

                                            // API'den gelen son güncelleme zamanını kullanmak daha sağlıklıdır
                                            lastUpdateEl.innerText = "Son Güncelleme: " + new Date().toLocaleTimeString('tr-TR');
                                        } catch (err) {
                                            console.error("Kur verisi alınamadı:", err);
                                            lastUpdateEl.innerText = "Veri alınamadı.";
                                        }
                                    }

                                    loadRates();
                                    setInterval(loadRates, 60000);
                    </script>

                    <div class="card-body">
                        @RenderPricingInputs(_basePricing)
                        <button class="btn btn-outline-info btn-sm mt-2" style="width:100%;" type="button" @onclick="ApplyBasePriceToVariants">
                            <i class="fa fa-arrow-down me-1"></i>Tüm Varyantlara Uygula
                        </button>
                    </div>
                </div>

                @for (int i = 0; i < _variants.Count; i++)
                {
                    var vm = _variants[i];
                    <div class="card mb-3 shadow-sm border-0 rounded-3 overflow-hidden">

                        <div class="card-header text-white py-2 d-flex align-items-center gap-2">

                            <img src="@(vm.Image?.FileUrl ?? "https://efavori.com/_files/main/NoImage.png")"
                                 class="rounded border"
                                 style="width:34px;height:34px;object-fit:cover;" />

                            <span class="fw-semibold flex-grow-1">
                                @vm.Variant.VariantTitle
                            </span>

                            <span class="badge bg-light text-light px-2 py-1">
                                Stok: @vm.Variant.StockQuantity
                            </span>

                        </div>
                        <div class="card-body py-3">

                            @RenderPricingInputs(vm.Pricing)

                        </div>
                    </div>
                }
            }
        }

        @* ─────────────────────────────────────────
           ADIM 5 — GÖRSELLER / GALERİ
           ───────────────────────────────────────── *@
        else if (_currentStep == 5)
        {
            <h6 class="text-white border-bottom  pb-2 mb-3">
                <i class="fa fa-picture-o me-2 text-info"></i>Görseller ve Galeri
            </h6>

            @if (!_product.ProductIsVariant)
            {
                <label class="form-label text-white-50 small">Ana Görsel</label>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <img src="@(_mainImage?.FileUrl ?? "https://efavori.com/_files/main/NoImage.png")"
                         class="rounded border " style="width:110px;height:110px;object-fit:cover;" />
                    <button class="btn btn-outline-light btn-sm" type="button" @onclick='() => OpenMediaPicker("main")'>
                        <i class="fa fa-picture-o me-1"></i>Ana Görsel Seç
                    </button>
                </div>
            }

            <label class="form-label text-white-50 small">
                Galeri Görselleri
                @if (_galleryFiles.Any())
                {
                    <span class="badge bg-primary ms-1">@_galleryFiles.Count</span>
                }
            </label>
            <button type="button" class="btn btn-outline-light btn-sm w-100 mb-2" @onclick="OpenGalleryPicker">
                <i class="fa fa-folder-open-o me-1"></i>Medyadan Galeri Görseli Seç
            </button>
            @if (_galleryFiles.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var m in _galleryFiles.ToList())
                    {
                        <div class="position-relative">
                            <img src="@m.FileUrl" class="rounded border " style="width:80px;height:80px;object-fit:cover;" alt="@m.FileName" />
                            <button type="button"
                                    class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center border-0"
                                    style="width:20px;height:20px;font-size:0.7rem;margin-top:-5px;margin-right:-5px;"
                                    @onclick="() => _galleryFiles.Remove(m)">
                                <i class="fa fa-times text-white" style="margin-left:5px"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        }

        @* ─────────────────────────────────────────
           ADIM 6 — ÖNİZLEME (ÜRÜN İNCELEME SAYFASI)
           ───────────────────────────────────────── *@
        else if (_currentStep == 6)
        {
            <h6 class="text-white border-bottom  pb-2 mb-3">
                <i class="fa fa-eye me-2 text-info"></i>Önizleme — Ürün İnceleme Sayfası
            </h6>

            <div class="card bg-light text-light border-0 shadow-sm">
                <div class="card-body">
                    <div class="row g-4">
                        @* Sol — görseller *@
                        <div class="col-12 col-md-5">
                            @{
                                var pvHero = PvHeroUrl();
                                var pvThumbs = PvThumbs();
                            }
                            <img src="@pvHero"
                                 class="img-fluid rounded w-100 mb-2 border" style="height:320px;object-fit:cover;" />
                            @if (pvThumbs.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var t in pvThumbs)
                                    {
                                        var act = string.Equals(pvHero, t, StringComparison.Ordinal);
                                        <img src="@t"
                                             class="rounded border @(act ? "border-primary" : "")"
                                             style="width:54px;height:54px;object-fit:cover;cursor:pointer;@(act ? "box-shadow:0 0 0 2px #0d6efd;" : "")"
                                             @onclick="() => PvSelectGallery(t)"
                                             title="Büyük görsel olarak göster" />
                                    }
                                </div>
                            }
                        </div>

                        @* Sağ — bilgi *@
                        <div class="col-12 col-md-7">
                            @if (!string.IsNullOrWhiteSpace(_product.Brand))
                            {
                                <div class="text-uppercase text-light small fw-bold">@_product.Brand</div>
                            }
                            <h4 class="fw-bold mb-1">@(string.IsNullOrWhiteSpace(_product.Name) ? "(Ürün adı girilmedi)" : _product.Name)</h4>
                            <div class="text-light small mb-2">
                                <i class="fa fa-building-o me-1"></i>@(_approvedStores.FirstOrDefault(s => s.Id == _product.StoreId)?.Name ?? "—")
                                <span class="mx-2">·</span>
                                <i class="fa fa-sitemap me-1"></i>@(_selectedCategory != null ? CategoryPath(_selectedCategory) : "—")
                            </div>

                            @{
                                var dispPrice = PvPrice();
                            }
                            <div class="mb-3">
                                @if (dispPrice.DiscountPriceTL.HasValue && dispPrice.DiscountPriceTL > 0)
                                {
                                    <span class="text-decoration-line-through text-light me-2">@dispPrice.PriceTL.ToString("N2") ₺</span>
                                    <span class="h4 fw-bold text-light">@dispPrice.DiscountPriceTL!.Value.ToString("N2") ₺</span>
                                }
                                else
                                {
                                    <span class="h4 fw-bold text-light">@dispPrice.PriceTL.ToString("N2") ₺</span>
                                }
                                <div class="small text-light mt-1">
                                    $ @dispPrice.PriceUSD.ToString("N2") · € @dispPrice.PriceEUR.ToString("N2") · ₼ @dispPrice.PriceAZN.ToString("N2")
                                </div>
                            </div>

                            <hr />

                            @if (!string.IsNullOrWhiteSpace(_product.Description))
                            {
                                <p class="text-light">@_product.Description</p>
                            }

                            @* Varyant seçenekleri önizleme (tıklanabilir) *@
                            @if (_product.ProductIsVariant)
                            {
                                @foreach (var avm in _attributes)
                                {
                                    <div class="mb-2">
                                        <div class="small fw-bold text-light">@avm.Attr.Name</div>
                                        <div class="d-flex flex-wrap gap-2 mt-1">
                                            @foreach (var v in avm.Values)
                                            {
                                                var sel = _pvSelected.TryGetValue(avm.Attr.Id, out var selVid) && selVid == v.Id;
                                                @if (avm.Attr.DisplayType == "color" && !string.IsNullOrWhiteSpace(v.ColorHex))
                                                {
                                                    <span class="d-inline-flex align-items-center border rounded px-2 py-1 small @(sel ? "border-primary" : "")"
                                                          style="cursor:pointer;@(sel ? "box-shadow:0 0 0 2px #0d6efd;" : "")"
                                                          @onclick="() => PvSelectValue(avm.Attr.Id, v.Id)">
                                                        <span class="rounded-circle border me-1" style="width:14px;height:14px;background:@v.ColorHex;display:inline-block;"></span>@v.Value
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="border rounded px-2 py-1 small @(sel ? "border-primary text-white" : "")"
                                                          style="cursor:pointer;@(sel ? "box-shadow:0 0 0 2px #0d6efd;" : "")"
                                                          @onclick="() => PvSelectValue(avm.Attr.Id, v.Id)">@v.Value</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                                var pvSelVariant = PvResolveVariant();
                                <div class="small text-light mt-2">
                                    <i class="fa fa-cubes me-1"></i>@_variants.Count varyant · Toplam stok: @_variants.Sum(v => v.Variant.StockQuantity)
                                </div>
                                @if (pvSelVariant != null)
                                {
                                    <div class="small mt-1">
                                        <span class="badge bg-success"><i class="fa fa-check me-1"></i>Seçili varyant: @pvSelVariant.Variant.VariantTitle</span>
                                        <span class="text-light ms-2"><i class="fa fa-archive me-1"></i>Stok: @pvSelVariant.Variant.StockQuantity</span>
                                        @if (!string.IsNullOrWhiteSpace(pvSelVariant.Variant.SKU))
                                        {
                                            <span class="text-light ms-2"><i class="fa fa-barcode me-1"></i>@pvSelVariant.Variant.SKU</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-warning mt-1"><i class="fa fa-info-circle me-1"></i>Bu kombinasyon için tanımlı bir varyant yok.</div>
                                }
                            }
                            else
                            {
                                <div class="small text-light">
                                    <i class="fa fa-barcode me-1"></i>SKU: @(_product.SKU ?? "—")
                                    <span class="mx-2">·</span>
                                    <i class="fa fa-archive me-1"></i>Stok: @_product.StockQuantity
                                </div>
                            }

                            <div class="mt-3">
                                @if (_product.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fa fa-check me-1"></i>Satışta</span>
                                }
                                else
                                {
                                    <span class="badge bg-light">Pasif</span>
                                }
                                @if (_product.IsFeatured)
                                {
                                    <span class="badge bg-warning text-light ms-1"><i class="fa fa-star me-1"></i>Vitrin</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (_specs.Any(s => !string.IsNullOrWhiteSpace(s.Key)))
                    {
                        <hr />
                        <h6 class="fw-bold">Teknik Özellikler</h6>
                        <table class="table table-sm table-striped mb-0">
                            <tbody>
                                @foreach (var s in _specs.Where(s => !string.IsNullOrWhiteSpace(s.Key)))
                                {
                                    <tr><th style="width:35%;">@s.Key</th><td>@s.Value</td></tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (!string.IsNullOrWhiteSpace(_product.Content))
                    {
                        <hr />
                        <h6 class="fw-bold">Ürün Açıklaması</h6>
                        <div class="text-light">@((MarkupString)_product.Content!)</div>
                    }

                </div>
            </div>

            @if (_validationErrors.Any())
            {
                <div class="alert alert-danger border border-danger text-danger mt-3">
                    <div class="fw-bold mb-1"><i class="fa fa-exclamation-circle me-1"></i>Kaydetmeden önce düzeltin:</div>
                    <ul class="mb-0 small">
                        @foreach (var err in _validationErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</div>

@* ═══════════════════════════════════════════
   GEZİNME (GERİ / İLERİ / KAYDET)
   ═══════════════════════════════════════════ *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <button class="btn btn-outline-light btn-sm" @onclick="PrevStep" disabled="@(_currentStep == 1 || _isProcessing)">
        <i class="fa fa-arrow-left me-1"></i>Geri
    </button>

    <span class="text-white-50 small">Adım @_currentStep / @_steps.Count</span>

    @if (_currentStep < _steps.Count)
    {
        <button class="btn btn-primary btn-sm" @onclick="NextStep" disabled="@_isProcessing">
            İleri<i class="fa fa-arrow-right ms-1"></i>
        </button>
    }
    else
    {
        <button class="btn btn-success btn-sm px-4" @onclick="SaveAsync" disabled="@_isProcessing">
            @if (_isProcessing)
            {
                <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
            }
            else
            {
                <i class="fa fa-save me-1"></i><span>Ürünü Kaydet</span>
            }
        </button>
    }
</div>

@* ═══════════════════════════════════════════
   MEDYA SEÇİCİ MODAL (Ana görsel / Varyant / Galeri)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="modalMediaPicker" tabindex="-1" aria-hidden="true"
     data-bs-backdrop="false" style="z-index:1080;">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border ">
            <div class="modal-header border-bottom  py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-picture-o me-2 text-info"></i>
                    @(_activeMediaSlot == "gallery" ? "Galeri Görselleri Seç" : "Görsel Seç")
                </h6>
                <button type="button" class="btn btn-sm text-danger border-0" @onclick="CloseMediaPicker"><i class="fa fa-times"></i></button>
            </div>
            <div class="modal-body">
                <Upload use="use" />
                <hr class=" my-3" />

                <div class="input-group input-group-sm mb-3">
                    <span class="input-group-text  text-white-50"><i class="fa fa-search"></i></span>
                    <input type="text" class="form-control  text-white" placeholder="Ara..."
                           value="@_mediaSearch" @oninput="OnMediaSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(_mediaSearch))
                    {
                        <button class="btn btn-outline-light " type="button" @onclick="ClearMediaSearch"><i class="fa fa-times"></i></button>
                    }
                </div>

                @if (_mediaLoading)
                {
                    <div class="text-center py-5"><i class="fa fa-spinner fa-spin fa-2x text-info"></i><p class="mt-2 text-light small">Yükleniyor...</p></div>
                }
                else if (!_filteredMedia.Any())
                {
                    <div class="text-center py-5 text-white-50"><i class="fa fa-folder-open fa-3x mb-3 d-block"></i><p class="mb-0">Medya bulunamadı</p></div>
                }
                else
                {
                    var selSet = _galleryFiles.Select(g => g.Id).ToHashSet();
                    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
                        @foreach (var m in _filteredMedia.Take(_mediaDisplayCount))
                        {
                            var isGallerySel = _activeMediaSlot == "gallery" && selSet.Contains(m.Id);
                            <div class="col">
                                <div class="card  h-100 overflow-hidden position-relative @(isGallerySel ? "border-primary" : "")"
                                     style="cursor:pointer;" @onclick="() => OnMediaClicked(m)">
                                    @if (isGallerySel)
                                    {
                                        <div class="position-absolute top-0 end-0 m-2" style="z-index:10;">
                                            <span class="badge bg-primary"><i class="fa fa-check"></i></span>
                                        </div>
                                    }
                                    @{
                                        var ext = m.FileExtensionType?.ToLower() ?? "";
                                        var isImg = _imageExt.Contains(ext);
                                    }
                                    @if (isImg)
                                    {
                                        <img src="@m.FileUrl" style="height:140px;object-fit:cover;width:100%;" alt="@m.FileName" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center text-white-50" style="height:140px;"><i class="fa fa-file-o fa-3x"></i></div>
                                    }
                                    <div class="card-body p-2">
                                        <div class="text-white small text-truncate" title="@m.FileName">@m.FileName</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_mediaDisplayCount < _filteredMedia.Count)
                    {
                        <div class="text-center mt-3">
                            <button class="btn btn-outline-light btn-sm px-4" @onclick="() => _mediaDisplayCount += 15">
                                <i class="fa fa-arrow-down me-1"></i>Daha Fazla
                            </button>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer border-top  py-2">
                <span class="text-white-50 small me-auto">
                    @if (_activeMediaSlot == "gallery")
                    {
                        @($"{_galleryFiles.Count} görsel seçildi")
                    }
                </span>
                <button type="button" class="btn btn-primary btn-sm" @onclick="CloseMediaPicker">
                    <i class="fa fa-check me-1"></i>@(_activeMediaSlot == "gallery" ? "Seçimi Onayla" : "Kapat")
                </button>
            </div>
        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ─────────────────────────────────────────────────
    private const string PAGE_TITLE = "Ürün Ekle";
    private const string ENTITY_NAME = "Product";
    private const int SEARCH_DELAY = 350;

    // ─── Parametre: oturum açan kullanıcı (otomatik) ──────────────
    [Parameter] public Users? use { get; set; }

    // ─── Wizard ───────────────────────────────────────────────────
    private int _currentStep = 1;
    private readonly List<(int No, string Title, string Icon)> _steps = new()
    {
        (1, "Mağaza & Kategori", "fa-shopping-cart"),
        (2, "Temel Bilgiler",    "fa-info-circle"),
        (3, "Ürün Tipi",         "fa-cubes"),
        (4, "Fiyatlandırma",     "fa-money"),
        (5, "Görseller",         "fa-picture-o"),
        (6, "Önizleme",          "fa-eye"),
    };

    // ─── Ana model ────────────────────────────────────────────────
    private ProductCreateRequest _product = new();
    private ProductPricingCreateRequest _basePricing = new();

    // ─── Mağazalar ────────────────────────────────────────────────
    private List<Store> _approvedStores = new();
    private bool _loadingStores;

    // ─── Kategoriler ──────────────────────────────────────────────
    private List<CategoriesTr> _allCategories = new();
    private List<CategoriesTr> _filteredCategories = new();
    private CategoriesTr? _selectedCategory;
    private CategoriesTr? _catL1;          // 1. kutuda seçili ana kategori
    private CategoriesTr? _catL2;          // 2. kutuda seçili alt kategori
    private string _categorySearch = string.Empty;
    private bool _loadingCategories;

    // Hızlı erişim indeksleri (20.000+ kategori için O(1) çocuk/ata erişimi)
    private Dictionary<int, CategoriesTr> _catById = new();
    private Dictionary<int, List<CategoriesTr>> _childrenByParent = new();
    private List<CategoriesTr> _catRoots = new();

    // Arama (tüm ağaçta düz sonuç) durumu
    private List<CategoriesTr> _catResults = new();
    private int _catResultTotal;
    private int _catActiveIndex = -1;
    private const int CAT_RESULT_LIMIT = 60;

    // ─── Teknik özellikler (SpecificationsJson kaynağı) ───────────
    private class SpecRow { public string Key { get; set; } = ""; public string Value { get; set; } = ""; }
    private List<SpecRow> _specs = new();

    // ─── Varyant özellikleri ──────────────────────────────────────
    private class AttributeVm
    {
        public ProductAttributeCreateRequest Attr { get; set; } = new();
        public List<ProductAttributeValueCreateRequest> Values { get; set; } = new();
        public bool IsExisting { get; set; }                 // mevcut özellik tekrar kullanılıyor mu
        public string NewValueText { get; set; } = "";
        public string NewValueColor { get; set; } = "#000000";
    }
    private List<AttributeVm> _attributes = new();
    private string _newAttrName = string.Empty;
    private string _newAttrDisplayType = "text";
    private int _newAttrOrder = 0;
    private List<ProductAttributeCreateRequest> _existingAttributes = new();

    // ─── Üretilen varyantlar ──────────────────────────────────────
    private class VariantVm
    {
        public ProductVariantCreateRequest Variant { get; set; } = new();
        public ProductPricingCreateRequest Pricing { get; set; } = new();
        public List<(Guid attrId, Guid valueId)> Combo { get; set; } = new();
        public Data.Media? Image { get; set; }
        public string Signature => string.Join("|", Combo.OrderBy(c => c.attrId).Select(c => $"{c.attrId}:{c.valueId}"));
    }
    private List<VariantVm> _variants = new();

    // ─── Medya seçici ─────────────────────────────────────────────
    private Data.Media? _mainImage;
    private List<Data.Media> _galleryFiles = new();
    private List<Data.Media> _allMedia = new();
    private List<Data.Media> _filteredMedia = new();
    private string _mediaSearch = string.Empty;
    private int _mediaDisplayCount = 15;
    private bool _mediaLoading;
    private string _activeMediaSlot = string.Empty;  // "main" | "gallery" | "variant"
    private int _activeVariantIndex = -1;
    private static readonly string[] _imageExt =
        { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg", ".avif", ".heic", ".heif" };

    // ─── UI / yaşam döngüsü ───────────────────────────────────────
    private bool _isProcessing;
    private bool _disposed;
    private bool _isInitialized;
    private Notification? _notificationRef;
    private List<string> _validationErrors = new();

    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _categoryCts;
    private CancellationTokenSource? _mediaSearchCts;
    private CancellationTokenSource? _slugCheckCts;
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── URL (Slug) benzersizlik durumu ──────────────────────────
    private enum SlugState { None, Checking, Available, Taken }
    private SlugState _slugState = SlugState.None;

    // ─── Önizleme (interaktif ürün sayfası) ──────────────────────
    private string? _pvHeroOverride;                            // galeri küçük resmine tıklanınca büyük görsel
    private readonly Dictionary<Guid, Guid> _pvSelected = new(); // attrId -> seçili valueId (önizleme)

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        FileService.OnFileSelected += HandleSingleFileSelected;
        FileService.OnFileUploaded += HandleMediaUploaded;

        // Yeni ürün varsayılanları
        _product = new ProductCreateRequest { IsActive = true, IsFeatured = false, ProductIsVariant = false };

        await Task.WhenAll(
            LoadApprovedStoresAsync(),
            LoadCategoriesAsync()
        );
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        FileService.OnFileSelected -= HandleSingleFileSelected;
        FileService.OnFileUploaded -= HandleMediaUploaded;

        await _cts.CancelAsync();
        _cts.Dispose();
        _categoryCts?.Dispose();
        _mediaSearchCts?.Dispose();
        _slugCheckCts?.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    // Sadece ADMIN ONAYLI (IsActiveStateAdmin == true) ve silinmemiş mağazalar
    private async Task LoadApprovedStoresAsync()
    {
        if (use == null) return;
        _loadingStores = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _approvedStores = await db.Stores.AsNoTracking()
                .Where(s => s.UserId == use.Id
                         && s.IsActiveStateAdmin == true
                         && (s.IsDeleted == null || s.IsDeleted.IsDeletedStatu == null || s.IsDeleted.IsDeletedStatu == false))
                .OrderByDescending(s => s.CreatedAt)
                .ToListAsync(_cts.Token);

            // Tek onaylı mağaza varsa otomatik seç
            if (_approvedStores.Count == 1)
                _product.StoreId = _approvedStores[0].Id;
        }
        catch (Exception ex) { await LogError("LoadApprovedStores", ex); }
        finally { _loadingStores = false; StateHasChanged(); }
    }

    private async Task LoadCategoriesAsync()
    {
        _loadingCategories = true;
        StateHasChanged();
        try
        {
            _allCategories = await StateHub.GetOrLoadAsync("CategoriesTr_All", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.CategoriesTr.AsNoTracking()
                    .OrderBy(c => c.DepartmentName).ThenBy(c => c.Name)
                    .ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();

            BuildCategoryIndex();
        }
        catch (Exception ex) { await LogError("LoadCategories", ex); }
        finally { _loadingCategories = false; StateHasChanged(); }
    }

    // Bellekte indeks kur: Id→kategori, ParentId→çocuklar, kökler. Her seviye ada göre sıralı.
    private void BuildCategoryIndex()
    {
        _catById = new Dictionary<int, CategoriesTr>(_allCategories.Count);
        _childrenByParent = new Dictionary<int, List<CategoriesTr>>();
        _catRoots = new List<CategoriesTr>();

        foreach (var c in _allCategories)
        {
            _catById[c.Id] = c;
            if (c.ParentCategoryId is int pid)
            {
                if (!_childrenByParent.TryGetValue(pid, out var list))
                    _childrenByParent[pid] = list = new List<CategoriesTr>();
                list.Add(c);
            }
            else
            {
                _catRoots.Add(c);
            }
        }

        _catRoots = _catRoots.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList();
        foreach (var key in _childrenByParent.Keys.ToList())
            _childrenByParent[key] = _childrenByParent[key].OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList();
    }

    // Seçilen mağazaya ait mevcut varyant özelliklerini yükler (tekrar kullanım için)
    private async Task LoadExistingAttributesAsync()
    {
        if (use == null || _product.StoreId == Guid.Empty) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _existingAttributes = await db.ProductAttributeCreateRequest.AsNoTracking()
                .Where(a => a.StoreId == _product.StoreId
                         && (a.IsDeleted == null || a.IsDeleted.IsDeletedStatu != true))
                .OrderBy(a => a.DisplayOrder).ThenBy(a => a.Name)
                .ToListAsync(_cts.Token);
        }
        catch (Exception ex) { await LogError("LoadExistingAttributes", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // ADIM 1 — MAĞAZA & KATEGORİ
    // ══════════════════════════════════════════════════════════════

    private async Task SelectStore(Store s)
    {
        _product.StoreId = s.Id;
        await LoadExistingAttributesAsync();
        StateHasChanged();
    }

    // ── Arama (debounce 300ms) — tüm ağaçta, her seviyede ──
    private async Task OnCategorySearchInput(ChangeEventArgs e)
    {
        _categorySearch = e.Value?.ToString() ?? string.Empty;
        _catActiveIndex = -1;

        _categoryCts?.Cancel();
        _categoryCts = new CancellationTokenSource();
        var token = _categoryCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (token.IsCancellationRequested) return;
            RunCategorySearch();
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private void ClearCategorySearch()
    {
        _categorySearch = string.Empty;
        _catResults = new();
        _catResultTotal = 0;
        _catActiveIndex = -1;
    }

    // Klavye ile sonuç listesinde gezinme (↑ ↓ Enter / Esc)
    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (!_catResults.Any()) return;
        switch (e.Key)
        {
            case "ArrowDown": _catActiveIndex = Math.Min(_catActiveIndex + 1, _catResults.Count - 1); break;
            case "ArrowUp": _catActiveIndex = Math.Max(_catActiveIndex - 1, 0); break;
            case "Enter":
                var pick = _catActiveIndex >= 0 && _catActiveIndex < _catResults.Count ? _catActiveIndex : 0;
                SelectFromSearch(_catResults[pick]);
                break;
            case "Escape": ClearCategorySearch(); break;
        }
    }

    // Tüm kategorilerde ada göre arama + alaka sıralaması (tam > baştan > kelime başı > içerir)
    private void RunCategorySearch()
    {
        var q = _categorySearch?.Trim();
        if (string.IsNullOrWhiteSpace(q))
        {
            _catResults = new();
            _catResultTotal = 0;
            return;
        }

        var ranked = _allCategories
            .Where(c => c.Name != null && c.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Select(c => new { c, rank = CatRank(c.Name!, q) })
            .OrderBy(x => x.rank)
            .ThenBy(x => x.c.Name!.Length)
            .ThenBy(x => x.c.Name, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.c)
            .ToList();

        _catResultTotal = ranked.Count;
        _catResults = ranked.Take(CAT_RESULT_LIMIT).ToList();
    }

    private static int CatRank(string name, string q)
    {
        if (string.Equals(name, q, StringComparison.OrdinalIgnoreCase)) return 0;   // tam eşleşme
        if (name.StartsWith(q, StringComparison.OrdinalIgnoreCase)) return 1;       // baştan eşleşir
        foreach (var w in name.Split(new[] { ' ', '-', '/', ',' }, StringSplitOptions.RemoveEmptyEntries))
            if (w.StartsWith(q, StringComparison.OrdinalIgnoreCase)) return 2;      // kelime başı
        return 3;                                                                  // içerir
    }

    // Arama sonucundan seçim: seç + gözatma kutularını bu kategorinin konumuna senkronla
    private void SelectFromSearch(CategoriesTr c)
    {
        _selectedCategory = c;
        _product.CategoryId = c.Id;
        SyncColumnsToSelection(c);
        _categorySearch = string.Empty;
        _catResults = new();
        _catResultTotal = 0;
        _catActiveIndex = -1;
    }

    // ── Gözatma (Miller kolonları) — indeks üzerinden ──
    private List<CategoriesTr> CatChildren(int parentId)
        => _childrenByParent.TryGetValue(parentId, out var list) ? list : new();

    private List<CategoriesTr> CatLevel1() => _catRoots;
    private List<CategoriesTr> CatLevel2() => _catL1 == null ? new() : CatChildren(_catL1.Id);
    private List<CategoriesTr> CatLevel3() => _catL2 == null ? new() : CatChildren(_catL2.Id);

    // Bir kutudaki kategoriye tıklayınca: hem seç hem de alt seviyeyi aç
    private void SelectCatLevel(int level, CategoriesTr c)
    {
        _selectedCategory = c;
        _product.CategoryId = c.Id;

        if (level == 1) { _catL1 = c; _catL2 = null; }
        else if (level == 2) { _catL2 = c; }
        // level == 3: yaprak seçim, açılacak alt seviye yok
    }

    // Seçilen kategorinin atasına göre 1. ve 2. kutuyu ayarla (gözatma senkronu)
    private void SyncColumnsToSelection(CategoriesTr c)
    {
        var chain = Ancestry(c);
        _catL1 = chain.Count >= 1 ? chain[0] : null;
        _catL2 = chain.Count >= 2 ? chain[1] : null;
    }

    private void ClearCategory()
    {
        _selectedCategory = null;
        _product.CategoryId = null;
    }

    // c → kök zinciri (kök ... c) ; indeks üzerinden O(derinlik)
    private List<CategoriesTr> Ancestry(CategoriesTr c)
    {
        var chain = new List<CategoriesTr>();
        CategoriesTr? cur = c;
        var guard = 0;
        while (cur != null && guard++ < 20)
        {
            chain.Insert(0, cur);
            if (cur.ParentCategoryId is int pid && _catById.TryGetValue(pid, out var p))
                cur = p;
            else
                break;
        }
        return chain;
    }

    // Kategori üst-yol metni (Antikalar › ... › Korkuluklar)
    private string CategoryPath(CategoriesTr c)
    {
        var names = Ancestry(c)
            .Where(x => !string.IsNullOrWhiteSpace(x.Name))
            .Select(x => x.Name!)
            .ToList();

        if (!string.IsNullOrWhiteSpace(c.DepartmentName)
            && (names.Count == 0 || !string.Equals(names[0], c.DepartmentName, StringComparison.OrdinalIgnoreCase)))
            names.Insert(0, c.DepartmentName!);

        return string.Join(" › ", names);
    }

    // Eşleşen metni güvenli biçimde vurgula (HTML encode + <mark>)
    private MarkupString Highlight(string? text, string? query)
    {
        var t = text ?? "";
        var q = query?.Trim() ?? "";
        if (q.Length == 0) return (MarkupString)System.Net.WebUtility.HtmlEncode(t);

        var idx = t.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return (MarkupString)System.Net.WebUtility.HtmlEncode(t);

        var pre = System.Net.WebUtility.HtmlEncode(t.Substring(0, idx));
        var mid = System.Net.WebUtility.HtmlEncode(t.Substring(idx, q.Length));
        var post = System.Net.WebUtility.HtmlEncode(t.Substring(idx + q.Length));
        return (MarkupString)$"{pre}<mark style=\"background:#ffe08a;color:#000;padding:0 2px;border-radius:2px;\">{mid}</mark>{post}";
    }

