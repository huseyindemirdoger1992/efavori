    private bool _slugAuto = true;

    private async Task OnSlugInput(ChangeEventArgs e)
    {
        _product.UniqueNameSlug = e.Value?.ToString() ?? string.Empty;
        _slugAuto = false; // kullanıcı elle düzenledi
        await CheckSlugDebouncedAsync();
    }

    private async Task RegenerateSlug()
    {
        _product.UniqueNameSlug = Slugify(_product.Name ?? "");
        _slugAuto = true;
        await CheckSlugDebouncedAsync();
    }

    // Slug'ı yazma durduktan yarım saniye sonra DB'de kontrol et
    private async Task CheckSlugDebouncedAsync()
    {
        _slugCheckCts?.Cancel();
        _slugCheckCts = new CancellationTokenSource();
        var token = _slugCheckCts.Token;

        var slug = _product.UniqueNameSlug?.Trim();
        if (string.IsNullOrWhiteSpace(slug))
        {
            _slugState = SlugState.None;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _slugState = SlugState.Checking;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(500, token);
            if (token.IsCancellationRequested) return;

            var taken = await SlugExistsAsync(slug, token);
            if (token.IsCancellationRequested) return;

            _slugState = taken ? SlugState.Taken : SlugState.Available;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
        catch (Exception ex) { await LogError("CheckSlug", ex); }
    }

    private async Task<bool> SlugExistsAsync(string slug, CancellationToken token)
    {
        await using var db = await DbFactory.CreateDbContextAsync(token);
        return await db.ProductCreateRequest.AsNoTracking()
            .AnyAsync(p => p.UniqueNameSlug == slug
                        && (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu == null || p.IsDeleted.IsDeletedStatu == false),
                      token);
    }

    private static string Slugify(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        var s = input.Trim().ToLowerInvariant()
            .Replace("ı", "i").Replace("ğ", "g").Replace("ü", "u")
            .Replace("ş", "s").Replace("ö", "o").Replace("ç", "c").Replace("â", "a");
        var sb = new StringBuilder();
        foreach (var ch in s)
        {
            if (char.IsLetterOrDigit(ch)) sb.Append(ch);
            else if (ch is ' ' or '-' or '_' or '/' or '.') sb.Append('-');
        }
        return Regex.Replace(sb.ToString(), "-+", "-").Trim('-');
    }

