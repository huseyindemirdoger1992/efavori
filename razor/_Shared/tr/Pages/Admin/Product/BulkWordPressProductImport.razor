    // ════════════════════════ SİSTEM REFERANSLARI ════════════════════════
    private async Task LoadSystemReferences()
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        _systemCategories = await db.CategoriesTr.AsNoTracking().OrderBy(c => c.DepartmentName).ThenBy(c => c.Name).ToListAsync(_cts.Token);
        _systemBrands = await db.Brands.AsNoTracking()
            .Where(b => (b.UserId == null || b.UserId == _currentJob.UserId) && (b.IsDeleted == null || b.IsDeleted.IsDeletedStatu != true))
            .OrderBy(b => b.Name).ToListAsync(_cts.Token);
