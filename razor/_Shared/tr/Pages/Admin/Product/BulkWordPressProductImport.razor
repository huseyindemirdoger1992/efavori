    // ════════════════════════ HAFIZA: önceki eşleşmeleri uygula ════════════════════════
    private async Task ApplyRememberedMappings(string type, List<ProductImportMappings> working)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var remembered = await db.ProductImportMappings.AsNoTracking()
                .Where(m => m.StoreId == _currentJob.StoreId && m.MappingType == type
                            && m.IsConfirmedByUser && (m.IsDeleted == null || m.IsDeleted.IsDeletedStatu != true))
                .ToListAsync(_cts.Token);
            var byHash = remembered.GroupBy(m => m.SourceKeyHash).ToDictionary(g => g.Key!, g => g.First());
            foreach (var w in working)
            {
                if (w.SourceKeyHash != null && byHash.TryGetValue(w.SourceKeyHash, out var prev))
                {
                    w.TargetValue = prev.TargetValue;
                    w.TargetDisplayName = prev.TargetDisplayName;
                    w.IsConfirmedByUser = true;
                    w.ConfidenceLevel = "Exact"; // hafızadan geldi → tekrar sorma
                }
            }
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "ApplyRememberedMappings", exception: ex.Message, stackTrace: ex.StackTrace);
        }
    }

    // ════════════════════════ KALICILIK (job + mappings) ════════════════════════
    private async Task PersistJobAndMappings()
    {
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            _currentJob.FieldMappingJson = JsonSerializer.Serialize(
                _fieldMappings.Where(m => !string.IsNullOrEmpty(m.TargetValue))
                    .ToDictionary(m => m.SourceKey!, m => m.TargetValue!));
            _currentJob.AnalysisReportJson = JsonSerializer.Serialize(_analysisReport);
            _currentJob.TotalCount = _csvRows.Count;
            _currentJob.Status = "Ready";
            _currentJob.UpdatedAt = DateTime.UtcNow;

            var exists = await db.ProductImportJobs.AnyAsync(j => j.Id == _currentJob.Id, _cts.Token);
            if (exists) db.ProductImportJobs.Update(_currentJob);
            else db.ProductImportJobs.Add(_currentJob);

            // Tekrar kaydedilebilirlik: bu job'a ait eski Category/Brand eşleşmelerini temizle,
            // böylece job yeniden açılıp kaydedildiğinde çift kayıt birikmez (yeni seçimler geçerli olur).
            var oldMaps = await db.ProductImportMappings
                .Where(m => m.JobId == _currentJob.Id && (m.MappingType == "Category" || m.MappingType == "Brand"))
                .ToListAsync(_cts.Token);
            if (oldMaps.Any()) db.ProductImportMappings.RemoveRange(oldMaps);

            // Eşleşmeleri (Category + Brand) hafızaya yaz — sonraki aktarımlarda yeniden kullanılır
            var allMaps = _categoryMappings.Concat(_brandMappings)
                .Where(m => m.IsConfirmedByUser && !string.IsNullOrEmpty(m.TargetValue));
            foreach (var m in allMaps)
            {
                m.UpdatedAt = DateTime.UtcNow;
                db.ProductImportMappings.Add(new ProductImportMappings
                {
                    JobId = _currentJob.Id,
                    UserId = _currentJob.UserId,
                    StoreId = _currentJob.StoreId,
                    MappingType = m.MappingType,
                    SourceKey = m.SourceKey,
                    SourceKeyHash = m.SourceKeyHash,
                    SourceParentKey = m.SourceParentKey,
                    SourceItemCount = m.SourceItemCount,
                    TargetType = m.TargetType,
                    TargetValue = m.TargetValue,
                    TargetDisplayName = m.TargetDisplayName,
                    ConfidenceLevel = m.ConfidenceLevel,
                    ConfidenceScore = m.ConfidenceScore,
                    IsConfirmedByUser = true,
                    CreateIfMissing = m.CreateIfMissing,
                    CreatedAt = DateTime.UtcNow
                });
            }
            await db.SaveChangesAsync(_cts.Token);
            await StateHub.NotifyDataChanged("ProductImportJobs");
        }
        finally { _writeLock.Release(); }
    }

    // ════════════════════════ SATIR HAZIRLAMA (idempotent) ════════════════════════
    private async Task PrepareRows()
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var already = await db.ProductImportRows.AnyAsync(r => r.JobId == _currentJob.Id, _cts.Token);
        if (already) return; // zaten hazırlanmış → tekrar oluşturma (idempotent)

        var rows = new List<ProductImportRows>();
        for (int i = 0; i < _csvRows.Count; i++)
        {
            var r = _csvRows[i];
            var raw = new Dictionary<string, string>();
            for (int c = 0; c < _csvHeaders.Count && c < r.Length; c++) raw[_csvHeaders[c]] = r[c];

            rows.Add(new ProductImportRows
            {
                JobId = _currentJob.Id,
                UserId = _currentJob.UserId,
                StoreId = _currentJob.StoreId,
                SourceRowIndex = i,
                SourceExternalId = Col(r, "Kimlik"),
                SourceSku = Col(r, "Stok kodu (SKU)"),
                ParentExternalId = Col(r, "Ebeveyn"),
                SourceProductType = string.IsNullOrEmpty(Col(r, "Tür")) ? "simple" : Col(r, "Tür"),
                RowStatus = "Pending",
                RawRowJson = JsonSerializer.Serialize(raw),
                CreatedAt = DateTime.UtcNow
            });

            if (rows.Count >= 1000) { await db.ProductImportRows.AddRangeAsync(rows, _cts.Token); await db.SaveChangesAsync(_cts.Token); rows.Clear(); }
        }
        if (rows.Any()) { await db.ProductImportRows.AddRangeAsync(rows, _cts.Token); await db.SaveChangesAsync(_cts.Token); }
    }

    // ════════════════════════ ÇALIŞTIRMA MOTORU ════════════════════════
    private async Task RunImport()
    {
        if (_isRunning) return;
        _isRunning = true;
        _pauseRequested = false; _cancelRequested = false;
        _liveLog.Clear(); _currentProcessingName = null;   // canlı akış tamponunu sıfırla

        try
        {
            // Çalışma anı sözlüklerini RAM'e al (kategori/marka hızlı arama)
            await BuildRuntimeLookups();

            _currentJob.Status = "Running";
            _currentJob.StartedAt ??= DateTime.UtcNow;
            await UpdateJobStatus("Running");
            await InvokeAsync(StateHasChanged);

            while (!_cancelRequested && !_pauseRequested)
            {
                var processed = await ProcessNextBatch();
                await InvokeAsync(StateHasChanged);
                if (processed == 0)
                {
                    await PersistCountersFromDb();                 // bitişte kesin senkron
                    await UpdateJobStatus("Completed", DateTime.UtcNow);
                    var msg = $"{_currentJob.ImportedCount} aktarıldı, {_currentJob.SkippedCount} atlandı (yinelenen), {_currentJob.FailedCount} hata.";
                    await ShowNotification(_currentJob.FailedCount > 0 ? "warning" : "success", "İçe Aktarım Tamamlandı", msg, null);
                    break;
                }
                await Task.Yield(); // circuit'in nefes alması için
            }

            if (_cancelRequested) await UpdateJobStatus("Cancelled", DateTime.UtcNow);
            else if (_pauseRequested) await UpdateJobStatus("Paused");
        }
        catch (Exception ex)
        {
            _currentJob.LastErrorMessage = ex.Message;
            await UpdateJobStatus("Failed", DateTime.UtcNow);
            await Logger.TakeIt(use?.Id, PAGE, "RunImport", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "İçe aktarım durdu: " + ex.Message, null);
        }
        finally { _isRunning = false; await InvokeAsync(StateHasChanged); }
    }

    private void PauseImport() => _pauseRequested = true;

    private async Task CancelImport()
    {
        _cancelRequested = true;
        if (_currentJob.Status != "Running") await UpdateJobStatus("Cancelled", DateTime.UtcNow);
    }

    private async Task RetryFailed()
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var failed = await db.ProductImportRows.Where(r => r.JobId == _currentJob.Id && r.RowStatus == "Failed").ToListAsync(_cts.Token);
        foreach (var f in failed) { f.RowStatus = "Pending"; f.ErrorCode = null; f.ErrorMessage = null; }
        await db.SaveChangesAsync(_cts.Token);
        _currentJob.FailedCount = 0;
        await UpdateJobStatus("Ready");
        await RunImport();
    }

    // Tek batch işle → işlenen satır sayısını döndür (0 = bitti)
    private async Task<int> ProcessNextBatch()
    {
        List<ProductImportRows> batch;
        await using (var db = await DbFactory.CreateDbContextAsync(_cts.Token))
        {
            batch = await db.ProductImportRows
                .Where(r => r.JobId == _currentJob.Id && r.RowStatus == "Pending")
                .OrderBy(r => r.SourceRowIndex)
                .Take(Math.Max(50, _currentJob.BatchSize))
                .ToListAsync(_cts.Token);
        }
        if (!batch.Any()) return 0;

        foreach (var row in batch)
        {
            if (_cancelRequested || _pauseRequested) break;

            // 1) "Şu an işleniyor" — satır işlenmeden ÖNCE ekrana yansıt (görsel indirme uzun sürebilir)
            _currentProcessingName = RowName(row);
            await InvokeAsync(StateHasChanged);

            // 2) Satırı işle (kendi transaction'ı içinde)
            await ProcessRow(row);
            _currentJob.LastProcessedRowIndex = row.SourceRowIndex;

            // 3) Bellekte canlı sayaç + akış listesi (her satırda DB GroupBy yapmadan)
            BumpCounter(row.RowStatus);
            _liveLog.Insert(0, new LiveItem
            {
                ExternalId = row.SourceExternalId,
                Name = _currentProcessingName,
                Status = row.RowStatus ?? "Pending",
                Error = row.ErrorCode
            });
            if (_liveLog.Count > 50) _liveLog.RemoveAt(_liveLog.Count - 1);

            // 4) Her satırda UI'ı tazele → ilerleme çubuğu ve liste canlı hareket eder
            await InvokeAsync(StateHasChanged);

            // 5) Her 25 satırda bir sayaçları DB gerçeğiyle bağdaştır + ilerlemeyi kalıcılaştır
            if ((row.SourceRowIndex + 1) % 25 == 0) await PersistCountersFromDb();
        }

        _currentProcessingName = null;
        await PersistCountersFromDb();                       // batch sonu kesin senkron
        await RefreshErrorRows();
        await InvokeAsync(StateHasChanged);
        return batch.Count;
    }

    // İşlenen satırın ürün adını ham CSV verisinden okur (canlı gösterim için)
    private string RowName(ProductImportRows row)
    {
        try
        {
            var raw = JsonSerializer.Deserialize<Dictionary<string, string>>(row.RawRowJson ?? "{}");
            if (raw != null && raw.TryGetValue("İsim", out var n) && !string.IsNullOrWhiteSpace(n)) return n.Trim();
        }
        catch { }
        return row.SourceSku ?? row.SourceExternalId ?? $"Satır {row.SourceRowIndex}";
    }

    // Bellekte anlık sayaç artışı (PersistCountersFromDb ile periyodik olarak bağdaştırılır)
    private void BumpCounter(string? status)
    {
        switch (status)
        {
            case "Imported": _currentJob.ImportedCount++; break;
            case "Failed": _currentJob.FailedCount++; break;
            case "Skipped":
            case "Duplicate": _currentJob.SkippedCount++; break;
        }
        var done = _currentJob.ImportedCount + _currentJob.FailedCount;
        _currentJob.SuccessRate = done > 0 ? Math.Round((decimal)_currentJob.ImportedCount / done * 100m, 1) : 0m;
    }

    // Canlı durum rozetleri
    private string LiveBadge(string s) => s switch
