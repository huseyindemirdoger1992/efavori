@using api
@using api.tr
@using data
@using data._Product
@using data._Product.BulkWordPressProductImport
@using Data
@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Text
@using System.Text.Json
@using System.Security.Cryptography
@using System.Globalization
@using razor._Shared
@using razor._Shared.tr.Media

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
@inject FileUploadService FileService
@inject api.tr.Media MediaProcessor
@inject IHttpClientFactory HttpFactory
@inject NavigationManager NavigationManager

@implements IAsyncDisposable

@*
    ════════════════════════════════════════════════════════════════════════════
    WOOCOMMERCE → EFAVORI ÜRÜN İÇE AKTARIM SİHİRBAZI  (Tek dosya)
    --------------------------------------------------------------------------
    • Kaynak CSV galeriden seçilir (SourceMediaId hafızası).
    • Alan / Kategori / Marka / Özellik eşleşmeleri güven seviyeli olarak yapılır
      ve ProductImportMappings tablosunda HAFIZADA tutulur (tekrar sorulmaz).
    • İçe aktarım batch + transaction + idempotent + KALDIĞI YERDEN DEVAM eder
      (ProductImportRows satır kursoru + ProductImportJobs.LastProcessedRowIndex).
    • Görseller, mevcut Media.cs (AVIF) hattıyla işlenir — yeni medya sistemi yok.
    ════════════════════════════════════════════════════════════════════════════
*@

<Notification @ref="notificationRef" />

@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-globe", "efavori", "/"),
        ("fa fa-cubes", "Ürün Yönetimi", "javascript:void(0)"),
        ("fa fa-cloud-upload", "İçe Aktarım", "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads=roads />

<div class="container-fluid py-3">

    @* ═══════════════ ÜST BAŞLIK + ADIM GÖSTERGESİ ═══════════════ *@
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        @if (_currentStep > 0)
        {
            <button type="button" class="btn btn-outline-light btn-sm" @onclick="BackToDashboard">
                <i class="fa fa-th-list me-1"></i>Panele Dön
            </button>
        }
    </div>

    @if (_currentStep > 0)
    {
        <ul class="nav nav-pills nav-fill mb-4 small bg-light rounded p-1 shadow-sm">
            @foreach (var s in _stepTitles)
            {
                var idx = s.Key;
                var cls = idx == _currentStep ? "active fw-bold" : (idx < _currentStep ? "text-success" : "text-light");
                <li class="nav-item">
                    <span class="nav-link @cls py-1">
                        @if (idx < _currentStep)
                        {
                            <i class="fa fa-check-circle me-1"></i>
                        }
                        @s.Value
                    </span>
                </li>
            }
        </ul>
    }

    @* ════════════════════════════════════════════════════════════════════════
       ADIM 0 — DASHBOARD (Aktarım İşleri + İstatistik Paneli)
       ════════════════════════════════════════════════════════════════════ *@
    @if (_currentStep == 0)
    {
        <div class="d-flex justify-content-end mb-3">
            <button type="button" class="btn btn-primary btn-sm" @onclick="StartNewImport" style="width:100%">
                <i class="fa fa-plus me-1"></i>Yeni İçe Aktarım
            </button>
        </div>

        @if (_isLoading)
        {
            <p class="text-light"><i class="fa fa-spinner fa-spin me-2"></i>Yükleniyor...</p>
        }
        else if (_jobs is null || !_jobs.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center text-light py-5">
                    <i class="fa fa-inbox fa-3x mb-3 d-block opacity-50"></i>
                    Henüz bir içe aktarım oluşturulmadı. "Yeni İçe Aktarım" ile başlayın.
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var job in _jobs)
                {
                    var pending = Math.Max(0, job.TotalCount - job.ImportedCount - job.FailedCount - job.SkippedCount);
                    <div class="col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-bold mb-0 text-truncate" title="@job.Name">@job.Name</h6>
                                    <span class="badge @StatusBadgeClass(job.Status)">
                                        <i class="fa @StatusIcon(job.Status) me-1"></i>@StatusText(job.Status)
                                    </span>
                                </div>
                                <div class="small text-light mb-2">
                                    <i class="fa fa-calendar-o me-1"></i>@(job.CreatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                </div>

                                @* İstatistik paneli *@
                                <div class="row text-center g-1 mb-3">
                                    <div class="col"><div class="border rounded py-1"><div class="fw-bold">@job.TotalCount</div><div class="text-light" style="font-size:.65rem;">Toplam</div></div></div>
                                    <div class="col"><div class="border rounded py-1 bg-success-subtle"><div class="fw-bold text-success">@job.ImportedCount</div><div class="text-light" style="font-size:.65rem;">Aktarılan</div></div></div>
                                    <div class="col"><div class="border rounded py-1 bg-warning-subtle"><div class="fw-bold text-warning">@pending</div><div class="text-light" style="font-size:.65rem;">Bekleyen</div></div></div>
                                    <div class="col"><div class="border rounded py-1 bg-secondary-subtle"><div class="fw-bold text-secondary">@job.SkippedCount</div><div class="text-light" style="font-size:.65rem;">Atlandı</div></div></div>
                                    <div class="col"><div class="border rounded py-1 bg-danger-subtle"><div class="fw-bold text-danger">@job.FailedCount</div><div class="text-light" style="font-size:.65rem;">Hatalı</div></div></div>
                                </div>

                                <div class="progress mb-1" style="height:6px;">
                                    <div class="progress-bar bg-success" style="width:@(ProgressPercent(job))%"></div>
                                </div>
                                <div class="d-flex justify-content-between small text-light mb-3">
                                    <span>Başarı Oranı</span>
                                    <span class="fw-bold">%@job.SuccessRate.ToString("0.0")</span>
                                </div>

                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-outline-primary btn-sm flex-fill" @onclick="() => OpenJob(job)">
                                        <i class="fa fa-folder-open-o me-1"></i>Aç
                                    </button>
                                    @if (job.Status == "Running" || job.Status == "Paused")
                                    {
                                        <button type="button" class="btn btn-outline-success btn-sm" title="Devam Et" @onclick="() => ResumeJob(job)">
                                            <i class="fa fa-play"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-danger btn-sm" title="Sil" @onclick="() => DeleteJob(job)">
                                        <i class="fa fa-trash-o"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* ════════════════════════════════════════════════════════════════════════
       ADIM 1 — KAYNAK CSV (Galeriden Seç)
       ════════════════════════════════════════════════════════════════════ *@
    @if (_currentStep == 1)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-file-excel-o me-2 text-success"></i>1. Kaynak CSV Dosyası</h6>
                <div class="mb-3">
                    <label class="form-label">İçe Aktarım Adı</label>
                    <input class="form-control" @bind="_currentJob.Name" placeholder="Örn: Başer Elektrik - Aralık Aktarımı" />
                </div>

                <label class="form-label">WooCommerce Dışa Aktarım CSV'si</label>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <button type="button" class="btn btn-outline-primary"
                            data-bs-toggle="modal" data-bs-target="#modalCsvSource"
                            @onclick='() => _activeMediaSlot = "csvSource"'>
                        <i class="fa fa-picture-o me-1"></i>Galeriden CSV Seç
                    </button>
                    @if (_sourceCsvMedia is not null)
                    {
                        <span class="badge bg-success-subtle text-success p-2">
                            <i class="fa fa-file-text-o me-1"></i>@_sourceCsvMedia.FileName
                        </span>
                    }
                </div>

                @if (_analysisReport is not null)
                {
                    <hr />
                    <h6 class="fw-bold mb-2"><i class="fa fa-search me-2 text-info"></i>CSV Analiz Raporu (AŞAMA 1)</h6>
                    <div class="row text-center g-2 mb-3">
                        <div class="col"><div class="border rounded py-2"><div class="fw-bold fs-5">@_analysisReport.ColumnCount</div><div class="small text-light">Kolon</div></div></div>
                        <div class="col"><div class="border rounded py-2"><div class="fw-bold fs-5">@_analysisReport.RowCount</div><div class="small text-light">Ürün Satırı</div></div></div>
                        <div class="col"><div class="border rounded py-2"><div class="fw-bold fs-5">@_analysisReport.DistinctCategoryCount</div><div class="small text-light">Kategori</div></div></div>
                        <div class="col"><div class="border rounded py-2"><div class="fw-bold fs-5">@_analysisReport.DistinctBrandCount</div><div class="small text-light">Marka</div></div></div>
                        <div class="col"><div class="border rounded py-2"><div class="fw-bold fs-5">@_analysisReport.MetaColumnCount</div><div class="small text-light">Özel (Meta)</div></div></div>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var t in _analysisReport.TypeCounts)
                        {
                            <span class="badge bg-secondary-subtle text-dark">@t.Key: @t.Value</span>
                        }
                    </div>
                }
            </div>
            <div class="card-footer bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-primary" disabled="@(_sourceCsvMedia is null || _isProcessing)" @onclick="GoToFieldMapping">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i>
                    }
                    else
                    {

                        <i class="fa fa-arrow-right me-1"></i>
                    }
                    Alan Eşleştirmeye Geç
                </button>
            </div>
        </div>
    }

    @* ════════════════════════════════════════════════════════════════════════
       ADIM 2 — ALAN EŞLEŞTİRME (Güven seviyeli)
       ════════════════════════════════════════════════════════════════════ *@
    @if (_currentStep == 2)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-random me-2 text-primary"></i>2. Alan Eşleştirme (AŞAMA 2)</h6>
                <p class="small text-light">Otomatik eşleşmeler güven seviyesiyle işaretlendi. <span class="badge bg-danger">Belirsiz</span> olanları kontrol edin.</p>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>WooCommerce Kolonu</th>
                                <th style="width:40px;"></th>
                                <th>Sistem Alanı</th>
                                <th style="width:130px;">Güven</th>
                                <th style="width:90px;" class="text-center">Aktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _fieldMappings)
                            {
                                <tr class="@(m.ConfidenceLevel == "Uncertain" ? "table-warning" : "")">
                                    <td class="small fw-semibold">@m.SourceKey</td>
                                    <td class="text-center text-light"><i class="fa fa-arrow-right"></i></td>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="m.TargetValue">
                                            <option value="">— Aktarma —</option>
                                            @foreach (var f in _systemFields)
                                            {
                                                <option value="@f.Key">@f.Value</option>
                                            }
                                        </select>
                                    </td>
                                    <td><span class="badge @ConfidenceBadge(m.ConfidenceLevel)">@ConfidenceText(m.ConfidenceLevel)</span></td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input"
                                               checked="@(!string.IsNullOrEmpty(m.TargetValue))" disabled />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-light" @onclick="() => _currentStep = 1"><i class="fa fa-arrow-left me-1"></i>Geri</button>
                <button type="button" class="btn btn-primary" disabled="@_isProcessing" @onclick="GoToCategoryMapping">
                    <i class="fa fa-arrow-right me-1"></i>Kategori Eşleştirmeye Geç
                </button>
            </div>
        </div>
    }

    @* ════════════════════════════════════════════════════════════════════════
       ADIM 3 — KATEGORİ EŞLEŞTİRME (Ağaç + Sayım + Akıllı Öneri + Hafıza)
       ════════════════════════════════════════════════════════════════════ *@
    @if (_currentStep == 3)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-sitemap me-2 text-warning"></i>3. Kategori Eşleştirme (AŞAMA 3)</h6>
                <p class="small text-light">Her WooCommerce kategorisini sistem kategorinizle eşleyin. Onaylanan eşleşmeler hafızaya alınır, tekrar sorulmaz.</p>
                <div class="table-responsive" style="max-height:480px;overflow:auto;">
                    <table class="table table-sm align-middle">
                        <thead class="table-light position-sticky top-0">
                            <tr>
                                <th>WooCommerce Kategori Yolu</th>
                                <th style="width:90px;" class="text-center">Ürün</th>
                                <th style="width:280px;">Sistem Kategorisi</th>
                                <th style="width:110px;" class="text-center">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _categoryMappings.OrderByDescending(x => x.SourceItemCount))
                            {
                                <tr>
                                    <td class="small">
                                        <i class="fa fa-folder-o me-1 text-warning"></i>@c.SourceKey
                                        @if (!string.IsNullOrEmpty(c.SuggestionsJson))
                                        {
                                            <div class="small text-light mt-1">
                                                <i class="fa fa-lightbulb-o me-1"></i>Öneri:
                                                @foreach (var sug in DeserializeSuggestions(c.SuggestionsJson))
                                                {
                                                    <span class="badge bg-light text-primary border me-1" style="cursor:pointer;"
                                                          @onclick="() => ApplySuggestion(c, sug)">@sug.Name</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center"><span class="badge bg-secondary">@c.SourceItemCount</span></td>
                                    <td>
                                        @if (_activeCatRow == c)
                                        {
                                            <div class="position-relative">
                                                <input class="form-control form-control-sm" placeholder="Kategori ara (en az 2 harf)..."
                                                       value="@_catSearch" @oninput="OnCatSearch" autofocus />
                                                <div class="border rounded mt-1 bg-light shadow-sm" style="max-height:220px;overflow:auto;">
                                                    @if (!_catResults.Any())
                                                    {
                                                        <div class="px-2 py-1 small text-light">@(_catSearch.Trim().Length < 2 ? "Aramak için yazın..." : "Sonuç yok")</div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var sc in _catResults)
                                                        {
                                                            <button type="button" class="dropdown-item small text-wrap py-1" @onclick="() => PickCat(c, sc)">
                                                                @(string.IsNullOrEmpty(sc.DepartmentName) ? sc.Name : sc.DepartmentName + " > " + sc.Name)
                                                            </button>
                                                        }
                                                        @if (_catHasMore)
                                                        {
                                                            <div class="px-2 py-1 small text-light fst-italic">Daha fazlası için aramayı daraltın…</div>
                                                        }
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-link btn-sm text-light p-0 mt-1" @onclick="CloseCatPicker"><i class="fa fa-times me-1"></i>Kapat</button>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(c.TargetValue))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success-subtle text-success text-wrap text-start">@CatDisplay(c)</span>
                                                <button type="button" class="btn btn-outline-light btn-sm py-0" @onclick="() => OpenCatPicker(c)">Değiştir</button>
                                                <button type="button" class="btn btn-outline-danger btn-sm py-0" title="Temizle" @onclick="() => ClearCat(c)"><i class="fa fa-times"></i></button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OpenCatPicker(c)"><i class="fa fa-search me-1"></i>Kategori Seç</button>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (c.IsConfirmedByUser)
                                        {
                                            <span class="badge bg-success"><i class="fa fa-check"></i></span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Bekliyor</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-light" @onclick="() => _currentStep = 2"><i class="fa fa-arrow-left me-1"></i>Geri</button>
                <button type="button" class="btn btn-primary" @onclick="GoToBrandMapping"><i class="fa fa-arrow-right me-1"></i>Marka Eşleştirmeye Geç</button>
            </div>
        </div>
    }

    @* ════════════════════════════════════════════════════════════════════════
       ADIM 4 — MARKA EŞLEŞTİRME (AŞAMA 4)
       ════════════════════════════════════════════════════════════════════ *@
    @if (_currentStep == 4)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-trademark me-2 text-info"></i>4. Marka Eşleştirme (AŞAMA 4)</h6>
                @if (!_brandMappings.Any())
                {
                    <p class="text-light"><i class="fa fa-info-circle me-1"></i>CSV'de marka alanı bulunamadı, bu adım atlanabilir.</p>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead class="table-light"><tr><th>WooCommerce Marka</th><th style="width:90px;" class="text-center">Ürün</th><th style="width:280px;">Sistem Markası</th><th style="width:140px;">İşlem</th></tr></thead>
                        <tbody>
                            @foreach (var b in _brandMappings)
                            {
                                <tr>
                                    <td class="small fw-semibold">@b.SourceKey</td>
                                    <td class="text-center"><span class="badge bg-secondary">@b.SourceItemCount</span></td>
                                    <td>
                                        @if (_activeBrandRow == b)
                                        {
                                            <div class="position-relative">
                                                <input class="form-control form-control-sm" placeholder="Marka ara..."
                                                       value="@_brandSearch" @oninput="OnBrandSearch" autofocus />
                                                <div class="border rounded mt-1 bg-light shadow-sm" style="max-height:200px;overflow:auto;">
                                                    @if (!_brandResults.Any())
                                                    {
                                                        <div class="px-2 py-1 small text-light">Sonuç yok</div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var sb in _brandResults)
                                                        {
                                                            <button type="button" class="dropdown-item small py-1" @onclick="() => PickBrand(b, sb)">@sb.Name</button>
                                                        }
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-link btn-sm text-light p-0 mt-1" @onclick="CloseBrandPicker"><i class="fa fa-times me-1"></i>Kapat</button>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(b.TargetValue))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success-subtle text-success">@(_systemBrands.FirstOrDefault(x => x.Id.ToString() == b.TargetValue)?.Name ?? b.TargetDisplayName)</span>
                                                <button type="button" class="btn btn-outline-light btn-sm py-0" @onclick="() => OpenBrandPicker(b)">Değiştir</button>
                                                <button type="button" class="btn btn-outline-danger btn-sm py-0" title="Temizle" @onclick="() => ClearBrand(b)"><i class="fa fa-times"></i></button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OpenBrandPicker(b)"><i class="fa fa-search me-1"></i>Marka Seç</button>
                                        }
                                    </td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" @bind="b.CreateIfMissing" />
                                            <label class="form-check-label small">Yoksa oluştur</label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-light" @onclick="() => _currentStep = 3"><i class="fa fa-arrow-left me-1"></i>Geri</button>
                <button type="button" class="btn btn-primary" @onclick="GoToStrategy"><i class="fa fa-arrow-right me-1"></i>Strateji Raporuna Geç</button>
            </div>
        </div>
    }

    @* ════════════════════════════════════════════════════════════════════════
       ADIM 5 — STRATEJİ RAPORU + ÖN İZLEME (AŞAMA 13)
       ════════════════════════════════════════════════════════════════════ *@
    @if (_currentStep == 5)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-clipboard me-2 text-success"></i>5. İçe Aktarım Strateji Raporu (AŞAMA 13)</h6>
                <div class="row g-3">
                    <div class="col-md-6"><div class="border rounded p-3"><div class="fw-bold mb-1"><i class="fa fa-random me-2 text-primary"></i>Alan Eşleşmesi</div><div class="small text-light">@_fieldMappings.Count(x => !string.IsNullOrEmpty(x.TargetValue)) / @_fieldMappings.Count kolon eşlendi</div></div></div>
                    <div class="col-md-6"><div class="border rounded p-3"><div class="fw-bold mb-1"><i class="fa fa-sitemap me-2 text-warning"></i>Kategori Eşleşmesi</div><div class="small text-light">@_categoryMappings.Count(x => x.IsConfirmedByUser) / @_categoryMappings.Count kategori onaylandı</div></div></div>
                    <div class="col-md-6"><div class="border rounded p-3"><div class="fw-bold mb-1"><i class="fa fa-trademark me-2 text-info"></i>Marka Eşleşmesi</div><div class="small text-light">@_brandMappings.Count(x => !string.IsNullOrEmpty(x.TargetValue) || x.CreateIfMissing) / @_brandMappings.Count marka hazır</div></div></div>
                    <div class="col-md-6"><div class="border rounded p-3"><div class="fw-bold mb-1"><i class="fa fa-picture-o me-2 text-success"></i>Görsel İşleme Planı</div><div class="small text-light">URL görseller indirilip Media.cs (AVIF) hattıyla işlenecek</div></div></div>
                </div>

                <hr />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small">Varsayılan Depo</label>
                        <select class="form-select form-select-sm" @bind="_currentJob.DefaultWarehouseId">
                            <option value="">— Seçiniz —</option>
                            @foreach (var w in _warehouses)
                            {
                                <option value="@w.Id">@(w.AddressInfo?.MapTitle ?? w.Id.ToString().Substring(0, 8))</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Para Birimi (CSV fiyatları)</label>
                        <select class="form-select form-select-sm" @bind="_currentJob.DefaultCurrency">
                            <option value="TRY">TRY (₺)</option>
                            <option value="USD">USD ($)</option>
                            <option value="EUR">EUR (€)</option>
                            <option value="AZN">AZN (₼)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Batch Boyutu</label>
                        <input type="number" class="form-control form-control-sm" @bind="_currentJob.BatchSize" min="50" max="2000" />
                    </div>
                </div>

                <div class="alert alert-info mt-3 small mb-0">
                    <i class="fa fa-shield me-1"></i>Aktarım <b>idempotent</b> çalışır: aynı satır iki kez işlenmez, yarıda kalırsa <b>kaldığı yerden devam</b> eder.
                </div>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-light" @onclick="() => _currentStep = 4"><i class="fa fa-arrow-left me-1"></i>Geri</button>
                <button type="button" class="btn btn-success" disabled="@_isProcessing" @onclick="GoToRun">
                    <i class="fa fa-rocket me-1"></i>Aktarımı Hazırla
                </button>
            </div>
        </div>
    }

    @* ════════════════════════════════════════════════════════════════════════
       ADIM 6 — ÇALIŞTIR (Batch + Pause/Resume/Cancel + Hata Logu)
       ════════════════════════════════════════════════════════════════════ *@
    @if (_currentStep == 6)
    {
        var pending = Math.Max(0, _currentJob.TotalCount - _currentJob.ImportedCount - _currentJob.FailedCount - _currentJob.SkippedCount);
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="fa fa-rocket me-2 text-success"></i>6. İçe Aktarım</h6>
                    <span class="badge @StatusBadgeClass(_currentJob.Status) fs-6">
                        <i class="fa @StatusIcon(_currentJob.Status) me-1"></i>@StatusText(_currentJob.Status)
                    </span>
                </div>

                @* İstatistik paneli *@
                <div class="row text-center g-2 mb-3">
                    <div class="col"><div class="border rounded py-3"><div class="fw-bold fs-4">@_currentJob.TotalCount</div><div class="small text-light">Toplam Ürün</div></div></div>
                    <div class="col"><div class="border rounded py-3 bg-success-subtle"><div class="fw-bold fs-4 text-success">@_currentJob.ImportedCount</div><div class="small text-light">Aktarılan</div></div></div>
                    <div class="col"><div class="border rounded py-3 bg-warning-subtle"><div class="fw-bold fs-4 text-warning">@pending</div><div class="small text-light">Bekleyen</div></div></div>
                    <div class="col"><div class="border rounded py-3 bg-secondary-subtle"><div class="fw-bold fs-4 text-secondary">@_currentJob.SkippedCount</div><div class="small text-light">Atlandı / Yinelenen</div></div></div>
                    <div class="col"><div class="border rounded py-3 bg-danger-subtle"><div class="fw-bold fs-4 text-danger">@_currentJob.FailedCount</div><div class="small text-light">Hatalı</div></div></div>
                    <div class="col"><div class="border rounded py-3 bg-info-subtle"><div class="fw-bold fs-4 text-info">%@_currentJob.SuccessRate.ToString("0.0")</div><div class="small text-light">Başarı Oranı</div></div></div>
                </div>

                @if (_currentJob.Status == "Completed" && _currentJob.SkippedCount > 0 && _currentJob.ImportedCount == 0)
                {
                    <div class="alert alert-secondary small d-flex align-items-center mb-3">
                        <i class="fa fa-info-circle me-2"></i>
                        <div>Bu CSV'deki ürünlerin tamamı (@_currentJob.SkippedCount adet) <b>daha önce aktarılmış</b> olduğu için yinelenen sayıldı ve atlandı. Tekrar aktarmak isterseniz önce ilgili ürünleri sistemden kaldırmanız gerekir.</div>
                    </div>
                }

                <div class="progress mb-3" style="height:14px;">
                    <div class="progress-bar progress-bar-striped @(_currentJob.Status == "Running" ? "progress-bar-animated" : "") bg-success"
                         style="width:@(ProgressPercent(_currentJob))%">
                        @(ProgressPercent(_currentJob))%
                    </div>
                </div>

                @* Şu an işlenen ürün *@
                @if (_currentJob.Status == "Running" && !string.IsNullOrEmpty(_currentProcessingName))
                {
                    <div class="alert alert-primary d-flex align-items-center py-2 mb-3">
                        <i class="fa fa-spinner fa-spin me-2"></i>
                        <div class="text-truncate">
                            <span class="fw-semibold">İşleniyor:</span> @_currentProcessingName
                            <span class="text-light small ms-2">(@(_currentJob.ImportedCount + _currentJob.FailedCount + _currentJob.SkippedCount)/@_currentJob.TotalCount)</span>
                        </div>
                    </div>
                }

                @* Kontroller *@
                <div class="d-flex gap-2 mb-3">
                    @if (_currentJob.Status == "Ready" || _currentJob.Status == "Paused")
                    {
                        <button type="button" class="btn btn-success" @onclick="RunImport"><i class="fa fa-play me-1"></i>@(_currentJob.Status == "Paused" ? "Devam Et" : "Başlat")</button>
                    }
                    @if (_currentJob.Status == "Running")
                    {
                        <button type="button" class="btn btn-warning" @onclick="PauseImport"><i class="fa fa-pause me-1"></i>Duraklat</button>
                    }
                    @if (_currentJob.Status == "Running" || _currentJob.Status == "Paused")
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="CancelImport"><i class="fa fa-stop me-1"></i>İptal Et</button>
                    }
                    @if (_currentJob.FailedCount > 0 && _currentJob.Status != "Running")
                    {
                        <button type="button" class="btn btn-outline-warning" @onclick="RetryFailed"><i class="fa fa-refresh me-1"></i>Hatalıları Tekrar Dene</button>
                    }
                </div>

                @* Canlı işlenen ürün akışı (en yeni üstte) *@
                @if (_liveLog.Any())
                {
                    <h6 class="fw-bold small mt-3"><i class="fa fa-list-ul me-2 text-primary"></i>İşlenen Ürünler (canlı)</h6>
                    <div class="table-responsive border rounded" style="max-height:320px;overflow:auto;">
                        <table class="table table-sm small mb-0 align-middle">
                            <thead class="table-light position-sticky top-0"><tr><th style="width:90px;">Kimlik</th><th>Ürün</th><th style="width:120px;">Durum</th></tr></thead>
                            <tbody>
                                @foreach (var li in _liveLog)
                                {
                                    <tr>
                                        <td class="text-light">@li.ExternalId</td>
                                        <td class="text-truncate" style="max-width:380px;" title="@li.Name">@li.Name</td>
                                        <td>
                                            <span class="badge @LiveBadge(li.Status)">
                                                <i class="fa @LiveIcon(li.Status) me-1"></i>@LiveText(li.Status)
                                            </span>
                                            @if (!string.IsNullOrEmpty(li.Error))
                                            {
                                                <span class="text-danger small ms-1">@li.Error</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* Hata logu (AŞAMA 12) *@
                @if (_errorRows.Any())
                {
                    <h6 class="fw-bold small mt-3"><i class="fa fa-exclamation-triangle me-2 text-danger"></i>Hata Raporu (@_errorRows.Count)</h6>
                    <div class="table-responsive" style="max-height:300px;overflow:auto;">
                        <table class="table table-sm small">
                            <thead class="table-light position-sticky top-0"><tr><th>Satır</th><th>Kimlik</th><th>Hata Kodu</th><th>Mesaj</th></tr></thead>
                            <tbody>
                                @foreach (var er in _errorRows)
                                {
                                    <tr>
                                        <td>@er.SourceRowIndex</td>
                                        <td>@er.SourceExternalId</td>
                                        <td><span class="badge bg-danger-subtle text-danger">@er.ErrorCode</span></td>
                                        <td class="text-light">@er.ErrorMessage</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ════════════════════════════════════════════════════════════════════════════
   PAYLAŞIMLI MEDYA MODALI — Kaynak CSV galeriden seçimi (SamplePage deseni)
   ════════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalCsvSource" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark border border-light-3">
            <div class="modal-header border-light-3">
                <h6 class="modal-title text-white"><i class="fa fa-file-excel-o me-2 text-success"></i>Kaynak CSV Dosyasını Seç</h6>
                <div class="btn-group shadow-sm border border-secondary rounded overflow-hidden" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 d-flex align-items-center justify-content-center"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran" style="padding: 0.5rem 0.75rem;">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="vr bg-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm border-0 d-flex align-items-center justify-content-center"
                            data-bs-dismiss="modal" @onclick="CloseMediaModal" style="padding: 0.5rem 0.75rem;">
                        <span class="btn-close btn-close-white" style="font-size: 0.65rem; padding: 0;"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <Upload use="use" />
                <hr class="border-light-3 my-3" />
                @if (_activeMediaSlot == "csvSource")
                {
                    <razor._Shared.tr.Media.List use="use" IsMultiSelect="false" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const string PAGE = "ProductImport";

    [Parameter] public Users? use { get; set; }
    [Parameter] public string? Language { get; set; }

    // ── Çekirdek altyapı (mimari standartları) ──
    private readonly CancellationTokenSource _cts = new();
    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _disposed, _isInitialized, _isLoading, _isProcessing;

    private Notification? notificationRef;

    // ── Sihirbaz durumu ──
    private int _currentStep = 0;
    private readonly Dictionary<int, string> _stepTitles = new()
    {
        { 1, "Kaynak CSV" }, { 2, "Alan Eşleştirme" }, { 3, "Kategori" },
        { 4, "Marka" }, { 5, "Strateji" }, { 6, "Aktarım" }
    };

    private List<ProductImportJobs> _jobs = new();
    private ProductImportJobs _currentJob = new();

    // ── Medya seçim state (SamplePage deseni) ──
    private string _activeMediaSlot = string.Empty;
    private Data.Media? _sourceCsvMedia;

    // ── CSV verisi (analiz + eşleştirme için bellek) ──
    private List<string> _csvHeaders = new();
    private List<string[]> _csvRows = new();
    private Dictionary<string, int> _headerIndex = new();
    private AnalysisReport? _analysisReport;

    // ── Eşleşme çalışma listeleri ──
    private List<ProductImportMappings> _fieldMappings = new();
    private List<ProductImportMappings> _categoryMappings = new();
    private List<ProductImportMappings> _brandMappings = new();

    // ── Sistem referansları ──
    private List<CategoriesTr> _systemCategories = new();
    private List<data._Product.Brands> _systemBrands = new();

    // ── Aranabilir kategori/marka seçici durumu (1300+ kategori için dropdown yerine) ──
    private ProductImportMappings? _activeCatRow;          // o an açık olan kategori satırı
    private string _catSearch = string.Empty;
    private List<CategoriesTr> _catResults = new();        // ekranda yalnızca filtrelenmiş ≤30 sonuç
    private bool _catHasMore;
    private ProductImportMappings? _activeBrandRow;        // o an açık olan marka satırı
    private string _brandSearch = string.Empty;
    private List<data._Product.Brands> _brandResults = new();
    private const int PickerLimit = 30;
    private List<data._Product.Warehouse> _warehouses = new();

    // ── Çalıştırma kontrol bayrakları ──
    private bool _pauseRequested, _cancelRequested;
    private bool _isRunning;                                 // çalıştırma reentrancy guard'ı
    private List<ProductImportRows> _errorRows = new();

    // ── Canlı çalışma geri bildirimi (ilerleme/şu an işlenen/akış listesi) ──
    private string? _currentProcessingName;                 // o an işlenen ürün adı
    private readonly List<LiveItem> _liveLog = new();       // son işlenenler (en yeni üstte, ~50 kayıt)
    private sealed class LiveItem
    {
        public string? ExternalId { get; set; }
        public string? Name { get; set; }
        public string Status { get; set; } = "Pending";
        public string? Error { get; set; }
    }

    // ── Çalışma anı hızlı sözlükleri (RAM) ──
    private Dictionary<string, int> _categoryLookup = new();   // pathHash → CategoriesTr.Id
    private Dictionary<string, Guid> _brandLookup = new();      // markaAdı(lower) → Brands.Id
    private Dictionary<string, string> _fieldLookup = new();    // kolon → hedef alan

    // Sistem alanı seçenekleri (UI dropdown)
    private readonly Dictionary<string, string> _systemFields = new()
    {
        { "", "— Aktarma —" },
        { "Name", "Ürün Adı (Name)" }, { "ShortDescription", "Kısa Açıklama" },
        { "FullDescription", "Detaylı Açıklama" }, { "Sku", "Stok Kodu (Sku)" },
        { "Barcode", "Barkod" }, { "Gtin", "GTIN/UPC/EAN/ISBN" },
        { "Price", "Normal Fiyat (Price)" }, { "DiscountedPrice", "İndirimli Fiyat" },
        { "Quantity", "Stok Adedi" }, { "StockStatus", "Stok Durumu" },
        { "WeightKg", "Ağırlık (kg)" }, { "LengthCm", "Uzunluk (cm)" },
        { "WidthCm", "Genişlik (cm)" }, { "HeightCm", "Yükseklik (cm)" },
        { "Categories", "Kategoriler" }, { "Tags", "Etiketler" },
        { "Images", "Görseller" }, { "Brand", "Marka" },
        { "PublishStatus", "Yayın Durumu" }, { "ExternalUrl", "Harici URL" },
        { "ExternalButtonText", "Harici Buton Metni" }, { "ExternalId", "Kaynak Kimlik (idempotency)" },
        { "ProductType", "Ürün Tipi" }, { "ParentExternalId", "Ebeveyn (varyasyon)" },
        { "Attribute", "Özellik/Attribute (bilgi dağarcığı)" }
    };

    // ════════════════════════ YAŞAM DÖNGÜSÜ ════════════════════════
    protected override void OnInitialized()
    {
        FileService.OnFileSelected += HandleSingleFileSelected;
    }

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;
        await LoadDashboard();
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || _currentStep != 0) return;
        if (entityName is "ProductImportJobs")
            await InvokeAsync(async () => { await LoadDashboard(); StateHasChanged(); });
    }

    private async Task LoadDashboard()
    {
        try
        {
            _isLoading = true; StateHasChanged();
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _jobs = await db.ProductImportJobs.AsNoTracking()
                .Where(j => j.StoreId == CurrentStoreId() && (j.IsDeleted == null || j.IsDeleted.IsDeletedStatu != true))
                .OrderByDescending(j => j.CreatedAt)
                .ToListAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadDashboard", exception: ex.Message, stackTrace: ex.StackTrace);
        }
        finally { _isLoading = false; StateHasChanged(); }
    }

    // Mağaza kimliği — gerçek projede use üzerinden aktif mağaza çözülür.
    private Guid CurrentStoreId() => _currentJob.StoreId != Guid.Empty ? _currentJob.StoreId : (use?.Id ?? Guid.Empty);

    // ════════════════════════ MEDYA SEÇİM (CSV) ════════════════════════
    private void HandleSingleFileSelected(Data.Media media)
    {
        if (_activeMediaSlot == "csvSource")
        {
            _sourceCsvMedia = media;
            _currentJob.SourceMediaId = media.Id;
            if (string.IsNullOrWhiteSpace(_currentJob.Name))
                _currentJob.Name = Path.GetFileNameWithoutExtension(media.FileName ?? "İçe Aktarım");
        }
        InvokeAsync(StateHasChanged);
    }

    private void CloseMediaModal() => _activeMediaSlot = string.Empty;

    // ════════════════════════ NAVİGASYON ════════════════════════
    private void BackToDashboard() { _currentStep = 0; _ = LoadDashboard(); }

    private void StartNewImport()
    {
        _currentJob = new ProductImportJobs
        {
            UserId = use?.Id ?? Guid.Empty,
            StoreId = use?.Id ?? Guid.Empty, // gerçek projede aktif Store.Id
            Status = "Draft",
            DefaultCurrency = "TRY",
            BatchSize = 500
        };
        _sourceCsvMedia = null; _analysisReport = null;
        _fieldMappings.Clear(); _categoryMappings.Clear(); _brandMappings.Clear();
        _csvHeaders.Clear(); _csvRows.Clear(); _errorRows.Clear();
        _currentStep = 1;
    }

    private async Task OpenJob(ProductImportJobs job)
    {
        if (_isProcessing) return;
        _isProcessing = true; StateHasChanged();
        try
        {
            await LoadJobIntoMemory(job.Id);   // job + media + referanslar + CSV (diskten)

            // Önceden yüklenmiş CSV varsa: analiz + alan eşleştirmeyi yeniden kur, önceki onaylı
            // seçimleri üzerine bindir → kullanıcı doğrudan "Alan Eşleştirme"den devam eder ve
            // yeniden işleyip ilerleyebilir. Yeni seçimler kaydedildiğinde güncellenir.
            if (_csvHeaders.Any())
            {
                await BuildAnalysisReport();           // AŞAMA 1
                BuildFieldMappings();                  // AŞAMA 2 (otomatik + güven)
                ApplySavedFieldMappings();             // daha önce kaydedilen alan seçimlerini geri getir
                await LoadSystemReferences();
                _currentStep = 2;                      // Alan Eşleştirme
            }
            else
            {
                _currentStep = 1;                      // CSV okunamadıysa kaynak adımına düş
            }
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "OpenJob", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Job açılırken sorun oluştu: " + ex.Message, null);
        }
        finally { _isProcessing = false; StateHasChanged(); }
    }

    // Daha önce kaydedilmiş alan eşleşmelerini (FieldMappingJson) otomatik tahminin üzerine bindirir.
    private void ApplySavedFieldMappings()
    {
        if (string.IsNullOrWhiteSpace(_currentJob.FieldMappingJson)) return;
        Dictionary<string, string>? saved;
        try { saved = JsonSerializer.Deserialize<Dictionary<string, string>>(_currentJob.FieldMappingJson); }
        catch { return; }
        if (saved is null) return;
        foreach (var m in _fieldMappings)
        {
            if (!string.IsNullOrEmpty(m.SourceKey) && saved.TryGetValue(m.SourceKey, out var tv) && !string.IsNullOrEmpty(tv))
            {
                m.TargetValue = tv;
                m.IsConfirmedByUser = true;
            }
        }
    }

    private async Task ResumeJob(ProductImportJobs job)
    {
        await LoadJobIntoMemory(job.Id);
        _currentStep = 6;
        await RunImport();
    }

    // ════════════════════════ ADIM GEÇİŞLERİ ════════════════════════
    private async Task GoToFieldMapping()
    {
        if (_isProcessing) return;
        _isProcessing = true; StateHasChanged();
        try
        {
            await LoadCsvFromMedia();          // diskten oku + parse
            await BuildAnalysisReport();       // AŞAMA 1
            BuildFieldMappings();              // AŞAMA 2 (otomatik + güven)
            await LoadSystemReferences();
            _currentStep = 2;
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "GoToFieldMapping", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "CSV okunurken bir sorun oluştu: " + ex.Message, null);
        }
        finally { _isProcessing = false; StateHasChanged(); }
    }

    private async Task GoToCategoryMapping()
    {
        BuildCategoryMappings();   // AŞAMA 3
        await ApplyRememberedMappings("Category", _categoryMappings);
        _currentStep = 3;
    }

    private async Task GoToBrandMapping()
    {
        BuildBrandMappings();      // AŞAMA 4
        await ApplyRememberedMappings("Brand", _brandMappings);
        _currentStep = 4;
    }

    private async Task GoToStrategy()
    {
        await LoadWarehouses();
        _currentStep = 5;
    }

    private async Task GoToRun()
    {
        if (_isProcessing) return;
        _isProcessing = true; StateHasChanged();
        try
        {
            await PersistJobAndMappings();   // job + tüm eşleşmeler DB'ye (hafıza)
            await PrepareRows();             // satırları oluştur (idempotent)
            _currentStep = 6;
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "GoToRun", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Hazırlık başarısız: " + ex.Message, null);
        }
        finally { _isProcessing = false; StateHasChanged(); }
    }

    // ════════════════════════ CSV OKUMA & PARSE ════════════════════════
    private async Task LoadCsvFromMedia()
    {
        if (_sourceCsvMedia is null) throw new InvalidOperationException("Kaynak CSV seçilmedi.");

        // Galerideki dosyanın fiziksel diskteki yolu (Media.cs ile aynı kök mantığı)
        var rel = (_sourceCsvMedia.OrjFileUrl ?? _sourceCsvMedia.FileUrl ?? string.Empty)
            .TrimStart('/').Replace('/', Path.DirectorySeparatorChar);
        var fullPath = Path.Combine(Directory.GetCurrentDirectory(), rel);
        if (!File.Exists(fullPath)) throw new FileNotFoundException("CSV dosyası bulunamadı: " + rel);

        var content = await File.ReadAllTextAsync(fullPath, Encoding.UTF8, _cts.Token);
        var (headers, rows) = ParseCsv(content);
        _csvHeaders = headers;
        _csvRows = rows;
        _headerIndex = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        for (int i = 0; i < headers.Count; i++) _headerIndex[headers[i].Trim()] = i;
    }

    // RFC-4180 uyumlu minimal CSV ayrıştırıcı (tırnak içi virgül/yeni satır/çift tırnak destekler)
    private (List<string> headers, List<string[]> rows) ParseCsv(string text)
    {
        var result = new List<string[]>();
        var field = new StringBuilder();
        var record = new List<string>();
        bool inQuotes = false;
        // BOM temizliği
        if (text.Length > 0 && text[0] == '\uFEFF') text = text.Substring(1);

        for (int i = 0; i < text.Length; i++)
        {
            char c = text[i];
            if (inQuotes)
            {
                if (c == '"')
                {
                    if (i + 1 < text.Length && text[i + 1] == '"') { field.Append('"'); i++; }
                    else inQuotes = false;
                }
                else field.Append(c);
            }
            else
            {
                if (c == '"') inQuotes = true;
                else if (c == ',') { record.Add(field.ToString()); field.Clear(); }
                else if (c == '\r') { /* yoksay */ }
                else if (c == '\n')
                {
                    record.Add(field.ToString()); field.Clear();
                    result.Add(record.ToArray()); record = new List<string>();
                }
                else field.Append(c);
            }
        }
        if (field.Length > 0 || record.Count > 0) { record.Add(field.ToString()); result.Add(record.ToArray()); }

        var headers = result.Count > 0 ? result[0].ToList() : new List<string>();
        var rows = result.Skip(1).Where(r => r.Any(c => !string.IsNullOrWhiteSpace(c))).ToList();
        return (headers, rows);
    }

    private string Col(string[] row, string header)
    {
        if (_headerIndex.TryGetValue(header.Trim(), out int idx) && idx < row.Length)
            return row[idx]?.Trim() ?? string.Empty;
        return string.Empty;
    }

    // ════════════════════════ AŞAMA 1 — ANALİZ ════════════════════════
    private Task BuildAnalysisReport()
    {
        var report = new AnalysisReport
        {
            ColumnCount = _csvHeaders.Count,
            RowCount = _csvRows.Count,
            MetaColumnCount = _csvHeaders.Count(h => h.StartsWith("Meta:", StringComparison.OrdinalIgnoreCase))
        };
        foreach (var r in _csvRows)
        {
            var t = Col(r, "Tür");
            if (string.IsNullOrEmpty(t)) t = "simple";
            report.TypeCounts[t] = report.TypeCounts.GetValueOrDefault(t) + 1;
        }
        report.DistinctCategoryCount = _csvRows
            .Select(r => PrimaryCategoryPath(Col(r, "Kategoriler")))
            .Where(p => !string.IsNullOrEmpty(p)).Distinct().Count();
        report.DistinctBrandCount = _csvRows
            .Select(r => Col(r, "Markalar")).Where(b => !string.IsNullOrEmpty(b)).Distinct().Count();
        _analysisReport = report;
        return Task.CompletedTask;
    }

    // ════════════════════════ AŞAMA 2 — ALAN EŞLEŞTİRME ════════════════════════
    private void BuildFieldMappings()
    {
        _fieldMappings = new List<ProductImportMappings>();
        foreach (var h in _csvHeaders)
        {
            var (target, level, score) = GuessField(h);
            _fieldMappings.Add(new ProductImportMappings
            {
                JobId = _currentJob.Id,
                UserId = _currentJob.UserId,
                StoreId = _currentJob.StoreId,
                MappingType = "Field",
                SourceKey = h,
                SourceKeyHash = Hash(h),
                TargetType = "ProductField",
                TargetValue = target,
                ConfidenceLevel = level,
                ConfidenceScore = score,
                IsConfirmedByUser = level == "Exact"
            });
        }
    }

    // Kesin / Büyük olasılıkla / Belirsiz güven seviyeli otomatik eşleştirme
    private (string target, string level, int score) GuessField(string header)
    {
        var h = header.Trim();
        switch (h)
        {
            case "İsim": return ("Name", "Exact", 100);
            case "Açıklama": return ("FullDescription", "Exact", 98);
            case "Kısa açıklama": return ("ShortDescription", "Exact", 98);
            case "Stok kodu (SKU)": return ("Sku", "Exact", 100);
            case "GTIN, UPC, EAN veya ISBN": return ("Gtin", "Likely", 85);
            case "Stok": return ("Quantity", "Exact", 95);
            case "Stokta?": return ("StockStatus", "Likely", 80);
            case "Ağırlık (kg)": return ("WeightKg", "Exact", 100);
            case "Uzunluk (cm)": return ("LengthCm", "Exact", 100);
            case "Genişlik (cm)": return ("WidthCm", "Exact", 100);
            case "Yükseklik (cm)": return ("HeightCm", "Exact", 100);
            case "Kategoriler": return ("Categories", "Exact", 100);
            case "Etiketler": return ("Tags", "Exact", 95);
            case "Görseller": return ("Images", "Exact", 100);
            case "Markalar": return ("Brand", "Exact", 95);
            case "Normal fiyat": return ("Price", "Likely", 88);
            case "İndirimli satış fiyatı": return ("DiscountedPrice", "Likely", 85);
            case "Kimlik": return ("ExternalId", "Exact", 100);
            case "Tür": return ("ProductType", "Exact", 100);
            case "Ebeveyn": return ("ParentExternalId", "Exact", 95);
            case "Yayımlanmış": return ("PublishStatus", "Likely", 75);
            case "Harici URL": return ("ExternalUrl", "Exact", 90);
            case "Düğme metni": return ("ExternalButtonText", "Exact", 90);
        }
        if (h.StartsWith("Öznitelik", StringComparison.OrdinalIgnoreCase) && h.Contains("değer"))
            return ("Attribute", "Likely", 70);
        // Geri kalanlar (Meta:* ve bilinmeyenler) → BELİRSİZ, kullanıcı onayı şart
        return ("", "Uncertain", 30);
    }

    // ════════════════════════ AŞAMA 3 — KATEGORİ ════════════════════════
    private string PrimaryCategoryPath(string categoriesCell)
    {
        if (string.IsNullOrWhiteSpace(categoriesCell)) return string.Empty;
        // WooCommerce hücresi: "A, B, A > B > C, A > B"  → en uzun (en derin) yolu birincil al
        var paths = categoriesCell.Split(',').Select(p => p.Trim()).Where(p => p.Length > 0);
        return paths.OrderByDescending(p => p.Count(ch => ch == '>')).ThenByDescending(p => p.Length).FirstOrDefault() ?? string.Empty;
    }

    private void BuildCategoryMappings()
    {
        var counts = new Dictionary<string, int>();
        foreach (var r in _csvRows)
        {
            var path = PrimaryCategoryPath(Col(r, "Kategoriler"));
            if (string.IsNullOrEmpty(path)) continue;
            counts[path] = counts.GetValueOrDefault(path) + 1;
        }
        _categoryMappings = counts.Select(kv => new ProductImportMappings
        {
            JobId = _currentJob.Id,
            UserId = _currentJob.UserId,
            StoreId = _currentJob.StoreId,
            MappingType = "Category",
            SourceKey = kv.Key,
            SourceKeyHash = Hash(kv.Key),
            SourceItemCount = kv.Value,
            TargetType = "CategoryId",
            ConfidenceLevel = "Unmapped",
            SuggestionsJson = JsonSerializer.Serialize(SuggestCategories(kv.Key))
        }).ToList();
    }

    // Akıllı öneri: yol son segmentini sistem kategori adlarıyla eşleştir
    private List<SuggestionDto> SuggestCategories(string path)
    {
        var leaf = path.Split('>').Last().Trim().ToLowerInvariant();
        return _systemCategories
            .Select(c => new { c, score = Similarity(leaf, (c.Name ?? "").ToLowerInvariant()) })
            .Where(x => x.score > 0).OrderByDescending(x => x.score).Take(3)
            .Select(x => new SuggestionDto { Id = x.c.Id.ToString(), Name = x.c.Name ?? "" }).ToList();
    }

    private int Similarity(string a, string b)
    {
        if (a == b) return 100;
        if (a.Contains(b) || b.Contains(a)) return 70;
        var wa = a.Split(' '); var wb = b.Split(' ');
        return wa.Intersect(wb).Count() * 25;
    }

    private void ApplySuggestion(ProductImportMappings c, SuggestionDto sug)
    {
        c.TargetValue = sug.Id; c.TargetDisplayName = sug.Name;
        c.IsConfirmedByUser = true; c.ConfidenceLevel = "Likely";
        StateHasChanged();
    }

    // ── Aranabilir KATEGORİ seçici (dropdown'da 1300 kayıt basmak yerine) ──
    private void OpenCatPicker(ProductImportMappings c)
    {
        CloseBrandPicker();
        _activeCatRow = c; _catSearch = string.Empty; _catResults = new(); _catHasMore = false;
    }
    private void CloseCatPicker() { _activeCatRow = null; _catSearch = string.Empty; _catResults = new(); _catHasMore = false; }

    private void OnCatSearch(ChangeEventArgs e)
    {
        _catSearch = e.Value?.ToString() ?? string.Empty;
        var q = _catSearch.Trim();
        if (q.Length < 2) { _catResults = new(); _catHasMore = false; return; }
        var nq = NormalizeTr(q);
        // 1300 kaydı bellekte filtrelemek mikro-saniyeler sürer; ekrana yalnızca ilk 30 basılır → UI kilitlenmez.
        var matches = _systemCategories.Where(c =>
            NormalizeTr(c.Name ?? "").Contains(nq) ||
            NormalizeTr(c.DepartmentName ?? "").Contains(nq));
        _catResults = matches.Take(PickerLimit).ToList();
        _catHasMore = _catResults.Count == PickerLimit && matches.Skip(PickerLimit).Any();
    }

    private void PickCat(ProductImportMappings c, CategoriesTr sc)
    {
        c.TargetValue = sc.Id.ToString();
        c.TargetDisplayName = string.IsNullOrEmpty(sc.DepartmentName) ? sc.Name : sc.DepartmentName + " > " + sc.Name;
        c.IsConfirmedByUser = true; c.ConfidenceLevel = "Exact";
        CloseCatPicker();
    }
    private void ClearCat(ProductImportMappings c)
    {
        c.TargetValue = null; c.TargetDisplayName = null;
        c.IsConfirmedByUser = false; c.ConfidenceLevel = "Unmapped";
    }
    private string CatDisplay(ProductImportMappings c)
    {
        if (!string.IsNullOrEmpty(c.TargetDisplayName)) return c.TargetDisplayName!;
        var sc = _systemCategories.FirstOrDefault(x => x.Id.ToString() == c.TargetValue);
        return sc == null ? "" : (string.IsNullOrEmpty(sc.DepartmentName) ? (sc.Name ?? "") : sc.DepartmentName + " > " + sc.Name);
    }

    // Türkçe karakterleri normalize ederek arama duyarlılığını artırır (İ/ı/ş/ğ/ü/ö/ç).
    private string NormalizeTr(string s)
    {
        var map = new Dictionary<char, char> { { 'ı', 'i' }, { 'ğ', 'g' }, { 'ü', 'u' }, { 'ş', 's' }, { 'ö', 'o' }, { 'ç', 'c' }, { 'İ', 'i' }, { 'â', 'a' }, { 'î', 'i' }, { 'û', 'u' } };
        var sb = new StringBuilder();
        foreach (var ch in s.ToLowerInvariant()) sb.Append(map.TryGetValue(ch, out var m) ? m : ch);
        return sb.ToString();
    }

    // ════════════════════════ AŞAMA 4 — MARKA ════════════════════════
    private void BuildBrandMappings()
    {
        var counts = new Dictionary<string, int>();
