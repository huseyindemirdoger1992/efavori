    // ── TEK SATIR → ÜRÜN (transaction + rollback) ──
    private async Task ProcessRow(ProductImportRows row)
    {
        // EnableRetryOnFailure açık olduğunda (SqlServerRetryingExecutionStrategy) manuel
        // transaction DOĞRUDAN açılamaz; execution strategy üzerinden çalıştırılmalıdır.
        // Aksi halde "does not support user-initiated transactions" hatası alınır.
        try
        {
            await using var stratDb = await DbFactory.CreateDbContextAsync(_cts.Token);
            var strategy = stratDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                // Her deneme TAZE context ile başlar → retry'de değişiklik takibi temiz kalır.
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                await using var tx = await db.Database.BeginTransactionAsync(_cts.Token);
                // 1) IDEMPOTENCY — bu Kimlik bu mağazada zaten aktarıldı mı?
                if (!string.IsNullOrEmpty(row.SourceExternalId))
                {
                    bool dup = await db.ProductImportRows.AnyAsync(r =>
                        r.StoreId == _currentJob.StoreId && r.SourceExternalId == row.SourceExternalId
                        && r.RowStatus == "Imported" && r.Id != row.Id, _cts.Token);
                    if (dup) { await MarkRow(db, row, "Duplicate", null, null); await tx.CommitAsync(_cts.Token); return; }
                }

                var raw = JsonSerializer.Deserialize<Dictionary<string, string>>(row.RawRowJson ?? "{}") ?? new();
                string G(string h) => raw.TryGetValue(h, out var v) ? (v ?? "").Trim() : "";

                var type = (row.SourceProductType ?? "simple").ToLowerInvariant();

                // Varyasyon → üst ürünü bul
                Guid parentProductId = Guid.Empty;
                if (type == "variation")
                {
                    var parentRow = await db.ProductImportRows.FirstOrDefaultAsync(r =>
                        r.JobId == _currentJob.Id && r.SourceExternalId == row.ParentExternalId
                        && r.CreatedProductId != null, _cts.Token);
                    if (parentRow?.CreatedProductId == null)
                    {
                        await MarkRow(db, row, "Failed", "OrphanVariation", "Üst ürün henüz oluşturulmadı.");
                        await tx.CommitAsync(_cts.Token); return;
                    }
                    parentProductId = parentRow.CreatedProductId.Value;
                }

                // 2) ÜRÜN (variation değilse yeni ürün oluştur)
                Guid productId = parentProductId;
                if (type != "variation")
                {
                    var product = new data._Product.Products
                    {
                        UserId = _currentJob.UserId,
                        StoreId = _currentJob.StoreId,
                        ProductType = type == "variable" ? "Variant" : (type == "external" ? "External" : "Simple"),
                        Name = G("İsim"),
                        ShortDescription = G("Kısa açıklama"),
                        FullDescription = G("Açıklama"),
                        Tags = G("Etiketler"),
                        ExternalUrl = G("Harici URL"),
                        ExternalButtonText = G("Düğme metni"),
                        PublishStatus = G("Yayımlanmış") == "1",
                        IsActive = true,
                        CreatedAt = DateTime.UtcNow
                    };
                    product.BrandId = ResolveBrand(G("Markalar"));
                    db.Products.Add(product);
                    productId = product.Id;

                    // Kategoriler
                    AddCategories(db, productId, G("Kategoriler"));
                    // SEO
                    AddSeo(db, productId, product.Name);
                    // Özellikler/Öznitelikler (bilgi dağarcığı) — WooCommerce "Öznitelik N adı/değeri" kolonları
                    AddSpecifications(db, productId, raw);
                }

                // 3) VARYANT (basit/varyasyon → fiyat & stok her zaman varyant üzerinden)
                var variant = new data._Product.ProductVariants
                {
                    ProductId = productId,
                    Sku = string.IsNullOrEmpty(G("Stok kodu (SKU)")) ? null : G("Stok kodu (SKU)"),
                    Gtin = G("GTIN, UPC, EAN veya ISBN"),
                    IsDefault = type != "variation",
                    IsActive = true,
                    WeightKg = ParseDec(G("Ağırlık (kg)")),
                    LengthCm = ParseDec(G("Uzunluk (cm)")),
                    WidthCm = ParseDec(G("Genişlik (cm)")),
                    HeightCm = ParseDec(G("Yükseklik (cm)")),
                    CreatedAt = DateTime.UtcNow
                };
                db.ProductVariants.Add(variant);

                // 4) FİYAT (append-only, EffectiveTo=null = güncel)
                var price = ParseDec(G("Normal fiyat"));
                if (price.HasValue)
                {
                    db.ProductPrices.Add(new data._Product.ProductPrices
                    {
                        ProductId = productId,
                        VariantId = variant.Id,
                        Currency = _currentJob.DefaultCurrency,
                        Price = price.Value,
                        DiscountedPrice = ParseDec(G("İndirimli satış fiyatı")),
                        EffectiveFrom = DateTime.UtcNow,
                        CreatedByUserId = _currentJob.UserId,
                        CreatedAt = DateTime.UtcNow
                    });
                }

                // 5) STOK
                if (_currentJob.DefaultWarehouseId.HasValue)
                {
                    int.TryParse(G("Stok"), out int qty);
                    db.ProductStocks.Add(new data._Product.ProductStocks
                    {
                        ProductId = productId,
                        VariantId = variant.Id,
                        WarehouseId = _currentJob.DefaultWarehouseId.Value,
                        Quantity = qty,
                        TrackStock = true,
                        StockStatus = MapStockStatus(G("Stokta?"), G("Ön Siparişe İzin Ver?")),
                        UpdatedAt = DateTime.UtcNow
                    });
                }

                await db.SaveChangesAsync(_cts.Token);

                // 6) GÖRSELLER (URL → Media.cs AVIF hattı → CoverMediaId + ItemGallery)
                if (type != "variation")
                    await ImportImages(db, productId, G("Görseller"), row);

                await db.SaveChangesAsync(_cts.Token);
                await MarkRow(db, row, "Imported", null, null, productId, variant.Id);
                await tx.CommitAsync(_cts.Token);
            }); // strategy.ExecuteAsync sonu
        }
        catch (Exception ex)
        {
            // Transaction commit edilmedi → dispose'da otomatik geri alındı. Hatayı satıra işle.
            await using var edb = await DbFactory.CreateDbContextAsync(_cts.Token);
            await MarkRow(edb, row, "Failed", "Unknown", ex.Message);
            await Logger.TakeIt(use?.Id, PAGE, $"ProcessRow#{row.SourceRowIndex}", exception: ex.Message, stackTrace: ex.StackTrace);
        }
    }

    // ── Görsel migrasyonu: mevcut Media.cs kullanılır, yeni sistem yok ──
    private async Task ImportImages(_ApplicationConnectionDb db, Guid productId, string imagesCell, ProductImportRows row)
    {
        if (string.IsNullOrWhiteSpace(imagesCell)) return;
        var urls = imagesCell.Split(',').Select(u => u.Trim()).Where(u => u.StartsWith("http")).ToList();
        if (!urls.Any()) return;

        var http = HttpFactory.CreateClient();
        http.Timeout = TimeSpan.FromSeconds(30);
        var warnings = new List<string>();
        bool firstSet = false;

        foreach (var url in urls)
        {
            // Bilinen placeholder'ları atla
            if (url.IndexOf("ResimYok", StringComparison.OrdinalIgnoreCase) >= 0 ||
                url.IndexOf("NoImage", StringComparison.OrdinalIgnoreCase) >= 0)
            { warnings.Add($"Placeholder atlandı: {url}"); continue; }

            try
            {
                var bytes = await http.GetByteArrayAsync(url, _cts.Token);
                var fileName = Path.GetFileName(new Uri(url).LocalPath);
                if (string.IsNullOrEmpty(fileName)) fileName = $"img_{Guid.NewGuid():N}.jpg";

                // Framework'ün kendi FormFile'ı; özel IFormFile sınıfına gerek yok.
                // ASP.NET bağımlılığı tamamen web katmanında kalır, data projesi temiz POCO olur.
                using var ms = new MemoryStream(bytes);
                var form = new FormFile(ms, 0, bytes.Length, "file", fileName)
                {
                    Headers = new HeaderDictionary(),
                    ContentType = GuessContentType(fileName)
                };

                // Mevcut AVIF dönüştürme + oranlama + Media kaydı (Media.cs)
                var (storedName, _) = await MediaProcessor.ConvertToAvifWithLogAsync(form, UserEmail(), _currentJob.UserId);
                if (string.IsNullOrEmpty(storedName)) { warnings.Add($"İşlenemedi: {url}"); continue; }

                var media = await db.Media.AsNoTracking()
                    .Where(m => m.FileStoredName == storedName)
                    .OrderByDescending(m => m.CreatedAt).FirstOrDefaultAsync(_cts.Token);
                if (media == null) { warnings.Add($"Media kaydı bulunamadı: {url}"); continue; }

                if (!firstSet)
                {
                    var prod = await db.Products.FirstOrDefaultAsync(p => p.Id == productId, _cts.Token);
                    if (prod != null) { prod.CoverMediaId = media.Id; firstSet = true; }
                }
                db.ItemGallery.Add(new ItemGallery
                {
                    UserId = _currentJob.UserId,
                    ItemId = productId,
                    ItemType = "ProductGallery",
                    MediaId = media.Id,
                    ItemAddDate = DateTime.UtcNow,
                    IsDelete = false
                });
            }
            catch (Exception ex) { warnings.Add($"Görsel hatası ({url}): {ex.Message}"); }
        }
        if (warnings.Any()) row.WarningsJson = JsonSerializer.Serialize(warnings);
    }

    // ════════════════════════ ÇALIŞMA ANI YARDIMCILARI ════════════════════════
    private async Task BuildRuntimeLookups()
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var cats = await db.ProductImportMappings.AsNoTracking()
            .Where(m => m.JobId == _currentJob.Id && m.MappingType == "Category" && m.IsConfirmedByUser).ToListAsync(_cts.Token);
        _categoryLookup = cats.Where(c => int.TryParse(c.TargetValue, out _))
            .ToDictionary(c => c.SourceKeyHash!, c => int.Parse(c.TargetValue!));

        _brandLookup = new Dictionary<string, Guid>(StringComparer.OrdinalIgnoreCase);
        var brs = await db.ProductImportMappings.AsNoTracking()
            .Where(m => m.JobId == _currentJob.Id && m.MappingType == "Brand").ToListAsync(_cts.Token);
        foreach (var b in brs)
            if (Guid.TryParse(b.TargetValue, out var gid)) _brandLookup[b.SourceKey!] = gid;
    }

    private void AddCategories(_ApplicationConnectionDb db, Guid productId, string categoriesCell)
    {
        var path = PrimaryCategoryPath(categoriesCell);
        int? catId = null;
        if (!string.IsNullOrEmpty(path) && _categoryLookup.TryGetValue(Hash(path), out var cid)) catId = cid;
        catId ??= _currentJob.DefaultCategoryId;
        if (catId.HasValue)
            db.ProductCategories.Add(new data._Product.ProductCategories
            { ProductId = productId, CategoryId = catId.Value, IsPrimary = true, CreatedAt = DateTime.UtcNow });
    }

    private void AddSeo(_ApplicationConnectionDb db, Guid productId, string? name)
    {
        db.ProductSeo.Add(new data._Product.ProductSeo
        {
            ProductId = productId,
            Slug = Slugify(name),
            SeoTitle = name,
            LanguageCode = "tr",
            CreatedAt = DateTime.UtcNow
        });
    }

    // BİLGİ DAĞARCIĞI: WooCommerce "Öznitelik N adı" / "Öznitelik N değer(ler)i" çiftlerini
    // ProductSpecifications'a serbest (CustomName + CustomValue) olarak yazar — veri kaybını önler.
    // Tanımlı attribute/variant sistemine bağlanmadan, ürün özelliklerini güvenle saklar.
    private void AddSpecifications(_ApplicationConnectionDb db, Guid productId, Dictionary<string, string> raw)
    {
        int order = 0;
        foreach (var kv in raw)
        {
            var key = kv.Key?.Trim() ?? "";
            // "Öznitelik 1 adı", "Öznitelik 1 değer(ler)i" desenini yakala
            if (!key.StartsWith("Öznitelik", StringComparison.OrdinalIgnoreCase)) continue;
            if (!(key.Contains("ad", StringComparison.OrdinalIgnoreCase))) continue; // yalnızca "... adı" kolonundan başla

            var nameVal = (kv.Value ?? "").Trim();
            if (string.IsNullOrEmpty(nameVal)) continue;

            // Aynı N numarasının "değer(ler)i" kolonunu bul
            var num = new string(key.Where(char.IsDigit).ToArray());
            var valueCol = raw.Keys.FirstOrDefault(k =>
                k.StartsWith("Öznitelik", StringComparison.OrdinalIgnoreCase) &&
                k.Contains("değer", StringComparison.OrdinalIgnoreCase) &&
                new string(k.Where(char.IsDigit).ToArray()) == num);
            var valueVal = valueCol != null ? (raw[valueCol] ?? "").Trim() : "";
            if (string.IsNullOrEmpty(valueVal)) continue;

            db.ProductSpecifications.Add(new data._Product.ProductSpecifications
            {
                ProductId = productId,
                CustomName = nameVal,
                CustomValue = valueVal,
                DisplayOrder = order++,
                CreatedAt = DateTime.UtcNow
            });
        }
    }

    private Guid? ResolveBrand(string brandCell)
    {
        if (string.IsNullOrWhiteSpace(brandCell)) return null;
        var first = brandCell.Split(',').First().Trim();
        return _brandLookup.TryGetValue(first, out var gid) ? gid : (Guid?)null;
    }

    private string MapStockStatus(string stokta, string backorder)
    {
        if (backorder == "1") return "Backorder";
        return stokta == "1" ? "InStock" : "OutOfStock";
    }

    // ── Satır işaretle + job sayaçları (DB gerçeği) ──
    private async Task MarkRow(_ApplicationConnectionDb db, ProductImportRows row, string status,
        string? errorCode, string? errorMsg, Guid? productId = null, Guid? variantId = null)
    {
        var tracked = await db.ProductImportRows.FirstOrDefaultAsync(r => r.Id == row.Id, _cts.Token);
        if (tracked == null) return;
        tracked.RowStatus = status; tracked.ErrorCode = errorCode; tracked.ErrorMessage = errorMsg;
        tracked.CreatedProductId = productId; tracked.CreatedVariantId = variantId;
        tracked.WarningsJson = row.WarningsJson; tracked.ProcessedAt = DateTime.UtcNow;
        await db.SaveChangesAsync(_cts.Token);
        row.RowStatus = status;
    }

    // Sayaçları yalnızca OKUYARAK _currentJob'a yansıtır (DB'ye yazmaz). İş açılışında self-heal için.
    private async Task RecomputeCountersFromDb()
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var stats = await db.ProductImportRows.Where(r => r.JobId == _currentJob.Id)
            .GroupBy(r => r.RowStatus).Select(g => new { g.Key, C = g.Count() }).ToListAsync(_cts.Token);

        _currentJob.ImportedCount = stats.FirstOrDefault(s => s.Key == "Imported")?.C ?? 0;
        _currentJob.FailedCount = stats.FirstOrDefault(s => s.Key == "Failed")?.C ?? 0;
        _currentJob.SkippedCount = (stats.FirstOrDefault(s => s.Key == "Skipped")?.C ?? 0)
                                 + (stats.FirstOrDefault(s => s.Key == "Duplicate")?.C ?? 0);
        var done = _currentJob.ImportedCount + _currentJob.FailedCount;
        _currentJob.SuccessRate = done > 0 ? Math.Round((decimal)_currentJob.ImportedCount / done * 100m, 1) : 0m;
    }

    private async Task PersistCountersFromDb()
    {
        await RecomputeCountersFromDb();   // _currentJob sayaçlarını DB gerçeğinden tazele
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var job = await db.ProductImportJobs.FirstOrDefaultAsync(j => j.Id == _currentJob.Id, _cts.Token);
        if (job != null)
        {
            job.ImportedCount = _currentJob.ImportedCount; job.FailedCount = _currentJob.FailedCount;
            job.SkippedCount = _currentJob.SkippedCount; job.SuccessRate = _currentJob.SuccessRate;
            job.LastProcessedRowIndex = _currentJob.LastProcessedRowIndex; job.LastRunAt = DateTime.UtcNow;
            job.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync(_cts.Token);
        }
    }

    // İşlenen son satırları canlı listeye doldurur (tamamlanmış işi tekrar açınca da liste dolu görünür).
    private async Task LoadLiveLogFromDb()
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var recent = await db.ProductImportRows.AsNoTracking()
            .Where(r => r.JobId == _currentJob.Id && r.ProcessedAt != null)
            .OrderByDescending(r => r.ProcessedAt).Take(50).ToListAsync(_cts.Token);
        _liveLog.Clear();
        foreach (var r in recent)
            _liveLog.Add(new LiveItem { ExternalId = r.SourceExternalId, Name = RowName(r), Status = r.RowStatus ?? "Pending", Error = r.ErrorCode });
    }


    private async Task UpdateJobStatus(string status, DateTime? completedAt = null)
    {
        _currentJob.Status = status;
        if (completedAt.HasValue) _currentJob.CompletedAt = completedAt;
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var job = await db.ProductImportJobs.FirstOrDefaultAsync(j => j.Id == _currentJob.Id, _cts.Token);
        if (job != null)
        {
            job.Status = status; job.CompletedAt = _currentJob.CompletedAt;
            job.LastErrorMessage = _currentJob.LastErrorMessage; job.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync(_cts.Token);
        }
        await StateHub.NotifyDataChanged("ProductImportJobs");
    }

    private async Task RefreshErrorRows()
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        _errorRows = await db.ProductImportRows.AsNoTracking()
            .Where(r => r.JobId == _currentJob.Id && r.RowStatus == "Failed")
            .OrderBy(r => r.SourceRowIndex).Take(200).ToListAsync(_cts.Token);
    }

    private async Task DeleteJob(ProductImportJobs job)
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        var j = await db.ProductImportJobs.FirstOrDefaultAsync(x => x.Id == job.Id, _cts.Token);
        if (j != null) { j.IsDeleted = new() { IsDeletedStatu = true, DeletedAtDate = DateTime.UtcNow }; await db.SaveChangesAsync(_cts.Token); }
        await StateHub.NotifyDataChanged("ProductImportJobs");
        await LoadDashboard();
    }

    private async Task LoadJobIntoMemory(Guid jobId)
    {
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        _currentJob = await db.ProductImportJobs.FirstOrDefaultAsync(j => j.Id == jobId, _cts.Token) ?? new();
        _sourceCsvMedia = await db.Media.AsNoTracking().FirstOrDefaultAsync(m => m.Id == _currentJob.SourceMediaId, _cts.Token);
        await LoadSystemReferences();
        await LoadWarehouses();
        await RefreshErrorRows();
        await RecomputeCountersFromDb();   // sayaçları satırlardan tazele → eski/tamamlanmış işler doğru görünür
        await LoadLiveLogFromDb();         // işlenen ürünler listesini doldur
        // CSV'yi tekrar yükle (kaldığı yerden devam için bellek tazelemesi)
        if (_sourceCsvMedia != null) { try { await LoadCsvFromMedia(); } catch { } }
    }

    // ════════════════════════ KÜÇÜK YARDIMCILAR ════════════════════════
    private decimal? ParseDec(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        s = s.Replace(".", "").Replace(',', '.'); // Türkçe ondalık: 1.088,1 → 1088.1
        return decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? d : (decimal?)null;
    }

    private string Slugify(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return Guid.NewGuid().ToString("N").Substring(0, 8);
        var map = new Dictionary<char, char> { { 'ı', 'i' }, { 'ğ', 'g' }, { 'ü', 'u' }, { 'ş', 's' }, { 'ö', 'o' }, { 'ç', 'c' }, { 'İ', 'i' } };
        var sb = new StringBuilder();
        foreach (var ch in s.ToLowerInvariant())
        {
            var c = map.TryGetValue(ch, out var m) ? m : ch;
            if (char.IsLetterOrDigit(c)) sb.Append(c);
            else if (char.IsWhiteSpace(c) || c == '-') sb.Append('-');
        }
        var slug = sb.ToString().Trim('-');
        while (slug.Contains("--")) slug = slug.Replace("--", "-");
        return string.IsNullOrEmpty(slug) ? Guid.NewGuid().ToString("N").Substring(0, 8) : slug + "-" + Guid.NewGuid().ToString("N").Substring(0, 4);
    }

    private string Hash(string input)
    {
        var norm = (input ?? "").Trim().ToLowerInvariant();
        using var sha = SHA256.Create();
        return Convert.ToHexString(sha.ComputeHash(Encoding.UTF8.GetBytes(norm))).Substring(0, 32);
    }

    private string GuessContentType(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch { ".png" => "image/png", ".webp" => "image/webp", ".gif" => "image/gif", ".avif" => "image/avif", _ => "image/jpeg" };
    }

    private string UserEmail() => use?.ContactInformation?.Email ?? use?.Id.ToString() ?? "system";

    private List<SuggestionDto> DeserializeSuggestions(string json)
    {
        try { return JsonSerializer.Deserialize<List<SuggestionDto>>(json) ?? new(); } catch { return new(); }
