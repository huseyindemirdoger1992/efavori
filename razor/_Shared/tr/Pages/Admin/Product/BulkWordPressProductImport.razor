    private int ProgressPercent(ProductImportJobs j)
    {
        if (j.TotalCount == 0) return 0;
        var done = j.ImportedCount + j.FailedCount + j.SkippedCount;
        return (int)Math.Round((double)done / j.TotalCount * 100);
    }

