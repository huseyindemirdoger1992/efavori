@* ============================================================
   ListProduct.razor — Ürün Listesi (efavori)
   ─────────────────────────────────────────────────────────────
   ✅ SUNUCU-TARAFLI SAYFALAMA → milyonlarca üründe bile kilitlenmez
      (her sayfada yalnızca PAGE_SIZE kayıt + filtre başına tek CountAsync)
   ✅ İlişkili veriler (kapak/marka/mağaza/yükleyen/fiyat/stok) sayfa
      kimlikleri için TEK toplu sorguyla doldurulur → N+1 yok
   ✅ ROL DUYARLI:
        SuperAdmin → tüm ürünler + "Yükleyen" & "Mağaza" sütunları + TOPLU İŞLEM
        Diğer      → yalnızca kendi ürünleri (standart görünüm)
   ✅ GlobalStateHub broadcast + RAM yok (liste DB'den sayfalı gelir)
   ✅ TakeLogs ile tüm aksiyonlar loglanır
   ✅ SemaphoreSlim yazma kilidi + _isProcessing guard
   ✅ Soft delete (owned IsDeleted) — fiziksel silme yok
   ✅ Bootstrap 5.3 + Font Awesome, tek dosya, code-behind yok
   ✅ GlobalSecurityProvider KULLANILMAZ (talep gereği)
   ─────────────────────────────────────────────────────────────
   REVİZYON EKLERİ:
   ✅ Durum filtresi düzeltildi (Published/Draft/Bekliyor doğru eşleme)
   ✅ Etkileşim filtreleri: Görüntülenme, Paylaşma, Tavsiye (min/max)
   ✅ Toplu Kategori Değiştirme (derinlik gösteren ağaç seçici)
   ✅ Toplu Stok Güncelleme (varsayılan varyant)
   ============================================================ *@

@using data
@using api
@using api.tr
@using data._Shared
@using data._Product
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@implements IAsyncDisposable

@code {
    // Global state'ten dil alıp yönlendirme için gereklidir — SİLME.
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa", "/"),
        ("fa fa-cubes",    "Ürünler",   "javascript:void(0)"),
        ("fa fa-list-alt", PAGE_TITLE,  "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ═══════════════════════════ ÜST BAR ═══════════════════════════ *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button class="btn btn-primary btn-sm" @onclick="NavigateToAdd">
        <i class="fa fa-plus me-sm-1"></i><span class="d-none d-sm-inline">Yeni Ürün</span>
    </button>

    @* ── Toplu işlem çubuğu (yalnızca SuperAdmin) ── *@
    @if (IsAdmin && _selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light text-dark">@_selectedIds.Count seçili</span>
        <button class="btn btn-secondary btn-sm" @onclick="ClearSelection"><i class="fa fa-times me-1"></i>Temizle</button>
        <div class="btn-group btn-group-sm">
            <button class="btn btn-success" @onclick='() => OpenBulk("publish")' disabled="@_isProcessing"><i class="fa fa-check me-1"></i>Yayınla</button>
            <button class="btn btn-warning" @onclick='() => OpenBulk("unpublish")' disabled="@_isProcessing"><i class="fa fa-eye-slash me-1"></i>Taslağa Al</button>
            <button class="btn btn-info" @onclick='() => OpenBulk("activate")' disabled="@_isProcessing"><i class="fa fa-toggle-on me-1"></i>Aktifleştir</button>
            <button class="btn btn-dark" @onclick='() => OpenBulk("deactivate")' disabled="@_isProcessing"><i class="fa fa-toggle-off me-1"></i>Pasifleştir</button>
            <button class="btn btn-danger" @onclick='() => OpenBulk("delete")' disabled="@_isProcessing"><i class="fa fa-trash me-1"></i>Sil</button>
        </div>
        <div class="vr mx-1"></div>
        <div class="btn-group btn-group-sm">
            <button class="btn btn-primary" @onclick="OpenBulkCategory" disabled="@_isProcessing"><i class="fa fa-folder me-1"></i>Kategori Değiştir</button>
            <button class="btn btn-primary" @onclick="OpenBulkStock" disabled="@_isProcessing"><i class="fa fa-cubes me-1"></i>Stok Güncelle</button>
        </div>
    }

    <div class="ms-auto small text-light align-self-center">
        @if (IsAdmin)
        {
            <span class="badge bg-danger"><i class="fa fa-shield me-1"></i>SuperAdmin · Tam Yetki</span>
        }
        else
        {
            <span class="badge bg-secondary"><i class="fa fa-user me-1"></i>Mağaza Görünümü</span>
        }
    </div>
</div>

@* ═══════════════════════════ Aİ İSTATİSTİK KARTLARI ═══════════════════════════ *@
<div class="row g-2 mb-3">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card @(_filterAiStat == "" ? "border-primary border-2 shadow-sm" : "border-0") bg-primary bg-opacity-10"
             role="button" @onclick='() => OnStatCardClicked("")'>
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-cubes text-primary"></i>
                    <div>
                        <div class="small text-light">Toplam Ürün</div>
                        <div class="fw-bold">@_statTotal.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card @(_filterAiStat == "ai_on" ? "border-light border-2 shadow-sm" : "border-0") bg-success bg-opacity-10"
             role="button" @onclick='() => OnStatCardClicked("ai_on")'>
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-magic text-light"></i>
                    <div>
                        <div class="small text-light">AI Açık</div>
                        <div class="fw-bold text-light">@_statAiManagedTrue.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card @(_filterAiStat == "ai_off" ? "border-secondary border-2 shadow-sm" : "border-0") bg-secondary bg-opacity-10"
             role="button" @onclick='() => OnStatCardClicked("ai_off")'>
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-ban text-dark"></i>
                    <div>
                        <div class="small text-light">AI Kapalı</div>
                        <div class="fw-bold text-dark">@_statAiManagedFalse.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card @(_filterAiStat == "status_null" ? "border-warning border-2 shadow-sm" : "border-0") bg-warning bg-opacity-10"
             role="button" @onclick='() => OnStatCardClicked("status_null")'>
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-clock-o text-warning"></i>
                    <div>
                        <div class="small text-light">AI Bekliyor</div>
                        <div class="fw-bold text-warning">@_statAiStatusNull.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card @(_filterAiStat == "status_true" ? "border-info border-2 shadow-sm" : "border-0") bg-info bg-opacity-10"
             role="button" @onclick='() => OnStatCardClicked("status_true")'>
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-check-circle text-info"></i>
                    <div>
                        <div class="small text-light">AI Başarılı</div>
                        <div class="fw-bold text-info">@_statAiStatusTrue.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card @(_filterAiStat == "status_false" ? "border-danger border-2 shadow-sm" : "border-0") bg-danger bg-opacity-10"
             role="button" @onclick='() => OnStatCardClicked("status_false")'>
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-exclamation-triangle text-danger"></i>
                    <div>
                        <div class="small text-light">AI Başarısız</div>
                        <div class="fw-bold text-danger">@_statAiStatusFalse.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════ FİLTRELER ═══════════════════════════ *@
<div class="row g-2 mb-2">
    @* ═══════════════════════════ KATEGORİ FİLTRESİ (Dropdown Select) ═══════════════════════════ *@

    <div class="col-6 col-lg-2">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="fa fa-search"></i></span>
            <input type="text" class="form-control form-control-lg" placeholder="Ürün adı veya SKU ara..."
                   value="@_searchTerm" @oninput="OnSearchInput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button class="btn btn-secondary" @onclick="ClearSearch"><i class="fa fa-times"></i></button>
            }
        </div>
    </div>

    <div class="col-6 col-lg-2">
        <select class="form-select form-select-sm" value="@_filterType" @onchange="OnFilterTypeChanged">
            <option value="">Tüm Tipler</option>
            <option value="Simple">Basit</option>
            <option value="Variant">Varyantlı</option>
            <option value="Digital">Dijital</option>
            <option value="Service">Hizmet</option>
            <option value="Bundle">Paket</option>
            <option value="External">Harici</option>
        </select>
    </div>

    <div class="col-6 col-lg-2">
        <select class="form-select form-select-sm" value="@_filterStatus" @onchange="OnFilterStatusChanged">
            <option value="">Tüm Durumlar</option>
            <option value="Published">Yayında</option>
            <option value="Draft">Taslak</option>
            <option value="PendingApproval">Onay Bekliyor</option>
            <option value="Rejected">Reddedildi</option>
        </select>
    </div>

    <div class="col-6 col-lg-2">
        <select class="form-select form-select-sm" value="@_filterActive" @onchange="OnFilterActiveChanged">
            <option value="">Aktif + Pasif</option>
            <option value="active">Yalnızca Aktif</option>
            <option value="passive">Yalnızca Pasif</option>
        </select>
    </div>

    <div class="col-6 col-lg-2">
        <select class="form-select form-select-sm" value="@_sort" @onchange="OnSortChanged">
            <option value="new">En Yeni</option>
            <option value="old">En Eski</option>
            <option value="name">İsim (A-Z)</option>
            <option value="upd">Son Güncellenen</option>
            <option value="view_desc">En Çok Görüntülenen</option>
            <option value="share_desc">En Çok Paylaşılan</option>
            <option value="recommend_desc">En Çok Tavsiye Edilen</option>
        </select>
    </div>

    @* SuperAdmin: mağaza filtresi (mağaza sayısı ürün sayısından çok azdır → güvenli) *@
    @if (IsAdmin && _stores.Any())
    {
        <div class="col-12 col-lg-2">
            <select class="form-select form-select-sm" value="@_filterStoreId" @onchange="OnFilterStoreChanged">
                <option value="">Tüm Mağazalar</option>
                @foreach (var s in _stores)
                {
                    <option value="@s.Id">@(string.IsNullOrWhiteSpace(s.Name) ? "(İsimsiz mağaza)" : s.Name)</option>
                }
            </select>
        </div>
    }
</div>




@* ═══════════════════════════ GELİŞMİŞ FİLTRELER (ETKİLEŞİM) ═══════════════════════════ *@
<div class="mb-3 row">

    <div class="col-12 col-lg-10">
        <div class="dropdown position-relative" @onfocusout="OnFilterCatBlur">

            @* Sahte Select Kutusu *@
            <div class="form-select form-select-sm d-flex align-items-center @(_filterCategoryId.HasValue ? "border-primary" : "")"
                 role="button" @onclick="ToggleFilterCatDropdown">

                @if (_filterCatItemsLoading)
                {
                    <i class="fa fa-spinner fa-spin me-2 text-secondary"></i>
                    <span class="text-secondary">Kategoriler yükleniyor...</span>
                }
                else if (_filterCategoryId.HasValue)
                {
                    <span class="text-primary text-truncate">
                        <i class="fa fa-folder-open me-2"></i>@_filterCategoryName
                    </span>
                }
                else
                {
                    <span class="text-secondary">
                        <i class="fa fa-folder me-2"></i>Tüm Kategoriler
                    </span>
                }
            </div>

            @* Açılır Menü (Dropdown) *@
            @if (_filterCatDropdownOpen)
            {
                <div class="dropdown-menu show w-100 p-0 shadow-sm mt-1 border" style="max-height: 350px; overflow-y: auto;">

                    @* Sticky Arama Kutusu *@
                    <div class="p-2 border-bottom bg-light sticky-top" style="z-index: 10;">
                        <input type="text" class="form-control form-control-sm" placeholder="Kategori ara..."
                               value="@_filterCatInternalSearch" @oninput="OnFilterCatInternalSearch"
                               @onclick:stopPropagation="true" />
                    </div>

                    @* "Tümü" Seçeneği *@
                    <div class="dropdown-item py-2 @(_filterCategoryId == null ? "active" : "")"
                         role="button" @onclick="ClearCategoryFilter" @onclick:stopPropagation="true">
                        <i class="fa fa-list me-2"></i>Tüm Kategoriler
                    </div>

                    @* Kategori Listesi *@
                    @{
                        var visibleCats = GetFilteredCatItems();
                    }
                    @if (!visibleCats.Any() && !_filterCatItemsLoading)
                    {
                        <div class="text-center py-3 small text-secondary">Sonuç bulunamadı.</div>
                    }
                    else
                    {
                        @foreach (var cat in visibleCats)
                        {
                            var isActive = _filterCategoryId == cat.Id;
                            <div class="dropdown-item py-1 d-flex align-items-center @(isActive ? "active" : "")"
                                 role="button" @onclick="() => ApplyFilterCategory(cat)" @onclick:stopPropagation="true"
                                 style="padding-left: @(12 + cat.Depth * 16)px !important;">

                                <i class="fa @(cat.HasChildren ? "fa-folder text-warning" : "fa-tag text-secondary") me-2 small" style="width: 14px; text-align: center;"></i>
                                <span class="small text-truncate flex-grow-1" title="@cat.FullPath">@cat.Name</span>
                                <span class="small text-secondary ms-2 flex-shrink-0">(@cat.ProductCount)</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-2">

        <button class="btn btn-link btn-sm text-decoration-none p-0" @onclick="() => _showAdvancedFilters = !_showAdvancedFilters">
            <i class="fa @(_showAdvancedFilters ? "fa-chevron-up" : "fa-chevron-down") me-1"></i>
            Etkileşim Filtreleri
            @if (HasAnyInteractionCountsFilter())
            {
                <span class="badge bg-info ms-1">Aktif</span>
            }
        </button>
    </div>


    @if (_showAdvancedFilters)
    {
        <div class="row g-2 mt-1">
            @* Görüntülenme *@
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1 text-light"><i class="fa fa-eye me-1"></i>Görüntülenme</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Min</span>
                    <input type="number" class="form-control" placeholder="0" min="0"
                           value="@_filterViewCountMin" @onchange="e => OnInteractionCountsFilterChanged(e, nameof(_filterViewCountMin))" />
                    <span class="input-group-text">Max</span>
                    <input type="number" class="form-control" placeholder="∞" min="0"
                           value="@_filterViewCountMax" @onchange="e => OnInteractionCountsFilterChanged(e, nameof(_filterViewCountMax))" />
                </div>
            </div>
            @* Paylaşma *@
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1 text-light"><i class="fa fa-share-alt me-1"></i>Paylaşma</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Min</span>
                    <input type="number" class="form-control" placeholder="0" min="0"
                           value="@_filterShareCountMin" @onchange="e => OnInteractionCountsFilterChanged(e, nameof(_filterShareCountMin))" />
                    <span class="input-group-text">Max</span>
                    <input type="number" class="form-control" placeholder="∞" min="0"
                           value="@_filterShareCountMax" @onchange="e => OnInteractionCountsFilterChanged(e, nameof(_filterShareCountMax))" />
                </div>
            </div>
            @* Tavsiye Etme *@
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1 text-light"><i class="fa fa-thumbs-up me-1"></i>Tavsiye Etme</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Min</span>
                    <input type="number" class="form-control" placeholder="0" min="0"
                           value="@_filterRecommendCountMin" @onchange="e => OnInteractionCountsFilterChanged(e, nameof(_filterRecommendCountMin))" />
                    <span class="input-group-text">Max</span>
                    <input type="number" class="form-control" placeholder="∞" min="0"
                           value="@_filterRecommendCountMax" @onchange="e => OnInteractionCountsFilterChanged(e, nameof(_filterRecommendCountMax))" />
                </div>
            </div>

            @if (HasAnyInteractionCountsFilter())
            {
                <div class="col-12">
                    <button class="btn btn-secondary btn-sm" @onclick="ClearInteractionCountsFilters">
                        <i class="fa fa-times me-1"></i>Etkileşim Filtrelerini Temizle
                    </button>
                </div>
            }
        </div>
    }
</div>

@* ═══════════════════════════ İÇERİK ═══════════════════════════ *@
@if (_isLoading && !_rows.Any())
{
    <div class="text-center py-5"><i class="fa fa-spinner fa-spin fa-2x text-info"></i><p class="mt-2 small text-light">Yükleniyor...</p></div>
}
else if (!_rows.Any())
{
    <div class="text-center py-5 text-light"><i class="fa fa-inbox fa-3x mb-3 d-block"></i><p class="mb-0">Ürün bulunamadı.</p></div>
}
else
{
    <div class="table-responsive rounded-3 border">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    @if (IsAdmin)
                    {
                        <th style="width:2rem;">
                            <input type="checkbox" class="form-check-input" checked="@_pageAllSelected" @onchange="ToggleSelectPage" />
                        </th>
                    }
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th style="width:56px;">Görsel</th>
                    <th>Ürün</th>
                    <th class="d-none d-lg-table-cell">SKU</th>
                    <th class="text-end">Fiyat</th>
                    <th class="text-center d-none d-md-table-cell">Stok</th>
                    <th class="d-none d-lg-table-cell">Marka</th>
                    @if (IsAdmin)
                    {
                        <th class="d-none d-xl-table-cell">Mağaza</th>
                        <th class="d-none d-xl-table-cell">Yükleyen</th>
                    }
                    <th class="text-center d-none d-lg-table-cell" title="Görüntülenme / Paylaşma / Tavsiye"><i class="fa fa-bar-chart"></i></th>
                    <th class="text-center">Durum</th>
                    <th class="d-none d-lg-table-cell">Tarih</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_page - 1) * _pageSize + 1;
                }
                @foreach (var r in _rows)
                {
                    var selected = _selectedIds.Contains(r.Id);
                    <tr class="@(selected ? "table-active" : "")">
                        @if (IsAdmin)
                        {
                            <td><input type="checkbox" class="form-check-input" checked="@selected" @onchange="() => ToggleRow(r.Id)" /></td>
                        }
                        <td class="d-none d-md-table-cell text-light small">@(rowNo++)</td>
                        <td>
                            <img src="@CoverUrl(r)" class="rounded border" style="width:42px;height:42px;object-fit:cover;" alt="" />
                        </td>
                        <td>
                            <div class="fw-semibold text-truncate" style="max-width:256px;" title="@r.Name">@(string.IsNullOrWhiteSpace(r.Name) ? "(İsimsiz ürün)" : r.Name)</div>
                            <div>
                                <span class="badge bg-light text-warning border">@TypeText(r.ProductType)</span>
                                @if (r.IsApprovedByAdmin == true)
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="fa fa-check-circle me-1"></i>Onaylı</span>
                                }
                            </div>
                        </td>
                        <td class="d-none d-lg-table-cell"><code class="small">@(_skuMap.GetValueOrDefault(r.Id) ?? "—")</code></td>
                        <td class="text-end text-nowrap">@PriceText(r.Id)</td>
                        <td class="text-center d-none d-md-table-cell">
                            <span class="badge @(StockBadge(r.Id))">@(_stockMap.GetValueOrDefault(r.Id))</span>
                        </td>
                        <td class="d-none d-lg-table-cell">@(r.BrandId.HasValue ? _brandMap.GetValueOrDefault(r.BrandId.Value) ?? "—" : "—")</td>
                        @if (IsAdmin)
                        {
                            <td class="d-none d-xl-table-cell small">@(_storeMap.GetValueOrDefault(r.StoreId) ?? "—")</td>
                            <td class="d-none d-xl-table-cell small">@(_userMap.GetValueOrDefault(r.UserId) ?? "—")</td>
                        }
                        <td class="text-center d-none d-lg-table-cell text-nowrap">
                            @{
                                var ic = _InteractionCountsMap.GetValueOrDefault(r.Id);
                            }
                            <span class="small" title="Görüntülenme"><i class="fa fa-eye text-info"></i> @(ic.view)</span>
                            <span class="small ms-1" title="Paylaşma"><i class="fa fa-share-alt text-success"></i> @(ic.share)</span>
                            <span class="small ms-1" title="Tavsiye"><i class="fa fa-thumbs-up text-warning"></i> @(ic.recommend)</span>
                        </td>
                        <td class="text-center text-nowrap">
                            <span class="badge @(r.PublishStatus == true ? "bg-success" : r.PublishStatus == false ? "bg-secondary" : "bg-warning text-dark")">
                                @(r.PublishStatus == true ? "Yayında" : r.PublishStatus == false ? "Taslak" : "Bekliyor")
                            </span>
                            <span class="ms-1" title="@(r.IsActive ? "Aktif" : "Pasif")">
                                <i class="fa @(r.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary")"></i>
                            </span>
                        </td>
                        <td class="d-none d-lg-table-cell text-nowrap small text-light">@r.CreatedAt?.ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-info btn-sm" title="Detay" @onclick="() => OpenDetail(r.Id)"><i class="fa fa-eye"></i></button>
                            <button class="btn btn-warning btn-sm" title="Düzenle" @onclick="() => NavigateToEdit(r.Id)"><i class="fa fa-edit"></i></button>
                            @if (IsAdmin || r.UserId == use?.Id)
                            {
                                <button class="btn btn-danger btn-sm" title="Sil" @onclick="() => OpenDelete(r)"><i class="fa fa-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama (kompakt — milyonlarca sayfa için buton listesi basılmaz) ─── *@
    <div class="d-flex flex-wrap align-items-center justify-content-between mt-2 gap-2">
        <div class="d-flex align-items-center gap-2">
            <small class="text-light">Sayfa @_page / @_totalPages.ToString("N0")</small>
            <select class="form-select form-select-sm w-auto" value="@_pageSize" @onchange="OnPageSizeChanged">
                <option value="10">10 / sayfa</option>
                <option value="100">100 / sayfa</option>
                <option value="1000">1000 / sayfa</option>
                <option value="10000">10000 / sayfa</option>
            </select>
        </div>

        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(_page <= 1 ? "disabled" : "")"><button class="page-link" @onclick="() => GoToPage(1)" title="İlk"><i class="fa fa-angle-double-left"></i></button></li>
                <li class="page-item @(_page <= 1 ? "disabled" : "")"><button class="page-link" @onclick="() => GoToPage(_page - 1)"><i class="fa fa-angle-left"></i></button></li>
                <li class="page-item active"><span class="page-link">@_page</span></li>
                <li class="page-item @(_page >= _totalPages ? "disabled" : "")"><button class="page-link" @onclick="() => GoToPage(_page + 1)"><i class="fa fa-angle-right"></i></button></li>
                <li class="page-item @(_page >= _totalPages ? "disabled" : "")"><button class="page-link" @onclick="() => GoToPage(_totalPages)" title="Son"><i class="fa fa-angle-double-right"></i></button></li>
            </ul>
        </nav>

        <div class="input-group input-group-sm" style="width:160px;">
            <span class="input-group-text">Git</span>
            <input type="number" min="1" max="@_totalPages" class="form-control" value="@_page" @onchange="OnJumpPage" />
        </div>
    </div>
}

