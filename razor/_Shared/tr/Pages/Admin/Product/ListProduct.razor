    // ═══════════════════════ GÖRÜNÜM YARDIMCILARI ═══════════════════════
    private string CoverUrl(ProductRow r)
        => r.CoverMediaId.HasValue && _coverMap.TryGetValue(r.CoverMediaId.Value, out var u) ? u : NoImage;

    private string PriceText(Guid id)
    {
        if (!_priceMap.TryGetValue(id, out var p)) return "—";
        return FormatPrice(p.price, p.disc, p.cur);
    }

    private string FormatPrice(decimal price, decimal? disc, string cur)
    {
        var sym = cur switch { "TRY" => "₺", "USD" => "$", "EUR" => "€", "AZN" => "₼", _ => cur + " " };
        if (disc.HasValue && disc.Value > 0 && disc.Value < price)
            return $"{disc.Value:N2} {sym}";
        return $"{price:N2} {sym}";
    }

    private string StockBadge(Guid id)
    {
        var q = _stockMap.GetValueOrDefault(id);
        return q <= 0 ? "bg-danger-subtle text-danger" : (q < 5 ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success");
    }

    private string TypeText(string? t) => t switch
    {
        "Simple" => "Basit",
        "Variant" => "Varyantlı",
        "Digital" => "Dijital",
        "Service" => "Hizmet",
        "Bundle" => "Paket",
        "External" => "Harici",
        _ => t ?? "—"
    };

    private string BulkActionText(string a) => a switch
    {
        "delete" => "Silme",
        "publish" => "Yayınlama",
        "unpublish" => "Taslağa Alma",
        "activate" => "Aktifleştirme",
        "deactivate" => "Pasifleştirme",
        _ => a
    };

    private static IEnumerable<List<T>> Chunk<T>(List<T> source, int size)
    {
        for (int i = 0; i < source.Count; i += size)
            yield return source.GetRange(i, Math.Min(size, source.Count - i));
    }

    // ═══════════════════════ ALTYAPI YARDIMCILARI ═══════════════════════
    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval", $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval", $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://efavori.com/_files/main/logo/logo.png");
    }

    private async Task LogError(string action, Exception ex)
    {
        try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleDataChanged;
        _searchCts?.Cancel(); _searchCts?.Dispose();
        _bulkCatSearchCts?.Cancel(); _bulkCatSearchCts?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

