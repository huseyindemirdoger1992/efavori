        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleDataChanged;
        _searchCts?.Cancel(); _searchCts?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

