    // ═══════════════════════ TOPLU İŞLEM (yalnızca SuperAdmin) ═══════════════════════
    private async Task OpenBulk(string action)
    {
        if (!IsAdmin || !_selectedIds.Any()) return;
        _bulkAction = action;
        await ShowModal("bulkModal");
    }

    private async Task ApplyBulk()
    {
        if (!IsAdmin || _isProcessing || !_selectedIds.Any()) return;
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            var ids = _selectedIds.ToList();
            var now = DateTime.UtcNow;

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            foreach (var chunk in Chunk(ids, 500))
            {
                var items = await db.Products.Where(p => chunk.Contains(p.Id)).ToListAsync(_cts.Token);
                foreach (var p in items)
                {
                    switch (_bulkAction)
                    {
                        case "delete": p.IsDeleted = new IsDeleted { IsDeletedStatu = true, DeletedAtDate = now }; break;
                        case "publish": p.PublishStatus = true; p.UpdatedAt = now; break;
                        case "unpublish": p.PublishStatus = false; p.UpdatedAt = now; break;
                        case "activate": p.IsActive = true; p.UpdatedAt = now; break;
                        case "deactivate": p.IsActive = false; p.UpdatedAt = now; break;
                    }
                }
                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("bulkModal");
            var count = ids.Count;
            ClearSelection();
            _isProcessing = false;

            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"Bulk:{_bulkAction} ({count})");
            await Notify("success", "Tamamlandı", $"{count} ürüne '{BulkActionText(_bulkAction)}' uygulandı.");
            await LoadPageAsync(recount: true);
        }
        catch (Exception ex)
        {
            await LogError("ApplyBulk", ex);
            await Notify("danger", "Hata", "Toplu işlem sırasında bir sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ═══════════════════════ ORTAK KATEGORİ ARAMA MOTORU (sunucu-taraflı) ═══════════════════════
    // 100K+ kategoride RAM'e çekmez → yalnızca eşleşen sonuçları DB'den alır
    // Ancestor zincirini batch olarak çeker → derinlik ve tam yol hesaplar
    private async Task<List<CategorySearchItem>> SearchCategoriesAsync(
        _ApplicationConnectionDb db, string term, bool onlyWithProducts, int maxResults = 50)
    {
        IQueryable<CategoriesTr> q = db.CategoriesTr.AsNoTracking();

        // Arama terimi
        if (!string.IsNullOrWhiteSpace(term))
        {
            var t = term.Trim();
            q = q.Where(c => c.Name != null && c.Name.Contains(t));
        }

        // Yalnızca ürün içeren kategoriler (filtre modu)
        if (onlyWithProducts)
        {
            var productQuery = db.Products.AsNoTracking()
                .Where(p => p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true);
            if (!IsAdmin)
                productQuery = productQuery.Where(p => p.UserId == (use != null ? use.Id : Guid.Empty));

            var catIdsWithProducts = db.ProductCategories.AsNoTracking()
                .Where(pc => productQuery.Any(p => p.Id == pc.ProductId))
                .Select(pc => pc.CategoryId).Distinct();

            q = q.Where(c => catIdsWithProducts.Contains(c.Id));
        }

        // Sonuçları al (sınırlı)
        var raw = await q.OrderBy(c => c.DepartmentName).ThenBy(c => c.Name).Take(maxResults)
            .Select(c => new { c.Id, c.Name, c.DepartmentName, c.ParentCategoryId })
            .ToListAsync(_cts.Token);

        if (!raw.Any()) return new List<CategorySearchItem>();

        // ── Ürün sayılarını hesapla (yalnızca onlyWithProducts modunda) ──
        var rawIds = raw.Select(r => r.Id).ToList();
        var productCountMap = new Dictionary<int, int>();
        if (onlyWithProducts)
        {
            var productQuery2 = db.Products.AsNoTracking()
                .Where(p => p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true);
            if (!IsAdmin)
                productQuery2 = productQuery2.Where(p => p.UserId == (use != null ? use.Id : Guid.Empty));

            var counts = await db.ProductCategories.AsNoTracking()
                .Where(pc => rawIds.Contains(pc.CategoryId) && productQuery2.Any(p => p.Id == pc.ProductId))
                .GroupBy(pc => pc.CategoryId)
                .Select(g => new { CategoryId = g.Key, Count = g.Count() })
                .ToListAsync(_cts.Token);
            foreach (var c in counts) productCountMap[c.CategoryId] = c.Count;
        }

        // ── Derinlik & Tam Yol: ancestor zincirini batch olarak yükle ──
        var parentMap = new Dictionary<int, int?>(); // Id → ParentCategoryId
        var nameMap = new Dictionary<int, string>(); // Id → Name

        foreach (var r in raw)
        {
            parentMap[r.Id] = r.ParentCategoryId;
            nameMap[r.Id] = r.Name ?? "(İsimsiz)";
        }

        // Henüz yüklenmemiş parent ID'lerini topla ve iteratif olarak çek (maks ~10 seviye)
        var missingParentIds = raw
            .Where(r => r.ParentCategoryId.HasValue && !parentMap.ContainsKey(r.ParentCategoryId.Value))
            .Select(r => r.ParentCategoryId!.Value).Distinct().ToList();

        int safetyCounter = 0;
        while (missingParentIds.Any() && safetyCounter++ < 15)
        {
            var ancestors = await db.CategoriesTr.AsNoTracking()
                .Where(c => missingParentIds.Contains(c.Id))
                .Select(c => new { c.Id, c.Name, c.DepartmentName, c.ParentCategoryId })
                .ToListAsync(_cts.Token);

            foreach (var a in ancestors)
            {
                parentMap[a.Id] = a.ParentCategoryId;
                nameMap[a.Id] = !string.IsNullOrWhiteSpace(a.DepartmentName) && a.ParentCategoryId == null
                    ? $"{a.DepartmentName} > {a.Name ?? "(İsimsiz)"}"
                    : a.Name ?? "(İsimsiz)";
            }

            missingParentIds = ancestors
                .Where(a => a.ParentCategoryId.HasValue && !parentMap.ContainsKey(a.ParentCategoryId.Value))
                .Select(a => a.ParentCategoryId!.Value).Distinct().ToList();
        }

        // ── Alt kategorisi olup olmadığını toplu kontrol et ──
        var hasChildrenSet = new HashSet<int>();
        if (rawIds.Count <= 100) // Az sonuçta toplu sorgu
        {
            var childCheck = await db.CategoriesTr.AsNoTracking()
                .Where(c => c.ParentCategoryId.HasValue && rawIds.Contains(c.ParentCategoryId.Value))
                .Select(c => c.ParentCategoryId!.Value).Distinct().ToListAsync(_cts.Token);
            hasChildrenSet = childCheck.ToHashSet();
        }

        // ── Sonuç listesini oluştur ──
        var results = new List<CategorySearchItem>();
        foreach (var r in raw)
        {
            // Tam yolu oluştur (kök → ... → bu kategori)
            var pathParts = new List<string>();
            int? currentId = r.Id;
            int depth = 0;
            while (currentId.HasValue && depth < 20)
            {
                if (nameMap.TryGetValue(currentId.Value, out var n))
                    pathParts.Insert(0, n);
                currentId = parentMap.GetValueOrDefault(currentId.Value);
                if (currentId.HasValue) depth++;
            }

            var displayName = r.Name ?? "(İsimsiz)";
            if (depth == 0 && !string.IsNullOrWhiteSpace(r.DepartmentName))
                displayName = $"{r.DepartmentName} > {displayName}";

            results.Add(new CategorySearchItem
            {
                Id = r.Id,
                Name = displayName,
                FullPath = string.Join(" > ", pathParts),
                Depth = depth,
                HasChildren = hasChildrenSet.Contains(r.Id),
                ProductCount = productCountMap.GetValueOrDefault(r.Id)
            });
        }

        return results.OrderBy(r => r.FullPath).ToList();
    }

    // ═══════════════════════ KATEGORİ FİLTRE SEÇİCİ (Dropdown Select) ═══════════════════════
    // İlk açılışta ürünü olan tüm kategorileri TEK SEFERDE yükler, sonra istemci-taraflı filtreler
    private async Task ToggleFilterCatDropdown()
    {
        if (_filterCatDropdownOpen)
        {
            _filterCatDropdownOpen = false;
            _filterCatInternalSearch = string.Empty;
            return;
        }

        _filterCatDropdownOpen = true;

        // İlk açılışta lazy yükle
        if (!_filterCatItemsLoaded)
            await LoadFilterCatItems();
    }

    private async Task LoadFilterCatItems()
    {
        _filterCatItemsLoading = true; StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _filterCatItems = await SearchCategoriesAsync(db, term: "", onlyWithProducts: true, maxResults: 5000);
            _filterCatItemsLoaded = true;
        }
        catch (Exception ex) { await LogError("LoadFilterCatItems", ex); }
        finally { _filterCatItemsLoading = false; StateHasChanged(); }
    }

    private List<CategorySearchItem> GetFilteredCatItems()
    {
        if (string.IsNullOrWhiteSpace(_filterCatInternalSearch))
            return _filterCatItems;

        var term = _filterCatInternalSearch.Trim().ToLowerInvariant();
        return _filterCatItems.Where(c => c.Name.ToLowerInvariant().Contains(term)
            || c.FullPath.ToLowerInvariant().Contains(term)).ToList();
    }

