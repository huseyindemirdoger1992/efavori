    // ═══════════════════════ TOPLU KATEGORİ DEĞİŞTİRME ═══════════════════════
    private async Task OpenBulkCategory()
    {
        if (!IsAdmin || !_selectedIds.Any()) return;
        _bulkSelectedCategoryId = null;
        _bulkSelectedCategoryPath = string.Empty;
        _bulkCatSearchTerm = string.Empty;
        _bulkCatResults.Clear();
        await ShowModal("bulkCategoryModal");
    }

    private async Task OnBulkCatSearchInput(ChangeEventArgs e)
    {
        _bulkCatSearchTerm = e.Value?.ToString() ?? string.Empty;

        if (_bulkCatSearchTerm.Trim().Length < 2)
        {
            _bulkCatResults.Clear();
            StateHasChanged();
            return;
        }

        // Debounce
        _bulkCatSearchCts?.Cancel();
        _bulkCatSearchCts = new CancellationTokenSource();
        var tok = _bulkCatSearchCts.Token;
        try { await Task.Delay(300, tok); } catch { return; }
        if (tok.IsCancellationRequested) return;

        _bulkCatLoading = true; StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _bulkCatResults = await SearchCategoriesAsync(db, _bulkCatSearchTerm, onlyWithProducts: false, maxResults: 50);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { await LogError("BulkCatSearch", ex); }
        finally { _bulkCatLoading = false; StateHasChanged(); }
    }

    private void SelectBulkCategory(CategorySearchItem cat)
    {
        _bulkSelectedCategoryId = cat.Id;
        _bulkSelectedCategoryPath = cat.FullPath;
    }

    private async Task ApplyBulkCategory()
    {
        if (!IsAdmin || _isProcessing || !_selectedIds.Any() || !_bulkSelectedCategoryId.HasValue) return;
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            var ids = _selectedIds.ToList();
            var catId = _bulkSelectedCategoryId.Value;
            var now = DateTime.UtcNow;

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            foreach (var chunk in Chunk(ids, 500))
            {
                // Mevcut primary kategori kayıtlarını bul
                var existingPrimaries = await db.ProductCategories
                    .Where(pc => chunk.Contains(pc.ProductId) && pc.IsPrimary)
                    .ToListAsync(_cts.Token);

                // Ürünlerin mevcut primary'lerini sil
                db.ProductCategories.RemoveRange(existingPrimaries);

                // Yeni primary kategori ata
                foreach (var pid in chunk)
                {
                    db.ProductCategories.Add(new ProductCategories
                    {
                        Id = Guid.NewGuid(),
                        ProductId = pid,
                        CategoryId = catId,
                        IsPrimary = true,
                        CreatedAt = now
                    });
                }

                // Ürünlerin UpdatedAt güncelle
                var products = await db.Products.Where(p => chunk.Contains(p.Id)).ToListAsync(_cts.Token);
                foreach (var p in products) p.UpdatedAt = now;

                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("bulkCategoryModal");
            var count = ids.Count;
            ClearSelection();
            _isProcessing = false;

            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkCategory ({count}) → CatId:{catId}");
            await Notify("success", "Tamamlandı", $"{count} ürünün ana kategorisi '{_bulkSelectedCategoryPath}' olarak değiştirildi.");
            await LoadPageAsync(recount: true);
        }
        catch (Exception ex)
        {
            await LogError("ApplyBulkCategory", ex);
            await Notify("danger", "Hata", "Toplu kategori değişimi sırasında bir sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ═══════════════════════ TOPLU STOK GÜNCELLEME ═══════════════════════
    private async Task OpenBulkStock()
    {
        if (!IsAdmin || !_selectedIds.Any()) return;
        _bulkStockQuantity = 0;
        _bulkStockMode = "set";
        await ShowModal("bulkStockModal");
    }

    private async Task ApplyBulkStock()
    {
        if (!IsAdmin || _isProcessing || !_selectedIds.Any()) return;
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            var ids = _selectedIds.ToList();
            var now = DateTime.UtcNow;

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            foreach (var chunk in Chunk(ids, 500))
            {
                // Varsayılan varyantları bul
                var defaultVariants = await db.ProductVariants.AsNoTracking()
                    .Where(v => chunk.Contains(v.ProductId) && v.IsDefault
                        && (v.IsDeleted == null || v.IsDeleted.IsDeletedStatu != true))
                    .Select(v => new { v.Id, v.ProductId })
                    .ToListAsync(_cts.Token);

                var variantIds = defaultVariants.Select(v => v.Id).ToList();

                // Mevcut stok kayıtlarını bul
                var existingStocks = await db.ProductStocks
                    .Where(s => variantIds.Contains(s.VariantId))
                    .ToListAsync(_cts.Token);

                var existingVariantIds = existingStocks.Select(s => s.VariantId).ToHashSet();

                foreach (var dv in defaultVariants)
                {
                    var stockRecord = existingStocks.FirstOrDefault(s => s.VariantId == dv.Id);
                    if (stockRecord != null)
                    {
                        // Mevcut kaydı güncelle
                        if (_bulkStockMode == "set")
                            stockRecord.Quantity = _bulkStockQuantity;
                        else
                            stockRecord.Quantity += _bulkStockQuantity;

                        stockRecord.UpdatedAt = now;
                    }
                    else
                    {
                        // Varsayılan depoyu bul (ürünün mağazasına ait)
                        var product = await db.Products.AsNoTracking()
                            .Where(p => p.Id == dv.ProductId)
                            .Select(p => new { p.StoreId })
                            .FirstOrDefaultAsync(_cts.Token);

                        var warehouseId = Guid.Empty;
                        if (product != null)
                        {
                            var wh = await db.Warehouse.AsNoTracking()
                                .Where(w => w.StoreId == product.StoreId && w.IsDefault
                                    && (w.IsDeleted == null || w.IsDeleted.IsDeletedStatu != true))
                                .Select(w => w.Id)
                                .FirstOrDefaultAsync(_cts.Token);
                            if (wh != Guid.Empty) warehouseId = wh;
                            else
                            {
                                // Mağazanın herhangi bir deposu
                                warehouseId = await db.Warehouse.AsNoTracking()
                                    .Where(w => w.StoreId == product.StoreId
                                        && (w.IsDeleted == null || w.IsDeleted.IsDeletedStatu != true))
                                    .Select(w => w.Id)
                                    .FirstOrDefaultAsync(_cts.Token);
                            }
                        }

                        // Yeni stok kaydı oluştur (depo bulunsa)
                        if (warehouseId != Guid.Empty)
                        {
                            db.ProductStocks.Add(new ProductStocks
                            {
                                Id = Guid.NewGuid(),
                                ProductId = dv.ProductId,
                                VariantId = dv.Id,
                                WarehouseId = warehouseId,
                                Quantity = _bulkStockQuantity,
                                TrackStock = true,
                                StockStatus = _bulkStockQuantity > 0 ? "InStock" : "OutOfStock",
                                UpdatedAt = now
                            });
                        }
                    }
                }

                // Ürünlerin UpdatedAt güncelle
                var products2 = await db.Products.Where(p => chunk.Contains(p.Id)).ToListAsync(_cts.Token);
                foreach (var p in products2) p.UpdatedAt = now;

                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("bulkStockModal");
            var count = ids.Count;
            ClearSelection();
            _isProcessing = false;

            var modeText = _bulkStockMode == "set" ? "olarak atandı" : "kadar eklendi";
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkStock:{_bulkStockMode} ({count}) → {_bulkStockQuantity}");
            await Notify("success", "Tamamlandı", $"{count} ürünün stok değeri {_bulkStockQuantity} {modeText}.");
            await LoadPageAsync(recount: true);
        }
        catch (Exception ex)
        {
            await LogError("ApplyBulkStock", ex);
            await Notify("danger", "Hata", "Toplu stok güncelleme sırasında bir sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ═══════════════════════ TEKLİ SİL ═══════════════════════
    private async Task OpenDelete(ProductRow r)
    {
        if (!(IsAdmin || r.UserId == use?.Id)) return;
        _deleteTarget = r;
        await ShowModal("deleteModal");
    }

    private async Task DeleteConfirmed()
    {
        if (_isProcessing || _deleteTarget == null) return;
        if (!(IsAdmin || _deleteTarget.UserId == use?.Id)) return;
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.Products.FirstOrDefaultAsync(p => p.Id == _deleteTarget.Id, _cts.Token);
            if (entity != null)
            {
                entity.IsDeleted = new IsDeleted { IsDeletedStatu = true, DeletedAtDate = DateTime.UtcNow };
                await db.SaveChangesAsync(_cts.Token);
            }
            await HideModal("deleteModal");
            _selectedIds.Remove(_deleteTarget.Id);
            _deleteTarget = null;
            _isProcessing = false;

            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Delete");
            await Notify("success", "Silindi", "Ürün başarıyla silindi.");
            await LoadPageAsync(recount: true);
        }
        catch (Exception ex)
        {
            await LogError("DeleteConfirmed", ex);
            await Notify("danger", "Hata", "Silme sırasında bir sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ═══════════════════════ DETAY (tek ürün → ucuz) ═══════════════════════
    private async Task OpenDetail(Guid id)
    {
        _detail = null; _detailLoading = true;
        await ShowModal("detailModal");
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var p = await db.Products.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id, _cts.Token);
            if (p == null) { _detailLoading = false; return; }

            var vm = new DetailVm
            {
                Id = p.Id,
                Name = p.Name ?? "(İsimsiz)",
                ProductType = p.ProductType,
                PublishStatus = p.PublishStatus,
                IsActive = p.IsActive,
                ShortDescription = p.ShortDescription,
                CreatedAt = p.CreatedAt,
                CoverUrl = NoImage,
                ViewCount = p.InteractionCounts?.ViewCount ?? 0,
                ShareCount = p.InteractionCounts?.ShareCount ?? 0,
                RecommendCount = p.InteractionCounts?.RecommendCount ?? 0
            };

            if (p.CoverMediaId.HasValue)
                vm.CoverUrl = await db.Media.AsNoTracking().Where(m => m.Id == p.CoverMediaId.Value)
                    .Select(m => m.FileUrl).FirstOrDefaultAsync(_cts.Token) ?? NoImage;

            if (p.BrandId.HasValue)
                vm.BrandName = await db.Brands.AsNoTracking().Where(b => b.Id == p.BrandId.Value)
                    .Select(b => b.Name).FirstOrDefaultAsync(_cts.Token);

            var prefCur = string.IsNullOrEmpty(use?.Currency) ? "TRY" : use!.Currency!;
            var price = await db.ProductPrices.AsNoTracking()
                .Where(pr => pr.ProductId == id && pr.EffectiveTo == null)
                .Select(pr => new { pr.Price, pr.DiscountedPrice, pr.Currency }).ToListAsync(_cts.Token);
            var chosen = price.FirstOrDefault(x => x.Currency == prefCur) ?? price.FirstOrDefault();
            vm.PriceText = chosen == null ? "—" : FormatPrice(chosen.Price, chosen.DiscountedPrice, chosen.Currency ?? prefCur);

            vm.TotalStock = await db.ProductStocks.AsNoTracking().Where(s => s.ProductId == id).SumAsync(s => (int?)s.Quantity, _cts.Token) ?? 0;

            var catIds = await db.ProductCategories.AsNoTracking().Where(c => c.ProductId == id).Select(c => c.CategoryId).ToListAsync(_cts.Token);
            if (catIds.Any())
                vm.Categories = await db.CategoriesTr.AsNoTracking().Where(c => catIds.Contains(c.Id))
                    .Select(c => string.IsNullOrEmpty(c.DepartmentName) ? c.Name! : c.DepartmentName + " > " + c.Name).ToListAsync(_cts.Token);

            var galleryMediaIds = await db.ItemGallery.AsNoTracking()
                .Where(g => g.ItemId == id && g.ItemType == "ProductGallery" && (g.IsDelete == null || g.IsDelete == false) && g.MediaId != null)
                .Select(g => g.MediaId!.Value).Take(12).ToListAsync(_cts.Token);
            if (galleryMediaIds.Any())
                vm.Gallery = await db.Media.AsNoTracking().Where(m => galleryMediaIds.Contains(m.Id) && m.FileUrl != null)
                    .Select(m => m.FileUrl!).ToListAsync(_cts.Token);

            if (IsAdmin)
            {
                vm.StoreName = await db.Stores.AsNoTracking().Where(s => s.Id == p.StoreId).Select(s => s.Name).FirstOrDefaultAsync(_cts.Token);
                var u = await db.Users.AsNoTracking().Where(x => x.Id == p.UserId)
                    .Select(x => new { x.FirstName, x.LastName, Email = x.ContactInformation!.Email }).FirstOrDefaultAsync(_cts.Token);
                if (u != null)
                {
                    var name = $"{u.FirstName} {u.LastName}".Trim();
                    vm.UploaderName = !string.IsNullOrWhiteSpace(name) ? name : u.Email;
                }
            }

            _detail = vm;
        }
        catch (Exception ex) { await LogError("OpenDetail", ex); }
        finally { _detailLoading = false; StateHasChanged(); }
    }

