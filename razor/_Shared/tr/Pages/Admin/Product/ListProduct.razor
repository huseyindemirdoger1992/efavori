@code {
    // ─────────────── Sabitler ───────────────
    private const string PAGE_TITLE = "Ürün Listesi";
    private const string ENTITY_NAME = "Products";

    [Parameter] public Users? use { get; set; }
    [Parameter] public string? Language { get; set; }

    private bool IsAdmin => string.Equals(use?.UsersType, "SuperAdmin", StringComparison.OrdinalIgnoreCase);

    // ─────────────── Çekirdek altyapı ───────────────
    private readonly CancellationTokenSource _cts = new();
    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _disposed, _isInitialized, _isLoading, _isProcessing;
    private Notification? _notificationRef;

    // ─────────────── Liste + sayfalama durumu ───────────────
    private List<ProductRow> _rows = new();
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private int _totalPages = 1;

    // ─────────────── AI İstatistik Sayaçları ───────────────
    private int _statTotal;
    private int _statAiManagedTrue;
    private int _statAiManagedFalse;
    private int _statAiStatusNull;
    private int _statAiStatusTrue;
    private int _statAiStatusFalse;

    // ─────────────── Filtreler ───────────────
    private string _searchTerm = string.Empty;
    private string _filterType = string.Empty;
    private string _filterStatus = string.Empty;
    private string _filterActive = string.Empty;
    private string _filterStoreId = string.Empty;
    private string _filterAiStat = string.Empty; // "", "ai_on", "ai_off", "status_null", "status_true", "status_false"
    private string _sort = "new";
    private CancellationTokenSource? _searchCts;

    // ─────────────── Etkileşim Filtreleri ───────────────
    private bool _showAdvancedFilters;
    private int? _filterViewCountMin;
    private int? _filterViewCountMax;
    private int? _filterShareCountMin;
    private int? _filterShareCountMax;
    private int? _filterRecommendCountMin;
    private int? _filterRecommendCountMax;

    // ─────────────── Sayfa-içi toplu lookup'lar (N+1 yok) ───────────────
    private readonly Dictionary<Guid, string> _coverMap = new();   // CoverMediaId → FileUrl
    private readonly Dictionary<Guid, string> _brandMap = new();   // BrandId → Ad
    private readonly Dictionary<Guid, string> _storeMap = new();   // StoreId → Ad
    private readonly Dictionary<Guid, string> _userMap = new();    // UserId → Yükleyen
    private readonly Dictionary<Guid, string> _skuMap = new();     // ProductId → varsayılan SKU
    private readonly Dictionary<Guid, int> _stockMap = new();      // ProductId → toplam stok
    private readonly Dictionary<Guid, (decimal price, decimal? disc, string cur)> _priceMap = new();
    private readonly Dictionary<Guid, (int view, int share, int recommend)> _InteractionCountsMap = new(); // Etkileşim sayaçları

    // ─────────────── Seçim (toplu işlem) ───────────────
    private readonly HashSet<Guid> _selectedIds = new();
    private bool _pageAllSelected;
    private string _bulkAction = string.Empty;

    // ─────────────── Mağaza filtresi referansı (admin) ───────────────
    private List<Store> _stores = new();

    // ─────────────── Modal state ───────────────
    private ProductRow? _deleteTarget;
    private DetailVm? _detail;
    private bool _detailLoading;

    // ─────────────── Kategori Filtresi (Dropdown Select) ───────────────
    private int? _filterCategoryId;
    private string _filterCategoryName = string.Empty;
    private List<CategorySearchItem> _filterCatItems = new();  // Tüm ürünlü kategoriler (tek seferde yüklenir)
    private bool _filterCatItemsLoading;
    private bool _filterCatItemsLoaded;
    private bool _filterCatDropdownOpen;
    private string _filterCatInternalSearch = string.Empty;    // Dropdown içi arama

    // ─────────────── Toplu Kategori Değiştirme ───────────────
    private string _bulkCatSearchTerm = string.Empty;
    private List<CategorySearchItem> _bulkCatResults = new();
    private bool _bulkCatLoading;
    private int? _bulkSelectedCategoryId;
    private string _bulkSelectedCategoryPath = string.Empty;
    private CancellationTokenSource? _bulkCatSearchCts;

    // ─────────────── Toplu Stok Güncelleme ───────────────
    private int _bulkStockQuantity;
    private string _bulkStockMode = "set"; // "set" veya "add"

    private const string NoImage = "https://efavori.com/_files/main/NoImage.png";

    // ═══════════════════════ YAŞAM DÖNGÜSÜ ═══════════════════════
    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleDataChanged;
        if (IsAdmin) await LoadStores();
        await LoadAiStatsAsync();
        await LoadPageAsync(recount: true);
    }

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || entityName != ENTITY_NAME) return;
        _filterCatItemsLoaded = false; // Ürün değiştiğinde kategori-ürün sayıları güncellenmeli
        await InvokeAsync(async () => { await LoadAiStatsAsync(); await LoadPageAsync(recount: true); StateHasChanged(); });
    }

    // ═══════════════════════ MAĞAZA REFERANSI (admin) ═══════════════════════
    private async Task LoadStores()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _stores = await db.Stores.AsNoTracking()
                .Where(s => s.IsDeleted == null || s.IsDeleted.IsDeletedStatu != true)
                .OrderBy(s => s.Name)
                .Select(s => new Store { Id = s.Id, Name = s.Name })
                .ToListAsync(_cts.Token);
        }
        catch (Exception ex) { await LogError("LoadStores", ex); }
    }

    // ═══════════════════════ Aİ İSTATİSTİK SAYAÇLARI ═══════════════════════
    private async Task LoadAiStatsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var q = db.Products.AsNoTracking()
                .Where(p => p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true);

            if (!IsAdmin)
            {
                var uid = use?.Id ?? Guid.Empty;
                q = q.Where(p => p.UserId == uid);
            }

            // Tek sorgu ile tüm istatistikleri çek → 6 ayrı COUNT yerine GROUP BY benzeri projeksiyon
            var stats = await q.Select(p => new
            {
                AiManaged = p.IsAiManaged,
                AiStatus = p.AiContentStatus
            }).ToListAsync(_cts.Token);

            _statTotal = stats.Count;
            _statAiManagedTrue = stats.Count(s => s.AiManaged == true);
            _statAiManagedFalse = stats.Count(s => s.AiManaged != true); // null veya false → AI kapalı
            _statAiStatusNull = stats.Count(s => s.AiStatus == null);
            _statAiStatusTrue = stats.Count(s => s.AiStatus == true);
            _statAiStatusFalse = stats.Count(s => s.AiStatus == false);
        }
        catch (Exception ex) { await LogError("LoadAiStats", ex); }
    }

    // ═══════════════════════ SAYFA YÜKLEME (sunucu-taraflı) ═══════════════════════
    // recount=true → filtre/arama değişti, toplam yeniden sayılır + sayfa 1'e döner mantığı çağıran tarafta
    private async Task LoadPageAsync(bool recount)
    {
        try
        {
            _isLoading = true; StateHasChanged();
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var q = BuildQuery(db);

            if (recount)
            {
                _totalCount = await q.CountAsync(_cts.Token);
                _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));
                if (_page > _totalPages) _page = _totalPages;
                if (_page < 1) _page = 1;
            }

            q = ApplySort(q);

            // Yalnızca o sayfanın hafif projeksiyonu — açıklama (büyük HTML) ÇEKİLMEZ
            _rows = await q
                .Skip((_page - 1) * _pageSize).Take(_pageSize)
                .Select(p => new ProductRow
                {
                    Id = p.Id,
                    Name = p.Name,
                    ProductType = p.ProductType,
                    PublishStatus = p.PublishStatus,
                    IsActive = p.IsActive,
                    IsApprovedByAdmin = p.IsApprovedByAdmin,
                    CreatedAt = p.CreatedAt,
                    UpdatedAt = p.UpdatedAt,
                    CoverMediaId = p.CoverMediaId,
                    BrandId = p.BrandId,
                    StoreId = p.StoreId,
                    UserId = p.UserId
                })
                .ToListAsync(_cts.Token);

            await LoadRelatedLookups(db, _rows);
            RecalcPageSelection();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await LogError("LoadPageAsync", ex);
            await Notify("danger", "Hata", "Liste yüklenirken bir sorun oluştu.");
        }
        finally { _isLoading = false; StateHasChanged(); }
    }

    // Rol + filtre kapsamlı temel sorgu
    private IQueryable<Products> BuildQuery(_ApplicationConnectionDb db)
    {
        var q = db.Products.AsNoTracking()
            .Where(p => p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true);

        // ROL: admin değilse yalnızca kendi ürünleri
        if (!IsAdmin)
        {
            var uid = use?.Id ?? Guid.Empty;
            q = q.Where(p => p.UserId == uid);
        }
        else if (!string.IsNullOrEmpty(_filterStoreId) && Guid.TryParse(_filterStoreId, out var sid))
        {
            q = q.Where(p => p.StoreId == sid);
        }

        // Arama (ad veya SKU)
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            q = q.Where(p => (p.Name != null && p.Name.Contains(term))
                || db.ProductVariants.Any(v => v.ProductId == p.Id && v.Sku != null && v.Sku.Contains(term)));
        }

        // Ürün tipi
        if (!string.IsNullOrEmpty(_filterType))
            q = q.Where(p => p.ProductType == _filterType);

        // ── DURUM FİLTRESİ (DÜZELTİLDİ) ──
        // PublishStatus: true=Yayında, false=Taslak, null=Onay Bekliyor
        // IsApprovedByAdmin: true=Onaylı, false=Reddedildi, null=Bekliyor
        if (!string.IsNullOrEmpty(_filterStatus))
        {
            switch (_filterStatus)
            {
                case "Published":
                    q = q.Where(p => p.PublishStatus == true);
                    break;
                case "Draft":
                    q = q.Where(p => p.PublishStatus == false);
                    break;
                case "PendingApproval":
                    q = q.Where(p => p.PublishStatus == null);
                    break;
                case "Rejected":
                    q = q.Where(p => p.IsApprovedByAdmin == false);
                    break;
            }
        }

        // Aktiflik
        if (_filterActive == "active") q = q.Where(p => p.IsActive);
        else if (_filterActive == "passive") q = q.Where(p => !p.IsActive);

        // AI istatistik kartı filtresi
        if (_filterAiStat == "ai_on") q = q.Where(p => p.IsAiManaged == true);
        else if (_filterAiStat == "ai_off") q = q.Where(p => p.IsAiManaged != true);
        else if (_filterAiStat == "status_null") q = q.Where(p => p.AiContentStatus == null);
        else if (_filterAiStat == "status_true") q = q.Where(p => p.AiContentStatus == true);
        else if (_filterAiStat == "status_false") q = q.Where(p => p.AiContentStatus == false);

        // ── ETKİLEŞİM FİLTRELERİ ──
        if (_filterViewCountMin.HasValue)
            q = q.Where(p => (p.InteractionCounts != null ? p.InteractionCounts.ViewCount : 0) >= _filterViewCountMin.Value);
        if (_filterViewCountMax.HasValue)
            q = q.Where(p => (p.InteractionCounts != null ? p.InteractionCounts.ViewCount : 0) <= _filterViewCountMax.Value);

        if (_filterShareCountMin.HasValue)
            q = q.Where(p => (p.InteractionCounts != null ? p.InteractionCounts.ShareCount : 0) >= _filterShareCountMin.Value);
        if (_filterShareCountMax.HasValue)
            q = q.Where(p => (p.InteractionCounts != null ? p.InteractionCounts.ShareCount : 0) <= _filterShareCountMax.Value);

        if (_filterRecommendCountMin.HasValue)
            q = q.Where(p => (p.InteractionCounts != null ? p.InteractionCounts.RecommendCount : 0) >= _filterRecommendCountMin.Value);
        if (_filterRecommendCountMax.HasValue)
            q = q.Where(p => (p.InteractionCounts != null ? p.InteractionCounts.RecommendCount : 0) <= _filterRecommendCountMax.Value);

        // ── KATEGORİ FİLTRESİ ──
        if (_filterCategoryId.HasValue)
        {
            var catId = _filterCategoryId.Value;
            q = q.Where(p => db.ProductCategories.Any(pc => pc.ProductId == p.Id && pc.CategoryId == catId));
        }

        return q;
    }

    private IQueryable<Products> ApplySort(IQueryable<Products> q) => _sort switch
    {
        "old" => q.OrderBy(p => p.CreatedAt).ThenBy(p => p.Id),
        "name" => q.OrderBy(p => p.Name).ThenBy(p => p.Id),
        "upd" => q.OrderByDescending(p => p.UpdatedAt ?? p.CreatedAt).ThenBy(p => p.Id),
        "view_desc" => q.OrderByDescending(p => p.InteractionCounts != null ? p.InteractionCounts.ViewCount ?? 0 : 0).ThenBy(p => p.Id),
        "share_desc" => q.OrderByDescending(p => p.InteractionCounts != null ? p.InteractionCounts.ShareCount ?? 0 : 0).ThenBy(p => p.Id),
        "recommend_desc" => q.OrderByDescending(p => p.InteractionCounts != null ? p.InteractionCounts.RecommendCount ?? 0 : 0).ThenBy(p => p.Id),
        _ => q.OrderByDescending(p => p.CreatedAt).ThenBy(p => p.Id)
    };

    // Sayfadaki kimlikler için ilişkili verileri TEK toplu sorgularla doldur (N+1 yok)
    private async Task LoadRelatedLookups(_ApplicationConnectionDb db, List<ProductRow> rows)
    {
        _coverMap.Clear(); _brandMap.Clear(); _storeMap.Clear(); _userMap.Clear();
        _skuMap.Clear(); _stockMap.Clear(); _priceMap.Clear(); _InteractionCountsMap.Clear();
        if (!rows.Any()) return;

        var ids = rows.Select(r => r.Id).ToList();
        var coverIds = rows.Where(r => r.CoverMediaId.HasValue).Select(r => r.CoverMediaId!.Value).Distinct().ToList();
        var brandIds = rows.Where(r => r.BrandId.HasValue).Select(r => r.BrandId!.Value).Distinct().ToList();

        // Kapak görselleri
        if (coverIds.Any())
        {
            var media = await db.Media.AsNoTracking()
                .Where(m => coverIds.Contains(m.Id))
                .Select(m => new { m.Id, m.FileUrl }).ToListAsync(_cts.Token);
            foreach (var m in media) if (!string.IsNullOrEmpty(m.FileUrl)) _coverMap[m.Id] = m.FileUrl!;
        }

        // Markalar
        if (brandIds.Any())
        {
            var brands = await db.Brands.AsNoTracking()
                .Where(b => brandIds.Contains(b.Id))
                .Select(b => new { b.Id, b.Name }).ToListAsync(_cts.Token);
            foreach (var b in brands) _brandMap[b.Id] = b.Name ?? "—";
        }

        // Varsayılan varyant SKU
        var skus = await db.ProductVariants.AsNoTracking()
            .Where(v => ids.Contains(v.ProductId) && v.IsDefault && (v.IsDeleted == null || v.IsDeleted.IsDeletedStatu != true))
            .Select(v => new { v.ProductId, v.Sku }).ToListAsync(_cts.Token);
        foreach (var s in skus) if (!_skuMap.ContainsKey(s.ProductId) && !string.IsNullOrEmpty(s.Sku)) _skuMap[s.ProductId] = s.Sku!;

        // Toplam stok (ürün başına tüm depo satırlarının toplamı)
        var stocks = await db.ProductStocks.AsNoTracking()
            .Where(s => ids.Contains(s.ProductId))
            .Select(s => new { s.ProductId, s.Quantity }).ToListAsync(_cts.Token);
        foreach (var grp in stocks.GroupBy(s => s.ProductId)) _stockMap[grp.Key] = grp.Sum(x => x.Quantity);

        // Güncel fiyat (EffectiveTo == null) — kullanıcı para birimi tercih edilir
        var prices = await db.ProductPrices.AsNoTracking()
            .Where(pr => ids.Contains(pr.ProductId) && pr.EffectiveTo == null)
            .Select(pr => new { pr.ProductId, pr.Price, pr.DiscountedPrice, pr.Currency }).ToListAsync(_cts.Token);
        var prefCur = string.IsNullOrEmpty(use?.Currency) ? "TRY" : use!.Currency!;
        foreach (var grp in prices.GroupBy(p => p.ProductId))
        {
            var chosen = grp.FirstOrDefault(x => x.Currency == prefCur) ?? grp.First();
            _priceMap[grp.Key] = (chosen.Price, chosen.DiscountedPrice, chosen.Currency ?? prefCur);
        }

        // Etkileşim sayaçları (Products.InteractionCounts owned type → doğrudan Products tablosundan)
        var InteractionCountss = await db.Products.AsNoTracking()
            .Where(p => ids.Contains(p.Id))
            .Select(p => new
            {
                p.Id,
                View = p.InteractionCounts != null ? p.InteractionCounts.ViewCount ?? 0 : 0,
                Share = p.InteractionCounts != null ? p.InteractionCounts.ShareCount ?? 0 : 0,
                Recommend = p.InteractionCounts != null ? p.InteractionCounts.RecommendCount ?? 0 : 0
            }).ToListAsync(_cts.Token);
        foreach (var i in InteractionCountss) _InteractionCountsMap[i.Id] = (i.View, i.Share, i.Recommend);

        // SuperAdmin: mağaza + yükleyen adları
        if (IsAdmin)
        {
            var storeIds = rows.Select(r => r.StoreId).Distinct().ToList();
            var stores = await db.Stores.AsNoTracking()
                .Where(s => storeIds.Contains(s.Id))
                .Select(s => new { s.Id, s.Name }).ToListAsync(_cts.Token);
            foreach (var s in stores) _storeMap[s.Id] = string.IsNullOrWhiteSpace(s.Name) ? "(İsimsiz)" : s.Name!;

            var userIds = rows.Select(r => r.UserId).Distinct().ToList();
            var users = await db.Users.AsNoTracking()
                .Where(u => userIds.Contains(u.Id))
                .Select(u => new { u.Id, u.FirstName, u.LastName, Email = u.ContactInformation!.Email })
                .ToListAsync(_cts.Token);
            foreach (var u in users)
            {
                var name = $"{u.FirstName} {u.LastName}".Trim();
                _userMap[u.Id] = !string.IsNullOrWhiteSpace(name) ? name : (u.Email ?? u.Id.ToString());
            }
        }
    }

