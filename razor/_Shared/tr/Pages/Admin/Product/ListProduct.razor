    {
        "Simple" => "Basit",
        "Variant" => "Varyantlı",
        "Digital" => "Dijital",
        "Service" => "Hizmet",
        "Bundle" => "Paket",
        "External" => "Harici",
        _ => t ?? "—"
    };

    private string PublishBadge(string? s) => s switch
    {
        "Published" => "bg-success",
        "Draft" => "bg-secondary",
        "PendingApproval" => "bg-warning text-dark",
        "Rejected" => "bg-danger",
        "Archived" => "bg-dark",
        _ => "bg-secondary"
    };

    private string PublishText(string? s) => s switch
    {
        "Published" => "Yayında",
        "Draft" => "Taslak",
        "PendingApproval" => "Onay Bekliyor",
        "Rejected" => "Reddedildi",
        "Archived" => "Arşiv",
        _ => s ?? "—"
    };

    private string BulkActionText(string a) => a switch
    {
        "delete" => "Silme",
        "publish" => "Yayınlama",
        "unpublish" => "Taslağa Alma",
        "activate" => "Aktifleştirme",
        "deactivate" => "Pasifleştirme",
        _ => a
    };

    private static IEnumerable<List<T>> Chunk<T>(List<T> source, int size)
    {
        for (int i = 0; i < source.Count; i += size)
            yield return source.GetRange(i, Math.Min(size, source.Count - i));
    }

