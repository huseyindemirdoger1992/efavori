<div class="modal fade" id="bulkCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0"><i class="fa fa-folder-open me-1"></i>Toplu Kategori Değiştir</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-light mb-2">
                    Seçili <b>@_selectedIds.Count</b> ürünün ana kategorisi aşağıda seçeceğiniz kategori ile değiştirilecektir.
                    Kategori bulmak için en az 2 karakter yazın.
                </p>

                @* Arama kutusu *@
                <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text"><i class="fa fa-search"></i></span>
                    <input type="text" class="form-control" placeholder="Kategori adı yazarak arayın..."
                           value="@_bulkCatSearchTerm" @oninput="OnBulkCatSearchInput" />
                    @if (_bulkCatLoading)
                    {
                        <span class="input-group-text"><i class="fa fa-spinner fa-spin"></i></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_bulkCatSearchTerm))
                    {
                        <button class="btn btn-secondary" @onclick='() => { _bulkCatSearchTerm = ""; _bulkCatResults.Clear(); }'>
                            <i class="fa fa-times"></i>
                        </button>
                    }
                </div>

                @* Seçili kategori göstergesi *@
                @if (_bulkSelectedCategoryId.HasValue)
                {
                    <div class="alert alert-info py-1 px-2 small mb-2">
                        <i class="fa fa-check-circle me-1"></i>Seçilen: <b>@_bulkSelectedCategoryPath</b>
                        <button class="btn btn-sm p-0 ms-1" @onclick='() => { _bulkSelectedCategoryId = null; _bulkSelectedCategoryPath = ""; }'>
                            <i class="fa fa-times text-danger"></i>
                        </button>
                    </div>
                }

                @* Arama sonuçları *@
                <div style="max-height:360px;overflow-y:auto;" class="border rounded p-1">
                    @if (!_bulkCatResults.Any())
                    {
                        <div class="text-center py-3 text-light small">
                            @if (_bulkCatLoading)
                            {
                                <i class="fa fa-spinner fa-spin me-1"></i> @:Aranıyor...
                            }
                            else if (!string.IsNullOrWhiteSpace(_bulkCatSearchTerm) && _bulkCatSearchTerm.Trim().Length >= 2)
                            {
                                @:Kategori bulunamadı.
                            }
                            else
                            {
                                @:Aramak için en az 2 karakter yazın.
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var cat in _bulkCatResults)
                        {
                            var isSelected = _bulkSelectedCategoryId == cat.Id;
                            <div class="d-flex align-items-center px-2 py-1 rounded @(isSelected ? "bg-primary bg-opacity-10 border border-primary" : "border border-transparent")"
                                 role="button" @onclick="() => SelectBulkCategory(cat)"
                                 style="margin-left:@(cat.Depth * 16)px;">
                                <i class="fa @(cat.HasChildren ? "fa-folder text-warning" : "fa-tag text-light") me-2 small"></i>
                                <div class="flex-grow-1 overflow-hidden">
                                    <span class="small @(isSelected ? "fw-bold text-primary" : "")">@cat.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(cat.FullPath) && cat.FullPath != cat.Name)
                                    {
                                        <div class="text-light small text-truncate" style="font-size:0.65rem;">@cat.FullPath</div>
                                    }
                                </div>
                                @if (cat.Depth + 1 == 1)
                                {
                                    <span class="badge bg-light text-light ms-2 small" style="font-size:0.6rem;">Seviye @(cat.Depth + 1)</span>
                                }
                                @if (cat.Depth + 1 == 2)
                                {
                                    <span class="badge bg-info text-dark ms-2 small" style="font-size:0.6rem;">Seviye @(cat.Depth + 1)</span>
                                }
                                @if (cat.Depth + 1 == 3)
                                {
                                    <span class="badge bg-warning text-dark ms-2 small" style="font-size:0.6rem;">Seviye @(cat.Depth + 1)</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button class="btn btn-primary btn-sm" @onclick="ApplyBulkCategory" disabled="@(_isProcessing || !_bulkSelectedCategoryId.HasValue)">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i>
                    }
                    <span>Kategoriyi Uygula</span>
                </button>
            </div>
        </div>
    </div>
</div>

