@* ============================================================
   ProductHistoryList.razor
   ─────────────────────────────────────────────────────────────
   ✅ Ürün ziyaret geçmişi listeleme sayfası (salt-okunur + silme)
   ✅ Normal kullanıcı: yalnızca kendi geçmişi (UserId == use.Id)
   ✅ SuperAdmin: tüm kullanıcıların geçmişi + ziyaretçi bilgisi
   ✅ Sunucu tarafı sayfalama (her sayfada 10 kayıt, DB'de Skip/Take)
   ✅ Arama TÜM tabloda çalışır (o anki 10'luk sayfada değil)
   ✅ Pencereli sayfalama + "Sayfaya git"
   ✅ Sağda "Detaylar" butonu → modal (ürün bilgileri + kapak görseli)
   ✅ Tekli / toplu / tümünü temizle soft-delete
   ✅ GlobalStateHub broadcast, TakeLogs ile aksiyon loglama
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using data._Product
@using data._Product.ProductHistory
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using System.Globalization

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    // Bu alanı kesinlikle SİLME. Global state'den dil bilgisini alıp yönlendirme için gereklidir.
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",    "Ana Sayfa",       "/"),
        ("fa fa-table",   "Kayıtlar",        "javascript:void(0)"),
        ("fa fa-history", PAGE_TITLE,        "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button class="btn btn-light btn-sm" @onclick="RefreshAsync" disabled="@_isLoading">
        <i class="fa fa-refresh me-sm-1 @(_isLoading ? "fa-spin" : "")"></i>
        <span class="d-none d-sm-inline">Yenile</span>
    </button>

    @if (_selectedIds.Any())
    {
        <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedAsync">
            <i class="fa fa-trash me-sm-1"></i>
            <span class="d-none d-sm-inline">Seçilenleri Sil (@_selectedIds.Count)</span>
        </button>
    }

    <button class="btn btn-outline-warning btn-sm" @onclick="ClearAllHistoryAsync" disabled="@(_totalCount == 0)">
        <i class="fa fa-eraser me-sm-1"></i>
        <span class="d-none d-sm-inline">Tümünü Temizle</span>
    </button>

    <div class="vr mx-1"></div>
    <span class="badge bg-light text-light">
        <i class="fa fa-history me-1"></i>@_totalCount ziyaret
    </span>
</div>

@* ─── Arama ─── *@
<div class="d-flex flex-wrap gap-2 mb-2">
    <div class="input-group input-group-sm flex-fill" style="min-width:14rem;">
        <span class="input-group-text bg-transparent border-secondary text-white">
            <i class="fa fa-search"></i>
        </span>
        <input type="text"
               class="form-control bg-transparent text-light border-secondary"
               placeholder="Ürün adı ara…"
               value="@_searchTerm"
               @oninput="OnSearchInput" />
        @if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                <i class="fa fa-times"></i>
            </button>
        }
    </div>

    @* SuperAdmin: Kullanıcı araması *@
    @if (_isSuperAdmin)
    {
        <div class="input-group input-group-sm" style="min-width:12rem; max-width:18rem;">
            <span class="input-group-text bg-transparent border-secondary text-white">
                <i class="fa fa-user"></i>
            </span>
            <input type="text"
                   class="form-control bg-transparent text-light border-secondary"
                   placeholder="Kullanıcı adı ara…"
                   value="@_userSearchTerm"
                   @oninput="OnUserSearchInput" />
            @if (!string.IsNullOrWhiteSpace(_userSearchTerm))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearUserSearch">
                    <i class="fa fa-times"></i>
                </button>
            }
        </div>
    }

    @* Tarih filtreleri *@
    <div class="input-group input-group-sm" style="max-width:11rem;">
        <span class="input-group-text bg-transparent border-secondary text-white">
            <i class="fa fa-calendar"></i>
        </span>
        <input type="date"
               class="form-control bg-transparent text-light border-secondary"
               value="@_dateFrom?.ToString("yyyy-MM-dd")"
               title="Başlangıç tarihi"
               @onchange="e => { _dateFrom = string.IsNullOrEmpty((string?)e.Value) ? null : DateTime.Parse((string)e.Value!); _ = LoadPageAsync(1); }" />
    </div>
    <div class="input-group input-group-sm" style="max-width:11rem;">
        <span class="input-group-text bg-transparent border-secondary text-white">
            <i class="fa fa-calendar-check-o"></i>
        </span>
        <input type="date"
               class="form-control bg-transparent text-light border-secondary"
               value="@_dateTo?.ToString("yyyy-MM-dd")"
               title="Bitiş tarihi"
               @onchange="e => { _dateTo = string.IsNullOrEmpty((string?)e.Value) ? null : DateTime.Parse((string)e.Value!); _ = LoadPageAsync(1); }" />
    </div>

    @if (_dateFrom.HasValue || _dateTo.HasValue)
    {
        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearDateFilters" title="Tarih filtrelerini temizle">
            <i class="fa fa-times me-1"></i>Tarih
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && _totalCount == 0)
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-eye-slash fa-3x mb-3 d-block"></i>
        <p class="mb-0">
            @if (!string.IsNullOrEmpty(_searchTerm) || _dateFrom.HasValue || _dateTo.HasValue || !string.IsNullOrEmpty(_userSearchTerm))
            {
                <span>Filtre kriterlerinize uygun kayıt bulunamadı.</span>
            }
            else
            {
                <span>Henüz ziyaret geçmişi bulunmuyor.</span>
            }
        </p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2.5rem;">
                        <input class="form-check-input" type="checkbox"
                               checked="@(_selectedIds.Count == _pagedItems.Count && _pagedItems.Any())"
                               @onchange="ToggleSelectAll" title="Tümünü seç" />
                    </th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th style="width:3.5rem;">Görsel</th>
                    <th>Ürün Adı</th>
                    <th class="d-none d-lg-table-cell">Mağaza</th>
                    @if (_isSuperAdmin)
                    {
                        <th class="d-none d-lg-table-cell">Ziyaretçi</th>
                    }
                    <th class="d-none d-md-table-cell">Tarih</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    <tr>
                        <td>
                            <input class="form-check-input" type="checkbox"
                                   checked="@_selectedIds.Contains(item.HistoryId)"
                                   @onchange="() => ToggleSelection(item.HistoryId)" />
                        </td>
                        <td class="d-none d-md-table-cell text-light small">@(rowNo++)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                            {
                                <img src="@item.CoverImageUrl" alt="@item.ProductName"
                                     class="rounded-2" style="width:40px; height:40px; object-fit:cover;" loading="lazy" />
                            }
                            else
                            {
                                <div class="rounded-2 bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center"
                                     style="width:40px; height:40px;">
                                    <i class="fa fa-picture-o text-secondary"></i>
                                </div>
                            }
                        </td>
                        <td class="text-truncate" style="max-width:18rem;">
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.ProductName) ? "İsimsiz Ürün" : item.ProductName)</div>
                        </td>
                        <td class="d-none d-lg-table-cell text-truncate" style="max-width:10rem;">
                            @if (!string.IsNullOrWhiteSpace(item.StoreName))
                            {
                                <span><i class="fa fa-building-o me-1 text-secondary"></i>@item.StoreName</span>
                            }
                            else
                            {
                                <span class="text-light">—</span>
                            }
                        </td>
                        @if (_isSuperAdmin)
                        {
                            <td class="d-none d-lg-table-cell text-truncate" style="max-width:12rem;">
                                @if (!string.IsNullOrWhiteSpace(item.VisitorName))
                                {
                                    <div class="small">
                                        <i class="fa fa-user-circle me-1 text-info"></i>@item.VisitorName
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.VisitorEmail))
                                    {
                                        <div class="small text-warning text-truncate">@item.VisitorEmail</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-light small">Anonim</span>
                                }
                            </td>
                        }
                        <td class="d-none d-md-table-cell text-nowrap">
                            <div class="small">
                                @if (item.VisitedAt.HasValue)
                                {
                                    @item.VisitedAt.Value.ToString("dd.MM.yyyy")
                                    <span class="text-light"> | @item.VisitedAt.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-light">—</span>
                                }
                            </div>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-info btn-sm"
                                    @onclick="() => OpenDetailModal(item)" title="Detaylar">
                                <i class="fa fa-eye"></i>
                                <span class="d-none d-xl-inline ms-1">Detaylar</span>
                            </button>
                            <button class="btn btn-outline-danger btn-sm ms-1"
                                    @onclick="() => DeleteSingleAsync(item.HistoryId)" title="Sil">
                                <i class="fa fa-trash-o"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama (pencereli — binlerce sayfada bile taşmaz) ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_totalCount kayıt
            <span class="text-light"> · Sayfa @_currentPage / @_totalPages</span>
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <div class="d-flex align-items-center flex-wrap gap-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0 flex-nowrap">
                        @* İlk sayfa *@
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(1)" title="İlk sayfa">
                                <i class="fa fa-angle-double-left"></i>
                            </button>
                        </li>
                        @* Önceki *@
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(_currentPage - 1)" title="Önceki">
                                <i class="fa fa-chevron-left"></i>
                            </button>
                        </li>

                        @* Baştaki "…" *@
                        @if (_pageWindow.First() > 1)
                        {
                            <li class="page-item disabled d-none d-sm-block">
                                <span class="page-link bg-dark text-light border-secondary">…</span>
                            </li>
                        }

                        @* Pencere içindeki sayfalar *@
                        @foreach (var pg in _pageWindow)
                        {
                            <li class="page-item @(_currentPage == pg ? "active" : "")">
                                <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                        @onclick="() => GoToPage(pg)">
                                    @pg
                                </button>
                            </li>
                        }

                        @* Sondaki "…" *@
                        @if (_pageWindow.Last() < _totalPages)
                        {
                            <li class="page-item disabled d-none d-sm-block">
                                <span class="page-link bg-dark text-light border-secondary">…</span>
                            </li>
                        }

                        @* Sonraki *@
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(_currentPage + 1)" title="Sonraki">
                                <i class="fa fa-chevron-right"></i>
                            </button>
                        </li>
                        @* Son sayfa *@
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(_totalPages)" title="Son sayfa">
                                <i class="fa fa-angle-double-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>

                @* Sayfaya git *@
                <div class="input-group input-group-sm" style="width:9.5rem;">
                    <input type="number" min="1" max="@_totalPages"
                           class="form-control bg-dark text-light border-secondary text-center"
                           placeholder="Sayfa"
                           value="@_jumpToPage"
                           @oninput="OnJumpInput"
                           @onkeydown="OnJumpKeyDown" />
                    <button class="btn btn-outline-light border-secondary" @onclick="JumpToPage" title="Git">
                        <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Ziyaret Detayları
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="DetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-info"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-info py-2">
                <h6 class="modal-title text-info mb-0">
                    <i class="fa fa-eye me-1"></i>Ziyaret Detayları
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_detailTarget != null)
                {
                    var d = _detailTarget;
                    <div class="row g-3">

                        @* Kapak görseli *@
                        <div class="col-12 text-center">
                            @if (!string.IsNullOrEmpty(d.CoverImageUrl))
                            {
                                <img src="@d.CoverImageUrl" alt="@d.ProductName"
                                     class="rounded-3 border border-secondary" style="max-height:220px; object-fit:contain;" />
                            }
                            else
                            {
                                <div class="d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-10 rounded-3"
                                     style="width:160px; height:120px;">
                                    <i class="fa fa-picture-o fa-3x text-secondary"></i>
                                </div>
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-cube me-1"></i>Ürün Adı</label>
                            <div class="text-light text-break fw-semibold">@(string.IsNullOrWhiteSpace(d.ProductName) ? "İsimsiz Ürün" : d.ProductName)</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-building-o me-1"></i>Mağaza</label>
                            <div class="text-light text-break">@(string.IsNullOrWhiteSpace(d.StoreName) ? "—" : d.StoreName)</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-calendar me-1"></i>Ziyaret Tarihi (UTC)</label>
                            <div class="text-light">@(d.VisitedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</div>
                        </div>

                        @if (_isSuperAdmin)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small mb-0"><i class="fa fa-user-circle me-1"></i>Ziyaretçi</label>
                                <div class="text-light text-break">@(string.IsNullOrWhiteSpace(d.VisitorName) ? "Anonim" : d.VisitorName)</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small mb-0"><i class="fa fa-envelope-o me-1"></i>E-posta</label>
                                <div class="text-light text-break">@(string.IsNullOrWhiteSpace(d.VisitorEmail) ? "—" : d.VisitorEmail)</div>
                            </div>
                        }

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-link me-1"></i>Slug</label>
                            <div class="text-light small text-break">@(string.IsNullOrWhiteSpace(d.Slug) ? "—" : d.Slug)</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-key me-1"></i>Kayıt Id</label>
                            <div class="text-light small text-break">@d.HistoryId</div>
                        </div>

                        @* Ürüne git linki *@
                        @if (!string.IsNullOrWhiteSpace(d.Slug))
                        {
                            <div class="col-12">
                                <a href="/Public/_Viewer/ProductProfile/@d.Slug"
                                   class="btn btn-outline-info btn-sm">
                                    <i class="fa fa-external-link me-1"></i>Ürün Sayfasına Git
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-info py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Silme Onayı
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="ConfirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content bg-dark border border-danger border-opacity-50 text-light">
            <div class="modal-header border-secondary py-2">
                <h6 class="modal-title">
                    <i class="fa fa-exclamation-triangle text-danger me-2"></i>Silme Onayı
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">@_confirmMessage</p>
            </div>
            <div class="modal-footer border-secondary py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="ExecuteConfirmedDelete">
                    <i class="fa fa-trash me-1"></i>Sil
                </button>
            </div>
        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE  = "Ziyaret Geçmişi";
    private const string ENTITY_NAME = "ProductHistory";
    private const int SEARCH_DELAY   = 500;
    private const int PAGE_SIZE      = 10;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;
    private bool _isSuperAdmin;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private string _searchTerm      = string.Empty;
    private string _userSearchTerm  = string.Empty;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private Notification? _notificationRef;

    // ─── Veriler ──────────────────────────────────────────────────
    private int _totalCount;
    private List<HistoryDisplayItem> _pagedItems = new();

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages  = 1;

    // Görünür sayfa düğmesi sayısı (current'in iki yanında ~2'şer)
    private const int PAGE_WINDOW = 5;
    private List<int> _pageWindow = new() { 1 };

    // "Sayfaya git" alanı
    private int? _jumpToPage;

    // ─── Seçim ────────────────────────────────────────────────────
    private HashSet<Guid> _selectedIds = new();

    // ─── Silme onay ───────────────────────────────────────────────
    private string _confirmMessage = "";
    private Func<Task>? _confirmedAction;

    // ─── Detay modal hedefi ───────────────────────────────────────
    private HistoryDisplayItem? _detailTarget;

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        _isSuperAdmin = use?.UsersType == "SuperAdmin";
        StateHub.OnDataChanged += HandleDataChanged;
        await LoadPageAsync(1);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || (entityName != ENTITY_NAME && entityName != "Products")) return;

        await InvokeAsync(async () =>
        {
            await LoadPageAsync(_currentPage);
            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME — sunucu tarafı sayfalama, tüm tabloda arama
    // ══════════════════════════════════════════════════════════════

    private async Task LoadPageAsync(int page, bool debounce = false)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        var search     = string.IsNullOrWhiteSpace(_searchTerm)     ? null : _searchTerm.Trim();
        var userSearch = string.IsNullOrWhiteSpace(_userSearchTerm) ? null : _userSearchTerm.Trim();

        try
        {
            // Yazarken her tuşta sorgu atmamak için debounce
            if (debounce)
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(token);

            // ── Temel sorgu ──
            var historyQuery = db.Set<ProductHistory>().AsNoTracking()
                .Where(h => h.IsDeleted!.IsDeletedStatu != true);

            // Kullanıcı bazlı filtre
            if (!_isSuperAdmin)
                historyQuery = historyQuery.Where(h => h.UserId == use!.Id);

            // Tarih filtresi
            if (_dateFrom.HasValue)
                historyQuery = historyQuery.Where(h => h.CreatedAt >= _dateFrom.Value.Date);
            if (_dateTo.HasValue)
                historyQuery = historyQuery.Where(h => h.CreatedAt < _dateTo.Value.Date.AddDays(1));

            // ── Products ile join ──
            var joinQuery = from h in historyQuery
                            join p in db.Set<Products>().AsNoTracking()
                                .Where(p => p.IsDeleted!.IsDeletedStatu != true)
                                on h.ProductId equals p.Id into pJoin
                            from p in pJoin.DefaultIfEmpty()
                            select new { History = h, Product = p };

            // Ürün adı araması (DB tarafında LIKE)
            if (search != null)
            {
                joinQuery = joinQuery.Where(x => x.Product != null &&
                                                  x.Product.Name != null &&
                                                  x.Product.Name.Contains(search));
            }

            // SuperAdmin: kullanıcı adı araması
            if (_isSuperAdmin && userSearch != null)
            {
                var matchingUserIds = await db.Set<Users>().AsNoTracking()
                    .Where(u => (u.FirstName != null && u.FirstName.Contains(userSearch)) ||
                                (u.LastName  != null && u.LastName.Contains(userSearch)))
                    .Select(u => u.Id)
                    .ToListAsync(token);

                joinQuery = joinQuery.Where(x => x.History.UserId.HasValue &&
                                                  matchingUserIds.Contains(x.History.UserId.Value));
            }

            // ── Toplam sayım + sayfa sınırlama ──
            _totalCount  = await joinQuery.CountAsync(token);
            _totalPages  = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PAGE_SIZE));
            _currentPage = Math.Clamp(page, 1, _totalPages);
            BuildPageWindow();

            // ── Sadece o anki 10 kaydı çek (Skip/Take DB tarafında) ──
            var rawItems = await joinQuery
                .OrderByDescending(x => x.History.CreatedAt)
                .Skip((_currentPage - 1) * PAGE_SIZE)
                .Take(PAGE_SIZE)
                .Select(x => new
                {
                    HistoryId    = x.History.Id,
                    VisitedAt    = x.History.CreatedAt,
                    VisitorUserId = x.History.UserId,
                    ProductId    = x.History.ProductId,
                    ProductName  = x.Product != null ? x.Product.Name : null,
                    CoverMediaId = x.Product != null ? x.Product.CoverMediaId : (Guid?)null,
                    StoreId      = x.Product != null ? (Guid?)x.Product.StoreId : (Guid?)null
                })
                .ToListAsync(token);

            if (token.IsCancellationRequested) return;

            // ── İlişkili verileri toplu çek (N+1 önleme) ──
            var productIds = rawItems.Where(r => r.ProductId.HasValue).Select(r => r.ProductId!.Value).Distinct().ToList();
            var mediaIds   = rawItems.Where(r => r.CoverMediaId.HasValue).Select(r => r.CoverMediaId!.Value).Distinct().ToList();
            var storeIds   = rawItems.Where(r => r.StoreId.HasValue).Select(r => r.StoreId!.Value).Distinct().ToList();
            var visitorIds = _isSuperAdmin
                ? rawItems.Where(r => r.VisitorUserId.HasValue).Select(r => r.VisitorUserId!.Value).Distinct().ToList()
                : new List<Guid>();

            // Slug'lar
            var slugMap = productIds.Any()
                ? await db.Set<ProductSeo>().AsNoTracking()
                    .Where(s => productIds.Contains(s.ProductId))
                    .GroupBy(s => s.ProductId)
                    .Select(g => new { ProductId = g.Key, Slug = g.OrderByDescending(s => s.CreatedAt).First().Slug })
                    .ToDictionaryAsync(x => x.ProductId, x => x.Slug, token)
                : new Dictionary<Guid, string?>();

            // Kapak görselleri
            var mediaMap = mediaIds.Any()
                ? await db.Set<Data.Media>().AsNoTracking()
                    .Where(m => mediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                    .ToDictionaryAsync(m => m.Id, m => m.FileUrl_Ratio_1_4 ?? m.FileUrl_Ratio_1_2 ?? m.FileUrl, token)
                : new Dictionary<Guid, string?>();

            // Mağaza adları
            var storeMap = storeIds.Any()
                ? await db.Set<Store>().AsNoTracking()
                    .Where(s => storeIds.Contains(s.Id))
                    .ToDictionaryAsync(s => s.Id, s => s.Name, token)
                : new Dictionary<Guid, string?>();

            // Ziyaretçi bilgileri (SuperAdmin)
            var visitorMap = visitorIds.Any()
                ? await db.Set<Users>().AsNoTracking()
                    .Where(u => visitorIds.Contains(u.Id))
                    .Select(u => new { u.Id, u.FirstName, u.LastName, Email = u.ContactInformation != null ? u.ContactInformation.Email : null })
                    .ToDictionaryAsync(u => u.Id, u => new VisitorInfo
                    {
                        FullName = ((u.FirstName ?? "") + " " + (u.LastName ?? "")).Trim(),
                        Email    = u.Email
                    }, token)
                : new Dictionary<Guid, VisitorInfo>();

            // ── Display modeline dönüştür ──
            _pagedItems = rawItems.Select(r =>
            {
                var di = new HistoryDisplayItem
                {
                    HistoryId     = r.HistoryId,
                    VisitedAt     = r.VisitedAt,
                    VisitorUserId = r.VisitorUserId,
                    ProductId     = r.ProductId,
                    ProductName   = r.ProductName,
                    Slug          = r.ProductId.HasValue && slugMap.ContainsKey(r.ProductId.Value) ? slugMap[r.ProductId.Value] : null,
                    CoverImageUrl = r.CoverMediaId.HasValue && mediaMap.ContainsKey(r.CoverMediaId.Value) ? mediaMap[r.CoverMediaId.Value] : null,
                    StoreName     = r.StoreId.HasValue && storeMap.ContainsKey(r.StoreId.Value) ? storeMap[r.StoreId.Value] : null
                };

                if (_isSuperAdmin && r.VisitorUserId.HasValue && visitorMap.ContainsKey(r.VisitorUserId.Value))
                {
                    var vi = visitorMap[r.VisitorUserId.Value];
                    di.VisitorName  = vi.FullName;
                    di.VisitorEmail = vi.Email;
                }

                return di;
            }).ToList();

            _selectedIds.Clear();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadPage", ex);
                await Notify("danger", "Hata", "Ziyaret geçmişi yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    // Sadece current'in etrafındaki PAGE_WINDOW kadar sayfa numarasını üretir
    private void BuildPageWindow()
    {
        int start = Math.Max(1, _currentPage - PAGE_WINDOW / 2);
        int end   = Math.Min(_totalPages, start + PAGE_WINDOW - 1);
        // Sona yaklaşıldıysa pencereyi geriye doğru tamamla
        start = Math.Max(1, end - PAGE_WINDOW + 1);

        _pageWindow = Enumerable.Range(start, end - start + 1).ToList();
    }

    private async Task GoToPage(int page)
    {
        _jumpToPage = null;
        await LoadPageAsync(page);
    }

    // ─── "Sayfaya git" alanı ───
    private void OnJumpInput(ChangeEventArgs e) =>
        _jumpToPage = int.TryParse(e.Value?.ToString(), out var v) ? v : null;

    private async Task JumpToPage()
    {
        if (_jumpToPage is int p) await GoToPage(p);
    }

    private async Task OnJumpKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await JumpToPage();
    }

    private async Task RefreshAsync()
    {
        await LoadPageAsync(_currentPage);
    }

