    {
        _searchTerm = string.Empty;
        await LoadPageAsync(1);
    }

    private async Task OnUserSearchInput(ChangeEventArgs e)
    {
        _userSearchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadPageAsync(1, debounce: true);
    }

    private async Task ClearUserSearch()
    {
        _userSearchTerm = string.Empty;
        await LoadPageAsync(1);
    }

    private async Task ClearDateFilters()
    {
        _dateFrom = null;
        _dateTo   = null;
        await LoadPageAsync(1);
    }

    // ══════════════════════════════════════════════════════════════
    // SEÇİM
    // ══════════════════════════════════════════════════════════════

    private void ToggleSelection(Guid id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private void ToggleSelectAll()
    {
        if (_selectedIds.Count == _pagedItems.Count)
            _selectedIds.Clear();
        else
            _selectedIds = _pagedItems.Select(x => x.HistoryId).ToHashSet();
    }

    // ══════════════════════════════════════════════════════════════
    // SİLME İŞLEMLERİ (Soft Delete)
    // ══════════════════════════════════════════════════════════════

    private async Task DeleteSingleAsync(Guid historyId)
    {
        _confirmMessage = "Bu ziyaret kaydını silmek istediğinize emin misiniz?";
        _confirmedAction = async () =>
        {
            try
            {
                var token = _cts.Token;
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var record = await db.Set<ProductHistory>()
                    .FirstOrDefaultAsync(h => h.Id == historyId, token);

                if (record != null)
                {
                    if (!_isSuperAdmin && record.UserId != use?.Id) return;

                    record.IsDeleted = new IsDeleted { IsDeletedStatu = true, DeletedAtDate = DateTime.UtcNow };
                    await db.SaveChangesAsync(token);
                    await Logger.TakeIt(use?.Id, PAGE_TITLE, "DeleteSingle", "details", historyId.ToString());
                    await Notify("success", PAGE_TITLE, "Ziyaret kaydı silindi.");
                    await LoadPageAsync(_currentPage);
                }
            }
            catch (Exception ex)
            {
                await LogError("DeleteSingle", ex);
                await Notify("danger", PAGE_TITLE, "Silme işlemi başarısız.");
            }
        };
        await ShowModal("ConfirmDeleteModal");
    }

    private async Task DeleteSelectedAsync()
    {
        if (!_selectedIds.Any()) return;
        _confirmMessage = $"{_selectedIds.Count} adet ziyaret kaydını silmek istediğinize emin misiniz?";
        _confirmedAction = async () =>
        {
            try
            {
                var token = _cts.Token;
                await using var db = await DbFactory.CreateDbContextAsync(token);
                var ids = _selectedIds.ToList();

                foreach (var chunk in ids.Chunk(500))
                {
                    var query = db.Set<ProductHistory>().Where(h => chunk.Contains(h.Id));
                    if (!_isSuperAdmin)
                        query = query.Where(h => h.UserId == use!.Id);

                    var records = await query.ToListAsync(token);
                    foreach (var r in records)
                        r.IsDeleted = new IsDeleted { IsDeletedStatu = true, DeletedAtDate = DateTime.UtcNow };

                    await db.SaveChangesAsync(token);
                }

                await Logger.TakeIt(use?.Id, PAGE_TITLE, "DeleteBulk", "details", $"{ids.Count} kayıt silindi");
                await Notify("success", PAGE_TITLE, $"{ids.Count} ziyaret kaydı silindi.");
                _selectedIds.Clear();
                await LoadPageAsync(_currentPage);
            }
            catch (Exception ex)
            {
                await LogError("DeleteBulk", ex);
                await Notify("danger", PAGE_TITLE, "Toplu silme işlemi başarısız.");
            }
        };
        await ShowModal("ConfirmDeleteModal");
    }

    private async Task ClearAllHistoryAsync()
    {
        _confirmMessage = _isSuperAdmin
            ? "TÜM kullanıcıların ziyaret geçmişi silinecek. Emin misiniz?"
            : "Tüm ziyaret geçmişiniz silinecek. Emin misiniz?";

        _confirmedAction = async () =>
        {
            try
            {
                var token = _cts.Token;
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query = db.Set<ProductHistory>().Where(h => h.IsDeleted!.IsDeletedStatu != true);
                if (!_isSuperAdmin)
                    query = query.Where(h => h.UserId == use!.Id);

                var allRecords = await query.ToListAsync(token);

                foreach (var chunk in allRecords.Chunk(500))
                {
                    foreach (var r in chunk)
                        r.IsDeleted = new IsDeleted { IsDeletedStatu = true, DeletedAtDate = DateTime.UtcNow };
                    await db.SaveChangesAsync(token);
                }

                await Logger.TakeIt(use?.Id, PAGE_TITLE, "ClearAll", "details", $"{allRecords.Count} kayıt temizlendi");
                await Notify("success", PAGE_TITLE, $"{allRecords.Count} ziyaret kaydı temizlendi.");
                await LoadPageAsync(1);
            }
            catch (Exception ex)
            {
                await LogError("ClearAll", ex);
                await Notify("danger", PAGE_TITLE, "Temizleme işlemi başarısız.");
            }
        };
        await ShowModal("ConfirmDeleteModal");
    }

    private async Task ExecuteConfirmedDelete()
    {
        await HideModal("ConfirmDeleteModal");
        if (_confirmedAction != null)
            await _confirmedAction.Invoke();
        _confirmedAction = null;
    }

