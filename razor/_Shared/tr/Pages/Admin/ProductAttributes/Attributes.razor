    private void EditOption(AttributeOption opt)
    {
        _optionBuffer = new AttributeOption
        {
            Id = opt.Id,
            AttributeDefinitionId = opt.AttributeDefinitionId,
            CanonicalCode = opt.CanonicalCode,
            CanonicalValue = opt.CanonicalValue,
            NormalizedValue = opt.NormalizedValue,
            ColorHex = opt.ColorHex,
            ImageUrl = opt.ImageUrl,
            NumericValue = opt.NumericValue,
            ParentOptionId = opt.ParentOptionId,
            Level = opt.Level,
            DisplayOrder = opt.DisplayOrder,
            IsActive = opt.IsActive
        };
        _editingOptionId = opt.Id;
    }

    private void SaveOptionBuffer()
    {
        if (string.IsNullOrWhiteSpace(_optionBuffer.CanonicalCode) || string.IsNullOrWhiteSpace(_optionBuffer.CanonicalValue)) return;
        if (string.IsNullOrWhiteSpace(_optionBuffer.NormalizedValue)) _optionBuffer.NormalizedValue = TextNormalizer.Normalize(_optionBuffer.CanonicalValue);
        // Seviyeyi otomatik hesapla (parent varsa parent.Level + 1)
        if (_optionBuffer.ParentOptionId.HasValue && _optionBuffer.ParentOptionId != Guid.Empty)
        {
            var parent = _editOptions.FirstOrDefault(o => o.Id == _optionBuffer.ParentOptionId);
            _optionBuffer.Level = (parent?.Level ?? 0) + 1;
        }
        else
        {
            _optionBuffer.Level = 0;
            _optionBuffer.ParentOptionId = null;
        }
        var existing = _editOptions.FirstOrDefault(o => o.Id == _optionBuffer.Id);
        if (existing != null)
        {
            existing.CanonicalCode = _optionBuffer.CanonicalCode;
            existing.CanonicalValue = _optionBuffer.CanonicalValue;
            existing.NormalizedValue = _optionBuffer.NormalizedValue;
            existing.ColorHex = _optionBuffer.ColorHex;
            existing.ImageUrl = _optionBuffer.ImageUrl;
            existing.NumericValue = _optionBuffer.NumericValue;
            existing.ParentOptionId = _optionBuffer.ParentOptionId;
            existing.Level = _optionBuffer.Level;
            existing.DisplayOrder = _optionBuffer.DisplayOrder;
            existing.IsActive = _optionBuffer.IsActive;
        }
        _editingOptionId = Guid.Empty;
    }

    private void CancelOptionEdit()
    {
        if (_optionBuffer.Id != Guid.Empty && !_editOptions.Any(o => o.Id == _optionBuffer.Id && o.CanonicalCode != null))
            _editOptions.RemoveAll(o => o.Id == _optionBuffer.Id);
        _editingOptionId = Guid.Empty;
    }

