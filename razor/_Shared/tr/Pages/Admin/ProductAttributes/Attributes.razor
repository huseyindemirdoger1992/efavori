                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Kanonik Ad <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.CanonicalName" @onblur="OnEditNameBlur" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Normalize Ad</label>
                                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.NormalizedName" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Görsel Grup</label>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editModel.AttributeGroupId">
                                    <option value="@Guid.Empty">— Grup Seçiniz —</option>
                                    @foreach (var g in _groups)
                                    {
                                        <option value="@g.Id">@g.CanonicalName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Veri Tipi</label>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editModel.DataType">
                                    @foreach (var dt in Enum.GetValues<AttributeDataType>())
                                    {
                                        <option value="@dt">@dt</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Giriş Bileşeni</label>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editModel.InputType">
                                    @foreach (var it in Enum.GetValues<AttributeInputType>())
                                    {
                                        <option value="@it">@it</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Birim Grubu</label>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary" value="@_editUnitGroupId" @onchange="e => OnUnitGroupChanged(e, false)">
                                    <option value="@Guid.Empty">— Seçiniz —</option>
                                    @foreach (var ug in _unitGroups)
                                    {
                                        <option value="@ug.Id">@ug.CanonicalName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Baz Birim</label>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_editModel.BaseUnitId" disabled="@(!_editUnits.Any())">
                                    <option value="@Guid.Empty">@(_editUnits.Any() ? "— Seçiniz —" : "—")</option>
                                    @foreach (var u in _editUnits)
                                    {
                                        <option value="@u.Id">@u.Symbol (@u.CanonicalName)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12"><label class="form-label text-white-50 small">Varsayılan Değer</label><input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.DefaultValue" /></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a1" @bind="_editModel.IsMultiValued" /><label class="form-check-label text-white-50 small" for="ed_a1">Çok Değerli</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a2" @bind="_editModel.IsRequiredByDefault" /><label class="form-check-label text-white-50 small" for="ed_a2">Vars. Zorunlu</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a3" @bind="_editModel.IsVariantByDefault" /><label class="form-check-label text-white-50 small" for="ed_a3">Vars. Varyant</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a4" @bind="_editModel.IsFilterableByDefault" /><label class="form-check-label text-white-50 small" for="ed_a4">Vars. Filtrelenebilir</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a5" @bind="_editModel.IsSearchableByDefault" /><label class="form-check-label text-white-50 small" for="ed_a5">Vars. Aranabilir</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a6" @bind="_editModel.IsComparableByDefault" /><label class="form-check-label text-white-50 small" for="ed_a6">Vars. Karşılaştırılabilir</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a7" @bind="_editModel.IsVisibleOnProductPageByDefault" /><label class="form-check-label text-white-50 small" for="ed_a7">Ürün Sayfasında Görünür</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a8" @bind="_editModel.IsKeyAttribute" /><label class="form-check-label text-white-50 small" for="ed_a8">Anahtar Özellik</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a9" @bind="_editModel.IsActive" /><label class="form-check-label text-white-50 small" for="ed_a9">Aktif</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a10" @bind="_editModel.IsUnique" /><label class="form-check-label text-white-50 small" for="ed_a10">Benzersiz Değer</label></div></div>
                            <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ed_a11" @bind="_editModel.IsSystemLocked" /><label class="form-check-label text-white-50 small" for="ed_a11">Sistem Kilidi</label></div></div>
                        </div>
                    }

                    @* ═══════ TAB 2: Validasyon ═══════ *@
                    @if (_activeTab == 2)
                    {
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-white-50 small">Regex Deseni</label>
                                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.RegexPattern" />
                            </div>
                            <div class="col-6 col-md-3"><label class="form-label text-white-50 small">Min. Sayısal</label><input type="number" step="any" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.MinNumericValue" /></div>
                            <div class="col-6 col-md-3"><label class="form-label text-white-50 small">Max. Sayısal</label><input type="number" step="any" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.MaxNumericValue" /></div>
                            <div class="col-6 col-md-3"><label class="form-label text-white-50 small">Artış Adımı</label><input type="number" step="any" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.NumericStep" /></div>
                            <div class="col-6 col-md-3"><label class="form-label text-white-50 small">Ondalık Basamak</label><input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.DecimalScale" /></div>
                            <div class="col-6 col-md-3"><label class="form-label text-white-50 small">Min. Uzunluk</label><input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.MinLength" /></div>
                            <div class="col-6 col-md-3"><label class="form-label text-white-50 small">Max. Uzunluk</label><input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.MaxLength" /></div>
                            <div class="col-12 col-md-6"><label class="form-label text-white-50 small">Sıralama</label><input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_editModel.DisplayOrder" /></div>
                        </div>
                    }

                    @* ═══════ TAB 3: Options ═══════ *@
                    @if (_activeTab == 3)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="text-white-50 mb-0"><i class="fa fa-list-ul me-1"></i>Seçilebilir Değerler</h6>
                            <button class="btn btn-outline-info btn-sm" @onclick="AddNewOptionRow" disabled="@_isProcessing"><i class="fa fa-plus me-1"></i>Yeni Option</button>
                        </div>
                        <div class="table-responsive rounded-2 border" style="max-height:400px; overflow-y:auto;">
                            <table class="table table-sm table-dark table-bordered mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th class="small" style="width:120px;">Kod</th>
                                        <th class="small">Değer</th>
                                        <th class="small" style="width:100px;">Normalize</th>
                                        <th class="small" style="width:80px;">Renk</th>
                                        <th class="small" style="width:90px;">Görsel URL</th>
                                        <th class="small" style="width:70px;">Sayısal</th>
                                        <th class="small" style="width:110px;">Üst Option</th>
                                        <th class="small" style="width:50px;">Seviye</th>
                                        <th class="small" style="width:60px;">Sıra</th>
                                        <th class="small text-center" style="width:50px;">Aktif</th>
                                        <th class="small text-end" style="width:90px;">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var opt in _editOptions.OrderBy(o => o.DisplayOrder))
                                    {
                                        @if (_editingOptionId == opt.Id)
                                        {
                                            <tr>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.CanonicalCode" /></td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.CanonicalValue" /></td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.NormalizedValue" /></td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.ColorHex" placeholder="#000000" /></td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.ImageUrl" placeholder="https://..." /></td>
                                                <td><input type="number" step="any" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.NumericValue" /></td>
                                                <td>
                                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_optionBuffer.ParentOptionId">
                                                        <option value="@Guid.Empty">— Yok —</option>
                                                        @foreach (var po in _editOptions.Where(o => o.Id != _optionBuffer.Id))
                                                        {
                                                            <option value="@po.Id">@po.CanonicalValue</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td><input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.Level" disabled /></td>
                                                <td><input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_optionBuffer.DisplayOrder" /></td>
                                                <td class="text-center"><input type="checkbox" class="form-check-input" @bind="_optionBuffer.IsActive" /></td>
                                                <td class="text-end">
                                                    <button class="btn btn-success btn-sm py-0 px-1" @onclick="SaveOptionBuffer" title="Kaydet"><i class="fa fa-check"></i></button>
                                                    <button class="btn btn-secondary btn-sm py-0 px-1" @onclick="CancelOptionEdit" title="İptal"><i class="fa fa-times"></i></button>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td class="small"><code>@opt.CanonicalCode</code></td>
                                                <td class="small">@opt.CanonicalValue</td>
                                                <td class="small text-white-50">@opt.NormalizedValue</td>
                                                <td class="small">@opt.ColorHex</td>
                                                <td class="small text-truncate" style="max-width:90px;" title="@opt.ImageUrl">@opt.ImageUrl</td>
                                                <td class="small">@opt.NumericValue</td>
                                                <td class="small">@(_editOptions.FirstOrDefault(o => o.Id == opt.ParentOptionId)?.CanonicalValue ?? "—")</td>
                                                <td class="small">@opt.Level</td>
                                                <td class="small">@opt.DisplayOrder</td>
                                                <td class="text-center">
                                                    @if (opt.IsActive)
                                                    {
                                                        <i class="fa fa-check text-success"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-times text-secondary"></i>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-outline-warning btn-sm py-0 px-1" @onclick="() => EditOption(opt)" title="Düzenle"><i class="fa fa-edit"></i></button>
                                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => DeleteOption(opt)" title="Sil"><i class="fa fa-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* ═══════ TAB 4: Çeviriler ═══════ *@
                    @if (_activeTab == 4)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="text-white-50 mb-0"><i class="fa fa-language me-1"></i>Dil Çevirileri</h6>
                            <button class="btn btn-outline-info btn-sm" @onclick="AddNewTranslationRow" disabled="@_isProcessing"><i class="fa fa-plus me-1"></i>Yeni Çeviri</button>
                        </div>
                        <div class="table-responsive rounded-2 border" style="max-height:400px; overflow-y:auto;">
                            <table class="table table-sm table-dark table-bordered mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th class="small" style="width:80px;">Dil</th>
                                        <th class="small">Ad</th>
                                        <th class="small">Açıklama</th>
                                        <th class="small">Yardım Metni</th>
                                        <th class="small">Placeholder</th>
                                        <th class="small" style="width:70px;">Kaynak</th>
                                        <th class="small text-center" style="width:55px;">Manuel</th>
                                        <th class="small text-end" style="width:80px;">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tr in _editTranslations)
                                    {
                                        @if (_editingTranslationId == tr.Id)
                                        {
                                            <tr>
                                                <td>
                                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_translationBuffer.Language">
                                                        @foreach (var lng in Enum.GetValues<Language>())
                                                        {
                                                            <option value="@lng">@lng</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_translationBuffer.Name" /></td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_translationBuffer.Description" /></td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_translationBuffer.HelpText" /></td>
                                                <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_translationBuffer.Placeholder" /></td>
                                                <td>
                                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_translationBuffer.Source">
                                                        @foreach (var src in Enum.GetValues<ContentSource>())
                                                        {
                                                            <option value="@src">@src</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="text-center"><input type="checkbox" class="form-check-input" @bind="_translationBuffer.IsManuallyEdited" /></td>
                                                <td class="text-end">
                                                    <button class="btn btn-success btn-sm py-0 px-1" @onclick="SaveTranslationBuffer"><i class="fa fa-check"></i></button>
                                                    <button class="btn btn-secondary btn-sm py-0 px-1" @onclick="CancelTranslationEdit"><i class="fa fa-times"></i></button>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td class="small"><span class="badge bg-secondary">@tr.Language</span></td>
                                                <td class="small">@tr.Name</td>
                                                <td class="small text-white-50">@(tr.Description ?? "—")</td>
                                                <td class="small text-white-50">@(tr.HelpText ?? "—")</td>
                                                <td class="small text-white-50">@(tr.Placeholder ?? "—")</td>
                                                <td class="small"><span class="badge bg-dark border border-secondary">@tr.Source</span></td>
                                                <td class="text-center">
                                                    @if (tr.IsManuallyEdited)
                                                    {
                                                        <i class="fa fa-check text-success"></i>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-outline-warning btn-sm py-0 px-1" @onclick="() => EditTranslation(tr)"><i class="fa fa-edit"></i></button>
                                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => DeleteTranslation(tr)"><i class="fa fa-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* ═══════ TAB 5: Alias & Synonym ═══════ *@
                    @if (_activeTab == 5)
                    {
                        <div class="row">
                            <div class="col-12 col-lg-6">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="text-white-50 mb-0"><i class="fa fa-tag me-1"></i>Alias'lar</h6>
                                    <button class="btn btn-outline-info btn-sm" @onclick="AddNewAliasRow"><i class="fa fa-plus"></i></button>
                                </div>
                                <div class="table-responsive rounded-2 border" style="max-height:300px; overflow-y:auto;">
                                    <table class="table table-sm table-dark table-bordered mb-0">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th class="small">Dil</th>
                                                <th class="small">Alias</th>
                                                <th class="small text-end" style="width:80px;">İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var al in _editAliases)
                                            {
                                                @if (_editingAliasId == al.Id)
                                                {
                                                    <tr>
                                                        <td>
                                                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_aliasBuffer.Language">
                                                                <option value="">—</option>
                                                                @foreach (var lng in Enum.GetValues<Language>())
                                                                {
                                                                    <option value="@lng">@lng</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_aliasBuffer.Alias" /></td>
                                                        <td class="text-end">
                                                            <button class="btn btn-success btn-sm py-0 px-1" @onclick="SaveAliasBuffer"><i class="fa fa-check"></i></button>
                                                            <button class="btn btn-secondary btn-sm py-0 px-1" @onclick="CancelAliasEdit"><i class="fa fa-times"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td class="small">@(al.Language?.ToString() ?? "—")</td>
                                                        <td class="small">@al.Alias</td>
                                                        <td class="text-end">
                                                            <button class="btn btn-outline-warning btn-sm py-0 px-1" @onclick="() => EditAlias(al)"><i class="fa fa-edit"></i></button>
                                                            <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => DeleteAlias(al)"><i class="fa fa-trash"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="text-white-50 mb-0"><i class="fa fa-link me-1"></i>Synonym'ler</h6>
                                    <button class="btn btn-outline-info btn-sm" @onclick="AddNewSynonymRow"><i class="fa fa-plus"></i></button>
                                </div>
                                <div class="table-responsive rounded-2 border" style="max-height:300px; overflow-y:auto;">
                                    <table class="table table-sm table-dark table-bordered mb-0">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th class="small">Token</th>
                                                <th class="small">Normalize</th>
                                                <th class="small text-end" style="width:80px;">İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var sy in _editSynonyms)
                                            {
                                                @if (_editingSynonymId == sy.Id)
                                                {
                                                    <tr>
                                                        <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_synonymBuffer.Token" /></td>
                                                        <td><input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_synonymBuffer.NormalizedToken" /></td>
                                                        <td class="text-end">
                                                            <button class="btn btn-success btn-sm py-0 px-1" @onclick="SaveSynonymBuffer"><i class="fa fa-check"></i></button>
                                                            <button class="btn btn-secondary btn-sm py-0 px-1" @onclick="CancelSynonymEdit"><i class="fa fa-times"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td class="small">@sy.Token</td>
                                                        <td class="small text-white-50">@sy.NormalizedToken</td>
                                                        <td class="text-end">
                                                            <button class="btn btn-outline-warning btn-sm py-0 px-1" @onclick="() => EditSynonym(sy)"><i class="fa fa-edit"></i></button>
                                                            <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => DeleteSynonym(sy)"><i class="fa fa-trash"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
