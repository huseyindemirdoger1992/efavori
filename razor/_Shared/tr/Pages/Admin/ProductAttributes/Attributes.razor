<div class="modal fade" id="BulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-light border border-danger" style="box-shadow:0 0 8px rgba(220,53,69,0.35);">
            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>Toplu Silme — @_selectedIds.Count kayıt seçildi
                </h6>
                <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="modal-body text-dark">
                <p class="text-warning small mb-3">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    Aşağıdaki <strong>@_selectedIds.Count</strong> attribute kalıcı olarak silinecek. Bu işlem geri alınamaz.
                </p>
                @if (_bulkDeletePreview != null && _bulkDeletePreview.Any())
                {
                    <div class="table-responsive" style="max-height:300px; overflow-y:auto;">
                        <table class="table table-sm table-bordered table-striped mb-0">
                            <thead>
                                <tr>
                                    <th class="small">#</th>
                                    <th class="small">Kod</th>
                                    <th class="small">Ad</th>
                                    <th class="small">Tip</th>
