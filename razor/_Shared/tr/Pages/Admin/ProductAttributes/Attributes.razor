        await ShowModal("DeleteModal");
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget == null) return;
        try
        {
            _isSaving = true; StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var versions = await db.AttributeTemplates
                .Where(x => x.TemplateGroupId == _deleteTarget.TemplateGroupId)
                .ToListAsync(_cts.Token);

            var now = DateTime.UtcNow;
            foreach (var v in versions)
            {
                v.IsDeleted ??= new IsDeleted();
                v.IsDeleted.IsDeletedStatu = true;
                v.IsDeleted.DeletedAtDate = now;
            }
            await db.SaveChangesAsync(_cts.Token);

            await Logger.TakeIt(use?.Id, PAGE_TITLE, "SoftDeleteGroup", "message", $"{_deleteTarget.TemplateGroupId}");
            StateHub.NotifyDataChanged(ENTITY_NAME);
            await HideModal("DeleteModal");
            await Notify("success", "Tamam", "Şablon grubu silindi.");
            _deleteTarget = null;
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("DeleteGroup", ex);
            await Notify("danger", "Hata", "Silme sırasında sorun oluştu.");
        }
        finally { _isSaving = false; StateHasChanged(); }
    }

