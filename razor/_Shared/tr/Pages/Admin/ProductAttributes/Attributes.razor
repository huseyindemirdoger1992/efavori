    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-danger" style="box-shadow:0 0 8px rgba(220,53,69,0.35);">
            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0"><i class="fa fa-trash-o me-2"></i>Silme İşlemi</h6>
