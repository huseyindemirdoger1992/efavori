@* ============================================================
   AttributeDefinitions.razor  (v3 — Syntax Düzeltildi)
   ============================================================ *@
@using data
@using data.Owned;
@using data._Attribute;
@using data._Categories;
@using data._Helper;
@using data._Products;
@using data._Systems;
@using data._Users;
@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using System.Globalization

@inject IDbContextFactory<data._ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa",  "/"),
        ("fa fa-cogs",     "Katalog",    "javascript:void(0)"),
        ("fa fa-tags",     PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button class="btn btn-light btn-sm" @onclick="OpenAddModal" disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Attribute</span>
    </button>

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light">@_selectedIds.Count seçili</span>
        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Seçimi Temizle
        </button>
        <div class="vr mx-1"></div>
        <button class="btn btn-outline-danger btn-sm border-0" @onclick="OpenBulkDeleteModal" disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Kanonik kod, ad veya normalize ad ara..."
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_allItems.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Attribute bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2rem;"><input type="checkbox" class="form-check-input" checked="@_allSelected" @onchange="ToggleSelectAll" /></th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Kanonik Kod</th>
                    <th>Ad</th>
                    <th>Veri Tipi</th>
                    <th>Giriş Bileşeni</th>
                    <th>Grup</th>
                    <th class="text-center">Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    var groupName = _groupLookup.GetValueOrDefault(item.AttributeGroupId ?? Guid.Empty, "—");
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td><input type="checkbox" class="form-check-input" checked="@isSelected" @onchange="() => ToggleRowSelection(item.Id)" /></td>
                        <td class="d-none d-md-table-cell text-secondary small">@(rowNo++)</td>
                        <td><code class="text-info">@item.CanonicalCode</code></td>
                        <td>
                            <div class="fw-semibold">@item.CanonicalName</div>
                            <div class="small text-white-50">@item.NormalizedName</div>
                        </td>
                        <td><span class="badge bg-secondary">@item.DataType</span></td>
                        <td><span class="badge bg-dark border border-secondary">@item.InputType</span></td>
                        <td class="small">@groupName</td>
                        <td class="text-center">
                            @if (item.IsSystemLocked)
                            {
                                <span class="badge bg-danger" title="Sistem Kilidi"><i class="fa fa-lock"></i></span>
                            }
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pasif</span>
                            }
                            @if (item.Ai?.IsManuallyEdited == true)
                            {
                                <span class="badge bg-info" title="Manuel Düzenleme Kilidi"><i class="fa fa-user"></i></span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama (Akıllı) ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">Toplam @_allItems.Count kayıt @if (_isLoading) { <i class="fa fa-spinner fa-spin ms-1 text-info"></i> }</small>
        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0 flex-wrap">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary" @onclick="() => GoToPage(_currentPage - 1)"><i class="fa fa-chevron-left"></i></button>
                    </li>
                    @foreach (var pg in GetVisiblePages())
                    {
                        if (pg == -1)
                        {
                            <li class="page-item disabled"><span class="page-link bg-dark text-light border-secondary">…</span></li>
                        }
                        else
                        {
                            <li class="page-item @(_currentPage == pg ? "active" : "")">
                                <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary" @onclick="() => GoToPage(pg)">@pg</button>
                            </li>
                        }
                    }
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary" @onclick="() => GoToPage(_currentPage + 1)"><i class="fa fa-chevron-right"></i></button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Ekle
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="AddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content bg-dark border border-secondary" style="box-shadow:0 0 8px rgba(13,202,240,0.35);">
            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0"><i class="fa fa-plus me-1"></i>Yeni Attribute</h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran"><i class="fa fa-expand" style="font-size: 0.85rem;"></i></button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat"><i class="fa fa-times" style="font-size: 0.95rem;"></i></button>
                </div>
            </div>
            <div class="modal-body">
                @if (_addModel != null)
                {
                    <div class="row g-3">
                        @* ── Temel Bilgiler ── *@
                        <div class="col-12"><h6 class="text-info border-bottom border-secondary pb-1"><i class="fa fa-info-circle me-1"></i>Temel Bilgiler</h6></div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-code me-1"></i>Kanonik Kod <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.CanonicalCode" placeholder="ornek_ram" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-font me-1"></i>Kanonik Ad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.CanonicalName" @onblur="OnAddNameBlur" placeholder="RAM" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-text-width me-1"></i>Normalize Ad (Otomatik)</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.NormalizedName" placeholder="ram" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-object-group me-1"></i>Görsel Grup</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_addModel.AttributeGroupId">
                                <option value="@Guid.Empty">— Grup Seçiniz —</option>
                                @foreach (var g in _groups)
                                {
                                    <option value="@g.Id">@g.CanonicalName</option>
                                }
                            </select>
                        </div>

                        @* ── Tip & Bileşen ── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-database me-1"></i>Veri Tipi</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_addModel.DataType">
                                @foreach (var dt in Enum.GetValues<AttributeDataType>())
                                {
                                    <option value="@dt">@dt</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-desktop me-1"></i>Giriş Bileşeni</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_addModel.InputType">
                                @foreach (var it in Enum.GetValues<AttributeInputType>())
                                {
                                    <option value="@it">@it</option>
                                }
                            </select>
                        </div>

                        @* ── Birim (Measurement tipi için) ── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-balance-scale me-1"></i>Birim Grubu</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" value="@_addUnitGroupId" @onchange="e => OnUnitGroupChanged(e, true)">
                                <option value="@Guid.Empty">— Seçiniz —</option>
                                @foreach (var ug in _unitGroups)
                                {
                                    <option value="@ug.Id">@ug.CanonicalName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-ruler me-1"></i>Baz Birim</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_addModel.BaseUnitId" disabled="@(!_addUnits.Any())">
                                <option value="@Guid.Empty">@(_addUnits.Any() ? "— Seçiniz —" : "—")</option>
                                @foreach (var u in _addUnits)
                                {
                                    <option value="@u.Id">@u.Symbol (@u.CanonicalName)</option>
                                }
                            </select>
                        </div>

                        @* ── Davranış Bayrakları ── *@
                        <div class="col-12"><h6 class="text-info border-bottom border-secondary pb-1 mt-2"><i class="fa fa-sliders me-1"></i>Davranışlar</h6></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a1" @bind="_addModel.IsMultiValued" /><label class="form-check-label text-white-50 small" for="add_a1">Çok Değerli</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a2" @bind="_addModel.IsRequiredByDefault" /><label class="form-check-label text-white-50 small" for="add_a2">Vars. Zorunlu</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a3" @bind="_addModel.IsVariantByDefault" /><label class="form-check-label text-white-50 small" for="add_a3">Vars. Varyant</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a4" @bind="_addModel.IsFilterableByDefault" /><label class="form-check-label text-white-50 small" for="add_a4">Vars. Filtrelenebilir</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a5" @bind="_addModel.IsSearchableByDefault" /><label class="form-check-label text-white-50 small" for="add_a5">Vars. Aranabilir</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a6" @bind="_addModel.IsComparableByDefault" /><label class="form-check-label text-white-50 small" for="add_a6">Vars. Karşılaştırılabilir</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a7" @bind="_addModel.IsVisibleOnProductPageByDefault" /><label class="form-check-label text-white-50 small" for="add_a7">Ürün Sayfasında Görünür</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a8" @bind="_addModel.IsKeyAttribute" /><label class="form-check-label text-white-50 small" for="add_a8">Anahtar Özellik</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a9" @bind="_addModel.IsActive" /><label class="form-check-label text-white-50 small" for="add_a9">Aktif</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a10" @bind="_addModel.IsUnique" /><label class="form-check-label text-white-50 small" for="add_a10">Benzersiz Değer</label></div></div>
                        <div class="col-6 col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="add_a11" @bind="_addModel.IsSystemLocked" /><label class="form-check-label text-white-50 small" for="add_a11">Sistem Kilidi</label></div></div>

                        @* ── Validasyon ── *@
                        <div class="col-12"><h6 class="text-info border-bottom border-secondary pb-1 mt-2"><i class="fa fa-shield me-1"></i>Validasyon Kuralları</h6></div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">Regex Deseni</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.RegexPattern" placeholder="^\d+$" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label text-white-50 small">Min. Sayısal</label>
                            <input type="number" step="any" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.MinNumericValue" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label text-white-50 small">Max. Sayısal</label>
                            <input type="number" step="any" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.MaxNumericValue" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label text-white-50 small">Artış Adımı</label>
                            <input type="number" step="any" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.NumericStep" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label text-white-50 small">Ondalık Basamak</label>
                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.DecimalScale" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label text-white-50 small">Min. Uzunluk</label>
                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.MinLength" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label text-white-50 small">Max. Uzunluk</label>
                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.MaxLength" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">Varsayılan Değer</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.DefaultValue" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label text-white-50 small">Sıralama</label>
                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.DisplayOrder" />
                        </div>

                        @* ── AI Metadata ── *@
                        <div class="col-12"><h6 class="text-info border-bottom border-secondary pb-1 mt-2"><i class="fa fa-robot me-1"></i>AI Metadata</h6></div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">Kaynak</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_addModel.Ai.Source">
                                @foreach (var src in Enum.GetValues<ContentSource>())
                                {
                                    <option value="@src">@src</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">Onay Durumu</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_addModel.Ai.ApprovalStatus">
                                @foreach (var ap in Enum.GetValues<AiApprovalStatus>())
                                {
                                    <option value="@ap">@ap</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small">İnceleme Durumu</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_addModel.Ai.ReviewStatus">
                                @foreach (var rs in Enum.GetValues<AiReviewStatus>())
                                {
                                    <option value="@rs">@rs</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">AI Model</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.Ai.AiModel" placeholder="gemini-2.5-pro" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">Güven Skoru (0-1)</label>
                            <input type="number" step="0.01" min="0" max="1" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_addModel.Ai.Confidence" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="add_aiLock" @bind="_addModel.Ai.IsManuallyEdited" />
                                <label class="form-check-label text-white-50" for="add_aiLock"><i class="fa fa-lock me-1"></i>Manuel Düzenleme Kilidi (AI/Import bu kaydın üzerine yazamaz)</label>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"><i class="fa fa-arrow-left me-1"></i>Kapat</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="AddAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-plus me-1"></i><span>Yeni Attribute Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Düzenle (Sekmeli)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content bg-dark border border-secondary" style="box-shadow:0 0 8px rgba(255,215,0,0.35);">
            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0"><i class="fa fa-pencil me-1"></i>Attribute Düzenle</h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran"><i class="fa fa-expand" style="font-size: 0.85rem;"></i></button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat"><i class="fa fa-times" style="font-size: 0.95rem;"></i></button>
                </div>
            </div>
            <div class="modal-body">
                @if (_editModel != null)
                {
                    @* ── Sekmeler ── *@
                    <ul class="nav nav-tabs nav-fill border-secondary mb-3" id="editTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == 1 ? "active bg-dark text-info border-info" : "bg-transparent text-white-50")" @onclick="() => _activeTab = 1" type="button">Temel Bilgiler</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == 2 ? "active bg-dark text-info border-info" : "bg-transparent text-white-50")" @onclick="() => _activeTab = 2" type="button">Validasyon</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == 3 ? "active bg-dark text-info border-info" : "bg-transparent text-white-50")" @onclick="() => _activeTab = 3" type="button">Options (@_editOptions.Count)</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == 4 ? "active bg-dark text-info border-info" : "bg-transparent text-white-50")" @onclick="() => _activeTab = 4" type="button">Çeviriler (@_editTranslations.Count)</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == 5 ? "active bg-dark text-info border-info" : "bg-transparent text-white-50")" @onclick="() => _activeTab = 5" type="button">Alias & Synonym</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == 6 ? "active bg-dark text-info border-info" : "bg-transparent text-white-50")" @onclick="() => _activeTab = 6" type="button">Kurallar (@_editDependencies.Count)</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == 7 ? "active bg-dark text-info border-info" : "bg-transparent text-white-50")" @onclick="() => _activeTab = 7" type="button">AI & Sistem</button>
