    private async Task SyncOptionsAsync(data._ApplicationConnectionDb db, Guid attributeId)
    {
        var existingOpts = await db.Set<AttributeOption>()
            .Where(o => o.AttributeDefinitionId == attributeId && (o.IsDeleted == null || o.IsDeleted.IsDeletedStatu == null || o.IsDeleted.IsDeletedStatu == false))
            .ToListAsync(_cts.Token);

        foreach (var opt in _editOptions)
        {
            var existing = existingOpts.FirstOrDefault(o => o.Id == opt.Id);
            if (existing == null)
            {
                opt.AttributeDefinitionId = attributeId;
                opt.IsDeleted = new IsDeleted { IsDeletedStatu = false };
                if (string.IsNullOrWhiteSpace(opt.NormalizedValue)) opt.NormalizedValue = TextNormalizer.Normalize(opt.CanonicalValue);
                db.Set<AttributeOption>().Add(opt);
            }
            else
            {
                existing.CanonicalCode = opt.CanonicalCode;
                existing.CanonicalValue = opt.CanonicalValue;
                existing.NormalizedValue = opt.NormalizedValue;
                existing.ColorHex = opt.ColorHex;
                existing.ImageUrl = opt.ImageUrl;
                existing.NumericValue = opt.NumericValue;
                existing.ParentOptionId = opt.ParentOptionId;
                existing.Level = opt.Level;
                existing.DisplayOrder = opt.DisplayOrder;
                existing.IsActive = opt.IsActive;
            }
        }
        // Silinenler
        foreach (var ex in existingOpts.Where(o => !_editOptions.Any(e => e.Id == o.Id)))
        {
            ex.IsDeleted ??= new IsDeleted();
            ex.IsDeleted.IsDeletedStatu = true;
            ex.IsDeleted.DeletedAtDate = DateTime.UtcNow;
        }
    }

