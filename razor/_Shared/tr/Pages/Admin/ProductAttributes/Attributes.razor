            </div>
            <div class="modal-body">
                <p class="text-white-50 small mb-3">Bu attribute'u silmek istediğinizden emin misiniz?</p>
                @if (_deleteTarget != null)
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-4"><label class="form-label text-white-50 small">Kanonik Kod</label><input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" value="@_deleteTarget.CanonicalCode" disabled /></div>
                        <div class="col-12 col-md-4"><label class="form-label text-white-50 small">Ad</label><input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" value="@_deleteTarget.CanonicalName" disabled /></div>
                        <div class="col-12 col-md-4"><label class="form-label text-white-50 small">Veri Tipi</label><input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" value="@_deleteTarget.DataType" disabled /></div>
                    </div>
                }
            </div>
            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"><i class="fa fa-arrow-left me-1"></i>İptal</button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="DeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>Evet, Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

