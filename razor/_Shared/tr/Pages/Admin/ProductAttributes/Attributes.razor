    }

    /// <summary>
    /// Server-side kategori autocomplete — DB tarafında Contains + Take(25).
    /// Milyonlarca kategori için tüm ağacı yüklemeden çalışır.
    /// </summary>
    private async Task<List<CategoryLookup>> SearchCategoriesAsync(string? term, CancellationToken token)
    {
        await using var db = await DbFactory.CreateDbContextAsync(token);

        var q = db.CategoriesTr.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(term))
        {
            var s = term.Trim();
            q = q.Where(c =>
                (c.Name != null && c.Name.Contains(s)) ||
                (c.DepartmentName != null && c.DepartmentName.Contains(s)));
        }

        var rows = await q
            .OrderBy(c => c.DepartmentName)
            .ThenBy(c => c.Name)
            .Take(CAT_TAKE)
            .Select(c => new { c.Id, c.Name, c.DepartmentName })
            .ToListAsync(token);

        return rows.Select(c => new CategoryLookup
        {
            Id = c.Id,
            Name = c.Name,
            DepartmentName = c.DepartmentName,
            Path = string.IsNullOrWhiteSpace(c.DepartmentName)
                ? (c.Name ?? string.Empty)
                : $"{c.DepartmentName} › {c.Name}"
        }).ToList();
    }

    private async Task AssignCategoryAsync(CategoryLookup c)
    {
        if (_catPanelTarget == null) return;
        if (_catAssigned.Any(x => x.Id == c.Id)) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // İdempotent — zaten varsa atla
            var exists = await db.AttributeTemplateCategories
                .AsNoTracking()
                .AnyAsync(x => x.TemplateGroupId == _catPanelTarget.TemplateGroupId
                            && x.CategoryId == c.Id, _cts.Token);

            if (!exists)
            {
                db.AttributeTemplateCategories.Add(new AttributeTemplateCategories
                {
                    Id = Guid.NewGuid(),
                    TemplateGroupId = _catPanelTarget.TemplateGroupId,
                    CategoryId = c.Id,
                    CreatedAt = DateTime.UtcNow
                });
                await db.SaveChangesAsync(_cts.Token);
            }

            _catAssigned.Add(c);
            _catAssigned = _catAssigned.OrderBy(x => x.Path).ToList();

            await Logger.TakeIt(use?.Id, PAGE_TITLE, "AssignCategory",
                "message", $"Group={_catPanelTarget.TemplateGroupId}, Cat={c.Id}");
            StateHub.NotifyDataChanged(ENTITY_NAME);
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("AssignCategory", ex);
            await Notify("danger", "Hata", "Kategori atanırken sorun oluştu.");
        }
    }

    private async Task RemoveCategoryAsync(CategoryLookup c)
    {
        if (_catPanelTarget == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var row = await db.AttributeTemplateCategories
                .FirstOrDefaultAsync(x => x.TemplateGroupId == _catPanelTarget.TemplateGroupId
                                       && x.CategoryId == c.Id, _cts.Token);
            if (row != null)
            {
                db.AttributeTemplateCategories.Remove(row);
                await db.SaveChangesAsync(_cts.Token);
            }

            _catAssigned.RemoveAll(x => x.Id == c.Id);

            await Logger.TakeIt(use?.Id, PAGE_TITLE, "RemoveCategory",
                "message", $"Group={_catPanelTarget.TemplateGroupId}, Cat={c.Id}");
            StateHub.NotifyDataChanged(ENTITY_NAME);
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("RemoveCategory", ex);
            await Notify("danger", "Hata", "Kategori kaldırılırken sorun oluştu.");
        }
    }

