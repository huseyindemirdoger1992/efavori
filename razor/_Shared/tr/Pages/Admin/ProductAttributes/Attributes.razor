    private void ToggleRowSelection(Guid id) { if (!_selectedIds.Remove(id)) _selectedIds.Add(id); _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id)); StateHasChanged(); }
    private void ToggleSelectAll() { if (_allSelected) _selectedIds.Clear(); else foreach (var item in _allItems) _selectedIds.Add(item.Id); _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id)); StateHasChanged(); }
    private void ClearSelection() { _selectedIds.Clear(); _allSelected = false; StateHasChanged(); }

