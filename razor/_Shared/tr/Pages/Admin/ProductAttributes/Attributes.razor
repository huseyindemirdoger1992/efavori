    // ══════════════════════════════════════════════════════════════
    // CRUD — Ekle
    // ══════════════════════════════════════════════════════════════

    private async Task AddAsync()
    {
        if (_isProcessing || _addModel == null) return;
        if (string.IsNullOrWhiteSpace(_addModel.CanonicalCode) || string.IsNullOrWhiteSpace(_addModel.CanonicalName))
        { await Notify("warning", "Uyarı", "Kanonik kod ve ad zorunludur."); return; }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            if (string.IsNullOrWhiteSpace(_addModel.NormalizedName)) _addModel.NormalizedName = TextNormalizer.Normalize(_addModel.CanonicalName);
            _addModel.CanonicalCode = TextNormalizer.ToCanonicalCode(_addModel.CanonicalCode);
            _addModel.CreatedAtUtc = DateTime.UtcNow;
            _addModel.CreatedByUserId = use?.Id;
            _addModel.IsDeleted = new IsDeleted { IsDeletedStatu = false };

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.Set<AttributeDefinition>().Add(_addModel);
            await db.SaveChangesAsync(_cts.Token);

            await HideModal("AddModal"); _addModel = null; _isProcessing = false;
            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Add");
            await Notify("success", "Başarılı", "Attribute eklendi.");
        }
        catch (Exception ex) { await LogError("AddAsync", ex); await Notify("danger", "Hata", "Kayıt sırasında sorun oluştu."); }
        finally { if (_isProcessing) { _isProcessing = false; StateHasChanged(); } _writeLock.Release(); }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Güncelle
    // ══════════════════════════════════════════════════════════════

    private async Task UpdateAsync()
    {
        if (_isProcessing || _editModel == null) return;
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.Set<AttributeDefinition>().FindAsync(new object[] { _editModel.Id }, _cts.Token);
            if (existing == null) { await Notify("warning", "Uyarı", "Kayıt artık mevcut değil."); return; }

            // Temel alanlar
            existing.CanonicalCode = _editModel.CanonicalCode;
            existing.NormalizedName = string.IsNullOrWhiteSpace(_editModel.NormalizedName) ? TextNormalizer.Normalize(_editModel.CanonicalName) : _editModel.NormalizedName;
            existing.CanonicalName = _editModel.CanonicalName;
            existing.AttributeGroupId = _editModel.AttributeGroupId == Guid.Empty ? null : _editModel.AttributeGroupId;
            existing.DataType = _editModel.DataType;
            existing.InputType = _editModel.InputType;
            existing.UnitGroupId = _editModel.UnitGroupId;
            existing.BaseUnitId = _editModel.BaseUnitId;
            existing.IsMultiValued = _editModel.IsMultiValued;
            existing.IsRequiredByDefault = _editModel.IsRequiredByDefault;
            existing.IsVariantByDefault = _editModel.IsVariantByDefault;
            existing.IsFilterableByDefault = _editModel.IsFilterableByDefault;
            existing.IsSearchableByDefault = _editModel.IsSearchableByDefault;
            existing.IsComparableByDefault = _editModel.IsComparableByDefault;
            existing.IsVisibleOnProductPageByDefault = _editModel.IsVisibleOnProductPageByDefault;
            existing.IsKeyAttribute = _editModel.IsKeyAttribute;
            existing.IsActive = _editModel.IsActive;
            existing.IsUnique = _editModel.IsUnique;
            existing.IsSystemLocked = _editModel.IsSystemLocked;
            existing.RegexPattern = _editModel.RegexPattern;
            existing.MinNumericValue = _editModel.MinNumericValue;
            existing.MaxNumericValue = _editModel.MaxNumericValue;
            existing.NumericStep = _editModel.NumericStep;
            existing.DecimalScale = _editModel.DecimalScale;
            existing.MinLength = _editModel.MinLength;
            existing.MaxLength = _editModel.MaxLength;
            existing.DefaultValue = _editModel.DefaultValue;
            existing.DisplayOrder = _editModel.DisplayOrder;
            existing.UpdatedAtUtc = DateTime.UtcNow;
            existing.UpdatedByUserId = use?.Id;

            // AI Metadata
            existing.Ai ??= new AiMetadata();
            existing.Ai.Source = _editModel.Ai.Source;
            existing.Ai.IsManuallyEdited = _editModel.Ai.IsManuallyEdited;
            existing.Ai.AiModel = _editModel.Ai.AiModel;
            existing.Ai.AiModelVersion = _editModel.Ai.AiModelVersion;
            existing.Ai.Confidence = _editModel.Ai.Confidence;
            existing.Ai.PromptHash = _editModel.Ai.PromptHash;
            existing.Ai.PromptVersion = _editModel.Ai.PromptVersion;
            existing.Ai.ApprovalStatus = _editModel.Ai.ApprovalStatus;
            existing.Ai.ReviewStatus = _editModel.Ai.ReviewStatus;
            existing.Ai.ReviewNote = _editModel.Ai.ReviewNote;
            existing.Ai.CategorySource = _editModel.Ai.CategorySource;
            if (_editModel.Ai.IsManuallyEdited) { existing.Ai.ManuallyEditedByUserId = use?.Id; existing.Ai.ManuallyEditedAtUtc = DateTime.UtcNow; }

            // Options sync
            await SyncOptionsAsync(db, existing.Id);
            // Translations sync
            await SyncTranslationsAsync(db, existing.Id);
            // Alias sync
            await SyncAliasesAsync(db, existing.Id);
            // Synonym sync
            await SyncSynonymsAsync(db, existing.Id);
            // Dependencies sync (YENİ)
            await SyncDependenciesAsync(db, existing.Id);

            await db.SaveChangesAsync(_cts.Token);
            await HideModal("EditModal"); _editModel = null; _isProcessing = false;
            StateHub.ClearCache(CACHE_KEY);
