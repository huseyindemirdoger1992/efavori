    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null) return;
        if (_deleteTarget.IsSystemLocked) { await Notify("warning", "Kilit", "Sistem kilitli attribute silinemez."); await HideModal("DeleteModal"); return; }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.Set<AttributeDefinition>().FindAsync(new object[] { _deleteTarget.Id }, _cts.Token);
            if (entity != null)
            {
                entity.IsDeleted ??= new IsDeleted();
                entity.IsDeleted.IsDeletedStatu = true;
                entity.IsDeleted.DeletedAtDate = DateTime.UtcNow;
                await db.SaveChangesAsync(_cts.Token);
            }
            await HideModal("DeleteModal"); _deleteTarget = null; _isProcessing = false;
            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Delete");
            await Notify("success", "Silindi", "Attribute başarıyla silindi.");
        }
        catch (Exception ex) { await LogError("DeleteAsync", ex); await Notify("danger", "Hata", "Silme sırasında sorun oluştu."); }
        finally { if (_isProcessing) { _isProcessing = false; StateHasChanged(); } _writeLock.Release(); }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Sil
    // ══════════════════════════════════════════════════════════════

    private async Task BulkDeleteConfirmedAsync()
    {
        if (_isProcessing || !_selectedIds.Any()) return;
        var locked = _allItems.Where(x => _selectedIds.Contains(x.Id) && x.IsSystemLocked).ToList();
        if (locked.Any()) { await Notify("warning", "Kilit", $"{locked.Count} sistem kilitli kayıt atlandı."); }
        var ids = _selectedIds.Where(id => !_allItems.Any(x => x.Id == id && x.IsSystemLocked)).ToList();
        if (!ids.Any()) { await HideModal("BulkDeleteModal"); return; }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true; StateHasChanged();
            var now = DateTime.UtcNow;
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            await db.Set<AttributeDefinition>()
                .Where(x => ids.Contains(x.Id))
                .ExecuteUpdateAsync(s => s
                    .SetProperty(x => x.IsDeleted!.IsDeletedStatu, true)
                    .SetProperty(x => x.IsDeleted!.DeletedAtDate, now), _cts.Token);
            _selectedIds.Clear(); _allSelected = false; _bulkDeletePreview.Clear();
            await HideModal("BulkDeleteModal"); _isProcessing = false;
            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkDelete ({ids.Count})");
            await Notify("success", "Silindi", $"{ids.Count} attribute silindi.");
        }
        catch (Exception ex) { await LogError("BulkDelete", ex); await Notify("danger", "Hata", "Toplu silme sırasında sorun oluştu."); }
        finally { if (_isProcessing) { _isProcessing = false; StateHasChanged(); } _writeLock.Release(); }
    }

