    private async Task ShowModal(string id) => await JS.InvokeVoidAsync("eval", $"new bootstrap.Modal(document.getElementById('{id}')).show()");
    private async Task HideModal(string id) => await JS.InvokeVoidAsync("eval", $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");
    private async Task Notify(string type, string title, string text) { if (_notificationRef == null) return; await _notificationRef.Launch(type, title, text, "https://picsum.photos/120"); }
    private async Task LogError(string action, Exception ex) { try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); } catch { } }
