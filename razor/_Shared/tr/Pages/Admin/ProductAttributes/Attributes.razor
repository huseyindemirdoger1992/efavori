    /// <summary>
    /// Seçili tüm şablon gruplarına seçili tüm kategorileri toplu enjekte eder.
    /// İdempotent — zaten mevcut olan eşleşmeleri atlar, yalnızca eksikleri ekler.
    /// 500'lük chunk'larla yazar (büyük seçim güvencesi).
    /// </summary>
    private async Task ApplyBulkCategoryAsync()
    {
        if (_selected.Count == 0 || _bulkCatPicked.Count == 0) return;

        try
        {
            _isSaving = true; StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Seçili sürüm Id'lerinden TemplateGroupId çıkar
            var groupIds = _pagedItems
                .Where(x => _selected.Contains(x.Id))
                .Select(x => x.TemplateGroupId)
                .Distinct()
                .ToList();

            // Sayfa dışı seçim varsa DB'den de tamamla
            var missingIds = _selected
                .Where(id => _pagedItems.All(x => x.Id != id))
                .ToList();
            if (missingIds.Count > 0)
            {
                var extra = await db.AttributeTemplates
                    .AsNoTracking()
                    .Where(t => missingIds.Contains(t.Id))
                    .Select(t => t.TemplateGroupId)
                    .ToListAsync(_cts.Token);
                groupIds = groupIds.Concat(extra).Distinct().ToList();
            }

            var catIds = _bulkCatPicked.Select(c => c.Id).Distinct().ToList();

            // Mevcut eşleşmeleri çek
            var existing = await db.AttributeTemplateCategories
                .AsNoTracking()
                .Where(c => groupIds.Contains(c.TemplateGroupId) && catIds.Contains(c.CategoryId))
                .Select(c => new { c.TemplateGroupId, c.CategoryId })
                .ToListAsync(_cts.Token);

            var existingSet = existing.Select(e => (e.TemplateGroupId, e.CategoryId)).ToHashSet();

            var now = DateTime.UtcNow;
            var toAdd = new List<AttributeTemplateCategories>();
            foreach (var g in groupIds)
                foreach (var c in catIds)
                    if (!existingSet.Contains((g, c)))
                        toAdd.Add(new AttributeTemplateCategories
                        {
                            Id = Guid.NewGuid(),
                            TemplateGroupId = g,
                            CategoryId = c,
                            CreatedAt = now
                        });

            int added = 0;
            for (int i = 0; i < toAdd.Count; i += BULK_CHUNK)
            {
                var slice = toAdd.Skip(i).Take(BULK_CHUNK).ToList();
                db.AttributeTemplateCategories.AddRange(slice);
                await db.SaveChangesAsync(_cts.Token);
                added += slice.Count;
            }

            await Logger.TakeIt(use?.Id, PAGE_TITLE, "BulkAssignCategory",
                "message", $"{groupIds.Count} grup × {catIds.Count} kategori → {added} yeni satır");

            StateHub.NotifyDataChanged(ENTITY_NAME);
            await HideModal("BulkCategoryModal");
            await Notify("success", "Tamam", $"{added} yeni kategori ataması yapıldı.");
            ClearSelection();
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            await LogError("BulkAssignCategory", ex);
            await Notify("danger", "Hata", "Toplu kategori atama sırasında sorun oluştu.");
        }
        finally { _isSaving = false; StateHasChanged(); }
    }

