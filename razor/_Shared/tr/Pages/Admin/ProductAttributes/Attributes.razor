            </div>
            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal" @onclick="() => _bulkDeletePreview.Clear()">
                    <i class="fa fa-arrow-left me-1"></i>Vazgeç
                </button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="BulkDeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>@_selectedIds.Count Kaydı Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {
    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Attribute Yönetimi";
    private const string ENTITY_NAME = "AttributeDefinition";
    private const string CACHE_KEY = "AttributeDefinition_List";
    private const int SEARCH_DELAY = 500;
    private const int PAGE_SIZE = 10;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;
    private int _activeTab = 1;

    // ─── Veriler ──────────────────────────────────────────────────
    private List<AttributeDefinition> _allItems = new();
    private List<AttributeDefinition> _pagedItems = new();
    private List<AttributeGroup> _groups = new();
    private List<UnitGroup> _unitGroups = new();
    private Dictionary<Guid, string> _groupLookup = new();
    private Dictionary<Guid, string> _allAttributeLookup = new(); // Dependency lookup için

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;

    // ─── Seçim ────────────────────────────────────────────────────
    private readonly HashSet<Guid> _selectedIds = new();
    private bool _allSelected;
    private List<AttributeDefinition> _bulkDeletePreview = new();

    // ─── Ekle modal state ─────────────────────────────────────────
    private AttributeDefinition? _addModel;
    private Guid _addUnitGroupId;
    private List<Unit> _addUnits = new();

    // ─── Düzenle modal state ──────────────────────────────────────
    private AttributeDefinition? _editModel;
    private Guid _editUnitGroupId;
    private List<Unit> _editUnits = new();

    // ─── Options tab state ────────────────────────────────────────
    private List<AttributeOption> _editOptions = new();
    private Guid _editingOptionId;
    private AttributeOption _optionBuffer = new();

    // ─── Translations tab state ───────────────────────────────────
    private List<AttributeTranslation> _editTranslations = new();
    private Guid _editingTranslationId;
    private AttributeTranslation _translationBuffer = new();

    // ─── Alias tab state ──────────────────────────────────────────
    private List<AttributeAlias> _editAliases = new();
    private Guid _editingAliasId;
    private AttributeAlias _aliasBuffer = new();

    // ─── Synonym tab state ────────────────────────────────────────
    private List<AttributeSynonym> _editSynonyms = new();
    private Guid _editingSynonymId;
    private AttributeSynonym _synonymBuffer = new();

    // ─── Dependency tab state (YENİ) ──────────────────────────────
    private List<AttributeDependency> _editDependencies = new();
    private Guid _editingDependencyId;
    private AttributeDependency _dependencyBuffer = new();

    // ─── Sil modal state ──────────────────────────────────────────
    private AttributeDefinition? _deleteTarget;

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleDataChanged;
        await Task.WhenAll(LoadDataAsync(_searchTerm), LoadLookupsAsync());
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;
        await InvokeAsync(async () => { await LoadDataAsync(_searchTerm); StateHasChanged(); });
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    private async Task LoadDataAsync(string? search)
    {
        _searchCts?.Cancel(); _searchCts?.Dispose(); _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            if (!string.IsNullOrWhiteSpace(search)) await Task.Delay(SEARCH_DELAY, token);
            if (token.IsCancellationRequested) return;
            _isLoading = true; StateHasChanged();

            string cacheKey = string.IsNullOrWhiteSpace(search) ? CACHE_KEY : $"{CACHE_KEY}_{search}";
            if (!string.IsNullOrWhiteSpace(search)) StateHub.ClearCache(cacheKey);

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);
                var q = db.Set<AttributeDefinition>().AsNoTracking().AsQueryable();
                q = q.Where(x => x.IsDeleted == null || x.IsDeleted.IsDeletedStatu == null || x.IsDeleted.IsDeletedStatu == false);
                return await q.OrderBy(x => x.DisplayOrder).ThenBy(x => x.CanonicalName).ToListAsync(token);
            }, token);

            if (token.IsCancellationRequested || result == null) return;

            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim();
                result = result.Where(x =>
                    Contains(x.CanonicalCode, s) || Contains(x.CanonicalName, s) || Contains(x.NormalizedName, s)
                ).ToList();
            }
            _allItems = result;
            ApplyPaging(1);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested) { await LogError("LoadData", ex); await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu."); }
        }
        finally { if (!token.IsCancellationRequested) { _isLoading = false; StateHasChanged(); } }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _groups = await db.Set<AttributeGroup>().AsNoTracking()
                .Where(x => x.IsDeleted == null || x.IsDeleted.IsDeletedStatu == null || x.IsDeleted.IsDeletedStatu == false)
                .OrderBy(x => x.DisplayOrder).ThenBy(x => x.CanonicalName).ToListAsync(_cts.Token);
            _groupLookup = _groups.ToDictionary(g => g.Id, g => g.CanonicalName);

            _unitGroups = await db.Set<UnitGroup>().AsNoTracking()
                .Where(x => x.IsDeleted == null || x.IsDeleted.IsDeletedStatu == null || x.IsDeleted.IsDeletedStatu == false)
                .OrderBy(x => x.CanonicalName).ToListAsync(_cts.Token);

            // Tüm attribute'ları dependency lookup için yükle (YENİ)
            var allAttrs = await db.Set<AttributeDefinition>().AsNoTracking()
                .Where(x => x.IsDeleted == null || x.IsDeleted.IsDeletedStatu == null || x.IsDeleted.IsDeletedStatu == false)
                .OrderBy(x => x.CanonicalName).ToListAsync(_cts.Token);
            _allAttributeLookup = allAttrs.ToDictionary(a => a.Id, a => $"{a.CanonicalName} ({a.CanonicalCode})");
        }
        catch (Exception ex) { await LogError("LoadLookups", ex); }
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void ApplyPaging(int page)
    {
        _totalPages = Math.Max(1, (int)Math.Ceiling(_allItems.Count / (double)PAGE_SIZE));
        _currentPage = Math.Clamp(page, 1, _totalPages);
        _pagedItems = _allItems.Skip((_currentPage - 1) * PAGE_SIZE).Take(PAGE_SIZE).ToList();
    }

    private void GoToPage(int page) { ApplyPaging(page); StateHasChanged(); }

    // ══════════════════════════════════════════════════════════════
    // AKILLI SAYFALAMA (taşma düzeltmesi)
    // ══════════════════════════════════════════════════════════════
    private List<int> GetVisiblePages()
    {
        var pages = new List<int>();
        const int window = 2;
        if (_totalPages <= 7)
        {
            for (int i = 1; i <= _totalPages; i++) pages.Add(i);
            return pages;
        }
        pages.Add(1);
        int start = Math.Max(2, _currentPage - window);
        int end = Math.Min(_totalPages - 1, _currentPage + window);
        if (start > 2) pages.Add(-1);
        for (int i = start; i <= end; i++) pages.Add(i);
        if (end < _totalPages - 1) pages.Add(-1);
        pages.Add(_totalPages);
        return pages;
    }

    // ══════════════════════════════════════════════════════════════
    // CASCADE: UnitGroup → Unit
    // ══════════════════════════════════════════════════════════════

    private async Task OnUnitGroupChanged(ChangeEventArgs e, bool isAdd)
    {
        Guid.TryParse(e.Value?.ToString(), out var ugId);
        if (isAdd) { _addUnitGroupId = ugId; _addModel!.BaseUnitId = null; _addUnits.Clear(); }
        else { _editUnitGroupId = ugId; _editModel!.BaseUnitId = null; _editUnits.Clear(); }

        if (ugId != Guid.Empty)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var units = await db.Set<Unit>().AsNoTracking()
                    .Where(u => u.UnitGroupId == ugId && (u.IsDeleted == null || u.IsDeleted.IsDeletedStatu == null || u.IsDeleted.IsDeletedStatu == false))
                    .OrderBy(u => u.DisplayOrder).ToListAsync(_cts.Token);
                if (isAdd) _addUnits = units; else _editUnits = units;
            }
            catch (Exception ex) { await LogError("OnUnitGroupChanged", ex); }
        }
        StateHasChanged();
    }

