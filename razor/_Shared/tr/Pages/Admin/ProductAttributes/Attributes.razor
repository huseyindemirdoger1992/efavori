    private async Task OpenCategoryPanel(TemplateRow t)
    {
        _catPanelTarget = t;
        _catSearchTerm = string.Empty;
        _catSearchResults.Clear();
        _catSearchOpen = false;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var catIds = await db.AttributeTemplateCategories
                .AsNoTracking()
                .Where(c => c.TemplateGroupId == t.TemplateGroupId)
                .Select(c => c.CategoryId)
                .ToListAsync(_cts.Token);

            if (catIds.Count > 0)
            {
                var cats = await db.CategoriesTr
                    .AsNoTracking()
                    .Where(c => catIds.Contains(c.Id))
                    .Select(c => new { c.Id, c.Name, c.DepartmentName })
                    .ToListAsync(_cts.Token);

                _catAssigned = cats.Select(c => new CategoryLookup
                {
                    Id = c.Id,
                    Name = c.Name,
                    DepartmentName = c.DepartmentName,
                    Path = string.IsNullOrWhiteSpace(c.DepartmentName)
                        ? (c.Name ?? string.Empty)
                        : $"{c.DepartmentName} › {c.Name}"
                }).OrderBy(x => x.Path).ToList();
            }
            else
            {
                _catAssigned = new();
            }
        }
        catch (Exception ex)
        {
            await LogError("LoadGroupCats", ex);
            _catAssigned = new();
        }

        await ShowOffcanvas("CategoryOffcanvas");
    }

    private async Task OnCatSearchInput(ChangeEventArgs e)
    {
        _catSearchTerm = e.Value?.ToString() ?? string.Empty;
