    private async Task LoadRelatedDataAsync(Guid attributeId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _editOptions = await db.Set<AttributeOption>().AsNoTracking()
                .Where(o => o.AttributeDefinitionId == attributeId && (o.IsDeleted == null || o.IsDeleted.IsDeletedStatu == null || o.IsDeleted.IsDeletedStatu == false))
                .OrderBy(o => o.DisplayOrder).ThenBy(o => o.CanonicalValue).ToListAsync(_cts.Token);

            _editTranslations = await db.Set<AttributeTranslation>().AsNoTracking()
                .Where(t => t.AttributeDefinitionId == attributeId && (t.IsDeleted == null || t.IsDeleted.IsDeletedStatu == null || t.IsDeleted.IsDeletedStatu == false))
                .OrderBy(t => t.Language).ToListAsync(_cts.Token);

            _editAliases = await db.Set<AttributeAlias>().AsNoTracking()
                .Where(a => a.AttributeDefinitionId == attributeId && (a.IsDeleted == null || a.IsDeleted.IsDeletedStatu == null || a.IsDeleted.IsDeletedStatu == false))
                .OrderBy(a => a.Language).ToListAsync(_cts.Token);

            _editSynonyms = await db.Set<AttributeSynonym>().AsNoTracking()
                .Where(s => s.AttributeDefinitionId == attributeId && (s.IsDeleted == null || s.IsDeleted.IsDeletedStatu == null || s.IsDeleted.IsDeletedStatu == false))
                .OrderBy(s => s.Token).ToListAsync(_cts.Token);

            // Dependencies yükle (YENİ)
            _editDependencies = await db.Set<AttributeDependency>().AsNoTracking()
                .Where(d => d.SourceAttributeDefinitionId == attributeId || d.TargetAttributeDefinitionId == attributeId)
                .Where(d => d.IsDeleted == null || d.IsDeleted.IsDeletedStatu == null || d.IsDeleted.IsDeletedStatu == false)
                .OrderBy(d => d.ConditionGroup).ThenBy(d => d.DisplayOrder).ToListAsync(_cts.Token);
        }
        catch (Exception ex) { await LogError("LoadRelatedData", ex); }
    }

