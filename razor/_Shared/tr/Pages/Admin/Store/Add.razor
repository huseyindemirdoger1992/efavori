    private List<Data.Media> _galleryOutSideFiles = new();
    private List<Data.Media> _galleryInSideFiles = new();
    private List<Data.Media> _galleryDocuments = new();

    // ─── Modal Açma Metotları ────────────────────────────────────────────────
    // Her metot yalnızca kendi slotunu aktif eder.
    // data-bs-target ile eşleşen benzersiz modal ID'si Bootstrap'in
    // doğru modalı açmasını garantiler.
    private void OpenGalleryOutModal() => _activeMediaSlot = "galleryOutSide";
    private void OpenGalleryInModal() => _activeMediaSlot = "galleryInSide";
    private void OpenDocumentModal() => _activeMediaSlot = "galleryDocuments";

    private void CloseMediaModal()
    {
        // Modal kapanınca slot sıfırlanır → List component DOM'dan kaldırılır
        // → FileService event'leri artık hiçbir List'e ulaşamaz.
        _activeMediaSlot = string.Empty;
    }

    // ─── Tekli Seçim Handler ────────────────────────────────────────────────
    private void HandleSingleFileSelected(Data.Media media)
    {
        switch (_activeMediaSlot)
        {
            case "profile": _profileMedia = media; break;
            case "cover": _coverMedia = media; break;

            // --- İşletme Evrakları Slotları ---
            case "certificateOfIncorporation": _certificateOfIncorporation = media; break;
            case "activityCertificate": _activityCertificate = media; break;
            case "taxRegistration": _taxRegistration = media; break;
            case "tradeRegistryGazette": _tradeRegistryGazette = media; break;
            case "signatureCircular": _signatureCircular = media; break;
            case "authorizedPersonId": _authorizedPersonId = media; break;
            case "proofOfBusinessAddress": _proofOfBusinessAddress = media; break;
            case "bankStatement": _bankStatement = media; break;
            case "bankAccountConfirmation": _bankAccountConfirmation = media; break;
            case "trademarkCertificate": _trademarkCertificate = media; break;
            case "letterOfAuthorization": _letterOfAuthorization = media; break;
            case "qualityCertificates": _qualityCertificates = media; break;
            case "customsRegistration": _customsRegistration = media; break;
            case "socialSecurityRegistration": _socialSecurityRegistration = media; break;
            case "proofOfOwnership": _proofOfOwnership = media; break;

            default: break;
        }
        InvokeAsync(StateHasChanged);
    }

    // ─── Çoklu Seçim Handler ────────────────────────────────────────────────
    private void HandleMultiSelectionChanged(List<Data.Media> files)
    {
        if (files == null) return;

        // Uzman Notu: Bileşen kümülatif (toplam) liste gönderiyorsa,
        // diğer slotların verilerini mevcut 'files' içerisinden ayıklamalıyız.
        switch (_activeMediaSlot)
        {
            case "galleryOutSide":
                // files içerisinden, diğer slotlarda zaten var olanları çıkar.
                _galleryOutSideFiles = files.Except(_galleryInSideFiles).Except(_galleryDocuments).ToList();
                break;

            case "galleryInSide":
                _galleryInSideFiles = files.Except(_galleryOutSideFiles).Except(_galleryDocuments).ToList();
                break;

            case "galleryDocuments":
                _galleryDocuments = files.Except(_galleryOutSideFiles).Except(_galleryInSideFiles).ToList();
                break;

            default: break;
        }

        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        FileService.OnFileSelected += HandleSingleFileSelected;
        FileService.OnSelectionChanged += HandleMultiSelectionChanged;
    }

    protected async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int countryId);
        _States.Clear();
        _Cities.Clear();

        if (countryId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _States = await db.States.AsNoTracking()
                .Where(s => s.country_id == countryId)
                .OrderBy(s => s.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int stateId);
        _Cities.Clear();

        if (stateId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _Cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == stateId)
                .OrderBy(c => c.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;

        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;

        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleGlobalDataChange;
        FileService.OnFileSelected -= HandleSingleFileSelected;
        FileService.OnSelectionChanged -= HandleMultiSelectionChanged;

        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;

        var shouldRefresh = entityName == "Users";

        if (shouldRefresh)
        {
            await InvokeAsync(async () =>
            {
                await LoadData(null);
                StateHasChanged();
            });
        }
    }

    protected virtual async Task LoadData(string? search)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(1000, token);

            if (_isLoading) return;
            _isLoading = true;
            using var db = await DbFactory.CreateDbContextAsync();
            _Countries = await db.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync();
            StateHasChanged();

            var result = await StateHub.GetOrLoadAsync("DataManager_Main", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query = db.Users.AsNoTracking().Where(u => u.IsActive == true);

                if (!string.IsNullOrWhiteSpace(search))
                {
                    query = query.Where(u =>
                        u.FirstName.Contains(search) ||
                        u.LastName.Contains(search));
                }

                var users = await query
                    .OrderByDescending(u => u.RegistrationDate)
                    .ToListAsync(token);

                return new { Users = users };

            }, token);

            if (result != null && !token.IsCancellationRequested)
                Users = result.Users;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    protected async Task AddUser(Users newUser)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            newUser.RegistrationDate = DateTime.UtcNow;
            db.Users.Add(newUser);
            await db.SaveChangesAsync(_cts.Token);

            await StateHub.NotifyDataChanged("Users");

            await Logger.TakeIt(newUser.Id, PAGE, "AddUser");

            await ShowNotification("success", "Başarılı", "Kullanıcı başarıyla eklendi.", null);
            await JS.InvokeVoidAsync("eval", $"$('#Modal_{null}').modal('hide')");
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "AddUser",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Kullanıcı eklenirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

