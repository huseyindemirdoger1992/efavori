@using api
@using api.tr
@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using razor._Shared.tr.Media

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
@inject FileUploadService FileService

<Notification @ref="notificationRef" />

@{
    var roads = new List<(string icon, string Name, string Url)>
                                    {
                                    ("fa fa-globe","efavori", $"/"),
                                    ("fa fa-building","Mağza/İşletme Yönetimi", "javascript:void(0)"),
                                    ("fa fa-plus","Yeni Ekle", "javascript:void(0)")
                                    };
}
<razor._Shared.BreadCrumbLinksUrl roads=roads />

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}

@if (Users is not null)
{

}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-12 col-xl-12">
            <div class="card shadow-sm border-0 overflow-hidden">

                <!-- Kapak Fotoğrafı -->
                <div class="position-relative">

                    @if (_coverMedia is not null)
                    {
                        <img src="@_coverMedia.FileUrl"
                             class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="@_coverMedia.FileName">
                    }
                    else
                    {
                        <img src="https://efavori.com/_files/main/NoImage.png"
                             class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="Kapak Fotoğrafı">
                    }
                    <div class="position-absolute bottom-0 end-0 m-3">
                        <button type="button" class="btn btn-light btn-sm fw-bold shadow-sm border-0" data-bs-toggle="modal" data-bs-target="#modalCoverList"
                                @onclick='() => _activeMediaSlot = "cover"'>
                            <i class="fa fa-camera me-2"></i>Kapak Fotoğrafını Düzenle
                        </button>
                    </div>
                </div>

                <div class="card-body px-4 pt-0">
                    <!-- Profil Fotoğrafı -->
                    <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end" style="margin-top: -100px;">
                        <div class="position-relative">
                            @if (_profileMedia is not null)
                            {
                                <img src="@_profileMedia.FileUrl"
                                     class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                     width="168" height="168" style="object-fit: cover;" alt="@_profileMedia.FileName">
                            }
                            else
                            {
                                <img src="https://efavori.com/_files/main/NoImage.png"
                                     class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                     width="168" height="168" style="object-fit: cover;" alt="No Image">
                            }
                            <button type="button"
                                    class="btn btn-light border-0 btn-sm rounded-circle position-absolute bottom-0 end-0 mb-2 me-1 shadow d-flex align-items-center justify-content-center"
                                    style="width: 36px; height: 36px;" data-bs-toggle="modal" data-bs-target="#modalProfileList"
                                    @onclick='() => _activeMediaSlot = "profile"'>
                                <i class="fa fa-camera text-dark" style="margin-left:5px;"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-12" style="margin-top:5px;">
                        <label class="form-label">İşletme/Mağza Adını Belirtiniz</label>
                        <input class="form-control mb-3" type="text">
                    </div>

                    <div class="card bg-light">
