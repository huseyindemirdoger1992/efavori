@code {

    private const string PAGE = "DataManager";

    [Parameter] public Users? use { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;

    private bool _isLoading;
    private CancellationTokenSource? _searchCts;

    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _isProcessing;

    private DotNetObjectReference<Add>? _objRef;
    private bool _mapInitialized;

    private List<Users>? Users { get; set; } = new();

    private List<Country> _Countries = new();
    private List<States> _States = new();
    private List<Cities> _Cities = new();

    private Notification? notificationRef;

    private Store _Store = new Store();
    private data._Galleries.MediaItems _ItemGallery = new data._Galleries.MediaItems();


    // --- Medya Seçim State ---
    private string _activeMediaSlot = string.Empty;

    // Tekli seçimler
    private data._Galleries.Media? _profileMedia;
    private data._Galleries.Media? _coverMedia;

    private data._Galleries.Media? _certificateOfIncorporation; // Şirket Kuruluş Belgesi (Certificate of Incorporation) *
    private data._Galleries.Media? _activityCertificate;        // Güncel Faaliyet Belgesi (Son 3 Aylık - Activity Certificate) *
    private data._Galleries.Media? _taxRegistration;            // Vergi Levhası / VAT / GST / EIN Sertifikası (Tax Registration) *
    private data._Galleries.Media? _tradeRegistryGazette;       // Ticaret Sicil Gazetesi Örneği (Trade Registry Gazette)
    private data._Galleries.Media? _signatureCircular;          // İmza Sirküleri veya Yetki Belgesi (Signature Circular / POA) *
    private data._Galleries.Media? _authorizedPersonId;         // Şirket Yetkilisi Pasaport veya Kimlik Görseli (Authorized Person ID) *
    private data._Galleries.Media? _proofOfBusinessAddress;     // Şirket Adres Kanıtı - Fatura/Resmi Belge (Proof of Business Address) *
    private data._Galleries.Media? _bankStatement;              // Son 3 Aya Ait Banka Hesap Dökümü (Bank Statement)
    private data._Galleries.Media? _bankAccountConfirmation;    // IBAN / SWIFT Doğrulama Mektubu veya Dekontu (Bank Confirmation) *
    private data._Galleries.Media? _trademarkCertificate;       // Marka Tescil Belgesi (Trademark Certificate)
    private data._Galleries.Media? _letterOfAuthorization;      // Yetkili Satıcı Onay Belgesi (Letter of Authorization - LOA)
    private data._Galleries.Media? _qualityCertificates;        // Ürün Kalite ve Sağlık Sertifikaları (CE, ISO, FDA vb.)
    private data._Galleries.Media? _customsRegistration;        // Gümrük Kayıt Belgesi (EORI veya Gümrük No - Customs Registration)
    private data._Galleries.Media? _socialSecurityRegistration; // Sosyal Güvenlik / İşletme Kayıt No Belgesi (Social Security/Employer ID)
    private data._Galleries.Media? _proofOfOwnership;           // Şirket Ortaklık Yapısı ve Nihai Faydalanıcı Belgesi (Proof of Ownership/UBO) *

    // Çoklu seçimler (Slot bazlı izole listeler)
    private List<data._Galleries.Media> _galleryOutSideFiles = new();
    private List<data._Galleries.Media> _galleryInSideFiles = new();
    private List<data._Galleries.Media> _galleryDocuments = new();

    // ─── Modal Açma Metotları ────────────────────────────────────────────────
    // Her metot yalnızca kendi slotunu aktif eder.
    // data-bs-target ile eşleşen benzersiz modal ID'si Bootstrap'in
    // doğru modalı açmasını garantiler.
    private void OpenGalleryOutModal() => _activeMediaSlot = "galleryOutSide";
    private void OpenGalleryInModal() => _activeMediaSlot = "galleryInSide";
    private void OpenDocumentModal() => _activeMediaSlot = "galleryDocuments";

    private void CloseMediaModal()
    {
        // Modal kapanınca slot sıfırlanır → List component DOM'dan kaldırılır
        // → FileService event'leri artık hiçbir List'e ulaşamaz.
        _activeMediaSlot = string.Empty;
    }

    // ─── Tekli Seçim Handler ────────────────────────────────────────────────
    private void HandleSingleFileSelected(data._Galleries.Media media)
    {
        switch (_activeMediaSlot)
        {
            case "profile": _profileMedia = media; break;
            case "cover": _coverMedia = media; break;

            // --- İşletme Evrakları Slotları ---
            case "certificateOfIncorporation": _certificateOfIncorporation = media; break;
            case "activityCertificate": _activityCertificate = media; break;
            case "taxRegistration": _taxRegistration = media; break;
            case "tradeRegistryGazette": _tradeRegistryGazette = media; break;
            case "signatureCircular": _signatureCircular = media; break;
            case "authorizedPersonId": _authorizedPersonId = media; break;
            case "proofOfBusinessAddress": _proofOfBusinessAddress = media; break;
            case "bankStatement": _bankStatement = media; break;
            case "bankAccountConfirmation": _bankAccountConfirmation = media; break;
            case "trademarkCertificate": _trademarkCertificate = media; break;
            case "letterOfAuthorization": _letterOfAuthorization = media; break;
            case "qualityCertificates": _qualityCertificates = media; break;
            case "customsRegistration": _customsRegistration = media; break;
            case "socialSecurityRegistration": _socialSecurityRegistration = media; break;
            case "proofOfOwnership": _proofOfOwnership = media; break;

            default: break;
        }
        InvokeAsync(StateHasChanged);
    }

    // ─── Çoklu Seçim Handler ────────────────────────────────────────────────
    private void HandleMultiSelectionChanged(List<data._Galleries.Media> files)
    {
        if (files == null) return;

        // Uzman Notu: Bileşen kümülatif (toplam) liste gönderiyorsa,
        // diğer slotların verilerini mevcut 'files' içerisinden ayıklamalıyız.
        switch (_activeMediaSlot)
        {
            case "galleryOutSide":
                // files içerisinden, diğer slotlarda zaten var olanları çıkar.
                _galleryOutSideFiles = files.Except(_galleryInSideFiles).Except(_galleryDocuments).ToList();
                break;

            case "galleryInSide":
                _galleryInSideFiles = files.Except(_galleryOutSideFiles).Except(_galleryDocuments).ToList();
                break;

            case "galleryDocuments":
                _galleryDocuments = files.Except(_galleryOutSideFiles).Except(_galleryInSideFiles).ToList();
                break;

            default: break;
        }

        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        FileService.OnFileSelected += HandleSingleFileSelected;
        FileService.OnSelectionChanged += HandleMultiSelectionChanged;
    }

    protected async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int countryId);
        _States.Clear();
        _Cities.Clear();
        _Store.AddressInfo!.Country = _Countries
            .FirstOrDefault(c => c.id == countryId)?.name;

        if (countryId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _States = await db.States.AsNoTracking()
                .Where(s => s.country_id == countryId)
                .OrderBy(s => s.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int stateId);
        _Cities.Clear();
        _Store.AddressInfo!.State = _States
            .FirstOrDefault(s => s.id == stateId)?.name;

        if (stateId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _Cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == stateId)
                .OrderBy(c => c.name).ToListAsync();
        }
        StateHasChanged();
    }

    // Şehir seçimi → AddressInfo.City'e yaz
    private void OnCitySelected(ChangeEventArgs e)
    {
        _Store.AddressInfo!.City = _Cities
            .FirstOrDefault(c => c.id.ToString() == e.Value?.ToString())?.name;
    }

    // JS'den Lat/Lng almak için (DotNetObjectReference ile instance çağrısı)
    [JSInvokable]
    public Task SetLatLng(double lat, double lng)
    {
        if (_Store?.AddressInfo != null)
        {
            _Store.AddressInfo.Latitude = (decimal)lat;
