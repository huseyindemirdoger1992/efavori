                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#primaryhome" role="tab" aria-selected="true">
                                        <div class="d-flex align-items-center">
                                            <div class="tab-icon">
                                                <i class="fa fa-camera font-18 me-1"></i>
                                            </div>
                                            <div class="tab-title">İşletme Dış Çekimleri</div>
                                        </div>
                                    </a>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <a class="nav-link" data-bs-toggle="tab" href="#primaryprofile" role="tab" aria-selected="false">
                                        <div class="d-flex align-items-center">
                                            <div class="tab-icon">
                                                <i class="fa fa-building-o font-18 me-1"></i>
                                            </div>
                                            <div class="tab-title">İşletme İç Çekimleri</div>
                                        </div>
                                    </a>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <a class="nav-link" data-bs-toggle="tab" href="#primarycontact" role="tab" aria-selected="false">
                                        <div class="d-flex align-items-center">
                                            <div class="tab-icon">
                                                <i class="fa fa-file-pdf-o font-18 me-1"></i>
                                            </div>
                                            <div class="tab-title">İşletme Resmi Evrakları</div>
                                        </div>
                                    </a>
                                </li>
                            </ul>

                            <div class="tab-content py-3">
                                <div class="tab-pane fade show active" id="primaryhome" role="tabpanel">
                                    <div class="mb-4">
                                        <label class="form-label text-light fw-semibold">
                                            <i class="fa fa-tree me-1 text-success"></i>İşletme Dış Çekim Görselleri
                                            <span class="badge bg-secondary ms-2 fw-normal" style="font-size:0.7rem;">En Az 3 Görsel</span>
                                        </label>
                                        <div class="row g-2 mb-3">
                                            <div class="col-md-12">
                                                <button type="button" class="btn btn-outline-light btn-sm w-100"
                                                        data-bs-toggle="modal" data-bs-target="#modalGalleryOutSide"
                                                        @onclick="OpenGalleryOutModal">
                                                    <i class="fa fa-picture-o me-1"></i>Medyadan Seç
                                                    @if (_galleryOutSideFiles.Any())
                                                    {
                                                        <span class="badge bg-primary ms-1">@_galleryOutSideFiles.Count</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                        @if (_galleryOutSideFiles.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var m in _galleryOutSideFiles.ToList())
                                                {
                                                    <div class="position-relative">
                                                        <img src="@m.FileUrl" class="rounded border border-secondary" style="width:65px;height:65px;object-fit:cover;" alt="@m.FileName" />
                                                        <button type="button"
                                                                class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center border-0"
                                                                style="width:20px;height:20px;font-size:0.7rem; margin-top:-5px; margin-right:-5px;"
                                                                @onclick="() => { _galleryOutSideFiles.Remove(m); }">
                                                            <i class="fa fa-times text-white" style="margin-left:5px"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="primaryprofile" role="tabpanel">
                                    <div class="mb-4">
                                        <label class="form-label text-light fw-semibold">
                                            <i class="fa fa-search-plus me-1 text-success"></i>İşletme İç Çekim Görselleri
