    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;

        _isInitialized = true;

        // _Store null geliyorsa burada initialize et
        _Store ??= new Store();

        StateHub.OnDataChanged += HandleGlobalDataChange;

        await LoadData(null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Harita yalnızca model hazır olduğunda kurulur.
        if (_mapInitialized || _Store?.AddressInfo == null)
            return;

        try
        {
            // 1) Harita motorunu eval ile tanımla (inline <script> interactive modda çalışmaz)
            await JS.InvokeVoidAsync("eval", AddMapEngineScript);

            // 2) DotNet referansı ile başlat (koordinatlar JS → C# iletimi için gerekli)
            _objRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("storeAddMap.init", _objRef,
                _Store.AddressInfo.Latitude, _Store.AddressInfo.Longitude);

            _mapInitialized = true;
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "MapInit",
                exception: ex.Message, stackTrace: ex.StackTrace);
        }
    }

    // Harita motoru (Leaflet yükleyici + init). eval ile çalıştırılır → her render modunda güvenli.
    private const string AddMapEngineScript = @"
        if (!window.storeAddMap) {
            window.storeAddMap = (function () {
                var map = null, marker = null, dotnet = null;

                function injectAssets() {
                    if (!document.getElementById('leaflet-css')) {
                        var l = document.createElement('link');
                        l.id = 'leaflet-css'; l.rel = 'stylesheet';
                        l.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                        document.head.appendChild(l);
                    }
                    if (typeof L === 'undefined' && !document.getElementById('leaflet-js')) {
                        var s = document.createElement('script');
                        s.id = 'leaflet-js';
                        s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                        document.head.appendChild(s);
                    }
                }

                function place(lat, lng, zoom) {
                    if (!map) return;
                    var c = [lat, lng];
                    map.setView(c, zoom || 15);
                    if (marker) { marker.setLatLng(c); } else { marker = L.marker(c).addTo(map); }
                    marker.bindPopup('Bulunduğunuz Yer').openPopup();
                }

                function build(lat, lng) {
                    var el = document.getElementById('add_map');
                    if (!el) return;
                    if (map) { map.remove(); map = null; marker = null; }

                    var has = (lat !== null && lat !== undefined && lng !== null && lng !== undefined && lat !== 0 && lng !== 0);
                    map = L.map(el).setView([has ? lat : 38.9637, has ? lng : 35.2433], has ? 14 : 6);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
                    if (has) { place(lat, lng, 14); }
                    setTimeout(function () { if (map) map.invalidateSize(); }, 300);

                    var btn = document.getElementById('btnAddGetLocation');
                    if (btn && !btn.dataset.bound) {
                        btn.dataset.bound = '1';
                        btn.addEventListener('click', function () {
                            var o = btn.innerHTML; btn.disabled = true;
                            btn.innerHTML = '<i class=""fa fa-spinner fa-spin me-2""></i> Konum Alınıyor...';
                            if ('geolocation' in navigator) {
                                navigator.geolocation.getCurrentPosition(
                                    function (p) {
                                        var la = p.coords.latitude, lo = p.coords.longitude;
                                        place(la, lo, 15);
                                        if (dotnet) { dotnet.invokeMethodAsync('SetLatLng', la, lo); }
                                        btn.disabled = false; btn.innerHTML = o;
                                    },
                                    function (e) { alert('Hata: ' + e.message); btn.disabled = false; btn.innerHTML = o; },
                                    { enableHighAccuracy: true, timeout: 5000 }
                                );
                            } else { alert('Tarayıcınız konumu desteklemiyor.'); btn.disabled = false; btn.innerHTML = o; }
                        });
                    }
                }

                return {
                    init: function (ref, lat, lng) {
                        dotnet = ref;
                        injectAssets();
                        var a = 0;
                        (function t() {
                            var el = document.getElementById('add_map');
                            var ok = el && (typeof L !== 'undefined');
                            if (!ok) { if (a++ < 80) { setTimeout(t, 150); } return; }
                            try { build(lat, lng); } catch (e) { console.error('storeAddMap.build', e); }
                        })();
                    }
                };
            })();
        }
    ";

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleGlobalDataChange;
        FileService.OnFileSelected -= HandleSingleFileSelected;
        FileService.OnSelectionChanged -= HandleMultiSelectionChanged;

        _objRef?.Dispose();

        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;

        var shouldRefresh = entityName == "Users";

        if (shouldRefresh)
        {
            await InvokeAsync(async () =>
            {
                await LoadData(null);
                StateHasChanged();
            });
        }
    }

    protected virtual async Task LoadData(string? search)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(1000, token);

            if (_isLoading) return;
            _isLoading = true;
            using var db = await DbFactory.CreateDbContextAsync();
            _Countries = await db.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync();
            StateHasChanged();

            var result = await StateHub.GetOrLoadAsync("DataManager_Main", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query = db.Users.AsNoTracking().Where(u => u.IsActive == true);

                if (!string.IsNullOrWhiteSpace(search))
                {
                    query = query.Where(u =>
                        u.FirstName.Contains(search) ||
                        u.LastName.Contains(search));
                }

                var users = await query
                    .OrderByDescending(u => u.RegistrationDate)
                    .ToListAsync(token);

                return new { Users = users };

            }, token);

            if (result != null && !token.IsCancellationRequested)
                Users = result.Users;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    protected async Task AddStore()
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            // ──────────────────────────────────────────
            // 1. VALIDATION — Zorunlu Alan Kontrolleri
            // ──────────────────────────────────────────
            var errors = new List<string>();

            // Temel Bilgiler
            if (string.IsNullOrWhiteSpace(_Store.Name))
                errors.Add("İşletme/Mağaza adı boş bırakılamaz.");

            if (string.IsNullOrWhiteSpace(_Store.Description))
                errors.Add("İşletme/Mağaza açıklaması boş bırakılamaz.");

            // İletişim Bilgileri
            if (_Store.ContactInformation == null)
            {
                errors.Add("İletişim bilgileri boş bırakılamaz.");
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_Store.ContactInformation.Email))
                    errors.Add("E-posta adresi boş bırakılamaz.");

                if (string.IsNullOrWhiteSpace(_Store.ContactInformation.CountryPhoneCode))
                    errors.Add("Ülke telefon kodu seçilmedi.");

                if (string.IsNullOrWhiteSpace(_Store.ContactInformation.PhoneNumber))
                    errors.Add("Telefon numarası boş bırakılamaz.");
            }

            // Profil & Kapak Görseli
            if (_profileMedia == null)
                errors.Add("Profil görseli yüklenmedi.");

            if (_coverMedia == null)
                errors.Add("Kapak görseli yüklenmedi.");

            // Dış / İç Çekim Galerileri
            if (_galleryOutSideFiles.Count < 3)
                errors.Add($"Dış çekim görseli en az 3 adet olmalıdır. (Şu an: {_galleryOutSideFiles.Count})");

            if (_galleryInSideFiles.Count < 3)
                errors.Add($"İç çekim görseli en az 3 adet olmalıdır. (Şu an: {_galleryInSideFiles.Count})");

            // Sadece gerekli olan 4 belge için kontrol
            if (_taxRegistration == null)
                errors.Add("Vergi kaydı belgesi yüklenmedi.");

            if (_activityCertificate == null)
                errors.Add("Faaliyet belgesi yüklenmedi.");

            if (_signatureCircular == null)
                errors.Add("İmza sirküleri yüklenmedi.");

            if (_tradeRegistryGazette == null)
                errors.Add("Ticaret sicil gazetesi yüklenmedi.");


            // Hata varsa toplu göster ve çık
            if (errors.Any())
            {
                var errorMessage = string.Join("<br/>• ", errors.Prepend("Lütfen aşağıdaki alanları doldurun:"));
                await ShowNotification("danger", "Eksik Bilgiler", $"• {errorMessage}", null);
                return;
            }

            // ──────────────────────────────────────────
            // 2. VERİ HAZIRLAMA
            // ──────────────────────────────────────────
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Admin Kontrolleri
            _Store.UserId = use.Id;
            _Store.IsActiveStateAdmin = null;
            _Store.IsActiveDateAdmin = new DateTime();

            // Satıcı Kontrolleri
            _Store.IsActiveStateVendor = true;
            _Store.IsActiveDateVendor = DateTime.UtcNow;
            _Store.CreatedAt = DateTime.UtcNow;

            // Profil / Kapak Görselleri
            _Store.ProfileCoverGallery ??= new();
            _Store.ProfileCoverGallery.ProfileImagePath = _profileMedia?.FileUrl;
            _Store.ProfileCoverGallery.CoverImagePath = _coverMedia?.FileUrl;

            // FullPhoneNumber birleştir
            if (_Store.ContactInformation != null &&
                !string.IsNullOrWhiteSpace(_Store.ContactInformation.CountryPhoneCode) &&
                !string.IsNullOrWhiteSpace(_Store.ContactInformation.PhoneNumber))
            {
                TextualFunctions textualFunctions = new TextualFunctions();
                _Store.ContactInformation.FullPhoneNumber =
                    _Store.ContactInformation.CountryPhoneCode.Trim() +
                    textualFunctions.NormalizePhoneNumberEditor(
                        _Store.ContactInformation.PhoneNumber.Trim());
            }

            // Belge GUID Atamaları
            _Store.CertificateOfIncorporation = _certificateOfIncorporation?.Id;
            _Store.ActivityCertificate = _activityCertificate?.Id;
            _Store.TaxRegistration = _taxRegistration?.Id;
            _Store.TradeRegistryGazette = _tradeRegistryGazette?.Id;
            _Store.SignatureCircular = _signatureCircular?.Id;
            _Store.AuthorizedPersonId = _authorizedPersonId?.Id;
            _Store.ProofOfBusinessAddress = _proofOfBusinessAddress?.Id;
            _Store.BankStatement = _bankStatement?.Id;
            _Store.BankAccountConfirmation = _bankAccountConfirmation?.Id;
            _Store.TrademarkCertificate = _trademarkCertificate?.Id;
            _Store.LetterOfAuthorization = _letterOfAuthorization?.Id;
            _Store.QualityCertificates = _qualityCertificates?.Id;
            _Store.CustomsRegistration = _customsRegistration?.Id;
            _Store.SocialSecurityRegistration = _socialSecurityRegistration?.Id;
            _Store.ProofOfOwnership = _proofOfOwnership?.Id;

            // Galeri Mapping
            var galleryItems = _galleryOutSideFiles
                .Select(m => new data._Galleries.MediaItems
                {
                    UserId = use.Id,
                    ItemId = _Store.Id,
                    ItemType = "OutShooting",
                    MediaId = m.Id,
                    ItemAddDate = DateTime.UtcNow,
                    IsDeleted = new data.Owned.IsDeleted { IsDeletedStatu = false }
                })
                .Concat(_galleryInSideFiles.Select(m => new data._Galleries.MediaItems
                {
                    UserId = use.Id,
                    ItemId = _Store.Id,
                    ItemType = "InShooting",
                    MediaId = m.Id,
                    ItemAddDate = DateTime.UtcNow,
                    IsDeleted = new data.Owned.IsDeleted { IsDeletedStatu = false }
                }))
                .ToList();

            // ──────────────────────────────────────────
            // 3. VERİTABANI İŞLEMİ
            // ──────────────────────────────────────────
            if (galleryItems.Any())
            {
                await db.MediaItems.AddRangeAsync(galleryItems, _cts.Token);
                await db.SaveChangesAsync(_cts.Token);
            }
            _Store.AddressInfo.MapTitle = _Store.Name;
            db.Store.Add(_Store);
            await db.SaveChangesAsync(_cts.Token);

            // ──────────────────────────────────────────
            // 4. BAŞARI BİLDİRİMLERİ
            // ──────────────────────────────────────────
            await StateHub.NotifyDataChanged("AddStore");
            await Logger.TakeIt(use.Id, PAGE, "razor._Shared.tr.Pages.Admin.Store");
            await ShowNotification("success", "Başarılı", "İşletme/Mağaza başarıyla eklendi.", null);
            await JS.InvokeVoidAsync("eval", $"$('#Modal_{null}').modal('hide')");
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "AddStore",
                exception: ex.Message,
                stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "İşletme/Mağaza eklenirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
        NavigationManager.NavigateTo($@"/{use?.Language.ToLower()}/Admin/Store/List/", true);
    }

