                                                    <td class="text-light small">Vergi Levhası / VAT / GST / EIN Sertifikası (Tax Registration)</td>
                                                    <td class="small">
                                                        @if (_taxRegistration is not null)
                                                        {
                                                            <span class="text-truncate d-inline-block" style="max-width:140px;" title="@_taxRegistration.FileName">@_taxRegistration.FileName</span>
                                                        }
                                                        else
                                                        {

                                                            <span class="text-light fst-italic">—</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (_taxRegistration is not null)
                                                        {
                                                            <span class="badge bg-success"><i class="fa fa-check me-1"></i>Yüklendi</span>
                                                        }
                                                        else
                                                        {

                                                            <span class="badge bg-danger text-light">Bekleniyor</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#modalBusinessDocumentList" @onclick='() => _activeMediaSlot = "taxRegistration"'>
                                                            <i class="fa fa-upload me-1"></i>Yükle
                                                        </button>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="text-center text-light"><i class="fa fa-file-text-o"></i></td>
                                                    <td class="fw-semibold">Faaliyet Belgesi <span class="text-danger">*</span></td>
                                                    <td class="text-light small">Güncel Faaliyet Belgesi (Son 3 Aylık - Activity Certificate)</td>
