                                                            <i class="fa fa-upload me-1"></i>Yükle
                                                        </button>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="text-center text-light"><i class="fa fa-newspaper-o"></i></td>
                                                    <td class="fw-semibold">Sicil Gazetesi <span class="text-danger">*</span></td>
