                                <label class="form-label">Google My Business Linki</label>
                                <input class="form-control" type="url" placeholder="https://business.google.com/..."
                                       @bind="_Store.AddressInfo!.GoogleMyBusinessAccountLink">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Enlem (Latitude)</label>
