    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;
        FileService.OnFileSelected += HandleSingleFileSelected;
        FileService.OnFileUploaded += HandleGalleryFileUploaded;

        await LoadCountriesAsync();
    }

    // Parametre (SelectedStore) ilk geldiğinde veya başka bir kayda değiştiğinde
    // çalışma modelini (yeniden) kur. Bu, kaydın OnInitialized'den SONRA atanması
    // ya da bileşen yeniden kullanılması durumlarında da yüklemeyi garanti eder.
    protected override async Task OnParametersSetAsync()
    {
        if (_disposed) return;

        var incomingId = SelectedStore?.Id;
        if (incomingId == null) return;
        if (_builtForId == incomingId) return; // aynı kayıt için tekrar kurma

        _builtForId = incomingId;
        _mapInitialized = false; // yeni kayıt → harita yeniden kurulsun
        await BuildWorkingModelAsync(SelectedStore!);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Harita yalnızca model hazır olduğunda kurulur.
        if (_mapInitialized || _Store?.AddressInfo == null || SelectedStore == null)
            return;

        try
        {
            // 1) Harita motorunu eval ile tanımla (markup <script> interaktif modda
            //    çalışmadığı için tek güvenilir yol budur). İçinde Leaflet'i de
            //    otomatik yükler ve hazır olana kadar bekler.
            await JS.InvokeVoidAsync("eval", MapEngineScript);

            // 2) Bu kayda ait koordinatlarla başlat (DotNet referansı geolocation içindir)
            _objRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("storeEditMap.init", _objRef,
                _Store.AddressInfo.Latitude, _Store.AddressInfo.Longitude);

            _mapInitialized = true;
        }
        catch (Exception ex) { await LogError("MapInit", ex); }
    }

    // Harita motoru (Leaflet yükleyici + init). eval ile çalıştırılır → her render modunda güvenli.
    private const string MapEngineScript = @"
        if (!window.storeEditMap) {
            window.storeEditMap = (function () {
                var map = null, marker = null, dotnet = null;

                function injectAssets() {
                    if (!document.getElementById('leaflet-css')) {
                        var l = document.createElement('link');
                        l.id = 'leaflet-css'; l.rel = 'stylesheet';
                        l.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                        document.head.appendChild(l);
                    }
                    if (typeof L === 'undefined' && !document.getElementById('leaflet-js')) {
                        var s = document.createElement('script');
                        s.id = 'leaflet-js';
                        s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                        document.head.appendChild(s);
                    }
                }

                function place(lat, lng, zoom) {
                    if (!map) return;
                    var c = [lat, lng];
                    map.setView(c, zoom || 15);
                    if (marker) { marker.setLatLng(c); } else { marker = L.marker(c).addTo(map); }
                }

                function build(lat, lng) {
                    var el = document.getElementById('edit_map');
                    if (!el) return;
                    if (map) { map.remove(); map = null; marker = null; }

                    var has = (lat !== null && lat !== undefined && lng !== null && lng !== undefined);
                    map = L.map(el).setView([has ? lat : 38.9637, has ? lng : 35.2433], has ? 14 : 6);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
                    if (has) { place(lat, lng, 14); }
                    setTimeout(function () { if (map) map.invalidateSize(); }, 300);

                    var btn = document.getElementById('btnEditGetLocation');
                    if (btn && !btn.dataset.bound) {
                        btn.dataset.bound = '1';
                        btn.addEventListener('click', function () {
                            var o = btn.innerHTML; btn.disabled = true;
                            btn.innerHTML = '<i class=""fa fa-spinner fa-spin me-2""></i> Konum Alınıyor...';
                            if ('geolocation' in navigator) {
                                navigator.geolocation.getCurrentPosition(
                                    function (p) {
                                        var la = p.coords.latitude, lo = p.coords.longitude;
                                        place(la, lo, 15);
                                        if (dotnet) { dotnet.invokeMethodAsync('SetLatLng', la, lo); }
                                        btn.disabled = false; btn.innerHTML = o;
                                    },
                                    function (e) { alert('Hata: ' + e.message); btn.disabled = false; btn.innerHTML = o; },
                                    { enableHighAccuracy: true, timeout: 5000 }
                                );
                            } else { alert('Tarayıcınız konumu desteklemiyor.'); btn.disabled = false; btn.innerHTML = o; }
                        });
                    }
                }

                return {
                    init: function (ref, lat, lng) {
                        dotnet = ref;
                        injectAssets();
                        var a = 0;
                        (function t() {
                            var el = document.getElementById('edit_map');
                            var ok = el && (typeof L !== 'undefined');
                            if (!ok) { if (a++ < 80) { setTimeout(t, 150); } return; }
                            try { build(lat, lng); } catch (e) { console.error('storeEditMap.build', e); }
                        })();
                    }
                };
            })();
        }
    ";

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        FileService.OnFileSelected -= HandleSingleFileSelected;
        FileService.OnFileUploaded -= HandleGalleryFileUploaded;

        _objRef?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    private async Task HandleDataChanged(string entityName)
    {
        // Düzenlenen kayıt dışarıdan değişirse sadece bilgilendir; aktif düzenleme ezilmez.
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;
        await InvokeAsync(StateHasChanged);
    }

    // ══════════════════════════════════════════════════════════════
    // ÇALIŞMA MODELİ KURULUMU (parametreden kopya + medya geri yükleme)
    // ══════════════════════════════════════════════════════════════

    private async Task BuildWorkingModelAsync(Store src)
    {
        // ──────────────────────────────────────────────────────────────
        // KÖK SORUN ÇÖZÜMÜ:
        // Parametreyle gelen SelectedStore, üst listedeki sorgudan/RAM
        // cache'ten kısmî (projeksiyon) gelebiliyordu. Bu durumda belge
        // GUID sütunları ve owned AddressInfo (Latitude/Longitude) BOŞ
        // geliyordu → evraklar "hiç yüklenmemiş" görünüyor, harita ve
        // koordinatlar gelmiyordu.
        // Çözüm: düzenlenecek kaydın TAM halini DB'den taze çekiyoruz.
        // (Add.razor kültürüyle uyumlu: veri her zaman DB'den okunur.)
        // ──────────────────────────────────────────────────────────────
        try
        {
            await using var loadDb = await DbFactory.CreateDbContextAsync(_cts.Token);
            var fresh = await loadDb.Store.AsNoTracking()
                .FirstOrDefaultAsync(s => s.Id == src.Id, _cts.Token);

            if (fresh != null)
                src = fresh; // owned tipler (AddressInfo/ContactInformation/WorkingHours) ve tüm sütunlar dolu gelir
        }
        catch (Exception ex) { await LogError("BuildWorkingModel.Fetch", ex); }

        // Owned entity'ler için referans paylaşmamak adına yeni instance'lar oluşturulur.
        _Store = new Store
        {
            Id = src.Id,
            UserId = src.UserId,
            Name = src.Name,
            Description = src.Description,
            IsActiveStateAdmin = src.IsActiveStateAdmin,     // SALT OKUNUR — yalnızca gösterilir
            IsActiveDateAdmin = src.IsActiveDateAdmin,
            IsActiveStateVendor = src.IsActiveStateVendor,
            IsActiveDateVendor = src.IsActiveDateVendor,
            CreatedAt = src.CreatedAt,

            CertificateOfIncorporation = src.CertificateOfIncorporation,
            ActivityCertificate = src.ActivityCertificate,
            TaxRegistration = src.TaxRegistration,
            TradeRegistryGazette = src.TradeRegistryGazette,
            SignatureCircular = src.SignatureCircular,
            AuthorizedPersonId = src.AuthorizedPersonId,
            ProofOfBusinessAddress = src.ProofOfBusinessAddress,
            BankStatement = src.BankStatement,
            BankAccountConfirmation = src.BankAccountConfirmation,
            TrademarkCertificate = src.TrademarkCertificate,
            LetterOfAuthorization = src.LetterOfAuthorization,
            QualityCertificates = src.QualityCertificates,
            CustomsRegistration = src.CustomsRegistration,
            SocialSecurityRegistration = src.SocialSecurityRegistration,
            ProofOfOwnership = src.ProofOfOwnership,

            ContactInformation = CloneContact(src.ContactInformation),
            ProfileCoverGallery = new ProfileCoverGallery
            {
                ProfileImagePath = src.ProfileCoverGallery?.ProfileImagePath,
                CoverImagePath = src.ProfileCoverGallery?.CoverImagePath
            },
            AddressInfo = CloneAddress(src.AddressInfo),
            WorkingHours = CloneWorkingHours(src.WorkingHours),
            Meta = src.Meta,
            Interaction = src.Interaction,
            IsDeleted = src.IsDeleted
        };

        _vendorActive = _Store.IsActiveStateVendor ?? false;
        _adminActive = _Store.IsActiveStateAdmin ?? false;

        // UI yardımcı satırlarını kur
        BuildDocumentRows();
        BuildDayRows();

        // Profil / Kapak görsellerini geri yükle
        _profileMedia = string.IsNullOrWhiteSpace(_Store.ProfileCoverGallery?.ProfileImagePath)
            ? null
            : new data._Galleries.Media { FileUrl = _Store.ProfileCoverGallery!.ProfileImagePath, FileName = "Profil" };

        _coverMedia = string.IsNullOrWhiteSpace(_Store.ProfileCoverGallery?.CoverImagePath)
            ? null
            : new data._Galleries.Media { FileUrl = _Store.ProfileCoverGallery!.CoverImagePath, FileName = "Kapak" };

        // Evrak medyalarını ve galerileri DB'den yükle
        await LoadDocumentMediaAsync();
        _galleryOutSideFiles = await LoadGalleryAsync(_Store.Id, "OutShooting");
        _galleryInSideFiles = await LoadGalleryAsync(_Store.Id, "InShooting");

        // Değerlendirme / eksik bilgi notlarını yükle
        await LoadBlockingInfosAsync();

        // Adres cascade ön-yükleme
        await PreloadCascadeAsync();

        StateHasChanged();
    }

