                                <div class="input-group">
                                    <span class="input-group-text"><input class="form-check-input mt-0" type="checkbox" title="Göster" @bind="_Store.ContactInformation!.IsActiveWeChat"></span>
                                    <input class="form-control" type="text" placeholder="WeChat ID" @bind="_Store.ContactInformation!.WeChat">
