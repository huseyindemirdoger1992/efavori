@using data
@using data.Owned;
@using data._Carts;
@using data._Categories;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;

@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using razor._Shared.tr.Media

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
@inject FileUploadService FileService

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    // NavigationManager.NavigateTo($@"/{use?.Language.ToLower()}/Admin/Store/List/", true); Dil bilgisini global state'den alarak yönlendirme yapar.
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-globe",    "efavori",                "/"),
        ("fa fa-building", "Mağza/İşletme Yönetimi", "javascript:void(0)"),
        ("fa fa-pencil",   "Düzenle",                "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />



@if (SelectedStore is null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="fa fa-exclamation-triangle fa-lg me-2"></i>
        Düzenlenecek bir kayıt seçilmedi.
    </div>
}
else if (_Store is null)
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else
{


    @* Galeri grid render fragment'i — modallardan ÖNCE ve aynı kapsamda tanımlanır *@
    RenderFragment<List<data._Galleries.Media>> RenderGalleryGrid = (selected) => @<text>
        <div class="input-group input-group-sm mb-3">
            <span class="input-group-text bg-dark-transparent border-light-3 text-white-50"><i class="fa fa-search"></i></span>
            <input type="text" class="form-control bg-dark-transparent border-light-3 text-white" placeholder="Ara..."
                   value="@_gallerySearch" @oninput="OnGallerySearchInput" />
            @if (!string.IsNullOrWhiteSpace(_gallerySearch))
            {
                <button class="btn btn-outline-light border-light-3" type="button" @onclick="ClearGallerySearch"><i class="fa fa-times"></i></button>
            }
        </div>

        @if (_galleryLoading)
        {
            <div class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
                <p class="mt-2 text-light small">Yükleniyor...</p>
            </div>
        }
        else if (!_galleryFilteredMedia.Any())
        {
            <div class="text-center py-5 text-white-50">
                <i class="fa fa-folder-open fa-3x mb-3 d-block"></i>
                <p class="mb-0">@(string.IsNullOrWhiteSpace(_gallerySearch) ? "Henüz medya yok" : "Sonuç bulunamadı")</p>
            </div>
        }
        else
        {
            var selectedIdSet = selected.Select(g => g.Id).ToHashSet();
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
                @foreach (var m in _galleryFilteredMedia.Take(_galleryDisplayCount))
                {
                    var isSel = selectedIdSet.Contains(m.Id);
                    <div class="col">
                        <div class="card bg-dark-transparent border-light-3 h-100 overflow-hidden shadow-sm position-relative @(isSel ? "border-primary shadow" : "")"
                             style="cursor:pointer;" @onclick="() => ToggleGalleryItem(m)">
                            @if (isSel)
                            {
                                <div class="position-absolute top-0 end-0 m-2" style="z-index:10;">
                                    <span class="badge bg-primary"><i class="fa fa-check"></i> Seçildi</span>
                                </div>
                            }
                            @{
                                var ext = m.FileExtensionType?.ToLower() ?? "";
                                var isImg = IsGalleryImage(ext);
                                var isVid = IsGalleryVideo(ext);
                            }
                            @if (isImg)
                            {
                                <img src="@m.FileUrl" style="height:150px;object-fit:cover;width:100%;" alt="@m.FileName" loading="lazy" />
                            }
                            else if (isVid)
                            {
                                <div class="position-relative" style="height:150px;background:#000;">
                                    <video class="w-100 h-100" style="object-fit:cover;"><source src="@m.FileUrl" type="@m.ContentType"></video>
                                    <div class="position-absolute top-50 start-50 translate-middle"><i class="fa fa-play-circle fa-3x text-white opacity-75"></i></div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-dark text-white-50" style="height:150px;"><i class="fa fa-file-o fa-4x"></i></div>
                            }
                            <div class="card-body p-2">
                                <div class="text-white small text-truncate fw-bold" title="@m.FileName"><i class="fa fa-file-text-o me-1 text-info"></i>@m.FileName</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (_galleryDisplayCount < _galleryFilteredMedia.Count)
            {
                <div class="text-center mt-3">
                    <button class="btn btn-outline-light btn-sm px-4" @onclick="() => _galleryDisplayCount += 15">
                        <i class="fa fa-arrow-down me-1"></i>Daha Fazla Göster
                    </button>
                </div>
            }
        }
    </text>;

    <div class="container-fluid">

        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-dark-transparent border-light-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 text-light fw-bold">
                    <i class="fa fa-clipboard me-2 text-warning"></i>Mağaza Değerlendirme Notları
                </h6>
                <span class="badge @AdminStatusBadgeClass">
                    <i class="fa fa-circle me-1" style="font-size:0.6rem;"></i>@AdminStatusText
                </span>
            </div>
            <div class="card-body">

                @if (IsSuperAdmin)
                {
                    @* ── SuperAdmin: yeni not ekle ── *@
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-sm btn-primary"
                                @onclick="OpenCreateBlockInfo" disabled="@(_editingBlockInfo != null)">
                            <i class="fa fa-plus me-1"></i>Yeni Not Ekle
                        </button>
                    </div>

                    @* ── SuperAdmin: inline oluştur/düzenle formu ── *@
                    @if (_editingBlockInfo != null)
                    {
                        <div class="border border-light-3 rounded p-3 mb-3 bg-dark-transparent">
                            <h6 class="text-light small fw-bold mb-2">
                                <i class="fa fa-pencil me-1"></i>@(_isEditingExisting ? "Notu Düzenle" : "Yeni Not")
                            </h6>
                            <div class="mb-2">
                                <label class="form-label">Açıklama (Eksik Bilgi / Engelleme Nedeni)</label>
                                <textarea class="form-control" rows="3"
                                          placeholder="Örn: Vergi levhası okunaksız, lütfen yeniden yükleyiniz."
                                          @bind="_editingBlockInfo.BlockInfoDescription"></textarea>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="blkSucces" @bind="_editingBlockInfo.IsSucces">
                                <label class="form-check-label" for="blkSucces">Giderildi / Çözüldü olarak işaretle</label>
                            </div>
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-sm btn-secondary"
                                        @onclick="CancelBlockInfoEdit" disabled="@_isBlockProcessing">
                                    Vazgeç
                                </button>
                                <button type="button" class="btn btn-sm btn-primary"
                                        @onclick="SaveBlockInfo" disabled="@_isBlockProcessing">
                                    @if (_isBlockProcessing)
                                    {
                                        <i class="fa fa-spinner fa-spin me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-save me-1"></i>
                                    }
                                    Kaydet
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-light small mb-3">
                        <i class="fa fa-info-circle me-1 text-info"></i>
                        Yönetici tarafından belirtilen eksikleri giderdikten sonra ilgili maddeyi
                        <span class="fw-semibold">"Giderildi"</span> olarak işaretleyip kaydedin.
                        Mağazanız yeniden değerlendirmeye alınacaktır.
                    </p>
                }

                @if (!_blockingInfos.Any())
                {
                    <div class="text-center py-4 text-white-50">
                        <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"></i>
                        <p class="mb-0">Bekleyen bir değerlendirme notu yok.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Açıklama</th>
                                    <th style="width:160px;">Tarih</th>
                                    <th style="width:140px;" class="text-center">Durum</th>
                                    @if (IsSuperAdmin)
                                    {
                                        <th style="width:110px;" class="text-center">İşlem</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var info in _blockingInfos)
                                {
                                    <tr>
                                        <td>
                                            <div class="bg-light text-light border p-2 rounded"
                                                 style="word-wrap: break-word; overflow-wrap: break-word;">
                                                @info.BlockInfoDescription
                                            </div>
                                        </td>
                                        <td class="small text-white-50">@info.AtDateTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="text-center">
                                            @if (IsSuperAdmin)
                                            {
                                                <span class="badge @(info.IsSucces ? "bg-success" : "bg-warning text-dark")">
                                                    @(info.IsSucces ? "Giderildi" : "Bekliyor")
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="form-check form-switch d-flex justify-content-center mb-0">
                                                    <input class="form-check-input" type="checkbox" role="switch"
                                                           checked="@info.IsSucces"
                                                           @onchange="(e) => OnVendorSuccesChanged(info, (bool)(e.Value ?? false))">
                                                </div>
                                            }
                                        </td>
                                        @if (IsSuperAdmin)
                                        {
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-light me-1"
                                                        title="Düzenle" @onclick="() => OpenEditBlockInfo(info)"
                                                        disabled="@(_editingBlockInfo != null)">
                                                    <i class="fa fa-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        title="Sil" @onclick="() => DeleteBlockInfo(info)"
                                                        disabled="@(_editingBlockInfo != null || _isBlockProcessing)">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!IsSuperAdmin)
                    {
                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" class="btn btn-success btn-sm px-4"
                                    @onclick="SaveVendorBlockResolution"
                                    disabled="@(_isBlockProcessing || !_vendorBlockChanged)">
                                @if (_isBlockProcessing)
                                {
                                    <i class="fa fa-spinner fa-spin me-2"></i>
                                }
                                else
                                {
                                    <i class="fa fa-paper-plane me-2"></i>
                                }
                                Değerlendirmeye Gönder
                            </button>
                        </div>
                    }
                }
            </div>
        </div>






        <div class="row justify-content-center">
            <div class="col-lg-12 col-xl-12">
                <div class="card shadow-sm border-0 overflow-hidden">

                    <!-- Kapak Fotoğrafı -->
                    <div class="position-relative">
                        @if (_coverMedia is not null)
                        {
                            <img src="@_coverMedia.FileUrl"
                                 class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="@_coverMedia.FileName">
                        }
                        else
                        {
                            <img src="https://efavori.com/_files/main/NoImage.png"
                                 class="img-fluid w-100 object-fit-cover" style="height: 350px; min-height: 200px;" alt="Kapak Fotoğrafı">
                        }
                        <div class="position-absolute bottom-0 end-0 m-3">
                            <button type="button" class="btn btn-outline-primary btn-sm fw-bold shadow-sm border-0 text-dark"
                                    @onclick='() => OpenMediaModal("cover")'>
                                <i class="fa fa-camera me-2"></i>Kapak Fotoğrafını Düzenle
                            </button>
                        </div>
                    </div>

                    <!-- Profil Fotoğrafı -->
                    <div class="card-body px-4 pt-0">
                        <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end" style="margin-top: -100px;">
                            <div class="position-relative">
                                @if (_profileMedia is not null)
                                {
                                    <img src="@_profileMedia.FileUrl"
                                         class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                         width="168" height="168" style="object-fit: cover;" alt="@_profileMedia.FileName">
                                }
                                else
                                {
                                    <img src="https://efavori.com/_files/main/NoImage.png"
                                         class="rounded-circle border border-5 border-white bg-light shadow-sm"
                                         width="168" height="168" style="object-fit: cover;" alt="No Image">
                                }
                                <button type="button"
                                        class="btn btn-outline-light border-0 btn-sm rounded-circle position-absolute bottom-0 end-0 mb-2 me-1 shadow d-flex align-items-center justify-content-center"
                                        style="width: 36px; height: 36px;"
                                        @onclick='() => OpenMediaModal("profile")'>
                                    <i class="fa fa-camera text-dark" style="margin-left:5px;"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Onay/Durum Bilgileri -->
                        <div class="row align-items-center mt-2 mb-1">
                            @if (IsSuperAdmin)
                            {
                                <div class="col-md-6">
                                    @* IsActiveStateVendor → Satıcının kendi kontrolü, düzenlenebilir *@
                                    <label class="form-label d-block mb-1 fw-semibold">
                                        <i class="fa fa-store me-1 text-primary"></i>Admin Onay Durumu
                                    </label>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="_adminActive"
                                               @bind="_adminActive">
                                        <label class="form-check-label @(_adminActive ? "text-success" : "text-danger")" for="_adminActive">
                                            @(_adminActive ? "Onaylandı" : "Reddedildi")
                                        </label>
                                    </div>
                                </div>
                            }
                            <div class="col-md-6">
                                @* IsActiveStateVendor → Satıcının kendi kontrolü, düzenlenebilir *@
                                <label class="form-label d-block mb-1 fw-semibold">
                                    <i class="fa fa-store me-1 text-primary"></i>Mağaza Yayın Durumu
                                </label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="vendorActive"
                                           @bind="_vendorActive">
                                    <label class="form-check-label @(_vendorActive ? "text-success" : "text-danger")" for="vendorActive">
                                        @(_vendorActive ? "Yayında (Aktif)" : "Yayında Değil (Pasif)")
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="col-12" style="margin-top:5px;">
                            <label class="form-label">İşletme/Mağza Adını Belirtiniz</label>
                            <input class="form-control mb-3" type="text" @bind="_Store.Name">
                        </div>

                        <div class="col-12">
                            <label class="form-label">İşletme/Mağza Açıklaması</label>
                            <textarea class="form-control" rows="3" @bind="_Store.Description"></textarea>
                        </div>


                        <div class="card bg-light mt-3">
                            <div class="card-body">
                                <ul class="nav nav-tabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link active" data-bs-toggle="tab" href="#editPrimaryHome" role="tab" aria-selected="true">
                                            <div class="d-flex align-items-center">
                                                <div class="tab-icon"><i class="fa fa-camera font-18 me-1"></i></div>
                                                <div class="tab-title">İşletme Dış Çekimleri</div>
                                            </div>
                                        </a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link" data-bs-toggle="tab" href="#editPrimaryProfile" role="tab" aria-selected="false">
                                            <div class="d-flex align-items-center">
                                                <div class="tab-icon"><i class="fa fa-building-o font-18 me-1"></i></div>
                                                <div class="tab-title">İşletme İç Çekimleri</div>
                                            </div>
                                        </a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link" data-bs-toggle="tab" href="#editPrimaryContact" role="tab" aria-selected="false">
                                            <div class="d-flex align-items-center">
                                                <div class="tab-icon"><i class="fa fa-file-pdf-o font-18 me-1"></i></div>
                                                <div class="tab-title">İşletme Resmi Evrakları</div>
                                            </div>
                                        </a>
                                    </li>
                                </ul>

                                <div class="tab-content py-3">
                                    <!-- Dış Çekim -->
                                    <div class="tab-pane fade show active" id="editPrimaryHome" role="tabpanel">
                                        <div class="mb-4">
                                            <label class="form-label text-light fw-semibold">
                                                <i class="fa fa-tree me-1 text-success"></i>İşletme Dış Çekim Görselleri
                                                <span class="badge bg-warning ms-2 fw-normal text-dark" style="font-size:0.7rem;">En Az 3 Görsel</span>
                                            </label>
                                            <div class="row g-2 mb-3">
                                                <div class="col-md-12">
                                                    <button type="button" class="btn btn-outline-light btn-sm w-100"
                                                            @onclick="OpenGalleryOutModal">
                                                        <i class="fa fa-picture-o me-1"></i>Medyadan Seç
                                                        @if (_galleryOutSideFiles.Any())
                                                        {
                                                            <span class="badge bg-primary ms-1">@_galleryOutSideFiles.Count</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                            @if (_galleryOutSideFiles.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var m in _galleryOutSideFiles.ToList())
                                                    {
                                                        <div class="position-relative">
                                                            <img src="@m.FileUrl" class="rounded border border-secondary" style="width:65px;height:65px;object-fit:cover;" alt="@m.FileName" />
                                                            <button type="button"
                                                                    class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center border-0"
                                                                    style="width:20px;height:20px;font-size:0.7rem; margin-top:-5px; margin-right:-5px;"
                                                                    @onclick="() => { _galleryOutSideFiles.Remove(m); }">
                                                                <i class="fa fa-times text-white" style="margin-left:5px"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- İç Çekim -->
                                    <div class="tab-pane fade" id="editPrimaryProfile" role="tabpanel">
                                        <div class="mb-4">
                                            <label class="form-label text-light fw-semibold">
                                                <i class="fa fa-search-plus me-1 text-success"></i>İşletme İç Çekim Görselleri
                                                <span class="badge bg-warning ms-2 fw-normal text-dark" style="font-size:0.7rem;">En Az 3 Görsel</span>
                                            </label>
                                            <div class="row g-2 mb-3">
                                                <div class="col-md-12">
                                                    <button type="button" class="btn btn-outline-light btn-sm w-100"
                                                            @onclick="OpenGalleryInModal">
                                                        <i class="fa fa-image me-1"></i>Medyadan Seç
                                                        @if (_galleryInSideFiles.Any())
                                                        {
                                                            <span class="badge bg-primary ms-1">@_galleryInSideFiles.Count</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                            @if (_galleryInSideFiles.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var m in _galleryInSideFiles.ToList())
                                                    {
                                                        <div class="position-relative">
                                                            <img src="@m.FileUrl" class="rounded border border-secondary" style="width:65px;height:65px;object-fit:cover;" alt="@m.FileName" />
                                                            <button type="button"
                                                                    class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center border-0"
                                                                    style="width:20px;height:20px;font-size:0.7rem; margin-top:-5px; margin-right:-5px;"
                                                                    @onclick="() => { _galleryInSideFiles.Remove(m); }">
                                                                <i class="fa fa-trash-o text-white" style="margin-left:5px;"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Resmi Evraklar -->
                                    <div class="tab-pane fade" id="editPrimaryContact" role="tabpanel">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-hover align-middle mb-0 bg-light">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width:40px;" class="text-center">#</th>
                                                        <th>Belge Adı</th>
                                                        <th>Açıklama</th>
                                                        <th style="width:180px;">Yüklenen Dosya</th>
                                                        <th style="width:110px;" class="text-center">Durum</th>
                                                        <th style="width:90px;" class="text-center">İşlem</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var doc in _documentRows)
                                                    {
                                                        var media = doc.Getter();
                                                        <tr>
                                                            <td class="text-center text-light"><i class="fa @doc.Icon"></i></td>
                                                            <td class="fw-semibold">
                                                                @doc.Title
                                                                @if (doc.Required)
                                                                {
                                                                    <span class="text-danger">*</span>
                                                                }
                                                            </td>
                                                            <td class="text-light small">@doc.Description</td>
                                                            <td class="small">
                                                                @if (media is not null)
                                                                {
                                                                    <span class="text-truncate d-inline-block" style="max-width:140px;" title="@media.FileName">@media.FileName</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-light fst-italic">—</span>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                @if (media is not null)
                                                                {
                                                                    <span class="badge bg-success"><i class="fa fa-check me-1"></i>Yüklendi</span>
                                                                }
                                                                else if (doc.Required)
                                                                {
                                                                    <span class="badge bg-danger text-light">Bekleniyor</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-light">İsteğe Bağlı</span>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                <button type="button" class="btn btn-sm btn-outline-dark"
                                                                        @onclick="() => OpenDocumentModal(doc.Slot)">
                                                                    <i class="fa fa-upload me-1"></i>Yükle
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
