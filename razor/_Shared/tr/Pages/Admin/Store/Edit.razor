                                <label class="form-label">Eyalet/İl</label>
                                <select class="form-select" value="@_stateId" @onchange="OnStateSelected" disabled="@(!_States.Any())">
                                    <option value="0">@(_States.Any() ? "İl Seçiniz" : "---")</option>
                                    @foreach (var state in _States)
                                    {
                                        <option value="@state.id">@state.name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Şehir</label>
                                <select class="form-select" @onchange="OnCitySelected" disabled="@(!_Cities.Any())">
                                    <option value="0">@(_Cities.Any() ? "Şehir Seçiniz" : "---")</option>
                                    @foreach (var city in _Cities)
                                    {
                                        <option value="@city.id" selected="@(string.Equals(city.name, _Store.AddressInfo!.City, StringComparison.OrdinalIgnoreCase))">@city.name</option>
                                    }
                                </select>
