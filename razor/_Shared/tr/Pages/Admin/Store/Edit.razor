                                       @bind="_Store.AddressInfo!.Latitude" placeholder="Bekleniyor...">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Boylam (Longitude)</label>
                                <input id="edit_lng" class="form-control shadow-sm border bg-light" type="number" step="any"
                                       @bind="_Store.AddressInfo!.Longitude" placeholder="Bekleniyor...">
