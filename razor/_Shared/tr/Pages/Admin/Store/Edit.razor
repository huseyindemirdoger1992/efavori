                                           @bind="_Store.ContactInformation!.Email">
                                    <div class="input-group-text">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" id="isActiveEmail"
                                                   @bind="_Store.ContactInformation!.IsActiveEmail">
                                            <label class="form-check-label small" for="isActiveEmail">Göster</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Telefon Numarası</label>
                                <div class="input-group">
                                    <select class="form-select" style="max-width: 160px;"
                                            @bind="_Store.ContactInformation!.CountryPhoneCode">
                                        <option value="">Kod</option>
                                        @foreach (Country item in _Countries)
                                        {
                                            <option value="@item.phonecode">@item.phonecode @item.name</option>
                                        }
                                    </select>
                                    <input class="form-control" type="tel" placeholder="5XX XXX XX XX"
                                           @bind="_Store.ContactInformation!.PhoneNumber">
