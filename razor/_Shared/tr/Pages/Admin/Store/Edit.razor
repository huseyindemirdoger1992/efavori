    private async Task LoadCountriesAsync()
    {
        try
        {
            _Countries = await StateHub.GetOrLoadAsync("Countries_All", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadCountries", ex); }
    }

    private async Task PreloadCascadeAsync()
    {
        if (_Store?.AddressInfo == null) return;

        if (!string.IsNullOrWhiteSpace(_Store.AddressInfo.Country))
        {
            var country = _Countries.FirstOrDefault(c =>
                string.Equals(c.name, _Store.AddressInfo.Country, StringComparison.OrdinalIgnoreCase));

            if (country != null)
            {
                _countryId = country.id;
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                    _States = await db.States.AsNoTracking()
                        .Where(s => s.country_id == _countryId)
                        .OrderBy(s => s.name).ToListAsync(_cts.Token);

                    if (!string.IsNullOrWhiteSpace(_Store.AddressInfo.State))
                    {
                        var state = _States.FirstOrDefault(s =>
                            string.Equals(s.name, _Store.AddressInfo.State, StringComparison.OrdinalIgnoreCase));

                        if (state != null)
                        {
                            _stateId = state.id;
                            _Cities = await db.Cities.AsNoTracking()
                                .Where(c => c.state_id == _stateId)
                                .OrderBy(c => c.name).ToListAsync(_cts.Token);
                        }
                    }
                }
                catch (Exception ex) { await LogError("PreloadCascade", ex); }
            }
        }
    }

    private async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out _countryId);
        _stateId = 0;
        _States.Clear();
        _Cities.Clear();

        var name = _Countries.FirstOrDefault(c => c.id == _countryId)?.name;
        _Store!.AddressInfo!.Country = name;
        _Store.AddressInfo.State = null;
        _Store.AddressInfo.City = null;

        if (_countryId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                _States = await db.States.AsNoTracking()
                    .Where(s => s.country_id == _countryId)
                    .OrderBy(s => s.name).ToListAsync(_cts.Token);
            }
            catch (Exception ex) { await LogError("OnCountrySelected", ex); }
        }
        StateHasChanged();
    }

    private async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out _stateId);
        _Cities.Clear();

        var name = _States.FirstOrDefault(s => s.id == _stateId)?.name;
        _Store!.AddressInfo!.State = name;
        _Store.AddressInfo.City = null;

        if (_stateId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                _Cities = await db.Cities.AsNoTracking()
                    .Where(c => c.state_id == _stateId)
                    .OrderBy(c => c.name).ToListAsync(_cts.Token);
            }
            catch (Exception ex) { await LogError("OnStateSelected", ex); }
        }
        StateHasChanged();
    }

    private void OnCitySelected(ChangeEventArgs e)
    {
        _Store!.AddressInfo!.City = _Cities
            .FirstOrDefault(c => c.id.ToString() == e.Value?.ToString())?.name;
    }

