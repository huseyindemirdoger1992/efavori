    private async Task LoadGalleryAllMediaAsync()
    {
        if (use == null) return;
        _galleryLoading = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _galleryAllMedia = await db.Media.AsNoTracking()
                .Where(m => m.IsDeleted!.IsDeletedStatu != true && m.UserId == use.Id)
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync(_cts.Token);
            ApplyGalleryFilter();
        }
        catch (Exception ex) { await LogError("LoadGalleryAllMedia", ex); }
        finally
        {
            _galleryLoading = false;
            StateHasChanged();
        }
    }

    private void OnGallerySearchInput(ChangeEventArgs e)
    {
        _gallerySearch = e.Value?.ToString() ?? string.Empty;
        _galleryDisplayCount = 15;
        ApplyGalleryFilter();
    }

    private void ClearGallerySearch()
    {
        _gallerySearch = string.Empty;
        _galleryDisplayCount = 15;
        ApplyGalleryFilter();
    }

    private void ApplyGalleryFilter()
    {
        if (string.IsNullOrWhiteSpace(_gallerySearch))
        {
            _galleryFilteredMedia = _galleryAllMedia.ToList();
        }
        else
        {
            var s = _gallerySearch.Trim();
            _galleryFilteredMedia = _galleryAllMedia
                .Where(m => m.FileName != null && m.FileName.Contains(s, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void ToggleGalleryItem(data._Galleries.Media m)
    {
        var target = _activeMediaSlot == "galleryInSide" ? _galleryInSideFiles : _galleryOutSideFiles;
        var existing = target.FirstOrDefault(x => x.Id == m.Id);
        if (existing != null) target.Remove(existing);
        else target.Add(m);
    }

    private static readonly string[] _galleryImageExt =
        { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tiff", ".tif", ".heic", ".heif", ".svg", ".ico", ".avif" };
    private static readonly string[] _galleryVideoExt =
        { ".mp4", ".mov", ".avi", ".mkv", ".wmv", ".flv", ".webm", ".mpeg", ".mpg" };

    private static bool IsGalleryImage(string ext) => _galleryImageExt.Contains(ext);
    private static bool IsGalleryVideo(string ext) => _galleryVideoExt.Contains(ext);

    // ══════════════════════════════════════════════════════════════
    // CRUD — GÜNCELLE
    // ══════════════════════════════════════════════════════════════

    private async Task UpdateStore()
    {
        if (_isProcessing || _Store == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            // ── 1. VALIDATION (zorunlu alanlar) ──
            var errors = new List<string>();

            if (string.IsNullOrWhiteSpace(_Store.Name))
                errors.Add("İşletme/Mağaza adı boş bırakılamaz.");
            if (string.IsNullOrWhiteSpace(_Store.Description))
                errors.Add("İşletme/Mağaza açıklaması boş bırakılamaz.");

            if (_Store.ContactInformation == null)
            {
                errors.Add("İletişim bilgileri boş bırakılamaz.");
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_Store.ContactInformation.Email))
                    errors.Add("E-posta adresi boş bırakılamaz.");
                if (string.IsNullOrWhiteSpace(_Store.ContactInformation.CountryPhoneCode))
                    errors.Add("Ülke telefon kodu seçilmedi.");
                if (string.IsNullOrWhiteSpace(_Store.ContactInformation.PhoneNumber))
                    errors.Add("Telefon numarası boş bırakılamaz.");
            }

            if (_profileMedia == null) errors.Add("Profil görseli yüklenmedi.");
            if (_coverMedia == null) errors.Add("Kapak görseli yüklenmedi.");

            if (_galleryOutSideFiles.Count < 3)
                errors.Add($"Dış çekim görseli en az 3 adet olmalıdır. (Şu an: {_galleryOutSideFiles.Count})");
            if (_galleryInSideFiles.Count < 3)
                errors.Add($"İç çekim görseli en az 3 adet olmalıdır. (Şu an: {_galleryInSideFiles.Count})");

            // Zorunlu belgeler
            foreach (var doc in _documentRows.Where(d => d.Required))
                if (doc.Getter() == null)
                    errors.Add($"{doc.Title} yüklenmedi.");

            if (errors.Any())
            {
                var errorMessage = string.Join("<br/>• ", errors.Prepend("Lütfen aşağıdaki alanları doldurun:"));
                await Notify("danger", "Eksik Bilgiler", $"• {errorMessage}");
                return;
            }

            // ── 2. MEVCUT KAYDI YÜKLE (blanket Update YOK; alan bazlı yazılır) ──
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.Store.FindAsync(new object[] { _Store.Id }, _cts.Token);

            if (existing == null)
            {
                await Notify("warning", "Uyarı", "Kayıt artık mevcut değil.");
                return;
            }

            // ── 3. DÜZENLENEBİLİR ALANLARI YAZ ──
            existing.Name = _Store.Name;
            existing.Description = _Store.Description;

            // KISIT: IsActiveStateAdmin / IsActiveDateAdmin alanlarına DOKUNULMAZ.
            //        (Kullanıcı müdahale edemez; mevcut DB değerleri korunur.)

            // Satıcının kendi yayın kontrolü
            existing.IsActiveStateAdmin = _adminActive;
            existing.IsActiveDateAdmin = DateTime.UtcNow;
            existing.IsActiveStateVendor = _vendorActive;
            existing.IsActiveDateVendor = DateTime.UtcNow;

            // Telefon birleştir
            if (_Store.ContactInformation != null &&
                !string.IsNullOrWhiteSpace(_Store.ContactInformation.CountryPhoneCode) &&
                !string.IsNullOrWhiteSpace(_Store.ContactInformation.PhoneNumber))
            {
                var tf = new TextualFunctions();
                _Store.ContactInformation.FullPhoneNumber =
                    _Store.ContactInformation.CountryPhoneCode.Trim() +
                    tf.NormalizePhoneNumberEditor(_Store.ContactInformation.PhoneNumber.Trim());
            }

            // Owned entity'leri yeniden ata (EF Core sütunları günceller)
            existing.ContactInformation = CloneContact(_Store.ContactInformation);
            existing.AddressInfo = CloneAddress(_Store.AddressInfo);
            existing.WorkingHours = CloneWorkingHours(_Store.WorkingHours);
            existing.ProfileCoverGallery = new ProfileCoverGallery
            {
                ProfileImagePath = _profileMedia?.FileUrl,
                CoverImagePath = _coverMedia?.FileUrl
            };

            // Belge GUID atamaları (değiştirilmeyenler aynı Id ile korunur)
            existing.CertificateOfIncorporation = _certificateOfIncorporation?.Id;
            existing.ActivityCertificate = _activityCertificate?.Id;
            existing.TaxRegistration = _taxRegistration?.Id;
            existing.TradeRegistryGazette = _tradeRegistryGazette?.Id;
            existing.SignatureCircular = _signatureCircular?.Id;
            existing.AuthorizedPersonId = _authorizedPersonId?.Id;
            existing.ProofOfBusinessAddress = _proofOfBusinessAddress?.Id;
            existing.BankStatement = _bankStatement?.Id;
            existing.BankAccountConfirmation = _bankAccountConfirmation?.Id;
            existing.TrademarkCertificate = _trademarkCertificate?.Id;
            existing.LetterOfAuthorization = _letterOfAuthorization?.Id;
            existing.QualityCertificates = _qualityCertificates?.Id;
            existing.CustomsRegistration = _customsRegistration?.Id;
            existing.SocialSecurityRegistration = _socialSecurityRegistration?.Id;
            existing.ProofOfOwnership = _proofOfOwnership?.Id;

            // ── 4. GALERİ SOFT-DELETE MERGE ──
            await SyncGalleryAsync(db, existing.Id, _galleryOutSideFiles, "OutShooting");
            await SyncGalleryAsync(db, existing.Id, _galleryInSideFiles, "InShooting");
            if (!IsSuperAdmin)
            {
                existing.IsActiveStateAdmin = null; // satıcı değişikliği → mağaza yeniden değerlendirmeye alınır
            }
            await db.SaveChangesAsync(_cts.Token);

            // ── 5. SON ──
            StateHub.ClearCache("DataManager_Main");
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE, "UpdateStore");
            await Notify("success", "Başarılı", "İşletme/Mağaza başarıyla güncellendi.");
        }
        catch (Exception ex)
        {
            await LogError("UpdateStore", ex);
            await Notify("danger", "Hata", "İşletme/Mağaza güncellenirken bir sorun oluştu.");
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
        NavigationManager.NavigateTo($@"/{use?.Language.ToLower()}/Admin/Store/List/", true);
    }

    // Galeri merge: artık seçili olmayanlar soft-delete, tekrar seçilenler reaktive,
    // hiç kaydı olmayan yeniler eklenir. (audit izi korunur, tablo şişmez)
    private async Task SyncGalleryAsync(_ApplicationConnectionDb db, Guid storeId, List<data._Galleries.Media> selectedFiles, string itemType)
    {
        var oldGallery = await db.MediaItems
                    .Where(g => g.ItemId == storeId && g.ItemType == itemType)
                    .ToListAsync(_cts.Token);

        var selectedMediaIds = selectedFiles.Select(m => m.Id).ToHashSet();

        foreach (var g in oldGallery)
        {
            var stillSelected = g.MediaId.HasValue && selectedMediaIds.Contains(g.MediaId.Value);

            // IsDeleted nesnesini güvenli şekilde başlat[cite: 4, 11]
            g.IsDeleted ??= new data.Owned.IsDeleted();

            if (!stillSelected && g.IsDeleted.IsDeletedStatu != true)
            {
                g.IsDeleted.IsDeletedStatu = true;
                g.IsDeleted.DeletedAtDate = DateTime.UtcNow;
            }
            else if (stillSelected && g.IsDeleted.IsDeletedStatu == true)
            {
                g.IsDeleted.IsDeletedStatu = false;
                g.IsDeleted.DeletedAtDate = null; // Silinme tarihini temizle
                g.ItemAddDate = DateTime.UtcNow;
            }
        }

        var existingMediaIds = oldGallery
            .Where(g => g.MediaId.HasValue)
            .Select(g => g.MediaId!.Value)
            .ToHashSet();

        var trulyNew = selectedFiles.Where(m => !existingMediaIds.Contains(m.Id)).ToList();

        if (trulyNew.Any())
        {
            var newGallery = trulyNew.Select(m => new data._Galleries.MediaItems
            {
                UserId = use!.Id,
                ItemId = storeId,
                ItemType = itemType,
                MediaId = m.Id,
                ItemAddDate = DateTime.UtcNow,
                // IsDeleted sahipli nesnesini başlat ve durumunu false (silinmemiş) olarak ayarla
                IsDeleted = new data.Owned.IsDeleted { IsDeletedStatu = false }
            }).ToList();

            await db.MediaItems.AddRangeAsync(newGallery, _cts.Token);
        }
    }

