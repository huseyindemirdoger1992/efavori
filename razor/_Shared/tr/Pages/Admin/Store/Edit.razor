    private void BuildDocumentRows()
    {
        // Add.razor "İşletme Resmi Evrakları" ile birebir aynı sıra, başlık, açıklama, ikon ve zorunluluk yapısı.
        // Zorunlu (Required=true) yalnızca: Vergi Levhası, Faaliyet Belgesi, İmza Sirküleri, Sicil Gazetesi.
