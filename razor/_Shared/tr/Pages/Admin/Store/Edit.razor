                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fa fa-stop"></i></span>
                                                <input type="time" class="form-control"
                                                       value="@day.GetFinish()?.ToString("HH:mm")"
                                                       @onchange="(e) => day.SetFinish(ParseTime(e.Value?.ToString()))">
                                            </div>
                                        </div>
                                    </div>
                                </div>
