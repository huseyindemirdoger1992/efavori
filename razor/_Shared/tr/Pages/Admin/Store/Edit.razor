                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" id="isActivePhone"
                                                   @bind="_Store.ContactInformation!.IsActivePhoneNumber">
                                            <label class="form-check-label small" for="isActivePhone">Göster</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3 opacity-10">

                        <!-- Adres Bilgileri -->
