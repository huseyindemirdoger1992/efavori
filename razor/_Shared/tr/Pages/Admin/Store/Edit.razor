                                <label class="form-label">Soyadınız</label>
                                <input class="form-control" type="text" value="@use?.LastName" readonly>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kayıt Tarihi</label>
                                <input class="form-control" type="text" value="@_Store.CreatedAt?.ToLocalTime()" readonly>
                            </div>
                        </div>

                        <hr class="my-3 opacity-10">

                        <!-- İletişim Bilgileri -->
