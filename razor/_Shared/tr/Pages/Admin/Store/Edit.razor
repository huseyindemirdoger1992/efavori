    // ── Evrak GUID'lerini Media kayıtlarına çöz ──
    // Önce Store üzerindeki skaler GUID sütunlarından (Add.razor bu şekilde kaydeder),
    // ardından eksik kalan slotlar için ItemGallery (ItemType = slot adı) üzerinden çözülür.
    private async Task LoadDocumentMediaAsync()
    {
        if (_Store == null) return;

        // slot → (getter, setter) eşlemesi
        var slotGet = new Dictionary<string, Func<data._Galleries.Media?>>(StringComparer.OrdinalIgnoreCase);
        var slotSet = new Dictionary<string, Action<data._Galleries.Media>>(StringComparer.OrdinalIgnoreCase);
        var slotGuid = new Dictionary<string, Guid?>(StringComparer.OrdinalIgnoreCase);

        void Map(string slot, Guid? id, Func<data._Galleries.Media?> get, Action<data._Galleries.Media> set)
        {
            slotGet[slot] = get; slotSet[slot] = set; slotGuid[slot] = id;
        }

        Map("certificateOfIncorporation", _Store.CertificateOfIncorporation, () => _certificateOfIncorporation, m => _certificateOfIncorporation = m);
        Map("activityCertificate", _Store.ActivityCertificate, () => _activityCertificate, m => _activityCertificate = m);
        Map("taxRegistration", _Store.TaxRegistration, () => _taxRegistration, m => _taxRegistration = m);
        Map("tradeRegistryGazette", _Store.TradeRegistryGazette, () => _tradeRegistryGazette, m => _tradeRegistryGazette = m);
        Map("signatureCircular", _Store.SignatureCircular, () => _signatureCircular, m => _signatureCircular = m);
        Map("authorizedPersonId", _Store.AuthorizedPersonId, () => _authorizedPersonId, m => _authorizedPersonId = m);
        Map("proofOfBusinessAddress", _Store.ProofOfBusinessAddress, () => _proofOfBusinessAddress, m => _proofOfBusinessAddress = m);
        Map("bankStatement", _Store.BankStatement, () => _bankStatement, m => _bankStatement = m);
        Map("bankAccountConfirmation", _Store.BankAccountConfirmation, () => _bankAccountConfirmation, m => _bankAccountConfirmation = m);
        Map("trademarkCertificate", _Store.TrademarkCertificate, () => _trademarkCertificate, m => _trademarkCertificate = m);
        Map("letterOfAuthorization", _Store.LetterOfAuthorization, () => _letterOfAuthorization, m => _letterOfAuthorization = m);
        Map("qualityCertificates", _Store.QualityCertificates, () => _qualityCertificates, m => _qualityCertificates = m);
        Map("customsRegistration", _Store.CustomsRegistration, () => _customsRegistration, m => _customsRegistration = m);
        Map("socialSecurityRegistration", _Store.SocialSecurityRegistration, () => _socialSecurityRegistration, m => _socialSecurityRegistration = m);
        Map("proofOfOwnership", _Store.ProofOfOwnership, () => _proofOfOwnership, m => _proofOfOwnership = m);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // ── 1) Skaler GUID sütunlarından çöz ──
            // ÖNEMLİ: Aynı medya birden çok slota atanmış olabilir. Bu yüzden
            // medya->slot (tekil) eşleme YAPILMAZ; tüm medyalar tek seferde çekilip
            // HER slot kendi GUID'iyle ayrı ayrı doldurulur. (Önceki sürümde
            // Dictionary<Guid,string> aynı dosyayı tek slota indiriyor, diğer
            // slotlar boş kalıyordu → "aynı dosya seçilince göstermiyor" hatası.)
            var scalarIds = slotGuid.Values
                .Where(v => v.HasValue && v.Value != Guid.Empty)
                .Select(v => v!.Value)
                .Distinct()
                .ToList();

            if (scalarIds.Any())
            {
                var medias = await db.Media.AsNoTracking()
                    .Where(m => scalarIds.Contains(m.Id))
                    .ToListAsync(_cts.Token);

                var mediaById = medias.ToDictionary(m => m.Id);

                foreach (var kv in slotGuid)
                {
                    if (kv.Value.HasValue && kv.Value.Value != Guid.Empty
                        && mediaById.TryGetValue(kv.Value.Value, out var media)
                        && slotSet.TryGetValue(kv.Key, out var set))
                    {
                        set(media); // aynı medya birden çok slota atanabilir
                    }
                }
            }

            // ── 2) Hâlâ boş kalan slotları ItemGallery üzerinden çöz ──
            //     (Bazı kayıtlar evrakı ItemGallery'ye ItemType = slot adı ile yazmış olabilir.)
            var emptySlots = slotGet.Where(kv => kv.Value() == null).Select(kv => kv.Key).ToList();
            if (emptySlots.Any())
            {
                var rows = await db.MediaItems.AsNoTracking()
                    .Where(g => g.ItemId == _Store.Id
                                && g.IsDeleted!.IsDeletedStatu != true
                                && g.MediaId != null
                                && g.ItemType != null
                                && emptySlots.Contains(g.ItemType))
                    .OrderByDescending(g => g.ItemAddDate)
                    .ToListAsync(_cts.Token);

                if (rows.Any())
                {
                    var galleryMediaIds = rows.Select(r => r.MediaId!.Value).Distinct().ToList();
                    var galleryMedias = await db.Media.AsNoTracking()
                        .Where(m => galleryMediaIds.Contains(m.Id) && m.IsDeleted!.IsDeletedStatu != true)
                        .ToListAsync(_cts.Token);

                    var byId = galleryMedias.ToDictionary(m => m.Id);

                    // Her slot için en güncel (ilk) eşleşen satırı kullan
                    foreach (var slot in emptySlots)
                    {
                        var row = rows.FirstOrDefault(r => string.Equals(r.ItemType, slot, StringComparison.OrdinalIgnoreCase));
                        if (row?.MediaId != null && byId.TryGetValue(row.MediaId.Value, out var media) && slotSet.TryGetValue(slot, out var set))
                            set(media);
                    }
                }
            }

            // ── 3) Hiçbir slota bağlanamayan, "Document" gibi genel tipli evrak
            //       satırları varsa bunları da topla (depolama şemasından bağımsız
            //       olarak yüklü dosyaların görünmesini garanti eder). ──
            var slotMediaIds = slotGet.Values
                .Select(g => g())
                .Where(m => m != null)
                .Select(m => m!.Id)
                .ToHashSet();

            var otherRows = await db.MediaItems.AsNoTracking()
                .Where(g => g.ItemId == _Store.Id
                            && g.IsDeleted!.IsDeletedStatu != true
                            && g.MediaId != null
                            && g.ItemType != "InShooting"
                            && g.ItemType != "OutShooting")
                .OrderByDescending(g => g.ItemAddDate)
                .ToListAsync(_cts.Token);

            var otherMediaIds = otherRows
                .Select(r => r.MediaId!.Value)
                .Where(id => !slotMediaIds.Contains(id))
                .Distinct()
                .ToList();

            if (otherMediaIds.Any())
            {
                _otherDocumentFiles = await db.Media.AsNoTracking()
                    .Where(m => otherMediaIds.Contains(m.Id) && m.IsDeleted!.IsDeletedStatu != true)
                    .ToListAsync(_cts.Token);
            }
        }
        catch (Exception ex) { await LogError("LoadDocumentMedia", ex); }
    }

    // ── Mevcut galeri kayıtlarını DB'den yükle (ItemGallery → Media) ──
    private async Task<List<data._Galleries.Media>> LoadGalleryAsync(Guid itemId, string itemType)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var mediaIds = await db.MediaItems
                .Where(g => g.ItemId == itemId && g.ItemType == itemType && g.IsDeleted!.IsDeletedStatu != true)
                .Select(g => g.MediaId)
                .ToListAsync(_cts.Token);

            if (!mediaIds.Any()) return new();

            return await db.Media.AsNoTracking()
                .Where(m => mediaIds.Contains(m.Id) && m.IsDeleted!.IsDeletedStatu != true)
                .ToListAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            await LogError("LoadGallery", ex);
            return new();
        }
    }

