    // ── SuperAdmin: not oluştur veya güncelle ──
    private async Task SaveBlockInfo()
    {
        if (_editingBlockInfo == null || _Store == null) return;
        if (!IsSuperAdmin) { await Notify("warning", "Yetki", "Bu işlem için yetkiniz yok."); return; }
        if (string.IsNullOrWhiteSpace(_editingBlockInfo.BlockInfoDescription))
        { await Notify("danger", "Eksik Bilgi", "Açıklama boş bırakılamaz."); return; }

        _isBlockProcessing = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.StoreBlockingInfos
                .FirstOrDefaultAsync(b => b.Id == _editingBlockInfo.Id, _cts.Token);

            string action;
            if (existing == null)
            {
                // YENİ kayıt
                _editingBlockInfo.AdminId = use?.Id;
                _editingBlockInfo.AtDateTime = DateTime.UtcNow;
                await db.StoreBlockingInfos.AddAsync(_editingBlockInfo, _cts.Token);
                action = "CreateBlockInfo";
            }
            else
            {
                // GÜNCELLE (alan bazlı; soft-delete alanına dokunulmaz)
                existing.BlockInfoDescription = _editingBlockInfo.BlockInfoDescription;
                existing.IsSucces = _editingBlockInfo.IsSucces;
                existing.AdminId = use?.Id;
                existing.AtDateTime = DateTime.UtcNow;
                action = "UpdateBlockInfo";
            }

            await db.SaveChangesAsync(_cts.Token);
            await Logger.TakeIt(use?.Id, PAGE, action);

            _editingBlockInfo = null;
            _isEditingExisting = false;
            await LoadBlockingInfosAsync();
            await Notify("success", "Başarılı", "Değerlendirme notu kaydedildi.");
        }
        catch (Exception ex)
        {
            await LogError("SaveBlockInfo", ex);
            await Notify("danger", "Hata", "Not kaydedilirken bir sorun oluştu.");
        }
        finally
        {
            _isBlockProcessing = false;
            StateHasChanged();
        }
    }

    // ── SuperAdmin: notu SİL (soft delete — audit izi korunur) ──
    private async Task DeleteBlockInfo(StoreBlockingInfos info)
    {
        if (!IsSuperAdmin) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bu değerlendirme notunu silmek istediğinize emin misiniz?");
        if (!confirmed) return;

        _isBlockProcessing = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.StoreBlockingInfos
                .FirstOrDefaultAsync(b => b.Id == info.Id, _cts.Token);

            if (existing != null)
            {
                existing.IsDeleted ??= new IsDeleted();
                existing.IsDeleted.IsDeletedStatu = true;
                existing.IsDeleted.DeletedAtDate = DateTime.UtcNow;

                await db.SaveChangesAsync(_cts.Token);
                await Logger.TakeIt(use?.Id, PAGE, "DeleteBlockInfo");
            }

            await LoadBlockingInfosAsync();
            await Notify("success", "Silindi", "Değerlendirme notu silindi.");
        }
        catch (Exception ex)
        {
            await LogError("DeleteBlockInfo", ex);
            await Notify("danger", "Hata", "Not silinirken bir sorun oluştu.");
        }
        finally
        {
            _isBlockProcessing = false;
            StateHasChanged();
        }
    }

    // ── Satıcı (SuperAdmin olmayan): IsSucces değerini bellek üzerinde değiştir ──
    private void OnVendorSuccesChanged(StoreBlockingInfos info, bool value)
    {
        if (IsSuperAdmin) return; // güvenlik: yalnızca satıcı bu yolu kullanır
        info.IsSucces = value;
        _vendorBlockChanged = true;
    }

    // ── Satıcı (SuperAdmin olmayan): yalnızca IsSucces değişikliklerini kaydet ──
    //    KURAL: En az bir madde "Giderildi" (true) olarak işaretlenip kaydedilirse
    //           Store.IsActiveStateAdmin = NULL yapılır → mağaza yeniden
    //           değerlendirmeye alınır.
    private async Task SaveVendorBlockResolution()
    {
        if (IsSuperAdmin || _Store == null) return;
        if (!_vendorBlockChanged) return;

        _isBlockProcessing = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var ids = _blockingInfos.Select(b => b.Id).ToList();
            var dbRows = await db.StoreBlockingInfos
                .Where(b => ids.Contains(b.Id))
                .ToListAsync(_cts.Token);

            var successMap = _blockingInfos.ToDictionary(b => b.Id, b => b.IsSucces);
            bool anyMarkedSucces = false;

            foreach (var row in dbRows)
            {
                if (successMap.TryGetValue(row.Id, out var newVal) && row.IsSucces != newVal)
                {
                    // Satıcı YALNIZCA IsSucces alanını değiştirebilir; başka alana dokunulmaz.
                    row.IsSucces = newVal;
                    if (newVal) anyMarkedSucces = true; // "onaylanıp" → giderildi işareti
                }
            }

            // Eksik(ler) giderildi olarak onaylandıysa mağaza yeniden değerlendirmeye alınır.
            if (anyMarkedSucces)
            {
                var store = await db.Store.FirstOrDefaultAsync(s => s.Id == _Store.Id, _cts.Token);
                if (store != null)
                {
                    store.IsActiveStateAdmin = null;   // → "Yeniden Değerlendiriliyor"
                    store.IsActiveDateAdmin = null;     // önceki onay tarihi temizlenir

                    // Çalışma modelini de senkron tut (UI rozeti güncellensin)
                    _Store.IsActiveStateAdmin = null;
                    _Store.IsActiveDateAdmin = null;
                }
            }

            await db.SaveChangesAsync(_cts.Token);
            await Logger.TakeIt(use?.Id, PAGE, "VendorBlockResolution");

            _vendorBlockChanged = false;
            await LoadBlockingInfosAsync();

            await Notify("success", "Gönderildi", anyMarkedSucces
                ? "Eksikler giderildi olarak işaretlendi. Mağazanız yeniden değerlendirmeye alındı."
                : "Değişiklikler kaydedildi.");
        }
        catch (Exception ex)
        {
            await LogError("VendorBlockResolution", ex);
            await Notify("danger", "Hata", "İşlem kaydedilirken bir sorun oluştu.");
        }
        finally
        {
            _isBlockProcessing = false;
            StateHasChanged();
        }
    }

