@* ============================================================
   Store/List.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub — anlık broadcast, debounce, RAM cache
   ✅ GlobalSecurityProvider — Country/State/Cities şifreli
   ✅ TakeLogs — tüm CRUD aksiyonları loglanır
   ✅ Düzenle → modal yok, sayfa yönlendirmesi
   ✅ Ayrı Tekli Sil / Toplu Sil modalleri
   ✅ İşlemler sütunu: AdminPermissionPending=true VE IsActiveStateAdmin=true ise görünür
   ✅ 5'li sayfalama
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using Microsoft.AspNetCore.Components
@using System.Globalization
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
@inject NavigationManager NavManager

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa",  "/"),
        ("fa fa-table",    "Kayıtlar",   "javascript:void(0)"),
        ("fa fa-list-alt", PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light text-dark">@_selectedIds.Count seçili</span>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Seçimi Temizle
        </button>

        <div class="vr mx-1"></div>

        @* ── Role bazlı toplu işlemler ── *@
        @if (IsSuperAdmin)
        {
            @* SuperAdmin: Admin onay/blok (IsActiveStateAdmin) *@
            <button class="btn btn-outline-primary btn-sm border-0"
                    @onclick="BulkApproveAdminAsync"
                    disabled="@_isProcessing"
                    title="Seçilenleri Onayla">
                <i class="fa fa-check-circle"></i> Toplu Onayla
            </button>

            <button class="btn btn-outline-warning btn-sm border-0"
                    @onclick="BulkBlockAdminAsync"
                    disabled="@_isProcessing"
                    title="Seçilenleri Blokla">
                <i class="fa fa-ban"></i> Toplu Blokla
            </button>
        }
        else
        {
            @* Satıcı: Yayın durumu (IsActiveStateVendor) *@
            <button class="btn btn-outline-info btn-sm border-0"
                    @onclick="BulkPublishVendorAsync"
                    disabled="@_isProcessing"
                    title="Seçilenleri Yayına Al">
                <i class="fa fa-eye"></i> Yayına Al
            </button>

            <button class="btn btn-outline-warning btn-sm border-0"
                    @onclick="BulkUnpublishVendorAsync"
                    disabled="@_isProcessing"
                    title="Seçilenleri Yayından Kaldır">
                <i class="fa fa-eye-slash"></i> Yayından Kaldır
            </button>
        }

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-danger btn-sm border-0"
                @onclick="OpenBulkDeleteModal"
                disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Mağaza adı, konum, sahip veya sponsor ara..."
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_allItems.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Kayıt bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden" style="border:1px solid rgba(255,255,255,0.1);">
        <table class="table table-hover align-middle mb-0" style="border-collapse:separate;border-spacing:0;">
            <thead>
                <tr style="background:rgba(255,255,255,0.06);">
                    <th class="border-0 py-2 ps-3" style="width:2rem;">
                        <input type="checkbox" class="form-check-input"
                               checked="@_allSelected"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th class="border-0 py-2 d-none d-md-table-cell small text-uppercase" style="width:2.5rem;letter-spacing:.04em;font-weight:600;">#</th>
                    <th class="border-0 py-2 small text-uppercase" style="letter-spacing:.04em;font-weight:600;">Sponsor</th>
                    <th class="border-0 py-2 small text-uppercase" style="width:3rem;letter-spacing:.04em;font-weight:600;">Profil</th>
                    <th class="border-0 py-2 small text-uppercase" style="letter-spacing:.04em;font-weight:600;">Sahibi</th>
                    <th class="border-0 py-2 small text-uppercase" style="letter-spacing:.04em;font-weight:600;">Mağaza Adı</th>
                    <th class="border-0 py-2 small text-uppercase d-none d-lg-table-cell" style="letter-spacing:.04em;font-weight:600;">Ülke</th>
                    <th class="border-0 py-2 small text-uppercase d-none d-lg-table-cell" style="letter-spacing:.04em;font-weight:600;">İl</th>
                    <th class="border-0 py-2 small text-uppercase d-none d-xl-table-cell" style="letter-spacing:.04em;font-weight:600;">İlçe</th>
                    <th class="border-0 py-2 small text-uppercase" style="letter-spacing:.04em;font-weight:600;">Onay</th>
                    <th class="border-0 py-2 small text-uppercase" style="letter-spacing:.04em;font-weight:600;">Yayın</th>
                    <th class="border-0 py-2 small text-uppercase d-none d-lg-table-cell text-center cell-total" style="letter-spacing:.04em;font-weight:600;">Toplam Revizyon</th>
                    <th class="border-0 py-2 small text-uppercase d-none d-lg-table-cell text-center cell-pending" style="letter-spacing:.04em;font-weight:600;">Bekleyen</th>
                    <th class="border-0 py-2 small text-uppercase d-none d-lg-table-cell text-center cell-completed" style="letter-spacing:.04em;font-weight:600;">Tamamlanan</th>
                    <th class="border-0 py-2 small text-uppercase text-end pe-3" style="letter-spacing:.04em;font-weight:600;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {

                    var isSelected = _selectedIds.Contains(item.Id);

                    <tr class="@(isSelected ? "table-active" : "")" style="border-bottom:1px solid rgba(255,255,255,0.07);transition:background .15s ease;">
                        @{
                            // Kullanıcı kontrolü ve atama
                            var ownerInfo = (item.UserId.HasValue && _userLookup.ContainsKey(item.UserId.Value))
                                ? _userLookup[item.UserId.Value]
                                : (OwnerName: "—", SponsorName: (string?)null);

                            // Sponsor var mı kontrolü — em-dash (—) ve hyphen (-) her ikisini de kontrol et
                            bool hasSponsor = !string.IsNullOrWhiteSpace(ownerInfo.SponsorName)
                                              && ownerInfo.SponsorName != "—"
                                              && ownerInfo.SponsorName != "-";
                        }

                        @* ── Checkbox ── *@
                        <td class="border-0 ps-3">
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>

                        @* ── Sıra No ── *@
                        <td class="border-0 d-none d-md-table-cell small">@(rowNo++)</td>

                        @* ── Sponsor ── *@
                        <td class="border-0">
                            @if (hasSponsor)
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(25,135,84,0.2);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-link" aria-hidden="true" style="font-size:0.65rem;"></i>
                                    @ownerInfo.SponsorName
                                </span>
                            }
                            else
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(255,255,255,0.08);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-minus-circle" aria-hidden="true" style="font-size:0.65rem;"></i>
                                    Yok
                                </span>
                            }
                        </td>

                        @* ── Profil Resmi ── *@
                        <td class="border-0">
                            <img src="@(string.IsNullOrWhiteSpace(item.ProfileCoverGallery?.ProfileImagePath)
                                                                                                                                                                                                                                                                                                                                                                                                                                      ? "https://efavori.com/_files/main/NoImage.png"
                                                                                                                                                                                                                                                                                                                                                                                                                                      : item.ProfileCoverGallery!.ProfileImagePath)"
                                 class="rounded-circle"
                                 style="width:38px;height:38px;object-fit:cover;border:2px solid rgba(255,255,255,0.15);"
                                 alt="Profil" />
                        </td>

                        @* ── Mağaza Sahibi ── *@
                        <td class="border-0">
                            <span class="small text-light">
                                <i class="fa fa-user-circle-o me-1" aria-hidden="true"></i>@ownerInfo.OwnerName
                            </span>
                        </td>

                        @* ── Mağaza Adı ── *@
                        <td class="border-0">
                            <span class="fw-semibold text-light">@(item.Name ?? "—")</span>
                        </td>

                        @* ── Ülke ── *@
                        <td class="border-0 d-none d-lg-table-cell">
                            <span class="small">@(Decrypt(item.AddressInfo?.Country) ?? "—")</span>
                        </td>

                        @* ── İl ── *@
                        <td class="border-0 d-none d-lg-table-cell">
                            <span class="small">@(Decrypt(item.AddressInfo?.State) ?? "—")</span>
                        </td>

                        @* ── İlçe ── *@
                        <td class="border-0 d-none d-xl-table-cell">
                            <span class="small">@(Decrypt(item.AddressInfo?.City) ?? "—")</span>
                        </td>

                        @* ── Onay Durumu ── *@
                        <td class="border-0">
                            @{
                                bool? activeOk = item.IsActiveStateAdmin;
                            }
                            @if (activeOk == null)
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(255,193,7,0.18);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-hourglass-half" style="font-size:0.65rem;"></i>
                                    Beklemede
                                </span>
                            }
                            else if (activeOk == true)
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(13,110,253,0.18);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-check-circle" style="font-size:0.65rem;"></i>
                                    Onaylı
                                </span>
                            }
                            else
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(220,53,69,0.18);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-times-circle" style="font-size:0.65rem;"></i>
                                    Reddedildi
                                </span>
                            }
                        </td>
                        @* ── Yayın Durumu ── *@
                        <td class="border-0">
                            @{
                                bool ShowIsOk = (item.IsActiveStateAdmin == true) && (item.IsActiveStateVendor ?? false);
                            }
                            @if (item.IsActiveStateAdmin != true && item.IsActiveStateVendor == null)
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(255,193,7,0.18);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-hourglass-half" style="font-size:0.65rem;"></i>
                                    Beklemede
                                </span>
                            }
                            else if (ShowIsOk)
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(13,202,240,0.18);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-eye" style="font-size:0.65rem;"></i>
                                    Yayında
                                </span>
                            }
                            else
                            {
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(255,255,255,0.08);font-size:0.75rem;font-weight:500; width:100%;">
                                    <i class="fa fa-eye-slash" style="font-size:0.65rem;"></i>
                                    Gizli
                                </span>
                            }
                        </td>

                        @* ── Engelleme Bilgileri ── *@
                        @{
                            var blocking = _blockingLookup.ContainsKey(item.Id)
                                ? _blockingLookup[item.Id]
                                : (Total: 0, Pending: 0, Completed: 0);
                        }

                        @* Stil tanımlarını tek bir yerde yönetmek için yardımcı bir yöntem (opsiyonel) *@
                        <style>
                                            /* !important ekleyerek diğer Bootstrap stillerini geçersiz kılalım */
                                            .cell-total {
                                                background-color: rgba(108, 117, 125, 0.2) !important;
                                            }

                                            .cell-pending {
                                                background-color: rgba(108, 117, 125, 0.2) !important;
                                            }

                                            .cell-completed {
                                                background-color: rgba(108, 117, 125, 0.2) !important;
                                            }

                                            /* TD içindeki boşluğu yönetmek için */
                                            .table td.cell-total,
                                            .table td.cell-pending,
                                            .table td.cell-completed {
                                                padding: 0.5rem !important; /* Hücrenin içindeki dolguyu artırarak arka planın görünürlüğünü garanti eder */
                                            }
                        </style>

                        @* ── Toplam Revizyon ── *@
                        <td class="border-0 d-none d-lg-table-cell text-center cell-total">
                            @if (blocking.Total > 0)
                            {
                                <span class="d-inline-flex align-items-center justify-content-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(108,117,125,0.18);font-size:0.75rem;font-weight:500;min-width:2rem;">
                                    <i class="fa fa-exclamation-circle" style="font-size:0.65rem;"></i> @blocking.Total
                                </span>
                            }
                            else
                            {
                                <span class="small text-light">YOK</span>
                            }
                        </td>

                        @* ── Bekleyen ── *@
                        <td class="border-0 d-none d-lg-table-cell text-center cell-pending">
                            @if (blocking.Pending > 0)
                            {
                                <span class="d-inline-flex align-items-center justify-content-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(255,193,7,0.18);font-size:0.75rem;font-weight:500;min-width:2rem;">
                                    <i class="fa fa-hourglass-half" style="font-size:0.65rem;"></i> @blocking.Pending
                                </span>
                            }
                            else
                            {
                                <span class="small text-light">YOK</span>
                            }
                        </td>

                        @* ── Tamamlanan ── *@
                        <td class="border-0 d-none d-lg-table-cell text-center cell-completed">
                            @if (blocking.Completed > 0)
                            {
                                <span class="d-inline-flex align-items-center justify-content-center gap-1 px-2 py-1 rounded-pill small"
                                      style="background:rgba(25,135,84,0.18);font-size:0.75rem;font-weight:500;min-width:2rem;">
                                    <i class="fa fa-check-circle" style="font-size:0.65rem;"></i> @blocking.Completed
                                </span>
                            }
                            else
                            {
                                <span class="small text-light">YOK</span>
                            }
                        </td>
                        @* ── İşlemler ── *@
                        <td class="border-0 text-end text-nowrap pe-3">
                            <a class="btn btn-sm me-1 px-2 py-1 btn-outline-warning"
                               style="background:rgba(255,193,7,0.1);border:none;"
                               href="/@culture/Admin/Store/Edit/@(item.Id)"
                               title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </a>
                            <button class="btn btn-sm px-2 py-1 btn-outline-danger"
                                    style="background:rgba(220,53,69,0.1);border:none;"
                                    @onclick="() => OpenDeleteModal(item)"
                                    title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_allItems.Count kayıt
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                    </li>

                    @for (int p = 1; p <= _totalPages; p++)
                    {
                        var pg = p;
                        <li class="page-item @(_currentPage == pg ? "active" : "")">
                            <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                    @onclick="() => GoToPage(pg)">
                                @pg
                            </button>
                        </li>
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Tekli Sil
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>Mağaza Silme İşlemi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2"
                            data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-white-50 small mb-3">Bu mağazayı silmek istediğinizden emin misiniz?</p>
                @if (_deleteTarget != null)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="@(string.IsNullOrWhiteSpace(_deleteTarget.ProfileCoverGallery?.ProfileImagePath)
                                                                                                                                                                                                                                                                                                                                                                                  ? "https://efavori.com/_files/main/NoImage.png"
                                                                                                                                                                                                                                                                                                                                                                                  : _deleteTarget.ProfileCoverGallery!.ProfileImagePath)"
                             class="rounded-circle border border-secondary"
                             style="width:52px;height:52px;object-fit:cover;" alt="Profil" />
                        <div>
                            <div class="fw-semibold text-white">@(_deleteTarget.Name ?? "—")</div>
                            <div class="small text-white-50">
                                @(Decrypt(_deleteTarget.AddressInfo?.Country) ?? "—") /
                                @(Decrypt(_deleteTarget.AddressInfo?.State) ?? "—") /
                                @(Decrypt(_deleteTarget.AddressInfo?.City) ?? "—")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="DeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>Evet, Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Toplu Sil Onayı
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="BulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>
                    Toplu Silme — @_selectedIds.Count mağaza seçildi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2"
                            data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-warning small mb-3">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    Aşağıdaki <strong>@_selectedIds.Count</strong> mağaza silinecek. Bu işlem geri alınamaz.
                </p>

                @if (_bulkDeletePreview.Any())
                {
                    <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                        <table class="table table-sm table-dark table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th class="small">#</th>
                                    <th class="small">Mağaza Adı</th>
                                    <th class="small">Ülke</th>
                                    <th class="small">İl</th>
                                    <th class="small">İlçe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int n = 1;
                                }
                                @foreach (var item in _bulkDeletePreview)
                                {
                                    <tr>
                                        <td class="small text-secondary">@(n++)</td>
                                        <td class="small">@(item.Name ?? "—")</td>
                                        <td class="small">@(Decrypt(item.AddressInfo?.Country) ?? "—")</td>
                                        <td class="small">@(Decrypt(item.AddressInfo?.State) ?? "—")</td>
                                        <td class="small">@(Decrypt(item.AddressInfo?.City) ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"
                        @onclick="() => _bulkDeletePreview.Clear()">
                    <i class="fa fa-arrow-left me-1"></i>Vazgeç
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="BulkDeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>@_selectedIds.Count Mağazayı Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Mağaza Yönetimi";
    private const string ENTITY_NAME = "Store";
    private const string CACHE_KEY = "Store_List";
    private const int SEARCH_DELAY = 500;
    private const int PAGE_SIZE = 25;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yetki ────────────────────────────────────────────────────
    // SuperAdmin: tüm mağazaları görür + Admin onay/blok yetkisi
    // Diğer kullanıcı: sadece kendi mağazalarını görür + yayın yetkisi
    private bool IsSuperAdmin => use?.UsersType == "SuperAdmin";

    // ─── Cache kapsamı ────────────────────────────────────────────
    // KRİTİK: GlobalStateHub süreç genelinde paylaşılan bir RAM cache'tir.
    // Tek bir global anahtar (CACHE_KEY) kullanılırsa SuperAdmin'in tüm-mağaza
    // listesi ile bir satıcının kendi listesi AYNI anahtara yazılır ve
    // kullanıcılar arası veri sızması olur. Bu yüzden anahtar role/kullanıcıya
    // göre ayrıştırılır: SuperAdmin → "all", diğerleri → kendi UserId'si.
    private string CacheScope => IsSuperAdmin ? "all" : (use?.Id.ToString() ?? "anonymous");
    private string ScopedCacheKey => $"{CACHE_KEY}_{CacheScope}";

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;

    // ─── Veriler ──────────────────────────────────────────────────
    private List<Store> _allItems = new();

    // ─── Kullanıcı Bilgileri (Sahip + Sponsor) ─────────────────────
    // Key: Store.UserId → (OwnerFullName, SponsorFullName)
    private Dictionary<Guid, (string OwnerName, string? SponsorName)> _userLookup = new();

    // ─── Engelleme Bilgileri ────────────────────────────────────────
    // Key: Store.Id → (Toplam, Bekleyen, Tamamlanan)
    private Dictionary<Guid, (int Total, int Pending, int Completed)> _blockingLookup = new();

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;
    private List<Store> _pagedItems = new();

    // ─── Sil modal state ──────────────────────────────────────────
    private Store? _deleteTarget;

    // ─── Toplu Sil state ──────────────────────────────────────────
    private readonly HashSet<Guid> _selectedIds = new();
    private bool _allSelected;
    private List<Store> _bulkDeletePreview = new();

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI: Şifre çöz
    // ══════════════════════════════════════════════════════════════

    private static string? Decrypt(string? value)
    {
        if (string.IsNullOrEmpty(value)) return value;
        var result = GlobalSecurityProvider.Decrypt(value);
        return result?.StartsWith("Hata:") == true ? value : result;
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI: Kullanıcı Sahip + Sponsor bilgilerini yükle
    // ══════════════════════════════════════════════════════════════

    private async Task LoadUserLookupAsync(List<Store> stores, CancellationToken token)
    {
        _userLookup.Clear();

        // 1. Mağaza sahiplerinin UserId'lerini topla
        var ownerIds = stores
            .Where(s => s.UserId.HasValue)
            .Select(s => s.UserId!.Value)
            .Distinct()
            .ToList();

        if (!ownerIds.Any()) return;

        await using var db = await DbFactory.CreateDbContextAsync(token);

        // 2. Sahip kullanıcıları çek
        var owners = await db.Users
            .Where(u => ownerIds.Contains(u.Id))
            .Select(u => new { u.Id, u.FirstName, u.LastName, u.UserSponsorEmail })
            .AsNoTracking()
            .ToListAsync(token);

        // 3. Sponsor email'lerini topla ve sponsorları çek
        var sponsorEmails = owners
            .Where(o => !string.IsNullOrEmpty(o.UserSponsorEmail))
            .Select(o => o.UserSponsorEmail!)
            .Distinct()
            .ToList();

        // Sponsor email şifreli olabilir, ContactInformation.Email üzerinden eşleştir
        var allUsers = await db.Users
            .Where(u => u.ContactInformation != null && u.ContactInformation.Email != null)
            .Select(u => new { u.Id, u.FirstName, u.LastName, Email = u.ContactInformation!.Email })
            .AsNoTracking()
            .ToListAsync(token);

        // Email → FullName dictionary (decrypt ederek karşılaştır)
        var emailToName = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var u in allUsers)
        {
            var decryptedEmail = Decrypt(u.Email);
            if (!string.IsNullOrEmpty(decryptedEmail) && !emailToName.ContainsKey(decryptedEmail))
            {
                var fn = Decrypt(u.FirstName) ?? "";
                var ln = Decrypt(u.LastName) ?? "";
                emailToName[decryptedEmail] = $"{fn} {ln}".Trim();
            }
        }

        // 4. Lookup dictionary'yi oluştur
        foreach (var owner in owners)
        {
            var ownerFirstName = Decrypt(owner.FirstName) ?? "";
            var ownerLastName = Decrypt(owner.LastName) ?? "";
            var ownerFullName = $"{ownerFirstName} {ownerLastName}".Trim();
            if (string.IsNullOrEmpty(ownerFullName)) ownerFullName = "—";

            var sponsorFullName = (string?)null;
            if (!string.IsNullOrEmpty(owner.UserSponsorEmail))
            {
                var decryptedSponsorEmail = Decrypt(owner.UserSponsorEmail);
                if (!string.IsNullOrEmpty(decryptedSponsorEmail) &&
                    emailToName.TryGetValue(decryptedSponsorEmail, out var sName) &&
                    !string.IsNullOrEmpty(sName))
                {
                    sponsorFullName = sName;
                }
            }

            _userLookup[owner.Id] = (ownerFullName, sponsorFullName);
        }
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI: Mağaza Engelleme Bilgilerini Yükle
    // ══════════════════════════════════════════════════════════════

    private async Task LoadBlockingLookupAsync(List<Store> stores, CancellationToken token)
    {
        _blockingLookup.Clear();

        var storeIds = stores.Select(s => s.Id).Distinct().ToList();
        if (!storeIds.Any()) return;

        await using var db = await DbFactory.CreateDbContextAsync(token);

        var blockingData = await db.StoreBlockingInfos
            .Where(b => storeIds.Contains(b.StoreId)
                        && (b.IsDeleted == null || b.IsDeleted.IsDeletedStatu != true))
            .GroupBy(b => b.StoreId)
            .Select(g => new
            {
                StoreId = g.Key,
                Total = g.Count(),
                Completed = g.Count(b => b.IsSucces),
                Pending = g.Count(b => !b.IsSucces)
            })
            .AsNoTracking()
            .ToListAsync(token);

        foreach (var item in blockingData)
        {
            _blockingLookup[item.StoreId] = (item.Total, item.Pending, item.Completed);
        }
    }

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;

        await LoadDataAsync(_searchTerm);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;

        await InvokeAsync(async () =>
        {
            await LoadDataAsync(_searchTerm);
            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    private async Task LoadDataAsync(string? search)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            // Role/kullanıcı bazlı cache anahtarı — kullanıcılar arası sızmayı önler.
            string baseKey = ScopedCacheKey;
            string cacheKey = string.IsNullOrWhiteSpace(search) ? baseKey : $"{baseKey}_{search}";
            if (!string.IsNullOrWhiteSpace(search))
                StateHub.ClearCache(cacheKey);

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                IQueryable<Store> q;
                await using var db = await DbFactory.CreateDbContextAsync(token);
                if (IsSuperAdmin)
                {
                    // SuperAdmin tüm mağazaları görür
                    q = db.Stores.AsNoTracking();
                }
                else
                {
                    // Diğer kullanıcı yalnızca kendi mağazalarını görür
                    var uid = use?.Id;
                    q = db.Stores.Where(x => x.UserId == uid).AsNoTracking();
                }
                // Soft Delete filtresi
                q = q.Where(x => x.IsDeleted == null || x.IsDeleted.IsDeletedStatu != true);

                return await q.OrderByDescending(x => x.CreatedAt).ToListAsync(token);
            }, token);

            if (token.IsCancellationRequested || result == null) return;

            // ── GÜVENLİK: Bellek içi sahiplik filtresi (defense-in-depth) ──
            // Cache role bazlı ayrıştırılmış olsa bile, olası herhangi bir cache
            // karışmasına karşı son bir güvence: SuperAdmin OLMAYAN kullanıcı
            // KESİNLİKLE yalnızca kendi UserId'siyle eşleşen mağazaları görür.
            // (Cache referansını bozmamak için yeni liste üretilir.)
            if (!IsSuperAdmin)
            {
                var uid = use?.Id;
                result = result.Where(x => x.UserId == uid).ToList();
            }

            // Sahip + Sponsor bilgilerini yükle (arama öncesi gerekli)
            await LoadUserLookupAsync(result, token);

            // Engelleme bilgilerini yükle
            await LoadBlockingLookupAsync(result, token);

            // Bellek içi arama (şifreli alanlar + mağaza adı + sahip/sponsor)
            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim();
                result = result.Where(x =>
                    Contains(x.Name, s) ||
                    Contains(Decrypt(x.AddressInfo?.Country), s) ||
                    Contains(Decrypt(x.AddressInfo?.State), s) ||
                    Contains(Decrypt(x.AddressInfo?.City), s) ||
                    (x.UserId.HasValue && _userLookup.TryGetValue(x.UserId.Value, out var ui) &&
                        (Contains(ui.OwnerName, s) || Contains(ui.SponsorName, s)))
                ).ToList();
            }

            _allItems = result;
            ApplyPaging(1);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadData", ex);
                await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void ApplyPaging(int page)
    {
        _totalPages = Math.Max(1, (int)Math.Ceiling(_allItems.Count / (double)PAGE_SIZE));
        _currentPage = Math.Clamp(page, 1, _totalPages);
        _pagedItems = _allItems.Skip((_currentPage - 1) * PAGE_SIZE).Take(PAGE_SIZE).ToList();
    }

    private void GoToPage(int page)
    {
        ApplyPaging(page);
        StateHasChanged();
    }

    // ══════════════════════════════════════════════════════════════
    // ARAMA
    // ══════════════════════════════════════════════════════════════

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadDataAsync(_searchTerm);
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await LoadDataAsync(null);
    }

    // ══════════════════════════════════════════════════════════════
    // MODAL AÇMA
    // ══════════════════════════════════════════════════════════════

    private async Task OpenDeleteModal(Store item)
    {
        _deleteTarget = item;
        await ShowModal("DeleteModal");
    }

    private async Task OpenBulkDeleteModal()
    {
        if (!_selectedIds.Any()) return;
        _bulkDeletePreview = _allItems.Where(x => _selectedIds.Contains(x.Id)).ToList();
        await ShowModal("BulkDeleteModal");
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Tekli Sil
    // ══════════════════════════════════════════════════════════════

    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.Stores.FindAsync(new object[] { _deleteTarget.Id }, _cts.Token);

            if (entity != null)
            {
                entity.IsDeleted = new IsDeleted
                {
                    IsDeletedStatu = true,
                    DeletedAtDate = DateTime.UtcNow
                };
                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("DeleteModal");
            _deleteTarget = null;
            _isProcessing = false;

            StateHub.ClearCache(ScopedCacheKey);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Delete");
            await Notify("success", "Silindi", "Mağaza başarıyla silindi.");
        }
        catch (Exception ex)
        {
            await LogError("DeleteAsync", ex);
            await Notify("danger", "Hata", "Silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
            await LoadDataAsync(null);
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Sil
    // ══════════════════════════════════════════════════════════════

    private async Task BulkDeleteConfirmedAsync()
    {
        if (_isProcessing || !_selectedIds.Any()) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();
            var count = ids.Count;

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var entities = await db.Stores
                .Where(x => ids.Contains(x.Id))
                .ToListAsync(_cts.Token);

            var deletedAt = DateTime.UtcNow;
            foreach (var entity in entities)
            {
                entity.IsDeleted = new IsDeleted
                {
                    IsDeletedStatu = true,
                    DeletedAtDate = deletedAt
                };
            }

            if (entities.Count > 0)
                await db.SaveChangesAsync(_cts.Token);

            _selectedIds.Clear();
            _allSelected = false;
            _bulkDeletePreview.Clear();

            await HideModal("BulkDeleteModal");
            _isProcessing = false;

            StateHub.ClearCache(ScopedCacheKey);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkDelete ({count})");
            await Notify("success", "Silindi", $"{count} mağaza silindi.");
        }
        catch (Exception ex)
        {
            await LogError("BulkDelete", ex);
            await Notify("danger", "Hata", "Toplu silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Durum Güncelleme (Onay / Blok / Yayın)
    // ══════════════════════════════════════════════════════════════

    // SuperAdmin → IsActiveStateAdmin = true
    private Task BulkApproveAdminAsync() =>
        BulkUpdateStateAsync(adminState: true, action: "BulkApprove", successText: "onaylandı");

    // SuperAdmin → IsActiveStateAdmin = false
    private Task BulkBlockAdminAsync() =>
        BulkUpdateStateAsync(adminState: false, action: "BulkBlock", successText: "bloklandı");

    // Satıcı → IsActiveStateVendor = true
    private Task BulkPublishVendorAsync() =>
        BulkUpdateStateAsync(vendorState: true, action: "BulkPublish", successText: "yayına alındı");

    // Satıcı → IsActiveStateVendor = false
    private Task BulkUnpublishVendorAsync() =>
        BulkUpdateStateAsync(vendorState: false, action: "BulkUnpublish", successText: "yayından kaldırıldı");

    private async Task BulkUpdateStateAsync(
        bool? adminState = null,
        bool? vendorState = null,
        string action = "",
        string successText = "")
    {
        if (_isProcessing || !_selectedIds.Any() || use is null) return;

        // ── Yetki guard ──
        // Admin onay/blok yalnızca SuperAdmin; yayın işlemleri yalnızca SuperAdmin olmayan kullanıcı
        if (adminState.HasValue && !IsSuperAdmin) return;
        if (vendorState.HasValue && IsSuperAdmin) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var query = db.Stores.Where(x => ids.Contains(x.Id));

            // SuperAdmin olmayan kullanıcı sadece kendi mağazalarını güncelleyebilir
            if (!IsSuperAdmin)
                query = query.Where(x => x.UserId == use.Id);

            var entities = await query.ToListAsync(_cts.Token);

            var now = DateTime.Now;
            foreach (var entity in entities)
            {
                if (adminState.HasValue)
                {
                    entity.IsActiveStateAdmin = adminState.Value;
                    entity.IsActiveDateAdmin = now;
                }
                if (vendorState.HasValue)
                {
                    entity.IsActiveStateVendor = vendorState.Value;
                    entity.IsActiveDateVendor = now;
                }
            }

            var affected = entities.Count;
            if (affected > 0)
                await db.SaveChangesAsync(_cts.Token);

            _selectedIds.Clear();
            _allSelected = false;
            _isProcessing = false;

            StateHub.ClearCache(ScopedCacheKey);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"{action} ({affected})");
            await Notify("success", "İşlem Tamamlandı", $"{affected} mağaza {successText}.");
        }
        catch (Exception ex)
        {
            await LogError(action, ex);
            await Notify("danger", "Hata", "Toplu işlem sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
            await LoadDataAsync(null);
        }
    }

    // ══════════════════════════════════════════════════════════════
    // TOPLU SEÇİM
    // ══════════════════════════════════════════════════════════════

    private void ToggleRowSelection(Guid id)
    {
        if (!_selectedIds.Remove(id)) _selectedIds.Add(id);
        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (_allSelected)
            _selectedIds.Clear();
        else
            foreach (var item in _allItems)
                _selectedIds.Add(item.Id);

        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _allSelected = false;
        StateHasChanged();
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI
    // ══════════════════════════════════════════════════════════════

    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://picsum.photos/120");
    }

    private async Task LogError(string action, Exception ex)
    {
        try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); }
        catch { }
    }
}
