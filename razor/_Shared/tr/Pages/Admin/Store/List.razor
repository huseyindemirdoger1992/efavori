    // ══════════════════════════════════════════════════════════════
    // CRUD — Tekli Sil
    // ══════════════════════════════════════════════════════════════

    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.Stores.FindAsync(new object[] { _deleteTarget.Id }, _cts.Token);

            if (entity != null)
            {
                entity.IsDeleted = new IsDeleted
                {
                    IsDeletedStatu = true,
                    DeletedAtDate = DateTime.UtcNow
                };
                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("DeleteModal");
            _deleteTarget = null;
            _isProcessing = false;

            StateHub.ClearCache(ScopedCacheKey);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Delete");
            await Notify("success", "Silindi", "Mağaza başarıyla silindi.");
        }
        catch (Exception ex)
        {
            await LogError("DeleteAsync", ex);
            await Notify("danger", "Hata", "Silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
            await LoadDataAsync(null);
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Sil
    // ══════════════════════════════════════════════════════════════

    private async Task BulkDeleteConfirmedAsync()
    {
        if (_isProcessing || !_selectedIds.Any()) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();
            var count = ids.Count;

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var entities = await db.Stores
                .Where(x => ids.Contains(x.Id))
                .ToListAsync(_cts.Token);

            var deletedAt = DateTime.UtcNow;
            foreach (var entity in entities)
            {
                entity.IsDeleted = new IsDeleted
                {
                    IsDeletedStatu = true,
                    DeletedAtDate = deletedAt
                };
            }

            if (entities.Count > 0)
                await db.SaveChangesAsync(_cts.Token);

            _selectedIds.Clear();
            _allSelected = false;
            _bulkDeletePreview.Clear();

            await HideModal("BulkDeleteModal");
            _isProcessing = false;

            StateHub.ClearCache(ScopedCacheKey);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkDelete ({count})");
            await Notify("success", "Silindi", $"{count} mağaza silindi.");
        }
        catch (Exception ex)
        {
            await LogError("BulkDelete", ex);
            await Notify("danger", "Hata", "Toplu silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Durum Güncelleme (Onay / Blok / Yayın)
    // ══════════════════════════════════════════════════════════════

    // SuperAdmin → IsActiveStateAdmin = true
    private Task BulkApproveAdminAsync() =>
        BulkUpdateStateAsync(adminState: true, action: "BulkApprove", successText: "onaylandı");

    // SuperAdmin → IsActiveStateAdmin = false
    private Task BulkBlockAdminAsync() =>
        BulkUpdateStateAsync(adminState: false, action: "BulkBlock", successText: "bloklandı");

    // Satıcı → IsActiveStateVendor = true
    private Task BulkPublishVendorAsync() =>
        BulkUpdateStateAsync(vendorState: true, action: "BulkPublish", successText: "yayına alındı");

    // Satıcı → IsActiveStateVendor = false
    private Task BulkUnpublishVendorAsync() =>
        BulkUpdateStateAsync(vendorState: false, action: "BulkUnpublish", successText: "yayından kaldırıldı");

    private async Task BulkUpdateStateAsync(
        bool? adminState = null,
        bool? vendorState = null,
        string action = "",
        string successText = "")
    {
        if (_isProcessing || !_selectedIds.Any() || use is null) return;

        // ── Yetki guard ──
        // Admin onay/blok yalnızca SuperAdmin; yayın işlemleri yalnızca SuperAdmin olmayan kullanıcı
        if (adminState.HasValue && !IsSuperAdmin) return;
        if (vendorState.HasValue && IsSuperAdmin) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var query = db.Stores.Where(x => ids.Contains(x.Id));

            // SuperAdmin olmayan kullanıcı sadece kendi mağazalarını güncelleyebilir
            if (!IsSuperAdmin)
                query = query.Where(x => x.UserId == use.Id);

            var entities = await query.ToListAsync(_cts.Token);

            var now = DateTime.Now;
            foreach (var entity in entities)
            {
                if (adminState.HasValue)
                {
                    entity.IsActiveStateAdmin = adminState.Value;
                    entity.IsActiveDateAdmin = now;
                }
                if (vendorState.HasValue)
                {
                    entity.IsActiveStateVendor = vendorState.Value;
                    entity.IsActiveDateVendor = now;
                }
            }

            var affected = entities.Count;
            if (affected > 0)
                await db.SaveChangesAsync(_cts.Token);

            _selectedIds.Clear();
            _allSelected = false;
            _isProcessing = false;

            StateHub.ClearCache(ScopedCacheKey);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"{action} ({affected})");
            await Notify("success", "İşlem Tamamlandı", $"{affected} mağaza {successText}.");
        }
        catch (Exception ex)
        {
            await LogError(action, ex);
            await Notify("danger", "Hata", "Toplu işlem sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
            await LoadDataAsync(null);
        }
    }

    // ══════════════════════════════════════════════════════════════
    // TOPLU SEÇİM
    // ══════════════════════════════════════════════════════════════

    private void ToggleRowSelection(Guid id)
    {
        if (!_selectedIds.Remove(id)) _selectedIds.Add(id);
        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (_allSelected)
            _selectedIds.Clear();
        else
            foreach (var item in _allItems)
                _selectedIds.Add(item.Id);

        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _allSelected = false;
        StateHasChanged();
    }

