@* ============================================================
   EmailHistoryList.razor
   ─────────────────────────────────────────────────────────────
   ✅ Sadece EmailHistory.cs yapısını listeler (salt-okunur)
   ✅ Kullanıcı ile bağlı DEĞİL — tüm alanlar düz metin
   ✅ Sunucu tarafı sayfalama (her sayfada 10 kayıt, DB'de Skip/Take)
   ✅ Arama TÜM tabloda çalışır (o anki 10'luk sayfada değil)
   ✅ Pencereli sayfalama + "Sayfaya git"
   ✅ Sağda "Detaylar" butonu → modal (tüm alanlar + e-posta gövdesi)
   ✅ GlobalStateHub broadcast, TakeLogs ile aksiyon loglama
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    // Bu alanı kesinlikle SİLME. Global state'den dil bilgisini alıp yönlendirme için gereklidir.
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    // NavigationManager.NavigateTo($@"/{use?.Language.ToLower()}/Admin/EmailHistory/List/", true);
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",     "Ana Sayfa",  "/"),
        ("fa fa-table",    "Kayıtlar",   "javascript:void(0)"),
        ("fa fa-envelope", PAGE_TITLE,   "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button class="btn btn-light btn-sm" @onclick="RefreshAsync" disabled="@_isLoading">
        <i class="fa fa-refresh me-sm-1 @(_isLoading ? "fa-spin" : "")"></i>
        <span class="d-none d-sm-inline">Yenile</span>
    </button>

    <div class="vr mx-1"></div>
    <span class="badge bg-light text-light">
        <i class="fa fa-envelope me-1"></i>@_totalCount e-posta
    </span>
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Gönderen, alıcı, konu, içerik, ek veya TraceId ara"
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && _totalCount == 0)
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">E-posta kaydı bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                    <th>Gönderen</th>
                    <th>Alıcı</th>
                    <th>Konu</th>
                    <th class="d-none d-lg-table-cell text-center">Ek</th>
                    <th class="d-none d-md-table-cell">Tarih</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var mail in _pagedItems)
                {
                    var hasAttachment = !string.IsNullOrWhiteSpace(mail.Attachments);
                    <tr>
                        <td class="d-none d-md-table-cell text-light small">@(rowNo++)</td>
                        <td class="text-truncate" style="max-width:14rem;">
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(mail.FromWhom) ? "—" : mail.FromWhom)</div>
                        </td>
                        <td class="text-truncate" style="max-width:14rem;">
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(mail.ToWho) ? "—" : mail.ToWho)</div>
                        </td>
                        <td class="text-truncate" style="max-width:18rem;">
                            @(string.IsNullOrWhiteSpace(mail.Subject) ? "—" : mail.Subject)
                        </td>
                        <td class="d-none d-lg-table-cell text-center">
                            @if (hasAttachment)
                            {
                                <span title="@mail.Attachments"><i class="fa fa-paperclip text-info"></i></span>
                            }
                            else
                            {
                                <span class="text-light">—</span>
                            }
                        </td>
                        <td class="d-none d-md-table-cell text-nowrap">
                            <div class="small">
                                @mail.SentDate.ToString("dd.MM.yyyy")
                                <span class="text-light"> | @mail.SentDate.ToString("HH:mm")</span>
                            </div>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-info btn-sm"
                                    @onclick="() => OpenDetailModal(mail)" title="Detaylar">
                                <i class="fa fa-envelope-open-o"></i>
                                <span class="d-none d-xl-inline ms-1">Detaylar</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama (pencereli — binlerce sayfada bile taşmaz) ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_totalCount kayıt
            <span class="text-light"> · Sayfa @_currentPage / @_totalPages</span>
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <div class="d-flex align-items-center flex-wrap gap-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0 flex-nowrap">
                        @* İlk sayfa *@
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(1)" title="İlk sayfa">
                                <i class="fa fa-angle-double-left"></i>
                            </button>
                        </li>
                        @* Önceki *@
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(_currentPage - 1)" title="Önceki">
                                <i class="fa fa-chevron-left"></i>
                            </button>
                        </li>

                        @* Baştaki "…" *@
                        @if (_pageWindow.First() > 1)
                        {
                            <li class="page-item disabled d-none d-sm-block">
                                <span class="page-link bg-dark text-light border-secondary">…</span>
                            </li>
                        }

                        @* Pencere içindeki sayfalar *@
                        @foreach (var pg in _pageWindow)
                        {
                            <li class="page-item @(_currentPage == pg ? "active" : "")">
                                <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                        @onclick="() => GoToPage(pg)">
                                    @pg
                                </button>
                            </li>
                        }

                        @* Sondaki "…" *@
                        @if (_pageWindow.Last() < _totalPages)
                        {
                            <li class="page-item disabled d-none d-sm-block">
                                <span class="page-link bg-dark text-light border-secondary">…</span>
                            </li>
                        }

                        @* Sonraki *@
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(_currentPage + 1)" title="Sonraki">
                                <i class="fa fa-chevron-right"></i>
                            </button>
                        </li>
                        @* Son sayfa *@
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link bg-dark text-light border-secondary"
                                    @onclick="() => GoToPage(_totalPages)" title="Son sayfa">
                                <i class="fa fa-angle-double-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>

                @* Sayfaya git *@
                <div class="input-group input-group-sm" style="width:9.5rem;">
                    <input type="number" min="1" max="@_totalPages"
                           class="form-control bg-dark text-light border-secondary text-center"
                           placeholder="Sayfa"
                           value="@_jumpToPage"
                           @oninput="OnJumpInput"
                           @onkeydown="OnJumpKeyDown" />
                    <button class="btn btn-outline-light border-secondary" @onclick="JumpToPage" title="Git">
                        <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — E-posta Detayları
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="DetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-info"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-info py-2">
                <h6 class="modal-title text-info mb-0">
                    <i class="fa fa-envelope-open-o me-1"></i>E-posta Detayları
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" arialabel="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_detailTarget != null)
                {
                    var mail = _detailTarget;
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-user me-1"></i>Gönderen</label>
                            <div class="text-light text-break">@(string.IsNullOrWhiteSpace(mail.FromWhom) ? "—" : mail.FromWhom)</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-users me-1"></i>Alıcı</label>
                            <div class="text-light text-break">@(string.IsNullOrWhiteSpace(mail.ToWho) ? "—" : mail.ToWho)</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-tag me-1"></i>Konu</label>
                            <div class="text-light text-break">@(string.IsNullOrWhiteSpace(mail.Subject) ? "—" : mail.Subject)</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-calendar me-1"></i>Gönderim Tarihi (UTC)</label>
                            <div class="text-light">@mail.SentDate.ToString("dd.MM.yyyy HH:mm:ss")</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-hashtag me-1"></i>Trace Id</label>
                            <div class="text-light small text-break">@(string.IsNullOrWhiteSpace(mail.TraceId) ? "—" : mail.TraceId)</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-paperclip me-1"></i>Ekler</label>
                            <div class="text-light small text-break">@(string.IsNullOrWhiteSpace(mail.Attachments) ? "Ek yok" : mail.Attachments)</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-key me-1"></i>Kayıt Id</label>
                            <div class="text-light small text-break">@mail.Id</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-info small mb-1"><i class="fa fa-file-text-o me-1"></i>İçerik (Body)</label>
                            @if (!string.IsNullOrWhiteSpace(mail.Body))
                            {
                                <pre class="bg-black text-light p-2 rounded border border-secondary small mb-0"
                                     style="white-space:pre-wrap; max-height:22rem; overflow:auto;">@mail.Body</pre>
                            }
                            else
                            {
                                <div class="text-light small">İçerik yok.</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-info py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "E-posta Geçmişi";
    private const string ENTITY_NAME = "EmailHistory";
    private const int SEARCH_DELAY = 500;
    private const int PAGE_SIZE = 10;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;

    // ─── Veriler ──────────────────────────────────────────────────
    private int _totalCount;                            // Filtreye uyan toplam kayıt
    private List<EmailHistory> _pagedItems = new();     // Sadece o anki 10 satır

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;

    // Görünür sayfa düğmesi sayısı (current'in iki yanında ~2'şer)
    private const int PAGE_WINDOW = 5;
    private List<int> _pageWindow = new() { 1 };

    // "Sayfaya git" alanı
    private int? _jumpToPage;

    // ─── Detay modal hedefi ───────────────────────────────────────
    private EmailHistory? _detailTarget;

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;
        await LoadPageAsync(1);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;

        await InvokeAsync(async () =>
        {
            await LoadPageAsync(_currentPage);
            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME — sunucu tarafı sayfalama, tüm tabloda arama
    // ══════════════════════════════════════════════════════════════

    private async Task LoadPageAsync(int page, bool debounce = false)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        var search = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();

        try
        {
            // Yazarken her tuşta sorgu atmamak için debounce
            if (debounce)
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(token);

            // ── Temel sorgu (DB tarafında, hiç tüm tabloyu çekmeden) ──
            var query = db.EmailHistory.AsNoTracking().AsQueryable();

            // Tüm alanlar düz metin → arama doğrudan DB'de (LIKE) yapılır.
            if (search != null)
            {
                query = query.Where(e =>
                    (e.FromWhom != null && e.FromWhom.Contains(search)) ||
                    (e.ToWho != null && e.ToWho.Contains(search)) ||
                    (e.Subject != null && e.Subject.Contains(search)) ||
                    (e.Body != null && e.Body.Contains(search)) ||
                    (e.Attachments != null && e.Attachments.Contains(search)) ||
                    (e.TraceId != null && e.TraceId.Contains(search)));
            }

            // ── Toplam sayım + sayfa sınırlama ──
            _totalCount = await query.CountAsync(token);
            _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PAGE_SIZE));
            _currentPage = Math.Clamp(page, 1, _totalPages);
            BuildPageWindow();

            // ── Sadece o anki 10 kaydı çek (Skip/Take DB tarafında) ──
            _pagedItems = await query
                .OrderByDescending(x => x.SentDate)
                .Skip((_currentPage - 1) * PAGE_SIZE)
                .Take(PAGE_SIZE)
                .ToListAsync(token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadPage", ex);
                await Notify("danger", "Hata", "E-postalar yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    // Sadece current'in etrafındaki PAGE_WINDOW kadar sayfa numarasını üretir
    private void BuildPageWindow()
    {
        int start = Math.Max(1, _currentPage - PAGE_WINDOW / 2);
        int end = Math.Min(_totalPages, start + PAGE_WINDOW - 1);
        // Sona yaklaşıldıysa pencereyi geriye doğru tamamla
        start = Math.Max(1, end - PAGE_WINDOW + 1);

        _pageWindow = Enumerable.Range(start, end - start + 1).ToList();
    }

    private async Task GoToPage(int page)
    {
        _jumpToPage = null;
        await LoadPageAsync(page);
    }

    // ─── "Sayfaya git" alanı ───
    private void OnJumpInput(ChangeEventArgs e) =>
        _jumpToPage = int.TryParse(e.Value?.ToString(), out var v) ? v : null;

    private async Task JumpToPage()
    {
        if (_jumpToPage is int p) await GoToPage(p);
    }

    private async Task OnJumpKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await JumpToPage();
    }

    private async Task RefreshAsync()
    {
        await LoadPageAsync(_currentPage);
    }

    // ══════════════════════════════════════════════════════════════
    // ARAMA — tüm tabloda arar, sonucu 1. sayfadan gösterir
    // ══════════════════════════════════════════════════════════════

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadPageAsync(1, debounce: true);
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await LoadPageAsync(1);
    }

    // ══════════════════════════════════════════════════════════════
    // MODAL AÇMA
    // ══════════════════════════════════════════════════════════════

    private async Task OpenDetailModal(EmailHistory mail)
    {
        _detailTarget = mail;
        await ShowModal("DetailModal");
        await Logger.TakeIt(use?.Id, PAGE_TITLE, "ViewEmailDetail");
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI
    // ══════════════════════════════════════════════════════════════

    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://picsum.photos/120");
    }

    private async Task LogError(string action, Exception ex)
    {
        try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); }
        catch { }
    }
}
