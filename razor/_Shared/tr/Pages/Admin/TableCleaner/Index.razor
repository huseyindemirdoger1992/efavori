@using data
@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using System.Reflection

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject IJSRuntime JS

<h4 class="mb-4">
    <i class="fa fa-database text-danger"></i>
    Veri Tabanı Tablo Temizleme
</h4>

<div class="card shadow-sm">

    <div class="card-header">

        <div class="row align-items-center">

            <div class="col-md-4">

                <input type="text"
                       class="form-control"
                       placeholder="Tablo ara..."
                       @bind="_searchText" />

            </div>

            <div class="col-md-8 text-end">

                <button class="btn btn-outline-secondary btn-sm me-2"
                        @onclick="SelectAll">
                    Tümünü Seç
                </button>

                <button class="btn btn-outline-secondary btn-sm me-2"
                        @onclick="ClearSelection">
                    Seçimi Temizle
                </button>

                <button class="btn btn-danger btn-sm"
                        disabled="@(!_selectedTables.Any() || _isProcessing)"
                        @onclick="DeleteSelectedTables">

                    <i class="fa fa-trash"></i>
                    Seçili Tabloların İçeriğini Temizle
                </button>

            </div>

        </div>

    </div>

    <div class="card-body">

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-2x"></i>
            </div>
        }
        else
        {
            <div class="row mb-3">

                <div class="col-md-4">
                    <div class="alert alert-secondary mb-0 text-light">
                        <strong>Toplam Tablo</strong><br />
                        @_tables.Count
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="alert alert-info mb-0 text-light">
                        <strong>Toplam Kayıt</strong><br />
                        @_tables.Sum(x => x.Count).ToString("N0")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="alert alert-warning mb-0 text-light">
                        <strong>Seçili Tablo</strong><br />
                        @_selectedTables.Count
                    </div>
                </div>
                <hr />
                <div class="col-md-12">
                    <div class="alert alert-danger mb-0 text-warning">
                        <strong>Silinecek Kayıt</strong><br />
                        @_tables
                        .Where(x => _selectedTables.Contains(x.Name))
                        .Sum(x => x.Count)
                        .ToString("N0")
                    </div>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead>

                        <tr>
                            <th width="50"></th>
                            <th>Tablo</th>
                            <th width="180">Kayıt Sayısı</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var table in FilteredTables)
                        {
                            <tr>

                                <td>

                                    <input type="checkbox"
                                           class="form-check-input"
                                           checked="@_selectedTables.Contains(table.Name)"
                                           @onchange="() => ToggleTable(table.Name)" />

                                </td>

                                <td>
                                    <strong>@table.Name</strong>
                                </td>

                                <td>

                                    <span class="badge bg-primary">
                                        @table.Count.ToString("N0")
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@code
{
    [Parameter]
    public Users? use { get; set; }

    private bool _isLoading = true;
    private bool _isProcessing;

    private string _searchText = "";

    private List<TableInfo> _tables = new();

    private HashSet<string> _selectedTables = new();

    public class TableInfo
    {
        public string Name { get; set; } = "";
        public int Count { get; set; }
    }

    private IEnumerable<TableInfo> FilteredTables =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _tables
            : _tables.Where(x =>
                x.Name.Contains(_searchText,
                    StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadTables();
    }

    private async Task LoadTables()
    {
        _isLoading = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            _tables.Clear();

            var dbSets = typeof(_ApplicationConnectionDb)
                .GetProperties(BindingFlags.Public | BindingFlags.Instance)
                .Where(x =>
                    x.PropertyType.IsGenericType &&
                    x.PropertyType.GetGenericTypeDefinition() == typeof(DbSet<>))
                .OrderBy(x => x.Name)
                .ToList();

            foreach (var property in dbSets)
            {
                try
                {
                    var entityType = property.PropertyType.GenericTypeArguments[0];

                    var countMethod = typeof(EntityFrameworkQueryableExtensions)
                        .GetMethods()
                        .First(x =>
                            x.Name == "CountAsync" &&
                            x.GetParameters().Length == 2);

                    var setMethod = typeof(DbContext)
                        .GetMethod(nameof(DbContext.Set), Type.EmptyTypes)!
                        .MakeGenericMethod(entityType);

                    var query = setMethod.Invoke(db, null);

                    var genericCountMethod =
                        countMethod.MakeGenericMethod(entityType);

                    var task =
                        (Task<int>)genericCountMethod.Invoke(
                            null,
                            new object?[]
                            {
                                query,
                                CancellationToken.None
                            })!;

                    int count = await task;

                    _tables.Add(new TableInfo
                    {
                        Name = property.Name,
                        Count = count
                    });
                }
                catch
                {
                    _tables.Add(new TableInfo
                    {
                        Name = property.Name,
                        Count = 0
                    });
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleTable(string tableName)
    {
        if (_selectedTables.Contains(tableName))
            _selectedTables.Remove(tableName);
        else
            _selectedTables.Add(tableName);
    }

    private void SelectAll()
    {
        foreach (var table in FilteredTables)
            _selectedTables.Add(table.Name);
    }

    private void ClearSelection()
    {
        _selectedTables.Clear();
    }

    private async Task DeleteSelectedTables()
    {
        if (!_selectedTables.Any())
            return;

        var totalRows =
            _tables
                .Where(x => _selectedTables.Contains(x.Name))
                .Sum(x => x.Count);

        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            $"Seçili {_selectedTables.Count} tablo içerisindeki toplam {totalRows:N0} kayıt silinecek.\n\nDevam etmek istiyor musunuz?"
        );

        if (!confirm)
            return;

        _isProcessing = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            foreach (var table in _selectedTables)
            {
                try
                {
                    await db.Database.ExecuteSqlRawAsync(
                        $"DELETE FROM [{table}]"
                    );
                }
                catch
                {
                }
            }

            _selectedTables.Clear();

            await LoadTables();

            await JS.InvokeVoidAsync(
                "alert",
                "Seçilen tabloların tüm içerikleri temizlendi."
            );
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                ex.Message
            );
        }
        finally
        {
            _isProcessing = false;
        }
    }
}