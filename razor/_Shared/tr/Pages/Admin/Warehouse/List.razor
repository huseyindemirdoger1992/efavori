<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>Depo Silme
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Kapat" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-white-50 small mb-3">Bu depo kaydını silmek istediğinizden emin misiniz?</p>
                @if (_deleteTarget != null)
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-building me-1"></i>Mağaza</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@GetStoreName(_deleteTarget.StoreId)" disabled />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Depo Adı</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.AddressInfo?.MapTitle ?? "—")" disabled />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Konum</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@($"{_deleteTarget.AddressInfo?.Country ?? "—"} / {_deleteTarget.AddressInfo?.State ?? "—"} / {_deleteTarget.AddressInfo?.City ?? "—"}")" disabled />
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="DeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>Evet, Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
