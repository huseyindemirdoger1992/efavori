    // JS'den Lat/Lng almak için (DotNetObjectReference ile instance çağrısı)
    [JSInvokable]
    public Task SetWarehouseLatLng(double lat, double lng, bool isAdd)
    {
        if (isAdd && _addModel?.AddressInfo != null)
        {
            _addModel.AddressInfo.Latitude = (decimal)lat;
            _addModel.AddressInfo.Longitude = (decimal)lng;
        }
        else if (!isAdd && _editModel?.AddressInfo != null)
        {
            _editModel.AddressInfo.Latitude = (decimal)lat;
            _editModel.AddressInfo.Longitude = (decimal)lng;
        }
        return InvokeAsync(StateHasChanged);
    }

    private async Task InitMapAsync(string mapElementId, string btnId, decimal? lat, decimal? lng, bool isAdd)
    {
        try
        {
            _objRef ??= DotNetObjectReference.Create(this);

            // Harita motorunu eval ile tanımla
            await JS.InvokeVoidAsync("eval", WarehouseMapEngineScript);

            // 300ms gecikme: modal DOM'a render olsun
            await Task.Delay(350);

            await JS.InvokeVoidAsync("warehouseMap.init", _objRef,
                mapElementId, btnId,
                lat ?? 0m, lng ?? 0m, isAdd);

            if (isAdd) _addMapInitialized = true;
            else _editMapInitialized = true;
        }
        catch (Exception ex)
        {
            await LogError("MapInit", ex);
        }
    }

    // Harita motoru (Leaflet yükleyici + init). eval ile çalıştırılır → her render modunda güvenli.
    private const string WarehouseMapEngineScript = @"
        if (!window.warehouseMap) {
            window.warehouseMap = (function () {
                var maps = {}, markers = {}, dotnet = null;

                function injectAssets() {
                    if (!document.getElementById('leaflet-css')) {
                        var l = document.createElement('link');
                        l.id = 'leaflet-css'; l.rel = 'stylesheet';
                        l.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                        document.head.appendChild(l);
                    }
                    if (typeof L === 'undefined' && !document.getElementById('leaflet-js')) {
                        var s = document.createElement('script');
                        s.id = 'leaflet-js';
                        s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                        document.head.appendChild(s);
                    }
                }

                function place(mapId, lat, lng, zoom) {
                    var m = maps[mapId]; if (!m) return;
                    var c = [lat, lng];
                    m.setView(c, zoom || 15);
                    if (markers[mapId]) { markers[mapId].setLatLng(c); }
                    else { markers[mapId] = L.marker(c).addTo(m); }
                    markers[mapId].bindPopup('Depo Konumu').openPopup();
                }

                function build(mapId, btnId, lat, lng, isAdd) {
                    var el = document.getElementById(mapId);
                    if (!el) return;
                    if (maps[mapId]) { maps[mapId].remove(); maps[mapId] = null; markers[mapId] = null; }

                    var has = (lat !== null && lat !== undefined && lng !== null && lng !== undefined && lat !== 0 && lng !== 0);
                    maps[mapId] = L.map(el).setView([has ? lat : 38.9637, has ? lng : 35.2433], has ? 14 : 6);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(maps[mapId]);
                    if (has) { place(mapId, lat, lng, 14); }
                    setTimeout(function () { if (maps[mapId]) maps[mapId].invalidateSize(); }, 300);

                    var btn = document.getElementById(btnId);
                    if (btn && !btn.dataset.bound) {
                        btn.dataset.bound = '1';
                        btn.addEventListener('click', function () {
                            var o = btn.innerHTML; btn.disabled = true;
                            btn.innerHTML = '<i class=""fa fa-spinner fa-spin me-2""></i> Konum Alınıyor...';
                            if ('geolocation' in navigator) {
                                navigator.geolocation.getCurrentPosition(
                                    function (p) {
                                        var la = p.coords.latitude, lo = p.coords.longitude;
                                        place(mapId, la, lo, 15);
                                        if (dotnet) { dotnet.invokeMethodAsync('SetWarehouseLatLng', la, lo, isAdd); }
                                        btn.disabled = false; btn.innerHTML = o;
                                    },
                                    function (e) { alert('Hata: ' + e.message); btn.disabled = false; btn.innerHTML = o; },
                                    { enableHighAccuracy: true, timeout: 5000 }
                                );
                            } else { alert('Tarayıcınız konumu desteklemiyor.'); btn.disabled = false; btn.innerHTML = o; }
                        });
                    }
                }

                return {
                    init: function (ref, mapId, btnId, lat, lng, isAdd) {
                        dotnet = ref;
                        injectAssets();
                        var a = 0;
                        (function t() {
                            var el = document.getElementById(mapId);
                            var ok = el && (typeof L !== 'undefined');
                            if (!ok) { if (a++ < 80) { setTimeout(t, 150); } return; }
                            try { build(mapId, btnId, lat, lng, isAdd); } catch (e) { console.error('warehouseMap.build', e); }
                        })();
                    }
                };
            })();
        }
    ";

