<div class="modal fade" id="BulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>
                    Toplu Silme — @_selectedIds.Count kayıt seçildi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Kapat" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-warning small mb-3">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    Aşağıdaki <strong>@_selectedIds.Count</strong> depo kaydı silinecek. Bu işlem geri alınamaz.
                </p>

                @if (_bulkDeletePreview.Any())
                {
                    <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                        <table class="table table-sm table-dark table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th class="small">#</th>
                                    <th class="small">Mağaza</th>
                                    <th class="small">Depo Adı</th>
                                    <th class="small">Konum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int n = 1;
                                }
                                @foreach (var item in _bulkDeletePreview)
                                {
                                    <tr>
                                        <td class="small text-secondary">@(n++)</td>
                                        <td class="small">@GetStoreName(item.StoreId)</td>
                                        <td class="small">@(item.AddressInfo?.MapTitle ?? "—")</td>
                                        <td class="small">@(item.AddressInfo?.Country ?? "—") / @(item.AddressInfo?.State ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"
                        @onclick="() => _bulkDeletePreview.Clear()">
                    <i class="fa fa-arrow-left me-1"></i>Vazgeç
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="BulkDeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>@_selectedIds.Count Kaydı Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Depo Yönetimi";
    private const string ENTITY_NAME = "Warehouse";
    private const int SEARCH_DELAY = 500;
    private const int PAGE_SIZE = 5;

    // Kullanıcı bazlı cache key (çoklu kullanıcı izolasyonu)
    private string CACHE_KEY => $"Warehouse_List_{use?.Id}";

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;

    // ─── JS Interop (Harita) ──────────────────────────────────────
    private DotNetObjectReference<List>? _objRef;
    private bool _addMapInitialized;
    private bool _editMapInitialized;

    // ─── Veriler ──────────────────────────────────────────────────
    private List<data._Product.Warehouse> _allItems = new();
    private List<Store> _userStores = new(); // Kullanıcının mağazaları
    private List<Country> _countries = new();

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;
    private List<data._Product.Warehouse> _pagedItems = new();

    // ─── Ekle modal state ─────────────────────────────────────────
    private data._Product.Warehouse? _addModel;
    private int _addCountryId;
    private int _addStateId;
    private List<States> _addStates = new();
    private List<Cities> _addCities = new();

    // ─── Düzenle modal state ──────────────────────────────────────
    private data._Product.Warehouse? _editModel;
    private int _editCountryId;
    private int _editStateId;
    private List<States> _editStates = new();
    private List<Cities> _editCities = new();

    // ─── Sil modal state ──────────────────────────────────────────
    private data._Product.Warehouse? _deleteTarget;

    // ─── Toplu Sil state ──────────────────────────────────────────
    private readonly HashSet<Guid> _selectedIds = new();
    private bool _allSelected;
    private List<data._Product.Warehouse> _bulkDeletePreview = new();

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI: Mağaza adı getir (ID → Ad eşleme)
    // ══════════════════════════════════════════════════════════════

    private string GetStoreName(Guid storeId)
    {
        return _userStores.FirstOrDefault(s => s.Id == storeId)?.Name ?? "—";
    }

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;

        await Task.WhenAll(
            LoadDataAsync(_searchTerm),
            LoadCountriesAsync(),
            LoadUserStoresAsync()
        );
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _objRef ??= DotNetObjectReference.Create(this);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _writeLock.Dispose();
        _objRef?.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized) return;

        // Warehouse veya Store değişikliğini dinle
        if (entityName != ENTITY_NAME && entityName != "Store") return;

        await InvokeAsync(async () =>
        {
            if (entityName == "Store")
                await LoadUserStoresAsync();
            else
                await LoadDataAsync(_searchTerm);

            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    private async Task LoadDataAsync(string? search)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            // Arama varsa cache kullanma
            string cacheKey = string.IsNullOrWhiteSpace(search) ? CACHE_KEY : $"{CACHE_KEY}_{search}";
            if (!string.IsNullOrWhiteSpace(search))
                StateHub.ClearCache(cacheKey);

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);
                var q = db.Warehouse.AsNoTracking().AsQueryable();

                // Kullanıcı bazlı izolasyon: sadece kendi depolarını getir
                q = q.Where(x => x.UserId == use!.Id);

                // Soft delete filtresi
                q = q.Where(x => x.IsDeleted == null
                              || x.IsDeleted.IsDeletedStatu == null
                              || x.IsDeleted.IsDeletedStatu == false);

                return await q.OrderByDescending(x => x.CreatedAt).ToListAsync(token);
            }, token);

            if (token.IsCancellationRequested || result == null) return;

            // Bellek içi arama (AddressInfo alanlarında)
            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim();
                result = result.Where(x =>
                    Contains(x.AddressInfo?.MapTitle, s) ||
                    Contains(x.AddressInfo?.Country, s) ||
                    Contains(x.AddressInfo?.State, s) ||
                    Contains(x.AddressInfo?.City, s) ||
                    Contains(x.AddressInfo?.Address, s) ||
                    Contains(GetStoreName(x.StoreId), s)
                ).ToList();
            }

            _allItems = result;
            ApplyPaging(1);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadData", ex);
                await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void ApplyPaging(int page)
    {
        _totalPages = Math.Max(1, (int)Math.Ceiling(_allItems.Count / (double)PAGE_SIZE));
        _currentPage = Math.Clamp(page, 1, _totalPages);
        _pagedItems = _allItems.Skip((_currentPage - 1) * PAGE_SIZE).Take(PAGE_SIZE).ToList();
    }

    private void GoToPage(int page)
    {
        ApplyPaging(page);
        StateHasChanged();
    }

    // ── Kullanıcının mağazalarını yükle ──
    private async Task LoadUserStoresAsync()
    {
        try
        {
            var storesCacheKey = $"Warehouse_UserStores_{use?.Id}";
            _userStores = await StateHub.GetOrLoadAsync(storesCacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.Stores.AsNoTracking()
                    .Where(s => s.UserId == use!.Id
                             && (s.IsDeleted == null
                                 || s.IsDeleted.IsDeletedStatu == null
                                 || s.IsDeleted.IsDeletedStatu == false))
                    .OrderBy(s => s.Name)
                    .ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadUserStores", ex); }
    }

    // ── Ülke listesi ──
    private async Task LoadCountriesAsync()
    {
        try
        {
            _countries = await StateHub.GetOrLoadAsync("Countries_All", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.Country.AsNoTracking()
                    .OrderBy(c => c.name).ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadCountries", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // CASCADE SELECT (isAdd=true → Ekle modali, false → Düzenle)
    // ══════════════════════════════════════════════════════════════

    private async Task OnCountryChanged(ChangeEventArgs e, bool isAdd)
    {
        int.TryParse(e.Value?.ToString(), out var countryId);
        var name = _countries.FirstOrDefault(c => c.id == countryId)?.name;

        if (isAdd)
        {
            _addCountryId = countryId;
            _addStateId = 0;
            _addStates.Clear();
            _addCities.Clear();
            if (_addModel?.AddressInfo != null) { _addModel.AddressInfo.Country = name; _addModel.AddressInfo.State = null; _addModel.AddressInfo.City = null; }
        }
        else
        {
            _editCountryId = countryId;
            _editStateId = 0;
            _editStates.Clear();
            _editCities.Clear();
            if (_editModel?.AddressInfo != null) { _editModel.AddressInfo.Country = name; _editModel.AddressInfo.State = null; _editModel.AddressInfo.City = null; }
        }

        if (countryId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var states = await db.States.AsNoTracking()
                    .Where(s => s.country_id == countryId)
                    .OrderBy(s => s.name).ToListAsync(_cts.Token);

                if (isAdd) _addStates = states;
                else _editStates = states;
            }
            catch (Exception ex) { await LogError("OnCountryChanged", ex); }
        }
        StateHasChanged();
    }

    private async Task OnStateChanged(ChangeEventArgs e, bool isAdd)
    {
        int.TryParse(e.Value?.ToString(), out var stateId);
        var states = isAdd ? _addStates : _editStates;
        var name = states.FirstOrDefault(s => s.id == stateId)?.name;

        if (isAdd)
        {
            _addStateId = stateId;
            _addCities.Clear();
            if (_addModel?.AddressInfo != null) { _addModel.AddressInfo.State = name; _addModel.AddressInfo.City = null; }
        }
        else
        {
            _editStateId = stateId;
            _editCities.Clear();
            if (_editModel?.AddressInfo != null) { _editModel.AddressInfo.State = name; _editModel.AddressInfo.City = null; }
        }

        if (stateId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var cities = await db.Cities.AsNoTracking()
                    .Where(c => c.state_id == stateId)
                    .OrderBy(c => c.name).ToListAsync(_cts.Token);

                if (isAdd) _addCities = cities;
                else _editCities = cities;
            }
            catch (Exception ex) { await LogError("OnStateChanged", ex); }
        }
        StateHasChanged();
    }

    private void OnCityChanged(ChangeEventArgs e, bool isAdd)
    {
        var city = e.Value?.ToString();
        if (isAdd) { if (_addModel?.AddressInfo != null) _addModel.AddressInfo.City = city; }
        else { if (_editModel?.AddressInfo != null) _editModel.AddressInfo.City = city; }
    }

    // ── Mağaza Seçimi (Ekle / Düzenle) ──
    private void OnAddStoreChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var storeId) && _addModel != null)
            _addModel.StoreId = storeId;
    }

    private void OnEditStoreChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var storeId) && _editModel != null)
            _editModel.StoreId = storeId;
    }

    // ══════════════════════════════════════════════════════════════
    // ARAMA
    // ══════════════════════════════════════════════════════════════

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadDataAsync(_searchTerm);
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await LoadDataAsync(null);
    }

    // ══════════════════════════════════════════════════════════════
    // MODAL AÇMA
    // ══════════════════════════════════════════════════════════════

    private async Task OpenAddModal()
    {
        _addModel = new data._Product.Warehouse
        {
            Id = Guid.Empty,
            IsDefault = false,
            IsActive = true,
            AddressInfo = new AddressInfo()
        };
        _addCountryId = 0;
        _addStateId = 0;
        _addStates.Clear();
        _addCities.Clear();
        _addMapInitialized = false;

        await ShowModal("AddModal");

        // Haritayı modal açıldıktan sonra başlat
        await InitMapAsync("warehouse_add_map", "btnWarehouseAddLocation",
            null, null, true);
    }

    private async Task OpenEditModal(data._Product.Warehouse item)
    {
        _editModel = new data._Product.Warehouse
        {
            Id = item.Id,
            UserId = item.UserId,
            StoreId = item.StoreId,
            IsDefault = item.IsDefault,
            IsActive = item.IsActive,
            CreatedAt = item.CreatedAt,
            AddressInfo = new AddressInfo
            {
                MapTitle = item.AddressInfo?.MapTitle,
                Country = item.AddressInfo?.Country,
                State = item.AddressInfo?.State,
                City = item.AddressInfo?.City,
                ZipCode = item.AddressInfo?.ZipCode,
                Address = item.AddressInfo?.Address,
                Latitude = item.AddressInfo?.Latitude,
                Longitude = item.AddressInfo?.Longitude,
                GoogleMyBusinessAccountLink = item.AddressInfo?.GoogleMyBusinessAccountLink
            }
        };

        _editCountryId = 0;
        _editStateId = 0;
        _editStates.Clear();
        _editCities.Clear();
        _editMapInitialized = false;

        // Cascade preload (ülke/il/şehir seçimlerini geri yükle)
        if (!string.IsNullOrWhiteSpace(_editModel.AddressInfo?.Country))
        {
            var country = _countries.FirstOrDefault(c =>
                string.Equals(c.name, _editModel.AddressInfo.Country, StringComparison.OrdinalIgnoreCase));

            if (country != null)
            {
                _editCountryId = country.id;
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                    _editStates = await db.States.AsNoTracking()
                        .Where(s => s.country_id == _editCountryId)
                        .OrderBy(s => s.name).ToListAsync(_cts.Token);

                    if (!string.IsNullOrWhiteSpace(_editModel.AddressInfo.State))
                    {
                        var state = _editStates.FirstOrDefault(s =>
                            string.Equals(s.name, _editModel.AddressInfo.State, StringComparison.OrdinalIgnoreCase));

                        if (state != null)
                        {
                            _editStateId = state.id;
                            _editCities = await db.Cities.AsNoTracking()
                                .Where(c => c.state_id == _editStateId)
                                .OrderBy(c => c.name).ToListAsync(_cts.Token);
                        }
                    }
                }
                catch (Exception ex) { await LogError("OpenEditModal_Preload", ex); }
            }
        }

        // Cascade preload verilerini UI'a yansıt
        StateHasChanged();

        await ShowModal("EditModal");

        // Haritayı modal açıldıktan sonra başlat (mevcut koordinatlarla)
        await InitMapAsync("warehouse_edit_map", "btnWarehouseEditLocation",
            _editModel.AddressInfo?.Latitude, _editModel.AddressInfo?.Longitude, false);
    }

