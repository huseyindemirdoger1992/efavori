@* ============================================================
   Warehouse.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub — anlık broadcast, debounce, RAM cache
   ✅ GlobalSecurityProvider — AddressInfo alanları şifreli
   ✅ TakeLogs — tüm CRUD aksiyonları loglanır
   ✅ Ayrı Ekle / Düzenle / Sil modalleri
   ✅ Seçilenleri Sil → önce onay modali (sayı + liste)
   ✅ 5'li sayfalama
   ✅ Kullanıcı bazlı veri izolasyonu (UserId filtre)
   ✅ Mağaza bazlı StoreId seçimi (kullanıcının mağazaları)
   ✅ Cascade adres seçimi (Ülke/İl/Şehir)
   ✅ Leaflet harita + konum bulma (JS interop)
   ✅ Basit, performanslı, kötü sunucuda bile binlerce kullanıcıya cevap
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using data._Product
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    // Bu alanı kesinlikle SİLME. Kullanılsın veya kullanılmasın, global state'den dil bilgisini almak ve yönlendirme yapmak için gereklidir.
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    // NavigationManager.NavigateTo($@"/{use?.Language.ToLower()}/Admin/Warehouse/List/", true);
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",      "Ana Sayfa",        "/"),
        ("fa fa-cubes",     "Depo Yönetimi",    "javascript:void(0)"),
        ("fa fa-list-alt",  PAGE_TITLE,         "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    <button class="btn btn-light btn-sm" @onclick="OpenAddModal" disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Depo</span>
    </button>

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light">@_selectedIds.Count seçili</span>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Seçimi Temizle
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-danger btn-sm border-0"
                @onclick="OpenBulkDeleteModal"
                disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent border-secondary text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light border-secondary"
           placeholder="Ara (ülke, il, şehir, adres...)"
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_allItems.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Henüz depo kaydı bulunmuyor.</p>
    </div>
}
else
{
    @* ─── Masaüstü Tablo ─── *@
    <div class="d-none d-md-block table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2rem;">
                        <input type="checkbox" class="form-check-input"
                               checked="@_allSelected"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th style="width:2.5rem;">#</th>
                    <th>Depo</th>
                    <th>Mağaza</th>
                    <th>Ülke</th>
                    <th>İl</th>
                    <th>Şehir</th>
                    <th>Kontroller</th>
                    <th>Tarih</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>
                        <td class="text-secondary small">@(rowNo++)</td>
                        <td><div class="small">@(item.AddressInfo?.MapTitle ?? "—")</div></td>
                        <td>
                            <div class="fw-semibold small">@GetStoreName(item.StoreId)</div>
                        </td>
                        <td><div class="small">@(item.AddressInfo?.Country ?? "—")</div></td>
                        <td><div class="small">@(item.AddressInfo?.State ?? "—")</div></td>
                        <td><div class="small">@(item.AddressInfo?.City ?? "—")</div></td>
                        <td>
                            <span class="me-2" title="Varsayılan Depo">
                                <i class="fa @(item.IsDefault ? "fa-star text-warning" : "fa-star-o text-secondary")"></i>
                            </span>
                            <span title="Aktif">
                                <i class="fa @(item.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary")"></i>
                            </span>
                        </td>
                        <td class="text-nowrap">
                            <div class="small">@(item.CreatedAt?.ToString("dd.MM.yyyy") ?? "—") | @(item.CreatedAt?.ToString("HH:mm") ?? "")</div>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Mobil Kart Görünümü ─── *@
    <div class="d-md-none">
        @{
            int cardNo = (_currentPage - 1) * PAGE_SIZE + 1;
        }
        @foreach (var item in _pagedItems)
        {
            var isSelected = _selectedIds.Contains(item.Id);
            <div class="card bg-dark border-secondary mb-2 @(isSelected ? "border-info" : "")">
                <div class="card-body p-2">
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                            <span class="text-secondary small">#@(cardNo++)</span>
                        </div>
                        <div class="d-flex gap-1">
                            <button class="btn btn-outline-warning btn-sm" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div class="small text-white-50">
                            <i class="fa fa-building me-1"></i>@GetStoreName(item.StoreId)
                        </div>
                        <div class="small text-light mt-1">
                            <i class="fa fa-map-marker me-1"></i>
                            @(item.AddressInfo?.Country ?? "—") / @(item.AddressInfo?.State ?? "—") / @(item.AddressInfo?.City ?? "—")
                        </div>
                        <div class="d-flex align-items-center gap-3 mt-1">
                            <span class="small" title="Varsayılan Depo">
                                <i class="fa @(item.IsDefault ? "fa-star text-warning" : "fa-star-o text-secondary") me-1"></i>
                                @(item.IsDefault ? "Varsayılan" : "—")
                            </span>
                            <span class="small" title="Aktif">
                                <i class="fa @(item.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-secondary") me-1"></i>
                                @(item.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </div>
                        <div class="small text-secondary mt-1">
                            <i class="fa fa-calendar me-1"></i>@(item.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_allItems.Count kayıt
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                    </li>

                    @for (int p = 1; p <= _totalPages; p++)
                    {
                        var pg = p;
                        <li class="page-item @(_currentPage == pg ? "active" : "")">
                            <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                    @onclick="() => GoToPage(pg)">
                                @pg
                            </button>
                        </li>
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Ekle
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="AddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-plus me-1"></i>Yeni Depo Ekle
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Kapat" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_addModel != null)
                {
                    <div class="row g-3">
                        @* ─── Mağaza Seçimi ─── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-building me-1"></i>Mağaza</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addModel.StoreId"
                                    @onchange="e => OnAddStoreChanged(e)">
                                <option value="@Guid.Empty">Mağaza Seçiniz</option>
                                @foreach (var s in _userStores)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>

                        @* ─── Harita Başlığı ─── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Depo Adı / Harita Başlığı</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Örn: Merkez Depo, Şube Depo..."
                                   @bind="_addModel.AddressInfo!.MapTitle" />
                        </div>

                        @* ─── Kontroller ─── *@
                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="add_chkDefault" @bind="_addModel.IsDefault" />
                                <label class="form-check-label text-white-50" for="add_chkDefault">
                                    <i class="fa fa-star me-1"></i>Varsayılan Depo
                                </label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="add_chkActive" @bind="_addModel.IsActive" />
                                <label class="form-check-label text-white-50" for="add_chkActive">
                                    <i class="fa fa-toggle-on me-1"></i>Aktif
                                </label>
                            </div>
                        </div>

                        @* ─── Adres: Ülke / İl / Şehir ─── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addCountryId"
                                    @onchange="e => OnCountryChanged(e, true)">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addStateId"
                                    @onchange="e => OnStateChanged(e, true)"
                                    disabled="@(!_addStates.Any())">
                                <option value="0">@(_addStates.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _addStates)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addModel.AddressInfo!.City"
                                    @onchange="e => OnCityChanged(e, true)"
                                    disabled="@(!_addCities.Any())">
                                <option value="">@(_addCities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _addCities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        @* ─── Posta Kodu ─── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-envelope me-1"></i>Posta Kodu</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Posta Kodu"
                                   @bind="_addModel.AddressInfo!.ZipCode" />
                        </div>

                        @* ─── Google My Business ─── *@
                        <div class="col-12 col-md-8">
                            <label class="form-label text-white-50 small"><i class="fa fa-google me-1"></i>Google My Business Linki</label>
                            <input type="url"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="https://business.google.com/..."
                                   @bind="_addModel.AddressInfo!.GoogleMyBusinessAccountLink" />
                        </div>

                        @* ─── Açık Adres ─── *@
                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-map me-1"></i>Açık Adres</label>
                            <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                                      rows="2" placeholder="Detaylı adres bilgisi..."
                                      @bind="_addModel.AddressInfo!.Address"></textarea>
                        </div>

                        @* ─── Harita ─── *@
                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Konum</label>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="small text-white-50">
                                    Enlem: <span class="text-info">@(_addModel.AddressInfo?.Latitude?.ToString("F6") ?? "—")</span>
                                    &nbsp;|&nbsp;
                                    Boylam: <span class="text-info">@(_addModel.AddressInfo?.Longitude?.ToString("F6") ?? "—")</span>
                                </span>
                                <button type="button" class="btn btn-outline-info btn-sm ms-auto" id="btnWarehouseAddLocation">
                                    <i class="fa fa-crosshairs me-1"></i>Konumumu Bul
                                </button>
                            </div>
                            <div id="warehouse_add_map" style="height:250px;border-radius:0.5rem;border:1px solid var(--bs-secondary);"></div>
                        </div>

                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="AddAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-plus me-1"></i><span>Depo Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Düzenle
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(255,215,0,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-pencil me-1"></i>Depo Düzenle
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Kapat" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_editModel != null)
                {
                    <div class="row g-3">
                        @* ─── Mağaza Seçimi ─── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-building me-1"></i>Mağaza</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editModel.StoreId"
                                    @onchange="e => OnEditStoreChanged(e)">
                                <option value="@Guid.Empty">Mağaza Seçiniz</option>
                                @foreach (var s in _userStores)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>

                        @* ─── Harita Başlığı ─── *@
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Depo Adı / Harita Başlığı</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Örn: Merkez Depo, Şube Depo..."
                                   @bind="_editModel.AddressInfo!.MapTitle" />
                        </div>

                        @* ─── Kontroller ─── *@
                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="edit_chkDefault" @bind="_editModel.IsDefault" />
                                <label class="form-check-label text-white-50" for="edit_chkDefault">
                                    <i class="fa fa-star me-1"></i>Varsayılan Depo
                                </label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="edit_chkActive" @bind="_editModel.IsActive" />
                                <label class="form-check-label text-white-50" for="edit_chkActive">
                                    <i class="fa fa-toggle-on me-1"></i>Aktif
                                </label>
                            </div>
                        </div>

                        @* ─── Adres: Ülke / İl / Şehir ─── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editCountryId"
                                    @onchange="e => OnCountryChanged(e, false)">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editStateId"
                                    @onchange="e => OnStateChanged(e, false)"
                                    disabled="@(!_editStates.Any())">
                                <option value="0">@(_editStates.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _editStates)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editModel.AddressInfo!.City"
                                    @onchange="e => OnCityChanged(e, false)"
                                    disabled="@(!_editCities.Any())">
                                <option value="">@(_editCities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _editCities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        @* ─── Posta Kodu ─── *@
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-envelope me-1"></i>Posta Kodu</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Posta Kodu"
                                   @bind="_editModel.AddressInfo!.ZipCode" />
                        </div>

                        @* ─── Google My Business ─── *@
                        <div class="col-12 col-md-8">
                            <label class="form-label text-white-50 small"><i class="fa fa-google me-1"></i>Google My Business Linki</label>
                            <input type="url"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="https://business.google.com/..."
                                   @bind="_editModel.AddressInfo!.GoogleMyBusinessAccountLink" />
                        </div>

                        @* ─── Açık Adres ─── *@
                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-map me-1"></i>Açık Adres</label>
                            <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                                      rows="2" placeholder="Detaylı adres bilgisi..."
                                      @bind="_editModel.AddressInfo!.Address"></textarea>
                        </div>

                        @* ─── Harita ─── *@
                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Konum</label>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="small text-white-50">
                                    Enlem: <span class="text-info">@(_editModel.AddressInfo?.Latitude?.ToString("F6") ?? "—")</span>
                                    &nbsp;|&nbsp;
                                    Boylam: <span class="text-info">@(_editModel.AddressInfo?.Longitude?.ToString("F6") ?? "—")</span>
                                </span>
                                <button type="button" class="btn btn-outline-info btn-sm ms-auto" id="btnWarehouseEditLocation">
                                    <i class="fa fa-crosshairs me-1"></i>Konumumu Bul
                                </button>
                            </div>
                            <div id="warehouse_edit_map" style="height:250px;border-radius:0.5rem;border:1px solid var(--bs-secondary);"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-warning btn-sm"
                        @onclick="UpdateAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-save me-1"></i><span>Değişiklikleri Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Tekli Sil
