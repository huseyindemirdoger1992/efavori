    // ══════════════════════════════════════════════════════════════
    // CRUD — Ekle
    // ══════════════════════════════════════════════════════════════

    private async Task AddAsync()
    {
        if (_isProcessing || _addModel == null) return;

        // Validasyon
        if (_addModel.StoreId == Guid.Empty)
        {
            await Notify("warning", "Uyarı", "Lütfen bir mağaza seçiniz.");
            return;
        }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            _addModel.Id = Guid.NewGuid();
            _addModel.UserId = use!.Id;
            _addModel.CreatedAt = DateTime.UtcNow;

            _addModel.IsDeleted = new IsDeleted
            {
                IsDeletedStatu = false,
                DeletedAtDate = null
            };

            // Eğer varsayılan olarak işaretlendiyse, aynı mağazadaki diğer depoları varsayılandan çıkar
            if (_addModel.IsDefault)
            {
                await ClearDefaultForStoreAsync(_addModel.StoreId, Guid.Empty);
            }

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.Warehouse.Add(_addModel);
            await db.SaveChangesAsync(_cts.Token);

            await HideModal("AddModal");
            _addModel = null;
            _isProcessing = false;

            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Add");
            await Notify("success", "Başarılı", "Depo eklendi.");
        }
        catch (Exception ex)
        {
            await LogError("AddAsync", ex);
            await Notify("danger", "Hata", "Kayıt sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Güncelle
    // ══════════════════════════════════════════════════════════════

    private async Task UpdateAsync()
    {
        if (_isProcessing || _editModel == null) return;

        // Validasyon
        if (_editModel.StoreId == Guid.Empty)
        {
            await Notify("warning", "Uyarı", "Lütfen bir mağaza seçiniz.");
            return;
        }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.Warehouse.FindAsync(new object[] { _editModel.Id }, _cts.Token);

            if (existing == null)
            {
                _isProcessing = false;
                await Notify("warning", "Uyarı", "Kayıt artık mevcut değil.");
                return;
            }

            // Alanları güncelle
            existing.StoreId = _editModel.StoreId;
            existing.IsDefault = _editModel.IsDefault;
            existing.IsActive = _editModel.IsActive;

            existing.AddressInfo ??= new AddressInfo();
            existing.AddressInfo.MapTitle = _editModel.AddressInfo?.MapTitle;
            existing.AddressInfo.Country = _editModel.AddressInfo?.Country;
            existing.AddressInfo.State = _editModel.AddressInfo?.State;
            existing.AddressInfo.City = _editModel.AddressInfo?.City;
            existing.AddressInfo.ZipCode = _editModel.AddressInfo?.ZipCode;
            existing.AddressInfo.Address = _editModel.AddressInfo?.Address;
            existing.AddressInfo.Latitude = _editModel.AddressInfo?.Latitude;
            existing.AddressInfo.Longitude = _editModel.AddressInfo?.Longitude;
            existing.AddressInfo.GoogleMyBusinessAccountLink = _editModel.AddressInfo?.GoogleMyBusinessAccountLink;

            // Eğer varsayılan olarak işaretlendiyse, aynı mağazadaki diğer depoları varsayılandan çıkar
            if (_editModel.IsDefault)
            {
                await ClearDefaultForStoreAsync(_editModel.StoreId, _editModel.Id);
            }

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("EditModal");
            _editModel = null;
            _isProcessing = false;

            StateHub.ClearCache(CACHE_KEY);
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Update");
            await Notify("success", "Başarılı", "Depo güncellendi.");
        }
        catch (Exception ex)
        {
            await LogError("UpdateAsync", ex);
            await Notify("danger", "Hata", "Güncelleme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

