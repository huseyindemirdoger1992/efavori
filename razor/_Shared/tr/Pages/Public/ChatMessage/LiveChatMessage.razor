                        style="width: 62px; height: 62px;"
                        @onclick="() => HangUp()"
                        title="Aramayı Sonlandır">
                    <i class="fa fa-phone" style="transform: rotate(135deg); font-size: 1.5rem;"></i>
                </button>
            </div>
        </div>
    </div>
}

