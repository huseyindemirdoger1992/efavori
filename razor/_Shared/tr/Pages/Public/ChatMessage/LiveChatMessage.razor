        if (use != null) await StateHub.UnregisterOnlineUser(use.Id);

        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    // ═══════════════════════════════════════════
    //  DATA LOADING
    // ═══════════════════════════════════════════

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized) return;
        if (entityName == "ChatMessages" || entityName == "ChatMessage")
        {
            await InvokeAsync(async () =>
            {
                StateHub.ClearCache($"ChatManager_Friends_{use?.Id}");
                await LoadFriends();
                if (_selectedFriend != null && _selectedConversationId != null)
                    await RefreshMessages(_selectedConversationId.Value);
                _shouldScrollToBottom = true;
                StateHasChanged();
            });
        }
    }

    private async Task HandleOnlineUsersChanged()
    {
        if (_disposed || !_isInitialized) return;
        await InvokeAsync(() => { _onlineUsers = StateHub.GetOnlineUsers(); StateHasChanged(); return Task.CompletedTask; });
    }

    private async Task LoadFriends()
    {
        if (use == null) return;
        try
        {
            _isLoading = true;
            StateHasChanged();

            var result = await StateHub.GetOrLoadAsync($"ChatManager_Friends_{use.Id}", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

                // Kabul edilmiş arkadaşlıkları çek
                var friendships = await db.Friendships.AsNoTracking()
                    .Where(f => (f.RequestorUserId == use.Id || f.ReceiverUserId == use.Id)
                                && f.Status == FriendshipStatus.Accepted
                                && f.IsDeleted.IsDeletedStatu != true)
                    .ToListAsync(_cts.Token);

                var friendIds = friendships
                    .Select(f => f.RequestorUserId == use.Id ? f.ReceiverUserId : f.RequestorUserId)
                    .Distinct().ToList();

                // Profil bilgileri — kendi profilimizi de dahil et
                var allUserIds = friendIds.Append(use.Id).Distinct().ToList();
                var profiles = await db.UserProfiles.AsNoTracking()
                    .Where(p => allUserIds.Contains(p.UserId))
                    .ToListAsync(_cts.Token);

                // Avatar medyaları
                var avatarMediaIds = profiles.Where(p => p.AvatarMediaId.HasValue)
                    .Select(p => p.AvatarMediaId!.Value).Distinct().ToList();
                var mediaList = avatarMediaIds.Count > 0
                    ? await db.Media.AsNoTracking().Where(m => avatarMediaIds.Contains(m.Id)).ToListAsync(_cts.Token)
                    : new List<data._Galleries.Media>();

                // Her arkadaş için son mesaj ve okunmamış sayısı (Conversation bazlı)
                var lastMsgs = new Dictionary<Guid, ChatMessages>();
                var unreadCounts = new Dictionary<Guid, int>();

                foreach (var fid in friendIds)
                {
                    // Bu iki kişi arasındaki Direct conversation'ı bul
                    var conv = await db.ChatConversations.AsNoTracking()
                        .Where(c => c.ConversationType == ConversationType.Direct
                                 && c.IsActive
                                 && ((c.DirectUserAId == use.Id && c.DirectUserBId == fid)
                                  || (c.DirectUserAId == fid && c.DirectUserBId == use.Id)))
                        .FirstOrDefaultAsync(_cts.Token);

                    if (conv == null) continue;

                    // Son mesaj
                    var last = await db.ChatMessages.AsNoTracking()
                        .Where(m => m.ConversationId == conv.Id && m.Status != ChatMessageStatus.Deleted)
                        .OrderByDescending(m => m.CreatedAtUtc)
                        .FirstOrDefaultAsync(_cts.Token);

                    if (last != null) lastMsgs[fid] = last;

                    // Okunmamış sayısı — participant'ın LastReadMessageId'den sonra gelen mesajlar
                    var participant = await db.ChatParticipants.AsNoTracking()
                        .Where(p => p.ConversationId == conv.Id && p.UserId == use.Id && p.LeftAtUtc == null)
                        .FirstOrDefaultAsync(_cts.Token);

                    if (participant != null)
                    {
                        unreadCounts[fid] = participant.UnreadCount;
                    }
                }

                return new { FriendIds = friendIds, Profiles = profiles, MediaList = mediaList, LastMsgs = lastMsgs, UnreadCounts = unreadCounts };
            }, _cts.Token);

            if (result != null)
            {
                _friendIds = result.FriendIds;
                _profileCache = result.Profiles.ToDictionary(p => p.UserId);
                _mediaCache = result.MediaList.ToDictionary(m => m.Id);
                _lastMessages = result.LastMsgs;
                _unreadCounts = result.UnreadCounts;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"[{PAGE}] LoadFriends hata: {ex.Message}"); }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task SelectFriend(Guid friendId)
    {
        _selectedFriend = friendId;
        _selectedConversationId = null;
        _messages.Clear();
        StateHasChanged();
        await LoadMessages(friendId);
    }

    private async Task LoadMessages(Guid friendId)
    {
        if (use == null) return;
        try
        {
            _isMessagesLoading = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Conversation bul veya oluştur
            var conv = await db.ChatConversations
                .Where(c => c.ConversationType == ConversationType.Direct
                         && c.IsActive
                         && ((c.DirectUserAId == use.Id && c.DirectUserBId == friendId)
                          || (c.DirectUserAId == friendId && c.DirectUserBId == use.Id)))
                .FirstOrDefaultAsync(_cts.Token);

            if (conv == null)
            {
                // Henüz sohbet yok — ilk mesajda oluşturulacak
                _selectedConversationId = null;
                _messages.Clear();
                return;
            }

            _selectedConversationId = conv.Id;

            // Participant'ın ClearedBeforeUtc'den sonraki mesajları çek
            var participant = await db.ChatParticipants.AsNoTracking()
                .Where(p => p.ConversationId == conv.Id && p.UserId == use.Id && p.LeftAtUtc == null)
                .FirstOrDefaultAsync(_cts.Token);

            var clearedBefore = participant?.ClearedBeforeUtc;

            var query = db.ChatMessages.AsNoTracking()
                .Where(m => m.ConversationId == conv.Id);

            if (clearedBefore.HasValue)
                query = query.Where(m => m.CreatedAtUtc > clearedBefore.Value);

            _messages = await query.OrderBy(m => m.CreatedAtUtc).ToListAsync(_cts.Token);

            // Okundu olarak işaretle
            if (participant != null && _messages.Any())
            {
                var lastMsgId = _messages.Last().Id;
                if (participant.LastReadMessageId != lastMsgId)
                {
                    await db.ChatParticipants
                        .Where(p => p.Id == participant.Id)
                        .ExecuteUpdateAsync(s => s
                            .SetProperty(p => p.LastReadMessageId, lastMsgId)
                            .SetProperty(p => p.LastReadAtUtc, DateTime.UtcNow)
                            .SetProperty(p => p.UnreadCount, 0), _cts.Token);

                    StateHub.ClearCache($"ChatManager_Friends_{use.Id}");
                }
            }

            _unreadCounts[friendId] = 0;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"[{PAGE}] LoadMessages hata: {ex.Message}"); }
        finally
        {
            _isMessagesLoading = false;
            _shouldScrollToBottom = true;
            _shouldFocusInput = true;
            StateHasChanged();
        }
    }

    private async Task RefreshMessages(Guid conversationId)
    {
        if (use == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _messages = await db.ChatMessages.AsNoTracking()
                .Where(m => m.ConversationId == conversationId)
                .OrderBy(m => m.CreatedAtUtc)
                .ToListAsync(_cts.Token);

            if (_selectedFriend.HasValue)
                _unreadCounts[_selectedFriend.Value] = 0;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"[{PAGE}] RefreshMessages hata: {ex.Message}"); }
    }

    private async Task SendMessage()
    {
        if (use == null || _selectedFriend == null) return;
        if (string.IsNullOrWhiteSpace(_newMessage) || _isSending) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isSending = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Conversation yoksa oluştur
            if (_selectedConversationId == null)
            {
                var conv = new ChatConversations
                {
                    ConversationType = ConversationType.Direct,
                    DirectUserAId = use.Id,
                    DirectUserBId = _selectedFriend.Value,
                    IsActive = true,
                    ParticipantCount = 2
                };
                db.ChatConversations.Add(conv);

                // İki katılımcı ekle
                db.ChatParticipants.Add(new ChatParticipants { ConversationId = conv.Id, UserId = use.Id });
                db.ChatParticipants.Add(new ChatParticipants { ConversationId = conv.Id, UserId = _selectedFriend.Value });

                await db.SaveChangesAsync(_cts.Token);
                _selectedConversationId = conv.Id;
            }

            var message = new ChatMessages
            {
                ConversationId = _selectedConversationId.Value,
                SenderUserId = use.Id,
                MessageType = ChatMessageType.Text,
                Content = GlobalSecurityProvider.Encrypt(_newMessage.Trim()),
                Status = ChatMessageStatus.Sent
            };

            db.ChatMessages.Add(message);

            // Conversation son mesaj bilgilerini güncelle
            await db.ChatConversations
                .Where(c => c.Id == _selectedConversationId.Value)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(c => c.LastMessageAtUtc, DateTime.UtcNow)
                    .SetProperty(c => c.LastMessageId, message.Id)
                    .SetProperty(c => c.LastMessageSenderUserId, use.Id)
                    .SetProperty(c => c.MessageCount, c => c.MessageCount + 1), _cts.Token);

            // Karşı tarafın UnreadCount'unu artır
            await db.ChatParticipants
                .Where(p => p.ConversationId == _selectedConversationId.Value
                          && p.UserId == _selectedFriend.Value
                          && p.LeftAtUtc == null)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(p => p.UnreadCount, p => p.UnreadCount + 1), _cts.Token);

            await db.SaveChangesAsync(_cts.Token);

            _newMessage = string.Empty;
            _emojiPickerOpen = false;
            _messages.Add(message);

            StateHub.ClearCache($"ChatManager_Friends_{use.Id}");
            StateHub.ClearCache($"ChatManager_Friends_{_selectedFriend.Value}");
            await StateHub.NotifyDataChanged("ChatMessages");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"[{PAGE}] SendMessage hata: {ex.Message}"); }
        finally
        {
            _isSending = false;
            _writeLock.Release();
            _shouldScrollToBottom = true;
            _shouldFocusInput = true;
            StateHasChanged();
        }
    }

    private async Task DeleteMessage(ChatMessages msg)
    {
        if (use == null || msg.SenderUserId != use.Id) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            await db.ChatMessages.Where(m => m.Id == msg.Id)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(m => m.Status, ChatMessageStatus.Deleted)
                    .SetProperty(m => m.Content, (string?)null), _cts.Token);

            var local = _messages.FirstOrDefault(m => m.Id == msg.Id);
            if (local != null) { local.Status = ChatMessageStatus.Deleted; local.Content = null; }

            StateHub.ClearCache($"ChatManager_Friends_{use.Id}");
            StateHub.ClearCache($"ChatManager_Friends_{_selectedFriend}");
            await StateHub.NotifyDataChanged("ChatMessages");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"[{PAGE}] DeleteMessage hata: {ex.Message}"); }
        finally { _writeLock.Release(); StateHasChanged(); }
    }

    // ═══════════════════════════════════════════
    //  UI HELPERS
    // ═══════════════════════════════════════════

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendMessage();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void ToggleEmojiPicker() { _emojiPickerOpen = !_emojiPickerOpen; }

    private void InsertEmoji(string emoji)
    {
        if (string.IsNullOrEmpty(emoji)) return;
        if ((_newMessage?.Length ?? 0) + emoji.Length > 2000) return;
        _newMessage = (_newMessage ?? "") + emoji;
        _shouldFocusInput = true;
        StateHasChanged();
    }

    private string FormatTime(DateTime dt)
    {
        var now = DateTime.UtcNow;
        if (dt.Date == now.Date) return dt.ToString("HH:mm");
        if (dt.Date == now.Date.AddDays(-1)) return "Dün";
        if ((now - dt).TotalDays < 7) return dt.DayOfWeek switch
        {
            DayOfWeek.Monday => "Pzt",
            DayOfWeek.Tuesday => "Sal",
            DayOfWeek.Wednesday => "Çrş",
            DayOfWeek.Thursday => "Per",
            DayOfWeek.Friday => "Cum",
            DayOfWeek.Saturday => "Cmt",
            DayOfWeek.Sunday => "Paz",
            _ => dt.ToString("dd/MM")
        };
        return dt.ToString("dd/MM/yy");
    }

    private string FormatDate(DateTime dt)
    {
        var now = DateTime.UtcNow;
        if (dt.Date == now.Date) return "Bugün";
        if (dt.Date == now.Date.AddDays(-1)) return "Dün";
        return dt.ToString("dd MMMM yyyy");
    }

    // ═══════════════════════════════════════════
    //  CALL MESSAGE PARSING
    // ═══════════════════════════════════════════

    private CallMessageInfo? ParseCallMessage(string? decryptedContent)
    {
        if (string.IsNullOrEmpty(decryptedContent) || !decryptedContent.StartsWith(CALL_MSG_PREFIX)) return null;
        try
        {
            var body = decryptedContent.Substring(CALL_MSG_PREFIX.Length);
            var parts = body.Split('|');
            if (parts.Length < 2) return null;
            int dur = 0;
            if (parts.Length >= 3) int.TryParse(parts[2], out dur);
            return new CallMessageInfo { IsVideo = parts[0] == "video", Status = parts[1], DurationSec = dur };
        }
        catch { return null; }
    }

    private string BuildCallStatusText(CallMessageInfo info, bool isMine)
    {
        var t = info.IsVideo ? "Görüntülü arama" : "Sesli arama";
        return info.Status switch
        {
            "completed" => $"{t} • {FormatDurationShort(info.DurationSec)}",
            "missed" => isMine ? $"{t} cevapsız" : $"Cevapsız {t.ToLower()}",
            "rejected" => $"{t} reddedildi",
            "busy" => $"{t} • Meşgul",
            "canceled" => isMine ? $"{t} iptal edildi" : $"Cevapsız {t.ToLower()}",
            _ => t
        };
    }

    private string FormatDurationShort(int s)
    {
        if (s <= 0) return "0:00";
        var t = TimeSpan.FromSeconds(s);
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes}:{t.Seconds:00}";
    }

    private sealed class CallMessageInfo { public bool IsVideo; public string Status = ""; public int DurationSec; }

    // ═══════════════════════════════════════════
    //  WEBRTC CALLS (aynı sinyal yapısı korundu)
    // ═══════════════════════════════════════════

    private async Task EnsureWebRtcScriptAsync()
    {
        if (_webRtcScriptInjected) return;
        const string script = @"
(function(){
if(window.liveChatRtc)return;
var pc=null,localStream=null,dotNetRef=null,pendingRemoteIce=[],isCaller=false,isVideo=false;
var rtcConfig={iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun1.l.google.com:19302'}]};
function attachStream(id,s){var e=document.getElementById(id);if(e&&s)try{e.srcObject=s}catch(x){}}
function detachStream(id){var e=document.getElementById(id);if(e)try{e.srcObject=null}catch(x){}}
function safeSend(t,p){if(dotNetRef)try{dotNetRef.invokeMethodAsync('JsSignal',t,p||'')}catch(x){}}
async function getMedia(v){return await navigator.mediaDevices.getUserMedia({audio:true,video:v})}
function createPc(){if(pc)try{pc.close()}catch(x){}pc=null;pc=new RTCPeerConnection(rtcConfig);
pc.onicecandidate=function(ev){if(ev.candidate)safeSend('ice',JSON.stringify(ev.candidate))};
pc.ontrack=function(ev){var s=ev.streams&&ev.streams[0]?ev.streams[0]:new MediaStream();if(!ev.streams||!ev.streams[0])s.addTrack(ev.track);attachStream('remoteVideo',s);safeSend('connected','')};
pc.onconnectionstatechange=function(){if(!pc)return;var st=pc.connectionState;if(st==='failed'||st==='disconnected'||st==='closed')safeSend('peer-gone',st)};
if(localStream)localStream.getTracks().forEach(function(t){pc.addTrack(t,localStream)})}
async function flushIce(){while(pendingRemoteIce.length&&pc&&pc.remoteDescription){var c=pendingRemoteIce.shift();try{await pc.addIceCandidate(c)}catch(x){}}}
window.liveChatRtc={
setRef:function(r){dotNetRef=r},
startCaller:async function(v){isCaller=true;isVideo=!!v;try{localStream=await getMedia(isVideo)}catch(e){safeSend('media-error',String(e&&e.message?e.message:e));return}attachStream('localVideo',localStream);createPc();var o=await pc.createOffer({offerToReceiveAudio:true,offerToReceiveVideo:isVideo});await pc.setLocalDescription(o);safeSend('offer',JSON.stringify(o))},
acceptCallee:async function(v,oj){isCaller=false;isVideo=!!v;try{localStream=await getMedia(isVideo)}catch(e){safeSend('media-error',String(e&&e.message?e.message:e));return}attachStream('localVideo',localStream);createPc();await pc.setRemoteDescription(new RTCSessionDescription(JSON.parse(oj)));await flushIce();var a=await pc.createAnswer();await pc.setLocalDescription(a);safeSend('answer',JSON.stringify(a))},
applyAnswer:async function(aj){if(!pc)return;try{await pc.setRemoteDescription(new RTCSessionDescription(JSON.parse(aj)));await flushIce()}catch(x){}},
addRemoteIce:async function(ij){try{var c=new RTCIceCandidate(JSON.parse(ij));if(pc&&pc.remoteDescription)await pc.addIceCandidate(c);else pendingRemoteIce.push(c)}catch(x){}},
setMicMuted:function(m){if(localStream)localStream.getAudioTracks().forEach(function(t){t.enabled=!m})},
setCamMuted:function(m){if(localStream)localStream.getVideoTracks().forEach(function(t){t.enabled=!m})},
cleanup:function(){try{if(pc){pc.onicecandidate=null;pc.ontrack=null;pc.onconnectionstatechange=null}}catch(x){}try{if(localStream)localStream.getTracks().forEach(function(t){try{t.stop()}catch(x){}})}catch(x){}localStream=null;try{if(pc)pc.close()}catch(x){}pc=null;pendingRemoteIce=[];detachStream('remoteVideo');detachStream('localVideo')}
}})();";
        await JS.InvokeVoidAsync("eval", script);
        _webRtcScriptInjected = true;
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("liveChatRtc.setRef", _dotNetRef);
    }

    private async Task StartCall(bool video)
    {
        if (use == null || _selectedFriend == null || _call.IsActive || _call.IsIncoming) return;
        if (!_onlineUsers.Contains(_selectedFriend.Value)) return;
        _call = new CallState { IsActive = true, IsCaller = true, IsVideo = video, PeerId = _selectedFriend.Value };
        _hangingUp = false;
        StateHasChanged();
        await EnsureWebRtcScriptAsync();
        await StateHub.SendCallSignal(use.Id, _selectedFriend.Value, "ring", video ? "video" : "audio");
    }

    private async Task AcceptCall()
    {
        if (use == null || !_call.IsIncoming) return;
        _call.IsActive = true; _call.IsIncoming = false; _hangingUp = false;
        StateHasChanged();
        await EnsureWebRtcScriptAsync();
        await StateHub.SendCallSignal(use.Id, _call.PeerId, "accept", "");
    }

    private async Task RejectCall()
    {
        if (use == null || !_call.IsIncoming) return;
        var caller = _call.PeerId;
        try { await StateHub.SendCallSignal(use.Id, caller, "reject", ""); } catch { }
        _call = new CallState(); StateHasChanged();
    }

    private async Task HangUp(bool remote = false, string? reasonHint = null)
    {
        if (_hangingUp) return;
        _hangingUp = true;
        var peer = _call.PeerId; var wasCaller = _call.IsCaller; var wasConnected = _call.IsConnected;
        var isVideo = _call.IsVideo; var startedAt = _callStartedAt;
        if (_callDurationTimer != null) { try { _callDurationTimer.Dispose(); } catch { } _callDurationTimer = null; }
        try { if (_webRtcScriptInjected) await JS.InvokeVoidAsync("liveChatRtc.cleanup"); } catch { }
        if (!remote && use != null && peer != Guid.Empty)
        { try { await StateHub.SendCallSignal(use.Id, peer, "hangup", ""); } catch { } }

        if (use != null && peer != Guid.Empty && wasCaller)
        {
            string status; int dur = 0;
            if (wasConnected) { status = "completed"; dur = Math.Max(0, (int)(DateTime.UtcNow - startedAt).TotalSeconds); }
            else status = reasonHint ?? (remote ? "missed" : "canceled");
            _ = WriteCallSystemMessageAsync(peer, isVideo, status, dur);
        }

        _call = new CallState(); _callStartedAt = default; _hangingUp = false;
        StateHasChanged();
    }

    private async Task WriteCallSystemMessageAsync(Guid peerId, bool isVideo, string status, int dur)
    {
        if (use == null || peerId == Guid.Empty || _disposed) return;
        try
        {
            await _writeLock.WaitAsync(_cts.Token);
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

                // Conversation'ı bul
                var convId = _selectedConversationId;
                if (convId == null)
                {
                    var conv = await db.ChatConversations.Where(c => c.ConversationType == ConversationType.Direct && c.IsActive
                        && ((c.DirectUserAId == use.Id && c.DirectUserBId == peerId) || (c.DirectUserAId == peerId && c.DirectUserBId == use.Id)))
                        .FirstOrDefaultAsync(_cts.Token);
                    convId = conv?.Id;
                }
                if (convId == null) return;

                var payload = $"{CALL_MSG_PREFIX}{(isVideo ? "video" : "audio")}|{status}|{dur}";
                var message = new ChatMessages
                {
                    ConversationId = convId.Value,
                    SenderUserId = use.Id,
                    MessageType = ChatMessageType.System,
                    Content = GlobalSecurityProvider.Encrypt(payload),
                    Status = ChatMessageStatus.Sent
                };
                db.ChatMessages.Add(message);
                await db.SaveChangesAsync(_cts.Token);

                if (_selectedFriend.HasValue && _selectedFriend.Value == peerId)
                {
                    _messages.Add(message);
                    _shouldScrollToBottom = true;
                    await InvokeAsync(StateHasChanged);
                }

                StateHub.ClearCache($"ChatManager_Friends_{use.Id}");
                StateHub.ClearCache($"ChatManager_Friends_{peerId}");
                await StateHub.NotifyDataChanged("ChatMessages");
            }
            finally { _writeLock.Release(); }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"[{PAGE}] WriteCallSystemMessage hata: {ex.Message}"); }
    }

    private async Task ToggleMic() { _call.MicMuted = !_call.MicMuted; try { await JS.InvokeVoidAsync("liveChatRtc.setMicMuted", _call.MicMuted); } catch { } StateHasChanged(); }
    private async Task ToggleCam() { _call.CamMuted = !_call.CamMuted; try { await JS.InvokeVoidAsync("liveChatRtc.setCamMuted", _call.CamMuted); } catch { } StateHasChanged(); }

    private string FormatCallDuration()
    {
        if (!_call.IsConnected) return "";
        var span = DateTime.UtcNow - _callStartedAt;
        if (span.TotalSeconds < 0) span = TimeSpan.Zero;
        return span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss");
    }

    private async Task HandleCallSignal(Guid fromUserId, Guid toUserId, string signalType, string payload)
    {
        if (_disposed || !_isInitialized || use == null || toUserId != use.Id || fromUserId == use.Id) return;
        await InvokeAsync(async () =>
        {
            try
            {
                switch (signalType)
                {
                    case "ring":
                        if (_call.IsActive || _call.IsIncoming) { await StateHub.SendCallSignal(use.Id, fromUserId, "busy", ""); return; }
                        // Arayan profili cache'den al veya DB'den çek
                        if (!_profileCache.ContainsKey(fromUserId))
                        {
                            try
                            {
                                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                                var p = await db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(x => x.UserId == fromUserId, _cts.Token);
                                if (p != null) _profileCache[fromUserId] = p;
                            }
                            catch { }
                        }
                        _call = new CallState { IsIncoming = true, IsVideo = payload == "video", PeerId = fromUserId };
                        StateHasChanged();
                        break;
                    case "accept":
                        if (_call.IsActive && _call.IsCaller && fromUserId == _call.PeerId)
                        { await EnsureWebRtcScriptAsync(); await JS.InvokeVoidAsync("liveChatRtc.startCaller", _call.IsVideo); }
                        break;
                    case "reject":
                    case "busy":
                        if (fromUserId == _call.PeerId) await HangUp(true, signalType == "busy" ? "busy" : "rejected");
                        break;
                    case "hangup":
                    case "peer-gone":
                        if (fromUserId == _call.PeerId) await HangUp(true);
                        break;
                    case "offer":
                        if (_call.IsActive && !_call.IsCaller && fromUserId == _call.PeerId)
                        { await EnsureWebRtcScriptAsync(); await JS.InvokeVoidAsync("liveChatRtc.acceptCallee", _call.IsVideo, payload); }
                        break;
                    case "answer":
                        if (_call.IsActive && _call.IsCaller && fromUserId == _call.PeerId)
                            await JS.InvokeVoidAsync("liveChatRtc.applyAnswer", payload);
                        break;
                    case "ice":
                        if (_call.IsActive && fromUserId == _call.PeerId)
                            await JS.InvokeVoidAsync("liveChatRtc.addRemoteIce", payload);
                        break;
                }
            }
            catch (Exception ex) { Console.WriteLine($"[{PAGE}] HandleCallSignal({signalType}) hata: {ex.Message}"); }
        });
    }

    [JSInvokable]
    public async Task JsSignal(string type, string payload)
    {
        if (_disposed || use == null || _call.PeerId == Guid.Empty) return;
        try
        {
            switch (type)
            {
                case "offer":
                case "answer":
                case "ice":
                    await StateHub.SendCallSignal(use.Id, _call.PeerId, type, payload ?? ""); break;
                case "connected":
                    if (!_call.IsConnected)
                    {
                        _call.IsConnected = true; _callStartedAt = DateTime.UtcNow;
                        _callDurationTimer = new System.Threading.Timer(async _ =>
                        { try { if (!_disposed && _call.IsConnected) await InvokeAsync(StateHasChanged); } catch { } }, null, 1000, 1000);
                        await InvokeAsync(StateHasChanged);
                    }
                    break;
                case "media-error":
                    await InvokeAsync(async () => { await HangUp(false, "canceled"); }); break;
                case "peer-gone":
                    await InvokeAsync(() => HangUp(true)); break;
            }
        }
        catch (Exception ex) { Console.WriteLine($"[{PAGE}] JsSignal({type}) hata: {ex.Message}"); }
    }
}
