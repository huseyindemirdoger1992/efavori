    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        if (_heartbeatTimer != null) { await _heartbeatTimer.DisposeAsync(); _heartbeatTimer = null; }
        if (_callDurationTimer != null) { await _callDurationTimer.DisposeAsync(); _callDurationTimer = null; }

        StateHub.OnDataChanged -= HandleGlobalDataChange;
        StateHub.OnOnlineUsersChanged -= HandleOnlineUsersChanged;
        StateHub.OnCallSignal -= HandleCallSignal;

        if (_call.IsActive || _call.IsIncoming)
