@using data
@using data.Owned;
@using data._Carts;
@using data._Categories;
@using data._Chat;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;

@using api
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject IDbContextFactory<data._ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS

<div class="container-fluid p-0 h-100">
    <div class="row g-0 h-100 border border-secondary-subtle rounded-2 overflow-hidden">

        <div class="@(_selectedFriend == null ? "d-flex" : "d-none") d-md-flex flex-column col-md-4 col-lg-3 bg-light border-end border-secondary-subtle"
             style="min-height: 0; overflow: hidden; height: calc(100vh - 120px);">

            <div class="px-3 py-2 border-bottom border-secondary-subtle bg-light flex-shrink-0">
                <div class="d-flex align-items-center gap-2">

                    <div class="position-relative flex-shrink-0">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center overflow-hidden"
                             style="width: 42px; height: 42px; font-size: 0.82rem;">
                            @if (use != null)
                            {
                                var myProfile = _profileCache.GetValueOrDefault(use.Id);
                                var myAvatar = GetAvatarUrl(myProfile);
                                @if (!string.IsNullOrEmpty(myAvatar))
                                {
                                    <img src="@myAvatar" alt="Profil" class="w-100 h-100 object-fit-cover" />
                                }
                                else
                                {
                                    @GetInitials(myProfile)
                                }
                            }
                            else
                            {
                                <i class="fa fa-user"></i>
                            }
                        </div>
                        <span class="position-absolute bottom-0 end-0 bg-success rounded-circle border border-white"
                              style="width: 10px; height: 10px;"></span>
                    </div>

                    <div class="flex-grow-1 overflow-hidden">
                        <p class="mb-0 fw-semibold small text-truncate">
                            @if (use != null)
                            {
                                var myP = _profileCache.GetValueOrDefault(use.Id);
                                @myP?.FirstName@(" ") @myP?.LastName
                            }
                        </p>
                        <small class="text-light" style="font-size: 0.7rem;">
                            <i class="fa fa-circle me-1" style="font-size: 0.5rem;"></i>Çevrimiçi
                        </small>
                    </div>

                    <div class="dropdown flex-shrink-0">
                        <button class="btn btn-sm btn-light border-0" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item small" href="javascript:;"><i class="fa fa-cog me-2"></i>Ayarlar</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item small" href="javascript:;"><i class="fa fa-question-circle me-2"></i>Yardım</a></li>
                        </ul>
                    </div>

                </div>
            </div>

            <div class="px-3 py-2 border-bottom border-secondary-subtle bg-light flex-shrink-0">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 border-secondary-subtle">
                        <i class="fa fa-search text-light"></i>
                    </span>
                    <input type="text"
                           class="form-control form-control-sm bg-light border-start-0 border-secondary-subtle"
                           placeholder="Kişi ara..."
                           value="@_searchQuery"
                           @oninput="OnSearchChanged" />
                </div>
            </div>

            <div class="px-3 pt-3 pb-1 flex-shrink-0">
                <small class="text-uppercase text-light fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">
                    Son Sohbetler
                </small>
            </div>

            <div class="flex-grow-1 overflow-auto" style="min-height: 0;">
                @if (_isLoading)
                {
                    <div class="text-center text-light py-5">
                        <i class="fa fa-spinner fa-spin fa-2x mb-2 d-block"></i>
                        <small>Yükleniyor...</small>
                    </div>
                }
                else if (!_friendIds.Any())
                {
                    <div class="text-center text-light py-5 px-3">
                        <i class="fa fa-user-times fa-2x mb-2 d-block opacity-50"></i>
                        <small>Arkadaş bulunamadı</small>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var friendId in FilteredFriendIds)
                        {
                            var fp = _profileCache.GetValueOrDefault(friendId);
                            var friendAvatar = GetAvatarUrl(fp);
                            var friendName = fp != null ? $"{fp.FirstName} {fp.LastName}" : "Kullanıcı";
                            var unread = _unreadCounts.GetValueOrDefault(friendId, 0);
                            var isSelected = _selectedFriend == friendId;

                            <a href="javascript:;"
                               class="list-group-item list-group-item-action border-0 px-3 py-2 @(isSelected ? "active" : "")"
                               @onclick="() => SelectFriend(friendId)">
                                <div class="d-flex align-items-center gap-2">

                                    <div class="position-relative flex-shrink-0">
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center overflow-hidden @(isSelected ? "bg-light text-primary" : "")"
                                             style="width: 40px; height: 40px; font-size: 0.78rem;">
                                            @if (!string.IsNullOrEmpty(friendAvatar))
                                            {
                                                <img src="@friendAvatar" alt="@friendName" class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                @GetInitials(fp)
                                            }
                                        </div>
                                        @if (_onlineUsers.Contains(friendId))
                                        {
                                            <span class="position-absolute bottom-0 end-0 bg-success rounded-circle border border-white"
                                                  style="width: 10px; height: 10px;"></span>
                                        }
                                    </div>

                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="mb-0 small fw-semibold text-truncate">@friendName</h6>
                                            @if (_lastMessages.TryGetValue(friendId, out var lastMsg))
                                            {
                                                <small class="flex-shrink-0 ms-1 @(isSelected ? "text-white-50" : "text-light")"
                                                       style="font-size: 0.68rem;">
                                                    @FormatTime(lastMsg.CreatedAtUtc)
                                                </small>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center gap-1">
                                            <p class="mb-0 text-truncate small @(isSelected ? "text-white-50" : "text-light")"
                                               style="font-size: 0.76rem; max-width: 170px;">
                                                @if (_lastMessages.TryGetValue(friendId, out var lm))
                                                {
                                                    @(GlobalSecurityProvider.Decrypt(lm.Content) ?? "")
                                                }
                                            </p>
                                            @if (unread > 0)
                                            {
                                                <span class="badge bg-primary rounded-pill flex-shrink-0" style="font-size: 0.62rem;">
                                                    @unread
                                                </span>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

        </div>

        <div class="@(_selectedFriend != null ? "d-flex" : "d-none") d-md-flex flex-column col-md-8 col-lg-9 bg-light"
             style="min-width: 0; min-height: 0; height: calc(100vh - 120px);">

            @if (_selectedFriend == null)
            {
                <div class="flex-grow-1 d-none d-md-flex flex-column align-items-center justify-content-center text-light">
                    <i class="fa fa-comments fa-3x mb-3 opacity-25"></i>
                    <p class="mb-1 fw-semibold">Henüz bir sohbet seçilmedi</p>
                    <small class="text-light opacity-75">Soldan bir arkadaş seçerek mesajlaşmaya başlayın.</small>
                </div>
            }
            else
            {
                var selProfile = _profileCache.GetValueOrDefault(_selectedFriend.Value);
                var selAvatar = GetAvatarUrl(selProfile);
                var selName = selProfile != null ? $"{selProfile.FirstName} {selProfile.LastName}" : "Kullanıcı";

                <div class="px-3 py-2 border-bottom border-secondary-subtle bg-light d-flex align-items-center gap-2 flex-shrink-0">

                    <button class="btn btn-sm btn-light border-0 d-md-none"
                            @onclick="() => _selectedFriend = null"
                            title="Geri dön">
                        <i class="fa fa-arrow-left"></i>
                    </button>

                    <div class="position-relative flex-shrink-0">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center overflow-hidden"
                             style="width: 40px; height: 40px; font-size: 0.78rem;">
                            @if (!string.IsNullOrEmpty(selAvatar))
                            {
                                <img src="@selAvatar" alt="@selName" class="w-100 h-100 object-fit-cover" />
                            }
                            else
                            {
                                @GetInitials(selProfile)
                            }
                        </div>
                        @if (_onlineUsers.Contains(_selectedFriend.Value))
                        {
                            <span class="position-absolute bottom-0 end-0 bg-success rounded-circle border border-white"
                                  style="width: 10px; height: 10px;"></span>
                        }
                    </div>

                    <div class="flex-grow-1 overflow-hidden">
                        <h6 class="mb-0 fw-bold text-truncate">@selName</h6>
                        <div class="d-flex align-items-center gap-2">
                            @if (_onlineUsers.Contains(_selectedFriend.Value))
                            {
                                <small class="text-light d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                                    <i class="fa fa-circle" style="font-size: 0.45rem;"></i>Çevrimiçi
                                </small>
                            }
                            else
                            {
                                <small class="text-light" style="font-size: 0.7rem;">Çevrimdışı</small>
                            }
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                        <button class="btn btn-sm btn-light border-0" title="Görüntülü Arama"
                                @onclick="@(() => StartCall(true))"
                                disabled="@(_call.IsActive || _call.IsIncoming || !_onlineUsers.Contains(_selectedFriend.Value))">
                            <i class="fa fa-video-camera"></i>
                        </button>
                        <button class="btn btn-sm btn-light border-0" title="Sesli Arama"
                                @onclick="@(() => StartCall(false))"
                                disabled="@(_call.IsActive || _call.IsIncoming || !_onlineUsers.Contains(_selectedFriend.Value))">
                            <i class="fa fa-phone"></i>
                        </button>
                    </div>

                </div>

                <div class="flex-grow-1 overflow-auto p-3" id="chatMessageArea" style="min-height: 0;">

                    @if (_isMessagesLoading)
                    {
                        <div class="text-center text-light py-5">
                            <i class="fa fa-spinner fa-spin fa-2x mb-2 d-block"></i>
                            <small>Mesajlar yükleniyor...</small>
                        </div>
                    }
                    else if (!_messages.Any())
                    {
                        <div class="text-center text-light py-5">
                            <i class="fa fa-envelope-o fa-2x mb-2 d-block opacity-50"></i>
                            <small>Henüz mesaj yok. İlk mesajı siz gönderin!</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in _messages.GroupBy(m => m.CreatedAtUtc.Date))
                        {
                            <div class="d-flex align-items-center gap-2 my-3">
                                <hr class="flex-grow-1 border-secondary-subtle m-0" />
                                <span class="badge bg-secondary bg-opacity-10 text-light px-3 py-1 rounded-pill fw-normal"
                                      style="font-size: 0.68rem; white-space: nowrap;">
                                    @FormatDate(group.Key)
                                </span>
                                <hr class="flex-grow-1 border-secondary-subtle m-0" />
                            </div>

                            @foreach (var msg in group.OrderBy(m => m.CreatedAtUtc))
                            {
                                bool isMine = msg.SenderUserId == use?.Id;
                                bool deleted = msg.Status == ChatMessageStatus.Deleted;
                                var decoded = deleted ? null : GlobalSecurityProvider.Decrypt(msg.Content);
                                var callInfo = ParseCallMessage(decoded);

                                @if (callInfo != null && !deleted)
                                {
                                    var iconClass = callInfo.IsVideo ? "fa-video-camera" : "fa-phone";
                                    var statusColor = callInfo.Status switch
                                    {
                                        "completed" => "text-success",
                                        "missed" => "text-danger",
                                        "rejected" => "text-danger",
                                        "busy" => "text-warning",
                                        "canceled" => "text-light",
                                        _ => "text-light"
                                    };
                                    var statusText = BuildCallStatusText(callInfo, isMine);

                                    <div class="d-flex justify-content-center my-2">
                                        <div class="px-3 py-2 bg-light border border-secondary-subtle rounded-pill shadow-sm d-inline-flex align-items-center gap-2"
                                             style="max-width: 90%;">
                                            <i class="fa @iconClass @statusColor" style="font-size: 0.85rem;"></i>
                                            <small class="text-body" style="font-size: 0.78rem;">@statusText</small>
                                            <small class="text-light" style="font-size: 0.68rem;">@msg.CreatedAtUtc.ToString("HH:mm")</small>
                                        </div>
                                    </div>
                                }
                                else if (!isMine)
                                {
                                    <div class="d-flex align-items-end gap-2 mb-3">
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0"
                                             style="width: 36px; height: 36px; font-size: 0.72rem;">
                                            @if (!string.IsNullOrEmpty(selAvatar))
                                            {
                                                <img src="@selAvatar" alt="@selName" class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                @GetInitials(selProfile)
                                            }
                                        </div>
                                        <div style="max-width: min(480px, 75%);">
                                            <p class="mb-1 text-light" style="font-size: 0.68rem;">
                                                @selName
                                                <span class="ms-1">@msg.CreatedAtUtc.ToString("HH:mm")</span>
                                            </p>
                                            <p class="mb-0 px-3 py-2 bg-light border border-secondary-subtle shadow-sm rounded-3 @(deleted ? "fst-italic text-light" : "")"
                                               style="font-size: 0.86rem; border-radius: 0 1rem 1rem 1rem !important; word-break: break-word;">
                                                @if (deleted)
                                                {
                                                    <i class="fa fa-ban me-1 text-danger opacity-50"></i>
                                                    <small>Mesaj silindi</small>
                                                }
                                                else
                                                {
                                                    @decoded
                                                }
                                            </p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-end justify-content-end gap-1 mb-3">
                                        <div style="max-width: min(480px, 75%);">
                                            <p class="mb-1 text-light text-end" style="font-size: 0.68rem;">
                                                Siz <span class="ms-1">@msg.CreatedAtUtc.ToString("HH:mm")</span>
                                            </p>
                                            <div class="d-flex align-items-end justify-content-end gap-1">
                                                @if (!deleted)
                                                {
                                                    <span class="flex-shrink-0 align-self-end mb-1" style="cursor: pointer;"
                                                          @onclick="() => DeleteMessage(msg)" title="Sil">
                                                        <i class="fa fa-trash-o text-danger" style="font-size: 0.68rem;"></i>
                                                    </span>
                                                    <span class="flex-shrink-0 align-self-end mb-1">
                                                        @if (msg.Status == ChatMessageStatus.Read)
                                                        {
                                                            <i class="fa fa-check-circle text-white-50" style="font-size: 0.68rem;" title="Okundu"></i>
                                                        }
                                                        else if (msg.Status == ChatMessageStatus.Delivered)
                                                        {
                                                            <i class="fa fa-check-circle-o text-white-50" style="font-size: 0.68rem;" title="İletildi"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa fa-check text-white-50" style="font-size: 0.68rem;" title="Gönderildi"></i>
                                                        }
                                                    </span>
                                                }
                                                <p class="mb-0 px-3 py-2 bg-primary text-white shadow-sm @(deleted ? "fst-italic opacity-75" : "")"
                                                   style="font-size: 0.86rem; border-radius: 1rem 0 1rem 1rem !important; word-break: break-word;">
                                                    @if (deleted)
                                                    {
                                                        <i class="fa fa-ban me-1 opacity-75"></i>
                                                        <small>Mesaj silindi</small>
                                                    }
                                                    else
                                                    {
                                                        @decoded
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        <div id="chatBottom"></div>
                    }

                </div>

                <div class="border-top border-secondary-subtle bg-light px-3 py-2 flex-shrink-0">
                    <div class="d-flex align-items-center gap-2">

                        <div class="flex-grow-1">
                            <div class="input-group position-relative">
                                <button type="button"
                                        class="input-group-text bg-light border-secondary-subtle border-end-0 border-0"
                                        @onclick="ToggleEmojiPicker"
                                        title="Emoji">
                                    <i class="fa fa-smile-o text-light"></i>
                                </button>
                                <input type="text"
                                       id="messageInput"
                                       class="form-control bg-light border-secondary-subtle border-start-0 border-end-0"
                                       placeholder="Mesajınızı yazın..."
                                       @bind="_newMessage"
                                       @bind:event="oninput"
                                       @onkeydown="OnInputKeyDown"
                                       maxlength="2000"
                                       disabled="@_isSending" />

                                @if (_emojiPickerOpen)
                                {
                                    <div class="position-absolute shadow border border-secondary-subtle rounded-3 bg-light"
                                         id="emojiPickerPanel"
                                         style="bottom: calc(100% + 6px); left: 0; width: 320px; max-height: 280px; z-index: 1080; overflow: hidden;">

                                        <div class="d-flex border-bottom border-secondary-subtle px-2 py-1 gap-1 flex-wrap" style="font-size: 0.85rem;">
                                            @foreach (var cat in EmojiCategories)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-light border-0 px-2 py-1 @(_emojiActiveCategory == cat.Key ? "bg-secondary bg-opacity-25" : "")"
                                                        style="font-size: 0.95rem; line-height: 1;"
                                                        @onclick="@(() => _emojiActiveCategory = cat.Key)"
                                                        title="@cat.Key">
                                                    @cat.Value[0]
                                                </button>
                                            }
                                        </div>

                                        <div class="p-2 overflow-auto" style="max-height: 232px;">
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var emoji in EmojiCategories[_emojiActiveCategory])
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-light border-0 p-1"
                                                            style="font-size: 1.25rem; line-height: 1; min-width: 32px;"
                                                            @onclick="@(() => InsertEmoji(emoji))">
                                                        @emoji
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            <button class="btn btn-outlineprimary btn-sm px-3"
                                    @onclick="SendMessage"
                                    disabled="@(string.IsNullOrWhiteSpace(_newMessage) || _isSending)"
                                    title="Gönder">
                                @if (_isSending)
                                {
                                    <i class="fa fa-spinner fa-spin"></i>
                                }
                                else
                                {
                                    <i class="fa fa-paper-plane"></i>
                                }
                            </button>
                        </div>

                    </div>
                </div>
            }

        </div>

    </div>
</div>

@* ====== GELEN ARAMA BİLDİRİMİ ====== *@
@if (_call.IsIncoming && !_call.IsActive)
{
    var callerProfile = _profileCache.GetValueOrDefault(_call.PeerId);
    var callerAvatar = GetAvatarUrl(callerProfile);
    var callerName = callerProfile != null ? $"{callerProfile.FirstName} {callerProfile.LastName}" : "Kullanıcı";

    <div class="position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg rounded-3 bg-light border border-secondary-subtle"
         style="z-index: 1090; min-width: 320px; max-width: 92vw;">
        <div class="px-3 py-3">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0"
                     style="width: 48px; height: 48px;">
                    @if (!string.IsNullOrEmpty(callerAvatar))
                    {
                        <img src="@callerAvatar" alt="P" class="w-100 h-100 object-fit-cover" />
                    }
                    else
                    {
                        @GetInitials(callerProfile)
                    }
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <p class="mb-0 fw-semibold text-truncate">@callerName</p>
                    <small class="text-light">
                        <i class="fa @(_call.IsVideo ? "fa-video-camera" : "fa-phone") me-1"></i>
                        @(_call.IsVideo ? "Görüntülü arıyor..." : "Sesli arıyor...")
                    </small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success btn-sm flex-grow-1" @onclick="AcceptCall">
                    <i class="fa fa-phone me-1"></i> Kabul Et
                </button>
                <button class="btn btn-danger btn-sm flex-grow-1" @onclick="RejectCall">
                    <i class="fa fa-times me-1"></i> Reddet
                </button>
            </div>
        </div>
    </div>
}

@* ====== AKTİF ARAMA EKRANI ====== *@
@if (_call.IsActive)
{
    var peerProfile = _profileCache.GetValueOrDefault(_call.PeerId);
    var peerAvatar = GetAvatarUrl(peerProfile);
    var peerName = peerProfile != null ? $"{peerProfile.FirstName} {peerProfile.LastName}" : "Kullanıcı";

    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1085; background: rgba(0,0,0,0.85);">
        <div class="d-flex flex-column align-items-center justify-content-center text-white p-3"
             style="width: 100%; max-width: 960px; height: 100%; max-height: 100vh;">

            <div class="d-flex align-items-center justify-content-between w-100 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center overflow-hidden"
                         style="width: 40px; height: 40px;">
                        @if (!string.IsNullOrEmpty(peerAvatar))
                        {
                            <img src="@peerAvatar" alt="P" class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            @GetInitials(peerProfile)
                        }
                    </div>
                    <div>
                        <p class="mb-0 fw-semibold">@peerName</p>
                        <small class="opacity-75">
                            @(_call.IsConnected ? FormatCallDuration() : (_call.IsCaller ? "Aranıyor..." : "Bağlanıyor..."))
                        </small>
                    </div>
                </div>
            </div>

            <div class="position-relative w-100 flex-grow-1 d-flex align-items-center justify-content-center rounded-3 overflow-hidden"
                 style="background: #111; min-height: 280px;">

                @if (_call.IsVideo)
                {
                    <video id="remoteVideo" autoplay playsinline class="w-100 h-100" style="object-fit: cover; background: #000;"></video>
                    <video id="localVideo" autoplay playsinline muted
                           class="position-absolute shadow border border-light rounded-2"
                           style="bottom: 12px; right: 12px; width: 28%; max-width: 200px; min-width: 100px; object-fit: cover; background: #222;"></video>
                }
                else
                {
                    <audio id="remoteVideo" autoplay></audio>
                    <audio id="localVideo" autoplay muted></audio>
                    <div class="d-flex flex-column align-items-center text-white">
