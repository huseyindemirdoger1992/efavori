    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleGlobalDataChange;
        StateHub.OnOnlineUsersChanged += HandleOnlineUsersChanged;
        StateHub.OnCallSignal += HandleCallSignal;

        if (use != null)
        {
            await StateHub.Heartbeat(use.Id);
            _heartbeatTimer = new Timer(
                async _ => { if (!_disposed && use != null) await StateHub.Heartbeat(use.Id); },
                null, HEARTBEAT_INTERVAL_MS, HEARTBEAT_INTERVAL_MS);
        }

