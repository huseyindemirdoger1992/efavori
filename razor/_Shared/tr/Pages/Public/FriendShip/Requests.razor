@using api
@using api.tr
@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
@using data._Shared

<Notification @ref="notificationRef" />

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}


<div class="header-notifications-list">
    @foreach (var item in FriendShipList.Where(x => x.Status != true))
    {
        var currentUser = Users?.FirstOrDefault(u => u.Id == item.RequestorId);
        var profileImg = currentUser?.ProfileCoverGallery?.ProfileImagePath ?? "/images/default-avatar.png";
        var fullName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : "Bilinmeyen Kullanıcı";

        <div class="px-3 py-2 border-bottom" style="transition: background 0.2s;">
            <div class="d-flex align-items-center py-1">
                <div class="user-online position-relative flex-shrink-0">
                    @if (!string.IsNullOrEmpty(currentUser?.ProfileCoverGallery?.ProfileImagePath))
                    {
                        <img src="@profileImg" class="msg-avatar shadow-sm" alt="@fullName" style="width:42px; height:42px; object-fit: cover; border-radius: 50%;">
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border shadow-sm text-secondary" style="width:42px; height:42px;">
                            <i class="fa fa-address-book-o" style="font-size: 1.1rem;"></i>
                        </div>
                    }
                </div>

                <div class="flex-grow-1 ms-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">@fullName</span>
                        <small class="text-muted" style="font-size: 0.7rem;">Az önce</small>
                    </div>
                    <p class="mb-2 text-muted" style="font-size: 0.8rem; margin-top: -2px;">Sana arkadaşlık isteği gönderdi.</p>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary btn-sm px-3 py-1 flex-fill rounded-2"
                                style="font-size: 0.72rem; font-weight: 600;"
                                disabled="@_isProcessing"
                                @onclick="() => AcceptFriendShip(item.Id)"
                                @onclick:stopPropagation="true">
                            Onayla
                        </button>
                        <button type="button"
                                class="btn btn-danger btn-sm px-3 py-1 flex-fill rounded-2"
                                style="font-size: 0.72rem; font-weight: 600;"
                                disabled="@_isProcessing"
                                @onclick="() => DeleteFriendShip(item.Id)"
                                @onclick:stopPropagation="true">
                            Sil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
        

@code {

    private const string PAGE = "DataManager";

    [Parameter] public Users? use { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;

    private bool _isRendered;

    private readonly Queue<(string type, string title, string text, string? image)> _pendingNotifications = new();

    private bool _isLoading;
    private CancellationTokenSource? _searchCts;

    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _isProcessing;

    private bool _bypassCache;

    private List<Users>? Users { get; set; } = new();

    // ✅ FİX: "FriendShip" isimli property, razor._Shared namespace'indeki sınıfla
    // çakışıyordu. Property adı "FriendShipList" olarak değiştirildi,
    // tipi ise açıkça "data.FriendShip" olarak belirtildi.
    private List<data.FriendShip> FriendShipList { get; set; } = new();

    private List<Country> _Countries = new();
    private List<States> _States = new();
    private List<Cities> _Cities = new();

    private Notification? notificationRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isRendered = true;

            while (_pendingNotifications.TryDequeue(out var n))
            {
                await ShowNotificationDirect(n.type, n.title, n.text, n.image);
            }
        }
    }

    protected async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int countryId);
        _States.Clear();
        _Cities.Clear();

        if (countryId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _States = await db.States.AsNoTracking()
                .Where(s => s.country_id == countryId)
                .OrderBy(s => s.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int stateId);
        _Cities.Clear();

        if (stateId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _Cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == stateId)
                .OrderBy(c => c.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;

        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;

        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleGlobalDataChange;

        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;

        var shouldRefresh = entityName == "Users" || entityName == "FriendShip";

        if (shouldRefresh)
        {
            _bypassCache = true;
            await InvokeAsync(async () =>
            {
                await LoadData(null);
                StateHasChanged();
            });
        }
    }


    protected async Task AcceptFriendShip(Guid friendShipId)
    {
        if (_isProcessing) return;
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var request = await db.FriendShip
                .Include(f => f.IsDeleted)
                .FirstOrDefaultAsync(f => f.Id == friendShipId, _cts.Token);

            if (request == null
                || request.ReceiverId != use?.Id
                || request.IsDeleted?.IsDeletedStatu == true)
            {
                await ShowNotification("warning", "Uyarı", "İstek bulunamadı.", null);
                return;
            }

            request.Status = true;
            request.ActionDate = DateTime.UtcNow;

            await db.SaveChangesAsync(_cts.Token);

            // UI'ı anında güncelle — cache'i beklemeden item'ı listeden çıkar
            FriendShipList.RemoveAll(f => f.Id == friendShipId);
            StateHasChanged();

            await StateHub.NotifyDataChanged("FriendShip");
            await Logger.TakeIt(use?.Id, PAGE, "AcceptFriendShip");
            await ShowNotification("success", "Başarılı", "Arkadaşlık isteği onaylandı.", null);
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "AcceptFriendShip",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "İstek onaylanırken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    protected async Task DeleteFriendShip(Guid friendShipId)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // ✅ FİX: FindAsync tipi açıkça data.FriendShip olarak belirtildi
            var request = await db.FriendShip.FindAsync(
                new object[] { friendShipId }, _cts.Token);

            if (request == null || request.ReceiverId != use?.Id)
            {
                await ShowNotification("warning", "Uyarı", "İstek bulunamadı.", null);
            }
            else
            {
                request.IsDeleted ??= new IsDeleted();
                request.IsDeleted.IsDeletedStatu = true;
                request.IsDeleted.DeletedAtDate = DateTime.UtcNow;
                request.Status = false;
                request.ActionDate = DateTime.UtcNow;

                await db.SaveChangesAsync(_cts.Token);

                // UI'ı anında güncelle — cache'i beklemeden item'ı listeden çıkar
                FriendShipList.RemoveAll(f => f.Id == friendShipId);
                StateHasChanged();

                await StateHub.NotifyDataChanged("FriendShip");
                await Logger.TakeIt(use?.Id, PAGE, "DeleteFriendShip");
                await ShowNotification("success", "Başarılı", "Arkadaşlık isteği reddedildi.", null);
            }
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "DeleteFriendShip",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "İstek silinirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    protected virtual async Task LoadData(string? search)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(1000, token);

            if (_isLoading) return;
            _isLoading = true;

            using var db = await DbFactory.CreateDbContextAsync();
            _Countries = await db.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync();
            StateHasChanged();

            // Loader: cache'i bypass gereken durumlarda (Onayla/Sil sonrası) doğrudan DB'den yükle
            var shouldBypass = _bypassCache;
            if (_bypassCache) _bypassCache = false;

            Func<Task<dynamic>> loader = async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query = db.Users.AsNoTracking().Where(u => u.IsActive == true);

                // ✅ FİX: Sorgu sonucu tipi açıkça data.FriendShip olarak belirtildi
                var query_FriendShip = db.FriendShip.AsNoTracking()
                    .Where(u => u.ReceiverId == use.Id && (u.IsDeleted.IsDeletedStatu == null || u.IsDeleted.IsDeletedStatu != true));

                if (!string.IsNullOrWhiteSpace(search))
                {
                    query = query.Where(u =>
                        u.FirstName.Contains(search) ||
                        u.LastName.Contains(search));
                }

                var users = await query
                    .OrderByDescending(u => u.RegistrationDate)
                    .ToListAsync(token);

                // ✅ FİX: Tip açıkça List<data.FriendShip> olarak belirtildi
                var friendShip = await query_FriendShip
                    .ToListAsync(token);

                return new { Users = users, FriendShip = (List<data.FriendShip>)friendShip };
            };

            // Onayla/Sil sonrası bypass: cache'i atlayıp taze veri çek
            var result = shouldBypass
                ? await loader()
                : await StateHub.GetOrLoadAsync("DataManager_Main", loader, token);

            if (result != null && !token.IsCancellationRequested)
            {
                Users = result.Users;
                // ✅ FİX: Property adı FriendShipList olarak güncellendi
                FriendShipList = result.FriendShip;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }


    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (_isRendered)
        {
            await ShowNotificationDirect(type, title, text, image);
        }
        else
        {
            _pendingNotifications.Enqueue((type, title, text, image));
        }
    }

    private async Task ShowNotificationDirect(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
}
