@using data
@using data.Owned;
@using data._Carts;
@using data._Categories;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;

@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<data._ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

<Notification @ref="notificationRef" />

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}


<div class="header-notifications-list">
    @foreach (var item in FriendShipList.Where(x => x.Status == FriendshipStatus.Pending))
    {
        var currentProfile = _userProfiles?.FirstOrDefault(p => p.UserId == item.RequestorUserId);
        var avatarMediaId = currentProfile?.AvatarMediaId;
        var profileImg = avatarMediaId.HasValue
            ? (_mediaList?.FirstOrDefault(m => m.Id == avatarMediaId.Value)?.FileUrl ?? "/images/default-avatar.png")
            : "/images/default-avatar.png";
        var fullName = currentProfile != null
            ? $"{currentProfile.FirstName} {currentProfile.LastName}"
            : "Bilinmeyen Kullanıcı";

        <div class="px-3 py-2 border-bottom" style="transition: background 0.2s;">
            <div class="d-flex align-items-center py-1">
                <div class="user-online position-relative flex-shrink-0">
                    @if (avatarMediaId.HasValue && profileImg != "/images/default-avatar.png")
                    {
                        <img src="@profileImg" class="msg-avatar shadow-sm" alt="@fullName" style="width:42px; height:42px; object-fit: cover; border-radius: 50%;">
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border shadow-sm text-secondary" style="width:42px; height:42px;">
                            <i class="fa fa-address-book-o" style="font-size: 1.1rem;"></i>
                        </div>
                    }
                </div>

                <div class="flex-grow-1 ms-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-light" style="font-size: 0.85rem;">
                            @fullName
                        </span>
                        <small class="text-light" style="font-size: 0.7rem;"> @item.CreatedAtUtc </small>
                    </div>
                    <p class="mb-2 text-light" style="font-size: 0.8rem; margin-top: -2px;">Sana arkadaşlık isteği gönderdi.</p>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary btn-sm px-3 py-1 flex-fill rounded-2"
                                style="font-size: 0.72rem; font-weight: 600;"
                                disabled="@_isProcessing"
                                @onclick="() => AcceptFriendShip(item.Id)"
                                @onclick:stopPropagation="true">
                            Onayla
                        </button>
                        <button type="button"
                                class="btn btn-danger btn-sm px-3 py-1 flex-fill rounded-2"
                                style="font-size: 0.72rem; font-weight: 600;"
                                disabled="@_isProcessing"
                                @onclick="() => DeleteFriendShip(item.Id)"
                                @onclick:stopPropagation="true">
                            Sil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

        
@code {

    private const string PAGE = "DataManager";

    [Parameter] public Users? use { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;

    private bool _isRendered;

    private readonly Queue<(string type, string title, string text, string? image)> _pendingNotifications = new();

    private bool _isLoading;
    private CancellationTokenSource? _searchCts;

    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _isProcessing;

    private bool _bypassCache;

    private List<UserProfiles> _userProfiles = new();
    private List<data._Galleries.Media> _mediaList = new();
    private List<Friendships> FriendShipList { get; set; } = new();

    private List<Country> _Countries = new();
    private List<States> _States = new();
    private List<Cities> _Cities = new();

    private Notification? notificationRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isRendered = true;

            while (_pendingNotifications.TryDequeue(out var n))
            {
                await ShowNotificationDirect(n.type, n.title, n.text, n.image);
            }
        }
    }

    protected async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int countryId);
        _States.Clear();
        _Cities.Clear();

        if (countryId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _States = await db.States.AsNoTracking()
                .Where(s => s.country_id == countryId)
                .OrderBy(s => s.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int stateId);
        _Cities.Clear();

        if (stateId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _Cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == stateId)
                .OrderBy(c => c.name).ToListAsync();
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;

        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;

        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleGlobalDataChange;

        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;

        var shouldRefresh = entityName == "Users" || entityName == "Friendships";

        if (shouldRefresh)
        {
            _bypassCache = true;
            await InvokeAsync(async () =>
            {
                await LoadData(null);
                StateHasChanged();
            });
        }
    }


    protected async Task AcceptFriendShip(Guid friendShipId)
    {
        if (_isProcessing) return;
        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var request = await db.Friendships
                .Include(f => f.IsDeleted)
                .FirstOrDefaultAsync(f => f.Id == friendShipId, _cts.Token);

            if (request == null
                || request.ReceiverUserId != use?.Id
                || request.IsDeleted?.IsDeletedStatu == true)
            {
                await ShowNotification("warning", "Uyarı", "İstek bulunamadı.", null);
                return;
            }

            request.Status = FriendshipStatus.Accepted;
            request.RespondedAtUtc = DateTime.UtcNow;
            request.AcceptedAtUtc = DateTime.UtcNow;

            await db.SaveChangesAsync(_cts.Token);

            FriendShipList.RemoveAll(f => f.Id == friendShipId);
            StateHasChanged();

            await StateHub.NotifyDataChanged("Friendships");
            await Logger.TakeIt(use?.Id, PAGE, "AcceptFriendShip");
            await ShowNotification("success", "Başarılı", "Arkadaşlık isteği onaylandı.", null);
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "AcceptFriendShip",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "İstek onaylanırken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    protected async Task DeleteFriendShip(Guid friendShipId)
    {
        if (_isProcessing) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            var request = await db.Friendships
                .FirstOrDefaultAsync(f => f.Id == friendShipId, _cts.Token);

            if (request == null || request.ReceiverUserId != use?.Id)
            {
                await ShowNotification("warning", "Uyarı", "İstek bulunamadı.", null);
            }
            else
            {
                request.Status = FriendshipStatus.Rejected;
                request.RespondedAtUtc = DateTime.UtcNow;

                await db.SaveChangesAsync(_cts.Token);

                FriendShipList.RemoveAll(f => f.Id == friendShipId);
                StateHasChanged();

                await StateHub.NotifyDataChanged("Friendships");
                await Logger.TakeIt(use?.Id, PAGE, "DeleteFriendShip");
                await ShowNotification("success", "Başarılı", "Arkadaşlık isteği reddedildi.", null);
            }
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "DeleteFriendShip",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "İstek silinirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

    protected virtual async Task LoadData(string? search)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(1000, token);

            if (_isLoading) return;
            _isLoading = true;

            using var dbCountry = await DbFactory.CreateDbContextAsync();
            _Countries = await dbCountry.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync();
            StateHasChanged();

            var shouldBypass = _bypassCache;
            if (_bypassCache) _bypassCache = false;

            Func<Task<dynamic>> loader = async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                // Bekleyen arkadaşlık isteklerini çek
                var friendships = await db.Friendships.AsNoTracking()
                    .Where(f => f.ReceiverUserId == use!.Id
                             && f.IsDeleted.IsDeletedStatu != true
                             && f.Status == FriendshipStatus.Pending)
                    .ToListAsync(token);

                // İstek gönderen kullanıcıların profil bilgilerini çek
                var requestorIds = friendships.Select(f => f.RequestorUserId).Distinct().ToList();

                var profiles = requestorIds.Count > 0
                    ? await db.UserProfiles.AsNoTracking()
                        .Where(p => requestorIds.Contains(p.UserId))
                        .ToListAsync(token)
                    : new List<UserProfiles>();

                // Avatar medyalarını çek
                var avatarMediaIds = profiles
                    .Where(p => p.AvatarMediaId.HasValue)
                    .Select(p => p.AvatarMediaId!.Value)
                    .Distinct()
                    .ToList();

                var mediaList = avatarMediaIds.Count > 0
                    ? await db.Media.AsNoTracking()
                        .Where(m => avatarMediaIds.Contains(m.Id))
                        .ToListAsync(token)
                    : new List<data._Galleries.Media>();

                return (dynamic)new
                {
                    Friendships = friendships,
                    Profiles = profiles,
                    MediaList = mediaList
                };
            };

            var result = shouldBypass
                ? await loader()
                : await StateHub.GetOrLoadAsync("DataManager_Main", loader, token);

            if (result != null && !token.IsCancellationRequested)
            {
                FriendShipList = result.Friendships;
                _userProfiles = result.Profiles;
                _mediaList = result.MediaList;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData",
                exception: ex.Message,
                stackTrace: ex.StackTrace);

            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }


    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (_isRendered)
        {
            await ShowNotificationDirect(type, title, text, image);
        }
        else
        {
            _pendingNotifications.Enqueue((type, title, text, image));
        }
    }

    private async Task ShowNotificationDirect(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
}
