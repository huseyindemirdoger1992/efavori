@* ═══════════════════════════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Teleprompter";
    private const int SCROLL_INTERVAL_MS = 50;
    private const int WORDS_PER_MINUTE = 150;
    private const double WHEEL_SCROLL_MULTIPLIER = 2.5;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();

    // ─── UI durumu ────────────────────────────────────────────────
    private Notification? _notificationRef;

    // ─── Metin ────────────────────────────────────────────────────
    private string _scriptText = string.Empty;
    private int _wordCount;
    private int _charCount;
    private int _lineCount;
    private int _estimatedMinutes;
    private int _estimatedSeconds;

    // ─── Kaydırma / Sunum ─────────────────────────────────────────
    private bool _isPresenting;
    private bool _isScrolling;
    private bool _showPreview = true;
    private bool _showControls = true;
    private DateTime _lastMouseMove = DateTime.UtcNow;
    private System.Threading.Timer? _scrollTimer;
    private double _currentScrollPosition;
    private double _maxScrollHeight;
    private DateTime _presentationStartTime;
    private TimeSpan _elapsedTime;
    private string _elapsedDisplay = "00:00";
    private string _remainingDisplay = "--:--";
    private double _progressPercent;
    private System.Threading.Timer? _clockTimer;

    // ─── Geri sayım ──────────────────────────────────────────────
    private int _countdownValue;
    private int _countdownDuration = 3;

    // ─── Görünüm ayarları ─────────────────────────────────────────
    private int _scrollSpeed = 5;
    private int _fontSize = 42;
    private double _lineHeight = 1.6;
    private int _marginPercent = 10;
    private string _fontFamily = "'Segoe UI', system-ui, sans-serif";
    private string _textAlign = "center";
    private string _fontWeight = "400";
    private string _textColor = "#FFFFFF";
    private string _bgColor = "#000000";
    private bool _isMirrored;
    private bool _showFocusLine = true;
    private int _focusLinePosition = 35;
    private double _fadeOpacity = 0.45;
    private bool _autoPauseEnabled = true;

    // ─── Yer İmleri ──────────────────────────────────────────────
    private List<BookmarkItem> _bookmarks = new();

    // ─── JS interop referans ─────────────────────────────────────
    private DotNetObjectReference<Teleprompter>? _dotNetRef;

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        _dotNetRef = DotNetObjectReference.Create(this);
        await LoadSettingsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterKeyboardHandler();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        _scrollTimer?.Dispose();
        _clockTimer?.Dispose();

        try
        {
            await JS.InvokeVoidAsync("eval", @"
                if (window.__prompterKeyHandler) {
                    document.removeEventListener('keydown', window.__prompterKeyHandler);
                }
                if (window.__prompterWheelHandler) {
                    document.removeEventListener('wheel', window.__prompterWheelHandler);
                    document.removeEventListener('mousewheel', window.__prompterWheelHandler);
                    document.removeEventListener('DOMMouseScroll', window.__prompterWheelHandler);
                }
                window.__prompterDotNet = null;
            ");
        }
        catch { }

        _dotNetRef?.Dispose();

        await _cts.CancelAsync();
        _cts.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // KLAVYE & MOUSE WHEEL HANDLER (JS Interop)
    // ══════════════════════════════════════════════════════════════

    private async Task RegisterKeyboardHandler()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                if(window.__prompterKeyHandler) document.removeEventListener('keydown', window.__prompterKeyHandler);
                window.__prompterKeyHandler = function(e) {
                    if (e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
                    const key = e.key;
                    const validKeys = [' ', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Escape', 'm', 'M', 'f', 'F', 'r', 'R'];
                    if (validKeys.includes(key)) {
                        e.preventDefault();
                        window.__prompterDotNet && window.__prompterDotNet.invokeMethodAsync('HandleKeyFromJS', key);
                    }
                };
                document.addEventListener('keydown', window.__prompterKeyHandler);
            ");
        }
        catch { }
    }

    private async Task RegisterWheelHandler()
    {
        try
        {
            // ── Uzaktan masaüstü (RDP/VNC/AnyDesk/TeamViewer) uyumlu wheel handler ──
            // Bazı remote desktop istemcileri standart 'wheel' eventi yerine
            // eski 'mousewheel' veya 'DOMMouseScroll' eventlerini iletir.
            // Ayrıca bazıları scroll'u pointer event olarak gönderir.
            // Bu yüzden tüm varyantları dinliyoruz.
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    // Önceki handler'ları temizle
                    if (window.__prompterWheelHandler) {
                        document.removeEventListener('wheel', window.__prompterWheelHandler);
                        document.removeEventListener('mousewheel', window.__prompterWheelHandler);
                        document.removeEventListener('DOMMouseScroll', window.__prompterWheelHandler);
                    }

                    window.__prompterWheelHandler = function(e) {
                        var el = document.getElementById('prompterFullscreen');
                        if (!el) return;

                        // Event target doğrudan fullscreen içinde olmasa bile
                        // (z-index overlay'ler yüzünden) event'i yakala
                        // RDP gibi protokollerde target bazen 'document' veya 'body' olabilir
                        var isInPrompter = el.contains(e.target) ||
                                           e.target === document.body ||
                                           e.target === document.documentElement ||
                                           e.target === document;

                        if (!isInPrompter) return;

                        if (e.preventDefault) e.preventDefault();
                        if (e.stopPropagation) e.stopPropagation();

                        // deltaY normalize — farklı event tipleri farklı değerler verir
                        var delta = 0;
                        if (e.deltaY !== undefined) {
                            // Standart 'wheel' event
                            delta = e.deltaY;
                        } else if (e.wheelDelta !== undefined) {
                            // Eski 'mousewheel' event (IE, eski Chrome)
                            // wheelDelta ters işaretli ve 120 katları
                            delta = -e.wheelDelta / 3;
                        } else if (e.detail !== undefined) {
                            // Firefox 'DOMMouseScroll' event
                            // detail genellikle 3 veya -3
                            delta = e.detail * 40;
                        }

                        if (delta === 0) return;

                        if (window.__prompterDotNet) {
                            window.__prompterDotNet.invokeMethodAsync('HandleWheelFromJS', delta);
                        }
                    };

                    // Tüm wheel event varyantlarını dinle
                    document.addEventListener('wheel', window.__prompterWheelHandler, {passive: false, capture: true});
                    document.addEventListener('mousewheel', window.__prompterWheelHandler, {passive: false, capture: true});
                    document.addEventListener('DOMMouseScroll', window.__prompterWheelHandler, {passive: false, capture: true});
                })();
            ");
        }
        catch { }
    }

    [JSInvokable("HandleKeyFromJS")]
    public async Task HandleKeyFromJS(string key)
    {
        await HandleKeyPress(key);
    }

    [JSInvokable("HandleWheelFromJS")]
    public async Task HandleWheelFromJS(double deltaY)
    {
        if (!_isPresenting || _disposed) return;

        _currentScrollPosition += deltaY * WHEEL_SCROLL_MULTIPLIER;
        _currentScrollPosition = Math.Max(0, _currentScrollPosition);

        if (_maxScrollHeight > 0)
        {
            _currentScrollPosition = Math.Min(_currentScrollPosition, _maxScrollHeight);
            _progressPercent = Math.Min(100, (_currentScrollPosition / _maxScrollHeight) * 100);
        }

        try
        {
            await JS.InvokeVoidAsync("eval",
                $"var c=document.getElementById('prompterContent'); if(c) c.style.transform='translateY(-{_currentScrollPosition.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}px)';");
        }
        catch { }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyPress(string key)
    {
        switch (key)
        {
            case " ":
                if (_isPresenting)
                {
                    if (_isScrolling) PauseScrolling();
                    else ResumeScrolling();
                }
                break;
            case "ArrowUp": IncreaseSpeed(); break;
            case "ArrowDown": DecreaseSpeed(); break;
            case "ArrowLeft": DecreaseFontSize(); break;
            case "ArrowRight": IncreaseFontSize(); break;
            case "Escape":
                if (_isPresenting) await StopPresentation();
                break;
            case "m": case "M": _isMirrored = !_isMirrored; break;
            case "f": case "F": _showFocusLine = !_showFocusLine; break;
            case "r":
            case "R":
                if (_isPresenting) await ResetScroll();
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    // ══════════════════════════════════════════════════════════════
    // METİN ANALİZ
    // ══════════════════════════════════════════════════════════════

    private void OnTextChanged()
    {
        AnalyzeText();
        ExtractBookmarks();
    }

    private void AnalyzeText()
    {
        if (string.IsNullOrWhiteSpace(_scriptText))
        {
            _wordCount = 0; _charCount = 0; _lineCount = 0;
            _estimatedMinutes = 0; _estimatedSeconds = 0;
            return;
        }

        var cleanText = _scriptText
            .Replace("[PAUSE]", "")
            .Replace("[SLOW]", "").Replace("[/SLOW]", "")
            .Replace("[FAST]", "").Replace("[/FAST]", "")
            .Replace("---", "");

        var words = cleanText.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries);
        _wordCount = words.Length;
        _charCount = cleanText.Length;
        _lineCount = _scriptText.Split('\n').Length;

        var totalSeconds = (int)Math.Ceiling((double)_wordCount / WORDS_PER_MINUTE * 60);
        _estimatedMinutes = totalSeconds / 60;
        _estimatedSeconds = totalSeconds % 60;
    }

    private void ExtractBookmarks()
    {
        _bookmarks.Clear();
        if (string.IsNullOrWhiteSpace(_scriptText)) return;

        var lines = _scriptText.Split('\n');
        for (int i = 0; i < lines.Length; i++)
        {
            if (lines[i].Trim() == "---")
            {
                var preview = "Yer İmi";
                for (int j = i + 1; j < lines.Length && j < i + 3; j++)
                {
                    var next = lines[j].Trim();
                    if (!string.IsNullOrWhiteSpace(next) && next != "---" && !next.StartsWith("["))
                    {
                        preview = next.Length > 60 ? next.Substring(0, 60) + "..." : next;
                        break;
                    }
                }
                _bookmarks.Add(new BookmarkItem { LineNumber = i + 1, PreviewText = preview });
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    // SUNUM KONTROLÜ
    // ══════════════════════════════════════════════════════════════

    private async Task StartPresentation()
    {
        if (string.IsNullOrWhiteSpace(_scriptText)) return;

        _isPresenting = true;
        _currentScrollPosition = 0;
        _progressPercent = 0;
        _showControls = true;
        _countdownValue = _countdownDuration;
        _presentationStartTime = DateTime.UtcNow;
        _elapsedDisplay = "00:00";
        _remainingDisplay = FormatTime(TimeSpan.FromMinutes(_estimatedMinutes).Add(TimeSpan.FromSeconds(_estimatedSeconds)));

        StateHasChanged();

        // Tam ekran iste
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                var el = document.getElementById('prompterFullscreen');
                if (el && el.requestFullscreen) el.requestFullscreen().catch(()=>{});
            ");
        }
        catch { }

        // DotNetObjectReference'ı JS'e kaydet (keyboard + wheel handler için)
        _dotNetRef?.Dispose();
        _dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            await SetDotNetRefInJS();
        }
        catch { }

        // Klavye handler'ı kaydet
        await RegisterKeyboardHandler();

        // Mouse wheel handler'ı kaydet
        await RegisterWheelHandler();

        // Geri sayım
        if (_countdownDuration > 0)
        {
            for (int i = _countdownDuration; i > 0; i--)
            {
                _countdownValue = i;
                StateHasChanged();
                await Task.Delay(1000, _cts.Token);
            }
        }
        _countdownValue = 0;
        StateHasChanged();

        // Scroll yüksekliğini al
        try
        {
            _maxScrollHeight = await JS.InvokeAsync<double>("eval",
                "document.getElementById('prompterContent')?.scrollHeight || 5000");
        }
        catch { _maxScrollHeight = 5000; }

        // Saat timer'ı başlat
        _clockTimer = new System.Threading.Timer(async _ =>
        {
            if (_disposed || !_isPresenting) return;
            _elapsedTime = DateTime.UtcNow - _presentationStartTime;
            _elapsedDisplay = FormatTime(_elapsedTime);

            var totalEstimated = TimeSpan.FromMinutes(_estimatedMinutes).Add(TimeSpan.FromSeconds(_estimatedSeconds));
            var remaining = totalEstimated - _elapsedTime;
            _remainingDisplay = remaining.TotalSeconds > 0 ? FormatTime(remaining) : "00:00";

            await InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        // Kaydırmayı başlat
        StartScrollTimer();
    }

    private async Task SetDotNetRefInJS()
    {
        // Önce JS tarafında setter fonksiyonu tanımla, sonra DotNetObjectReference'ı parametre olarak geçir
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                window.__setPrompterRef = function(ref) {
                    window.__prompterDotNet = ref;
                };
            ");
            await JS.InvokeVoidAsync("window.__setPrompterRef", _dotNetRef);
        }
        catch { }
    }

    private async Task StopPresentation()
    {
        _isPresenting = false;
        _isScrolling = false;
        _scrollTimer?.Dispose();
        _scrollTimer = null;
        _clockTimer?.Dispose();
        _clockTimer = null;

        try
        {
            await JS.InvokeVoidAsync("eval", "document.exitFullscreen && document.exitFullscreen().catch(()=>{})");
        }
        catch { }

        // Wheel handler'ı temizle (tüm varyantlar)
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                if (window.__prompterWheelHandler) {
                    document.removeEventListener('wheel', window.__prompterWheelHandler);
                    document.removeEventListener('mousewheel', window.__prompterWheelHandler);
                    document.removeEventListener('DOMMouseScroll', window.__prompterWheelHandler);
                }
            ");
        }
        catch { }

        // Klavye handler'ı edit modu için yeniden kaydet
        await RegisterKeyboardHandler();

        StateHasChanged();
    }

    private void StartScrollTimer()
    {
        _isScrolling = true;
        _scrollTimer?.Dispose();

        _scrollTimer = new System.Threading.Timer(async _ =>
        {
            if (_disposed || !_isPresenting || !_isScrolling) return;

            var pixelsPerTick = _scrollSpeed * 0.6;
            _currentScrollPosition += pixelsPerTick;

            if (_maxScrollHeight > 0)
            {
                _progressPercent = Math.Min(100, (_currentScrollPosition / _maxScrollHeight) * 100);
            }

            if (_currentScrollPosition >= _maxScrollHeight)
            {
                _isScrolling = false;
                _progressPercent = 100;
                _scrollTimer?.Dispose();
            }

            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"var c=document.getElementById('prompterContent'); if(c) c.style.transform='translateY(-{_currentScrollPosition.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}px)';");
                await InvokeAsync(StateHasChanged);
            }
            catch { }

        }, null, 0, SCROLL_INTERVAL_MS);
    }

    private void PauseScrolling()
    {
        _isScrolling = false;
        _scrollTimer?.Dispose();
        _scrollTimer = null;
        StateHasChanged();
    }

    private void ResumeScrolling()
    {
        if (!_isPresenting) return;
        StartScrollTimer();
        StateHasChanged();
    }

    private async Task ResetScroll()
    {
        _currentScrollPosition = 0;
        _progressPercent = 0;
        _presentationStartTime = DateTime.UtcNow;
        _elapsedDisplay = "00:00";

        try
        {
            await JS.InvokeVoidAsync("eval",
                "var c=document.getElementById('prompterContent'); if(c) c.style.transform='translateY(0)';");
        }
        catch { }

        PauseScrolling();
    }

    // ══════════════════════════════════════════════════════════════
    // HIZ & BOYUT KONTROL
    // ══════════════════════════════════════════════════════════════

    private void IncreaseSpeed()
    {
        if (_scrollSpeed < 20) _scrollSpeed++;
        if (_isScrolling) RestartScrollTimer();
    }

    private void DecreaseSpeed()
    {
        if (_scrollSpeed > 1) _scrollSpeed--;
        if (_isScrolling) RestartScrollTimer();
    }

    private void IncreaseFontSize()
    {
        if (_fontSize < 300) _fontSize += 2;
    }

    private void DecreaseFontSize()
    {
        if (_fontSize > 16) _fontSize -= 2;
    }

    private void RestartScrollTimer()
    {
        if (!_isScrolling || !_isPresenting) return;
        _scrollTimer?.Dispose();
        StartScrollTimer();
    }

    // ══════════════════════════════════════════════════════════════
    // MOUSE HAREKETİ (kontrol çubuğunu göster/gizle)
    // ══════════════════════════════════════════════════════════════

    private void OnMouseMovePresentation()
    {
        _showControls = true;
        _lastMouseMove = DateTime.UtcNow;

        Task.Delay(3000).ContinueWith(_ =>
        {
            if (!_disposed && (DateTime.UtcNow - _lastMouseMove).TotalSeconds >= 2.8)
            {
                _showControls = false;
                InvokeAsync(StateHasChanged);
            }
        });
    }

