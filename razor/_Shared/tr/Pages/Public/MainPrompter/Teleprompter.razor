@* ============================================================
   Teleprompter.razor
   ─────────────────────────────────────────────────────────────
   ✅ Profesyonel Teleprompter / Prompter Sayfası
   ✅ Tam ekran sunum modu + mouse wheel kaydırma
   ✅ Ayarlanabilir kaydırma hızı (1-20)
   ✅ Ayarlanabilir yazı boyutu (16px-300px)
   ✅ Yazı tipi ailesi seçimi
   ✅ Satır yüksekliği ayarı
   ✅ Sol / Orta / Sağ metin hizalama
   ✅ Metin rengi ve arka plan rengi seçimi
   ✅ Yatay ayna (Mirror) modu — gerçek prompter camı için
   ✅ Odak çizgisi (Focus Line) — okunacak satır vurgusu
   ✅ Geri sayım (3-2-1) başlatma
   ✅ Başlat / Duraklat / Sıfırla kontrolleri
   ✅ Klavye kısayolları (Space, ↑, ↓, Esc, M, F, R)
   ✅ Kenar boşluğu (margin) ayarı
   ✅ Tahmini okuma süresi göstergesi
   ✅ İlerleme çubuğu (%)
   ✅ Geçen süre / Kalan süre göstergesi
   ✅ Yer imi (Bookmark) sistemi — metinde işaret noktaları
   ✅ Metin düzenleyici ile canlı önizleme
   ✅ Ayarları localStorage'a kaydet / yükle (JS interop)
   ✅ Tüm ayarlar sayfada kategorize — modal yok
   ✅ Karanlık tema (dark admin temasına uyumlu)
   ❌ CRUD işlemi yok — tamamen client-side
   ============================================================ *@
@using data
@using data.Owned;
@using data._Carts;
@using data._Categories;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;

@using api
@using api.tr
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<data._ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    // Bu alanı kesinlikle SİLME. Kullanılsın veya kullanılmasın, global state'den dil bilgisini almak ve yönlendirme yapmak için gereklidir.
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",       "Ana Sayfa",      "/"),
        ("fa fa-desktop",    "Araçlar",        "javascript:void(0)"),
        ("fa fa-television", PAGE_TITLE,       "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ═══════════════════════════════════════════════════════════════
   ANA DÜZEN — Düzenleyici + Ayarlar + Önizleme
   ═══════════════════════════════════════════════════════════════ *@

@if (!_isPresenting)
{
    @* ─── Toolbar ─── *@
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button class="btn btn-info btn-sm" @onclick="StartPresentation" disabled="@(string.IsNullOrWhiteSpace(_scriptText))">
            <i class="fa fa-play me-sm-1"></i>
            <span class="d-none d-sm-inline">Sunuma Başla</span>
        </button>

        <button class="btn btn-light btn-sm" @onclick="TogglePreview">
            <i class="fa @(_showPreview ? "fa-eye-slash" : "fa-eye") me-sm-1"></i>
            <span class="d-none d-sm-inline">@(_showPreview ? "Önizlemeyi Kapat" : "Önizleme")</span>
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="OpenBookmarksModal" title="Yer İmleri"
                disabled="@(!_bookmarks.Any())">
            <i class="fa fa-bookmark me-1"></i>
            <span class="d-none d-sm-inline">Yer İmleri (@_bookmarks.Count)</span>
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-warning btn-sm border-0" @onclick="ClearScript"
                disabled="@(string.IsNullOrWhiteSpace(_scriptText))">
            <i class="fa fa-eraser me-1"></i>
            <span class="d-none d-sm-inline">Temizle</span>
        </button>

        @if (!string.IsNullOrWhiteSpace(_scriptText))
        {
            <div class="ms-auto d-none d-md-flex align-items-center gap-3 text-light small">
                <span><i class="fa fa-file-text-o me-1"></i>@_wordCount kelime</span>
                <span><i class="fa fa-clock-o me-1"></i>~@_estimatedMinutes dk @_estimatedSeconds sn</span>
                <span><i class="fa fa-font me-1"></i>@_charCount karakter</span>
            </div>
        }
    </div>

    <div class="row g-3">
        @* ─── SOL PANEL: Metin Editörü ─── *@
        <div class="@(_showPreview ? "col-12 col-lg-6" : "col-12")">
            <div class="card bg-dark border-secondary">
                <div class="card-header border-secondary py-2 d-flex align-items-center justify-content-between">
                    <h6 class="mb-0 text-white">
                        <i class="fa fa-pencil-square-o me-1"></i>Metin Editörü
                    </h6>
                    <div class="d-flex align-items-center gap-2">
                        <small class="text-white-50">Satır: @_lineCount</small>
                    </div>
                </div>
                <div class="card-body p-0">
                    <textarea class="form-control bg-dark text-light border-0 rounded-0"
                              style="min-height:50vh; resize:vertical; font-family:@(_fontFamily); font-size:15px; line-height:1.8;"
                              placeholder="Metninizi buraya yapıştırın veya yazın...&#10;&#10;İpucu: Satır başına '### ' ile bölüm başlığı ekleyin.&#10;'---' ile yer imi (bookmark) noktası ekleyin.&#10;'[PAUSE]' ile otomatik duraklatma noktası ekleyin.&#10;'[SLOW]' ve '[/SLOW]' ile yavaş okuma bölgesi belirleyin.&#10;'[FAST]' ve '[/FAST]' ile hızlı okuma bölgesi belirleyin."
                              @bind="_scriptText"
                              @bind:event="oninput"
                              @bind:after="OnTextChanged">
                    </textarea>
                </div>
            </div>
        </div>

        @* ─── SAĞ PANEL: Önizleme ─── *@
        @if (_showPreview)
        {
            <div class="col-12 col-lg-6">
                <div class="card border-secondary overflow-hidden"
                     style="background-color:@_bgColor; min-height:50vh;">
                    <div class="card-header border-secondary py-2 d-flex align-items-center justify-content-between"
                         style="background-color:rgba(0,0,0,0.3);">
                        <h6 class="mb-0 text-white">
                            <i class="fa fa-eye me-1"></i>Önizleme
                        </h6>
                        <div class="d-flex align-items-center gap-1">
                            <button class="btn btn-sm @(_isMirrored ? "btn-info" : "btn-outline-secondary") border-0"
                                    @onclick="() => _isMirrored = !_isMirrored" title="Ayna Modu">
                                <i class="fa fa-exchange"></i>
                            </button>
                            <button class="btn btn-sm @(_showFocusLine ? "btn-info" : "btn-outline-secondary") border-0"
                                    @onclick="() => _showFocusLine = !_showFocusLine" title="Odak Çizgisi">
                                <i class="fa fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body position-relative p-0"
                         style="height:47vh; overflow:hidden;">

                        @if (_showFocusLine)
                        {
                            <div style="position:absolute; top:50%; left:0; right:0; height:2px;
                            background:rgba(13,202,240,0.6); z-index:10;
                            box-shadow:0 0 12px rgba(13,202,240,0.4); pointer-events:none;"></div>
                            <div style="position:absolute; top:0; left:0; right:0; height:50%;
                            background:linear-gradient(to bottom, rgba(0,0,0,0.4), transparent);
                            z-index:9; pointer-events:none;"></div>
                            <div style="position:absolute; bottom:0; left:0; right:0; height:50%;
                            background:linear-gradient(to top, rgba(0,0,0,0.4), transparent);
                            z-index:9; pointer-events:none;"></div>
                        }

                        <div style="padding:2rem @(_marginPercent)%;
                            font-size:@(_fontSize)px;
                            line-height:@(_lineHeight.ToString("0.0"));
                            font-family:@(_fontFamily);
                            color:@_textColor;
                            text-align:@_textAlign;
                            font-weight:@_fontWeight;
                            @(_isMirrored ? "transform:scaleX(-1);" : "")
                            overflow-y:auto; height:100%;">
                            @if (!string.IsNullOrWhiteSpace(_scriptText))
                            {
                                @foreach (var line in _scriptText.Split('\n'))
                                {
                                    var trimmed = line.Trim();
                                    @if (trimmed == "---")
                                    {
                                        <div style="border-top:2px dashed rgba(13,202,240,0.4); margin:0.5em 0;"></div>
                                    }
                                    else if (trimmed.StartsWith("### "))
                                    {
                                        <div style="font-size:1.3em; font-weight:700; color:#0dcaf0;
                                            margin:0.8em 0 0.3em; border-bottom:1px solid rgba(13,202,240,0.2);
                                            padding-bottom:0.2em;">
                                            @trimmed.Substring(4)
                                        </div>
                                    }
                                    else if (trimmed == "[PAUSE]")
                                    {
                                        <div style="text-align:center; color:#ffc107; font-size:0.6em;
                                            margin:0.5em 0; letter-spacing:3px;">
                                            ⏸ DURAKLAT ⏸
                                        </div>
                                    }
                                    else if (string.IsNullOrWhiteSpace(trimmed))
                                    {
                                        <div style="height:0.8em;"></div>
                                    }
                                    else
                                    {
                                        <div style="margin-bottom:0.15em;">@trimmed</div>
                                    }
                                }
                            }
                            else
                            {
                                <div class="text-center" style="color:rgba(255,255,255,0.15); padding-top:30%;">
                                    <i class="fa fa-television fa-3x d-block"></i>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ═══════════════════════════════════════════════════════════════
       AYAR PANELLERİ — Sayfada kategorize (modal yok)
       ═══════════════════════════════════════════════════════════════ *@
    <div class="row g-3 mt-1">

        @* ─── Kaydırma & Boyut ─── *@
        <div class="col-12 col-xl-4">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header border-secondary py-2">
                    <h6 class="mb-0 text-info small">
                        <i class="fa fa-sliders me-1"></i>Kaydırma & Boyut
                    </h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0">
                                <i class="fa fa-tachometer me-1"></i>Hız: @_scrollSpeed
                            </label>
                            <input type="range" class="form-range" min="1" max="20" step="1"
                                   @bind="_scrollSpeed" @bind:event="oninput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0">
                                <i class="fa fa-font me-1"></i>Boyut: @(_fontSize)px
                            </label>
                            <input type="range" class="form-range" min="16" max="300" step="2"
                                   @bind="_fontSize" @bind:event="oninput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0">
                                <i class="fa fa-text-height me-1"></i>Satır: @_lineHeight.ToString("0.0")x
                            </label>
                            <input type="range" class="form-range" min="1.0" max="3.0" step="0.1"
                                   @bind="_lineHeight" @bind:event="oninput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0">
                                <i class="fa fa-arrows-h me-1"></i>Kenar: @(_marginPercent)%
                            </label>
                            <input type="range" class="form-range" min="0" max="30" step="1"
                                   @bind="_marginPercent" @bind:event="oninput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0">
                                <i class="fa fa-hourglass-start me-1"></i>Geri Sayım: @(_countdownDuration)s
                            </label>
                            <input type="range" class="form-range" min="0" max="10" step="1"
                                   @bind="_countdownDuration" @bind:event="oninput" />
                        </div>
                        <div class="col-6 d-flex flex-column justify-content-center gap-1 pt-1">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="chk_autopause" @bind="_autoPauseEnabled" />
                                <label class="form-check-label text-white-50 small" for="chk_autopause">Oto. Duraklatma</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ─── Görünüm ─── *@
        <div class="col-12 col-xl-4">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header border-secondary py-2">
                    <h6 class="mb-0 text-info small">
                        <i class="fa fa-paint-brush me-1"></i>Görünüm
                    </h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-font me-1"></i>Yazı Tipi</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    @bind="_fontFamily">
                                <option value="'Segoe UI', system-ui, sans-serif">Segoe UI (Varsayılan)</option>
                                <option value="Arial, Helvetica, sans-serif">Arial</option>
                                <option value="'Times New Roman', serif">Times New Roman</option>
                                <option value="Georgia, serif">Georgia</option>
                                <option value="'Courier New', monospace">Courier New</option>
                                <option value="Verdana, Geneva, sans-serif">Verdana</option>
                                <option value="'Trebuchet MS', sans-serif">Trebuchet MS</option>
                                <option value="Tahoma, sans-serif">Tahoma</option>
                                <option value="Palatino, serif">Palatino</option>
                                <option value="'Lucida Console', monospace">Lucida Console</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-align-left me-1"></i>Hizalama</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    @bind="_textAlign">
                                <option value="left">Sola</option>
                                <option value="center">Ortaya</option>
                                <option value="right">Sağa</option>
                                <option value="justify">İki Yana</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-bold me-1"></i>Kalınlık</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    @bind="_fontWeight">
                                <option value="300">İnce (300)</option>
                                <option value="400">Normal (400)</option>
                                <option value="500">Orta (500)</option>
                                <option value="600">Yarı Kalın (600)</option>
                                <option value="700">Kalın (700)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-tint me-1"></i>Metin Rengi</label>
                            <input type="color" class="form-control form-control-sm form-control-color bg-dark border-secondary"
                                   @bind="_textColor" style="width:100%;" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0"><i class="fa fa-square me-1"></i>Arka Plan</label>
                            <input type="color" class="form-control form-control-sm form-control-color bg-dark border-secondary"
                                   @bind="_bgColor" style="width:100%;" />
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="chk_mirror2" @bind="_isMirrored" />
                                <label class="form-check-label text-white-50 small" for="chk_mirror2">
                                    <i class="fa fa-exchange me-1"></i>Ayna
                                </label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="chk_focus2" @bind="_showFocusLine" />
                                <label class="form-check-label text-white-50 small" for="chk_focus2">
                                    <i class="fa fa-minus me-1"></i>Odak Çizgisi
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ─── Odak & Tema ─── *@
        <div class="col-12 col-xl-4">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header border-secondary py-2">
                    <h6 class="mb-0 text-info small">
                        <i class="fa fa-magic me-1"></i>Odak & Tema
                    </h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0">
                                <i class="fa fa-arrows-v me-1"></i>Odak Konumu: @(_focusLinePosition)%
                            </label>
                            <input type="range" class="form-range" min="15" max="85" step="5"
                                   @bind="_focusLinePosition" @bind:event="oninput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 small mb-0">
                                <i class="fa fa-low-vision me-1"></i>Karartma: @((_fadeOpacity * 100).ToString("0"))%
                            </label>
                            <input type="range" class="form-range" min="0" max="0.8" step="0.05"
                                   @bind="_fadeOpacity" @bind:event="oninput" />
                        </div>

                        <div class="col-12 mt-1">
                            <label class="form-label text-white-50 small mb-1"><i class="fa fa-magic me-1"></i>Hazır Temalar</label>
                            <div class="d-flex flex-wrap gap-1">
                                <button class="btn btn-sm border py-0 px-2" style="background:#000; color:#fff; font-size:0.7rem;"
                                        @onclick='() => ApplyTheme("#000000", "#FFFFFF")'>
                                    Klasik
                                </button>
                                <button class="btn btn-sm border py-0 px-2" style="background:#000; color:#0f0; font-size:0.7rem;"
                                        @onclick='() => ApplyTheme("#000000", "#00FF00")'>
                                    Hacker
                                </button>
                                <button class="btn btn-sm border py-0 px-2" style="background:#001529; color:#0dcaf0; font-size:0.7rem;"
                                        @onclick='() => ApplyTheme("#001529", "#0dcaf0")'>
                                    Okyanus
                                </button>
                                <button class="btn btn-sm border py-0 px-2" style="background:#1a1a2e; color:#eaeaea; font-size:0.7rem;"
                                        @onclick='() => ApplyTheme("#1a1a2e", "#eaeaea")'>
                                    Gece
                                </button>
                                <button class="btn btn-sm border py-0 px-2" style="background:#fff; color:#222; font-size:0.7rem;"
                                        @onclick='() => ApplyTheme("#FFFFFF", "#222222")'>
                                    Aydınlık
                                </button>
                                <button class="btn btn-sm border py-0 px-2" style="background:#2d1b00; color:#ffb347; font-size:0.7rem;"
                                        @onclick='() => ApplyTheme("#2d1b00", "#FFB347")'>
                                    Sıcak
                                </button>
                                <button class="btn btn-sm border py-0 px-2" style="background:#0d1117; color:#c9d1d9; font-size:0.7rem;"
                                        @onclick='() => ApplyTheme("#0d1117", "#c9d1d9")'>
                                    GitHub
                                </button>
                            </div>
                        </div>

                        <div class="col-12 mt-2">
                            <label class="form-label text-white-50 small mb-1"><i class="fa fa-floppy-o me-1"></i>Ayar Yönetimi</label>
                            <div class="d-flex flex-wrap gap-1">
                                <button class="btn btn-sm btn-outline-info py-0 px-2" @onclick="SaveSettingsAsync">
                                    <i class="fa fa-save me-1"></i>Kaydet
                                </button>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="LoadSettingsAsync">
                                    <i class="fa fa-download me-1"></i>Yükle
                                </button>
                                <button class="btn btn-sm btn-outline-warning py-0 px-2" @onclick="ResetSettingsToDefault">
                                    <i class="fa fa-refresh me-1"></i>Varsayılan
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   TAM EKRAN SUNUM MODU
   ═══════════════════════════════════════════════════════════════ *@

@if (_isPresenting)
{
    <div id="prompterFullscreen"
         style="position:fixed; top:0; left:0; right:0; bottom:0; z-index:9999;
        background-color:@_bgColor; cursor:none; overflow:hidden;"
         @onmousemove="OnMouseMovePresentation"
         tabindex="0">

        @* ─── Geri Sayım Overlay ─── *@
        @if (_countdownValue > 0)
        {
            <div style="position:absolute; inset:0; display:flex; align-items:center;
                justify-content:center; z-index:10002; background:rgba(0,0,0,0.85);">
                <div style="font-size:min(30vw,200px); font-weight:900; color:#0dcaf0;
                    animation:pulse 0.8s ease-in-out infinite alternate;">
                    @_countdownValue
                </div>
            </div>
        }

        @* ─── Odak Çizgisi ─── *@
        @if (_showFocusLine && _countdownValue == 0)
        {
            <div style="position:absolute; top:@(_focusLinePosition)%; left:0; right:0; height:3px;
            background:rgba(13,202,240,0.7); z-index:10001;
            box-shadow:0 0 20px rgba(13,202,240,0.5); pointer-events:none;"></div>
            <div style="position:absolute; top:0; left:0; right:0; height:@(_focusLinePosition)%;
            background:linear-gradient(to bottom, rgba(0,0,0,@_fadeOpacity), transparent);
            z-index:10000; pointer-events:none;"></div>
            <div style="position:absolute; left:0; right:0; bottom:0;
            height:@(100 - _focusLinePosition)%;
            background:linear-gradient(to top, rgba(0,0,0,@_fadeOpacity), transparent);
            z-index:10000; pointer-events:none;"></div>
        }

        @* ─── Kayan Metin ─── *@
        <div id="prompterScrollContainer"
             style="position:absolute; inset:0; overflow:hidden;">
            <div id="prompterContent"
                 style="padding:50vh @(_marginPercent)% 50vh;
                font-size:@(_fontSize)px;
                line-height:@(_lineHeight.ToString("0.0"));
                font-family:@(_fontFamily);
                color:@_textColor;
                text-align:@_textAlign;
                font-weight:@_fontWeight;
                @(_isMirrored ? "transform:scaleX(-1);" : "")
                will-change:transform;">

                @foreach (var line in _scriptText.Split('\n'))
                {
                    var trimmed = line.Trim();
                    @if (trimmed == "---")
                    {
                        <div class="prompter-bookmark" style="border-top:3px dashed rgba(13,202,240,0.5);
                        margin:0.5em 0;"></div>
                    }
                    else if (trimmed.StartsWith("### "))
                    {
                        <div style="font-size:1.4em; font-weight:800; color:#0dcaf0;
                            margin:1em 0 0.4em; border-bottom:2px solid rgba(13,202,240,0.3);
                            padding-bottom:0.3em;">
                            @trimmed.Substring(4)
                        </div>
                    }
                    else if (trimmed == "[PAUSE]")
                    {
                        <div class="prompter-pause-marker"
                             data-action="pause"
                             style="text-align:center; color:#ffc107; font-size:0.5em;
                            margin:0.5em 0; letter-spacing:4px; opacity:0.8;">
                            ⏸ DURAKLAT ⏸
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(trimmed))
                    {
                        <div style="height:0.8em;"></div>
                    }
                    else
                    {
                        <div style="margin-bottom:0.15em;">@trimmed</div>
                    }
                }
            </div>
        </div>

        @* ─── Üst Kontrol Çubuğu (mouse hareketiyle görünür) ─── *@
        <div style="position:absolute; top:0; left:0; right:0; z-index:10003;
            padding:8px 16px; background:linear-gradient(to bottom, rgba(0,0,0,0.9), transparent);
            display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;
            transition:opacity 0.4s; opacity:@(_showControls ? "1" : "0");
            pointer-events:@(_showControls ? "auto" : "none");">

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-light border-0" @onclick="StopPresentation" title="Çıkış (Esc)">
                    <i class="fa fa-sign-out me-1"></i>Çıkış
                </button>

                <div class="vr mx-1" style="border-color:rgba(255,255,255,0.3);"></div>

                @if (_isScrolling)
                {
                    <button class="btn btn-sm btn-warning border-0" @onclick="PauseScrolling" title="Duraklat (Space)">
                        <i class="fa fa-pause me-1"></i>Duraklat
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-success border-0" @onclick="ResumeScrolling" title="Devam (Space)">
                        <i class="fa fa-play me-1"></i>Devam
                    </button>
                }

                <button class="btn btn-sm btn-outline-light border-0" @onclick="ResetScroll" title="Başa Dön (R)">
                    <i class="fa fa-undo"></i>
                </button>
            </div>

            <div class="d-flex align-items-center gap-3 text-light small">
                <span title="Hız">
                    <i class="fa fa-tachometer me-1"></i>
                    <button class="btn btn-sm btn-outline-light border-0 py-0 px-1" @onclick="DecreaseSpeed" title="Yavaşlat (↓)">
                        <i class="fa fa-minus"></i>
                    </button>
                    <span class="mx-1 fw-bold">@_scrollSpeed</span>
                    <button class="btn btn-sm btn-outline-light border-0 py-0 px-1" @onclick="IncreaseSpeed" title="Hızlandır (↑)">
                        <i class="fa fa-plus"></i>
                    </button>
                </span>

                <span title="Yazı Boyutu">
                    <i class="fa fa-font me-1"></i>
                    <button class="btn btn-sm btn-outline-light border-0 py-0 px-1" @onclick="DecreaseFontSize">
                        <i class="fa fa-minus"></i>
                    </button>
                    <span class="mx-1">@(_fontSize)px</span>
                    <button class="btn btn-sm btn-outline-light border-0 py-0 px-1" @onclick="IncreaseFontSize">
                        <i class="fa fa-plus"></i>
                    </button>
                </span>

                <button class="btn btn-sm @(_isMirrored ? "btn-info" : "btn-outline-light") border-0"
                        @onclick="() => _isMirrored = !_isMirrored" title="Ayna Modu (M)">
                    <i class="fa fa-exchange"></i>
                </button>

                <button class="btn btn-sm @(_showFocusLine ? "btn-info" : "btn-outline-light") border-0"
                        @onclick="() => _showFocusLine = !_showFocusLine" title="Odak Çizgisi (F)">
                    <i class="fa fa-minus"></i>
                </button>
            </div>

            <div class="d-flex align-items-center gap-3 text-light small">
                <span><i class="fa fa-clock-o me-1"></i>@_elapsedDisplay</span>
                <span class="text-white-50">|</span>
                <span><i class="fa fa-hourglass-half me-1"></i>@_remainingDisplay</span>
                <span class="text-info fw-bold">@(_progressPercent.ToString("0"))%</span>
            </div>
        </div>

        @* ─── İlerleme Çubuğu (her zaman görünür, altta) ─── *@
        <div style="position:absolute; bottom:0; left:0; right:0; height:4px;
            z-index:10003; background:rgba(255,255,255,0.1);">
            <div style="height:100%; width:@(_progressPercent.ToString("0.0"))%;
            background:linear-gradient(to right, #0dcaf0, #6610f2);
            transition:width 0.3s;"></div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   MODAL — Yer İmleri
