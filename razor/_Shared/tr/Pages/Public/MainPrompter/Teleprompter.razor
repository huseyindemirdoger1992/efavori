    // AYAR KAYDET / YÜKLE (localStorage via JS)
    // ══════════════════════════════════════════════════════════════

    private async Task SaveSettingsAsync()
    {
        try
        {
            var settings = System.Text.Json.JsonSerializer.Serialize(new
            {
                scrollSpeed = _scrollSpeed,
                fontSize = _fontSize,
                lineHeight = _lineHeight,
                marginPercent = _marginPercent,
                fontFamily = _fontFamily,
                textAlign = _textAlign,
                fontWeight = _fontWeight,
                textColor = _textColor,
                bgColor = _bgColor,
                isMirrored = _isMirrored,
                showFocusLine = _showFocusLine,
                focusLinePosition = _focusLinePosition,
                fadeOpacity = _fadeOpacity,
                countdownDuration = _countdownDuration,
                autoPauseEnabled = _autoPauseEnabled
            });

            await JS.InvokeVoidAsync("eval", $"localStorage.setItem('efavori_teleprompter_settings', '{EscapeJs(settings)}')");
            await Notify("success", "Kaydedildi", "Prompter ayarları kaydedildi.");
        }
        catch (Exception ex)
        {
            await Notify("danger", "Hata", "Ayarlar kaydedilemedi.");
        }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("eval", "localStorage.getItem('efavori_teleprompter_settings')");
            if (string.IsNullOrWhiteSpace(json)) return;

            var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("scrollSpeed", out var v1) && v1.TryGetInt32(out var ss)) _scrollSpeed = ss;
            if (root.TryGetProperty("fontSize", out var v2) && v2.TryGetInt32(out var fs)) _fontSize = fs;
            if (root.TryGetProperty("lineHeight", out var v3) && v3.TryGetDouble(out var lh)) _lineHeight = lh;
            if (root.TryGetProperty("marginPercent", out var v4) && v4.TryGetInt32(out var mp)) _marginPercent = mp;
            if (root.TryGetProperty("fontFamily", out var v5)) _fontFamily = v5.GetString() ?? _fontFamily;
            if (root.TryGetProperty("textAlign", out var v6)) _textAlign = v6.GetString() ?? _textAlign;
            if (root.TryGetProperty("fontWeight", out var v7)) _fontWeight = v7.GetString() ?? _fontWeight;
            if (root.TryGetProperty("textColor", out var v8)) _textColor = v8.GetString() ?? _textColor;
            if (root.TryGetProperty("bgColor", out var v9)) _bgColor = v9.GetString() ?? _bgColor;
            if (root.TryGetProperty("isMirrored", out var v10)) _isMirrored = v10.GetBoolean();
            if (root.TryGetProperty("showFocusLine", out var v11)) _showFocusLine = v11.GetBoolean();
            if (root.TryGetProperty("focusLinePosition", out var v12) && v12.TryGetInt32(out var flp)) _focusLinePosition = flp;
            if (root.TryGetProperty("fadeOpacity", out var v13) && v13.TryGetDouble(out var fo)) _fadeOpacity = fo;
            if (root.TryGetProperty("countdownDuration", out var v14) && v14.TryGetInt32(out var cd)) _countdownDuration = cd;
            if (root.TryGetProperty("autoPauseEnabled", out var v15)) _autoPauseEnabled = v15.GetBoolean();
        }
        catch { }
    }

    private void ResetSettingsToDefault()
    {
        _scrollSpeed = 5;
        _fontSize = 42;
        _lineHeight = 1.6;
        _marginPercent = 10;
        _fontFamily = "'Segoe UI', system-ui, sans-serif";
        _textAlign = "center";
        _fontWeight = "400";
        _textColor = "#FFFFFF";
        _bgColor = "#000000";
        _isMirrored = false;
        _showFocusLine = true;
        _focusLinePosition = 35;
        _fadeOpacity = 0.45;
        _countdownDuration = 3;
        _autoPauseEnabled = true;
        StateHasChanged();
    }

