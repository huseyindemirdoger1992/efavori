    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    private async Task OpenBookmarksModal() => await ShowModal("BookmarksModal");
    private async Task OpenShortcutsModal() => await ShowModal("ShortcutsModal");

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://picsum.photos/120");
    }

    private static string FormatTime(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
            return $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}";
        return $"{ts.Minutes:D2}:{ts.Seconds:D2}";
    }

    private static string EscapeJs(string s) =>
        s.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", "\\r");

