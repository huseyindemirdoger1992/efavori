@using data
@using data._Product
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ══════════════════════════════════════════════════════════════════════════════
   SEO: JSON-LD Structured Data + Open Graph + Twitter Card + Canonical
   ══════════════════════════════════════════════════════════════════════════════ *@
<HeadContent>
    @if (_seo != null || SelectedProduct != null)
    {
        <title>@(_seo?.SeoTitle ?? SelectedProduct?.Name ?? "Ürün Detayı") | efavori</title>
        <meta name="description" content="@(_seo?.SeoDescription ?? SelectedProduct?.ShortDescription ?? "")" />
        <meta name="keywords" content="@(_seo?.SeoKeywords ?? SelectedProduct?.Tags ?? "")" />
        <link rel="canonical" href="@(_seo?.CanonicalUrl ?? $"https://efavori.com/urun/{_seo?.Slug ?? SelectedProduct?.Id.ToString()}")" />

        @* Open Graph *@
        <meta property="og:type" content="product" />
        <meta property="og:title" content="@(_seo?.SeoTitle ?? SelectedProduct?.Name ?? "")" />
        <meta property="og:description" content="@(_seo?.SeoDescription ?? SelectedProduct?.ShortDescription ?? "")" />
        <meta property="og:url" content="@(_seo?.CanonicalUrl ?? $"https://efavori.com/urun/{_seo?.Slug}")" />
        @if (_coverMedia != null)
        {
            <meta property="og:image" content="@_coverMedia.FileUrl" />
        }
        <meta property="og:site_name" content="efavori" />
        <meta property="product:price:amount" content="@_currentPrice?.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
        <meta property="product:price:currency" content="@(_currentPrice?.Currency ?? "TRY")" />

        @* Twitter Card *@
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@(_seo?.SeoTitle ?? SelectedProduct?.Name ?? "")" />
        <meta name="twitter:description" content="@(_seo?.SeoDescription ?? SelectedProduct?.ShortDescription ?? "")" />
        @if (_coverMedia != null)
        {
            <meta name="twitter:image" content="@_coverMedia.FileUrl" />
        }

        @* JSON-LD Structured Data *@
        <script type="application/ld+json">@((MarkupString)GenerateJsonLd())</script>
    }
</HeadContent>

@if (SelectedProduct == null)
{
    <div class="pv-loading" role="status" aria-label="Yükleniyor">
        <div class="pv-loading-pulse"></div>
        <p class="mt-3 text-muted">Ürün bilgileri yükleniyor…</p>
    </div>
}
else
{
    <article class="pv-root" itemscope itemtype="https://schema.org/Product">
        @* ── 1. BREADCRUMB ──────────────────────────────────────────────── *@
        <nav aria-label="Kategori yolu" class="pv-breadcrumb">
            <ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a href="/" itemprop="item"><span itemprop="name">Ana Sayfa</span></a>
                    <meta itemprop="position" content="1" />
                </li>
                @if (_breadcrumbCategories != null)
                {
                    var pos = 2;
                    foreach (var cat in _breadcrumbCategories)
                    {
                        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <a href="/kategori/@cat.Id" itemprop="item"><span itemprop="name">@cat.Name</span></a>
                            <meta itemprop="position" content="@pos" />
                        </li>
                        pos++;
                    }
                }
                <li class="breadcrumb-item active" aria-current="page">@SelectedProduct.Name</li>
            </ol>
        </nav>

        @* ── 2-7. ANA İÇERİK ALANI ─────────────────────────────────────── *@
        <div class="pv-main">
            @* ═══ SOL KOLON: MEDYA GALERİSİ ═══ *@
            <section class="pv-media" aria-label="Ürün görselleri">
                @* Aktif büyük görsel *@
                <div class="pv-media-main" @onclick="OpenLightbox" role="button" tabindex="0"
                     aria-label="Görseli büyütmek için tıklayın" @onkeydown="@(e => { if (e.Key == "Enter") OpenLightbox(); })">
                    @if (!string.IsNullOrEmpty(GetActiveMediaUrl()))
                    {
                        <img src="@GetActiveMediaUrl()"
                             alt="@(SelectedProduct.Name ?? "Ürün görseli")"
                             class="pv-media-img"
                             loading="eager"
                             itemprop="image"
                             draggable="false" />
                        <div class="pv-media-zoom-hint">
                            <i class="fa fa-search-plus" aria-hidden="true"></i>
                        </div>
                    }
                    else
                    {
                        <div class="pv-media-placeholder">
                            <i class="fa fa-image fa-3x text-muted" aria-hidden="true"></i>
                            <span class="text-muted mt-2">Görsel bulunamadı</span>
                        </div>
                    }
                    @if (_currentPrice?.DiscountedPrice != null && _currentPrice.DiscountedPrice < _currentPrice.Price)
                    {
                        <span class="pv-badge-discount" aria-label="@(CalculateDiscountPercent())% indirim">
                            %@(CalculateDiscountPercent())
                        </span>
                    }
                    @if (SelectedProduct.ProductType == "Digital")
                    {
                        <span class="pv-badge-type"><i class="fa fa-download" aria-hidden="true"></i> Dijital</span>
                    }
                </div>

                @* Thumbnail şeridi *@
                <div class="pv-thumbs" role="listbox" aria-label="Ürün görselleri listesi">
                    @{
                        var thumbIdx = 0;
                    }
                    @if (_coverMedia != null)
                    {
                        var idx = thumbIdx;
                        <button class="pv-thumb @(_activeMediaIndex == idx ? "active" : "")"
                                @onclick="() => SetActiveMedia(idx)" role="option"
                                aria-selected="@(_activeMediaIndex == idx)" aria-label="Kapak görseli">
                            <img src="@_coverMedia.FileUrl" alt="Kapak" loading="lazy" />
                        </button>
                        thumbIdx++;
                    }
                    @if (_galleryMedias != null)
                    {
                        foreach (var gm in _galleryMedias)
                        {
                            var idx = thumbIdx;
                            <button class="pv-thumb @(_activeMediaIndex == idx ? "active" : "")"
                                    @onclick="() => SetActiveMedia(idx)" role="option"
                                    aria-selected="@(_activeMediaIndex == idx)" aria-label="Galeri görseli @(idx)">
                                <img src="@gm.FileUrl" alt="Galeri @(idx)" loading="lazy" />
                            </button>
                            thumbIdx++;
                        }
                    }
                    @if (_variantGroupMedias != null && _selectedVariantGroupId != null)
                    {
                        var vgMedias = _variantGroupMedias.Where(x => x.groupId == _selectedVariantGroupId.Value).SelectMany(x => x.medias).ToList();
                        foreach (var vm in vgMedias)
                        {
                            var idx = thumbIdx;
                            <button class="pv-thumb @(_activeMediaIndex == idx ? "active" : "")"
                                    @onclick="() => SetActiveMedia(idx)" role="option"
                                    aria-selected="@(_activeMediaIndex == idx)" aria-label="Varyant görseli">
                                <img src="@vm.FileUrl" alt="Varyant görseli" loading="lazy" />
                            </button>
                            thumbIdx++;
                        }
                    }
                    @* Video thumbnail *@
                    @if (_externalMedias != null)
                    {
                        foreach (var em in _externalMedias.Where(x => x.MediaType == "VideoUrl"))
                        {
                            <button class="pv-thumb pv-thumb-video" @onclick="() => PlayVideo(em.Url)"
                                    aria-label="@(em.Title ?? "Video")">
                                <i class="fa fa-play-circle fa-2x" aria-hidden="true"></i>
                                <span class="pv-thumb-label">Video</span>
                            </button>
                        }
                        @if (_externalMedias.Any(x => x.MediaType == "View360"))
                        {
                            <button class="pv-thumb pv-thumb-360" @onclick="() => Show360()"
                                    aria-label="360 derece görüntü">
                                <i class="fa fa-repeat fa-2x" aria-hidden="true"></i>
                                <span class="pv-thumb-label">360°</span>
                            </button>
                        }
                    }
                </div>
            </section>

            @* ═══ SAĞ KOLON: ÜRÜN BİLGİ + SATIN ALMA ═══ *@
            <section class="pv-info">
                @* ── 3. ÜRÜN BİLGİLERİ ────────────────────────────────────── *@
                <div class="pv-info-header">
                    @if (_brand != null)
                    {
                        <a href="/marka/@_brand.Slug" class="pv-brand" itemprop="brand" itemscope itemtype="https://schema.org/Brand">
                            @if (_brandLogoMedia != null)
                            {
                                <img src="@_brandLogoMedia.FileUrl" alt="@_brand.Name" class="pv-brand-logo" loading="lazy" />
                            }
                            <span itemprop="name">@_brand.Name</span>
                        </a>
                    }
                    <h1 class="pv-title" itemprop="name">@SelectedProduct.Name</h1>

                    <div class="pv-meta-row">
                        @if (_defaultVariant != null)
                        {
                            @if (!string.IsNullOrEmpty(_defaultVariant.Sku))
                            {
                                <span class="pv-meta-item" title="SKU">
                                    <i class="fa fa-barcode" aria-hidden="true"></i> SKU: <span itemprop="sku">@_defaultVariant.Sku</span>
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(_defaultVariant.Barcode))
                            {
                                <span class="pv-meta-item" title="Barkod">
                                    <i class="fa fa-qrcode" aria-hidden="true"></i> @_defaultVariant.Barcode
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(_defaultVariant.Mpn))
                            {
                                <span class="pv-meta-item" itemprop="mpn" content="@_defaultVariant.Mpn" title="Üretici Parça No">
                                    MPN: @_defaultVariant.Mpn
                                </span>
                            }
                        }
                        @if (!string.IsNullOrEmpty(SelectedProduct.ProductType) && SelectedProduct.ProductType != "Simple")
                        {
                            <span class="pv-meta-item pv-type-badge">@GetProductTypeLabel(SelectedProduct.ProductType)</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(SelectedProduct.ShortDescription))
                    {
                        <p class="pv-short-desc" itemprop="description">@SelectedProduct.ShortDescription</p>
                    }
                </div>

                @* ── 4. FİYAT ALANI ───────────────────────────────────────── *@
                <div class="pv-price-box" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                    <meta itemprop="priceCurrency" content="@(_currentPrice?.Currency ?? "TRY")" />
                    <link itemprop="availability" href="@(GetSchemaAvailability())" />
                    <meta itemprop="url" content="@(_seo?.CanonicalUrl ?? "")" />

                    @if (_currentPrice != null)
                    {
                        @if (_currentPrice.DiscountedPrice != null && _currentPrice.DiscountedPrice < _currentPrice.Price)
                        {
                            <div class="pv-price-campaign">
                                <span class="pv-price-old">@FormatPrice(_currentPrice.Price, _currentPrice.Currency)</span>
                                <span class="pv-discount-tag">%@(CalculateDiscountPercent()) İndirim</span>
                            </div>
                            <div class="pv-price-current" itemprop="price" content="@_currentPrice.DiscountedPrice.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                @FormatPrice(_currentPrice.DiscountedPrice.Value, _currentPrice.Currency)
                            </div>
                        }
                        else
                        {
                            <div class="pv-price-current" itemprop="price" content="@_currentPrice.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                @FormatPrice(_currentPrice.Price, _currentPrice.Currency)
                            </div>
                        }
                        <div class="pv-price-vat">KDV Dahil</div>

                        @* Taksit bilgisi *@

                        var effectivePrice = _currentPrice.DiscountedPrice ?? _currentPrice.Price;
                        if (effectivePrice >= 100)
                        {
                            <div class="pv-installment">
                                <i class="fa fa-credit-card" aria-hidden="true"></i>
                                <span>
                                    <strong>@FormatPrice(effectivePrice / 6, _currentPrice.Currency)</strong>'den
                                    başlayan taksitlerle <a href="#installment-section" class="pv-link">6 taksit</a>
                                </span>
                            </div>
                        }

                    }
                    else
                    {
                        <div class="pv-price-unavailable">Fiyat bilgisi bulunamadı</div>
                    }
                </div>

                @* ── 5. VARYASYON SEÇİCİ ──────────────────────────────────── *@
                @if (_variantAttributes != null && _variantAttributes.Any())
                {
                    <div class="pv-variants" role="group" aria-label="Ürün seçenekleri">
                        @foreach (var attr in _variantAttributes)
                        {
                            <div class="pv-variant-group">
                                <label class="pv-variant-label">
                                    @attr.attributeName
                                    @if (_selectedVariantValues.ContainsKey(attr.attributeId))
                                    {
                                        <span class="pv-variant-selected">: @GetValueDisplay(attr.attributeId)</span>
                                    }
                                </label>
                                <div class="pv-variant-options" role="radiogroup" aria-label="@attr.attributeName seçenekleri">
                                    @foreach (var val in attr.values)
                                    {
                                        var isSelected = _selectedVariantValues.ContainsKey(attr.attributeId) &&
                                                         _selectedVariantValues[attr.attributeId] == val.valueId;
                                        var isAvailable = IsVariantValueAvailable(attr.attributeId, val.valueId);

                                        @if (!string.IsNullOrEmpty(val.colorHex))
                                        {
                                            @* Renk seçici — swatch *@
                                            <button class="pv-swatch @(isSelected ? "active" : "") @(!isAvailable ? "disabled" : "")"
                                                    style="--swatch-color: @val.colorHex"
                                                    @onclick="() => SelectVariantValue(attr.attributeId, val.valueId)"
                                                    disabled="@(!isAvailable)"
                                                    title="@val.value"
                                                    role="radio" aria-checked="@isSelected" aria-label="@val.value">
                                                @if (isSelected)
                                                {
                                                    <i class="fa fa-check" aria-hidden="true"></i>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            @* Metin seçici — chip *@
                                            <button class="pv-chip @(isSelected ? "active" : "") @(!isAvailable ? "disabled" : "")"
                                                    @onclick="() => SelectVariantValue(attr.attributeId, val.valueId)"
                                                    disabled="@(!isAvailable)"
                                                    role="radio" aria-checked="@isSelected" aria-label="@val.value">
                                                @val.value @if(!string.IsNullOrEmpty(val.unit)) {
                                                <small>@val.unit</small>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @* ── 6. STOK DURUMU ───────────────────────────────────────── *@
            <div class="pv-stock" aria-live="polite">
                @{
                    var totalStock = _selectedVariantStocks?.Sum(s => s.Quantity) ?? 0;
                    var stockStatus = _selectedVariantStocks?.FirstOrDefault()?.StockStatus ?? "OutOfStock";
                    var trackStock = _selectedVariantStocks?.FirstOrDefault()?.TrackStock ?? true;
                    var criticalLevel = _selectedVariantStocks?.FirstOrDefault()?.CriticalStockLevel ?? 5;
                }
                @if (!trackStock)
                {
                    <span class="pv-stock-badge pv-stock-in"><i class="fa fa-check-circle" aria-hidden="true"></i> Stokta</span>
                }
                else if (stockStatus == "PreOrder")
                {
                    <span class="pv-stock-badge pv-stock-preorder"><i class="fa fa-clock-o" aria-hidden="true"></i> Ön Sipariş</span>
                }
                else if (stockStatus == "Backorder")
                {
                    <span class="pv-stock-badge pv-stock-backorder"><i class="fa fa-truck" aria-hidden="true"></i> Tedarik Sürecinde</span>
                }
                else if (totalStock <= 0)
                {
                    <span class="pv-stock-badge pv-stock-out"><i class="fa fa-times-circle" aria-hidden="true"></i> Tükendi</span>
                }
                else if (totalStock <= criticalLevel)
                {
                    <span class="pv-stock-badge pv-stock-critical">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                        Son @totalStock adet — Tükenmek üzere!
                    </span>
                }
                else
                {
                    <span class="pv-stock-badge pv-stock-in"><i class="fa fa-check-circle" aria-hidden="true"></i> Stokta</span>
                }
            </div>

            @* ── 7. SATIN ALMA KUTUSU ─────────────────────────────────── *@
            <div class="pv-purchase-box">
                @if (SelectedProduct.ProductType == "External")
                {
                    <a href="@SelectedProduct.ExternalUrl" target="_blank" rel="noopener noreferrer"
                       class="pv-btn pv-btn-primary w-100">
                        <i class="fa fa-external-link" aria-hidden="true"></i>
                        @(SelectedProduct.ExternalButtonText ?? "Satıcı Sitesinde Gör")
                    </a>
                }
                else
                {
                    
                        var canPurchase = totalStock > 0 || !trackStock || stockStatus == "PreOrder" || stockStatus == "Backorder";
                        var maxQty = _selectedVariantStocks?.FirstOrDefault()?.MaxOrderQuantity ?? (trackStock ? totalStock : 99);
                        if (maxQty <= 0) maxQty = 1;
                    
                    <div class="pv-qty-row">
                        <label for="pv-qty" class="visually-hidden">Adet</label>
                        <div class="pv-qty-control">
                            <button class="pv-qty-btn" @onclick="() => AdjustQuantity(-1)" disabled="@(_quantity <= 1)"
                                    aria-label="Azalt">
                                <i class="fa fa-minus" aria-hidden="true"></i>
                            </button>
                            <input type="number" id="pv-qty" class="pv-qty-input" min="1" max="@maxQty"
                                   @bind="_quantity" @bind:event="onchange" aria-label="Adet" />
                            <button class="pv-qty-btn" @onclick="() => AdjustQuantity(1)" disabled="@(_quantity >= maxQty)"
                                    aria-label="Artır">
                                <i class="fa fa-plus" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="pv-action-buttons">
                        <button class="pv-btn pv-btn-primary pv-btn-cart" disabled="@(!canPurchase)"
                                @onclick="AddToCart" aria-label="Sepete ekle">
                            <i class="fa fa-shopping-cart" aria-hidden="true"></i> Sepete Ekle
                        </button>
                        <button class="pv-btn pv-btn-accent pv-btn-buy" disabled="@(!canPurchase)"
                                @onclick="BuyNow" aria-label="Hemen al">
                            <i class="fa fa-bolt" aria-hidden="true"></i> Hemen Al
                        </button>
                    </div>

                    <div class="pv-secondary-actions">
                        <button class="pv-icon-btn" @onclick="ToggleFavorite" aria-label="@(_isFavorited ? "Favorilerden çıkar" : "Favorilere ekle")">
                            <i class="fa @(_isFavorited ? "fa-heart" : "fa-heart-o")" aria-hidden="true"></i>
                            <span>Favori</span>
                        </button>
                        <button class="pv-icon-btn" @onclick="ToggleCompare" aria-label="Karşılaştır">
                            <i class="fa fa-exchange" aria-hidden="true"></i>
                            <span>Karşılaştır</span>
                        </button>
                        <button class="pv-icon-btn" @onclick="ShareProduct" aria-label="Paylaş">
                            <i class="fa fa-share-alt" aria-hidden="true"></i>
                            <span>Paylaş</span>
                        </button>
                    </div>
                }
            </div>

            @* ── 8. GÜVEN ALANI ────────────────────────────────────────── *@
            <div class="pv-trust">
                <div class="pv-trust-item">
                    <i class="fa fa-shield" aria-hidden="true"></i>
                    <div>
                        <strong>Güvenli Ödeme</strong>
                        <small>256-bit SSL ile korunur</small>
                    </div>
                </div>
                <div class="pv-trust-item">
                    <i class="fa fa-undo" aria-hidden="true"></i>
                    <div>
                        <strong>Kolay İade</strong>
                        <small>14 gün içinde ücretsiz</small>
                    </div>
                </div>
                <div class="pv-trust-item">
                    <i class="fa fa-certificate" aria-hidden="true"></i>
                    <div>
                        <strong>Orijinal Ürün</strong>
                        <small>Garanti belgeli</small>
                    </div>
                </div>
                <div class="pv-trust-item">
                    <i class="fa fa-truck" aria-hidden="true"></i>
                    <div>
                        <strong>Hızlı Kargo</strong>
                        <small>1–3 iş günü</small>
                    </div>
                </div>
            </div>
        </section>
    </div>

    @* ── 9-25. DETAY SEKMELERI ─────────────────────────────────────── *@
    <div class="pv-detail-tabs">
        @* Tab navigasyonu *@
        <nav class="pv-tab-nav" role="tablist" aria-label="Ürün detay sekmeleri">
            <button class="pv-tab @(_activeTab == "desc" ? "active" : "")" role="tab"
                    aria-selected="@(_activeTab == "desc")" aria-controls="tab-desc"
                    @onclick='() => _activeTab = "desc"'>
                <i class="fa fa-align-left" aria-hidden="true"></i> Açıklama
            </button>
            @if (_specifications != null && _specifications.Any())
            {
                <button class="pv-tab @(_activeTab == "specs" ? "active" : "")" role="tab"
                        aria-selected="@(_activeTab == "specs")" aria-controls="tab-specs"
                        @onclick='() => _activeTab = "specs"'>
                    <i class="fa fa-list-alt" aria-hidden="true"></i> Teknik Özellikler
                </button>
            }
            @if (_externalMedias != null && _externalMedias.Any(x => x.MediaType == "Document"))
            {
                <button class="pv-tab @(_activeTab == "docs" ? "active" : "")" role="tab"
                        aria-selected="@(_activeTab == "docs")" aria-controls="tab-docs"
                        @onclick='() => _activeTab = "docs"'>
                    <i class="fa fa-file-pdf-o" aria-hidden="true"></i> Belgeler
                </button>
            }
            @if (_digitalAssets != null && _digitalAssets.Any())
            {
                <button class="pv-tab @(_activeTab == "digital" ? "active" : "")" role="tab"
                        aria-selected="@(_activeTab == "digital")" aria-controls="tab-digital"
                        @onclick='() => _activeTab = "digital"'>
                    <i class="fa fa-download" aria-hidden="true"></i> Dijital İçerikler
                </button>
            }
            @if (_bundleItems != null && _bundleItems.Any())
            {
                <button class="pv-tab @(_activeTab == "bundle" ? "active" : "")" role="tab"
                        aria-selected="@(_activeTab == "bundle")" aria-controls="tab-bundle"
                        @onclick='() => _activeTab = "bundle"'>
                    <i class="fa fa-cubes" aria-hidden="true"></i> Paket İçeriği
                </button>
            }
            <button class="pv-tab @(_activeTab == "seller" ? "active" : "")" role="tab"
                    aria-selected="@(_activeTab == "seller")" aria-controls="tab-seller"
                    @onclick='() => _activeTab = "seller"'>
                <i class="fa fa-store" aria-hidden="true"></i> Satıcı Bilgileri
            </button>
        </nav>

        @* ── Tab içerikleri ─────────────────────────────────────────── *@

        @* 12. Ürün Açıklaması *@
        <div id="tab-desc" class="pv-tab-panel @(_activeTab == "desc" ? "active" : "")" role="tabpanel">
            @if (!string.IsNullOrEmpty(SelectedProduct.FullDescription))
            {
                <div class="pv-description" itemprop="description">
                    @((MarkupString)SelectedProduct.FullDescription)
                </div>
            }
            else if (!string.IsNullOrEmpty(SelectedProduct.ShortDescription))
            {
                <p class="pv-description">@SelectedProduct.ShortDescription</p>
            }
            else
            {
                <p class="text-muted">Bu ürün için henüz detaylı açıklama eklenmemiştir.</p>
            }

            @* Video alanı — tab içinde *@
            @if (_externalMedias != null && _externalMedias.Any(x => x.MediaType == "VideoUrl"))
            {
                <div class="pv-section-divider"></div>
                <h3 class="pv-section-title"><i class="fa fa-play-circle" aria-hidden="true"></i> Ürün Videoları</h3>
                <div class="pv-video-grid">
                    @foreach (var vid in _externalMedias.Where(x => x.MediaType == "VideoUrl"))
                    {
                        <div class="pv-video-card">
                            <div class="pv-video-embed">
                                <iframe src="@ConvertToEmbedUrl(vid.Url)" title="@(vid.Title ?? "Ürün videosu")"
                                        loading="lazy" allowfullscreen
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                </iframe>
                            </div>
                            @if (!string.IsNullOrEmpty(vid.Title))
                            {
                                <p class="pv-video-title">@vid.Title</p>
                            }
                        </div>
                    }
                </div>
            }

            @* Etiketler *@
            @if (!string.IsNullOrEmpty(SelectedProduct.Tags))
            {
                <div class="pv-section-divider"></div>
                <div class="pv-tags" aria-label="Etiketler">
                    @foreach (var tag in SelectedProduct.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <a href="/arama?q=@Uri.EscapeDataString(tag)" class="pv-tag">
                            <i class="fa fa-tag" aria-hidden="true"></i> @tag
                        </a>
                    }
                </div>
            }

            @* 25. SEO İçerik Bölümü *@
            @if (_seo != null && !string.IsNullOrEmpty(_seo.SeoDescription))
            {
                <div class="pv-section-divider"></div>
                <div class="pv-seo-content" aria-label="Ürün hakkında">
                    <h2 class="pv-section-title">@(SelectedProduct.Name) Hakkında</h2>
                    <p>@_seo.SeoDescription</p>
                </div>
            }
        </div>

        @* 9-10. Teknik Özellikler *@
        @if (_specifications != null && _specifications.Any())
        {
            <div id="tab-specs" class="pv-tab-panel @(_activeTab == "specs" ? "active" : "")" role="tabpanel">
                <table class="pv-specs-table" aria-label="Teknik özellikler tablosu">
                    <tbody>
                        @foreach (var spec in _specifications.OrderBy(s => s.displayOrder))
                        {
                            <tr>
                                <th scope="row">@(spec.name)</th>
                                <td>@(spec.value) @(spec.unit)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* GTIN / EAN / ISBN / UPC bilgisi varsa ek satır *@
                @if (_selectedVariant != null)
                {
                    var idFields = new List<(string label, string? val)>
                        {
                            ("GTIN", _selectedVariant.Gtin),
                            ("EAN", _selectedVariant.Ean),
                            ("UPC", _selectedVariant.Upc),
                            ("ISBN", _selectedVariant.Isbn),
                            ("MPN", _selectedVariant.Mpn),
                        };
                    @if (idFields.Any(f => !string.IsNullOrEmpty(f.val)))
                    {
                        <h3 class="pv-section-title mt-4">Tanımlayıcı Kodlar</h3>
                        <table class="pv-specs-table">
                            <tbody>
                                @foreach (var f in idFields.Where(f => !string.IsNullOrEmpty(f.val)))
                                {
                                    <tr><th scope="row">@f.label</th><td>@f.val</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }

                @* Fiziksel özellikler *@
                @if (_selectedVariant != null &&
                     (_selectedVariant.WeightKg > 0 || _selectedVariant.WidthCm > 0 || _selectedVariant.HeightCm > 0 || _selectedVariant.LengthCm > 0))
                {
                    <h3 class="pv-section-title mt-4">Fiziksel Boyutlar</h3>
                    <table class="pv-specs-table">
                        <tbody>
                            @if (_selectedVariant.WeightKg > 0)
                            {
                                <tr><th scope="row">Ağırlık</th><td>@_selectedVariant.WeightKg kg</td></tr>
                            }
                            @if (_selectedVariant.WidthCm > 0)
                            {
                                <tr><th scope="row">Genişlik</th><td>@_selectedVariant.WidthCm cm</td></tr>
                            }
                            @if (_selectedVariant.HeightCm > 0)
                            {
                                <tr><th scope="row">Yükseklik</th><td>@_selectedVariant.HeightCm cm</td></tr>
                            }
                            @if (_selectedVariant.LengthCm > 0)
                            {
                                <tr><th scope="row">Uzunluk</th><td>@_selectedVariant.LengthCm cm</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        @* 14. Ürün Belgeleri *@
        @if (_externalMedias != null && _externalMedias.Any(x => x.MediaType == "Document"))
        {
            <div id="tab-docs" class="pv-tab-panel @(_activeTab == "docs" ? "active" : "")" role="tabpanel">
                <div class="pv-docs-grid">
                    @foreach (var doc in _externalMedias.Where(x => x.MediaType == "Document").OrderBy(x => x.DisplayOrder))
                    {
                        var docMedia = doc.MediaId.HasValue ? _allMediaDict.GetValueOrDefault(doc.MediaId.Value) : null;
                        <div class="pv-doc-card">
                            <div class="pv-doc-icon"><i class="fa fa-file-pdf-o fa-2x" aria-hidden="true"></i></div>
                            <div class="pv-doc-info">
                                <strong>@(doc.Title ?? "Belge")</strong>
                                @if (docMedia != null)
                                {
                                    <small class="text-muted">@FormatFileSize(docMedia.OriginalSize)</small>
                                }
                            </div>
                            @if (docMedia != null)
                            {
                                <a href="@docMedia.FileUrl" target="_blank" rel="noopener" class="pv-btn pv-btn-outline-sm">
                                    <i class="fa fa-download" aria-hidden="true"></i> İndir
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(doc.Url))
                            {
                                <a href="@doc.Url" target="_blank" rel="noopener" class="pv-btn pv-btn-outline-sm">
                                    <i class="fa fa-external-link" aria-hidden="true"></i> Görüntüle
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* 13. Dijital İçerikler *@
        @if (_digitalAssets != null && _digitalAssets.Any())
        {
            <div id="tab-digital" class="pv-tab-panel @(_activeTab == "digital" ? "active" : "")" role="tabpanel">
                <div class="pv-digital-list">
                    @foreach (var asset in _digitalAssets)
                    {
                        var assetMedia = _allMediaDict.GetValueOrDefault(asset.MediaId);
                        <div class="pv-digital-card">
                            <div class="pv-digital-icon">
                                <i class="fa fa-file-o fa-2x" aria-hidden="true"></i>
                            </div>
                            <div class="pv-digital-info">
                                <strong>@(asset.DisplayName ?? "Dijital İçerik")</strong>
                                <div class="pv-digital-meta">
                                    @if (asset.DownloadLimit.HasValue)
                                    {
                                        <span><i class="fa fa-download" aria-hidden="true"></i> Maks. @asset.DownloadLimit indirme</span>
                                    }
                                    else
                                    {
                                        <span><i class="fa fa-infinity" aria-hidden="true"></i> Sınırsız indirme</span>
                                    }
                                    @if (asset.ExpirationDays.HasValue)
                                    {
                                        <span><i class="fa fa-calendar" aria-hidden="true"></i> @asset.ExpirationDays gün geçerli</span>
                                    }
                                    @if (asset.RequiresLicenseKey)
                                    {
                                        <span class="pv-license-badge"><i class="fa fa-key" aria-hidden="true"></i> Lisans anahtarı dahil</span>
                                    }
                                </div>
                                @if (assetMedia != null)
                                {
                                    <small class="text-muted">@assetMedia.FileExtensionType?.ToUpperInvariant() — @FormatFileSize(assetMedia.OriginalSize)</small>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* 18. Paket İçeriği *@
        @if (_bundleItems != null && _bundleItems.Any())
        {
            <div id="tab-bundle" class="pv-tab-panel @(_activeTab == "bundle" ? "active" : "")" role="tabpanel">
                <div class="pv-bundle-list">
                    @foreach (var bi in _bundleItems.OrderBy(b => b.displayOrder))
                    {
                        <div class="pv-bundle-card">
                            @if (bi.coverUrl != null)
                            {
                                <img src="@bi.coverUrl" alt="@bi.productName" class="pv-bundle-img" loading="lazy" />
                            }
                            else
                            {
                                <div class="pv-bundle-img-placeholder"><i class="fa fa-cube" aria-hidden="true"></i></div>
                            }
                            <div class="pv-bundle-info">
                                <strong>@bi.productName</strong>
                                @if (bi.variantLabel != null)
                                {
                                    <small class="text-muted">@bi.variantLabel</small>
                                }
                                <span class="pv-bundle-qty">×@bi.quantity</span>
                                @if (bi.discountRate > 0)
                                {
                                    <span class="pv-badge-discount-sm">%@bi.discountRate paket indirimi</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* 21. Satıcı Bilgileri *@
        <div id="tab-seller" class="pv-tab-panel @(_activeTab == "seller" ? "active" : "")" role="tabpanel"
             itemprop="seller" itemscope itemtype="https://schema.org/Organization">
            @if (_store != null)
            {
                <div class="pv-seller-card">
                    <div class="pv-seller-header">
                        @if (_storeProfileMedia != null)
                        {
                            <img src="@_storeProfileMedia.FileUrl" alt="@_store.Name" class="pv-seller-avatar" loading="lazy" itemprop="logo" />
                        }
                        else
                        {
                            <div class="pv-seller-avatar-placeholder">
                                <i class="fa fa-store fa-2x" aria-hidden="true"></i>
                            </div>
                        }
                        <div>
                            <h3 class="pv-seller-name" itemprop="name">@_store.Name</h3>
                            @if (_store.CreatedAt.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="fa fa-calendar-o" aria-hidden="true"></i>
                                    @((DateTime.UtcNow - _store.CreatedAt.Value).Days / 365) yıldır efavori'de
                                </small>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_store.Description))
                    {
                        <p class="pv-seller-desc" itemprop="description">@_store.Description</p>
                    }
                    <div class="pv-seller-stats">
                        @if (_store.Interaction?.ViewCount > 0)
                        {
                            <div class="pv-seller-stat">
                                <strong>@_store.Interaction.ViewCount</strong>
                                <small>Görüntülenme</small>
                            </div>
                        }
                        @if (_store.Interaction?.LikeCount > 0)
                        {
                            <div class="pv-seller-stat">
                                <strong>@_store.Interaction.LikeCount</strong>
                                <small>Beğeni</small>
                            </div>
                        }
                    </div>
                    <a href="/magaza/@_store.Id" class="pv-btn pv-btn-outline w-100 mt-3">
                        <i class="fa fa-external-link" aria-hidden="true"></i> Mağazayı Ziyaret Et
                    </a>
                </div>
            }
        </div>
    </div>

    @* ── 20. SOSYAL KANIT ─────────────────────────────────────────── *@
    @if (SelectedProduct.Interaction != null &&
        (SelectedProduct.Interaction.ViewCount > 0 || SelectedProduct.Interaction.LikeCount > 0))
    {
        <section class="pv-social-proof" aria-label="Popülerlik bilgisi">
            @if (SelectedProduct.Interaction.ViewCount > 100)
            {
                <div class="pv-proof-item">
                    <i class="fa fa-eye" aria-hidden="true"></i>
                    <span>Son 30 günde <strong>@SelectedProduct.Interaction.ViewCount</strong> kez görüntülendi</span>
                </div>
            }
            @if (SelectedProduct.Interaction.LikeCount > 0)
            {
                <div class="pv-proof-item">
                    <i class="fa fa-heart" aria-hidden="true"></i>
                    <span><strong>@SelectedProduct.Interaction.LikeCount</strong> kişi favorilerine ekledi</span>
                </div>
            }
        </section>
    }

</article>

@* ── 23. MOBİL STICKY SATIN ALMA BARI ─────────────────────────────── *@
<div class="pv-mobile-sticky" aria-label="Hızlı satın alma">
    <div class="pv-mobile-sticky-price">
        @if (_currentPrice != null)
        {
            @if (_currentPrice.DiscountedPrice.HasValue && _currentPrice.DiscountedPrice < _currentPrice.Price)
            {
                <span class="pv-mobile-old-price">@FormatPrice(_currentPrice.Price, _currentPrice.Currency)</span>
                <span class="pv-mobile-current-price">@FormatPrice(_currentPrice.DiscountedPrice.Value, _currentPrice.Currency)</span>
            }
            else
            {
                <span class="pv-mobile-current-price">@FormatPrice(_currentPrice.Price, _currentPrice.Currency)</span>
            }
        }
    </div>
    <button class="pv-btn pv-btn-primary pv-mobile-cart-btn" @onclick="AddToCart"
            disabled="@(totalStock <= 0 && trackStock && stockStatus != "PreOrder" && stockStatus != "Backorder")"
            aria-label="Sepete ekle">
        <i class="fa fa-shopping-cart" aria-hidden="true"></i> Sepete Ekle
    </button>
</div>

@* ── LIGHTBOX MODAL ──────────────────────────────────────────────── *@
@if (_lightboxOpen)
{
    <div class="pv-lightbox" role="dialog" aria-label="Görsel önizleme" @onclick="CloseLightbox"
         @onkeydown="HandleLightboxKey" tabindex="0">
        <button class="pv-lightbox-close" @onclick="CloseLightbox" @onclick:stopPropagation="true"
                aria-label="Kapat">
            <i class="fa fa-times fa-2x" aria-hidden="true"></i>
        </button>
        <button class="pv-lightbox-prev" @onclick="LightboxPrev" @onclick:stopPropagation="true"
                aria-label="Önceki görsel">
            <i class="fa fa-chevron-left fa-2x" aria-hidden="true"></i>
        </button>
        <div class="pv-lightbox-content" @onclick:stopPropagation="true">
            <img src="@GetActiveMediaUrl()" alt="@SelectedProduct.Name" />
        </div>
        <button class="pv-lightbox-next" @onclick="LightboxNext" @onclick:stopPropagation="true"
                aria-label="Sonraki görsel">
            <i class="fa fa-chevron-right fa-2x" aria-hidden="true"></i>
        </button>
        <div class="pv-lightbox-counter">
            @(_activeMediaIndex + 1) / @_allMediaUrls.Count
        </div>
    </div>
}

@* ── VİDEO MODAL ─────────────────────────────────────────────────── *@
@if (_videoModalOpen && !string.IsNullOrEmpty(_activeVideoUrl))
{
    <div class="pv-lightbox" role="dialog" aria-label="Video oynatıcı" @onclick="CloseVideoModal">
        <button class="pv-lightbox-close" @onclick="CloseVideoModal" @onclick:stopPropagation="true" aria-label="Kapat">
            <i class="fa fa-times fa-2x" aria-hidden="true"></i>
        </button>
        <div class="pv-video-modal-content" @onclick:stopPropagation="true">
            <iframe src="@ConvertToEmbedUrl(_activeVideoUrl)" allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    title="Ürün videosu">
            </iframe>
        </div>
    </div>
}
}

@code {
    // ─── Parametreler ─────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }
    [Parameter] public Products? SelectedProduct { get; set; }

    // ─── CancellationToken ────────────────────────────────────────
    private CancellationTokenSource _cts = new();

    // ─── Yüklenen Veri ────────────────────────────────────────────
    private Brands? _brand;
    private Media? _brandLogoMedia;
    private Media? _coverMedia;
    private ProductSeo? _seo;
    private Store? _store;
    private Media? _storeProfileMedia;
    private ProductVariants? _defaultVariant;
    private ProductVariants? _selectedVariant;
    private ProductPrices? _currentPrice;
    private List<Media>? _galleryMedias;
    private List<ProductStocks>? _selectedVariantStocks;
    private List<ProductDigitalAssets>? _digitalAssets;
    private List<ProductExternalMedias>? _externalMedias;
    private List<CategoriesTr> _breadcrumbCategories = new();

    // Varyant sistemi
    private List<(Guid attributeId, string attributeName, string? unit, List<(Guid valueId, string value, string? colorHex, string? unit)> values)>? _variantAttributes;
    private Dictionary<Guid, Guid> _selectedVariantValues = new();
    private Guid? _selectedVariantGroupId;
    private List<(Guid groupId, Guid attributeValueId, List<Media> medias)>? _variantGroupMedias;

    // Tüm varyant + fiyat + stok verileri (seçim hesaplamaları için)
    private List<ProductVariants>? _allVariants;
    private List<ProductVariantValues>? _allVariantValues;
    private List<ProductPrices>? _allCurrentPrices;
    private List<ProductStocks>? _allStocks;

    // Spesifikasyonlar
    private List<(string name, string value, string? unit, int displayOrder)>? _specifications;

    // Bundle
    private List<(string productName, string? variantLabel, string? coverUrl, int quantity, decimal? discountRate, int displayOrder)>? _bundleItems;

    // Medya sözlük (MediaId → Media)
    private Dictionary<Guid, Media> _allMediaDict = new();

    // Tüm medya URL listesi (lightbox navigasyonu)
    private List<string> _allMediaUrls = new();

    // ─── UI State ─────────────────────────────────────────────────
    private int _activeMediaIndex = 0;
    private int _quantity = 1;
    private bool _isFavorited = false;
    private bool _lightboxOpen = false;
    private bool _videoModalOpen = false;
    private string? _activeVideoUrl;
    private string _activeTab = "desc";

    // ─── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        if (SelectedProduct == null) return;

        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        await using var db = await DbFactory.CreateDbContextAsync(ct);

        var productId = SelectedProduct.Id;

        // SEO
        _seo = await db.Set<ProductSeo>().AsNoTracking()
            .FirstOrDefaultAsync(s => s.ProductId == productId, ct);

        // Marka
        if (SelectedProduct.BrandId.HasValue)
        {
            _brand = await db.Set<Brands>().AsNoTracking()
                .FirstOrDefaultAsync(b => b.Id == SelectedProduct.BrandId.Value, ct);
        }

        // Kapak görseli
        if (SelectedProduct.CoverMediaId.HasValue)
        {
            _coverMedia = await db.Set<Media>().AsNoTracking()
                .FirstOrDefaultAsync(m => m.Id == SelectedProduct.CoverMediaId.Value, ct);
        }

        // Galeri görselleri
        var galleryItems = await db.Set<ItemGallery>().AsNoTracking()
            .Where(g => g.ItemId == productId && g.ItemType == "ProductGallery" && g.IsDelete != true)
            .OrderBy(g => g.ItemAddDate)
            .ToListAsync(ct);

        if (galleryItems.Any())
        {
            var galleryMediaIds = galleryItems.Where(g => g.MediaId.HasValue).Select(g => g.MediaId!.Value).ToList();
            _galleryMedias = await db.Set<Media>().AsNoTracking()
                .Where(m => galleryMediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                .ToListAsync(ct);
        }

        // Varyantlar
        _allVariants = await db.Set<ProductVariants>().AsNoTracking()
            .Where(v => v.ProductId == productId && (v.IsDeleted == null || v.IsDeleted.IsDeletedStatu != true))
            .OrderBy(v => v.DisplayOrder)
            .ToListAsync(ct);

        _defaultVariant = _allVariants.FirstOrDefault(v => v.IsDefault) ?? _allVariants.FirstOrDefault();
        _selectedVariant = _defaultVariant;

        // Varyant değerleri
        if (_allVariants.Any())
        {
            var variantIds = _allVariants.Select(v => v.Id).ToList();
            _allVariantValues = await db.Set<ProductVariantValues>().AsNoTracking()
                .Where(vv => variantIds.Contains(vv.VariantId))
                .ToListAsync(ct);
        }

        // Varyant özellik haritası (UI seçici)
        var attrMappings = await db.Set<ProductAttributeMappings>().AsNoTracking()
            .Where(m => m.ProductId == productId && m.IsVariantAttribute)
            .OrderBy(m => m.DisplayOrder)
            .ToListAsync(ct);

        if (attrMappings.Any())
        {
            var attrIds = attrMappings.Select(m => m.AttributeId).Distinct().ToList();
            var attrs = await db.Set<ProductAttributes>().AsNoTracking()
                .Where(a => attrIds.Contains(a.Id))
                .ToListAsync(ct);

            var attrValueIds = _allVariantValues?.Select(vv => vv.AttributeValueId).Distinct().ToList() ?? new();
            var attrValues = await db.Set<ProductAttributeValues>().AsNoTracking()
                .Where(av => attrValueIds.Contains(av.Id) && av.IsActive)
                .OrderBy(av => av.DisplayOrder)
                .ToListAsync(ct);

            _variantAttributes = attrMappings.Select(am =>
            {
                var attr = attrs.FirstOrDefault(a => a.Id == am.AttributeId);
                var relevantValueIds = _allVariantValues?
                    .Where(vv => vv.AttributeId == am.AttributeId)
                    .Select(vv => vv.AttributeValueId)
                    .Distinct().ToList() ?? new();
                var values = attrValues
                    .Where(av => relevantValueIds.Contains(av.Id))
                    .Select(av => (av.Id, av.Value ?? "", av.ColorHex, attr?.Unit))
                    .ToList();
                return (am.AttributeId, attr?.Name ?? "", attr?.Unit, values);
            }).ToList();

            // Varsayılan varyant değerlerini seç
            if (_defaultVariant != null && _allVariantValues != null)
            {
                var defaultVals = _allVariantValues.Where(vv => vv.VariantId == _defaultVariant.Id).ToList();
                foreach (var dv in defaultVals)
                {
                    _selectedVariantValues[dv.AttributeId] = dv.AttributeValueId;
                }
            }

            // Image variant grupları
            var imageAttrMapping = attrMappings.FirstOrDefault(m => m.IsImageVariantAttribute);
            if (imageAttrMapping != null)
            {
                var imgGroups = await db.Set<ProductImageVariantGroups>().AsNoTracking()
                    .Where(g => g.ProductId == productId && g.AttributeId == imageAttrMapping.AttributeId)
                    .ToListAsync(ct);

                if (imgGroups.Any())
                {
                    var groupIds = imgGroups.Select(g => g.Id).ToList();
                    var variantGalleryItems = await db.Set<ItemGallery>().AsNoTracking()
                        .Where(g => groupIds.Contains(g.ItemId!.Value) && g.ItemType == "VariantGallery" && g.IsDelete != true)
                        .ToListAsync(ct);

                    var vgMediaIds = variantGalleryItems.Where(g => g.MediaId.HasValue).Select(g => g.MediaId!.Value).Distinct().ToList();
                    var vgMedias = await db.Set<Media>().AsNoTracking()
                        .Where(m => vgMediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                        .ToListAsync(ct);

                    _variantGroupMedias = imgGroups.Select(g =>
                    {
                        var itemIds = variantGalleryItems.Where(vi => vi.ItemId == g.Id).Select(vi => vi.MediaId!.Value).ToList();
                        var medias = vgMedias.Where(m => itemIds.Contains(m.Id)).ToList();
                        return (g.Id, g.AttributeValueId, medias);
                    }).ToList();

                    // Başlangıç seçili grubu ayarla
                    if (_selectedVariantValues.ContainsKey(imageAttrMapping.AttributeId))
                    {
                        var selectedAttrValId = _selectedVariantValues[imageAttrMapping.AttributeId];
                        _selectedVariantGroupId = imgGroups.FirstOrDefault(g => g.AttributeValueId == selectedAttrValId)?.Id;
                    }
                }
            }
        }

        // Güncel fiyatlar (EffectiveTo == null)
        _allCurrentPrices = await db.Set<ProductPrices>().AsNoTracking()
            .Where(p => p.ProductId == productId && p.EffectiveTo == null)
            .ToListAsync(ct);

        UpdateSelectedVariantPrice();

        // Stoklar
        _allStocks = await db.Set<ProductStocks>().AsNoTracking()
            .Where(s => s.ProductId == productId)
            .ToListAsync(ct);

        UpdateSelectedVariantStocks();

        // Kategoriler — breadcrumb
        var productCategories = await db.Set<ProductCategories>().AsNoTracking()
            .Where(pc => pc.ProductId == productId)
            .ToListAsync(ct);

        var primaryCatId = productCategories.FirstOrDefault(pc => pc.IsPrimary)?.CategoryId
                          ?? productCategories.FirstOrDefault()?.CategoryId;

        if (primaryCatId.HasValue)
        {
            var allCats = await db.Set<CategoriesTr>().AsNoTracking().ToListAsync(ct);
            _breadcrumbCategories = BuildBreadcrumb(allCats, primaryCatId.Value);
        }

        // Spesifikasyonlar
        var specs = await db.Set<ProductSpecifications>().AsNoTracking()
            .Where(s => s.ProductId == productId)
            .OrderBy(s => s.DisplayOrder)
            .ToListAsync(ct);

        if (specs.Any())
        {
            var specAttrIds = specs.Where(s => s.AttributeId.HasValue).Select(s => s.AttributeId!.Value).Distinct().ToList();
            var specAttrs = specAttrIds.Any()
                ? await db.Set<ProductAttributes>().AsNoTracking().Where(a => specAttrIds.Contains(a.Id)).ToListAsync(ct)
                : new List<ProductAttributes>();

            var specValIds = specs.Where(s => s.AttributeValueId.HasValue).Select(s => s.AttributeValueId!.Value).Distinct().ToList();
            var specVals = specValIds.Any()
                ? await db.Set<ProductAttributeValues>().AsNoTracking().Where(v => specValIds.Contains(v.Id)).ToListAsync(ct)
                : new List<ProductAttributeValues>();

            _specifications = specs.Select(s =>
            {
                var attrName = s.CustomName ?? specAttrs.FirstOrDefault(a => a.Id == s.AttributeId)?.Name ?? "—";
                var attrVal = s.CustomValue ?? specVals.FirstOrDefault(v => v.Id == s.AttributeValueId)?.Value ?? "—";
                var unit = specAttrs.FirstOrDefault(a => a.Id == s.AttributeId)?.Unit;
                return (attrName, attrVal, unit, s.DisplayOrder);
            }).ToList();
        }

        // Harici medyalar
        _externalMedias = await db.Set<ProductExternalMedias>().AsNoTracking()
            .Where(e => e.ProductId == productId)
            .OrderBy(e => e.DisplayOrder)
            .ToListAsync(ct);

        // Dijital içerikler
        if (SelectedProduct.ProductType == "Digital")
        {
            _digitalAssets = await db.Set<ProductDigitalAssets>().AsNoTracking()
                .Where(d => d.ProductId == productId)
                .ToListAsync(ct);
        }

        // Bundle içerik
        if (SelectedProduct.ProductType == "Bundle")
        {
            var bundleRows = await db.Set<ProductBundleItems>().AsNoTracking()
                .Where(b => b.BundleProductId == productId)
                .OrderBy(b => b.DisplayOrder)
                .ToListAsync(ct);

            if (bundleRows.Any())
            {
                var childProductIds = bundleRows.Select(b => b.ChildProductId).Distinct().ToList();
                var childProducts = await db.Set<Products>().AsNoTracking()
                    .Where(p => childProductIds.Contains(p.Id))
                    .ToListAsync(ct);

                var childVariantIds = bundleRows.Where(b => b.ChildVariantId.HasValue).Select(b => b.ChildVariantId!.Value).Distinct().ToList();
                var childVariants = childVariantIds.Any()
                    ? await db.Set<ProductVariants>().AsNoTracking().Where(v => childVariantIds.Contains(v.Id)).ToListAsync(ct)
                    : new List<ProductVariants>();

                // Kapak görselleri
                var coverMediaIds = childProducts.Where(p => p.CoverMediaId.HasValue).Select(p => p.CoverMediaId!.Value).Distinct().ToList();
                var coverMedias = coverMediaIds.Any()
                    ? await db.Set<Media>().AsNoTracking().Where(m => coverMediaIds.Contains(m.Id)).ToListAsync(ct)
                    : new List<Media>();

                _bundleItems = bundleRows.Select(bi =>
                {
                    var cp = childProducts.FirstOrDefault(p => p.Id == bi.ChildProductId);
                    var cv = bi.ChildVariantId.HasValue ? childVariants.FirstOrDefault(v => v.Id == bi.ChildVariantId.Value) : null;
                    var cm = cp?.CoverMediaId.HasValue == true ? coverMedias.FirstOrDefault(m => m.Id == cp.CoverMediaId.Value) : null;
                    return (cp?.Name ?? "Ürün", cv?.Sku, cm?.FileUrl, bi.Quantity, bi.DiscountRate, bi.DisplayOrder);
                }).ToList();
            }
        }

        // Mağaza bilgisi
        _store = await db.Set<Store>().AsNoTracking()
            .FirstOrDefaultAsync(s => s.Id == SelectedProduct.StoreId, ct);

        if (_store?.ProfileCoverGallery?.ProfileImagePath != null)
        {
            // _storeProfileMedia = await db.Set<Media>().AsNoTracking()
            //     .FirstOrDefaultAsync(m => m.Id == _store.ProfileCoverGallery.ProfileImagePath.Value, ct);
        }

        // Dokümanlardaki medya kayıtlarını yükle
        if (_externalMedias != null)
        {
            var docMediaIds = _externalMedias.Where(e => e.MediaId.HasValue).Select(e => e.MediaId!.Value).Distinct().ToList();
            if (docMediaIds.Any())
            {
                var docMedias = await db.Set<Media>().AsNoTracking()
                    .Where(m => docMediaIds.Contains(m.Id))
                    .ToListAsync(ct);
                foreach (var dm in docMedias)
                {
                    _allMediaDict[dm.Id] = dm;
                }
            }
        }

        if (_digitalAssets != null)
        {
            var daMediaIds = _digitalAssets.Select(d => d.MediaId).Distinct().ToList();
            if (daMediaIds.Any())
            {
                var daMedias = await db.Set<Media>().AsNoTracking()
                    .Where(m => daMediaIds.Contains(m.Id))
                    .ToListAsync(ct);
                foreach (var dm in daMedias)
                {
                    _allMediaDict[dm.Id] = dm;
                }
            }
        }

        // Tüm medya URL listesi (lightbox)
        RebuildMediaUrlList();
    }

    // ─── Yardımcı Metotlar ────────────────────────────────────────

    private void RebuildMediaUrlList()
    {
        _allMediaUrls.Clear();
        if (_coverMedia?.FileUrl != null) _allMediaUrls.Add(_coverMedia.FileUrl);
        if (_galleryMedias != null)
        {
            foreach (var gm in _galleryMedias.Where(m => m.FileUrl != null))
                _allMediaUrls.Add(gm.FileUrl!);
        }
        if (_variantGroupMedias != null && _selectedVariantGroupId != null)
        {
            var vgm = _variantGroupMedias.Where(x => x.groupId == _selectedVariantGroupId.Value).SelectMany(x => x.medias);
            foreach (var m in vgm.Where(m => m.FileUrl != null))
                _allMediaUrls.Add(m.FileUrl!);
        }
    }

    private string GetActiveMediaUrl()
    {
        if (_allMediaUrls.Count == 0) return "";
        var idx = Math.Clamp(_activeMediaIndex, 0, _allMediaUrls.Count - 1);
        return _allMediaUrls[idx];
    }

    private void SetActiveMedia(int index)
    {
        _activeMediaIndex = Math.Clamp(index, 0, Math.Max(0, _allMediaUrls.Count - 1));
    }

    private void SelectVariantValue(Guid attributeId, Guid valueId)
    {
        _selectedVariantValues[attributeId] = valueId;

        // Varyant grubunu güncelle (renk seçildiğinde görseller değişsin)
        if (_variantGroupMedias != null)
        {
            var matchingGroup = _variantGroupMedias.FirstOrDefault(g => g.attributeValueId == valueId);
            if (matchingGroup.groupId != Guid.Empty)
            {
                _selectedVariantGroupId = matchingGroup.groupId;
                RebuildMediaUrlList();
                _activeMediaIndex = 0;
            }
        }

        // Seçime uyan varyantı bul
        if (_allVariants != null && _allVariantValues != null)
        {
            var matchedVariant = _allVariants.FirstOrDefault(v =>
            {
                var vvs = _allVariantValues.Where(vv => vv.VariantId == v.Id).ToList();
                return _selectedVariantValues.All(sv =>
                    vvs.Any(vv => vv.AttributeId == sv.Key && vv.AttributeValueId == sv.Value));
            });

            if (matchedVariant != null)
            {
                _selectedVariant = matchedVariant;
                UpdateSelectedVariantPrice();
                UpdateSelectedVariantStocks();
            }
        }
        _quantity = 1;
    }

    private bool IsVariantValueAvailable(Guid attributeId, Guid valueId)
    {
        if (_allVariants == null || _allVariantValues == null) return true;

        // Diğer seçili özelliklerle birlikte bu değer mevcut bir varyant oluşturuyor mu
        var otherSelections = _selectedVariantValues.Where(sv => sv.Key != attributeId).ToDictionary(k => k.Key, v => v.Value);

        return _allVariants.Any(v =>
        {
            if (!v.IsActive) return false;
            var vvs = _allVariantValues.Where(vv => vv.VariantId == v.Id).ToList();
            if (!vvs.Any(vv => vv.AttributeId == attributeId && vv.AttributeValueId == valueId)) return false;
            return otherSelections.All(os => vvs.Any(vv => vv.AttributeId == os.Key && vv.AttributeValueId == os.Value));
        });
    }

    private string GetValueDisplay(Guid attributeId)
    {
        if (!_selectedVariantValues.ContainsKey(attributeId) || _variantAttributes == null) return "";
        var valId = _selectedVariantValues[attributeId];
        var attr = _variantAttributes.FirstOrDefault(a => a.attributeId == attributeId);
        return attr.values.FirstOrDefault(v => v.valueId == valId).value ?? "";
    }

    private void UpdateSelectedVariantPrice()
    {
        if (_selectedVariant == null || _allCurrentPrices == null) return;
        // Kullanıcı para birimi tercihine göre (default TRY)
        var currency = use?.Currency ?? "TRY";
        _currentPrice = _allCurrentPrices.FirstOrDefault(p => p.VariantId == _selectedVariant.Id && p.Currency == currency)
                     ?? _allCurrentPrices.FirstOrDefault(p => p.VariantId == _selectedVariant.Id);
    }

    private void UpdateSelectedVariantStocks()
    {
        if (_selectedVariant == null || _allStocks == null) return;
        _selectedVariantStocks = _allStocks.Where(s => s.VariantId == _selectedVariant.Id).ToList();
    }

    private int CalculateDiscountPercent()
    {
        if (_currentPrice == null || _currentPrice.DiscountedPrice == null || _currentPrice.Price <= 0) return 0;
        return (int)Math.Round((1 - (_currentPrice.DiscountedPrice.Value / _currentPrice.Price)) * 100);
    }

    private string FormatPrice(decimal amount, string? currency)
    {
        return currency switch
        {
            "USD" => $"${amount:N2}",
            "EUR" => $"€{amount:N2}",
            "AZN" => $"₼{amount:N2}",
            _ => $"₺{amount:N2}"
        };
    }

    private string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0) return "";
        if (bytes.Value < 1024) return $"{bytes.Value} B";
        if (bytes.Value < 1048576) return $"{bytes.Value / 1024.0:F1} KB";
        return $"{bytes.Value / 1048576.0:F1} MB";
    }

    private string GetProductTypeLabel(string? type) => type switch
    {
        "Variant" => "Çoklu Seçenek",
        "Digital" => "Dijital Ürün",
        "Service" => "Hizmet",
        "Bundle" => "Paket Ürün",
        "External" => "Harici Ürün",
        _ => ""
    };

    private string GetSchemaAvailability()
    {
        var stock = _selectedVariantStocks?.FirstOrDefault();
        if (stock == null) return "https://schema.org/OutOfStock";
        return stock.StockStatus switch
        {
            "InStock" => "https://schema.org/InStock",
            "PreOrder" => "https://schema.org/PreOrder",
            "Backorder" => "https://schema.org/BackOrder",
            _ => stock.Quantity > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
        };
    }

    private List<CategoriesTr> BuildBreadcrumb(List<CategoriesTr> allCats, int categoryId)
    {
        var result = new List<CategoriesTr>();
        var current = allCats.FirstOrDefault(c => c.Id == categoryId);
        while (current != null)
        {
            result.Insert(0, current);
            current = current.ParentCategoryId.HasValue
                ? allCats.FirstOrDefault(c => c.Id == current.ParentCategoryId.Value)
                : null;
        }
        return result;
    }

    private string ConvertToEmbedUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        // YouTube
        if (url.Contains("youtube.com/watch"))
        {
            var uri = new Uri(url);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var videoId = query["v"];
            if (!string.IsNullOrEmpty(videoId))
                return $"https://www.youtube.com/embed/{videoId}";
        }
        if (url.Contains("youtu.be/"))
        {
            var videoId = url.Split("youtu.be/").LastOrDefault()?.Split('?').FirstOrDefault();
            if (!string.IsNullOrEmpty(videoId))
                return $"https://www.youtube.com/embed/{videoId}";
        }
        // Vimeo
        if (url.Contains("vimeo.com/"))
        {
            var videoId = url.Split("vimeo.com/").LastOrDefault()?.Split('?').FirstOrDefault();
            if (!string.IsNullOrEmpty(videoId))
                return $"https://player.vimeo.com/video/{videoId}";
        }
        return url;
    }

    private string GenerateJsonLd()
    {
        var price = _currentPrice;
        var effectivePrice = price?.DiscountedPrice ?? price?.Price ?? 0;

        var brandName = _brand?.Name ?? "";
        var sku = _defaultVariant?.Sku ?? "";
        var gtin = _defaultVariant?.Gtin ?? _defaultVariant?.Ean ?? _defaultVariant?.Upc ?? "";
        var imageUrl = _coverMedia?.FileUrl ?? "";
        var slug = _seo?.Slug ?? SelectedProduct?.Id.ToString() ?? "";

        var jsonLd = new System.Text.StringBuilder();
        jsonLd.Append('{');
        jsonLd.Append("\"@context\":\"https://schema.org\",");
        jsonLd.Append("\"@type\":\"Product\",");
        jsonLd.Append($"\"name\":\"{EscapeJson(SelectedProduct?.Name)}\",");
        jsonLd.Append($"\"description\":\"{EscapeJson(_seo?.SeoDescription ?? SelectedProduct?.ShortDescription)}\",");
        jsonLd.Append($"\"image\":\"{EscapeJson(imageUrl)}\",");
        jsonLd.Append($"\"sku\":\"{EscapeJson(sku)}\",");

        if (!string.IsNullOrEmpty(gtin))
            jsonLd.Append($"\"gtin\":\"{EscapeJson(gtin)}\",");

        if (!string.IsNullOrEmpty(_defaultVariant?.Mpn))
            jsonLd.Append($"\"mpn\":\"{EscapeJson(_defaultVariant.Mpn)}\",");

        if (!string.IsNullOrEmpty(brandName))
        {
            jsonLd.Append("\"brand\":{\"@type\":\"Brand\",");
            jsonLd.Append($"\"name\":\"{EscapeJson(brandName)}\"");
            jsonLd.Append("},");
        }

        // Offers
        jsonLd.Append("\"offers\":{\"@type\":\"Offer\",");
        jsonLd.Append($"\"url\":\"https://efavori.com/urun/{EscapeJson(slug)}\",");
        jsonLd.Append($"\"priceCurrency\":\"{EscapeJson(price?.Currency ?? "TRY")}\",");
        jsonLd.Append($"\"price\":\"{effectivePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\",");
        jsonLd.Append($"\"availability\":\"{GetSchemaAvailability()}\",");
        jsonLd.Append("\"itemCondition\":\"https://schema.org/NewCondition\"");

        if (_store != null)
        {
            jsonLd.Append(",\"seller\":{\"@type\":\"Organization\",");
            jsonLd.Append($"\"name\":\"{EscapeJson(_store.Name)}\"");
            jsonLd.Append('}');
        }
        jsonLd.Append('}');

        // Breadcrumb
        if (_breadcrumbCategories.Any())
        {
            jsonLd.Append(",\"isPartOf\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[");
            for (int i = 0; i < _breadcrumbCategories.Count; i++)
            {
                if (i > 0) jsonLd.Append(',');
                jsonLd.Append($"{{\"@type\":\"ListItem\",\"position\":{i + 1},\"name\":\"{EscapeJson(_breadcrumbCategories[i].Name)}\"}}");
            }
            jsonLd.Append("]}");
        }

        jsonLd.Append('}');
        return jsonLd.ToString();
    }

    private string EscapeJson(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "";
        return val.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n").Replace("\r", "").Replace("\t", "\\t");
    }

    // ─── UI Actions ───────────────────────────────────────────────

    private void AdjustQuantity(int delta)
    {
        var maxQty = _selectedVariantStocks?.FirstOrDefault()?.MaxOrderQuantity
                  ?? (_selectedVariantStocks?.Sum(s => s.Quantity) ?? 99);
        if (maxQty <= 0) maxQty = 1;
        _quantity = Math.Clamp(_quantity + delta, 1, maxQty);
    }

    private async Task AddToCart()
    {
        // Sepete ekleme event'i — parent component'ten handle edilir
        // Placeholder: JS ile notification göster
        await JS.InvokeVoidAsync("eval", "alert('Ürün sepete eklendi!')");
    }

    private async Task BuyNow()
    {
        await JS.InvokeVoidAsync("eval", "alert('Hemen al — ödeme sayfasına yönlendiriliyorsunuz…')");
    }

    private void ToggleFavorite() => _isFavorited = !_isFavorited;
    private void ToggleCompare() { /* Parent event */ }

    private async Task ShareProduct()
    {
        var url = _seo?.CanonicalUrl ?? $"https://efavori.com/urun/{_seo?.Slug ?? SelectedProduct?.Id.ToString()}";
        try
        {
            await JS.InvokeVoidAsync("eval", $"navigator.share ? navigator.share({{title:'{EscapeJson(SelectedProduct?.Name)}',url:'{EscapeJson(url)}'}}) : navigator.clipboard.writeText('{EscapeJson(url)}')");
        }
        catch { }
    }

    // Lightbox
    private void OpenLightbox() { if (_allMediaUrls.Any()) _lightboxOpen = true; }
    private void CloseLightbox() => _lightboxOpen = false;
    private void LightboxPrev()
    {
        _activeMediaIndex = _activeMediaIndex > 0 ? _activeMediaIndex - 1 : _allMediaUrls.Count - 1;
    }
    private void LightboxNext()
    {
        _activeMediaIndex = (_activeMediaIndex + 1) % _allMediaUrls.Count;
    }
    private void HandleLightboxKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft") LightboxPrev();
        else if (e.Key == "ArrowRight") LightboxNext();
        else if (e.Key == "Escape") CloseLightbox();
    }

    // Video modal
    private void PlayVideo(string? url)
    {
        _activeVideoUrl = url;
        _videoModalOpen = true;
    }
    private void Show360()
    {
        var em = _externalMedias?.FirstOrDefault(x => x.MediaType == "View360");
        if (em?.Url != null) PlayVideo(em.Url);
    }
    private void CloseVideoModal()
    {
        _videoModalOpen = false;
        _activeVideoUrl = null;
    }

    // ─── Dispose ──────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

