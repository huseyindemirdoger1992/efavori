    }

    .pv-meta-item {
    font-size: .75rem;
    color: var(--pv-text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    }

    .pv-type-badge {
    background: var(--pv-bg-muted);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
    }

    .pv-short-desc {
    font-size: .9375rem;
    color: var(--pv-text-secondary);
    margin: 0;
    line-height: 1.65;
    }

    /* ── Price Box ────────────────────────────────────────────── */
    .pv-price-box {
    background: var(--pv-bg-soft);
    border-radius: var(--pv-radius);
    padding: 20px;
    border: 1px solid var(--pv-border);
    }

    .pv-price-campaign {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
    }

    .pv-price-old {
    font-size: 1rem;
    color: var(--pv-text-light);
    text-decoration: line-through;
    }

    .pv-discount-tag {
    font-size: .75rem;
    font-weight: 700;
    color: var(--pv-accent);
    background: rgba(233,69,96,.08);
    padding: 2px 8px;
    border-radius: 4px;
    }

    .pv-price-current {
    font-size: 2rem;
    font-weight: 800;
    color: var(--pv-text);
    letter-spacing: -.02em;
    }

    .pv-price-vat {
    font-size: .75rem;
    color: var(--pv-text-light);
    margin-top: 2px;
    }

    .pv-price-unavailable {
    font-size: 1rem;
    color: var(--pv-text-secondary);
    font-style: italic;
    }

    .pv-installment {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--pv-border);
    font-size: .8125rem;
    color: var(--pv-text-secondary);
    }

    .pv-installment i {
    color: var(--pv-success);
    }

    .pv-link {
    color: var(--pv-accent);
    text-decoration: none;
    font-weight: 500;
    }

    .pv-link:hover {
    text-decoration: underline;
    }

    /* ── Variants ─────────────────────────────────────────────── */
    .pv-variants {
    display: flex;
    flex-direction: column;
    gap: 16px;
    }

    .pv-variant-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    }

    .pv-variant-label {
    font-size: .8125rem;
    font-weight: 600;
    color: var(--pv-text);
    }

    .pv-variant-selected {
    font-weight: 400;
    color: var(--pv-text-secondary);
    }

    .pv-variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    }

    /* Color swatch */
    .pv-swatch {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--pv-border);
    background: var(--swatch-color);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--pv-transition);
    color: #fff;
    font-size: .75rem;
    }

    .pv-swatch:hover {
    transform: scale(1.1);
    }

    .pv-swatch.active {
    border-color: var(--pv-primary);
    box-shadow: 0 0 0 2px var(--pv-bg), 0 0 0 4px var(--pv-primary);
    }

    .pv-swatch.disabled {
    opacity: .3;
    cursor: not-allowed;
    position: relative;
    }

    .pv-swatch.disabled::after {
    content: '';
    position: absolute;
    width: 120%;
    height: 2px;
    background: var(--pv-danger);
    transform: rotate(-45deg);
    }

    /* Text chip */
    .pv-chip {
    padding: 8px 16px;
    border-radius: var(--pv-radius-sm);
    border: 1.5px solid var(--pv-border);
    background: var(--pv-bg);
    font-size: .8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--pv-transition);
    color: var(--pv-text);
    }

    .pv-chip:hover {
    border-color: var(--pv-primary);
    }

    .pv-chip.active {
    border-color: var(--pv-primary);
    background: var(--pv-primary);
    color: #fff;
    }

    .pv-chip.disabled {
    opacity: .35;
    cursor: not-allowed;
    text-decoration: line-through;
    }

    .pv-chip small {
    font-size: .6875rem;
    color: inherit;
    opacity: .7;
    margin-left: 2px;
    }

    /* ── Stock Badge ──────────────────────────────────────────── */
    .pv-stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .8125rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--pv-radius-sm);
    }

    .pv-stock-in {
    background: rgba(16,185,129,.08);
    color: #059669;
    }

    .pv-stock-out {
    background: rgba(239,68,68,.08);
    color: var(--pv-danger);
    }

    .pv-stock-critical {
    background: rgba(245,158,11,.08);
    color: #d97706;
    animation: pvAttention 2s ease-in-out infinite;
    }

    .pv-stock-preorder {
    background: rgba(99,102,241,.08);
    color: #6366f1;
    }

    .pv-stock-backorder {
    background: rgba(14,165,233,.08);
    color: #0ea5e9;
    }
    @@keyframes pvAttention {
    0%, 100% {
    opacity: 1;
    }

    50% {
    opacity: .7;
    }
    }

    /* ── Purchase Box ─────────────────────────────────────────── */
    .pv-purchase-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
    }

    .pv-qty-row {
    display: flex;
    align-items: center;
    }

    .pv-qty-control {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--pv-border);
    border-radius: var(--pv-radius-sm);
    overflow: hidden;
    }

    .pv-qty-btn {
    width: 40px;
    height: 40px;
    border: none;
    background: var(--pv-bg-soft);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pv-text);
    transition: background var(--pv-transition);
    }

    .pv-qty-btn:hover:not(:disabled) {
    background: var(--pv-bg-muted);
    }

    .pv-qty-btn:disabled {
    opacity: .3;
    cursor: not-allowed;
    }

    .pv-qty-input {
    width: 56px;
    height: 40px;
    border: none;
    border-left: 1px solid var(--pv-border);
    border-right: 1px solid var(--pv-border);
    text-align: center;
    font-size: .9375rem;
    font-weight: 600;
    color: var(--pv-text);
    background: var(--pv-bg);
    outline: none;
    -moz-appearance: textfield;
    }

    .pv-qty-input::-webkit-inner-spin-button,
    .pv-qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
    }

    .pv-action-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    }

    .pv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 24px;
    border: none;
    border-radius: var(--pv-radius-sm);
    font-size: .9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--pv-transition);
    text-decoration: none;
    line-height: 1;
    }

    .pv-btn:disabled {
    opacity: .4;
    cursor: not-allowed;
    }

    .pv-btn-primary {
    background: var(--pv-primary);
    color: #fff;
    }

    .pv-btn-primary:hover:not(:disabled) {
    background: #2a2a4a;
    transform: translateY(-1px);
    box-shadow: var(--pv-shadow-lg);
    }

    .pv-btn-accent {
    background: var(--pv-accent);
    color: #fff;
    }

    .pv-btn-accent:hover:not(:disabled) {
    background: var(--pv-accent-hover);
    transform: translateY(-1px);
    box-shadow: var(--pv-shadow-lg);
    }

    .pv-btn-outline {
    background: transparent;
    border: 1.5px solid var(--pv-border);
    color: var(--pv-text);
    }

    .pv-btn-outline:hover {
    border-color: var(--pv-primary);
    color: var(--pv-primary);
    }

    .pv-btn-outline-sm {
    padding: 6px 14px;
    font-size: .8125rem;
    background: transparent;
    border: 1px solid var(--pv-border);
    color: var(--pv-text);
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all var(--pv-transition);
    }

    .pv-btn-outline-sm:hover {
    border-color: var(--pv-accent);
    color: var(--pv-accent);
    }

    .pv-secondary-actions {
    display: flex;
    gap: 4px;
    justify-content: center;
    }

    .pv-icon-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px 16px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--pv-text-secondary);
    font-size: .6875rem;
    transition: color var(--pv-transition);
    border-radius: var(--pv-radius-sm);
    }

    .pv-icon-btn:hover {
    color: var(--pv-accent);
    background: rgba(233,69,96,.04);
    }

    .pv-icon-btn i {
    font-size: 1.125rem;
    }

    /* ── Trust ────────────────────────────────────────────────── */
    .pv-trust {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 16px;
    background: var(--pv-bg-soft);
    border-radius: var(--pv-radius);
    border: 1px solid var(--pv-border);
    }

    .pv-trust-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: .8125rem;
    }

    .pv-trust-item i {
    font-size: 1.25rem;
    color: var(--pv-success);
    margin-top: 2px;
    flex-shrink: 0;
    }

    .pv-trust-item strong {
    display: block;
    font-size: .8125rem;
    color: var(--pv-text);
    }

    .pv-trust-item small {
    display: block;
    font-size: .6875rem;
    color: var(--pv-text-light);
    line-height: 1.3;
    }

    /* ── Detail Tabs ──────────────────────────────────────────── */
    .pv-detail-tabs {
    margin-bottom: 48px;
    }

    .pv-tab-nav {
    display: flex;
    gap: 0;
    border-bottom: 2px solid var(--pv-border);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    }

    .pv-tab {
    padding: 14px 20px;
    border: none;
    background: transparent;
    font-size: .875rem;
    font-weight: 500;
    color: var(--pv-text-secondary);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all var(--pv-transition);
    display: flex;
    align-items: center;
    gap: 6px;
    }

    .pv-tab:hover {
    color: var(--pv-text);
    }

    .pv-tab.active {
    color: var(--pv-accent);
    border-bottom-color: var(--pv-accent);
    font-weight: 600;
    }

    .pv-tab i {
    font-size: .875rem;
    }

    .pv-tab-panel {
    display: none;
    padding: 32px 0;
    }

    .pv-tab-panel.active {
    display: block;
    }

    .pv-section-divider {
    height: 1px;
    background: var(--pv-border);
    margin: 32px 0;
    }

    .pv-section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--pv-text);
    margin: 0 0 16px;
    }

    /* ── Description ──────────────────────────────────────────── */
    .pv-description {
    font-size: .9375rem;
    line-height: 1.75;
    color: var(--pv-text);
    }

    .pv-description img {
    max-width: 100%;
    height: auto;
    border-radius: var(--pv-radius-sm);
    margin: 16px 0;
    }

    .pv-description h2, .pv-description h3, .pv-description h4 {
    margin: 24px 0 8px;
    }

    .pv-description ul, .pv-description ol {
    padding-left: 20px;
    }

    .pv-description table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    }

    .pv-description table th, .pv-description table td {
    padding: 8px 12px;
    border: 1px solid var(--pv-border);
    text-align: left;
    font-size: .875rem;
    }

    /* ── Video Grid ───────────────────────────────────────────── */
    .pv-video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    }

    .pv-video-card {
    border-radius: var(--pv-radius);
    overflow: hidden;
    border: 1px solid var(--pv-border);
    }

    .pv-video-embed {
    position: relative;
    padding-top: 56.25%;
    }

    .pv-video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    }

    .pv-video-title {
    padding: 10px 14px;
    font-size: .8125rem;
    font-weight: 500;
    margin: 0;
    }

    /* ── Tags ─────────────────────────────────────────────────── */
    .pv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    }

    .pv-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    border-radius: 20px;
    background: var(--pv-bg-muted);
    color: var(--pv-text-secondary);
    font-size: .75rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--pv-transition);
    }

    .pv-tag:hover {
    background: var(--pv-primary);
    color: #fff;
    }

    /* ── Specs Table ──────────────────────────────────────────── */
    .pv-specs-table {
    width: 100%;
    border-collapse: collapse;
    }

    .pv-specs-table tr:nth-child(even) {
    background: var(--pv-bg-soft);
    }

    .pv-specs-table th {
    width: 40%;
    padding: 12px 16px;
    text-align: left;
    font-size: .8125rem;
    font-weight: 600;
    color: var(--pv-text);
    border-bottom: 1px solid var(--pv-border);
    }

    .pv-specs-table td {
    padding: 12px 16px;
    font-size: .8125rem;
    color: var(--pv-text-secondary);
    border-bottom: 1px solid var(--pv-border);
    }

    /* ── Docs Grid ────────────────────────────────────────────── */
    .pv-docs-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    }

    .pv-doc-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    border: 1px solid var(--pv-border);
    border-radius: var(--pv-radius-sm);
    transition: box-shadow var(--pv-transition);
    }

    .pv-doc-card:hover {
    box-shadow: var(--pv-shadow);
    }

    .pv-doc-icon {
    color: var(--pv-accent);
    flex-shrink: 0;
    }

    .pv-doc-info {
    flex: 1;
    }

    .pv-doc-info strong {
    display: block;
    font-size: .875rem;
    }

    .pv-doc-info small {
    display: block;
    margin-top: 2px;
    }

    /* ── Digital Assets ───────────────────────────────────────── */
    .pv-digital-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    }

    .pv-digital-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--pv-border);
    border-radius: var(--pv-radius);
    background: var(--pv-bg-soft);
    }

    .pv-digital-icon {
    color: var(--pv-primary);
    flex-shrink: 0;
    margin-top: 2px;
    }

    .pv-digital-info {
    flex: 1;
    }

    .pv-digital-info strong {
    display: block;
    font-size: .9375rem;
    margin-bottom: 6px;
    }

    .pv-digital-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: .75rem;
    color: var(--pv-text-secondary);
    }

    .pv-digital-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    }

    .pv-license-badge {
    color: var(--pv-success) !important;
    font-weight: 600;
    }

    /* ── Bundle ────────────────────────────────────────────────── */
    .pv-bundle-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    }

    .pv-bundle-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border: 1px solid var(--pv-border);
    border-radius: var(--pv-radius-sm);
    background: var(--pv-bg);
    transition: box-shadow var(--pv-transition);
    }

    .pv-bundle-card:hover {
    box-shadow: var(--pv-shadow);
    }

    .pv-bundle-img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: var(--pv-radius-sm);
    flex-shrink: 0;
    }

    .pv-bundle-img-placeholder {
    width: 64px;
    height: 64px;
    background: var(--pv-bg-muted);
    border-radius: var(--pv-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pv-text-light);
    flex-shrink: 0;
    }

    .pv-bundle-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    }

    .pv-bundle-info strong {
    font-size: .8125rem;
    }

    .pv-bundle-qty {
    font-size: .75rem;
    font-weight: 700;
    color: var(--pv-primary);
    }

    .pv-badge-discount-sm {
    font-size: .6875rem;
    color: var(--pv-accent);
    font-weight: 600;
    }

    /* ── Seller Card ──────────────────────────────────────────── */
    .pv-seller-card {
    max-width: 480px;
    }

    .pv-seller-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    }

    .pv-seller-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--pv-border);
    }

    .pv-seller-avatar-placeholder {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--pv-bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pv-text-light);
    }

    .pv-seller-name {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0;
    }

    .pv-seller-desc {
    font-size: .8125rem;
    color: var(--pv-text-secondary);
    margin: 0 0 16px;
    line-height: 1.6;
    }

    .pv-seller-stats {
    display: flex;
    gap: 24px;
    }

    .pv-seller-stat {
    display: flex;
    flex-direction: column;
    }

    .pv-seller-stat strong {
    font-size: 1.125rem;
    font-weight: 700;
    }

    .pv-seller-stat small {
    font-size: .6875rem;
    color: var(--pv-text-light);
    }

    /* ── Social Proof ─────────────────────────────────────────── */
    .pv-social-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 20px;
    background: var(--pv-bg-soft);
    border-radius: var(--pv-radius);
    margin-bottom: 48px;
    border: 1px solid var(--pv-border);
    }

    .pv-proof-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: .8125rem;
    color: var(--pv-text-secondary);
    }

    .pv-proof-item i {
    color: var(--pv-accent);
    }

    .pv-proof-item strong {
    color: var(--pv-text);
    }

    /* ── SEO Content ──────────────────────────────────────────── */
    .pv-seo-content h2 {
    font-size: 1.25rem;
    }

    .pv-seo-content p {
    font-size: .9375rem;
    line-height: 1.75;
    color: var(--pv-text-secondary);
    }

    /* ── Lightbox ─────────────────────────────────────────────── */
    .pv-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,.92);
    display: flex;
    align-items: center;
    justify-content: center;
    }

    .pv-lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    z-index: 10;
    opacity: .7;
    transition: opacity var(--pv-transition);
    padding: 8px;
    }

    .pv-lightbox-close:hover {
    opacity: 1;
    }

    .pv-lightbox-prev, .pv-lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    opacity: .6;
    transition: opacity var(--pv-transition);
    padding: 16px;
    z-index: 10;
    }

    .pv-lightbox-prev {
    left: 8px;
    }

    .pv-lightbox-next {
    right: 8px;
    }

    .pv-lightbox-prev:hover, .pv-lightbox-next:hover {
    opacity: 1;
    }

    .pv-lightbox-content {
    max-width: 90vw;
    max-height: 90vh;
    }

    .pv-lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    }

    .pv-lightbox-counter {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,.7);
    font-size: .8125rem;
    font-weight: 500;
    }

    .pv-video-modal-content {
    width: 80vw;
    max-width: 960px;
    aspect-ratio: 16/9;
    }

    .pv-video-modal-content iframe {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: var(--pv-radius);
    }

    /* ── Mobile Sticky Bar ────────────────────────────────────── */
    .pv-mobile-sticky {
    display: none;
