@code {
    // Cache Key - Benzersiz ve sabit anahtar
    private const string CACHE_KEY = "GitHubCommits_efavori_huseyindemirdoger1992";

    // Configuration
    private const string GitHubToken = "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";
    private const string UserName = "huseyindemirdoger1992";
    private const string RepoName = "efavori";
    private const int CACHE_DURATION_MINUTES = 5;

    // State
    private List<GitHubCommit> commits = new List<GitHubCommit>();
    private List<string> authors = new List<string>();
    private HashSet<string> expandedCommits = new HashSet<string>();
    private CommitStatistics statistics;
    private CacheInfo cacheInfo;

    // UI State
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string searchText = string.Empty;
    private string selectedAuthor = string.Empty;
    private LoadingProgress loadingProgress = new LoadingProgress();

    // Computed
    private int TotalCode => commits.Where(c => c.Stats != null).Sum(c => c.Stats.Total);

    protected override async Task OnInitializedAsync()
    {
        await LoadCommits();
    }

    private async Task ForceReload()
    {
        try
        {
            // Cache'i temizle
            MemoryCache.Remove(CACHE_KEY);
            Console.WriteLine("Cache temizlendi, yeni veriler çekiliyor...");

            // Verileri yeniden yükle
            await LoadCommits();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Force reload hatası: {ex.Message}");
        }
    }

    private async Task LoadCommits()
    {
        isLoading = true;
        errorMessage = string.Empty;
        loadingProgress = new LoadingProgress();
        StateHasChanged();

        try
        {
            // HttpClient yapılandırması
            Http.DefaultRequestHeaders.Clear();
            Http.DefaultRequestHeaders.Add("User-Agent", "GitHubCommitsApp");
            Http.DefaultRequestHeaders.Add("Accept", "application/vnd.github+json");
            Http.DefaultRequestHeaders.Add("Authorization", $"Bearer {GitHubToken}");
            Http.DefaultRequestHeaders.Add("X-GitHub-Api-Version", "2022-11-28");

            // Cache'den veri al veya yeni veri çek
            commits = await MemoryCache.GetOrCreateAsync(CACHE_KEY, async entry =>
            {
                Console.WriteLine("Cache MISS - Yeni veriler GitHub API'den çekiliyor...");

                // Cache süresi 5 dakika
                entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(CACHE_DURATION_MINUTES);
                entry.SetPriority(CacheItemPriority.High);

                // Cache bilgisini sakla
                cacheInfo = new CacheInfo
                {
                    CachedAt = DateTime.Now,
                    NextRefresh = DateTime.Now.AddMinutes(CACHE_DURATION_MINUTES)
                };

                // Tüm commitleri al (pagination ile)
                var commitList = new List<GitHubCommit>();
                int page = 1;
                int perPage = 100;
                bool hasMore = true;

                while (hasMore)
                {
                    var apiUrl = $"https://api.github.com/repos/{UserName}/{RepoName}/commits?per_page={perPage}&page={page}";
                    var response = await Http.GetAsync(apiUrl);

                    if (!response.IsSuccessStatusCode)
                    {
                        var errorContent = await response.Content.ReadAsStringAsync();
                        Console.WriteLine($"GitHub API hatası: {response.StatusCode} - {errorContent}");
                        throw new HttpRequestException($"GitHub API hatası: {response.StatusCode}");
                    }

                    var json = await response.Content.ReadAsStringAsync();
                    var pageCommits = JsonSerializer.Deserialize<List<GitHubCommit>>(json, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                    if (pageCommits == null || pageCommits.Count == 0)
                    {
                        hasMore = false;
                    }
                    else
                    {
                        commitList.AddRange(pageCommits);
                        Console.WriteLine($"Sayfa {page}: {pageCommits.Count} commit çekildi (Toplam: {commitList.Count})");

                        // Eğer gelen commit sayısı perPage'den azsa, son sayfadayız
                        if (pageCommits.Count < perPage)
                        {
                            hasMore = false;
                        }
                        else
                        {
                            page++;
                        }
                    }
                }

                if (commitList == null || !commitList.Any())
                {
                    Console.WriteLine("Commit listesi boş");
                    return new List<GitHubCommit>();
                }

                loadingProgress.TotalCommits = commitList.Count;
                StateHasChanged();

                Console.WriteLine($"{commitList.Count} commit bulundu, detaylar çekiliyor...");

                // Her commit için detaylı bilgi al (paralel)
                var detailedCommits = new ConcurrentBag<GitHubCommit>();
                var semaphore = new SemaphoreSlim(10); // Aynı anda max 10 istek
                var tasks = new List<Task>();

                foreach (var commit in commitList)
                {
                    tasks.Add(Task.Run(async () =>
                    {
                        await semaphore.WaitAsync();
                        try
                        {
                            var detail = await GetCommitDetail(commit.Sha);
                            if (detail != null)
                            {
                                detailedCommits.Add(detail);
                                loadingProgress.LoadedCommits = detailedCommits.Count;

                                // Her 10 commit'te bir UI güncelle
                                if (loadingProgress.LoadedCommits % 10 == 0)
                                {
                                    await InvokeAsync(StateHasChanged);
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"Commit detay hatası ({commit.Sha}): {ex.Message}");
                        }
                        finally
                        {
                            semaphore.Release();
                        }
                    }));
                }

                await Task.WhenAll(tasks);

                var orderedCommits = detailedCommits
                    .OrderByDescending(c => c.Commit?.Author?.Date ?? DateTime.MinValue)
                    .ToList();

                Console.WriteLine($"{orderedCommits.Count} commit detayı başarıyla yüklendi ve 5 dakika cache'lendi");

                return orderedCommits;
            });

            // Cache'den veri geldi mi kontrol et
            if (commits != null && commits.Any())
            {
                Console.WriteLine($"Cache HIT - {commits.Count} commit cache'den yüklendi");

                // Cache bilgisi yoksa oluştur (cache'den geldiğinde)
                if (cacheInfo == null)
                {
                    // Cache'in ne zaman oluşturulduğunu tam olarak bilemeyiz ama yaklaşık hesaplayabiliriz
                    cacheInfo = new CacheInfo
                    {
                        CachedAt = DateTime.Now.AddMinutes(-1), // Yaklaşık
                        NextRefresh = DateTime.Now.AddMinutes(CACHE_DURATION_MINUTES - 1)
                    };
                }

                UpdateUIData();
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"HTTP İstek Hatası: {ex.Message}");
            // Hata durumunda mevcut veriyi korumaya devam et
            if (commits == null || !commits.Any())
            {
                commits = new List<GitHubCommit>();
            }
        }
        catch (JsonException ex)
        {
            Console.WriteLine($"JSON Parse Hatası: {ex.Message}");
            if (commits == null || !commits.Any())
            {
                commits = new List<GitHubCommit>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Beklenmeyen Hata: {ex.Message}");
            if (commits == null || !commits.Any())
            {
                commits = new List<GitHubCommit>();
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateUIData()
    {
        try
        {
            // Yazarları topla
            authors = commits
                .Where(c => c.Author != null && !string.IsNullOrEmpty(c.Author.Login))
                .Select(c => c.Author.Login)
                .Distinct()
                .OrderBy(a => a)
                .ToList();

            // İstatistikleri hesapla
            CalculateStatistics();

            Console.WriteLine($"UI Data güncellendi - {authors.Count} yazar, {statistics?.TotalCommits ?? 0} commit");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"UI Data güncelleme hatası: {ex.Message}");
        }
    }

    private async Task<GitHubCommit> GetCommitDetail(string sha)
    {
        try
        {
            if (string.IsNullOrEmpty(sha))
            {
                return null;
            }

            var detailUrl = $"https://api.github.com/repos/{UserName}/{RepoName}/commits/{sha}";
            var response = await Http.GetAsync(detailUrl);

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Commit detayı alınamadı ({sha?.Substring(0, 7)}): {response.StatusCode}");
                return null;
            }

            var json = await response.Content.ReadAsStringAsync();
            var commit = JsonSerializer.Deserialize<GitHubCommit>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            return commit;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"GetCommitDetail hatası ({sha?.Substring(0, 7)}): {ex.Message}");
            return null;
        }
    }

    private void CalculateStatistics()
    {
        try
        {
            if (commits == null || !commits.Any())
            {
                statistics = null;
                return;
            }

            statistics = new CommitStatistics
            {
                TotalCommits = commits.Count,
                TotalAdditions = commits.Where(c => c.Stats != null).Sum(c => c.Stats.Additions),
                TotalDeletions = commits.Where(c => c.Stats != null).Sum(c => c.Stats.Deletions),
                TotalChanges = commits.Where(c => c.Stats != null).Sum(c => c.Stats.Total),
                UniqueAuthors = commits.Where(c => c.Author != null).Select(c => c.Author.Login).Distinct().Count(),
                FirstCommitDate = commits.OrderBy(c => c.Commit?.Author?.Date ?? DateTime.MinValue).FirstOrDefault()?.Commit?.Author?.Date,
                LastCommitDate = commits.OrderByDescending(c => c.Commit?.Author?.Date ?? DateTime.MinValue).FirstOrDefault()?.Commit?.Author?.Date
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"İstatistik hesaplama hatası: {ex.Message}");
            statistics = null;
        }
    }

    private IEnumerable<GitHubCommit> FilteredCommits
    {
        get
        {
            try
            {
                var filtered = commits.AsEnumerable();

                if (!string.IsNullOrWhiteSpace(searchText))
                {
                    filtered = filtered.Where(c =>
                        (c.Commit?.Message?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                        (c.Sha?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true));
                }

                if (!string.IsNullOrWhiteSpace(selectedAuthor))
                {
                    filtered = filtered.Where(c => c.Author?.Login == selectedAuthor);
                }

                return filtered.OrderByDescending(c => c.Commit?.Author?.Date ?? DateTime.MinValue);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Filtreleme hatası: {ex.Message}");
                return commits.OrderByDescending(c => c.Commit?.Author?.Date ?? DateTime.MinValue);
            }
        }
    }

    private void ToggleCommitDetails(string sha)
    {
        try
        {
            if (string.IsNullOrEmpty(sha))
            {
                return;
            }

            if (expandedCommits.Contains(sha))
            {
                expandedCommits.Remove(sha);
            }
            else
            {
                expandedCommits.Add(sha);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Toggle hatası: {ex.Message}");
        }
    }

    private string GetCommitTitle(string message)
    {
        try
        {
            if (string.IsNullOrEmpty(message))
                return "Commit mesajı yok";

            var lines = message.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
            return lines.Length > 0 ? lines[0] : "Commit mesajı yok";
        }
        catch
        {
            return "Commit mesajı yok";
        }
    }

    private string GetCommitDescription(string message)
    {
        try
        {
            if (string.IsNullOrEmpty(message))
                return string.Empty;

            var lines = message.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length > 1)
            {
                return string.Join(" ", lines.Skip(1)).Trim();
            }

            return string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

