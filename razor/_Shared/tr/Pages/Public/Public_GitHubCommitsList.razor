@using System.Net.Http
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Collections.Concurrent
@using Microsoft.Extensions.Caching.Memory
@inject HttpClient Http
@inject IMemoryCache MemoryCache
@code {
    // Gizlemek istenilen dosya adlarını
    public List<string> blackList = new List<string>
  {
  "Deneme",
  "slnx",
  "appsettings",
  "web.config",
  "launchSettings.json",
  "secrets.json",
  ".env",
  "dotnet-tools.json",
  "_ApplicationConnectionDb",
  "Migrations",
  "Account.cs",
  "EmailSender",
  ".db",
  ".sqlite",
  ".mdf",
  ".ldf",
  "Program.cs",
  "Startup.cs",
  "_Imports.razor",
  "Login.razor",
  "NewUserRegister.razor",
  "ResetPassword.razor",
  "bin",
  "obj",
  ".pdb",
  ".log",
  ".dll",
  ".exe",
  ".git",
  "main.yml",
  "main.yaml",
  "DockerFile",
  ".dockerignore",
  ".gitignore",
  "Public_GitHubCommitsList",
  "bundleconfig.json",
  "package.json",
  "package-lock.json"
  };  
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h3 class="text-light mb-2">
                        <i class="fa fa-github"></i> GitHub Commits Dashboard - <b>efavori</b>
                    </h3>
                    <p class="text-warning mb-0">
                        <i class="fa fa-code-fork"></i> Repository: <strong>huseyindemirdoger1992/efavori</strong>
                        <span class="badge bg-dark ms-2">@TotalCode.ToString("N0") satır kod oluşumu</span>
                    </p>
                </div>
                @if (cacheInfo != null)
                {
                    <div class="text-end">
                        <small class="text-light d-block">
                            <i class="fa fa-clock-o"></i> Cache zamanı: @cacheInfo.CachedAt.ToString("dd/MM/yyyy HH:mm:ss")
                        </small>
                        <small class="text-warning">
                            <i class="fa fa-refresh"></i> Sonraki güncelleme: @cacheInfo.NextRefresh.ToString("dd/MM/yyyy HH:mm:ss")
                        </small>
                    </div>
                }
            </div>
            <hr />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="mt-3 h5">Commit'ler GitHub API'den çekiliyor...</p>
            <small class="text-muted">
                @if (loadingProgress.TotalCommits > 0)
                {
                    <span>@loadingProgress.LoadedCommits / @loadingProgress.TotalCommits commit yüklendi (@loadingProgress.ProgressPercentage%)</span>
                }
                else
                {
                    <span>Lütfen bekleyin, veriler yükleniyor...</span>
                }
            </small>
            @if (loadingProgress.TotalCommits > 0)
            {
                <div class="progress mt-3" style="height: 25px; margin: 0 auto;width:100%">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                         role="progressbar"
                         style="width: @(loadingProgress.ProgressPercentage)%"
                         aria-valuenow="@loadingProgress.ProgressPercentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @loadingProgress.ProgressPercentage%
                    </div>
                </div>
            }
        </div>
    }
    else if (commits != null && commits.Any())
    {
        <!-- Filtreler -->
        <div class="row mb-4">
            <div class="col-md-6 mb-2">
                <div class="input-group">
                    <span class="input-group-text bg-dark text-white">
                        <i class="fa fa-search"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Commit mesajında veya SHA kodunda ara..." @bind="searchText" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-6 mb-2">
                <select class="form-select" @bind="selectedAuthor">
                    <option value="">Tüm Yazarlar (@authors.Count)</option>
                    @foreach (var author in authors)
                    {
                        <option value="@author">@author</option>
                    }
                </select>
            </div>
            @* <div class="col-md-3 mb-2">
                <button class="btn btn-primary w-100" @onclick="ForceReload">
                    <i class="fa fa-refresh"></i> Yenile (Cache Temizle)
                </button>
            </div> *@
        </div>

        <!-- İstatistikler -->
        @if (statistics != null)
        {
            <div class="row mb-4 g-3">
                <div class="col-md-2 col-6">
                    <div class="card border-primary shadow-sm">
                        <div class="card-body text-center p-3">
                            <i class="fa fa-github fs-3 text-primary"></i>
                            <h6 class="card-title mt-2 mb-1">Toplam Commit</h6>
                            <h3 class="text-primary mb-0 w-l">@statistics.TotalCommits</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-success shadow-sm">
                        <div class="card-body text-center p-3">
                            <i class="fa fa-plus-circle fs-3 text-success"></i>
                            <h6 class="card-title mt-2 mb-1">Eklenen</h6>
                            <h3 class="text-success mb-0 w-l">+@statistics.TotalAdditions.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-danger shadow-sm">
                        <div class="card-body text-center p-3">
                            <i class="fa fa-minus-circle fs-3 text-danger"></i>
                            <h6 class="card-title mt-2 mb-1">Silinen</h6>
                            <h3 class="text-danger mb-0 w-l">-@statistics.TotalDeletions.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-info shadow-sm">
                        <div class="card-body text-center p-3">
                            <i class="fa fa-pencil-square-o fs-3 text-info"></i>
                            <h6 class="card-title mt-2 mb-1">Değişiklik</h6>
                            <h3 class="text-info mb-0 w-l">@statistics.TotalChanges.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-light shadow-sm">
                        <div class="card-body text-center p-3">
                            <i class="fa fa-users fs-3 text-warning"></i>
                            <h6 class="card-title mt-2 mb-1">Katkıcı</h6>
                            <h3 class="text-warning mb-0 w-l">@statistics.UniqueAuthors</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-warning shadow-sm">
                        <div class="card-body text-center p-3">
                            <i class="fa fa-calendar-check-o fs-3 text-light"></i>
                            <h6 class="card-title mt-2 mb-1">Son Commit</h6>
                            <h3 class="text-light mb-0 b-l">@statistics.LastCommitDate?.ToString("dd/MM/yyyy")</h3>
                        </div>
                    </div>
                </div>
            </div>
        }
        <!-- Commit Listesi -->
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger text-warning" role="alert">
                    <strong>Gizlenen [Dosya/Türler]: </strong> @string.Join(", ", blackList)
                </div>
                <div class="card shadow">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <strong><i class="fa fa-list"></i> İşlem Geçmişi Şimdilik Private (Kaynak Kodlar Gizli)</strong>
                        <span class="badge bg-info text-dark"><strong>@FilteredCommits.Count()</strong> commit gösteriliyor</span>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var commit in FilteredCommits)
                        {
                            var isExpanded = expandedCommits.Contains(commit.Sha);
                            var commitTitle = GetCommitTitle(commit.Commit?.Message);
                            var commitDescription = GetCommitDescription(commit.Commit?.Message);

                            <div class="border-bottom">
                                <div class="p-3 border-bottom @(isExpanded ? "bg-light" : "")" style="cursor: pointer; transition: background-color 0.2s;" @onclick="() => ToggleCommitDetails(commit.Sha)">
                                    <div class="row align-items-center">

                                        <div class="col-md-3 col-sm-12 d-flex align-items-center mb-2 mb-md-0">
                                            <div class="flex-shrink-0">
                                                @if (commit.Author?.AvatarUrl != null)
                                                {
                                                    <img src="@commit.Author.AvatarUrl" alt="@(commit.Author?.Login ?? "User")"
                                                         class="rounded-circle me-2" style="width: 42px; height: 42px; border: 2px solid #dee2e6; object-fit: cover;"
                                                         title="@commit.Author.Login" />
                                                }
                                                else if (commit.Commit?.Author?.Name != null)
                                                {
                                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary text-white me-2"
                                                         style="width: 42px; height: 42px; border: 2px solid #dee2e6; font-size: 0.9rem;">
                                                        <strong>@commit.Commit.Author.Name.Substring(0, 1).ToUpper()</strong>
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex-grow-1 min-width-0">
                                                @if (commit.Author?.Login != null)
                                                {
                                                    <a href="@commit.Author.HtmlUrl" target="_blank" class="text-decoration-none fw-bold text-truncate d-block"
                                                       title="GitHub profilini aç" @onclick:stopPropagation="true">
                                                        <i class="fa fa-github"></i> @commit.Author.Login
                                                    </a>
                                                }
                                                else if (commit.Commit?.Author?.Name != null)
                                                {
                                                    <span class="fw-bold d-block text-truncate">@commit.Commit.Author.Name</span>
                                                }

                                                @*                                               
                                                @if (commit.Commit?.Author?.Email != null)
                                                {
                                                    <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">
                                                        <i class="fa fa-envelope-o"></i> @commit.Commit.Author.Email
                                                    </small>
                                                }
                                                *@
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-12 mb-2 mb-md-0">
                                            <div class="fw-bold text-truncate" title="@commitTitle">
                                                <i class="fa fa-commenting-o text-info me-1"></i>@(commitTitle.Length > 32 ? commitTitle.Substring(0, 32) + "..." : commitTitle)
                                            </div>
                                            @if (!string.IsNullOrEmpty(commitDescription))
                                            {
                                                <small class="text-warning d-block text-truncate" style="max-width: 75%;">
                                                    @commitDescription.Substring(0, Math.Min(commitDescription.Length, 64))@(commitDescription.Length > 64 ? "..." : "")
                                                </small>
                                            }
                                        </div>

                                        <div class="col-md-3 col-sm-6 mb-2 mb-md-0 text-md-center">
                                            <div class="small text-light mb-1 b-l">
                                                <i class="fa fa-calendar me-1"></i>@commit.Commit?.Author?.Date.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                            @if (commit.Stats != null)
                                            {
                                                <div class="d-flex justify-content-md-center">
                                                    <div class="hstack border rounded overflow-hidden" style="font-size: 0.75rem;">
                                                        <div class="bg-success-subtle text-dark px-2 py-1 border-end" title="Eklenen">
                                                            <i class="fa fa-plus me-1"></i>@commit.Stats.Additions
                                                        </div>
                                                        <div class="bg-danger-subtle text-dark px-2 py-1 border-end" title="Silinen">
                                                            <i class="fa fa-minus me-1"></i>@commit.Stats.Deletions
                                                        </div>
                                                        <div class="bg-info-subtle text-dark px-2 py-1" title="Toplam">
                                                            <i class="fa fa-exchange me-1"></i>@commit.Stats.Total
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="col-md-2 col-sm-6 text-end">
                                            <center>
                                                <code class="d-block mb-1 bg-dark text-uppercase badge" title="@commit.Sha">
                                                    <strong class="text-danger">@commit.Sha?.Substring(0, 7)</strong>
                                                </code>
                                            </center>
                                            <div class="d-flex align-items-center justify-content-end gap-2">
                                                @if (commit.Commit?.Verification != null)
                                                {
                                                    <div class="d-flex justify-content-start align-items-center w-100">
                                                        @if (commit.Commit.Verification.Verified)
                                                        {
                                                            <span class="badge rounded-pill bg-success" style="font-size: 0.65rem;" title="Verified">
                                                                <i class="fa fa-check-circle"></i> Verified
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill bg-light border text-dark" style="font-size: 0.65rem;" title="Unverified">
                                                                <i class="fa fa-shield"></i> Unverified
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                <i class="fa fa-chevron-@(isExpanded ? "up" : "down") text-light" style="font-size: 0.8rem;"></i>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Expanded Details -->
                                @if (isExpanded)
                                {
                                    <div class="p-3 bg-light border-top matrix">
                                        <div class="row">
                                            <!-- Sol Kolon: Commit Detayları -->
                                            <div class="col-md-6 mb-3 b-l">
                                                <h6 class="text-warning mb-3">
                                                    <i class="fa fa-info-circle text-info"></i> Commit Detayları
                                                </h6>

                                                <!-- Tam Commit Mesajı -->
                                                <div class="mb-3">
                                                    <strong class="d-block mb-1">
                                                        <i class="fa fa-comment"></i> Tam Mesaj:
                                                    </strong>
                                                    <textarea class="form-control mt-2" rows="3" readonly style="font-size: 0.75rem; font-family: monospace;">@commit.Commit?.Message</textarea>
                                                </div>

                                                <!-- SHA ve URL Bilgileri -->
                                                <div class="mb-3">
                                                    <strong class="d-block mb-1">
                                                        <i class="fa fa-code"></i> SHA:
                                                    </strong>
                                                    <code class="d-block p-2 text-light border rounded">@commit.Sha</code>
                                                    <a href="@commit.HtmlUrl" target="_blank" class="btn btn-sm btn-light mt-1" style="width:100%;">
                                                        <i class="fa fa-external-link"></i> GitHub'da Görüntüle
                                                    </a>
                                                </div>

                                                <!-- Yazar vs Committer -->
                                                @if (commit.Commit?.Author != null || commit.Commit?.Committer != null)
                                                {
                                                    <div class="mb-3">
                                                        <strong class="d-block mb-1">
                                                            <i class="fa fa-user"></i> Katkıda Bulunanlar:
                                                        </strong>
                                                        <div class="p-2 text-light border rounded">
                                                            @if (commit.Commit.Author != null)
                                                            {
                                                                <div class="mb-2">
                                                                    <strong>Yazar:</strong> @commit.Commit.Author.Name
                                                                    @if (!string.IsNullOrEmpty(commit.Commit.Author.Email))
                                                                    {
                                                                        <span>&lt;@commit.Commit.Author.Email&gt;</span>
                                                                    }
                                                                    <br />
                                                                    <small class="text-warning">
                                                                        <i class="fa fa-clock-o"></i> @commit.Commit.Author.Date.ToString("dd/MM/yyyy HH:mm:ss")
                                                                    </small>
                                                                </div>
                                                            }
                                                            @if (commit.Commit.Committer != null && commit.Commit.Committer.Name != commit.Commit.Author?.Name)
                                                            {
                                                                <div>
                                                                    <strong>Committer:</strong> @commit.Commit.Committer.Name
                                                                    @if (!string.IsNullOrEmpty(commit.Commit.Committer.Email))
                                                                    {
                                                                        <span>&lt;@commit.Commit.Committer.Email&gt;</span>
                                                                    }
                                                                    <br />
                                                                    <small class="text-muted">
                                                                        <i class="fa fa-clock-o"></i> @commit.Commit.Committer.Date.ToString("dd/MM/yyyy HH:mm:ss")
                                                                    </small>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Doğrulama Bilgisi -->
                                                @if (commit.Commit?.Verification != null)
                                                {
                                                    <div class="mb-3">
                                                        <strong class="d-block mb-1">
                                                            <i class="fa fa-shield"></i> GPG İmza Doğrulaması:
                                                        </strong>
                                                        <div class="p-2 text-light border rounded">
                                                            <span class="badge @(commit.Commit.Verification.Verified ? "bg-success" : "bg-warning")">
                                                                @(commit.Commit.Verification.Verified ? "✓ Doğrulandı" : "! Doğrulanmadı")
                                                            </span>
                                                            @if (!string.IsNullOrEmpty(commit.Commit.Verification.Reason))
                                                            {
                                                                <div class="mt-1">
                                                                    <small><strong>Sebep:</strong> @commit.Commit.Verification.Reason</small>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(commit.Commit.Verification.Signature))
                                                            {
                                                                <div class="mt-1">
                                                                    <small class="text-muted d-block">İmza mevcut</small>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Parent Commits -->
                                                @if (commit.Parents != null && commit.Parents.Any())
                                                {
                                                    <div class="mb-3">
                                                        <strong class="d-block mb-1">
                                                            <i class="fa fa-sitemap"></i> Üst Commit(ler):
                                                        </strong>
                                                        <div class="p-2 text-light border rounded">
                                                            @foreach (var parent in commit.Parents)
                                                            {
                                                                <div class="mb-1">
                                                                    <a href="@parent.HtmlUrl" target="_blank" class="ms-2 btn btn-sm btn-outline-warning" title="GitHub'da görüntüle" style="width:100%;">
                                                                        <i class="fa fa-external-link"></i>                                                                     <code><b>@parent.Sha?.Substring(0, 7)</b></code>
                                                                    </a>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Sağ Kolon: Dosya Değişiklikleri -->
                                            <div class="col-md-6">
                                                <h6 class="text-success mb-3 w-l">
                                                    <i class="fa fa-files-o"></i> Dosya Değişiklikleri
                                                </h6>
                                                <strong class="d-block mb-1">
                                                    <i class="fa fa-exchange me-1"></i> Değişiklik Değerleri:
                                                </strong>
                                                <!-- Değişiklik İstatistikleri -->
                                                @if (commit.Stats != null)
                                                {
                                                    <div class="mb-3">
                                                        <div class="card border-0 text-light shadow-sm">
                                                            <div class="card-body p-2">
                                                                <div class="row text-center">
                                                                    <div class="col-4">
                                                                        <div class="text-success b-l">
                                                                            <i class="fa fa-plus-circle"></i>
                                                                            <strong class="d-block">@commit.Stats.Additions</strong>
                                                                            <small>Eklenen</small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <div class="text-danger b-l">
                                                                            <i class="fa fa-minus-circle"></i>
                                                                            <strong class="d-block">@commit.Stats.Deletions</strong>
                                                                            <small>Silinen</small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <div class="text-info b-l">
                                                                            <i class="fa fa-exchange"></i>
                                                                            <strong class="d-block">@commit.Stats.Total</strong>
                                                                            <small>Toplam</small>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Dosya Listesi -->
                                                @if (commit.Files != null && commit.Files.Any())
                                                {
                                                    <div class="mb-3">
                                                        <strong class="d-block mb-2">
                                                            <i class="fa fa-file-code-o"></i> Değişen Dosyalar (@commit.Files.Count):
                                                        </strong>
                                                        <div style="max-height: 400px; overflow-y: auto;" class="border rounded text-light">
                                                            @foreach (var file in commit.Files)
                                                            {
                                                                // Dosya adının içinde bu listedeki kelimelerden HERHANGİ BİRİ geçiyor mu
                                                                bool isHidden = blackList.Any(x => file.Filename.Contains(x, StringComparison.OrdinalIgnoreCase));

                                                                if (!string.IsNullOrEmpty(file.Filename) && !isHidden)
                                                                {
                                                                    <div class="p-2 border-bottom">
                                                                        <div class="d-flex justify-content-between align-items-start">
                                                                            <div class="flex-grow-1">
                                                                                <strong class="d-block" style="word-break: break-all;">
                                                                                    @if (file.Status == "added")
                                                                                    {
                                                                                        <i class="fa fa-plus text-success"></i>
                                                                                    }
                                                                                    else if (file.Status == "removed")
                                                                                    {
                                                                                        <i class="fa fa-minus text-danger"></i>
                                                                                    }
                                                                                    else if (file.Status == "modified")
                                                                                    {
                                                                                        <i class="fa fa-pencil text-warning"></i>
                                                                                    }
                                                                                    else if (file.Status == "renamed")
                                                                                    {
                                                                                        <i class="fa fa-arrows text-info"></i>
                                                                                    }
                                                                                    @file.Filename
                                                                                </strong>
                                                                                @if (!string.IsNullOrEmpty(file.PreviousFilename) && file.PreviousFilename != file.Filename)
                                                                                {
                                                                                    <small class="text-muted d-block">
                                                                                        <i class="fa fa-arrow-left"></i> Önceki: @file.PreviousFilename
                                                                                    </small>
                                                                                }
                                                                                <small class="text-muted">
                                                                                    <span class="badge bg-secondary">@file.Status</span>
                                                                                    <span class="text-success ms-1 b-l">+@file.Additions</span>
                                                                                    <span class="text-danger ms-1 b-l">-@file.Deletions</span>
                                                                                    <span class="text-info ms-1 w-l">@file.Changes değişiklik</span>
                                                                                </small>
                                                                            </div>
                                                                            @if (!string.IsNullOrEmpty(file.BlobUrl))
                                                                            {
                                                                                <a href="@file.BlobUrl" target="_blank" class="btn btn-sm btn-outline-light ms-2" title="GitHub'da görüntüle">
                                                                                    <i class="fa fa-external-link"></i>
                                                                                </a>
                                                                            }
                                                                        </div>
                                                                        @if (!string.IsNullOrEmpty(file.Patch))
                                                                        {
                                                                            <details class="mt-2">
                                                                                <summary class="text-warning" style="cursor: pointer;">
                                                                                    <small><i class="fa fa-code"></i> Patch'i göster</small>
                                                                                </summary>
                                                                                <pre class="bg-light p-2 mt-1 rounded" style="font-size: 0.75rem; max-height: 200px; overflow-y: auto;">@file.Patch</pre>
                                                                            </details>
                                                                        }

                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info mb-0">
                                                        <i class="fa fa-info-circle"></i> Dosya değişikliği bilgisi mevcut değil
                                                    </div>
                                                }

                                                <!-- API Links -->
                                                <div class="mt-3">
                                                    <strong class="d-block mb-1">
                                                        <i class="fa fa-link"></i> API Linkleri:
                                                    </strong>
                                                    <div class="btn-group w-100" role="group">
