@using System.Net.Http
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Collections.Concurrent
@using Microsoft.Extensions.Caching.Memory
@inject HttpClient Http
@inject IMemoryCache MemoryCache

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="text-light">
                <i class="bi bi-github"></i> GitHub Commits Listesi - <b>efavori</b> Repository
            </h3>
            <p class="text-warning">Repository: <strong>huseyindemirdoger1992/efavori</strong></p>
            <hr />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="mt-3 h5">Commit'ler yükleniyor...</p>
            <small class="text-muted">
                @if (loadingProgress.TotalCommits > 0)
                {
                    <span>@loadingProgress.LoadedCommits / @loadingProgress.TotalCommits commit yüklendi (@loadingProgress.ProgressPercentage%)</span>
                }
                else
                {
                    <span>Lütfen bekleyin, veriler GitHub API'den çekiliyor...</span>
                }
            </small>
            @if (loadingProgress.TotalCommits > 0)
            {
                <div class="progress mt-3" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: @(loadingProgress.ProgressPercentage)%"
                         aria-valuenow="@loadingProgress.ProgressPercentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @loadingProgress.ProgressPercentage%
                    </div>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Hata Oluştu!</h5>
            <p><strong>Detay:</strong> @errorMessage</p>
            <hr>
            <p class="mb-0">
                <button class="btn btn-danger" @onclick="LoadCommits">
                    <i class="bi bi-arrow-clockwise"></i> Tekrar Dene
                </button>
            </p>
        </div>
    }
    else if (commits != null && commits.Any())
    {
        <!-- Filtreler -->
        <div class="row mb-4">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa fa-search" aria-hidden="true"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Commit mesajında ara..." @bind="searchText" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedAuthor">
                    <option value="">Tüm Yazarlar (@authors.Count)</option>
                    @foreach (var author in authors)
                    {
                        <option value="@author">@author</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="ForceReload">
                    <i class="bi bi-arrow-clockwise"></i> Yenile
                </button>
            </div>
        </div>

        <!-- İstatistikler -->
        @if (statistics != null)
        {
            <div class="row mb-4 g-3">
                <div class="col-md-2">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <i class="bi bi-git fs-3 text-primary"></i>
                            <h6 class="card-title mt-2">Toplam Commit</h6>
                            <h3 class="text-primary mb-0">@statistics.TotalCommits</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <i class="bi bi-plus-circle fs-3 text-success"></i>
                            <h6 class="card-title mt-2">Eklenen Satır</h6>
                            <h3 class="text-success mb-0">+@statistics.TotalAdditions.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <i class="bi bi-dash-circle fs-3 text-danger"></i>
                            <h6 class="card-title mt-2">Silinen Satır</h6>
                            <h3 class="text-danger mb-0">-@statistics.TotalDeletions.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <i class="bi bi-pencil-square fs-3 text-info"></i>
                            <h6 class="card-title mt-2">Toplam Değişiklik</h6>
                            <h3 class="text-info mb-0">@statistics.TotalChanges.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <i class="bi bi-people fs-3 text-warning"></i>
                            <h6 class="card-title mt-2">Katkıda Bulunan</h6>
                            <h3 class="text-warning mb-0">@statistics.UniqueAuthors</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <i class="bi bi-calendar-check fs-3 text-warning"></i>
                            <h6 class="card-title mt-2">En Son Değişiklik</h6>
                            <h3 class="text-light mb-0">@statistics.LastCommitDate?.ToString("dd/MM/yyyy")</h3>
                        </div>
                    </div>
                </div>

            </div>
        }

        <!-- Commit Listesi -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <strong><i class="bi bi-list-ul"></i> Commit Geçmişi</strong>
                        <span class="badge bg-light text-dark">@FilteredCommits.Count() commit gösteriliyor</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 140px;" class="text-center">Tarih</th>
                                        <th style="width: 80px;" class="text-center">Avatar</th>
                                        <th style="width: 150px;">Yazar</th>
                                        <th>Commit Mesajı</th>
                                        <th style="width: 120px;" class="text-center">İstatistikler</th>
                                        <th style="width: 100px;">SHA</th>
                                        <th style="width: 120px;" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var commit in FilteredCommits)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <div>
                                                    <i class="bi bi-calendar3"></i>
                                                    <small class="d-block">@commit.Commit?.Author?.Date.ToString("dd/MM/yyyy")</small>
                                                    <i class="bi bi-clock"></i>
                                                    <small class="d-block text-warning">@commit.Commit?.Author?.Date.ToString("HH:mm:ss")</small>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @if (commit.Author?.AvatarUrl != null)
                                                {
                                                    <img src="@commit.Author.AvatarUrl" alt="@(commit.Author?.Login ?? "User")" class="rounded-circle" style="width: 50px; height: 50px;" />
                                                }
                                                else
                                                {
                                                    <img src="\assets\images\coder.avif" alt="@(commit.Author?.Login ?? "User")" class="rounded-circle" style="width: 50px; height: 50px;" />
                                                }
                                        </td>
                                        <td>
                                            <strong>@(commit.Author?.Login ?? commit.Commit?.Author?.Name ?? "Unknown")</strong>
                                            <br />
                                            <small class="text-warning">@commit.Commit?.Author?.Email</small>
                                        </td>
                                        <td>
                                            <div class="commit-message">
                                                <strong>
                                                    @(GetCommitTitle(commit.Commit?.Message)?.Length > 32
                                                                                                    ? GetCommitTitle(commit.Commit?.Message).Substring(0, 32) + "..."
                                                                                                    : GetCommitTitle(commit.Commit?.Message))
                                                    </strong>
                                                    @if (!string.IsNullOrEmpty(GetCommitDescription(commit.Commit?.Message)))
                                                    {
                                                        <br />
                                                        <small class="text-light">
                                                            @(GetCommitDescription(commit.Commit?.Message)?.Length > 64
                                                                                                            ? GetCommitDescription(commit.Commit?.Message).Substring(0, 64) + "..."
                                                                                                            : GetCommitDescription(commit.Commit?.Message))
                                                        </small>
                                                    }
                                                </div>
                                                @if (commit.Commit?.Verification?.Verified == true)
                                                {
                                                    <span class="badge bg-success mt-1">
                                                        <i class="bi bi-shield-check"></i> Doğrulandı
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (commit.Stats != null)
                                                {
                                                    <div>
                                                        <span class="badge bg-success">+@commit.Stats.Additions</span>
                                                        <span class="badge bg-danger">-@commit.Stats.Deletions</span>
                                                    </div>
                                                    <small class="text-light d-block mt-1">
                                                        @(commit.Files?.Count ?? 0) dosya
                                                    </small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <code class="bg-info p-1 rounded" style="font-size: 0.8rem;">@commit.Sha?.Substring(0, 7)</code>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-light" @onclick="() => ToggleCommitDetails(commit.Sha)" title="Detayları Göster/Gizle">
                                                        @if (expandedCommits.Contains(commit.Sha))
                                                        {
                                                            <i class="fa fa-level-up" aria-hidden="true"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa fa-level-down" aria-hidden="true"></i>
                                                        }
                                                    </button>
@*                                                     <a href="@commit.HtmlUrl" target="_blank" class="btn btn-outline-warning" title="GitHub'da Aç">
                                                        <i class="fa fa-link"></i>
                                                    </a> *@
                                                </div>
                                            </td>
                                        </tr>
                                        @if (expandedCommits.Contains(commit.Sha))
                                        {
                                            <tr>
                                                <td colspan="7" class="bg-light">
                                                    <div class="p-4">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                @if (commit.Files != null && commit.Files.Any())
                                                                {
                                                                    <h6 class="text-light mb-3">
                                                                        <i class="bi bi-file-earmark-diff"></i> Değiştirilen Dosyalar (@commit.Files.Count)
                                                                    </h6>
                                                                    <div class="table-responsive">
                                                                        <table class="table table-sm table-striped">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th>Dosya</th>
                                                                                    <th>Durum</th>
                                                                                    <th class="text-center">Değişiklikler</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var file in commit.Files)
                                                                                {
                                                                                    <tr>
                                                                                        <td>
                                                                                            <small>
                                                                                                <code class="text-light">@file.Filename</code>
                                                                                            </small>
                                                                                        </td>
                                                                                        <td>
                                                                                            @if (file.Status == "added")
                                                                                            {
                                                                                                <span class="badge bg-success"><i class="bi bi-plus-circle"></i> Eklendi</span>
                                                                                            }
                                                                                            else if (file.Status == "modified")
                                                                                            {
                                                                                                <span class="badge bg-warning text-dark"><i class="bi bi-pencil-square"></i> Değiştirildi</span>
                                                                                            }
                                                                                            else if (file.Status == "removed")
                                                                                            {
                                                                                                <span class="badge bg-danger"><i class="bi bi-trash"></i> Silindi</span>
                                                                                            }
                                                                                            else if (file.Status == "renamed")
                                                                                            {
                                                                                                <span class="badge bg-info"><i class="bi bi-arrow-left-right"></i> Yeniden Adlandırıldı</span>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <span class="badge bg-secondary">@file.Status</span>
                                                                                            }
                                                                                        </td>
                                                                                        <td class="text-center">
                                                                                            <span class="badge bg-success me-1">+@file.Additions</span>
                                                                                            <span class="badge bg-danger me-1">-@file.Deletions</span>
                                                                                            <small class="text-muted">(@file.Changes)</small>
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <p class="text-muted"><i class="bi bi-info-circle"></i> Dosya bilgisi mevcut değil.</p>
                                                                }

                                                            </div>
                                                            <div class="col-md-6">
                                                                @if (commit.Parents != null && commit.Parents.Any())
                                                                {
                                                                    <h6 class="text-light mb-3">
                                                                        <i class="bi bi-diagram-3"></i> Üst Commit'ler
                                                                    </h6>
                                                                    <ul class="list-group list-group-flush">
                                                                        @foreach (var parent in commit.Parents)
                                                                        {
                                                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                                <code class="text-light" ">
                                                                                    *** <b>@parent.Sha?.Substring(0, 7)</b> ***
                                                                                </code>
@*                                                                                 <a href="@parent.HtmlUrl" target="_blank" class="btn btn-sm btn-outline-info">
                                                                                    <i class="fa fa-code-fork"></i>
                                                                                </a> *@
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                }

                                                                <h6 class="text-dark mb-3 mt-3">
                                                                    <i class="bi bi-info-circle"></i> Ek Bilgiler
                                                                </h6>
                                                                <ul class="list-unstyled">
                                                                    <li><strong>Committer:</strong> @commit.Committer?.Login</li>
                                                                    @* <li><strong>Node ID:</strong> <small>@commit.NodeId</small></li> *@                                                                    @if (commit.Commit?.CommentCount > 0)
                                                                    {
                                                                        <li><strong>Yorumlar:</strong> @commit.Commit.CommentCount</li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                            <div class="col-md-12">
                                                                <hr style="border: none; border-top: 3px dashed #000; height: 0; width: 100%;">                                                                <div class="commit-message">
                                                                    <strong>
                                                                        @GetCommitTitle(commit.Commit?.Message)
                                                                    </strong>
                                                                    @if (!string.IsNullOrEmpty(GetCommitDescription(commit.Commit?.Message)))
                                                                    {
                                                                        <hr />
                                                                        <small class="text-light">@GetCommitDescription(commit.Commit?.Message)</small>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-inbox"></i> Henüz commit bulunamadı.
        </div>
    }
</div>

@code {
    // Data Models
    public class GitHubCommit
    {
        public string Sha { get; set; }
        public string NodeId { get; set; }
        public CommitDetail Commit { get; set; }
        public string Url { get; set; }
        public string HtmlUrl { get; set; }
        public string CommentsUrl { get; set; }
        public GitHubUser Author { get; set; }
        public GitHubUser Committer { get; set; }
        public List<ParentCommit> Parents { get; set; }
        public CommitStats Stats { get; set; }
        public List<FileChange> Files { get; set; }
    }

    public class CommitDetail
    {
        public GitHubAuthor Author { get; set; }
        public GitHubAuthor Committer { get; set; }
        public string Message { get; set; }
        public string Url { get; set; }
        public int CommentCount { get; set; }
        public CommitVerification Verification { get; set; }
    }

    public class GitHubAuthor
    {
        public string Name { get; set; }
        public string Email { get; set; }
        public DateTime Date { get; set; }
    }

    public class GitHubUser
    {
        public string Login { get; set; }
        public int Id { get; set; }

        [JsonPropertyName("node_id")]
        public string NodeId { get; set; }

        [JsonPropertyName("avatar_url")]
        public string AvatarUrl { get; set; }

        [JsonPropertyName("gravatar_id")]
        public string GravatarId { get; set; }

        public string Url { get; set; }

        [JsonPropertyName("html_url")]
        public string HtmlUrl { get; set; }

        public string Type { get; set; }

        [JsonPropertyName("site_admin")]
        public bool SiteAdmin { get; set; }
    }


    public class ParentCommit
    {
        public string Sha { get; set; }
        public string Url { get; set; }
        public string HtmlUrl { get; set; }
    }

    public class CommitStats
    {
        public int Additions { get; set; }
        public int Deletions { get; set; }
        public int Total { get; set; }
    }

    public class FileChange
    {
        public string Sha { get; set; }
        public string Filename { get; set; }
        public string Status { get; set; }
        public int Additions { get; set; }
        public int Deletions { get; set; }
        public int Changes { get; set; }
        public string BlobUrl { get; set; }
        public string RawUrl { get; set; }
        public string ContentsUrl { get; set; }
        public string Patch { get; set; }
    }

    public class CommitVerification
    {
        public bool Verified { get; set; }
        public string Reason { get; set; }
        public string Signature { get; set; }
        public string Payload { get; set; }
    }

    public class CommitStatistics
    {
        public int TotalCommits { get; set; }
        public int TotalAdditions { get; set; }
        public int TotalDeletions { get; set; }
        public int TotalChanges { get; set; }
        public int UniqueAuthors { get; set; }
        public DateTime? FirstCommitDate { get; set; }
        public DateTime? LastCommitDate { get; set; }
    }

    public class LoadingProgress
    {
        public int TotalCommits { get; set; }
        public int LoadedCommits { get; set; }
        public int ProgressPercentage => TotalCommits > 0 ? (LoadedCommits * 100 / TotalCommits) : 0;
    }

    // Cache Key - Benzersiz ve sabit anahtar
    private const string CACHE_KEY = "GitHubCommits_efavori_huseyindemirdoger1992";

    // Configuration
    private const string GitHubToken = "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";
    private const string UserName = "huseyindemirdoger1992";
    private const string RepoName = "efavori";

    // Fields
    private List<GitHubCommit> commits = new List<GitHubCommit>();
    private List<string> authors = new List<string>();
    private CommitStatistics statistics;
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string searchText = string.Empty;
    private string selectedAuthor = string.Empty;
    private HashSet<string> expandedCommits = new HashSet<string>();
    private int pageSize = 50;
    private int displayCount = 50;
    private LoadingProgress loadingProgress = new LoadingProgress();

    protected override async Task OnInitializedAsync()
    {
        await LoadCommits();
    }

    private async Task ForceReload()
    {
        // IMemoryCache'den cache'i temizle
        MemoryCache.Remove(CACHE_KEY);
        await LoadCommits();
    }

    private async Task LoadCommits()
    {
        isLoading = true;
        errorMessage = string.Empty;
        loadingProgress = new LoadingProgress();
        StateHasChanged();

        try
        {
            // IMemoryCache GetOrCreateAsync kullanımı - Thread-Safe ve Cache Stampede koruması
            commits = await MemoryCache.GetOrCreateAsync(CACHE_KEY, async entry =>
            {
                // Absolute Expiration Policy - Tam 1 dakika ömür
                entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(1);

                // Bu blok sadece cache boş ise çalışır (Factory method)
                Console.WriteLine("Cache MISS - API'den veri çekiliyor...");

                // HttpClient yapılandırması
                Http.DefaultRequestHeaders.Clear();
                Http.DefaultRequestHeaders.Add("User-Agent", "GitHubCommitsApp");
                Http.DefaultRequestHeaders.Add("Accept", "application/vnd.github+json");
                Http.DefaultRequestHeaders.Add("Authorization", $"Bearer {GitHubToken}");
                Http.DefaultRequestHeaders.Add("X-GitHub-Api-Version", "2022-11-28");

                // Tüm commit'leri pagination ile çek
                var allCommitShas = new List<string>();
                int page = 1;
                bool hasMore = true;

                while (hasMore)
                {
                    var listUrl = $"https://api.github.com/repos/{UserName}/{RepoName}/commits?per_page=100&page={page}";
                    Console.WriteLine($"Fetching page {page}: {listUrl}");

                    var listResponse = await Http.GetAsync(listUrl);

                    if (!listResponse.IsSuccessStatusCode)
                    {
                        var errorContent = await listResponse.Content.ReadAsStringAsync();
                        throw new HttpRequestException($"API Hatası ({listResponse.StatusCode}): {errorContent}");
                    }

                    var listJson = await listResponse.Content.ReadAsStringAsync();
                    var pageCommits = JsonSerializer.Deserialize<List<GitHubCommit>>(listJson, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                    if (pageCommits == null || !pageCommits.Any())
                    {
                        hasMore = false;
                    }
                    else
                    {
                        allCommitShas.AddRange(pageCommits.Select(c => c.Sha));
                        Console.WriteLine($"Page {page}: {pageCommits.Count} commits loaded. Total: {allCommitShas.Count}");

                        // İlerlemeyi güncelle
                        loadingProgress.TotalCommits = allCommitShas.Count;
                        await InvokeAsync(StateHasChanged);

                        if (pageCommits.Count < 100)
                        {
                            hasMore = false;
                        }
                        else
                        {
                            page++;
                        }
                    }
                }

                if (!allCommitShas.Any())
                {
                    throw new InvalidOperationException("Repository'de commit bulunamadı.");
                }

                loadingProgress.TotalCommits = allCommitShas.Count;
                await InvokeAsync(StateHasChanged);

                Console.WriteLine($"Toplam {allCommitShas.Count} commit bulundu, detaylar çekiliyor...");

                // Paralel olarak commit detaylarını çek (15 eş zamanlı istek)
                var detailedCommits = new ConcurrentBag<GitHubCommit>();
                var semaphore = new SemaphoreSlim(15, 15);
                var tasks = new List<Task>();

                foreach (var sha in allCommitShas)
                {
                    tasks.Add(Task.Run(async () =>
                    {
                        await semaphore.WaitAsync();
                        try
                        {
                            var commit = await GetCommitDetail(sha);
                            if (commit != null)
                            {
                                detailedCommits.Add(commit);
                                loadingProgress.LoadedCommits = detailedCommits.Count;

                                // Her 10 commit'te bir UI'ı güncelle
                                if (detailedCommits.Count % 10 == 0)
                                {
                                    await InvokeAsync(StateHasChanged);
                                }
                            }
                        }
                        finally
                        {
                            semaphore.Release();
                        }
                    }));
                }

                await Task.WhenAll(tasks);

                var orderedCommits = detailedCommits
                    .OrderByDescending(c => c.Commit?.Author?.Date ?? DateTime.MinValue)
                    .ToList();

                Console.WriteLine($"{orderedCommits.Count} commit detayı başarıyla yüklendi ve cache'e alındı");

                return orderedCommits;
            });

            // Cache'den veri geldi
            if (commits != null && commits.Any())
            {
                Console.WriteLine($"Cache HIT - {commits.Count} commit cache'den yüklendi");
                UpdateUIData();
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Bağlantı Hatası: {ex.Message}";
            Console.WriteLine($"HttpRequestException: {ex}");

            // Hata durumunda mevcut veriyi göstermeye devam et
            if (commits == null || !commits.Any())
            {
                commits = new List<GitHubCommit>();
            }
        }
        catch (JsonException ex)
        {
            errorMessage = $"JSON Parse Hatası: {ex.Message}";
            Console.WriteLine($"JsonException: {ex}");

            if (commits == null || !commits.Any())
            {
                commits = new List<GitHubCommit>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Beklenmeyen Hata: {ex.Message}";
            Console.WriteLine($"Exception: {ex}");

            if (commits == null || !commits.Any())
            {
                commits = new List<GitHubCommit>();
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateUIData()
    {
        // Yazarları topla
        authors = commits
            .Where(c => c.Author != null && !string.IsNullOrEmpty(c.Author.Login))
            .Select(c => c.Author.Login)
            .Distinct()
            .OrderBy(a => a)
            .ToList();

        // İstatistikleri hesapla
        CalculateStatistics();

        Console.WriteLine("UI Data güncellendi");
    }

    private async Task<GitHubCommit> GetCommitDetail(string sha)
    {
        try
        {
            var detailUrl = $"https://api.github.com/repos/{UserName}/{RepoName}/commits/{sha}";
            var response = await Http.GetAsync(detailUrl);

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Commit detayı alınamadı ({sha}): {response.StatusCode}");
                return null;
            }

            var json = await response.Content.ReadAsStringAsync();
            var commit = JsonSerializer.Deserialize<GitHubCommit>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            return commit;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Commit detay hatası ({sha}): {ex.Message}");
            return null;
        }
    }

    private void CalculateStatistics()
    {
        if (commits == null || !commits.Any())
        {
            statistics = null;
            return;
        }

        statistics = new CommitStatistics
        {
            TotalCommits = commits.Count,
            TotalAdditions = commits.Where(c => c.Stats != null).Sum(c => c.Stats.Additions),
            TotalDeletions = commits.Where(c => c.Stats != null).Sum(c => c.Stats.Deletions),
            TotalChanges = commits.Where(c => c.Stats != null).Sum(c => c.Stats.Total),
            UniqueAuthors = commits.Where(c => c.Author != null).Select(c => c.Author.Login).Distinct().Count(),
            FirstCommitDate = commits.OrderBy(c => c.Commit.Author.Date).FirstOrDefault()?.Commit.Author.Date,
            LastCommitDate = commits.OrderByDescending(c => c.Commit.Author.Date).FirstOrDefault()?.Commit.Author.Date
        };
    }

    private IEnumerable<GitHubCommit> FilteredCommits
    {
        get
        {
            var filtered = commits.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                filtered = filtered.Where(c =>
                    c.Commit?.Message?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true);
            }

            if (!string.IsNullOrWhiteSpace(selectedAuthor))
            {
                filtered = filtered.Where(c => c.Author?.Login == selectedAuthor);
            }

            return filtered.OrderByDescending(c => c.Commit?.Author?.Date);
        }
    }

    private void ToggleCommitDetails(string sha)
    {
        if (expandedCommits.Contains(sha))
        {
            expandedCommits.Remove(sha);
        }
        else
        {
            expandedCommits.Add(sha);
        }
    }

    private void LoadMore()
    {
        displayCount += pageSize;
    }

    private string GetCommitTitle(string message)
    {
        if (string.IsNullOrEmpty(message))
            return string.Empty;

        var lines = message.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
        return lines.Length > 0 ? lines[0] : string.Empty;
    }

    private string GetCommitDescription(string message)
    {
        if (string.IsNullOrEmpty(message))
            return string.Empty;

        var lines = message.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);

        // Eğer birden fazla satır varsa, ilk satırı (başlığı) atla ve geri kalanını birleştir
        if (lines.Length > 1)
        {
            return string.Join(" ", lines.Skip(1)).Trim();
        }

        return string.Empty;
    }
