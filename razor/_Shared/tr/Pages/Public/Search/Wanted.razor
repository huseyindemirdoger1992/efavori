@using System.Globalization
@using data
@using api
@using api.tr
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using razor._Shared.tr._DataList
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger
<Notification @ref="notificationRef" />

@{
    var roads = new List<(string icon, string Name, string Url)>
{
    ("fa fa-home", "efavori", "/"),
    ("fa fa-search", "Arama Sonuçları", "javascript:void(0)"),
    ("fa fa-commenting", $"Sorgu: {SearchWantedText}", "javascript:void(0)")
};
}
<razor._Shared.BreadCrumbLinksUrl roads=roads />



<div class="container-fluid">
    <!-- Arama Başlığı -->
    <div class="mb-4">
        <form action="/@culture/Public/Search/Wanted/" method="post" class="position-relative">
            <div class="input-group">
                <input type="search"
                       name="SearchWantedText"
                       id="site-search"
                       class="form-control search-control border-0 shadow-none ps-3"
                       value="@SearchWantedText"
                       placeholder="Ara..."
                       autocomplete="off">

                <button class="btn btn-light border-0 px-4" type="submit">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>

        <div class="d-flex align-items-center mt-2 small">
            <p class="text-light mb-0">
                <strong>"@SearchWantedText"</strong> için <strong>142</strong> sonuç bulundu
            </p>
            <span class="ms-3 text-light opacity-75">
                <i class="fa fa-clock-o me-1"></i>0.38 saniye
            </span>
        </div>
    </div>

    <!-- Son Aramalar -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light border-0 fw-bold d-flex justify-content-between align-items-center">
                <span><i class="fa fa-history me-2 text-light"></i>Son Aramalar</span>
                <button class="btn btn-sm btn-link text-light p-0">Tümünü Temizle</button>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-light border px-3 py-2 rounded-pill">sandalye <i class="fa fa-times ms-1"></i></span>
                    <span class="badge bg-light text-light border px-3 py-2 rounded-pill">ofis koltuğu <i class="fa fa-times ms-1"></i></span>
                    <span class="badge bg-light text-light border px-3 py-2 rounded-pill">ergonomik masa <i class="fa fa-times ms-1"></i></span>
                    <span class="badge bg-light text-light border px-3 py-2 rounded-pill">ahşap mobilya <i class="fa fa-times ms-1"></i></span>
                    <span class="badge bg-light text-light border px-3 py-2 rounded-pill">bar taburesi <i class="fa fa-times ms-1"></i></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            <!-- Tab Başlıkları -->
            <ul class="nav nav-tabs nav-justified" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" data-bs-toggle="tab" href="#Product" role="tab" aria-selected="true">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="tab-icon"><i class="fa fa-shopping-basket font-18 me-2"></i></div>
                            <div class="tab-title">Ürün (86)</div>
                        </div>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" data-bs-toggle="tab" href="#Post" role="tab" aria-selected="false">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="tab-icon"><i class="fa fa-th-large font-18 me-2"></i></div>
                            <div class="tab-title">Gönderi (24)</div>
                        </div>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" data-bs-toggle="tab" href="#Blog" role="tab" aria-selected="false">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="tab-icon"><i class="fa fa-paper-plane-o font-18 me-2"></i></div>
                            <div class="tab-title">Yazı (24)</div>
                        </div>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" data-bs-toggle="tab" href="#User" role="tab" aria-selected="false">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="tab-icon"><i class="fa fa-user-circle-o font-18 me-2"></i></div>
                            <div class="tab-title">Kullanıcı (12)</div>
                        </div>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" data-bs-toggle="tab" href="#Business" role="tab" aria-selected="false">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="tab-icon"><i class="fa fa-briefcase font-18 me-2"></i></div>
                            <div class="tab-title">İşletme (X)</div>
                        </div>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" data-bs-toggle="tab" href="#Setting" role="tab" aria-selected="false">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="tab-icon"><i class="fa fa-cog font-18 me-2"></i></div>
                            <div class="tab-title">Ayar *</div>
                        </div>
                    </a>
                </li>
            </ul>

            <div class="tab-content py-3">

                <!-- ÜRÜN TAB -->
                <div class="tab-pane fade show active" id="Product" role="tabpanel">
                    <div class="row g-3">
                        @if (use is not null)
                        {
                            <Products_ use="@use" SearchWantedText="@SearchWantedText" />
                        }
                        else
                        {
                            <p class="text-light small">Yükleniyor...</p>
                        }
                    </div>
                </div>

                <!-- GÖNDERİ TAB -->
                <div class="tab-pane fade" id="Post" role="tabpanel">
                    <div class="row g-3">
                        @if (use is not null)
                        {
                            <Posts_ use="@use" SearchWantedText="@SearchWantedText" />
                        }
                        else
                        {
                            <p class="text-light small">Yükleniyor...</p>
                        }
                    </div>
                </div>

                <!-- YAZI TAB -->
                <div class="tab-pane fade" id="Blog" role="tabpanel">
                    <div class="row g-3">
                        @if (use is not null)
                        {
                            <Articles_ use="@use" SearchWantedText="@SearchWantedText" />
                        }
                        else
                        {
                            <p class="text-light small">Yükleniyor...</p>
                        }
                    </div>
                </div>

                <!-- KULLANICI TAB -->
                <div class="tab-pane fade" id="User" role="tabpanel">
                    <div class="row g-3">
                        @if (use is not null)
                        {
                            <Users_ use="@use" SearchWantedText="@SearchWantedText" />
                        }
                        else
                        {
                            <p class="text-light small">Yükleniyor...</p>
                        }
                    </div>
                </div>

                <!-- İŞLETME TAB -->
                <div class="tab-pane fade" id="Business" role="tabpanel">
                    <div class="row g-3">
                        @if (use is not null)
                        {
                            <Stores_ use="@use" SearchWantedText="@SearchWantedText" />
                        }
                        else
                        {
                            <p class="text-light small">Yükleniyor...</p>
                        }
                    </div>
                </div>
                <!-- AYAR TAB -->
                <div class="tab-pane fade" id="Setting" role="tabpanel">
                    <div class="row g-4">

                        <!-- Arama Tercihleri -->
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-light border-0 fw-bold">
                                    <i class="fa fa-search me-2 text-light"></i>Arama Tercihleri
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Varsayılan Arama Kategorisi</label>
                                        <select class="form-select form-select-sm">
                                            <option selected>Tümü</option>
                                            <option>Ürün</option>
                                            <option>Gönderi</option>
                                            <option>Kullanıcı</option>
                                            <option>İşletme</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Sayfa Başına Sonuç</label>
                                        <select class="form-select form-select-sm">
                                            <option>12</option>
                                            <option selected>24</option>
                                            <option>48</option>
                                        </select>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="safeSearch" checked>
                                        <label class="form-check-label small" for="safeSearch">Güvenli Arama</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="autoSuggest" checked>
                                        <label class="form-check-label small" for="autoSuggest">Otomatik Tamamlama</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bildirim & Gizlilik -->
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-light border-0 fw-bold">
                                    <i class="fa fa-bell me-2 text-light"></i>Bildirim & Gizlilik
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="searchHistory" checked>
                                        <label class="form-check-label small" for="searchHistory">Arama Geçmişi Kaydet</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="personalResults">
                                        <label class="form-check-label small" for="personalResults">Kişiselleştirilmiş Sonuçlar</label>
                                    </div>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="priceAlert" checked>
                                        <label class="form-check-label small" for="priceAlert">Fiyat Düşüşü Bildirimi</label>
                                    </div>
                                    <hr class="my-2">
                                    <button class="btn btn-outline-danger btn-sm w-100">
                                        <i class="fa fa-trash me-1"></i>Arama Geçmişini Temizle
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@code {

    [Parameter] public Users? use { get; set; }
    [Parameter] public string? SearchWantedText { get; set; }

    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;

    private Notification? notificationRef;
}