@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using api.tr
@using data._Shared
@using razor._Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
<div class="container-fluid p-3">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h3 class="mb-2">
                    <i class="fa fa-tasks"></i> Görevlendirme Panosu
                </h3>
                @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                {
                    <div class="btn-group">
                        <button type="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Yeni Ekle</button>
                        <div class="dropdown-menu dropdown-menu-right dropdown-menu-lg-end" style="">
                            <a class="dropdown-item" href="javascript:;" data-bs-toggle="modal"
                               data-bs-target="#AddNewCategoryModal">
                                <i class="fa fa-address-book"></i> Yeni Kategori
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="javascript:;" @onclick="() => ShowAddTaskModal()" disabled="@IsButtonProcessing("add")">
                                <i class="fa fa-tasks"></i> Yeni Görev
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-secondary btn-sm" disabled>
                        <i class="fa fa-plus"></i> Yeni Görev
                    </button>
                }
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item" role="presentation" title="*.*">
                    <a class="nav-link active" data-bs-toggle="tab" href="#*.*" role="tab" aria-selected="true" tabindex="-1">
                        <div class="d-flex align-items-center">
                            <div class="tab-title">*.*</div>
                        </div>
                    </a>
                </li>
                @foreach (var item in taskCategories)
                {
                    <li class="nav-item" role="presentation" title="@item.Description">
                        <a class="nav-link" data-bs-toggle="tab" href="#@item.Id" role="tab" aria-selected="false" tabindex="-1">
                            <div class="d-flex align-items-center">
                                <div class="tab-title">@item.Title (@GetTaskCount(item))</div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
            <div class="tab-content py-3">
                <div class="tab-pane fade active show" id="*.*" role="tabpanel">
                    <div class="row" style="margin-bottom:12px;">
                        <div class="col-md-12">
                            <label for="inputLastName1" class="form-label">Görevlerde Ara...</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                                <input type="text" class="form-control border-start-0" id="inputLastName1" placeholder="Görev Ara..."
                                       @bind="_SearchText"
                                       @bind:event="oninput"
                                       @onchange="LoadData">
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 row-cols-1 row-cols-md-3 row-cols-lg-5">
                        <div class="col">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-danger text-white sticky-top" style="top: 60px; z-index: 1020;">
                                    <h6 class="mb-0"><i class="fa fa-plus-circle"></i> Yeni (@GetTaskCountByStatus("NewTasks", null))</h6>
                                </div>
                                <div class="card-body p-2 kanban-column bg-primary bg-opacity-10 text-dark"
                                     @ondrop="@(() => HandleDrop("NewTasks"))"
                                     @ondragover:preventDefault="true"
                                     @ondragenter:preventDefault="true">
                                    @foreach (var task in GetTasksByStatus("NewTasks", null))
                                    {
                                        var taskNotesCount = GetTaskNotesCount(task.Id);
                                        var IsOktaskNotesCount = IsOkGetTaskNotesCount(task.Id);
                                        var IsNotOktaskNotesCount = IsNotOkGetTaskNotesCount(task.Id);
                                        <div class="task-card mb-2 bg-danger bg-opacity-25"
                                             draggable="true"
                                             @ondragstart="@(() => HandleDragStart(task.Id))"
                                             @onclick="@(() => ShowTaskDetail(task))">
                                            <h6 class="text-light">@(task.TaskTitle ?? "Başlıksız Görev")</h6>
                                            @if (!string.IsNullOrWhiteSpace(task.TaskDescription))
                                            {
                                                <p class="small text-light mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                    @task.TaskDescription
                                                </p>
                                            }
                                            <hr class="text-light" />
                                            <div class="mb-2">
                                                <span class="badge @GetPriorityBadgeClass(task.Priority) priority-badge" style="width: 100%;">@(task.Priority ?? "Orta")</span>
                                            </div>
                                            <hr class="text-warning" />
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-light bg-danger badge" style="width: 100%;">
                                                    <i class="fa fa-calendar me-1"></i>
                                                    Başlangıç:
                                                    @(task.DateCreatedAt.ToString("dd.MM.yyyy") ?? "-")
                                                </small>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-light bg-success badge" style="width: 100%;">
                                                    <i class="fa fa-calendar me-1"></i>
                                                    Bitiş:
                                                    @(task.TargetDate?.ToString("dd.MM.yyyy") ?? "-")
                                                </small>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-warning bg-light badge" style="width: 100%;">
                                                    <i class="fa fa-clock-o me-1"></i>
                                                    Kalan:
                                                    <span id="timer-@(task.Id)"
                                                          data-start="@task.DateCreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                          data-target="@task.TargetDate?.ToString("yyyy-MM-ddTHH:mm:ss")">
                                                        -
                                                    </span>
                                                    <div class="progress mt-1" style="height: 5px;">
                                                        <div id="progress-@(task.Id)" class="progress-bar bg-warning" role="progressbar" style="width: 0%;"></div>
                                                    </div>
                                                </small>
