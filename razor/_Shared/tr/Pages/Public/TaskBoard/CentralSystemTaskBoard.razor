@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using api.tr
@using data._Shared
@using razor._Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
<div class="container-fluid p-3">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                @if (TaskCategoriesValue == "PlanningTaskBoard")
                {
                    <h3 class="mb-2">
                        <i class="fa fa-list-ul"></i>
                        Plan Aşamasında
                    </h3>
                }
                @if (TaskCategoriesValue == "InProcessTaskBoard")
                {
                    <h3 class="mb-2">
                        <i class="fa fa-refresh"></i>
                        Aktif Görev Panosu
                    </h3>
                }
                @if (TaskCategoriesValue == "CompletedTaskBoard")
                {
                    <h3 class="mb-2">
                        <i class="fa fa-check-circle-o"></i>
                        Tamamlanan Görev Panosu
                    </h3>
                }
                @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                {
                    <div class="btn-group" role="group" aria-label="İşlem Butonları">
                        <button type="button" class="btn btn-light btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#AddNewCategoryModal">
                            <i class="fa fa-address-book"></i> Yeni Kategori
                        </button>

                        <button type="button" class="btn btn-light btn-sm"
                                @onclick="() => ShowAddTaskModal()"
                                disabled="@IsButtonProcessing("add")">
                            <i class="fa fa-tasks"></i> Yeni Görev
                        </button>
                    </div>
                }
                else
                {
                    <div class="btn-group" role="group" aria-label="İşlem Butonları">
                        <button type="button" class="btn btn-light btn-sm">
                            <i class="fa fa-address-book"></i> Yeni Kategori
                        </button>

                        <button type="button" class="btn btn-light btn-sm">
                            <i class="fa fa-tasks"></i> Yeni Görev
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>


    @if (taskCategories == null || !taskCategories.Any())
    {

    }
    else
    {
        <div class="w-100 mt-3">
            <div class="row g-2">

                <div class="col-3">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioAll" value="all" checked autocomplete="off">
                    <label class="btn btn-outline-light btn-sm w-100 py-1 shadow-sm custom-btn" for="radioAll">
                        <i class="fa fa-list me-1"></i> Tüm Görevler (@ToplamGorevSayisi)
                    </label>
                </div>

                <div class="col-3">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioLow" value="low" autocomplete="off">
                    <label class="btn btn-outline-success btn-sm w-100 py-1 text-dark shadow-sm custom-btn" for="radioLow">
                        <i class="fa fa-arrow-circle-down text-dark me-1"></i> Düşük (@DusukGorevSayisi)
                    </label>
                </div>

                <div class="col-3">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioMedium" value="medium" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm w-100 py-1 text-dark shadow-sm custom-btn" for="radioMedium">
                        <i class="fa fa-minus-circle text-dark me-1"></i> Orta (@OrtaGorevSayisi)
                    </label>
                </div>

                <div class="col-3">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioHigh" value="high" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm w-100 py-1 text-dark shadow-sm custom-btn" for="radioHigh">
                        <i class="fa fa-arrow-circle-up text-dark me-1"></i> Yüksek (@YuksekGorevSayisi)
                    </label>
                </div>

            </div>
