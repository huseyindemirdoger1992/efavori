            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title">Görevi Düzenle</h5>
                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                        </button>

                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat" @onclick="CloseEditModal">
                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                    @*                     <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
 *@                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Görev Başlığı</label>
                        <input type="text" class="form-control" @bind="editingTask.TaskTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="3" @bind="editingTask.TaskDescription"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Durum</label>
                            <select class="form-select" @bind="editingTask.Status">
                                <option value="UnSuccessful"> Başarısız/Ertelenmiş</option>
                                <option value="NewTasks">Yeni Görevler</option>
                                <option value="ToBeDone">Yapılacak</option>
                                <option value="InProcess">İşlemde</option>
                                <option value="InEditing">Düzenlemede</option>
                                <option value="Completed">Tamamlandı</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Kategori</label>
                            <select class="form-select" @bind="editingTask.TaskCategoriesId">
                                @foreach (TaskCategories item in taskCategories)
                                {
                                    <option value="@item.Id">@item.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Öncelik</label>
                            <select class="form-select" @bind="editingTask.Priority">
                                <option value="Düşük">Düşük</option>
                                <option value="Orta">Orta</option>
                                <option value="Yüksek">Yüksek</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Hedef Tarih</label>
                            <input type="datetime-local" class="form-control" @bind="editTargetDate" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sorumlu Kişi</label>
                        <select class="form-select" @bind="editSelectedPersonInCharge">
                            <option value="">Seçiniz...</option>
                            @foreach (var user in adminUsers)
                            {
                                <option value="@user.Id">@user.FirstName @user.LastName</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <label class="form-label text-light">Görevin hangi aşamalarında email bildirimi almak istiyorsunuz?</label>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkNew" @bind="editingTask.IsNew">
                                <label class="form-check-label" for="chkNew">Yeni</label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkToBeDone" @bind="editingTask.IsToBeDone">
                                <label class="form-check-label" for="chkToBeDone">Yapılacak</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkInProgress" @bind="editingTask.IsInProgress">
                                <label class="form-check-label" for="chkInProgress">İşlemde</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkInEditing" @bind="editingTask.IsInEditing">
                                <label class="form-check-label" for="chkInEditing">Düzenlemede</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkCompleted" @bind="editingTask.IsCompleted">
                                <label class="form-check-label" for="chkCompleted">Tamamlandı</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEditTask" disabled="@IsButtonProcessing("edit")">
                        @if (IsButtonProcessing("edit"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Güncelle
                    </button>
                </div>
            </div>
        </div>
    </div>
}





<!-- Task Detail Modal -->
@if (showDetailModal && selectedTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                <div class="modal-header border-bottom border-secondary">


                    <h5 class="modal-title text-white">
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DeleteTask" disabled="@IsButtonProcessing("delete")">
                            @if (IsButtonProcessing("delete"))
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="fa fa-trash me-2"></i>
                            }
                        </button>
                        <span class="fw-bold" style="font-size: 1.1rem;">@selectedTask.TaskTitle</span>
                    </h5>

                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                        </button>

                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat" @onclick="CloseDetailModal">
                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                    @*                     <button type="button" class="btn-close" @onclick="CloseDetailModal"></button>
 *@                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Kategori:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetCategoryText(selectedTask.TaskCategoriesId)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Durum:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetStatusText(selectedTask.Status)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Öncelik:</strong>
                            <span class="badge @GetPriorityBadgeClass(selectedTask.Priority)">
                                @selectedTask.Priority
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>Açıklama:</strong>
                        <textarea class="form-control bg-light" rows="3" disabled>@(selectedTask.TaskDescription ?? "Açıklama yok")</textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Oluşturulma:</strong>
                            <p>@selectedTask.DateCreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Hedef Tarih:</strong>
                            <p>@(selectedTask.TargetDate?.ToString("dd.MM.yyyy") ?? "-")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Sorumlu Kişi:</strong>
                            <p>@GetUserName(selectedTask.PersonInChargeUserId)</p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Yeni Not Ekle:</strong></label>
                        @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin" || use?.UsersType == "Employee")
                        {
                            <textarea class="form-control" rows="2" @bind="newNote"></textarea>
                        }
                        else
                        {
                            <textarea class="form-control" rows="2" disabled></textarea>
                        }
                    </div>
                    <button type="button"
                            class="btn btn-outline-info btn-sm"
                            @onclick="AddNote"
                            disabled="@IsButtonProcessing("addNote")"
                            style="width: 100%;">
                        @if (IsButtonProcessing("addNote"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="fa fa-comments"></i>
                        }
                        Not Ekle
                    </button>
                    <hr class="my-3" />
                    @if (taskNotes != null && taskNotes.Any())
                    {
                        <div class="mb-3">
                            <strong>Notlar:</strong>
                            <div class="mt-2 px-1" style="max-height: 250px; overflow-y: auto;">
                                <input class="form-control mb-3" type="text" placeholder="Notlarda ara..." oninput="filterNotes()">
                                @foreach (var note in taskNotes.Where(n => n.TaskStatusId == selectedTask?.Id))
                                {
                                    <div class="card shadow-sm border-0 mb-2 bg-light bg-opacity-10">
                                        <div class="card-body p-2">
                                            <div class="d-flex gap-2">
                                                <div class="flex-shrink-0 pt-1">
                                                    <input class="form-check-input mt-0"
                                                           type="checkbox"
                                                           checked="@(note.IsTheNoteOk == true)"
                                                           @onchange="@(async (e) => await ToggleNoteCompletion(note.Id, (bool)e.Value))"
                                                           id="note-@note.Id"
                                                           style="cursor: pointer; width: 1.2rem; height: 1.2rem;">
                                                </div>
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <small class="text-warning fw-semibold" style="font-size: 0.75rem;">
                                                                <i class="fa fa-clock-o me-1"></i>@note.NoteCreatedAt?.ToString("dd.MM.yyyy HH:mm")
                                                            </small>
                                                            @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                                                            {
                                                                <button class="btn btn-link btn-sm text-info p-0 border-0" title="Notu Düzenle" @onclick="() => EditNoteModalStatu(note)">
                                                                    <i class="fa fa-pencil"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                        @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                                                        {
                                                            <button class="btn btn-link btn-sm text-danger p-0 border-0"
                                                                    @onclick="@(async () => await DeleteNote(note.Id))"
                                                                    title="Notu Sil">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                    <p class="mb-0 text-break @(note.IsTheNoteOk == true ? "text-decoration-line-through opacity-50 text-light" : "text-light")"
                                                       style="font-size: 0.9rem; line-height: 1.4;">
                                                        @note.Note
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <script>
                                    function filterNotes() {
                                        // Arama kutusunu seç
                                        const input = document.querySelector('input[placeholder="Notlarda ara..."]');
                                        if (!input) return;

                                        // Arama metnini al, boşlukları temizle ve yerel dile göre küçük harfe çevir
                                        const filter = input.value.trim().toLocaleLowerCase(window.navigator.language);

                                        // Tüm not kartlarını seç
                                        const notes = document.querySelectorAll('.card.shadow-sm.border-0.mb-2');

                                        notes.forEach(note => {
                                            // Kart içindeki p etiketini bul
                                            const textElement = note.querySelector('p.text-break');

                                            if (textElement) {
                                                const textValue = (textElement.textContent || textElement.innerText)
                                                                  .toLocaleLowerCase(window.navigator.language);

                                                // Emojiler ve özel karakterler dahil içerik kontrolü
                                                if (textValue.includes(filter)) {
                                                    note.style.display = ""; // Varsayılan stil (görünür)
                                                } else {
                                                    note.style.setProperty('display', 'none', 'important'); // Gizle
                                                }
                                            }
                                        });
                                    }
                                </script>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer p-0">
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-outline-light rounded-0" @onclick="CloseDetailModal">
                            Kapat
                        </button>
                        @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                        {
                            <button type="button" class="btn btn-outline-warning rounded-0" @onclick="() => EditTask(selectedTask)">
                                <i class="fa fa-edit"></i> Düzenle
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-warning rounded-0" disabled>
                                <i class="fa fa-edit"></i> Düzenle
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

