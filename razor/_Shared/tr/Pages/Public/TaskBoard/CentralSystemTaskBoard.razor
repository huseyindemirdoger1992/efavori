    protected async Task LoadData()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Kullanıcı tipi kontrolü
            bool isAdminOrSuperAdmin = use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin";
            bool isEmployee = use?.UsersType == "Employee";

            if (use == null || use.Id == Guid.Empty)
                return;

            // Temel TaskStatus sorgusu - IsDeleted filtresi
            var query = db.TaskStatus
                .Where(t => t.IsDeleted == null || t.IsDeleted.IsDeletedStatu != true);

            // Kullanıcı tipine göre TaskStatus bazlı filtreleme
            // TaskKeeperJoint üzerinden atanmış görevleri de dahil et
            var userId = use.Id;

            query = query.Where(t =>
                t.AssignedByUserId == userId ||
                t.PersonInChargeUserId == userId ||
                db.TaskKeeperJoint.Any(j => j.TaskId == t.Id && j.UserId == userId
                    && (j.IsDeleted == null || j.IsDeleted.IsDeletedStatu != true)));

            // TaskCategories için filtre: kendi oluşturduğu VEYA kendisine görev atanmış kategoriler
            var baseCategoryFilter = db.TaskCategories
                .Where(c =>
                    (c.IsDeleted == null || c.IsDeleted.IsDeletedStatu != true) &&
                    // Kullanıcının kendi oluşturduğu VEYA atanmış görevi olan kategoriler
                    (c.UserId == userId ||
                     db.TaskStatus.Any(t =>
                         t.TaskCategoriesId == c.Id &&
                         (t.IsDeleted == null || t.IsDeleted.IsDeletedStatu != true) &&
                         (t.AssignedByUserId == userId ||
                          t.PersonInChargeUserId == userId ||
                          db.TaskKeeperJoint.Any(j => j.TaskId == t.Id && j.UserId == userId
                              && (j.IsDeleted == null || j.IsDeleted.IsDeletedStatu != true))))) &&
                    // Bağlı TaskFramework silinmemişse listele
                    (c.TaskFrameworkId == null ||
                     db.TaskFramework
                         .Any(f => f.Id == c.TaskFrameworkId &&
                                   (f.IsDeleted == null || f.IsDeleted.IsDeletedStatu != true))));

            if (TaskFrameworkId.HasValue && TaskFrameworkId.Value != Guid.Empty)
            {
                taskCategories = await baseCategoryFilter
                    // Görünürlük zaten baseCategoryFilter'da (sahip VEYA atanmış) uygulanıyor;
                    // burada yalnızca seçili bölüme daralt. Fazladan c.UserId==use.Id filtresi
                    // sana atanmış (ama başkasının açtığı) kategorileri gizleyip paneli boş gösteriyordu.
                    .Where(c => c.TaskFrameworkId == TaskFrameworkId)
                    .OrderByDescending(t => t.CreatedAt)
                    .AsNoTracking()
                    .ToListAsync(_cts.Token);

                var tasksQuery = query
                    .AsNoTracking()
                    .Where(t => baseCategoryFilter
                        .Any(c => c.Id == t.TaskCategoriesId &&
                                  c.TaskFrameworkId == TaskFrameworkId));


                tasks = await tasksQuery
                    .OrderByDescending(t => t.DateCreatedAt)
                    .ToListAsync(_cts.Token);
            }
            else
            {
                // CategoryStructure filtresini belirle (null → "All" gibi davranır)
                bool filterByStructure = TaskCategoriesValue != "All" && !string.IsNullOrEmpty(TaskCategoriesValue);

                taskCategories = await baseCategoryFilter
                    .Where(c => !filterByStructure)
                    .OrderByDescending(t => t.CreatedAt)
                    .AsNoTracking()
                    .ToListAsync(_cts.Token);

                var tasksQuery = query
                    .AsNoTracking()
                    .Where(t => baseCategoryFilter
                        .Any(c => c.Id == t.TaskCategoriesId));


                tasks = await tasksQuery
                    .OrderByDescending(t => t.DateCreatedAt)
                    .ToListAsync(_cts.Token);
            }

            // ✅ PERFORMANS: Notlar ve joint'ler yalnızca EKRANDAKİ görevler için yüklenir.
            // (Eskiden taskNotes sistemdeki TÜM notları çekiyordu — büyük veride ağır yük.)
            var taskIds = tasks.Select(t => t.Id).ToList();

            if (taskIds.Any())
            {
                taskNotes = await db.TaskNotes
                    .AsNoTracking()
                    .Where(n => taskIds.Contains(n.TaskStatusId)
                        && (n.IsDeleted == null || n.IsDeleted.IsDeletedStatu != true))
                    .OrderByDescending(t => t.NoteCreatedAt)
                    .ToListAsync(_cts.Token);

                taskKeepers = await db.TaskKeeperJoint
                    .AsNoTracking()
                    .Where(j => taskIds.Contains(j.TaskId)
                        && (j.IsDeleted == null || j.IsDeleted.IsDeletedStatu != true))
                    .ToListAsync(_cts.Token);
            }
            else
            {
                taskNotes = new List<TaskNotes>();
                taskKeepers = new List<TaskKeeperJoint>();
            }

            // === Arkadaş Listesini Yükle ===
            var friendships = await db.FriendShip
                .AsNoTracking()
                .Where(f => (f.RequestorId == use.Id || f.ReceiverId == use.Id)
                    && f.Status == true
                    && (f.IsDeleted != null || f.IsDeleted.IsDeletedStatu != true)
                    && (f.Block == null || f.Block != true))
                .ToListAsync(_cts.Token);

            var friendIds = friendships
                .Select(f => f.RequestorId == use.Id ? f.ReceiverId : f.RequestorId)
                .Distinct()
                .ToList();

            friendList = await db.Users
                .AsNoTracking()
                .Where(u => friendIds.Contains(u.Id)
                    && (u.IsDeleted == null || u.IsDeleted.IsDeletedStatu != true)
                    && u.IsActive == true)
                .ToListAsync(_cts.Token);

            // === Bölümleri (TaskFramework) belleğe yükle — markup artık DB'ye gitmez ===
            taskFrameworks = await db.TaskFramework
                .AsNoTracking()
                .Where(f => (f.IsDeleted == null || f.IsDeleted.IsDeletedStatu != true)
                            && f.UserId == use.Id)
                .OrderByDescending(f => f.CreatedAt)
                .ToListAsync(_cts.Token);

            // === Kullanıcı adı sözlüğü — kart başına DB sorgusunu önler ===
            var userIds = new HashSet<Guid>();
            foreach (var t in tasks)
            {
                if (t.PersonInChargeUserId is Guid pic) userIds.Add(pic);
                if (t.AssignedByUserId is Guid abu) userIds.Add(abu);
            }
            foreach (var k in taskKeepers) userIds.Add(k.UserId);
            if (use != null) userIds.Add(use.Id);

            _userNames = await db.Users
                .AsNoTracking()
                .Where(u => userIds.Contains(u.Id))
                .Select(u => new { u.Id, u.FirstName, u.LastName })
                .ToDictionaryAsync(
                    u => u.Id,
                    u => ($"{u.FirstName} {u.LastName}").Trim(),
                    _cts.Token);

            // ✅ LoadData bir OKUMA işlemidir; broadcast etmez (self-notify döngüsü ve çift yükleme yok).
            // Diğer kullanıcılara bildirim, mutasyon metotlarındaki NotifyDataChanged ile yapılır.
            await InvokeAsync(StateHasChanged); // veriler tazelendi → ekranı kesin olarak yenile
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await LogError(nameof(LoadData), ex);
        }
    }

