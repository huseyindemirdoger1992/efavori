                                                </td>
                                                <td class="text-center py-1">
                                                    <span class="badge @GetKeeperStatusBadge(keeper.Status) small">
                                                        @GetKeeperStatusText(keeper.Status)
                                                    </span>
                                                </td>
                                                <td class="text-light py-1 text-end pe-2 small">
                                                    <i class="fa fa-clock-o me-1 opacity-50"></i>@GetKeeperLastDate(keeper)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
