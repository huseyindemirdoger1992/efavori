    private async Task HandleDrop(string newStatus)
    {
        if (use != null && (use.UsersType == "Customer" || use.UsersType == "SuperAdmin"))
        {
            if (draggedTaskId == null) return;
            await ExecuteWithLock(nameof(HandleDrop), async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var task = await db.TaskStatus.FirstOrDefaultAsync(t => t.Id == draggedTaskId, _cts.Token);
                var taskjoin = await db.TaskKeeperJoint.FirstOrDefaultAsync(t => t.TaskId == draggedTaskId && t.UserId == use.Id, _cts.Token);
                if (task == null) return;

                // ✅ ÖNEMLİ: Kolon yerleşimi keeper (joint) tabanlıdır. Bu yüzden hem ana görevi
                // hem de bu kullanıcının joint kaydını AYNI anda güncelleyip TEK SaveChanges +
                // TEK LoadData ile bitiriyoruz. Eski kodda LoadData, joint güncellenmeden önce
                // çalıştığı için atanmış görevlerde kart yeni kolonda görünmüyordu (geri sıçrıyordu).
                bool changed = false;

                if (task.Status != newStatus)
                {
                    task.Status = newStatus;
                    switch (newStatus)
                    {
                        case "NewTasks": task.DateToBeDone = DateTime.Now; break;
                        case "ToBeDone": task.DateToBeDone = DateTime.Now; break;
                        case "InProcess": task.DateInProcess = DateTime.Now; break;
                        case "InEditing": task.DateInEditing = DateTime.Now; break;
                        case "Completed": task.DateCompleted = DateTime.Now; break;
                    }
                    db.TaskStatus.Update(task);
                    changed = true;
                }

                if (taskjoin != null && taskjoin.Status != newStatus)
                {
                    taskjoin.Status = newStatus;
                    switch (newStatus)
                    {
                        case "NewTasks": taskjoin.DateToBeDone = DateTime.Now; break;
                        case "ToBeDone": taskjoin.DateToBeDone = DateTime.Now; break;
                        case "InProcess": taskjoin.DateInProcess = DateTime.Now; break;
                        case "InEditing": taskjoin.DateInEditing = DateTime.Now; break;
                        case "Completed": taskjoin.DateCompleted = DateTime.Now; break;
                    }
                    db.TaskKeeperJoint.Update(taskjoin);
                    changed = true;
                }

                if (!changed) return;

                await db.SaveChangesAsync(_cts.Token);
                await StateHub.NotifyDataChanged("CentralSystemTaskBoard");
                await ShowNotification("success", "Başarılı", $"Görev '{GetStatusText(newStatus)}' durumuna taşındı.", null);
                await LoadData();
            });
        }
        else
        {
            await ShowNotification("danger", "Hata", $"Görev yetki dışı olduğundan gerçekleştirilmedi", null);
        }
        draggedTaskId = null;
    }
