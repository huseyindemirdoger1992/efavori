    private async Task SaveNewTask()
    {
        if (AddTask == null) return;
        await ExecuteWithLock("save", async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Validasyon
            if (string.IsNullOrEmpty(AddTask.TaskTitle) || string.IsNullOrEmpty(AddTask.TaskDescription) || AddTask.TaskCategoriesId == null)
            {
                await ShowNotification("danger", "Hata", "Boş alan bırakmayınız.", null);
                return;
            }

            // Validasyon: en az bir atama olmalı
            if (!isTaskForSelf && !selectedAssigneeIds.Any())
            {
                await ShowNotification("danger", "Hata", "Lütfen kendinizi veya en az bir arkadaşınızı seçiniz.", null);
                return;
            }

            if (targetDate.HasValue)
            {
                AddTask.TargetDate = targetDate.Value;
            }

            // === Atanacak kişi listesini belirle ===
            var assigneeList = new List<Guid>();

            if (isTaskForSelf)
                assigneeList.Add(use.Id);

            if (selectedAssigneeIds.Any())
                assigneeList.AddRange(selectedAssigneeIds.Where(id => id != use.Id));

            assigneeList = assigneeList.Distinct().ToList();

            // === Görev kaydı ===
            AddTask.AssignedByUserId = use.Id;
            AddTask.PersonInChargeUserId = assigneeList.FirstOrDefault();
            db.TaskStatus.Add(AddTask);

            // === Her atanan kişi için TaskKeeperJoint kaydı ===
            foreach (var assigneeId in assigneeList)
            {
                var joint = new TaskKeeperJoint
                {
                    Id = Guid.NewGuid(),
                    TaskId = AddTask.Id,
                    UserId = assigneeId,
                    Status = "ToBeDone",
                    DateToBeDone = DateTime.UtcNow,
                    CreatedAt = DateTime.UtcNow
                };
                db.TaskKeeperJoint.Add(joint);
            }

            await db.SaveChangesAsync(_cts.Token);
            await StateHub.NotifyDataChanged("CentralSystemTaskBoard");

            var assigneeCount = assigneeList.Count;
            await ShowNotification("success", "Başarılı",
                assigneeCount > 1
                    ? $"Görev {assigneeCount} kişiye atanarak oluşturuldu."
                    : "Görev oluşturuldu.", null);

            await LoadData();
            CloseAddModal();
        });
    }
    private async Task SaveEditTask()
    {
        if (editingTask == null) return;
        await ExecuteWithLock("edit", async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existingTask = await db.TaskStatus.FirstOrDefaultAsync(t => t.Id == editingTask.Id, _cts.Token);
            if (existingTask != null)
            {
                existingTask.TaskTitle = editingTask.TaskTitle;
                existingTask.TaskDescription = editingTask.TaskDescription;
                existingTask.Priority = editingTask.Priority;
                existingTask.Status = editingTask.Status;
                if (editTargetDate.HasValue)
                {
                    existingTask.TargetDate = editTargetDate.Value;
                }
                switch (editingTask.Status)
                {
                    case "NewTasks":
                    case "ToBeDone":
                        if (existingTask.DateToBeDone == null)
                            existingTask.DateToBeDone = DateTime.Now;
                        break;
                    case "InProcess":
                        if (existingTask.DateInProcess == null)
                            existingTask.DateInProcess = DateTime.Now;
                        break;
                    case "InEditing":
                        if (existingTask.DateInEditing == null)
                            existingTask.DateInEditing = DateTime.Now;
                        break;
                    case "Completed":
                        if (existingTask.DateCompleted == null)
                            existingTask.DateCompleted = DateTime.Now;
                        break;
                }
                existingTask.IsNew = editingTask.IsNew ?? false;
                existingTask.IsToBeDone = editingTask.IsToBeDone ?? false;
                existingTask.IsInProgress = editingTask.IsInProgress ?? false;
                existingTask.IsInEditing = editingTask.IsInEditing ?? false;
                existingTask.IsCompleted = editingTask.IsCompleted ?? false;
                existingTask.TaskCategoriesId = editingTask.TaskCategoriesId;

                // === Atanacak kişi listesini belirle ===
                var finalAssigneeIds = new List<Guid>();
                if (editIsTaskForSelf && use != null)
                    finalAssigneeIds.Add(use.Id);
                finalAssigneeIds.AddRange(editSelectedAssigneeIds.Where(id => id != (use?.Id ?? Guid.Empty)));
                finalAssigneeIds = finalAssigneeIds.Distinct().ToList();

                if (finalAssigneeIds.Any())
                    existingTask.PersonInChargeUserId = finalAssigneeIds.First();

                // === Mevcut TaskKeeperJoint kayıtlarını yönet ===
                var existingJoints = await db.TaskKeeperJoint
                    .Where(j => j.TaskId == existingTask.Id && (j.IsDeleted == null || j.IsDeleted.IsDeletedStatu != true))
                    .ToListAsync(_cts.Token);

                var existingUserIds = existingJoints.Select(j => j.UserId).ToList();

                // Çıkarılanları soft-delete et
                foreach (var joint in existingJoints.Where(j => !finalAssigneeIds.Contains(j.UserId)))
                {
                    if (joint.IsDeleted == null) joint.IsDeleted = new IsDeleted();
                    joint.IsDeleted.IsDeletedStatu = true;
                    joint.IsDeleted.DeletedAtDate = DateTime.UtcNow;
                    db.TaskKeeperJoint.Update(joint);
                }

                // Yeni eklenen kişiler için kayıt oluştur
                foreach (var newUserId in finalAssigneeIds.Where(id => !existingUserIds.Contains(id)))
                {
                    db.TaskKeeperJoint.Add(new TaskKeeperJoint
                    {
                        Id = Guid.NewGuid(),
                        TaskId = existingTask.Id,
                        UserId = newUserId,
                        Status = "ToBeDone",
                        DateToBeDone = DateTime.UtcNow,
                        CreatedAt = DateTime.UtcNow
                    });
                }

                // Mevcut katılımcıların aşamalarını güncelle (editTaskKeepers üzerinden)
                foreach (var editKeeper in editTaskKeepers.Where(ek => finalAssigneeIds.Contains(ek.UserId)))
                {
                    var dbJoint = existingJoints.FirstOrDefault(j => j.UserId == editKeeper.UserId);
                    if (dbJoint != null && dbJoint.Status != editKeeper.Status)
                    {
                        dbJoint.Status = editKeeper.Status;
                        switch (editKeeper.Status)
                        {
                            case "ToBeDone": dbJoint.DateToBeDone = DateTime.UtcNow; break;
                            case "InProcess": dbJoint.DateInProcess = DateTime.UtcNow; break;
                            case "InEditing": dbJoint.DateInEditing = DateTime.UtcNow; break;
                            case "Completed": dbJoint.DateCompleted = DateTime.UtcNow; break;
                        }
                        db.TaskKeeperJoint.Update(dbJoint);
                    }
                }

                db.TaskStatus.Update(existingTask);
                await db.SaveChangesAsync(_cts.Token);
                await StateHub.NotifyDataChanged("CentralSystemTaskBoard");
                await ShowNotification("success", "Başarılı", "Görev güncellendi.", null);
                await LoadData();
                CloseEditModal();
            }
        });
    }
    private async Task DeleteTask()
    {
        if (selectedTask == null) return;
        await ExecuteWithLock("delete", async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var task = await db.TaskStatus.FirstOrDefaultAsync(t => t.Id == selectedTask.Id, _cts.Token);
            if (task != null)
            {
                // Soft delete - görev
                if (task.IsDeleted == null)
                {
                    task.IsDeleted = new IsDeleted();
                }
                task.IsDeleted.IsDeletedStatu = true;
                task.IsDeleted.DeletedAtDate = DateTime.Now;
                // Soft delete - ilişkili notlar
                var notes = await db.TaskNotes.Where(n => n.TaskStatusId == task.Id).ToListAsync(_cts.Token);
                foreach (var note in notes)
                {
                    if (note.IsDeleted == null)
                    {
                        note.IsDeleted = new IsDeleted();
                    }
                    note.IsDeleted.IsDeletedStatu = true;
                    note.IsDeleted.DeletedAtDate = DateTime.Now;
                }
                db.TaskStatus.Update(task);
                db.TaskNotes.UpdateRange(notes);
                await db.SaveChangesAsync(_cts.Token);
                await StateHub.NotifyDataChanged("CentralSystemTaskBoard");
                await ShowNotification("success", "Başarılı", "Görev silindi.", null);
                await LoadData();
                CloseDetailModal();
            }
        });
    }
