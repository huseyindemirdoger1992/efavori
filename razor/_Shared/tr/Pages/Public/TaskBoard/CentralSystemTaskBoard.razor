                    </div>
                </div>
            </div>

        }






        <div class="w-100 mt-3">
            <div class="row g-1 d-flex flex-nowrap overflow-auto no-scrollbar align-items-center pb-2">

                <div class="col-auto flex-fill">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioAll" value="all" checked autocomplete="off">
                    <label class="btn btn-outline-light btn-sm w-100 py-1 shadow-sm custom-btn text-nowrap" for="radioAll">
                        <i class="fa fa-list me-1"></i> Tümü
                    </label>
                </div>

                <div class="col-auto flex-fill" @ondrop="@(() => HandleDropPri("Düşük"))" @ondragover:preventDefault="true" @ondragenter:preventDefault="true">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioLow" value="low" autocomplete="off">
                    <label class="btn btn-outline-success btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="radioLow">
                        <i class="fa fa-arrow-circle-down me-1"></i> Düşük
                    </label>
                </div>

                <div class="col-auto flex-fill" @ondrop="@(() => HandleDropPri("Orta"))" @ondragover:preventDefault="true" @ondragenter:preventDefault="true">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioMedium" value="medium" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="radioMedium">
                        <i class="fa fa-minus-circle me-1"></i> Orta
                    </label>
                </div>

                <div class="col-auto flex-fill" @ondrop="@(() => HandleDropPri("Yüksek"))" @ondragover:preventDefault="true" @ondragenter:preventDefault="true">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioHigh" value="high" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="radioHigh">
                        <i class="fa fa-arrow-circle-up me-1"></i> Yüksek
                    </label>
                </div>

                <div class="col-auto flex-fill">
                    <input type="radio" class="btn-check" name="priorityRadio" id="dateMonth" value="1month" autocomplete="off">
                    <label class="btn btn-outline-info btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateMonth">
                        <i class="fa fa-calendar-o me-1"></i> Son 1 Ay
                    </label>
                </div>

                <div class="col-auto flex-fill">
                    <input type="radio" class="btn-check" name="priorityRadio" id="dateWeek" value="1week" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateWeek">
                        <i class="fa fa-hourglass-half me-1"></i> Son 1 Hafta
                    </label>
                </div>

                <div class="col-auto flex-fill">
                    <input type="radio" class="btn-check" name="priorityRadio" id="dateDay" value="1day" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateDay">
                        <i class="fa fa-exclamation-circle me-1"></i> Son 1 Gün
                    </label>
                </div>

                <div class="col-auto flex-fill">
                    <input type="radio" class="btn-check" name="priorityRadio" id="dateHour" value="1hour" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateHour">
                        <i class="fa fa-bolt me-1"></i> Son 1 Saat
                    </label>
                </div>

                <!-- YENİ: Süre Doldu filtresi -->
                <div class="col-auto flex-fill">
                    <input type="radio" class="btn-check" name="priorityRadio" id="dateExpired" value="expired" autocomplete="off">
                    <label class="btn btn-outline-secondary btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateExpired">
                        <i class="fa fa-ban me-1"></i> Süre Doldu
                    </label>
                </div>

            </div>
        </div>

        <script>
            (function () {
                function isExpired(card) {
                    const timerSpan = card.querySelector('span[data-target]');
                    if (!timerSpan) return false;
                    const text = timerSpan.textContent.trim();
                    if (text === 'Süre Doldu') return true;
                    const targetDateStr = timerSpan.getAttribute('data-target');
                    if (!targetDateStr || targetDateStr === '') return false;
                    const targetDate = new Date(targetDateStr);
                    return (targetDate - new Date()) <= 0;
                }

                function updateCounts() {
                    const taskCards = document.querySelectorAll('.task-card:not([data-deleted="true"])');
                    const now = new Date();

                    const counts = {
                        all: 0, low: 0, medium: 0, high: 0,
                        '1month': 0, '1week': 0, '1day': 0, '1hour': 0, expired: 0
                    };

                    taskCards.forEach(card => {
                        if (card.offsetParent === null) return;

                        const badge = card.querySelector('.priority-badge');
                        const priorityText = badge ? badge.textContent.trim().toLocaleLowerCase('tr') : "";

                        const timerSpan = card.querySelector('span[data-target]');
                        const targetDateStr = timerSpan ? timerSpan.getAttribute('data-target') : null;
                        const targetDate = (targetDateStr && targetDateStr !== '') ? new Date(targetDateStr) : null;

                        counts.all++;

                        if (priorityText === "düşük") counts.low++;
                        if (priorityText === "orta") counts.medium++;
                        if (priorityText === "yüksek" || priorityText === "kritik") counts.high++;

                        if (isExpired(card)) counts.expired++;

                        if (targetDate) {
                            const diff = targetDate - now;
                            if (diff > 0 && diff <= 30 * 24 * 60 * 60 * 1000) counts['1month']++;
                            if (diff > 0 && diff <= 7 * 24 * 60 * 60 * 1000)  counts['1week']++;
                            if (diff > 0 && diff <= 24 * 60 * 60 * 1000)       counts['1day']++;
                            if (diff > 0 && diff <= 60 * 60 * 1000)             counts['1hour']++;
                        }
                    });

                    const labelMap = {
                        radioAll:    { prefix: ' Tümü',        count: counts.all },
                        radioLow:    { prefix: ' Düşük',       count: counts.low },
                        radioMedium: { prefix: ' Orta',        count: counts.medium },
                        radioHigh:   { prefix: ' Yüksek',      count: counts.high },
                        dateMonth:   { prefix: ' Son 1 Ay',    count: counts['1month'] },
                        dateWeek:    { prefix: ' Son 1 Hafta', count: counts['1week'] },
                        dateDay:     { prefix: ' Son 1 Gün',   count: counts['1day'] },
                        dateHour:    { prefix: ' Son 1 Saat',  count: counts['1hour'] },
                        dateExpired: { prefix: ' Süre Doldu',  count: counts.expired }
                    };

                    Object.entries(labelMap).forEach(([inputId, data]) => {
                        const label = document.querySelector(`label[for="${inputId}"]`);
                        if (!label) return;
                        const icon = label.querySelector('i');
                        const iconHtml = icon ? icon.outerHTML : '';
                        label.innerHTML = `${iconHtml}${data.prefix} (${data.count})`;
                    });
                }

                function applyFilter(selectedPriority) {
                    const taskCards = document.querySelectorAll('.task-card');
                    const now = new Date();

                    taskCards.forEach(card => {
                        const badge = card.querySelector('.priority-badge');
                        const priorityText = badge ? badge.textContent.trim().toLocaleLowerCase('tr') : "";

                        const timerSpan = card.querySelector('span[data-target]');
                        const targetDateStr = timerSpan ? timerSpan.getAttribute('data-target') : null;
                        const targetDate = (targetDateStr && targetDateStr !== '') ? new Date(targetDateStr) : null;

                        let isVisible = false;

                        if (selectedPriority === "all") {
                            isVisible = true;
                        } else if (selectedPriority === "low" && priorityText === "düşük") {
                            isVisible = true;
                        } else if (selectedPriority === "medium" && priorityText === "orta") {
                            isVisible = true;
                        } else if (selectedPriority === "high" && (priorityText === "yüksek" || priorityText === "kritik")) {
                            isVisible = true;
                        } else if (selectedPriority === "expired") {
                            isVisible = isExpired(card);
                        } else if (targetDate && selectedPriority === "1month") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 30 * 24 * 60 * 60 * 1000;
                        } else if (targetDate && selectedPriority === "1week") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 7 * 24 * 60 * 60 * 1000;
                        } else if (targetDate && selectedPriority === "1day") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 24 * 60 * 60 * 1000;
                        } else if (targetDate && selectedPriority === "1hour") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 60 * 60 * 1000;
                        }

                        card.style.display = isVisible ? "" : "none";
                    });
                }

                document.addEventListener('change', function (e) {
                    if (e.target && e.target.name === 'priorityRadio') {
                        applyFilter(e.target.value);
                    }
                });

                setTimeout(updateCounts, 500);
                setInterval(updateCounts, 1000);
                document.addEventListener('blazor:navigated', () => setTimeout(updateCounts, 300));

            })();
