    <script>
            (function () {
                function isExpired(card) {
                    const timerSpan = card.querySelector('span[data-target]');
                    if (!timerSpan) return false;
                    const text = timerSpan.textContent.trim();
                    if (text === 'Süre Doldu') return true;
                    const targetDateStr = timerSpan.getAttribute('data-target');
                    if (!targetDateStr || targetDateStr === '') return false;
                    const targetDate = new Date(targetDateStr);
                    return (targetDate - new Date()) <= 0;
                }

                function updateCounts() {
                    const taskCards = document.querySelectorAll('.task-card:not([data-deleted="true"])');
                    const now = new Date();

                    const counts = {
                        all: 0, low: 0, medium: 0, high: 0,
                        '1month': 0, '1week': 0, '1day': 0, '1hour': 0, expired: 0
                    };

                    taskCards.forEach(card => {
                        if (card.offsetParent === null) return;

                        const badge = card.querySelector('.priority-badge');
                        const priorityText = badge ? badge.textContent.trim().toLocaleLowerCase('tr') : "";

                        const timerSpan = card.querySelector('span[data-target]');
                        const targetDateStr = timerSpan ? timerSpan.getAttribute('data-target') : null;
                        const targetDate = (targetDateStr && targetDateStr !== '') ? new Date(targetDateStr) : null;

                        counts.all++;

                        if (priorityText === "düşük") counts.low++;
                        if (priorityText === "orta") counts.medium++;
                        if (priorityText === "yüksek" || priorityText === "kritik") counts.high++;

                        if (isExpired(card)) counts.expired++;

                        if (targetDate) {
                            const diff = targetDate - now;
                            if (diff > 0 && diff <= 30 * 24 * 60 * 60 * 1000) counts['1month']++;
                            if (diff > 0 && diff <= 7 * 24 * 60 * 60 * 1000)  counts['1week']++;
                            if (diff > 0 && diff <= 24 * 60 * 60 * 1000)       counts['1day']++;
                            if (diff > 0 && diff <= 60 * 60 * 1000)             counts['1hour']++;
                        }
                    });

                    const labelMap = {
                        radioAll:    { prefix: ' Tümü',        count: counts.all },
                        radioLow:    { prefix: ' Düşük',       count: counts.low },
                        radioMedium: { prefix: ' Orta',        count: counts.medium },
                        radioHigh:   { prefix: ' Yüksek',      count: counts.high },
                        dateMonth:   { prefix: ' Son 1 Ay',    count: counts['1month'] },
                        dateWeek:    { prefix: ' Son 1 Hafta', count: counts['1week'] },
                        dateDay:     { prefix: ' Son 1 Gün',   count: counts['1day'] },
                        dateHour:    { prefix: ' Son 1 Saat',  count: counts['1hour'] },
                        dateExpired: { prefix: ' Süre Doldu',  count: counts.expired }
                    };

                    Object.entries(labelMap).forEach(([inputId, data]) => {
                        const label = document.querySelector(`label[for="${inputId}"]`);
                        if (!label) return;
                        const icon = label.querySelector('i');
                        const iconHtml = icon ? icon.outerHTML : '';
                        label.innerHTML = `${iconHtml}${data.prefix} (${data.count})`;
                    });
                }

                function applyFilter(selectedPriority) {
                    const taskCards = document.querySelectorAll('.task-card');
                    const now = new Date();

                    taskCards.forEach(card => {
                        const badge = card.querySelector('.priority-badge');
                        const priorityText = badge ? badge.textContent.trim().toLocaleLowerCase('tr') : "";

                        const timerSpan = card.querySelector('span[data-target]');
                        const targetDateStr = timerSpan ? timerSpan.getAttribute('data-target') : null;
                        const targetDate = (targetDateStr && targetDateStr !== '') ? new Date(targetDateStr) : null;

                        let isVisible = false;

                        if (selectedPriority === "all") {
                            isVisible = true;
                        } else if (selectedPriority === "low" && priorityText === "düşük") {
                            isVisible = true;
                        } else if (selectedPriority === "medium" && priorityText === "orta") {
                            isVisible = true;
                        } else if (selectedPriority === "high" && (priorityText === "yüksek" || priorityText === "kritik")) {
                            isVisible = true;
                        } else if (selectedPriority === "expired") {
                            isVisible = isExpired(card);
                        } else if (targetDate && selectedPriority === "1month") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 30 * 24 * 60 * 60 * 1000;
                        } else if (targetDate && selectedPriority === "1week") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 7 * 24 * 60 * 60 * 1000;
                        } else if (targetDate && selectedPriority === "1day") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 24 * 60 * 60 * 1000;
                        } else if (targetDate && selectedPriority === "1hour") {
                            const diff = targetDate - now;
                            isVisible = diff > 0 && diff <= 60 * 60 * 1000;
                        }

                        card.style.display = isVisible ? "" : "none";
                    });
                }

                document.addEventListener('change', function (e) {
                    if (e.target && e.target.name === 'priorityRadio') {
                        applyFilter(e.target.value);
                    }
                });

                setTimeout(updateCounts, 500);
                setInterval(updateCounts, 1000);
                document.addEventListener('blazor:navigated', () => setTimeout(updateCounts, 300));

            })();
    </script>
