                                        @GetUserName(assigneeId)
                                        <button type="button" class="btn-close btn-close-white ms-1"
                                                style="font-size: 0.5rem;"
                                                @onclick="() => EditRemoveAssignee(assigneeId)"
                                                @onclick:stopPropagation="true">
                                        </button>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @* === Arkadaş Listesi Tablosu (Scrollable) === *@
                    @{
                        var editFilteredFriends = GetEditFilteredFriends();
                    }
                    @if (friendList.Any())
                    {
                        <div class="mb-3" style="max-height: 160px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.15); border-radius: 0.375rem;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="sticky-top">
                                    <tr class="bg-light">
                                        <th class="text-light small py-1 ps-2" style="width: 40px;"></th>
                                        <th class="text-light small py-1">Ad</th>
                                        <th class="text-light small py-1">Soyad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var editDisplayList = !string.IsNullOrWhiteSpace(editFriendSearchText)
                                            ? editFilteredFriends
                                            : friendList;
                                    }
                                    @foreach (var friend in editDisplayList)
                                    {
                                        var isSelected = editSelectedAssigneeIds.Contains(friend.Id);
                                        <tr class="@(isSelected ? "table-primary" : "")" style="cursor: pointer;"
                                            @onclick="() => EditToggleAssignee(friend.Id)">
                                            <td class="text-center py-1 ps-2">
                                                @if (isSelected)
                                                {
                                                    <i class="fa fa-check-square text-primary"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-square-o text-light"></i>
                                                }
                                            </td>
                                            <td class="text-light py-1 small">@friend.FirstName</td>
                                            <td class="text-light py-1 small">@friend.LastName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* === Katılımcı Aşama Yönetimi === *@
                    @if (editTaskKeepers.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label"><i class="fa fa-sliders me-1"></i> Katılımcı Görev Aşamaları</label>
                            <div style="max-height: 200px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.15); border-radius: 0.375rem;">
                                <table class="table table-sm mb-0">
                                    <thead class="sticky-top">
                                        <tr class="bg-light">
                                            <th class="text-light small py-1 ps-2">Kişi</th>
                                            <th class="text-light small py-1">Aşama</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var keeper in editTaskKeepers)
                                        {
                                            var keeperCopy = keeper;
                                            <tr>
                                                <td class="text-light py-1 ps-2 small">
                                                    <i class="fa fa-user-circle me-1"></i>@GetUserName(keeper.UserId)
                                                </td>
                                                <td class="py-1">
                                                    <select class="form-select form-select-sm"
                                                            value="@keeperCopy.Status"
                                                            @onchange="(e) => OnEditKeeperStatusChanged(keeperCopy, e.Value?.ToString())">
                                                        <option value="ToBeDone">Yapılacak</option>
                                                        <option value="InProcess">İşlemde</option>
                                                        <option value="InEditing">Düzenlemede</option>
                                                        <option value="Completed">Tamamlandı</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-12">
                            <label class="form-label text-light">Görevin hangi aşamalarında email bildirimi almak istiyorsunuz?</label>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkNew" @bind="editingTask.IsNew">
                                <label class="form-check-label" for="chkNew">Yeni</label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkToBeDone" @bind="editingTask.IsToBeDone">
                                <label class="form-check-label" for="chkToBeDone">Yapılacak</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkInProgress" @bind="editingTask.IsInProgress">
                                <label class="form-check-label" for="chkInProgress">İşlemde</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkInEditing" @bind="editingTask.IsInEditing">
                                <label class="form-check-label" for="chkInEditing">Düzenlemede</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkCompleted" @bind="editingTask.IsCompleted">
                                <label class="form-check-label" for="chkCompleted">Tamamlandı</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEditTask" disabled="@IsButtonProcessing("edit")">
                        @if (IsButtonProcessing("edit"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Güncelle
                    </button>
                </div>
            </div>
        </div>
    </div>
}





<!-- Task Detail Modal -->
@if (showDetailModal && selectedTask != null)
{
