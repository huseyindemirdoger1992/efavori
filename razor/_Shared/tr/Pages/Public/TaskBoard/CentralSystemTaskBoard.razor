@using System.Globalization
@using data
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using api.tr
@using data._Shared
@using razor._Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@code {
    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<div class="container-fluid p-3">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">


                @{
                    // Sabit olan ilk 3 elemanı tanımlayalım
                    var roads = new List<(string icon, string Name, string Url)>
                                {
                                ("fa fa-globe", "efavori", "/"),
                                ("fa fa-th-large", "Görev Paneli", "javascript:void(0)")
                                };

                    // Dinamik kısımları belirleyelim
                    string lastIcon = "fa fa-list-ul";
                    string lastName = "";
                    string midName = "Görev Bölümleri"; // Varsayılan orta isim

                    // Durum kontrolü (Pattern Matching kullanarak)
                    switch (TaskCategoriesValue)
                    {
                        case "PlanningTaskBoard":
                            midName = "Görev Durumları";
                            lastName = "Plan Aşamasında";
                            break;
                        case "InProcessTaskBoard":
                            midName = "Görev Durumları";
                            lastIcon = "fa fa-refresh";
                            lastName = "Aktif Görevler";
                            break;
                        case "CompletedTaskBoard":
                            midName = "Görev Durumları";
                            lastIcon = "fa fa-check-circle-o";
                            lastName = "Tamamlananlar";
                            break;
                        default:
                            // Board değerleri dışında kalan durumlar (Senin ilk if-else mantığın)
                            if (TaskCategoriesValue == "All" && (TaskFrameworkId == null || TaskFrameworkId == Guid.Empty))
                            {
                                lastName = "Tüm Görev Bölümleriniz";
                            }
                            else
                            {
                                lastName = db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId)?.Title ?? "Yükleniyor...";
                            }
                            break;
                    }

                    // Listeyi tamamla
                    roads.Add(("fa fa-th-large", midName, "javascript:void(0)"));
                    roads.Add((lastIcon, lastName, "javascript:void(0)"));
                }

                <div>
                    <razor._Shared.BreadCrumbLinksUrl roads="roads" />
                </div>

                @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                {
                    <div class="btn-group" role="group" aria-label="İşlem Butonları">
                        <button type="button" class="btn btn-light btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#AddNewEpisodeModal">
                            <i class="fa fa-folder-open"></i> Yeni Bölüm
                        </button>
                        <div class="modal fade" id="AddNewEpisodeModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                                    <div class="modal-header border-bottom border-secondary">
                                        <h5 class="modal-title text-white">
                                            <i class="fa fa-folder-open"></i> Yeni Görev Bölümü
                                        </h5>

                                        <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                                            <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                                <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                                            </button>

                                            <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                                            <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                                <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                                            </button>
                                        </div>

                                    </div>
                                    <div class="modal-body row">

                                        <div class="col-md-6">
                                            <label class="form-label">İkon</label>
                                            <select class="form-select" @bind="tf.Icon">
                                                <razor._Shared.FaIcons />
                                            </select>
                                        </div>

                                        <div class="col-6">
                                            <label class="form-label">Bölüm Adı</label>
                                            <input class="form-control mb-3" type="text" @bind="tf.Title">
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Bölüm Açıklaması</label>
                                            <textarea class="form-control" rows="3" @bind="tf.Description"></textarea>
                                        </div>

                                    </div>
                                    <div class="modal-footer border-top border-secondary">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>

                                        <button type="button"
                                                class="@(IsButtonProcessing("LoginButton") ? "btn btn-light colored" : "btn btn-light")"
                                                @onclick='async () => await AddNewTaskFramewok()'
                                                disabled="@IsButtonProcessing("LoginButton")">
                                            <i class="fa @(IsButtonProcessing("LoginButton") ? "fa-refresh fa-spin" : "fa-book")"></i>
                                            <span>@(IsButtonProcessing("LoginButton") ? "Yükleniyor..." : "Bölümü Kaydet")</span>
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (db.TaskFramework.Any())
                        {
                            <button type="button" class="btn btn-light btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#AddNewCategoryModal">
                                <i class="fa fa-address-book"></i> Yeni Kategori
                            </button>
                        }
                        @if (db.TaskCategories.Any())
                        {
                            <button type="button" class="btn btn-light btn-sm"
                                    @onclick="() => ShowAddTaskModal()"
                                    disabled="@IsButtonProcessing("add")">
                                <i class="fa fa-tasks"></i> Yeni Görev
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="btn-group" role="group" aria-label="İşlem Butonları">
                        <button type="button" class="btn btn-light btn-sm">
                            <i class="fa fa-address-book"></i> Yeni Kategori
                        </button>

                        <button type="button" class="btn btn-light btn-sm">
                            <i class="fa fa-tasks"></i> Yeni Görev
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    @if (taskCategories == null || !taskCategories.Any())
    {
        if (use != null)
        {
            <div class="container-fluid vh-50 d-flex justify-content-center align-items-center bg-light">
                <div class="col-12 col-md-8 col-lg-5">
                    <div class=" bg-transparent text-center">
                        <div class="card-body p-5">
                            <center>
                                <div class="position-relative mb-5">
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <i class="fa fa-circle-o-notch fa-spin fa-4x text-primary opacity-50"></i>
                                    </div>
                                    <i class="fa fa-database fa-3x text-primary position-relative"></i>
                                </div>
                            </center>

                            <center>
                                <h2 class="fw-light text-dark mb-1 tracking-tight">Bu Alanda Veri Yok</h2>
                            </center>

                            <hr />
                            <center>
                                <p class="text-light mb-4 small fw-medium text-uppercase badge bg-dark tracking-widest" style="letter-spacing: 2px;">
                                    "Bölüm > Kategori > Görev" oluşturabilirsiniz.
                                </p>
                            </center>


                            <center>
                                <div class="progress mb-4 shadow-sm" style="height: 12px; border-radius: 50px; background-color: #e9ecef;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                         role="progressbar"
                                         style="width: 100%; border-radius: 50px;">
                                    </div>
                                </div>
                            </center>




                            <center>
                                <div class="d-flex justify-content-between align-items-center p-3 rounded-4 shadow-sm border bg-light"
                                     style="background: linear-gradient(90deg, rgba(85, 42, 155, 0.05) 0%, rgba(83, 193, 237, 0.05) 100%);">
                                    <div class="text-start">
                                        <small class="d-block text-muted fw-bold">Durum:</small>
                                    </div>
                                    <div class="text-end">
                                        <i class="fa fa-refresh text-primary me-2"></i>
                                        <small class="text-dark fw-bold">Veri Girişi Bekleniyor</small>
                                    </div>
                                </div>
                            </center>


                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="container-fluid vh-50 d-flex justify-content-center align-items-center bg-light">
                <div class="col-12 col-md-8 col-lg-5">
                    <div class=" bg-transparent text-center">
                        <div class="card-body p-5">

                            <div class="position-relative mb-5">
                                <div class="position-absolute top-50 start-50 translate-middle">
                                    <i class="fa fa-circle-o-notch fa-spin fa-4x text-primary opacity-50"></i>
                                </div>
                                <i class="fa fa-user fa-3x text-primary position-relative"></i>
                            </div>

                            <h2 class="fw-light text-dark mb-1 tracking-tight">Kulanıcı Bulunamadı...</h2>
                            <hr />
                            <p class="text-light mb-4 small fw-medium text-uppercase tracking-widest" style="letter-spacing: 2px;">
                                Veri işleyebilmek için ilk olarak oturum açmalısınız.
                            </p>

                            <div class="progress mb-4 shadow-sm" style="height: 12px; border-radius: 50px; background-color: #e9ecef;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                     role="progressbar"
                                     style="width: 100%; border-radius: 50px;">
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-3 rounded-4 shadow-sm border bg-light"
                                 style="background: linear-gradient(90deg, rgba(85, 42, 155, 0.05) 0%, rgba(83, 193, 237, 0.05) 100%);">
                                <div class="text-start">
                                    <small class="d-block text-muted fw-bold">Durum:</small>
                                </div>
                                <div class="text-end">
                                    <i class="fa fa-refresh text-primary me-2"></i>
                                    <small class="text-dark fw-bold">Yetkisiz Erişim</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    }
    else
    {
        @if (TaskFrameworkId != null && TaskFrameworkId != Guid.Empty)
        {
            <div class="alert border-0 border-start border-2 border-white alert-dismissible fade show d-flex align-items-center justify-content-between">
                <div class="text-white">
                    <b>@db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId)?.Title</b> Bölümü için işlemler:
                </div>

                <div class="d-flex align-items-center ms-auto">
                    <button type="button" class="btn btn-link text-warning p-0 me-3" title="Düzenle" data-bs-toggle="modal" data-bs-target="#EditFramework">
                        <i class="fa fa-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-link text-danger p-0 me-3" title="Sil" data-bs-toggle="modal" data-bs-target="#TrashFramework">
                        <i class="fa fa-trash"></i>
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="position: static; padding: 0.5rem;"></button>
                </div>
            </div>
            <div class="modal fade" id="EditFramework" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                        <div class="modal-header border-bottom border-secondary">
                            <h5 class="modal-title text-white">
                                <i class="fa fa-edit"></i> Bölüm düzenleme işlemi
                            </h5>
                            <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                                <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                    <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                                </button>

                                <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                                <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                    <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                                </button>
                            </div>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">İkon</label>
                                    <select class="form-select" @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Icon">
                                        <razor._Shared.FaIcons />
                                    </select>
                                </div>

                                <div class="col-6">
                                    <label class="form-label">Bölüm Adı</label>
                                    <input class="form-control mb-3 bg-light" type="text"
                                           @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Title">
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Bölüm Açıklaması</label>
                                    <textarea class="form-control bg-light" rows="3"
                                              @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Description"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-top border-secondary">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                            <button type="button"
                                    class="btn btn-light @(IsButtonProcessing("EditFramework") ? "colored" : "")"
                                    @onclick='() => EditFramework(TaskFrameworkId)'
                                    disabled="@IsButtonProcessing("EditFramework")">

                                <i class="fa @(IsButtonProcessing("EditFramework") ? "fa-refresh fa-spin" : "fa-save")"></i>
                                <span>
                                    @(IsButtonProcessing("EditFramework") ? " Kaydediliyor..." : " Kaydet ve Kapat")
                                </span>
                            </button>
                        </div>


                    </div>
                </div>
            </div>
            <div class="modal fade" id="TrashFramework" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                        <div class="modal-header border-bottom border-secondary">
                            <h5 class="modal-title text-white">
                                <i class="fa fa-trash"></i> Bölüm silme işlemi
                            </h5>
                            <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                                <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                    <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                                </button>

                                <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                                <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                    <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                                </button>
                            </div>
                        </div>

                        <div class="modal-body">
                            <div class="col-12">
                                <label class="form-label">Bölüm Adı</label>
                                <input class="form-control mb-3 bg-light" type="text"
                                       @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Title">
                            </div>

                            <div class="col-12">
                                <label class="form-label">Bölüm Açıklaması</label>
                                <textarea class="form-control bg-light" rows="3"
                                          @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Description"></textarea>
                            </div>
                        </div>

                        <div class="modal-footer border-top border-secondary">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>

                            <button type="button"
                                    class="@(IsButtonProcessing("TrashFramework") ? "btn btn-danger colored" : "btn btn-danger")"
                                    @onclick='() => TrashFramework(TaskFrameworkId)'
                                    disabled="@IsButtonProcessing("TrashFramework")">

                                <i class="fa @(IsButtonProcessing("TrashFramework") ? "fa-refresh fa-spin" : "fa-trash")"></i>

                                <span>
                                    @(IsButtonProcessing("TrashFramework") ? "Siliniyor..." : "Çöp Kutusuna Taşı")
                                </span>
                            </button>

                        </div>
                    </div>
                </div>
            </div>

        }

        <div class="w-100 mt-3">
            <div class="row g-2">
                <div class="col-3">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioAll" value="all" checked autocomplete="off">
                    <label class="btn btn-outline-light btn-sm w-100 py-1 shadow-sm custom-btn" for="radioAll">
                        <i class="fa fa-list me-1"></i> Tüm Görevler
                    </label>
                </div>
                <div class="col-3"
                     @ondrop="@(() => HandleDropPri("Düşük"))"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioLow" value="low" autocomplete="off">
                    <label class="btn btn-outline-success btn-sm w-100 py-1 text-dark shadow-sm custom-btn" for="radioLow">
                        <i class="fa fa-arrow-circle-down text-dark me-1"></i> Düşük Öncelikli
                    </label>
                </div>
                <div class="col-3"
                     @ondrop="@(() => HandleDropPri("Orta"))"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioMedium" value="medium" autocomplete="off">
                    <label class="btn btn-outline-warning btn-sm w-100 py-1 text-dark shadow-sm custom-btn" for="radioMedium">
                        <i class="fa fa-minus-circle text-dark me-1"></i> Orta Öncelikli
                    </label>
                </div>
                <div class="col-3"
                     @ondrop="@(() => HandleDropPri("Yüksek"))"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true">
                    <input type="radio" class="btn-check" name="priorityRadio" id="radioHigh" value="high" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm w-100 py-1 text-dark shadow-sm custom-btn" for="radioHigh">
                        <i class="fa fa-arrow-circle-up text-dark me-1"></i> Yüksek Öncelikli
                    </label>
                </div>
            </div>
        </div>
        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-12">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa fa-search text-light"></i>
                    </span>
                    <input type="text"
                           class="form-control border-start-0 ps-0"
                           id="inputLastName1"
                           placeholder="Görev adını yazın..."
                           value="@_SearchText"
                           @oninput="OnSearchInput">
                </div>
            </div>
        </div>
        <script>
                document.querySelectorAll('input[name="priorityRadio"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    const selectedPriority = this.value; // "all", "low", "medium", "high"
                    const taskCards = document.querySelectorAll('.task-card');

                    taskCards.forEach(card => {
                        // Kartın içindeki badge metnini al (Küçük harfe çevirip temizliyoruz)
                        const badge = card.querySelector('.priority-badge');
                        const priorityText = badge ? badge.textContent.trim().toLowerCase() : "";

                        // Eşleştirme Mantığı
                        let isVisible = false;

                        if (selectedPriority === "all") {
                            isVisible = true;
                        } else if (selectedPriority === "low" && priorityText === "düşük") {
                            isVisible = true;
                        } else if (selectedPriority === "medium" && priorityText === "orta") {
                            isVisible = true;
                        } else if (selectedPriority === "high" && (priorityText === "yüksek" || priorityText === "kritik")) {
                            isVisible = true;
                        }
                        // Kartı göster veya gizle
                        if (isVisible) {
                            card.style.display = "block";
                            // İstersen buraya animasyon eklemek için: card.classList.add('fade-in');
                        } else {
                            card.style.display = "none";
                        }
                    });
                });
            });
        </script>
        <div class="card">
            <div class="card-body">
                <ul class="nav nav-tabs" role="tablist">

                    <li class="nav-item" role="presentation" title="*.*">
                        <a class="nav-link active" data-bs-toggle="tab" href="#*.*" role="tab" aria-selected="true" tabindex="-1">
                            <div class="d-flex align-items-center">
                                <div class="tab-title">*.*</div>
                            </div>
                        </a>
                    </li>

                    @foreach (var item in taskCategories)
                    {
                        <li class="nav-item" role="presentation" title="@item.Description"
                            @ondrop="@(() => HandleDropCate(item.Id))"
                            @ondragover:preventDefault="true"
                            @ondragenter:preventDefault="true">
                            <a class="nav-link" data-bs-toggle="tab" href="#@item.Id" role="tab" aria-selected="false" tabindex="-1">
                                <div class="d-flex align-items-center">
                                    <div class="tab-title">@item.Title (@GetTaskCount(item))</div>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
                <div class="tab-content py-3">

                        <div class="tab-pane fade active show" id="*.*" role="tabpanel">

                            <div class="row g-3 align-items-end mb-3">
                                <div class="col-md-12">
                                    <button class="btn btn-light w-100 d-flex align-items-center justify-content-center py-2 shadow-sm"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapseTwo"
                                            aria-expanded="false"
                                            aria-controls="collapseTwo"
                                            @ondrop="@(() => HandleDrop("UnSuccessful"))"
                                            @ondragover:preventDefault="true"
                                            @ondragenter:preventDefault="true">
                                        <i class="fa fa-bars"></i>
                                        <span> Başarısız/Ertelenmiş (@GetTaskCountByStatus("UnSuccessful", null))</span>
                                    </button>
                                </div>
                            </div>
                            @* Genel yapı tüm görevler *@
                            <div class="accordion" id="accordionExample">
                                <div class="accordion-item">
                                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                                        <br />
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <div class="card border-0 shadow-sm h-100">
                                                    <div class="card-header bg-danger text-white sticky-top" style="top: 60px; z-index: 1020;">
                                                        <h6 class="mb-0"><i class="fa fa-bars"></i> Başarıya Ulaşamamış Ertelenmiş Görevler (@GetTaskCountByStatus("UnSuccessful", null))</h6>
                                                    </div>
                                                    <div class="card-body p-2 kanban-column bg-primary bg-opacity-10 text-dark"
                                                         @ondrop="@(() => HandleDrop("UnSuccessful"))"
                                                         @ondragover:preventDefault="true"
                                                         @ondragenter:preventDefault="true">
                                                        <div class="row g-2 row-cols-1 row-cols-md-2 row-cols-lg-5">
                                                            @foreach (var task in GetTasksByStatus("UnSuccessful", null, TaskFrameworkId))
                                                            {
                                                                var taskNotesCount = GetTaskNotesCount(task.Id);
                                                                var IsOktaskNotesCount = IsOkGetTaskNotesCount(task.Id);
                                                                var IsNotOktaskNotesCount = IsNotOkGetTaskNotesCount(task.Id);
                                                                <div class="col d-flex">
                                                                    <div class="task-card mb-2 bg-danger bg-opacity-25 w-100"
                                                                         draggable="true"
                                                                         @ondragstart="@(() => HandleDragStart(task.Id))"
                                                                         @onclick="@(() => ShowTaskDetail(task))">
                                                                        <span>
                                                                            @{
                                                                                var categoryText = GetCategoryText(task.TaskCategoriesId);
                                                                            }

