                                            var taskNotesCount = GetTaskNotesCount(task.Id);
                                            var IsOktaskNotesCount = IsOkGetTaskNotesCount(task.Id);
                                            var IsNotOktaskNotesCount = IsNotOkGetTaskNotesCount(task.Id);
                                            <div class="task-card mb-2 bg-success bg-opacity-25"
                                                 draggable="true"
                                                 @ondragstart="@(() => HandleDragStart(task.Id))"
                                                 @onclick="@(() => ShowTaskDetail(task))">
                                                <h6 class="text-light">@((task.TaskTitle?.Length > 20) ? task.TaskTitle.Substring(0, 20) + "..." : (task.TaskTitle ?? "Başlıksız Görev"))</h6>
                                                @if (!string.IsNullOrWhiteSpace(task.TaskDescription))
                                                {
                                                    <p class="small text-light mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                        @task.TaskDescription
                                                    </p>
                                                }
                                                <hr class="text-light" />
                                                <div class="mb-2">
                                                    <span class="badge @GetPriorityBadgeClass(task.Priority) priority-badge" style="width: 100%;">@(task.Priority ?? "Orta")</span>
                                                </div>
                                                <hr class="text-warning" />
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small class="text-light bg-danger badge" style="width: 100%;">
                                                        <i class="fa fa-calendar me-1"></i>
                                                        Başlangıç:
                                                        @(task.DateCreatedAt.ToString("dd.MM.yyyy") ?? "-")
                                                    </small>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small class="text-light bg-success badge" style="width: 100%;">
                                                        <i class="fa fa-calendar me-1"></i>
                                                        Bitiş:
                                                        @(task.TargetDate?.ToString("dd.MM.yyyy") ?? "-")
                                                    </small>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small class="text-light bg-dark badge" style="width: 100%;">
                                                        <i class="fa fa-check me-1"></i>
                                                        Tamamlandı
                                                    </small>
                                                </div>
                                                @if (taskNotesCount > 0)
                                                {
                                                    <hr class="text-info" />
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <small class="text-dark bg-warning badge" style="width: 100%;">
                                                            Görev içerisindeki notlar
                                                        </small>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <small class="text-light bg-primary badge" style="width: 100%;">
                                                            <i class="fa fa-th-list me-1"></i>
                                                            @taskNotesCount
                                                        </small>
                                                        <small class="text-light bg-light badge" style="width: 100%;">
                                                            <i class="fa fa-hourglass-half me-1"></i>
                                                            @IsNotOktaskNotesCount
                                                        </small>
                                                        <small class="text-light bg-success badge" style="width: 100%;">
                                                            <i class="fa fa-check-square me-1"></i>
                                                            @IsOktaskNotesCount
                                                        </small>
                                                    </div>
                                                }
                                                <hr class="text-info" />
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small class="text-light" style="width: 100%;">
                                                        <i class="fa fa-user me-1"></i>
                                                        @{
                                                            var userName = GetUserName(task.PersonInChargeUserId);
                                                            userName = string.IsNullOrWhiteSpace(userName) ? "Atanmamış" : userName;
                                                        }
                                                        <span class="text-light">@userName</span>
                                                        @if (task.AssignedByUserId == use?.Id && !IsUserAssignedToTask(task.Id, use?.Id ?? Guid.Empty))
                                                        {
                                                            <span class="badge bg-info small ms-1" title="Arkadaş Görevi"><i class="fa fa-share-alt"></i></span>
                                                        }
                                                    </small>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="modal fade" id="edit_@item.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                                <div class="modal-header border-bottom border-secondary">
                                    <h5 class="modal-title text-white">
                                        <i class="fa fa-edit"></i> Kategori bilgilerini düzenleyebilirsiniz
                                    </h5>
                                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                                        </button>

                                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-6">
                                            <label class="form-label">Görev Bölümü</label>
                                            <select class="form-select" @bind="TaskFrameworkId">
                                                <option value="">...</option>
                                                @foreach (TaskFramework tf in db.TaskFramework.ToList())
                                                {
                                                    <option value=@tf.Id>@tf.Title</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-6">
                                            <label class="form-label">Görev Durumu</label>
                                            <select class="form-select" @bind="CategoryStructure">
                                                <option value="">...</option>
                                                <option value="PlanningTaskBoard">Plan Aşamasında</option>
                                                <option value="InProcessTaskBoard">Aktif Görev</option>
                                                <option value=CompletedTaskBoard>Tamamlandı</option>
                                            </select>
                                        </div>
                                        <div class="col-md-12 mb-12" style="margin-top:12px;">
                                            <label class="form-label">Kategori Adı</label>
                                            <input class="form-control mb-3" type="text" @bind="item.Title">
                                        </div>
                                        <div class="col-md-12 mb-12">
                                            <label>Kategori Açıklaması</label>
                                            <textarea class="form-control" rows="3" @bind="item.Description"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-top border-secondary">
                                    <button type="button"
                                            class="btn btn-light @(IsButtonProcessing("EditBtn_" + item.Id) ? "colored" : "")"
                                            style="width:100%;"
                                            @onclick='async () => await EditCategori(item)'
                                            disabled="@IsButtonProcessing("EditBtn_" + item.Id)">
                                        <i class="fa @(IsButtonProcessing("EditBtn_" + item.Id) ? "fa-refresh fa-spin" : "fa-edit")"></i>
                                        <span>
                                            @(IsButtonProcessing("EditBtn_" + item.Id) ? "Yükleniyor..." : "Düzenlemeyi Kaydet")
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="delete_@item.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                                <div class="modal-header border-bottom border-secondary">
                                    <h5 class="modal-title text-white">
                                        <i class="fa fa-edit"></i> Kategori bilgilerini silebilirsiniz
                                    </h5>
                                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                                        </button>

                                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="modal-body">
                                    <div class="col-12">
                                        <label>Kategori Adı</label>
                                        <input class="form-control mb-3" type="text" @bind="item.Title" readonly>
                                    </div>
                                    <div class="col-12">
                                        <label>Kategori Açıklaması</label>
                                        <textarea class="form-control" rows="3" @bind="item.Description" readonly></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer border-top border-secondary">
                                    <button type="button"
                                            class="btn btn-danger @(IsButtonProcessing("EditBtn_" + item.Id) ? "colored" : "")"
                                            data-bs-dismiss="modal"
                                            style="width:100%;"
                                            @onclick='async () => await DeleteCategori(item)'
                                            disabled="@IsButtonProcessing("EditBtn_" + item.Id)">
                                        <i class="fa @(IsButtonProcessing("EditBtn_" + item.Id) ? "fa-refresh fa-spin" : "fa-trash")"></i>
                                        <span>
                                            @(IsButtonProcessing("EditBtn_" + item.Id) ? "Yükleniyor..." : "Kategoriyi & İçerisindekileri Sil")
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
}


</div>
<!-- Add Task Modal -->
@if (AddTaskshowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title"><i class="fa fa-tasks"></i> Yeni Görev Oluştur</h5>
                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                        </button>

                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat" @onclick="CloseAddModal">
                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                    @*                     <button type="button" class="btn-close" @onclick="CloseAddModal"></button>
 *@
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Görev Başlığı</label>
                        <input type="text" class="form-control" @bind="AddTask.TaskTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="3" @bind="AddTask.TaskDescription"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Kategori</label>
                            <select class="form-select" @bind="AddTask.TaskCategoriesId">
                                @foreach (var item in taskCategories)
                                {
                                    <option value="@item.Id">@item.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Öncelik</label>
                            <select class="form-select" @bind="AddTask.Priority">
                                <option value="Düşük">Düşük</option>
                                <option value="Orta">Orta</option>
                                <option value="Yüksek">Yüksek</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Hedef Tarih</label>
                            <input type="datetime-local" class="form-control" @bind="targetDate" />
                        </div>
                    </div>

                    @* === Görev Atama === *@
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkForSelf" @bind="isTaskForSelf">
                            <label class="form-check-label" for="chkForSelf">Kendim İçin</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-search"></i> Listeden Arkadaş Ara</label>
                        <input type="text" class="form-control" placeholder="Ad veya soyad yazın..."
                               value="@friendSearchText"
                               @oninput="OnFriendSearchInput" />
                    </div>

                    @* === Seçilen Kişiler === *@
                    @if (selectedAssigneeIds.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label small text-light">
                                <i class="fa fa-check-circle"></i> Seçilen Kişiler (@selectedAssigneeIds.Count)
                            </label>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var assigneeId in selectedAssigneeIds)
                                {
                                    var assignee = friendList.FirstOrDefault(f => f.Id == assigneeId);
                                    if (assignee != null)
                                    {
                                        <span class="badge bg-primary d-inline-flex align-items-center gap-1 py-2 px-2">
                                            <i class="fa fa-user"></i>
                                            @assignee.FirstName @assignee.LastName
                                            <button type="button" class="btn-close btn-close-white ms-1"
                                                    style="font-size: 0.5rem;"
                                                    @onclick="() => RemoveAssignee(assigneeId)"
                                                    @onclick:stopPropagation="true">
                                            </button>
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @* === Arkadaş Listesi Tablosu (Scrollable) === *@
                    @{
                        var filteredFriends = GetFilteredFriends();
                    }
                    @if (friendList.Any())
                    {
                        <div class="mb-3" style="max-height: 200px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.15); border-radius: 0.375rem;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="sticky-top">
                                    <tr class="bg-light">
                                        <th class="text-light small py-1 ps-2" style="width: 40px;"></th>
                                        <th class="text-light small py-1">Ad</th>
                                        <th class="text-light small py-1">Soyad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        // Arama varsa filtrelenmiş listeyi, yoksa tüm listeyi göster
                                        var displayList = !string.IsNullOrWhiteSpace(friendSearchText)
                                            ? filteredFriends
                                            : friendList;
                                    }
                                    @if (displayList.Any())
                                    {
                                        @foreach (var friend in displayList)
                                        {
                                            var isSelected = selectedAssigneeIds.Contains(friend.Id);
                                            <tr class="@(isSelected ? "table-primary" : "")" style="cursor: pointer;"
                                                @onclick="() => ToggleAssignee(friend.Id)">
                                                <td class="text-center py-1 ps-2">
                                                    @if (isSelected)
                                                    {
                                                        <i class="fa fa-check-square text-primary"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-square-o text-light"></i>
                                                    }
                                                </td>
                                                <td class="text-light py-1 small">@friend.FirstName</td>
                                                <td class="text-light py-1 small">@friend.LastName</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-warning py-2 small">
                                                <i class="fa fa-info-circle"></i> Eşleşen arkadaş bulunamadı.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <i class="fa fa-info-circle"></i> Arkadaş listenizde henüz kimse yok.
                        </div>
                    }

                    @* === Görev Atama Özeti === *@
                    <div class="mb-3 p-2 border rounded bg-light bg-opacity-25">
                        <small class="text-light">
                            <i class="fa fa-info-circle me-1"></i>
                            @if (isTaskForSelf && !selectedAssigneeIds.Any())
                            {
                                <span>Bu görev sadece <strong>kendinize</strong> atanacaktır.</span>
                            }
                            else if (!isTaskForSelf && selectedAssigneeIds.Any())
                            {
                                <span>Bu görev seçtiğiniz <strong>@selectedAssigneeIds.Count arkadaşınıza</strong> atanacaktır.</span>
                            }
                            else if (isTaskForSelf && selectedAssigneeIds.Any())
                            {
                                <span>Bu görev <strong>kendinize</strong> ve seçtiğiniz <strong>@selectedAssigneeIds.Count arkadaşınıza</strong> atanacaktır.</span>
                            }
                            else
                            {
                                <span class="text-warning"><i class="fa fa-exclamation-triangle me-1"></i> Lütfen kendinizi veya en az bir arkadaşınızı seçin.</span>
                            }
                        </small>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="form-label">Görevin hangi aşamalarında email bildirimi almak istiyorsunuz?</label>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsNew">
                                <label class="form-check-label" for="flexCheckDefault">Yeni </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsToBeDone">
                                <label class="form-check-label" for="flexCheckDefault">Yapılacak </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsInProgress">
                                <label class="form-check-label" for="flexCheckDefault">İşlemde </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsInEditing">
                                <label class="form-check-label" for="flexCheckDefault">Düzenlemede </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsCompleted">
                                <label class="form-check-label" for="flexCheckDefault">Tamamlandı </label>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddModal">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveNewTask" disabled="@IsButtonProcessing("save")">
                        @if (IsButtonProcessing("save"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

