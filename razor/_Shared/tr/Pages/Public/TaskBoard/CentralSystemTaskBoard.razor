                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetCategoryText(selectedTask.TaskCategoriesId)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Durum:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetStatusText(selectedTask.Status)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Öncelik:</strong>
                            <span class="badge @GetPriorityBadgeClass(selectedTask.Priority)">
                                @selectedTask.Priority
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-light">
                                <i class="fa fa-file-text-o me-1"></i> Açıklama:
                            </strong>
                            <span class="badge bg-light text-info border"
                                  style="cursor: pointer;"
                                  @onclick="() => CopyText(selectedTask.TaskDescription)"
                                  title="Panoya Kopyala">
                                <i class="fa fa-clipboard text-info"></i> Kopyala
                            </span>
