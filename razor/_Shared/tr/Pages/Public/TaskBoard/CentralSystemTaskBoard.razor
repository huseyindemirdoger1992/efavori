                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat" @onclick="CloseAddModal">
                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                    @*                     <button type="button" class="btn-close" @onclick="CloseAddModal"></button>
 *@
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Görev Başlığı</label>
                        <input type="text" class="form-control" @bind="AddTask.TaskTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="3" @bind="AddTask.TaskDescription"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Kategori</label>
                            <select class="form-select" @bind="AddTask.TaskCategoriesId">
                                @foreach (var item in taskCategories)
                                {
                                    <option value="@item.Id">@item.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Öncelik</label>
                            <select class="form-select" @bind="AddTask.Priority">
                                <option value="Düşük">Düşük</option>
                                <option value="Orta">Orta</option>
                                <option value="Yüksek">Yüksek</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Hedef Tarih</label>
                            <input type="datetime-local" class="form-control" @bind="targetDate" />
                        </div>
                    </div>

                    @* === Görev Atama === *@
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkForSelf" @bind="isTaskForSelf">
                            <label class="form-check-label" for="chkForSelf">Kendim İçin</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-search"></i> Listeden Arkadaş Ara</label>
                        <input type="text" class="form-control" placeholder="Ad veya soyad yazın..."
                               value="@friendSearchText"
                               @oninput="OnFriendSearchInput" />
                    </div>

                    @* === Seçilen Kişiler === *@
                    @if (selectedAssigneeIds.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label small text-light">
                                <i class="fa fa-check-circle"></i> Seçilen Kişiler (@selectedAssigneeIds.Count)
                            </label>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var assigneeId in selectedAssigneeIds)
                                {
                                    var assignee = friendList.FirstOrDefault(f => f.Id == assigneeId);
                                    if (assignee != null)
                                    {
                                        <span class="badge bg-primary d-inline-flex align-items-center gap-1 py-2 px-2">
                                            <i class="fa fa-user"></i>
                                            @assignee.FirstName @assignee.LastName
                                            <button type="button" class="btn-close btn-close-white ms-1"
                                                    style="font-size: 0.5rem;"
                                                    @onclick="() => RemoveAssignee(assigneeId)"
                                                    @onclick:stopPropagation="true">
                                            </button>
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @* === Arkadaş Listesi Tablosu (Scrollable) === *@
                    @{
                        var filteredFriends = GetFilteredFriends();
                    }
                    @if (friendList.Any())
                    {
                        <div class="mb-3" style="max-height: 200px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.15); border-radius: 0.375rem;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="sticky-top">
                                    <tr class="bg-light">
                                        <th class="text-light small py-1 ps-2" style="width: 40px;"></th>
                                        <th class="text-light small py-1">Ad</th>
                                        <th class="text-light small py-1">Soyad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        // Arama varsa filtrelenmiş listeyi, yoksa tüm listeyi göster
                                        var displayList = !string.IsNullOrWhiteSpace(friendSearchText)
                                            ? filteredFriends
                                            : friendList;
                                    }
                                    @if (displayList.Any())
                                    {
                                        @foreach (var friend in displayList)
                                        {
                                            var isSelected = selectedAssigneeIds.Contains(friend.Id);
                                            <tr class="@(isSelected ? "table-primary" : "")" style="cursor: pointer;"
                                                @onclick="() => ToggleAssignee(friend.Id)">
                                                <td class="text-center py-1 ps-2">
                                                    @if (isSelected)
                                                    {
                                                        <i class="fa fa-check-square text-primary"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-square-o text-light"></i>
                                                    }
                                                </td>
                                                <td class="text-light py-1 small">@friend.FirstName</td>
                                                <td class="text-light py-1 small">@friend.LastName</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-warning py-2 small">
                                                <i class="fa fa-info-circle"></i> Eşleşen arkadaş bulunamadı.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <i class="fa fa-info-circle"></i> Arkadaş listenizde henüz kimse yok.
                        </div>
                    }

                    @* === Görev Atama Özeti === *@
                    <div class="mb-3 p-2 border rounded bg-light bg-opacity-25">
                        <small class="text-light">
                            <i class="fa fa-info-circle me-1"></i>
                            @if (isTaskForSelf && !selectedAssigneeIds.Any())
                            {
                                <span>Bu görev sadece <strong>kendinize</strong> atanacaktır.</span>
                            }
                            else if (!isTaskForSelf && selectedAssigneeIds.Any())
                            {
                                <span>Bu görev seçtiğiniz <strong>@selectedAssigneeIds.Count arkadaşınıza</strong> atanacaktır.</span>
                            }
                            else if (isTaskForSelf && selectedAssigneeIds.Any())
                            {
                                <span>Bu görev <strong>kendinize</strong> ve seçtiğiniz <strong>@selectedAssigneeIds.Count arkadaşınıza</strong> atanacaktır.</span>
                            }
                            else
                            {
                                <span class="text-warning"><i class="fa fa-exclamation-triangle me-1"></i> Lütfen kendinizi veya en az bir arkadaşınızı seçin.</span>
                            }
                        </small>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="form-label">Görevin hangi aşamalarında email bildirimi almak istiyorsunuz?</label>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsNew">
                                <label class="form-check-label" for="flexCheckDefault">Yeni </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsToBeDone">
                                <label class="form-check-label" for="flexCheckDefault">Yapılacak </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsInProgress">
                                <label class="form-check-label" for="flexCheckDefault">İşlemde </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsInEditing">
                                <label class="form-check-label" for="flexCheckDefault">Düzenlemede </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="AddTask.IsCompleted">
                                <label class="form-check-label" for="flexCheckDefault">Tamamlandı </label>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddModal">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveNewTask" disabled="@IsButtonProcessing("save")">
                        @if (IsButtonProcessing("save"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit Task Modal -->
@if (EditTaskshowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title">Görevi Düzenle</h5>
                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                        </button>

                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat" @onclick="CloseEditModal">
                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                    @*                     <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
 *@
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Görev Başlığı</label>
                        <input type="text" class="form-control" @bind="editingTask.TaskTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="3" @bind="editingTask.TaskDescription"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Durum</label>
                            <select class="form-select" @bind="editingTask.Status">
                                <option value="UnSuccessful"> Başarısız/Ertelenmiş</option>
                                <option value="NewTasks">Yeni Görevler</option>
                                <option value="ToBeDone">Yapılacak</option>
                                <option value="InProcess">İşlemde</option>
                                <option value="InEditing">Düzenlemede</option>
                                <option value="Completed">Tamamlandı</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Kategori</label>
                            <select class="form-select" @bind="editingTask.TaskCategoriesId">
                                @foreach (TaskCategories item in taskCategories)
                                {
                                    <option value="@item.Id">@item.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Öncelik</label>
                            <select class="form-select" @bind="editingTask.Priority">
                                <option value="Düşük">Düşük</option>
                                <option value="Orta">Orta</option>
                                <option value="Yüksek">Yüksek</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Hedef Tarih</label>
                            <input type="datetime-local" class="form-control" @bind="editTargetDate" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="editChkForSelf" @bind="editIsTaskForSelf">
                            <label class="form-check-label" for="editChkForSelf">Kendim İçin</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fa fa-search"></i> Listeden Arkadaş Ara</label>
                        <input type="text" class="form-control" placeholder="Ad veya soyad yazın..."
                               value="@editFriendSearchText"
                               @oninput="OnEditFriendSearchInput" />
                    </div>

                    @* === Seçilen Kişiler Badge === *@
                    @if (editSelectedAssigneeIds.Any())
                    {
                        <div class="mb-2">
                            <label class="form-label small text-light">
                                <i class="fa fa-check-circle"></i> Atanan Kişiler (@editSelectedAssigneeIds.Count)
                            </label>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var assigneeId in editSelectedAssigneeIds)
                                {
                                    <span class="badge bg-primary d-inline-flex align-items-center gap-1 py-2 px-2">
                                        <i class="fa fa-user"></i>
                                        @GetUserName(assigneeId)
                                        <button type="button" class="btn-close btn-close-white ms-1"
                                                style="font-size: 0.5rem;"
                                                @onclick="() => EditRemoveAssignee(assigneeId)"
                                                @onclick:stopPropagation="true">
                                        </button>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @* === Arkadaş Listesi Tablosu (Scrollable) === *@
                    @{
                        var editFilteredFriends = GetEditFilteredFriends();
                    }
                    @if (friendList.Any())
                    {
                        <div class="mb-3" style="max-height: 160px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.15); border-radius: 0.375rem;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="sticky-top">
                                    <tr class="bg-light">
                                        <th class="text-light small py-1 ps-2" style="width: 40px;"></th>
                                        <th class="text-light small py-1">Ad</th>
                                        <th class="text-light small py-1">Soyad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var editDisplayList = !string.IsNullOrWhiteSpace(editFriendSearchText)
                                            ? editFilteredFriends
                                            : friendList;
                                    }
                                    @foreach (var friend in editDisplayList)
                                    {
                                        var isSelected = editSelectedAssigneeIds.Contains(friend.Id);
                                        <tr class="@(isSelected ? "table-primary" : "")" style="cursor: pointer;"
                                            @onclick="() => EditToggleAssignee(friend.Id)">
                                            <td class="text-center py-1 ps-2">
                                                @if (isSelected)
                                                {
                                                    <i class="fa fa-check-square text-primary"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-square-o text-light"></i>
                                                }
                                            </td>
                                            <td class="text-light py-1 small">@friend.FirstName</td>
                                            <td class="text-light py-1 small">@friend.LastName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* === Katılımcı Aşama Yönetimi === *@
                    @if (editTaskKeepers.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label"><i class="fa fa-sliders me-1"></i> Katılımcı Görev Aşamaları</label>
                            <div style="max-height: 200px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.15); border-radius: 0.375rem;">
                                <table class="table table-sm mb-0">
                                    <thead class="sticky-top">
                                        <tr class="bg-light">
                                            <th class="text-light small py-1 ps-2">Kişi</th>
                                            <th class="text-light small py-1">Aşama</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var keeper in editTaskKeepers)
                                        {
                                            var keeperCopy = keeper;
                                            <tr>
                                                <td class="text-light py-1 ps-2 small">
                                                    <i class="fa fa-user-circle me-1"></i>@GetUserName(keeper.UserId)
                                                </td>
                                                <td class="py-1">
                                                    <select class="form-select form-select-sm"
                                                            value="@keeperCopy.Status"
                                                            @onchange="(e) => OnEditKeeperStatusChanged(keeperCopy, e.Value?.ToString())">
                                                        <option value="ToBeDone">Yapılacak</option>
                                                        <option value="InProcess">İşlemde</option>
                                                        <option value="InEditing">Düzenlemede</option>
                                                        <option value="Completed">Tamamlandı</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-12">
                            <label class="form-label text-light">Görevin hangi aşamalarında email bildirimi almak istiyorsunuz?</label>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkNew" @bind="editingTask.IsNew">
                                <label class="form-check-label" for="chkNew">Yeni</label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkToBeDone" @bind="editingTask.IsToBeDone">
                                <label class="form-check-label" for="chkToBeDone">Yapılacak</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkInProgress" @bind="editingTask.IsInProgress">
                                <label class="form-check-label" for="chkInProgress">İşlemde</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkInEditing" @bind="editingTask.IsInEditing">
                                <label class="form-check-label" for="chkInEditing">Düzenlemede</label>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkCompleted" @bind="editingTask.IsCompleted">
                                <label class="form-check-label" for="chkCompleted">Tamamlandı</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEditTask" disabled="@IsButtonProcessing("edit")">
                        @if (IsButtonProcessing("edit"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Güncelle
                    </button>
                </div>
            </div>
        </div>
    </div>
}





<!-- Task Detail Modal -->
@if (showDetailModal && selectedTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                <div class="modal-header border-bottom border-secondary">


                    <h5 class="modal-title text-white d-flex align-items-center">
                        <a type="button" class="btn btn-sm btn-outline-light me-2" title="Yazdır" href="/@culture/Public/TaskBoard/PrintTask/@selectedTask.Id" target="_blank">
                            <i class="fa fa-print" aria-hidden="true"></i>
                        </a>

                        <span class="fw-bold" style="font-size: 1.1rem;">@selectedTask.TaskTitle</span>
                    </h5>

                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                        </button>

                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat" @onclick="CloseDetailModal">
                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                    @*<button type="button" class="btn-close" @onclick="CloseDetailModal"></button>*@
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Kategori:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetCategoryText(selectedTask.TaskCategoriesId)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Durum:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetStatusText(selectedTask.Status)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Öncelik:</strong>
                            <span class="badge @GetPriorityBadgeClass(selectedTask.Priority)">
                                @selectedTask.Priority
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-light">
                                <i class="fa fa-file-text-o me-1"></i> Açıklama:
                            </strong>
                            <span class="badge bg-light text-info border"
                                  style="cursor: pointer;"
                                  @onclick="() => CopyText(selectedTask.TaskDescription)"
                                  title="Panoya Kopyala">
                                <i class="fa fa-clipboard text-info"></i> Kopyala
                            </span>
                        </div>
                        <textarea class="form-control bg-light border-0 shadow-sm"
                                  rows="3"
                                  readonly>@(selectedTask.TaskDescription ?? "Açıklama yok")</textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Oluşturulma:</strong>
                            <p>@selectedTask.DateCreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Hedef Tarih:</strong>
                            <p>@(selectedTask.TargetDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Sorumlu Kişi:</strong>
                            <p>@GetUserName(selectedTask.PersonInChargeUserId)</p>
                        </div>
                    </div>
                    @* ✅ Mobil için dokunmatik durum taşıma (sürükle-bırak dokunmatikte çalışmaz) *@
                    @if (use?.UsersType == "Customer" || use?.UsersType == "SuperAdmin")
                    {
                        <div class="mb-3">
                            <strong class="d-block mb-1"><i class="fa fa-random me-1"></i> Durumu Taşı:</strong>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var st in new[] { ("NewTasks", "Yeni"), ("ToBeDone", "Yapılacak"), ("InProcess", "İşlemde"), ("InEditing", "Düzenlemede"), ("Completed", "Tamamlandı"), ("UnSuccessful", "Ertelenmiş") })
                                {
                                    <button type="button"
                                            class="btn btn-sm @(selectedTask.Status == st.Item1 ? "btn-primary" : "btn-outline-secondary")"
                                            disabled="@(selectedTask.Status == st.Item1 || IsButtonProcessing(nameof(HandleDrop)))"
                                            @onclick="@(() => QuickMoveStatus(st.Item1))">
