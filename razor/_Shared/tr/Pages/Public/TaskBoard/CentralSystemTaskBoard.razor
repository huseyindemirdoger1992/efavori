                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa fa-search text-light"></i>
                    </span>
                    <input type="text"
                           class="form-control border-start-0 ps-0"
                           id="inputLastName1"
                           placeholder="Görev adını yazın..."
                           @bind="SearchText"
                           @bind:event="oninput">
                </div>
            </div>
        </div>
        <script>
                                        document.querySelectorAll('input[name="priorityRadio"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    const selectedPriority = this.value; // "all", "low", "medium", "high"
                    const taskCards = document.querySelectorAll('.task-card');

                    taskCards.forEach(card => {
                        // Kartın içindeki badge metnini al (Küçük harfe çevirip temizliyoruz)
                        const badge = card.querySelector('.priority-badge');
                        const priorityText = badge ? badge.textContent.trim().toLowerCase() : "";

                        // Eşleştirme Mantığı
                        let isVisible = false;

                        if (selectedPriority === "all") {
                            isVisible = true;
                        } else if (selectedPriority === "low" && priorityText === "düşük") {
                            isVisible = true;
                        } else if (selectedPriority === "medium" && priorityText === "orta") {
                            isVisible = true;
                        } else if (selectedPriority === "high" && (priorityText === "yüksek" || priorityText === "kritik")) {
                            isVisible = true;
                        }
                        // Kartı göster veya gizle
                        if (isVisible) {
                            card.style.display = "block";
                            // İstersen buraya animasyon eklemek için: card.classList.add('fade-in');
                        } else {
                            card.style.display = "none";
                        }
                    });
                });
            });
        </script>
