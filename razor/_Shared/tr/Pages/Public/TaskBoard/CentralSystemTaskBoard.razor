    private List<data._Tasks.TaskStatus> GetTasksByStatus(string status, Guid? TaskCategoriesId, Guid? TaskFramewokId)
    {
        using var db = DbFactory.CreateDbContext();

        // Sorguyu kategorilere göre başlatıyoruz
        var query = db.TaskStatus.AsQueryable();

        if (TaskCategoriesId != null)
        {
            query = query.Where(t => t.TaskCategoriesId == TaskCategoriesId);
        }

        // Filtreleme mantığı:
        // 1. TaskKeeperJoint tablosunda bu görev (TaskId) için bir kayıt varsa:
        //    Joint tablosundaki UserId ile senin gönderdiğin userId eşleşmeli VE Joint'teki status tutmalı.
        // 2. Eğer TaskKeeperJoint'te hiç kayıt yoksa (else durumu):
        //    TaskStatus tablosundaki PersonInChargeUserId ile userId eşleşmeli VE TaskStatus'taki ana status tutmalı.

        return query.Where(t =>
                (db.TaskKeeperJoint.Any(kj => kj.TaskId == t.Id)
                    ? db.TaskKeeperJoint.Any(kj => kj.TaskId == t.Id && kj.UserId == use.Id && kj.Status == status)
                    : (t.PersonInChargeUserId == use.Id && t.Status == status))
            ).ToList();
    }







    private int GetTaskCountByStatus(string status, Guid? TaskCategoriesId)
    {
        if (TaskCategoriesId == null)
        {
            return tasks.Count(t => t.Status == status);
        }
        else
        {
            return tasks.Count(t => t.Status == status && t.TaskCategoriesId == TaskCategoriesId);
        }
    }
    #endregion
    #region Drag and Drop
    private void HandleDragStart(Guid taskId)
    {
        draggedTaskId = taskId;
