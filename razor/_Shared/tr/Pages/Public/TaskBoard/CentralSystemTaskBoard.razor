                    <div class="btn-group w-100" role="group">


                        <div class="d-inline-flex align-items-center bg-light p-2 rounded border">
                            <span id="math-question" class="me-2 fw-bold text-dark" style="min-width: 45px;"></span>

                            <input type="number" id="math-answer"
                                   class="form-control form-control-sm me-2 text-center"
                                   style="width: 60px;" placeholder="?">

                            <button type="button" id="delete-btn"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="DeleteTask"
                                    disabled>
                                @if (IsButtonProcessing("delete"))
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="fa fa-trash"></i>
                                }
                            </button>
                        </div>
                        <script>
                                                (function() {
                                                    let result;
                                                    // Blazor elementleri render ettikten sonra ID'lere ulaşmak için kısa bir gecikme gerekebilir
                                                    setTimeout(() => {
                                                        const questionEl = document.getElementById('math-question');
                                                        const answerInput = document.getElementById('math-answer');
                                                        const deleteBtn = document.getElementById('delete-btn');

                                                        if (!questionEl || !answerInput || !deleteBtn) return;

                                                        function generateNewQuestion() {
                                                            const ops = ['+', '-', '*'];
                                                            const n1 = Math.floor(Math.random() * 9) + 1;
                                                            const n2 = Math.floor(Math.random() * 9) + 1;
                                                            const op = ops[Math.floor(Math.random() * ops.length)];

                                                            questionEl.innerText = `${n1}${op}${n2}=`;

                                                            if (op === '+') result = n1 + n2;
                                                            if (op === '-') result = n1 - n2;
                                                            if (op === '*') result = n1 * n2;
                                                        }

                                                        answerInput.addEventListener('input', function() {
                                                            if (parseInt(this.value) === result) {
                                                                // Doğru cevap: Butonu aktifleştir ve yeşil yap
                                                                deleteBtn.disabled = false;
                                                                this.style.borderColor = "#198754";
                                                                this.style.backgroundColor = "#d4edda";
                                                            } else {
                                                                // Yanlış cevap: Butonu kilitli tut
                                                                deleteBtn.disabled = true;
                                                                this.style.borderColor = "";
                                                                this.style.backgroundColor = "";
                                                            }
                                                        });

                                                        generateNewQuestion();
                                                    }, 500); // 500ms render bekletme
                                                })();
                        </script>

                        @if (use?.UsersType == "Customer" || use?.UsersType == "SuperAdmin")
                        {
                            <button type="button" class="btn btn-outline-warning rounded-0" @onclick="() => EditTask(selectedTask)">
                                <i class="fa fa-edit"></i> Düzenle
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-warning rounded-0" disabled>
                                <i class="fa fa-edit"></i> Düzenle
                            </button>
                        }
                        <button type="button" class="btn btn-outline-light rounded-0" @onclick="CloseDetailModal">
                            Kapat
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

