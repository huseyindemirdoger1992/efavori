    // ✅ TAMAMEN BELLEK İÇİ. Artık kolon/kategori başına DB sorgusu YOK.
    // Veriler LoadData ile bir kez yüklenir; burada yalnızca filtreleme yapılır.
    // Kolon yerleşimi: görevde TaskKeeperJoint varsa katılımcının aşamasına,
    // yoksa görevin ana durumuna göre belirlenir (eski DB mantığının aynısı).
    private List<data._Tasks.TaskStatus> GetTasksByStatus(string status, Guid? taskCategoriesId, Guid? taskFrameworkId)
    {
        if (use == null) return new();

        IEnumerable<data._Tasks.TaskStatus> query = tasks;

        if (taskCategoriesId != null)
            query = query.Where(t => t.TaskCategoriesId == taskCategoriesId);

        query = query.Where(t =>
        {
            var joints = taskKeepers.Where(kj => kj.TaskId == t.Id).ToList();
            if (joints.Count > 0)
                return joints.Any(kj => kj.UserId == use.Id && kj.Status == status);
            return t.PersonInChargeUserId == use.Id && t.Status == status;
        });

        query = ApplyBoardFilters(query);
        return query.ToList();
    }

    // Arama + öncelik/tarih filtresini bellekte uygular.
    private IEnumerable<data._Tasks.TaskStatus> ApplyBoardFilters(IEnumerable<data._Tasks.TaskStatus> source)
    {
        var result = source;

        // Metin arama (başlık + açıklama), Türkçe kültürüne duyarlı
        if (!string.IsNullOrWhiteSpace(_SearchText))
        {
            var term = _SearchText.Trim().ToLower(_tr);
            result = result.Where(t =>
                (t.TaskTitle ?? string.Empty).ToLower(_tr).Contains(term) ||
                (t.TaskDescription ?? string.Empty).ToLower(_tr).Contains(term));
        }

        // Öncelik / tarih filtresi
        if (_activeFilter != "all")
        {
            var now = DateTime.Now;
            result = _activeFilter switch
            {
                "low" => result.Where(t => t.Priority == "Düşük"),
                "medium" => result.Where(t => t.Priority == "Orta"),
                "high" => result.Where(t => t.Priority == "Yüksek" || t.Priority == "Kritik"),
                "expired" => result.Where(t => t.TargetDate.HasValue && t.TargetDate.Value <= now),
                "1month" => result.Where(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalDays <= 30),
                "1week" => result.Where(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalDays <= 7),
                "1day" => result.Where(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalHours <= 24),
                "1hour" => result.Where(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalMinutes <= 60),
                _ => result
            };
        }

        return result;
    }

    // Aktif öncelik/tarih filtresini değiştir (Blazor tabanlı — JS yok)
    private void SetActiveFilter(string key)
    {
        _activeFilter = key;
        StateHasChanged();
    }

    // Kart bir filtre butonuna sürüklenirse önceliğini değiştir (eski HandleDropPri davranışı)
    private async Task HandleFilterDrop(string key)
    {
        var pri = key switch
        {
            "low" => "Düşük",
            "medium" => "Orta",
            "high" => "Yüksek",
            _ => null
        };
        if (pri != null)
            await HandleDropPri(pri);
    }

    // Filtre butonu rozet sayıları (arama uygulanmış tüm görevler üzerinden)
    private int GetFilterCount(string key)
    {
        var now = DateTime.Now;
        IEnumerable<data._Tasks.TaskStatus> src = tasks;

        if (!string.IsNullOrWhiteSpace(_SearchText))
        {
            var term = _SearchText.Trim().ToLower(_tr);
            src = src.Where(t =>
                (t.TaskTitle ?? string.Empty).ToLower(_tr).Contains(term) ||
                (t.TaskDescription ?? string.Empty).ToLower(_tr).Contains(term));
        }

        return key switch
        {
            "all" => src.Count(),
            "low" => src.Count(t => t.Priority == "Düşük"),
            "medium" => src.Count(t => t.Priority == "Orta"),
            "high" => src.Count(t => t.Priority == "Yüksek" || t.Priority == "Kritik"),
            "expired" => src.Count(t => t.TargetDate.HasValue && t.TargetDate.Value <= now),
            "1month" => src.Count(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalDays <= 30),
            "1week" => src.Count(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalDays <= 7),
            "1day" => src.Count(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalHours <= 24),
            "1hour" => src.Count(t => t.TargetDate.HasValue && t.TargetDate.Value > now && (t.TargetDate.Value - now).TotalMinutes <= 60),
            _ => 0
        };
    }

