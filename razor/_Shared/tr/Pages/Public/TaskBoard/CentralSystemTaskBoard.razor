@using data
@using data.Owned;
@using data._Carts;
@using data._Categories;
@using data._Follows;
@using data._Galleries;
@using data._Helper;
@using data._Locations;
@using data._Products;
@using data._Shares;
@using data._Store;
@using data._Systems;
@using data._Tasks;
@using data._Users;

@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using api
@using api.tr
@using razor._Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@code {
    [Inject] protected GlobalStateHub StateHub { get; init; } = default!;
}

@code {
    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<div class="container-fluid p-3">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">


                @{
                    // Sabit olan ilk 3 elemanı tanımlayalım
                    var roads = new List<(string icon, string Name, string Url)>
                                {
                                ("fa fa-globe", "efavori", "/"),
                                ("fa fa-th-large", "Görev Paneli", "javascript:void(0)")
                                };

                    // Dinamik kısımları belirleyelim
                    string lastIcon = "fa fa-list-ul";
                    string lastName = "";
                    string midName = "Görev Bölümleri"; // Varsayılan orta isim

                    // Durum kontrolü (Pattern Matching kullanarak)
                    switch (TaskCategoriesValue)
                    {
                        case "PlanningTaskBoard":
                            midName = "Görev Durumları";
                            lastName = "Plan Aşamasında";
                            break;
                        case "InProcessTaskBoard":
                            midName = "Görev Durumları";
                            lastIcon = "fa fa-refresh";
                            lastName = "Aktif Görevler";
                            break;
                        case "CompletedTaskBoard":
                            midName = "Görev Durumları";
                            lastIcon = "fa fa-check-circle-o";
                            lastName = "Tamamlananlar";
                            break;
                        default:
                            // Board değerleri dışında kalan durumlar (Senin ilk if-else mantığın)
                            if (TaskCategoriesValue == "All" && (TaskFrameworkId == null || TaskFrameworkId == Guid.Empty))
                            {
                                lastName = "Tüm Görev Bölümleriniz";
                            }
                            else
                            {
                                lastName = db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId)?.Title ?? "Yükleniyor...";
                            }
                            break;
                    }

                    // Listeyi tamamla
                    roads.Add(("fa fa-th-large", midName, "javascript:void(0)"));
                    roads.Add((lastIcon, lastName, "javascript:void(0)"));
                }

                <div>
                    <razor._Shared.BreadCrumbLinksUrl roads="roads" />
                </div>

                @if (use != null)
                {
                    <div class="btn-group" role="group" aria-label="İşlem Butonları">
                        <button type="button" class="btn btn-light btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#AddNewEpisodeModal">
                            <i class="fa fa-folder-open"></i> Yeni Bölüm
                        </button>
                        <div class="modal fade" id="AddNewEpisodeModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                                    <div class="modal-header border-bottom border-secondary">
                                        <h5 class="modal-title text-white">
                                            <i class="fa fa-folder-open"></i> Yeni Görev Bölümü
                                        </h5>

                                        <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                                            <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                                <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                                            </button>

                                            <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                                            <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                                <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                                            </button>
                                        </div>

                                    </div>
                                    <div class="modal-body row">

                                        <div class="col-md-6">
                                            <label class="form-label">İkon</label>
                                            <select class="form-select" @bind="tf.Icon">
                                                <razor._Shared.FaIcons />
                                            </select>
                                        </div>

                                        <div class="col-6">
                                            <label class="form-label">Bölüm Adı</label>
                                            <input class="form-control mb-3" type="text" @bind="tf.Title">
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Bölüm Açıklaması</label>
                                            <textarea class="form-control" rows="3" @bind="tf.Description"></textarea>
                                        </div>

                                    </div>
                                    <div class="modal-footer border-top border-secondary">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>

                                        <button type="button"
                                                class="@(IsButtonProcessing("LoginButton") ? "btn btn-light colored" : "btn btn-light")"
                                                @onclick='async () => await AddNewTaskFramewok()'
                                                disabled="@IsButtonProcessing("LoginButton")">
                                            <i class="fa @(IsButtonProcessing("LoginButton") ? "fa-refresh fa-spin" : "fa-book")"></i>
                                            <span>@(IsButtonProcessing("LoginButton") ? "Yükleniyor..." : "Bölümü Kaydet")</span>
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (db.TaskFramework.Any())
                        {
                            <button type="button" class="btn btn-light btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#AddNewCategoryModal">
                                <i class="fa fa-address-book"></i> Yeni Kategori
                            </button>
                        }
                        @if (db.TaskCategories.Any())
                        {
                            <button type="button" class="btn btn-light btn-sm"
                                    @onclick="() => ShowAddTaskModal()"
                                    disabled="@IsButtonProcessing("add")">
                                <i class="fa fa-tasks"></i> Yeni Görev
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="btn-group" role="group" aria-label="İşlem Butonları">
                        <button type="button" class="btn btn-light btn-sm">
                            <i class="fa fa-folder-open"></i> Yeni Bölüm
                        </button>
                        <button type="button" class="btn btn-light btn-sm">
                            <i class="fa fa-address-book"></i> Yeni Kategori
                        </button>
                        <button type="button" class="btn btn-light btn-sm">
                            <i class="fa fa-tasks"></i> Yeni Görev
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    @if (taskCategories == null || !taskCategories.Any())
    {
        if (use != null)
        {
            <div class="min-vh-50 d-flex justify-content-center align-items-center bg-light py-5">
                <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
                    <div class="card border-0 bg-transparent">
                        <div class="card-body p-3 p-md-5">

                            <div class="text-center mb-5">
                                <div class="position-relative d-inline-block">
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <i class="fa fa-circle-o-notch fa-spin fa-4x text-primary opacity-25"></i>
                                    </div>
                                    <i class="fa fa-database fa-3x text-primary position-relative"></i>
                                </div>
                            </div>

                            <div class="text-center mb-4">
                                <span class="badge bg-dark text-light p-2 text-uppercase shadow-sm" style="letter-spacing: 1px;">
                                    <i class="fa fa-sitemap me-1"></i> Hiyerarşi Oluşturma
                                </span>
                            </div>

                            <div class="list-group shadow-sm border-0 mb-4">
                                @if (db.TaskFramework.Any(x => x.UserId == use.Id))
                                {
                                    <div class="list-group-item bg-primary d-flex align-items-center py-3 border-bottom shadow-sm">
                                        <span class="badge bg-white text-primary rounded-pill me-3">
                                            <i class="fa fa-check"></i>
                                        </span>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0 text-white fw-bold">Bölüm</h6>
                                            <small class="text-white-50 d-block">Ana çalışma alanını belirleyin.</small>
                                        </div>
                                        <i class="fa fa-address-book-o text-white opacity-50"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group-item bg-light d-flex align-items-center py-3 border-bottom">
                                        <span class="badge bg-secondary rounded-pill me-3">1</span>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0 text-dark fw-bold">Bölüm</h6>
                                            <small class="text-muted d-block">Ana çalışma alanını belirleyin.</small>
                                        </div>
                                    </div>
                                }

                                @if (db.TaskCategories.Any(x => x.UserId == use.Id))
                                {
                                    <div class="list-group-item bg-light d-flex align-items-start py-3 border-bottom shadow-sm border-start border-primary border-4">
                                        <span class="badge bg-success rounded-pill me-3 mt-1">
                                            <i class="fa fa-check"></i>
                                        </span>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0 text-dark fw-bold">Kategori <i class="fa fa-address-book-o ms-1 opacity-50"></i></h6>
                                            <small class="text-muted d-block">İş yükü başarıyla gruplandırıldı.</small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group-item bg-light d-flex align-items-start py-3 border-bottom opacity-75">
                                        <span class="badge bg-primary rounded-pill me-3 mt-1">2</span>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0 text-dark fw-bold">Kategori</h6>
                                            <small class="text-muted d-block">İş yükünü gruplandırın.</small>
                                        </div>
                                    </div>
                                }

                                <div class="list-group-item bg-light d-flex align-items-start py-3">
                                    <span class="badge bg-primary rounded-pill me-3 mt-1">3</span>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 text-dark fw-bold">Görev</h6>
                                        <small class="text-muted d-block">Yapılacak işi tanımlayın.</small>
                                    </div>
                                </div>

                            </div>

                            <p class="text-center mb-4 small text-warning fst-italic">
                                * Yukarıdaki sıralamayı takip ederek kayıt oluşturabilirsiniz.
                            </p>

                            <div class="progress mb-4 shadow-sm" style="height: 8px; border-radius: 50px; background-color: #e9ecef;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                     role="progressbar"
                                     style="width: 100%; border-radius: 50px;">
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-3 rounded-4 shadow-sm border"
                                 style="background: linear-gradient(90deg, rgba(85, 42, 155, 0.03) 0%, rgba(83, 193, 237, 0.08) 100%);">
                                <div class="text-start">
                                    <small class="d-block text-muted fw-bold small-text">Durum:</small>
                                </div>
                                <div class="text-end">
                                    <i class="fa fa-refresh text-primary me-2 fa-spin-hover"></i>
                                    <small class="text-dark fw-bold">Veri Girişi Bekleniyor</small>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="container-fluid vh-50 d-flex justify-content-center align-items-center bg-light">
                <div class="col-12 col-md-8 col-lg-5">
                    <div class=" bg-transparent text-center">
                        <div class="card-body p-5">

                            <div class="position-relative mb-5">
                                <div class="position-absolute top-50 start-50 translate-middle">
                                    <i class="fa fa-circle-o-notch fa-spin fa-4x text-primary opacity-50"></i>
                                </div>
                                <i class="fa fa-user fa-3x text-primary position-relative"></i>
                            </div>

                            <h2 class="fw-light text-dark mb-1 tracking-tight">Kulanıcı Bulunamadı...</h2>
                            <hr />
                            <p class="text-light mb-4 small fw-medium text-uppercase tracking-widest" style="letter-spacing: 2px;">
                                Veri işleyebilmek için ilk olarak oturum açmalısınız.
                            </p>

                            <div class="progress mb-4 shadow-sm" style="height: 12px; border-radius: 50px; background-color: #e9ecef;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                     role="progressbar"
                                     style="width: 100%; border-radius: 50px;">
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-3 rounded-4 shadow-sm border bg-light"
                                 style="background: linear-gradient(90deg, rgba(85, 42, 155, 0.05) 0%, rgba(83, 193, 237, 0.05) 100%);">
                                <div class="text-start">
                                    <small class="d-block text-muted fw-bold">Durum:</small>
                                </div>
                                <div class="text-end">
                                    <i class="fa fa-refresh text-primary me-2"></i>
                                    <small class="text-dark fw-bold">Yetkisiz Erişim</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    }
    else
    {
        @if (TaskFrameworkId != null && TaskFrameworkId != Guid.Empty)
        {
            <div class="alert border-0 border-start border-2 border-white alert-dismissible fade show d-flex align-items-center justify-content-between">
                <div class="text-white">
                    <b>@db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId)?.Title</b> Bölümü için işlemler:
                </div>

                <div class="d-flex align-items-center ms-auto">
                    <button type="button" class="btn btn-link text-warning p-0 me-3" title="Düzenle" data-bs-toggle="modal" data-bs-target="#EditFramework">
                        <i class="fa fa-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-link text-danger p-0 me-3" title="Sil" data-bs-toggle="modal" data-bs-target="#TrashFramework">
                        <i class="fa fa-trash"></i>
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="position: static; padding: 0.5rem;"></button>
                </div>
            </div>
            <div class="modal fade" id="EditFramework" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                        <div class="modal-header border-bottom border-secondary">
                            <h5 class="modal-title text-white">
                                <i class="fa fa-edit"></i> Bölüm düzenleme işlemi
                            </h5>
                            <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                                <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                    <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                                </button>

                                <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                                <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                    <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                                </button>
                            </div>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <label class="form-label">İkon</label>
                                        <select class="form-select bg-light" @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Icon">
                                            <razor._Shared.FaIcons />
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Bölüm Adı</label>
                                        <input class="form-control bg-light" type="text"
                                               @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Title">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Bölüm Durumu</label> <select class="form-select bg-light" @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Statu">
                                        <option value="plan">Plan Aşamasında</option>
                                        <option value="aktif">Aktif Aşamasında</option>
                                        <option value="tamam">Tamamlandı</option>
                                    </select>
                                </div>
                            </div>

                            <br />

                            <div class="col-12">
                                <label class="form-label">Bölüm Açıklaması</label>
                                <textarea class="form-control bg-light" rows="3"
                                          @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Description"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                        <button type="button"
                                class="btn btn-light @(IsButtonProcessing("EditFramework") ? "colored" : "")"
                                @onclick='() => EditFramework(TaskFrameworkId)'
                                disabled="@IsButtonProcessing("EditFramework")">

                            <i class="fa @(IsButtonProcessing("EditFramework") ? "fa-refresh fa-spin" : "fa-save")"></i>
                            <span>
                                @(IsButtonProcessing("EditFramework") ? " Kaydediliyor..." : " Kaydet ve Kapat")
                            </span>
                        </button>
                    </div>


                </div>
            </div>
        </div>
        <div class="modal fade" id="TrashFramework" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                    <div class="modal-header border-bottom border-secondary">
                        <h5 class="modal-title text-white">
                            <i class="fa fa-trash"></i> Bölüm silme işlemi
                        </h5>
                        <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                            <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                                <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                            </button>

                            <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                            <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                                <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                            </button>
                        </div>
                    </div>

                    <div class="modal-body">
                        <div class="col-12">
                            <label class="form-label">Bölüm Adı</label>
                            <input class="form-control mb-3 bg-light" type="text"
                                   @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Title">
                        </div>

                        <div class="col-12">
                            <label class="form-label">Bölüm Açıklaması</label>
                            <textarea class="form-control bg-light" rows="3"
                                      @bind="db.TaskFramework.FirstOrDefault(x => x.Id == TaskFrameworkId).Description"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>

                        <button type="button"
                                class="@(IsButtonProcessing("TrashFramework") ? "btn btn-danger colored" : "btn btn-danger")"
                                @onclick='() => TrashFramework(TaskFrameworkId)'
                                disabled="@IsButtonProcessing("TrashFramework")">

                            <i class="fa @(IsButtonProcessing("TrashFramework") ? "fa-refresh fa-spin" : "fa-trash")"></i>

                            <span>
                                @(IsButtonProcessing("TrashFramework") ? "Siliniyor..." : "Çöp Kutusuna Taşı")
                            </span>
                        </button>

                    </div>
                </div>
            </div>
        </div>

    }






    <div class="w-100 mt-3">
        <div class="row g-1 d-flex flex-nowrap overflow-auto no-scrollbar align-items-center pb-2">

            <div class="col-auto flex-fill">
                <input type="radio" class="btn-check" name="priorityRadio" id="radioAll" value="all" checked autocomplete="off">
                <label class="btn btn-outline-light btn-sm w-100 py-1 shadow-sm custom-btn text-nowrap" for="radioAll">
                    <i class="fa fa-list me-1"></i> Tümü
                </label>
            </div>

            <div class="col-auto flex-fill" @ondrop="@(() => HandleDropPri("Düşük"))" @ondragover:preventDefault="true" @ondragenter:preventDefault="true">
                <input type="radio" class="btn-check" name="priorityRadio" id="radioLow" value="low" autocomplete="off">
                <label class="btn btn-outline-success btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="radioLow">
                    <i class="fa fa-arrow-circle-down me-1"></i> Düşük
                </label>
            </div>

            <div class="col-auto flex-fill" @ondrop="@(() => HandleDropPri("Orta"))" @ondragover:preventDefault="true" @ondragenter:preventDefault="true">
                <input type="radio" class="btn-check" name="priorityRadio" id="radioMedium" value="medium" autocomplete="off">
                <label class="btn btn-outline-warning btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="radioMedium">
                    <i class="fa fa-minus-circle me-1"></i> Orta
                </label>
            </div>

            <div class="col-auto flex-fill" @ondrop="@(() => HandleDropPri("Yüksek"))" @ondragover:preventDefault="true" @ondragenter:preventDefault="true">
                <input type="radio" class="btn-check" name="priorityRadio" id="radioHigh" value="high" autocomplete="off">
                <label class="btn btn-outline-danger btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="radioHigh">
                    <i class="fa fa-arrow-circle-up me-1"></i> Yüksek
                </label>
            </div>

            <div class="col-auto flex-fill">
                <input type="radio" class="btn-check" name="priorityRadio" id="dateMonth" value="1month" autocomplete="off">
                <label class="btn btn-outline-info btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateMonth">
                    <i class="fa fa-calendar-o me-1"></i> Son 1 Ay
                </label>
            </div>

            <div class="col-auto flex-fill">
                <input type="radio" class="btn-check" name="priorityRadio" id="dateWeek" value="1week" autocomplete="off">
                <label class="btn btn-outline-primary btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateWeek">
                    <i class="fa fa-hourglass-half me-1"></i> Son 1 Hafta
                </label>
            </div>

            <div class="col-auto flex-fill">
                <input type="radio" class="btn-check" name="priorityRadio" id="dateDay" value="1day" autocomplete="off">
                <label class="btn btn-outline-warning btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateDay">
                    <i class="fa fa-exclamation-circle me-1"></i> Son 1 Gün
                </label>
            </div>

            <div class="col-auto flex-fill">
                <input type="radio" class="btn-check" name="priorityRadio" id="dateHour" value="1hour" autocomplete="off">
                <label class="btn btn-outline-danger btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateHour">
                    <i class="fa fa-bolt me-1"></i> Son 1 Saat
                </label>
            </div>

            <!-- YENİ: Süre Doldu filtresi -->
            <div class="col-auto flex-fill">
                <input type="radio" class="btn-check" name="priorityRadio" id="dateExpired" value="expired" autocomplete="off">
                <label class="btn btn-outline-secondary btn-sm w-100 py-1 text-light shadow-sm custom-btn text-nowrap" for="dateExpired">
                    <i class="fa fa-ban me-1"></i> Süre Doldu
                </label>
            </div>

        </div>
