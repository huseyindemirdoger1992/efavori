<!-- Task Detail Modal -->
@if (showDetailModal && selectedTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
                <div class="modal-header border-bottom border-secondary">


                    <h5 class="modal-title text-white d-flex align-items-center">
                        <a type="button" class="btn btn-sm btn-outline-light me-2" title="Yazdır" href="/@culture/Public/TaskBoard/PrintTask/@selectedTask.Id" target="_blank">
                            <i class="fa fa-print" aria-hidden="true"></i>
                        </a>

                        <span class="fw-bold" style="font-size: 1.1rem;">@selectedTask.TaskTitle</span>
                    </h5>

                    <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                        <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                            <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                        </button>

                        <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                        <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat" @onclick="CloseDetailModal">
                            <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                        </button>
                    </div>
                    @*<button type="button" class="btn-close" @onclick="CloseDetailModal"></button>*@               
    </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Kategori:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetCategoryText(selectedTask.TaskCategoriesId)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Durum:</strong>
                            <span class="badge @GetStatusBadgeClass(selectedTask.Status)">
                                @GetStatusText(selectedTask.Status)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Öncelik:</strong>
                            <span class="badge @GetPriorityBadgeClass(selectedTask.Priority)">
                                @selectedTask.Priority
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-light">
                                <i class="fa fa-file-text-o me-1"></i> Açıklama:
                            </strong>
                            <span class="badge bg-light text-info border"
                                  style="cursor: pointer;"
                                  @onclick="() => CopyText(selectedTask.TaskDescription)"
                                  title="Panoya Kopyala">
                                <i class="fa fa-clipboard text-info"></i> Kopyala
                            </span>
                        </div>
                        <textarea class="form-control bg-light border-0 shadow-sm"
                              rows="3"
                              readonly>@(selectedTask.TaskDescription ?? "Açıklama yok")</textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Oluşturulma:</strong>
                            <p>@selectedTask.DateCreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Hedef Tarih:</strong>
                            <p>@(selectedTask.TargetDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Sorumlu Kişi:</strong>
                            <p>@GetUserName(selectedTask.PersonInChargeUserId)</p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Yeni Not Ekle:</strong></label>
                        @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin" || use?.UsersType == "Employee")
                        {
                            <textarea class="form-control" rows="2" @bind="newNote"></textarea>
                        }
                        else
                        {
                            <textarea class="form-control" rows="2" disabled></textarea>
                        }
                    </div>
                    <button type="button"
                            class="btn btn-outline-info btn-sm"
                            @onclick="AddNote"
                            disabled="@IsButtonProcessing("addNote")"
                            style="width: 100%;">
                        @if (IsButtonProcessing("addNote"))
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="fa fa-comments"></i>
                        }
                        Not Ekle
                    </button>
                    <hr class="my-3" />
                    @if (taskNotes != null && taskNotes.Any())
                    {
                        <div class="mb-3">
                            <strong>Notlar:</strong>
                            <div class="mt-2 px-1" style="max-height: 256px; overflow-y: auto;">
                                <input class="form-control mb-3" type="text" placeholder="Notlarda ara..." oninput="filterNotes()">
                                @foreach (var note in taskNotes.Where(n => n.TaskStatusId == selectedTask?.Id))
                                {
                                    <div class="card shadow-sm border-0 mb-2 bg-light bg-opacity-10" style="border-left: 3px solid #ffc107 !important;">
                                        <div class="card-body py-2 px-3">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="pt-1">
                                                    <input class="form-check-input shadow-none NoteCheck"
                                                           type="checkbox"
                                                           checked="@(note.IsTheNoteOk == true)"
                                                           @onchange="@(async (e) => await ToggleNoteCompletion(note.Id, (bool)e.Value))"
                                                           id="note-@note.Id"
                                                           style="cursor: pointer; width: 1rem; height: 1rem; border-color: rgba(255,255,255,0.2);">
                                                </div>

                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="text-warning fw-normal" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                <i class="fa fa-clock-o opacity-75"></i> @note.NoteCreatedAt?.ToString("dd.MM.yyyy HH:mm")
                                                            </span>
                                                        </div>

                                                        <div class="d-flex gap-2">
                                                            <button class="btn btn-link btn-sm p-0 text-light opacity-50 hover-opacity-100 shadow-none"
                                                                    title="Kopyala" @onclick="() => CopyText(note.Note)">
                                                                <i class="fa fa-clone" style="font-size: 0.85rem;"></i>
                                                            </button>

                                                            @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                                                            {
                                                                <button class="btn btn-link btn-sm p-0 text-info opacity-75 shadow-none"
                                                                        title="Düzenle" @onclick="() => EditNoteModalStatu(note)">
                                                                    <i class="fa fa-pencil" style="font-size: 0.85rem;"></i>
                                                                </button>
                                                                <button class="btn btn-link btn-sm p-0 text-danger opacity-75 shadow-none"
                                                                        @onclick="@(async () => await DeleteNote(note.Id))"
                                                                        title="Sil">
                                                                    <i class="fa fa-trash-o" style="font-size: 0.85rem;"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                    <p class="mb-0 text-break @(note.IsTheNoteOk == true ? "text-decoration-line-through opacity-50" : "text-light")"
                                                       style="font-size: 0.85rem; line-height: 1.5; font-weight: 300;">
                                                        @note.Note
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <style>
                                    .hover-opacity-100:hover {
                                        opacity: 1 !important;
                                        transition: 0.2s;
                                    }

                                    .form-check-input:checked {
                                        background-color: #ffc107;
                                        border-color: #ffc107;
                                    }

                                    .NoteCheck {
                                        margin-top: -2px;
                                    }
                                </style>
                                <script>
                                    document.querySelectorAll('input[name="priorityRadio"]').forEach(radio => {
                                        radio.addEventListener('change', function() {
                                            const selectedPriority = this.value;
                                            const taskCards = document.querySelectorAll('.task-card');
                                            const now = new Date();

                                            taskCards.forEach(card => {
                                                const badge = card.querySelector('.priority-badge');
                                                const priorityText = badge ? badge.textContent.trim().toLowerCase() : "";

                                                // Hedef tarihi al (data-target attribute'undan)
                                                const timerSpan = card.querySelector('span[data-target]');
                                                const targetDateStr = timerSpan ? timerSpan.getAttribute('data-target') : null;
                                                const targetDate = targetDateStr ? new Date(targetDateStr) : null;

                                                let isVisible = false;

                                                if (selectedPriority === "all") {
                                                    isVisible = true;
                                                } else if (selectedPriority === "low" && priorityText === "düşük") {
                                                    isVisible = true;
                                                } else if (selectedPriority === "medium" && priorityText === "orta") {
                                                    isVisible = true;
                                                } else if (selectedPriority === "high" && (priorityText === "yüksek" || priorityText === "kritik")) {
                                                    isVisible = true;
                                                } else if (selectedPriority === "1month" && targetDate) {
                                                    const diff = targetDate - now;
                                                    isVisible = diff > 0 && diff <= 30 * 24 * 60 * 60 * 1000;
                                                } else if (selectedPriority === "1week" && targetDate) {
                                                    const diff = targetDate - now;
                                                    isVisible = diff > 0 && diff <= 7 * 24 * 60 * 60 * 1000;
                                                } else if (selectedPriority === "1day" && targetDate) {
                                                    const diff = targetDate - now;
                                                    isVisible = diff > 0 && diff <= 24 * 60 * 60 * 1000;
                                                } else if (selectedPriority === "1hour" && targetDate) {
                                                    const diff = targetDate - now;
                                                    isVisible = diff > 0 && diff <= 60 * 60 * 1000;
                                                }

                                                card.style.display = isVisible ? "block" : "none";
                                            });
                                        });
                                    });
                                </script>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer p-0">
                    <div class="btn-group w-100" role="group">


                        <div class="d-inline-flex align-items-center bg-light p-2 rounded border">
                            <span id="math-question" class="me-2 fw-bold text-dark" style="min-width: 45px;"></span>

                            <input type="number" id="math-answer"
                                   class="form-control form-control-sm me-2 text-center"
                                   style="width: 60px;" placeholder="?">

                            <button type="button" id="delete-btn"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="DeleteTask"
                                    disabled>
                                @if (IsButtonProcessing("delete"))
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="fa fa-trash"></i>
                                }
                            </button>
                        </div>
                        <script>
                            (function () {
                                let result;
                                // Blazor elementleri render ettikten sonra ID'lere ulaşmak için kısa bir gecikme gerekebilir
                                setTimeout(() => {
                                    const questionEl = document.getElementById('math-question');
                                    const answerInput = document.getElementById('math-answer');
                                    const deleteBtn = document.getElementById('delete-btn');

                                    if (!questionEl || !answerInput || !deleteBtn) return;

                                    function generateNewQuestion() {
                                        const ops = ['+', '-', '*'];
                                        const n1 = Math.floor(Math.random() * 9) + 1;
                                        const n2 = Math.floor(Math.random() * 9) + 1;
                                        const op = ops[Math.floor(Math.random() * ops.length)];

                                        questionEl.innerText = `${n1}${op}${n2}=`;

                                        if (op === '+') result = n1 + n2;
                                        if (op === '-') result = n1 - n2;
                                        if (op === '*') result = n1 * n2;
                                    }

                                    answerInput.addEventListener('input', function () {
                                        if (parseInt(this.value) === result) {
                                            // Doğru cevap: Butonu aktifleştir ve yeşil yap
                                            deleteBtn.disabled = false;
                                            this.style.borderColor = "#198754";
                                            this.style.backgroundColor = "#d4edda";
                                        } else {
                                            // Yanlış cevap: Butonu kilitli tut
                                            deleteBtn.disabled = true;
                                            this.style.borderColor = "";
                                            this.style.backgroundColor = "";
                                        }
                                    });

                                    generateNewQuestion();
                                }, 500); // 500ms render bekletme
                            })();
                        </script>

                        @if (use?.UsersType == "Admin" || use?.UsersType == "SuperAdmin")
                        {
                            <button type="button" class="btn btn-outline-warning rounded-0" @onclick="() => EditTask(selectedTask)">
                                <i class="fa fa-edit"></i> Düzenle
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-warning rounded-0" disabled>
                                <i class="fa fa-edit"></i> Düzenle
                            </button>
                        }
                        <button type="button" class="btn btn-outline-light rounded-0" @onclick="CloseDetailModal">
                            Kapat
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

