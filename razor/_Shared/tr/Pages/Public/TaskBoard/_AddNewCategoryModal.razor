@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using api.tr
@using data
@using data._Shared
@using razor._Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
<div class="modal fade" id="AddNewCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-light border border-secondary" style="backdrop-filter: blur(10px); box-shadow: 0 0 5px rgba(13, 202, 240, 0.5);">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-white">
                    <i class="fa fa-address-book"></i> Yeni Görev Kategorisi
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">


                <div class="row">
                    <div class="col-md-6 mb-6">
                        <label class="form-label">Görev Bölümü</label>
                        <select class="form-select" @bind="TaskCategories.TaskFrameworkId">
                            <option value="">...</option>
                            @foreach (TaskFramework tf in db.TaskFramework.ToList())
                            {
                                <option value=@tf.Id>@tf.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-6">
                        <label class="form-label">Görev Durumu</label>
                        <select class="form-select" @bind="TaskCategories.CategoryStructure">
                            <option value="">...</option>
                            <option value="PlanningTaskBoard">Plan Aşamasında</option>
                            <option value="InProcessTaskBoard">Aktif Görev</option>
                            <option value=CompletedTaskBoard>Tamamlandı</option>
                        </select>
                    </div>
                    <div class="col-md-12 mb-12" style="margin-top:12px;">
                        <label class="form-label">Kategori Adı</label>
                        <input class="form-control mb-3" type="text" @bind="TaskCategories?.Title">
                    </div>
                    <div class="col-md-12 mb-12">
                        <label>Kategori Açıklaması</label>
                        <textarea class="form-control" rows="3" @bind="TaskCategories?.Description"></textarea>
                    </div>
                </div>


            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button"
                        class="@(IsButtonProcessing("addCategory") ? "btn btn-light colored" : "btn btn-light")"
                        style="width:100%;"
                        @onclick='AddNewCategori'
                        disabled="@IsButtonProcessing("addCategory")">
                    <i class="fa @(IsButtonProcessing("addCategory") ? "fa-refresh fa-spin" : "fa-plus")"></i>
                    <span>@(IsButtonProcessing("addCategory") ? "Yükleniyor..." : "Kaydet")</span>
                </button>
            </div>
        </div>
    </div>
</div>
<Notification @ref="notificationRef" />