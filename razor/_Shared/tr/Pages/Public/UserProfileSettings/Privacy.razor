<razor._Shared.BreadCrumbLinksUrl roads=roads />

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:300px;">
        <div class="spinner-border text-light" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
    </div>
}
else if (use != null && _privacy != null)
{
    <div class="container-fluid px-3 py-4">

        <!-- ════════════════════════════════════════
             SEKME 3 – GİZLİLİK & BİLDİRİMLER
        ════════════════════════════════════════ -->
        <div class="tab-pane fade show active" id="pane-basic" role="tabpanel">

            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
