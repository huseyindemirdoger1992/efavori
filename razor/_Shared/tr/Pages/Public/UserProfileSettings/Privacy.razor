                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @* ProfileVisibility artık UserProfiles üzerinde enum (Public/FollowersOnly/FriendsOnly/Private).
                           Basit toggle için Public ↔ FriendsOnly kullanılır. *@
                        @RenderPrivacySwitch("Profil Herkese Açık",
                            _profile?.ProfileVisibility == ProfileVisibility.Public,
                            v => { if (_profile != null) _profile.ProfileVisibility = (v == true) ? ProfileVisibility.Public : ProfileVisibility.FriendsOnly; }, "priv1")

                        @* DefaultPostVisibility: 1=Public, 2=FollowersOnly vb. *@
                        @RenderPrivacySwitch("Paylaşımlarımı Herkes Görebilir",
                            _privacy?.DefaultPostVisibility == 1,
                            v => { if (_privacy != null) _privacy.DefaultPostVisibility = (byte)((v == true) ? 1 : 2); }, "priv2")

                        @RenderPrivacySwitch("Son Görülmeyi Göster",
                            _privacy?.ShowLastSeen,
                            v => { if (_privacy != null) _privacy.ShowLastSeen = v == true; }, "priv3")

                        @RenderPrivacySwitch("Çevrimiçi Durumunu Göster",
                            _privacy?.ShowOnlineStatus,
                            v => { if (_privacy != null) _privacy.ShowOnlineStatus = v == true; }, "priv4")

                        @RenderPrivacySwitch("Arama Motorlarında Listelen",
                            _profile?.AllowSearchEngineIndexing,
                            v => { if (_profile != null) _profile.AllowSearchEngineIndexing = v == true; }, "priv5")
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-comments-o me-2 text-light"></i>İletişim &amp; Bağlantı
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @* WhoCanSendFriendRequest → PrivacyAudience enum; toggle Everyone ↔ NoOne *@
                        @RenderPrivacySwitch("Arkadaşlık İsteklerine İzin Ver",
                            _privacy?.WhoCanSendFriendRequest != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanSendFriendRequest = (v == true) ? PrivacyAudience.Everyone : PrivacyAudience.NoOne; }, "priv6")

                        @RenderPrivacySwitch("Doğrudan Mesajlara İzin Ver",
                            _privacy?.WhoCanMessage != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanMessage = (v == true) ? PrivacyAudience.Everyone : PrivacyAudience.NoOne; }, "priv7")

                        @RenderPrivacySwitch("Sesli Arama İzni",
                            _privacy?.WhoCanVoiceCall != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanVoiceCall = (v == true) ? PrivacyAudience.FriendsOnly : PrivacyAudience.NoOne; }, "priv8")

                        @RenderPrivacySwitch("Görüntülü Arama İzni",
                            _privacy?.WhoCanVideoCall != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanVideoCall = (v == true) ? PrivacyAudience.FriendsOnly : PrivacyAudience.NoOne; }, "priv9")

                        @RenderPrivacySwitch("Okundu Bilgisi (Mavi Tık)",
                            _privacy?.SendReadReceipts,
                            v => { if (_privacy != null) _privacy.SendReadReceipts = v == true; }, "priv10")
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-user-secret me-2 text-light"></i>Kişisel Bilgi Gizliliği
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @RenderPrivacySwitch("Konum Bilgimi Paylaş",
                            _privacy?.WhoCanSeeLocation != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanSeeLocation = (v == true) ? PrivacyAudience.FriendsOnly : PrivacyAudience.NoOne; }, "priv11")

                        @RenderPrivacySwitch("Takipçi Sayısını Göster",
                            _privacy?.ShowFollowerCount,
                            v => { if (_privacy != null) _privacy.ShowFollowerCount = v == true; }, "priv12")

                        @RenderPrivacySwitch("Takip Ettiğim Listeyi Göster",
                            _privacy?.WhoCanSeeFollowingList != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanSeeFollowingList = (v == true) ? PrivacyAudience.Everyone : PrivacyAudience.NoOne; }, "priv13")

                        @RenderPrivacySwitch("Takipçi Listemi Göster",
                            _privacy?.WhoCanSeeFollowerList != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanSeeFollowerList = (v == true) ? PrivacyAudience.Everyone : PrivacyAudience.NoOne; }, "priv14")
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-th-large me-2 text-light"></i>Etkileşim &amp; İçerik
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @RenderPrivacySwitch("Yorum Yapılmasına İzin Ver",
                            _privacy?.WhoCanComment != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanComment = (v == true) ? PrivacyAudience.Everyone : PrivacyAudience.NoOne; }, "priv15")

                        @RenderPrivacySwitch("Etiketlenmeye İzin Ver",
                            _privacy?.WhoCanTag != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanTag = (v == true) ? PrivacyAudience.FriendsOnly : PrivacyAudience.NoOne; }, "priv16")

                        @RenderPrivacySwitch("Paylaşımlarımın Paylaşılmasına İzin Ver",
                            _privacy?.WhoCanShareMyPosts != PrivacyAudience.NoOne,
                            v => { if (_privacy != null) _privacy.WhoCanShareMyPosts = (v == true) ? PrivacyAudience.Everyone : PrivacyAudience.NoOne; }, "priv17")

                        @RenderPrivacySwitch("İçerik İndirilmesine İzin Ver",
                            _privacy?.AllowContentDownload,
                            v => { if (_privacy != null) _privacy.AllowContentDownload = v == true; }, "priv18")
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-bell-o me-2 text-light"></i>Bildirimler
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @RenderPrivacySwitch("E-posta Bildirimleri",
                            _settings?.EmailNotificationsEnabled,
                            v => { if (_settings != null) _settings.EmailNotificationsEnabled = v == true; }, "priv19")

                        @RenderPrivacySwitch("Uygulama (Push) Bildirimleri",
                            _settings?.PushNotificationsEnabled,
                            v => { if (_settings != null) _settings.PushNotificationsEnabled = v == true; }, "priv20")

                        @RenderPrivacySwitch("SMS Bildirimleri",
                            _settings?.SmsNotificationsEnabled,
                            v => { if (_settings != null) _settings.SmsNotificationsEnabled = v == true; }, "priv21")
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-database me-2 text-light"></i>Veri &amp; Reklam Politikası
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @RenderPrivacySwitch("Kişiselleştirilmiş Reklamlar",
                            _settings?.PersonalizedAdsEnabled,
                            v => { if (_settings != null) _settings.PersonalizedAdsEnabled = v == true; }, "priv22")

                        @RenderPrivacySwitch("Anonim Veri Toplanmasına İzin Ver",
                            _settings?.AnalyticsCollectionAllowed,
                            v => { if (_settings != null) _settings.AnalyticsCollectionAllowed = v == true; }, "priv23")

                        @RenderPrivacySwitch("Yapay Zeka Eğitimine İzin Ver",
                            _settings?.AiTrainingAllowed,
                            v => { if (_settings != null) _settings.AiTrainingAllowed = v == true; }, "priv24")
                    </div>
                </div>
            </div>

            <div class="text-end">
                <button class="btn btn-dark btn-sm px-4"
                        @onclick="SavePrivacySettings" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="fa fa-save me-1"></i> Kaydet
                </button>
            </div>
        </div>
    </div>
}
<!-- [1] Profil Görseli Modal -->
<div class="modal fade" id="modalProfileList" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark border border-light-3">
            <div class="modal-header border-light-3">
                <h6 class="modal-title text-white">
                    <i class="fa fa-user-circle me-2 text-info"></i>Profil Görseli Seç
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded overflow-hidden" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 d-flex align-items-center justify-content-center"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran" style="padding: 0.5rem 0.75rem;">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>

                    <div class="vr bg-secondary my-1" style="width: 1px; opacity: 0.5;"></div>

                    <button type="button" class="btn btn-sm border-0 d-flex align-items-center justify-content-center"
                            data-bs-dismiss="modal" @onclick="CloseMediaModal" style="padding: 0.5rem 0.75rem;">
                        <span class="btn-close btn-close-white" style="font-size: 0.65rem; padding: 0;"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <Upload use="use" />
                <hr class="border-light-3 my-3" />
                @if (_activeMediaSlot == "profile")
                {
                    <List use="use" IsMultiSelect="false" />
                }
            </div>
        </div>
    </div>
</div>

