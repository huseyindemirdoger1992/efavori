@code {

    private const string PAGE = "ProfileEdit";

    private Users? _use;

    [Parameter]
    public Users? use
    {
        get => _use;
        set
        {
            _use = value;
        }
    }

    /// <summary>
    /// Kullanıcının gizlilik ayarları (UserPrivacySettings — 1:1).
    /// Eski IsPrivateOrPublic owned type'ı kaldırıldı; tüm "WhoCan..." ve görünürlük
    /// ayarları artık bu ayrı entity'dedir. Navigation property kullanılmaz.
    /// </summary>
    private UserPrivacySettings? _privacy;

    /// <summary>
    /// Kullanıcının profil kaydı (UserProfiles — 1:1).
    /// ProfileVisibility ve AllowSearchEngineIndexing burada.
    /// </summary>
    private UserProfiles? _profile;

    /// <summary>
    /// Kullanıcının tercihleri (UserSettings — 1:1).
    /// Bildirim ana anahtarları ve veri/reklam politikası burada.
    /// </summary>
    private UserSettings? _settings;

    private readonly CancellationTokenSource _cts = new();
    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _disposed;
    private bool _isInitialized;
    private bool _isLoading;
    private bool _isProcessing;
    private CancellationTokenSource? _searchCts;

    private string _activeMediaSlot = string.Empty;
    // Tekli seçimler
    private data._Galleries.Media? _profileMedia;
    private data._Galleries.Media? _coverMedia;

    private List<Users> Users { get; set; } = new();
    private List<Country> _Countries = new();
    private List<States> _States = new();
    private List<Cities> _Cities = new();

    private string? _currentPassword;
    private string? _newPassword;
    private string? _confirmPassword;

    private Notification? notificationRef;

    // ────────────────────────────────────────────────────────────────
    // RENDER HELPERS
    // ────────────────────────────────────────────────────────────────

    private void CloseMediaModal()
    {
        // Modal kapanınca slot sıfırlanır → List component DOM'dan kaldırılır
        // → FileService event'leri artık hiçbir List'e ulaşamaz.
        _activeMediaSlot = string.Empty;
    }

    // ─── Tekli Seçim Handler ────────────────────────────────────────────────
    private void HandleSingleFileSelected(data._Galleries.Media media)
    {
        switch (_activeMediaSlot)
        {
            case "profile": _profileMedia = media; break;
            case "cover": _coverMedia = media; break;

            default: break;
        }
        InvokeAsync(StateHasChanged);
    }


    /// <summary>
    /// Sosyal medya satırı: metin input + "Herkese Açık" toggle
    /// </summary>
    private RenderFragment RenderSocialField(
        string icon, string label,
        string? value, Action<string?> onValueChange,
        bool isActive, Action<bool?> onActiveChange,
        string switchId) => __builder =>
    {
        <div class="col-md-6">
            <label class="form-label  small fw-semibold">
                <i class="@icon me-1"></i>@label
            </label>
            <input type="text" class="form-control "
                   value="@value"
                   @onchange="e => onValueChange(e.Value?.ToString())"
                   placeholder="@label kullanıcı adı veya URL" />
            <div class="form-check form-switch mt-1">
                <input class="form-check-input" type="checkbox" id="@switchId"
                       checked="@isActive"
                       @onchange="e => onActiveChange((bool?)e.Value)" />
                <label class="form-check-label small " for="@switchId">Herkese Açık</label>
            </div>
        </div>
    };

    /// <summary>
    /// Gizlilik toggle kartı
    /// </summary>
    private RenderFragment RenderPrivacySwitch(
        string label,
        bool? value,
        Action<bool?> onChange,
        string switchId) => __builder =>
    {
        <div class="col-md-6 col-lg-4">
            <div class="d-flex align-items-center justify-content-between  rounded p-2 border">
                <label class="form-check-label small mb-0" for="@switchId">@label</label>
                <div class="form-check form-switch mb-0 ms-2">
                    <input class="form-check-input" type="checkbox" id="@switchId"
                           checked="@(value == true)"
                           @onchange="e => onChange((bool?)e.Value)" />
                </div>
            </div>
        </div>
    };

    // ────────────────────────────────────────────────────────────────
    // LIFECYCLE
    // ────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        FileService.OnFileSelected += HandleSingleFileSelected;
        StateHub.OnDataChanged += HandleGlobalDataChange;
        await LoadData(null);
        await LoadPrivacyData();
    }

    /// <summary>
    /// Gizlilik sayfasının ihtiyaç duyduğu 3 ayrı entity'yi yükler.
    /// Navigation property kullanılmaz; her biri UserId FK ile ayrı sorgu.
    /// </summary>
    private async Task LoadPrivacyData()
    {
        if (use is null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            _privacy = await db.UserPrivacySettings
                .FirstOrDefaultAsync(p => p.UserId == use.Id
                    && (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true));
            _privacy ??= new UserPrivacySettings { UserId = use.Id };

            _profile = await db.UserProfiles
                .FirstOrDefaultAsync(p => p.UserId == use.Id
                    && (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true));
            _profile ??= new UserProfiles { UserId = use.Id };

            _settings = await db.UserSettings
                .FirstOrDefaultAsync(s => s.UserId == use.Id
                    && (s.IsDeleted == null || s.IsDeleted.IsDeletedStatu != true));
            _settings ??= new UserSettings { UserId = use.Id };
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadPrivacyData",
                exception: ex.Message, stackTrace: ex.StackTrace);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleGlobalDataChange;
        await _cts.CancelAsync();
        _cts.Dispose();
        _writeLock.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;
        if (entityName != "Users") return;

        await InvokeAsync(async () =>
        {
            await LoadData(null);
            StateHasChanged();
        });
    }

    // ────────────────────────────────────────────────────────────────
    // DATA LOADING
    // ────────────────────────────────────────────────────────────────

    protected virtual async Task LoadData(string? search)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(1000, token);

            if (_isLoading) return;
            _isLoading = true;

            // Ülke listesi
            using var db = await DbFactory.CreateDbContextAsync();
            _Countries = await db.Country.AsNoTracking().OrderBy(c => c.name).ToListAsync();
            StateHasChanged();

            // Kullanıcılar (RAM cache — 5 sn)
            var result = await StateHub.GetOrLoadAsync("ProfileEdit_Main", async () =>
            {
                await using var db2 = await DbFactory.CreateDbContextAsync(token);
                var query = db2.Users.AsNoTracking()
                    .Where(u => u.AccountStatus == UserAccountStatus.Active);

                if (!string.IsNullOrWhiteSpace(search))
                {
                    var matchedUserIds = db2.UserProfiles.AsNoTracking()
                        .Where(p => p.FirstName != null && p.FirstName.Contains(search)
                                 || p.LastName != null && p.LastName.Contains(search))
                        .Select(p => p.UserId);
                    query = query.Where(u => matchedUserIds.Contains(u.Id));
                }

                var users = await query
                    .OrderByDescending(u => u.RegistrationDateUtc)
                    .ToListAsync(token);

                return new { Users = users };
            }, token);

            if (result != null && !token.IsCancellationRequested)
                Users = result.Users;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData",
                exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    // ────────────────────────────────────────────────────────────────
    // KONUM CASCADE
    // ────────────────────────────────────────────────────────────────

    protected async Task OnCountrySelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int countryId);
        _States.Clear();
        _Cities.Clear();

        if (countryId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _States = await db.States.AsNoTracking()
                .Where(s => s.country_id == countryId)
                .OrderBy(s => s.name)
                .ToListAsync();
        }
        StateHasChanged();
    }

    protected async Task OnStateSelected(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int stateId);
        _Cities.Clear();

        if (stateId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _Cities = await db.Cities.AsNoTracking()
                .Where(c => c.state_id == stateId)
                .OrderBy(c => c.name)
                .ToListAsync();
        }
        StateHasChanged();
    }

    // ────────────────────────────────────────────────────────────────
    // RESİM YÜKLEME
    // ────────────────────────────────────────────────────────────────

    private async Task OnProfileImageChanged(InputFileChangeEventArgs e)
    {
        // TODO: Dosyayı sunucuya yükle → UserProfiles.AvatarMediaId güncelle (§72)
        await ShowNotification("info", "Bilgi", "Profil fotoğrafı yükleme işlemi yapılacak.", null);
    }

    private async Task OnCoverImageChanged(InputFileChangeEventArgs e)
    {
        // TODO: Dosyayı sunucuya yükle → UserProfiles.CoverMediaId güncelle (§72)
        await ShowNotification("info", "Bilgi", "Kapak fotoğrafı yükleme işlemi yapılacak.", null);
    }

    // ────────────────────────────────────────────────────────────────
    // KAYDETME İŞLEMLERİ
    // ────────────────────────────────────────────────────────────────

    private async Task SaveBasicInfo()
    {
        if (!await _writeLock.WaitAsync(0)) return;
        _isProcessing = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Users.Update(use!);
            await db.SaveChangesAsync();
            StateHub.ClearCache("ProfileEdit_Main"); // GlobalStateHub.ClearCache(string)
            await ShowNotification("success", "Başarılı", "Temel bilgiler kaydedildi.", null);
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "SaveBasicInfo",
                exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Kaydedilirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
            _writeLock.Release();
            StateHasChanged();
        }
    }

