    private async Task ChangePassword()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) ||
            string.IsNullOrWhiteSpace(_newPassword) ||
            _newPassword != _confirmPassword)
        {
            await ShowNotification("warning", "Uyarı",
                "Şifreler eşleşmiyor veya alanlar boş bırakıldı.", null);
            return;
        }
        // TODO: _currentPassword → hash doğrulama, _newPassword → hashleyip kaydet
        await ShowNotification("success", "Başarılı", "Şifreniz güncellendi.", null);
        _currentPassword = _newPassword = _confirmPassword = null;
    }

    private async Task FreezeAccount()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            "Hesabınızı dondurmak istediğinizden emin misiniz?");
        if (!confirmed) return;

        use!.AccountStatus = UserAccountStatus.Deactivated;
        use.AccountStatusChangedAtUtc = DateTime.UtcNow;
        await SaveBasicInfo();
    }

    private async Task DeleteAccount()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            "Bu işlem GERİ ALINAMAZ! Hesabınızı kalıcı olarak silmek istediğinizden emin misiniz?");
        if (!confirmed) return;

        use!.AccountStatus = UserAccountStatus.PendingDeletion;
        use.AccountStatusChangedAtUtc = DateTime.UtcNow;
        use.DeletionRequestedAtUtc = DateTime.UtcNow;
        await SaveBasicInfo();
    }

