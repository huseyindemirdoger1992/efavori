                        @RenderSocialField("fa fa-twitter", "X (Twitter)",
                                            _profile!.ContactInformation!.X, v => _profile!.ContactInformation!.X = v,
                                            _profile!.ContactInformation!.IsActiveX == true, v => _profile!.ContactInformation!.IsActiveX = v, "chkX")
                        @RenderSocialField("fa fa-youtube-play", "YouTube",
                                            _profile!.ContactInformation!.YouTube, v => _profile!.ContactInformation!.YouTube = v,
                                            _profile!.ContactInformation!.IsActiveYouTube == true, v => _profile!.ContactInformation!.IsActiveYouTube = v, "chkYt")
                        @RenderSocialField("fa fa-linkedin-square", "LinkedIn",
                                            _profile!.ContactInformation!.Linkedin, v => _profile!.ContactInformation!.Linkedin = v,
                                            _profile!.ContactInformation!.IsActiveLinkedin == true, v => _profile!.ContactInformation!.IsActiveLinkedin = v, "chkLi")
                        @RenderSocialField("fa fa-whatsapp", "WhatsApp",
                                            _profile!.ContactInformation!.WhatsApp, v => _profile!.ContactInformation!.WhatsApp = v,
                                            _profile!.ContactInformation!.IsActiveWhatsApp == true, v => _profile!.ContactInformation!.IsActiveWhatsApp = v, "chkWa")
                        @RenderSocialField("fa fa-paper-plane-o", "Telegram",
                                            _profile!.ContactInformation!.Telegram, v => _profile!.ContactInformation!.Telegram = v,
                                            _profile!.ContactInformation!.IsActiveTelegram == true, v => _profile!.ContactInformation!.IsActiveTelegram = v, "chkTg")
                        @RenderSocialField("fa fa-music", "TikTok",
                                            _profile!.ContactInformation!.TikTok, v => _profile!.ContactInformation!.TikTok = v,
                                            _profile!.ContactInformation!.IsActiveTikTok == true, v => _profile!.ContactInformation!.IsActiveTikTok = v, "chkTt")
                    </div>
