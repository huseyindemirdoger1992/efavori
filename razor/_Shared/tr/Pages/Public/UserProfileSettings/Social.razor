                                       placeholder="5XX XXX XX XX" />
                            </div>
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="chkPhoneActive"
                                       checked="@(_profile!.ContactInformation!.IsActivePhoneNumber == true)"
                                       @onchange="e => _profile!.ContactInformation!.IsActivePhoneNumber = (bool?)e.Value" />
                                <label class="form-check-label small " for="chkPhoneActive">
                                    Herkese Açık
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label  small fw-semibold">Kişisel Web Sitesi</label>
                            <div class="input-group">
                                <span class="input-group-text ">
                                    <i class="fa fa-globe text-light"></i>
                                </span>
                                <input type="url" class="form-control "
                                       @bind="_profile!.ContactInformation!.UserWebSite"
                                       placeholder="https://..." />
                            </div>
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="chkWebActive"
                                       checked="@(_profile!.ContactInformation!.IsActiveUserWebSite == true)"
                                       @onchange="e => _profile!.ContactInformation!.IsActiveUserWebSite = (bool?)e.Value" />
                                <label class="form-check-label small " for="chkWebActive">
                                    Herkese Açık
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Global Platformlar -->
            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-share-alt me-2 text-light"></i>Global Platformlar
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @RenderSocialField("fa fa-facebook-square", "Facebook",
                        _profile!.ContactInformation!.Facebook, v => _profile!.ContactInformation!.Facebook = v,
                                        _profile!.ContactInformation!.IsActiveFacebook == true, v => _profile!.ContactInformation!.IsActiveFacebook = v, "chkFb")
                        @RenderSocialField("fa fa-instagram", "Instagram",
                                            _profile!.ContactInformation!.Instagram, v => _profile!.ContactInformation!.Instagram = v,
