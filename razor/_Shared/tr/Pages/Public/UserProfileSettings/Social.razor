                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-envelope-o me-2 text-light"></i>E-posta, Telefon &amp; Web
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label  small fw-semibold">E-posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text ">
                                    <i class="fa fa-envelope-o text-light"></i>
                                </span>
                                <input type="email" class="form-control "
                                       @bind="_profile!.ContactInformation!.Email"
                                       placeholder="ornek@email.com" />
                            </div>
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="chkEmailActive"
