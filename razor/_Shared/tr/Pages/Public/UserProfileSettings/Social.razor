            </div>

            <!-- Bölgesel & Profesyonel -->
            <div class="card border-0 shadow-sm bg-light mb-3">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-map me-2 text-light"></i>Bölgesel &amp; Profesyonel Platformlar
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @RenderSocialField("fa fa-github", "GitHub",
                                            _profile!.ContactInformation!.GitHub, v => _profile!.ContactInformation!.GitHub = v,
                                            _profile!.ContactInformation!.IsActiveGitHub == true, v => _profile!.ContactInformation!.IsActiveGitHub = v, "chkGh")
                        @RenderSocialField("fa fa-pinterest", "Pinterest",
                                            _profile!.ContactInformation!.Pinterest, v => _profile!.ContactInformation!.Pinterest = v,
                                            _profile!.ContactInformation!.IsActivePinterest == true, v => _profile!.ContactInformation!.IsActivePinterest = v, "chkPin")
                        @RenderSocialField("fa fa-reddit", "Reddit",
                                            _profile!.ContactInformation!.Reddit, v => _profile!.ContactInformation!.Reddit = v,
                                            _profile!.ContactInformation!.IsActiveReddit == true, v => _profile!.ContactInformation!.IsActiveReddit = v, "chkRed")
                        @RenderSocialField("fa fa-comment", "Discord",
                                            _profile!.ContactInformation!.Discord, v => _profile!.ContactInformation!.Discord = v,
                                            _profile!.ContactInformation!.IsActiveDiscord == true, v => _profile!.ContactInformation!.IsActiveDiscord = v, "chkDis")
                        @RenderSocialField("fa fa-paint-brush", "Behance",
                                            _profile!.ContactInformation!.Behance, v => _profile!.ContactInformation!.Behance = v,
                                            _profile!.ContactInformation!.IsActiveBehance == true, v => _profile!.ContactInformation!.IsActiveBehance = v, "chkBeh")
                        @RenderSocialField("fa fa-weixin", "WeChat",
                                            _profile!.ContactInformation!.WeChat, v => _profile!.ContactInformation!.WeChat = v,
                                            _profile!.ContactInformation!.IsActiveWeChat == true, v => _profile!.ContactInformation!.IsActiveWeChat = v, "chkWc")
                        @RenderSocialField("fa fa-rss", "Weibo",
                                            _profile!.ContactInformation!.Weibo, v => _profile!.ContactInformation!.Weibo = v,
                                            _profile!.ContactInformation!.IsActiveWeibo == true, v => _profile!.ContactInformation!.IsActiveWeibo = v, "chkWb")
                        @RenderSocialField("fa fa-vk", "VKontakte",
                                            _profile!.ContactInformation!.VKontakte, v => _profile!.ContactInformation!.VKontakte = v,
                                            _profile!.ContactInformation!.IsActiveVKontakte == true, v => _profile!.ContactInformation!.IsActiveVKontakte = v, "chkVk")
                        @RenderSocialField("fa fa-line-chart", "Line",
                                            _profile!.ContactInformation!.Line, v => _profile!.ContactInformation!.Line = v,
                                            _profile!.ContactInformation!.IsActiveLine == true, v => _profile!.ContactInformation!.IsActiveLine = v, "chkLine")
                        @RenderSocialField("fa fa-commenting", "KakaoTalk",
                                            _profile!.ContactInformation!.KakaoTalk, v => _profile!.ContactInformation!.KakaoTalk = v,
                                            _profile!.ContactInformation!.IsActiveKakaoTalk == true, v => _profile!.ContactInformation!.IsActiveKakaoTalk = v, "chkKk")
                    </div>
                </div>
            </div>

            <div class="text-end">
                <button class="btn btn-dark btn-sm px-4"
                        @onclick="SaveContactInfo" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
