<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>Silme İşlemi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-white-50 small mb-3">Bu adresi silmek istediğinizden emin misiniz?</p>
                @if (_deleteTarget != null)
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Adres Adı</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(_deleteTarget.AddressName ?? "—")" disabled />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-user me-1"></i>Alıcı</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@($"{_deleteTarget.DeliveryReceiverFirstName} {_deleteTarget.DeliveryReceiverLastName}".Trim())" disabled />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(Decrypt(_deleteTarget.Country) ?? "—")" disabled />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(Decrypt(_deleteTarget.State) ?? "—")" disabled />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   value="@(Decrypt(_deleteTarget.Cities) ?? "—")" disabled />
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="DeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>Evet, Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Toplu Sil Onayı (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="BulkDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-danger"
             style="box-shadow:0 0 8px rgba(220,53,69,0.35);">

            <div class="modal-header border-bottom border-danger py-2">
                <h6 class="modal-title text-danger mb-0">
                    <i class="fa fa-trash-o me-2"></i>
                    Toplu Silme — @_selectedIds.Count kayıt seçildi
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <p class="text-warning small mb-3">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    Aşağıdaki <strong>@_selectedIds.Count</strong> adres kalıcı olarak silinecek. Bu işlem geri alınamaz.
                </p>

                @if (_bulkDeletePreview.Any())
                {
                    <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                        <table class="table table-sm table-dark table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th class="small">#</th>
                                    <th class="small">Adres Adı</th>
                                    <th class="small">Alıcı</th>
                                    <th class="small">Ülke</th>
                                    <th class="small">İl / Şehir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int n = 1;
                                }
                                @foreach (var item in _bulkDeletePreview)
                                {
                                    <tr>
                                        <td class="small text-light">@(n++)</td>
                                        <td class="small">@(item.AddressName ?? "—")</td>
                                        <td class="small">@($"{item.DeliveryReceiverFirstName} {item.DeliveryReceiverLastName}".Trim())</td>
                                        <td class="small">@(Decrypt(item.Country) ?? "—")</td>
                                        <td class="small">@(Decrypt(item.State) ?? "—") / @(Decrypt(item.Cities) ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer border-top border-danger py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"
                        @onclick="() => _bulkDeletePreview.Clear()">
                    <i class="fa fa-arrow-left me-1"></i>Vazgeç
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        @onclick="BulkDeleteConfirmedAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Siliniyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-trash me-1"></i><span>@_selectedIds.Count Adresi Sil</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   CODE BLOCK
   ═══════════════════════════════════════════ *@
@code {

    // ─── Sabitler ────────────────────────────────────────────────
    private const string PAGE_TITLE = "Adres Yönetimi";
    private const string ENTITY_NAME = "UserAddress";
    private const string CACHE_KEY = "UserAddress_List";
    private const int SEARCH_DELAY = 500;
    private const int PAGE_SIZE = 5;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _isInitialized;

    // ─── İptal zincirleri ─────────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchCts;

    // ─── Yazma kilidi ─────────────────────────────────────────────
    private readonly SemaphoreSlim _writeLock = new(1, 1);

    // ─── UI durumu ────────────────────────────────────────────────
    private bool _isLoading;
    private bool _isProcessing;
    private string _searchTerm = string.Empty;
    private Notification? _notificationRef;

    // ─── Veriler ──────────────────────────────────────────────────
    private List<UserAddressMethod> _allItems = new();
    private List<Country> _countries = new();

    // ─── Sayfalama ────────────────────────────────────────────────
    private int _currentPage = 1;
    private int _totalPages = 1;
    private List<UserAddressMethod> _pagedItems = new();

    // ─── Ekle modal state ─────────────────────────────────────────
    private UserAddressMethod? _addModel;
    private int _addCountryId;
    private int _addStateId;
    private List<States> _addStates = new();
    private List<Cities> _addCities = new();

    // ─── Düzenle modal state ──────────────────────────────────────
    private UserAddressMethod? _editModel;
    private int _editCountryId;
    private int _editStateId;
    private List<States> _editStates = new();
    private List<Cities> _editCities = new();

    // ─── Sil modal state ──────────────────────────────────────────
    private UserAddressMethod? _deleteTarget;

    // ─── Toplu Sil state ──────────────────────────────────────────
    private readonly HashSet<Guid> _selectedIds = new();
    private bool _allSelected;
    private List<UserAddressMethod> _bulkDeletePreview = new();

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI: Şifre çöz (null-safe, hata durumunda orijinal döner)
    // ══════════════════════════════════════════════════════════════

    private static string? Decrypt(string? value)
    {
        if (string.IsNullOrEmpty(value)) return value;
        var result = GlobalSecurityProvider.Decrypt(value);
        // Hata mesajı kontrolü: şifrelenmemiş eski veri de okunabilsin
        return result?.StartsWith("Hata:") == true ? value : result;
    }

    // ══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;

        // use parametresi gelmeden veri çekilmesin (UserId zorunlu)
        if (use == null) return;

        await Task.WhenAll(
            LoadDataAsync(_searchTerm),
            LoadCountriesAsync()
        );
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    // ══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized || entityName != ENTITY_NAME) return;

        await InvokeAsync(async () =>
        {
            await LoadDataAsync(_searchTerm);
            StateHasChanged();
        });
    }

    // ══════════════════════════════════════════════════════════════
    // VERİ YÜKLEME
    // ══════════════════════════════════════════════════════════════

    private async Task LoadDataAsync(string? search)
    {
        if (use == null) return;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(SEARCH_DELAY, token);

            if (token.IsCancellationRequested) return;

            _isLoading = true;
            StateHasChanged();

            // Arama varsa cache kullanma — her sorguda taze veri
            // Cache anahtarı kullanıcıya özel (multi-tenant güvenliği)
            string baseKey = $"{CACHE_KEY}_{use.Id}";
            string cacheKey = string.IsNullOrWhiteSpace(search) ? baseKey : $"{baseKey}_{search}";
            if (!string.IsNullOrWhiteSpace(search))
                StateHub.ClearCache(cacheKey);

            var userId = use.Id;

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);
                var q = db.UserAddressMethod.AsNoTracking()
                    .Where(x => x.UserId == userId); // Sadece bu kullanıcının adresleri

                // Soft delete: silinmemiş kayıtları getir
                // (IsDeleted owned entity'si hiç set edilmemiş eski kayıtlar da dahil)
                q = q.Where(x => x.IsDeleted == null
                              || x.IsDeleted.IsDeletedStatu == null
                              || x.IsDeleted.IsDeletedStatu == false);

                // Arama: şifreli alanlar DB'de şifreli olduğundan
                // tam liste çekilip bellek içi filtreleme yapılır.
                // (Ülke/il/şehir şifreli — DB'de LIKE çalışmaz)
                // Varsayılan adres önce, sonra en yeni tarih
                return await q.OrderByDescending(x => x.IsDefault)
                              .ThenByDescending(x => x.CreatedDate)
                              .ToListAsync(token);
            }, token);

            if (token.IsCancellationRequested || result == null) return;

            // Bellek içi arama (şifreli alanlar çözülerek)
            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim();
                result = result.Where(x =>
                    Contains(x.AddressName, s) ||
                    Contains(x.AddressType, s) ||
                    Contains(x.DeliveryReceiverFirstName, s) ||
                    Contains(x.DeliveryReceiverLastName, s) ||
                    Contains(x.DeliveryReceiverEmail, s) ||
                    Contains(x.DeliveryReceiverPhoneNumber, s) ||
                    Contains(Decrypt(x.Country), s) ||
                    Contains(Decrypt(x.State), s) ||
                    Contains(Decrypt(x.Cities), s) ||
                    Contains(x.FullAddress, s)
                ).ToList();
            }

            _allItems = result;
            ApplyPaging(1);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                await LogError("LoadData", ex);
                await Notify("danger", "Hata", "Veriler yüklenirken sorun oluştu.");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void ApplyPaging(int page)
    {
        _totalPages = Math.Max(1, (int)Math.Ceiling(_allItems.Count / (double)PAGE_SIZE));
        _currentPage = Math.Clamp(page, 1, _totalPages);
        _pagedItems = _allItems.Skip((_currentPage - 1) * PAGE_SIZE).Take(PAGE_SIZE).ToList();
    }

    private void GoToPage(int page)
    {
        ApplyPaging(page);
        StateHasChanged();
    }

    private async Task LoadCountriesAsync()
    {
        try
        {
            _countries = await StateHub.GetOrLoadAsync("Countries_All", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.Country.AsNoTracking()
                    .OrderBy(c => c.name).ToListAsync(_cts.Token);
            }, _cts.Token) ?? new();
        }
        catch (Exception ex) { await LogError("LoadCountries", ex); }
    }

    // ══════════════════════════════════════════════════════════════
    // CASCADE SELECT (isAdd=true → Ekle modali, false → Düzenle)
    // ══════════════════════════════════════════════════════════════

    private async Task OnCountryChanged(ChangeEventArgs e, bool isAdd)
    {
        int.TryParse(e.Value?.ToString(), out var countryId);
        var name = _countries.FirstOrDefault(c => c.id == countryId)?.name;

        if (isAdd)
        {
            _addCountryId = countryId;
            _addStateId = 0;
            _addStates.Clear();
            _addCities.Clear();
            if (_addModel != null) { _addModel.Country = name; _addModel.State = null; _addModel.Cities = null; }
        }
        else
        {
            _editCountryId = countryId;
            _editStateId = 0;
            _editStates.Clear();
            _editCities.Clear();
            if (_editModel != null) { _editModel.Country = name; _editModel.State = null; _editModel.Cities = null; }
        }

        if (countryId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var states = await db.States.AsNoTracking()
                    .Where(s => s.country_id == countryId)
                    .OrderBy(s => s.name).ToListAsync(_cts.Token);

                if (isAdd) _addStates = states;
                else _editStates = states;
            }
            catch (Exception ex) { await LogError("OnCountryChanged", ex); }
        }
        StateHasChanged();
    }

    private async Task OnStateChanged(ChangeEventArgs e, bool isAdd)
    {
        int.TryParse(e.Value?.ToString(), out var stateId);
        var states = isAdd ? _addStates : _editStates;
        var name = states.FirstOrDefault(s => s.id == stateId)?.name;

        if (isAdd)
        {
            _addStateId = stateId;
            _addCities.Clear();
            if (_addModel != null) { _addModel.State = name; _addModel.Cities = null; }
        }
        else
        {
            _editStateId = stateId;
            _editCities.Clear();
            if (_editModel != null) { _editModel.State = name; _editModel.Cities = null; }
        }

        if (stateId > 0)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                var cities = await db.Cities.AsNoTracking()
                    .Where(c => c.state_id == stateId)
                    .OrderBy(c => c.name).ToListAsync(_cts.Token);

                if (isAdd) _addCities = cities;
                else _editCities = cities;
            }
            catch (Exception ex) { await LogError("OnStateChanged", ex); }
        }
        StateHasChanged();
    }

    private void OnCityChanged(ChangeEventArgs e, bool isAdd)
    {
        var city = e.Value?.ToString();
        if (isAdd) { if (_addModel != null) _addModel.Cities = city; }
        else { if (_editModel != null) _editModel.Cities = city; }
    }

    // ══════════════════════════════════════════════════════════════
    // ARAMA
    // ══════════════════════════════════════════════════════════════

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadDataAsync(_searchTerm);
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await LoadDataAsync(null);
    }

    // ══════════════════════════════════════════════════════════════
    // MODAL AÇMA
    // ══════════════════════════════════════════════════════════════

    private async Task OpenAddModal()
    {
        if (use == null)
        {
            await Notify("warning", "Uyarı", "Kullanıcı bilgisi alınamadı.");
            return;
        }

        _addModel = new UserAddressMethod
        {
            Id = Guid.Empty,
            UserId = use.Id,
            CreatedDate = DateTime.UtcNow,
            IsDefault = !_allItems.Any() // İlk kayıt otomatik varsayılan
        };
        _addCountryId = 0;
        _addStateId = 0;
        _addStates.Clear();
        _addCities.Clear();
        await ShowModal("AddModal");
    }

    private async Task OpenEditModal(UserAddressMethod item)
    {
        // Şifreli alanları çözerek modele yaz
        _editModel = new UserAddressMethod
        {
            Id = item.Id,
            UserId = item.UserId,
            AddressName = item.AddressName,
            AddressType = item.AddressType,
            DeliveryReceiverFirstName = item.DeliveryReceiverFirstName,
            DeliveryReceiverLastName = item.DeliveryReceiverLastName,
            DeliveryReceiverEmail = item.DeliveryReceiverEmail,
            DeliveryReceiverPhoneCountryCode = item.DeliveryReceiverPhoneCountryCode,
            DeliveryReceiverPhoneNumber = item.DeliveryReceiverPhoneNumber,
            Country = Decrypt(item.Country),
            State = Decrypt(item.State),
            Cities = Decrypt(item.Cities),
            FullAddress = item.FullAddress,
            IsDefault = item.IsDefault,
            CreatedDate = item.CreatedDate
        };

        _editCountryId = 0;
        _editStateId = 0;
        _editStates.Clear();
        _editCities.Clear();

        // Cascade preload
        if (!string.IsNullOrWhiteSpace(_editModel.Country))
        {
            var country = _countries.FirstOrDefault(c =>
                string.Equals(c.name, _editModel.Country, StringComparison.OrdinalIgnoreCase));

            if (country != null)
            {
                _editCountryId = country.id;
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                    _editStates = await db.States.AsNoTracking()
                        .Where(s => s.country_id == _editCountryId)
                        .OrderBy(s => s.name).ToListAsync(_cts.Token);

                    if (!string.IsNullOrWhiteSpace(_editModel.State))
                    {
                        var state = _editStates.FirstOrDefault(s =>
                            string.Equals(s.name, _editModel.State, StringComparison.OrdinalIgnoreCase));

                        if (state != null)
                        {
                            _editStateId = state.id;
                            _editCities = await db.Cities.AsNoTracking()
                                .Where(c => c.state_id == _editStateId)
                                .OrderBy(c => c.name).ToListAsync(_cts.Token);
                        }
                    }
                }
                catch (Exception ex) { await LogError("OpenEditModal_Preload", ex); }
            }
        }

        await ShowModal("EditModal");
    }

    private async Task OpenDeleteModal(UserAddressMethod item)
    {
        _deleteTarget = item;
        await ShowModal("DeleteModal");
    }

    private async Task OpenBulkDeleteModal()
    {
        if (!_selectedIds.Any()) return;
        // Seçili kayıtların önizlemesini hazırla
        _bulkDeletePreview = _allItems.Where(x => _selectedIds.Contains(x.Id)).ToList();
        await ShowModal("BulkDeleteModal");
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Ekle
    // ══════════════════════════════════════════════════════════════

    private async Task AddAsync()
    {
        if (_isProcessing || _addModel == null || use == null) return;

        // Minimum doğrulama
        if (string.IsNullOrWhiteSpace(_addModel.AddressName))
        {
            await Notify("warning", "Eksik Bilgi", "Adres adı boş bırakılamaz.");
            return;
        }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            // Metin alanlarını trim et
            _addModel.AddressName = _addModel.AddressName?.Trim();
            _addModel.AddressType = _addModel.AddressType?.Trim();
            _addModel.DeliveryReceiverFirstName = _addModel.DeliveryReceiverFirstName?.Trim();
            _addModel.DeliveryReceiverLastName = _addModel.DeliveryReceiverLastName?.Trim();
            _addModel.DeliveryReceiverEmail = _addModel.DeliveryReceiverEmail?.Trim();
            _addModel.DeliveryReceiverPhoneCountryCode = _addModel.DeliveryReceiverPhoneCountryCode?.Trim();
            _addModel.DeliveryReceiverPhoneNumber = _addModel.DeliveryReceiverPhoneNumber?.Trim();
            _addModel.FullAddress = _addModel.FullAddress?.Trim();

            // Konum alanlarını şifrele
            _addModel.Country = GlobalSecurityProvider.Encrypt(_addModel.Country ?? "");
            _addModel.State = GlobalSecurityProvider.Encrypt(_addModel.State ?? "");
            _addModel.Cities = GlobalSecurityProvider.Encrypt(_addModel.Cities ?? "");

            _addModel.Id = Guid.NewGuid();
            _addModel.UserId = use.Id;
            _addModel.CreatedDate = DateTime.UtcNow;

            // Soft delete: yeni kayıt aktif (silinmemiş) durumda başlasın
            _addModel.IsDeleted = new IsDeleted
            {
                IsDeletedStatu = false,
                DeletedAtDate = null
            };

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // IsDefault tekilliği: yeni kayıt varsayılansa, kullanıcıya ait diğer adreslerden varsayılan bayrağı kaldır
            if (_addModel.IsDefault)
            {
                var userId = use.Id;
                await db.UserAddressMethod
                    .Where(x => x.UserId == userId && x.IsDefault)
                    .ExecuteUpdateAsync(s => s.SetProperty(x => x.IsDefault, false), _cts.Token);
            }

            db.UserAddressMethod.Add(_addModel);
            await db.SaveChangesAsync(_cts.Token);

            await HideModal("AddModal");
            _addModel = null;
            _isProcessing = false;

            StateHub.ClearCache($"{CACHE_KEY}_{use.Id}");
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Add");
            await Notify("success", "Başarılı", "Adres eklendi.");
        }
        catch (Exception ex)
        {
            await LogError("AddAsync", ex);
            await Notify("danger", "Hata", "Kayıt sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Güncelle
    // ══════════════════════════════════════════════════════════════

    private async Task UpdateAsync()
    {
        if (_isProcessing || _editModel == null || use == null) return;

        // Minimum doğrulama
        if (string.IsNullOrWhiteSpace(_editModel.AddressName))
        {
            await Notify("warning", "Eksik Bilgi", "Adres adı boş bırakılamaz.");
            return;
        }

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var existing = await db.UserAddressMethod.FindAsync(new object[] { _editModel.Id }, _cts.Token);

            if (existing == null)
            {
                await Notify("warning", "Uyarı", "Kayıt artık mevcut değil.");
                return;
            }

            // Güvenlik: başka bir kullanıcının adresi düzenlenmesin
            if (existing.UserId != use.Id)
            {
                await Notify("danger", "Yetki", "Bu kayıt üzerinde işlem yapma yetkiniz yok.");
                return;
            }

            // IsDefault tekilliği: bu kayıt varsayılan yapılıyorsa diğerlerinden bayrağı kaldır
            if (_editModel.IsDefault && !existing.IsDefault)
            {
                var userId = use.Id;
                var thisId = _editModel.Id;
                await db.UserAddressMethod
                    .Where(x => x.UserId == userId && x.Id != thisId && x.IsDefault)
                    .ExecuteUpdateAsync(s => s.SetProperty(x => x.IsDefault, false), _cts.Token);
            }

            // Düz alanlar (trim'li)
            existing.AddressName = _editModel.AddressName?.Trim();
            existing.AddressType = _editModel.AddressType?.Trim();
            existing.DeliveryReceiverFirstName = _editModel.DeliveryReceiverFirstName?.Trim();
            existing.DeliveryReceiverLastName = _editModel.DeliveryReceiverLastName?.Trim();
            existing.DeliveryReceiverEmail = _editModel.DeliveryReceiverEmail?.Trim();
            existing.DeliveryReceiverPhoneCountryCode = _editModel.DeliveryReceiverPhoneCountryCode?.Trim();
            existing.DeliveryReceiverPhoneNumber = _editModel.DeliveryReceiverPhoneNumber?.Trim();
            existing.FullAddress = _editModel.FullAddress?.Trim();
            existing.IsDefault = _editModel.IsDefault;

            // Şifreli alanlar
            existing.Country = GlobalSecurityProvider.Encrypt(_editModel.Country ?? "");
            existing.State = GlobalSecurityProvider.Encrypt(_editModel.State ?? "");
            existing.Cities = GlobalSecurityProvider.Encrypt(_editModel.Cities ?? "");

            await db.SaveChangesAsync(_cts.Token);

            await HideModal("EditModal");
            _editModel = null;
            _isProcessing = false;

            StateHub.ClearCache($"{CACHE_KEY}_{use.Id}");
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Update");
            await Notify("success", "Başarılı", "Adres güncellendi.");
        }
        catch (Exception ex)
        {
            await LogError("UpdateAsync", ex);
            await Notify("danger", "Hata", "Güncelleme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Tekli Sil
    // ══════════════════════════════════════════════════════════════

    private async Task DeleteConfirmedAsync()
    {
        if (_isProcessing || _deleteTarget == null || use == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.UserAddressMethod.FindAsync(new object[] { _deleteTarget.Id }, _cts.Token);

            if (entity != null)
            {
                // Güvenlik: başka bir kullanıcının adresi silinmesin
                if (entity.UserId != use.Id)
                {
                    await Notify("danger", "Yetki", "Bu kayıt üzerinde işlem yapma yetkiniz yok.");
                    return;
                }

                // Soft delete: kaydı kalıcı silmek yerine işaretle
                entity.IsDeleted = new IsDeleted
                {
                    IsDeletedStatu = true,
                    DeletedAtDate = DateTime.UtcNow
                };
                // Silinen kayıt varsayılan ise bayrağı düşür (listede varsayılan olmasın)
                if (entity.IsDefault) entity.IsDefault = false;

                await db.SaveChangesAsync(_cts.Token);
            }

            await HideModal("DeleteModal");
            _deleteTarget = null;
            _isProcessing = false;

            StateHub.ClearCache($"{CACHE_KEY}_{use.Id}");
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "Delete");
            await Notify("success", "Silindi", "Adres başarıyla silindi.");
        }
        catch (Exception ex)
        {
            await LogError("DeleteAsync", ex);
            await Notify("danger", "Hata", "Silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // CRUD — Toplu Sil
    // ══════════════════════════════════════════════════════════════

    private async Task BulkDeleteConfirmedAsync()
    {
        if (_isProcessing || !_selectedIds.Any() || use == null) return;

        await _writeLock.WaitAsync(_cts.Token);
        try
        {
            _isProcessing = true;
            StateHasChanged();

            var ids = _selectedIds.ToList();
            var count = ids.Count;
            var userId = use.Id;
            var now = DateTime.UtcNow;

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Soft delete: seçili kayıtları kalıcı silmek yerine işaretle
            // Güvenlik: sadece bu kullanıcının kayıtlarını etkile
            await db.UserAddressMethod
                .Where(x => ids.Contains(x.Id) && x.UserId == userId)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(x => x.IsDeleted!.IsDeletedStatu, true)
                    .SetProperty(x => x.IsDeleted!.DeletedAtDate, now)
                    .SetProperty(x => x.IsDefault, false),
                    _cts.Token);

            _selectedIds.Clear();
            _allSelected = false;
            _bulkDeletePreview.Clear();

            await HideModal("BulkDeleteModal");
            _isProcessing = false;

            StateHub.ClearCache($"{CACHE_KEY}_{use.Id}");
            await StateHub.NotifyDataChanged(ENTITY_NAME);
            await Logger.TakeIt(use?.Id, PAGE_TITLE, $"BulkDelete ({count})");
            await Notify("success", "Silindi", $"{count} adres silindi.");
        }
        catch (Exception ex)
        {
            await LogError("BulkDelete", ex);
            await Notify("danger", "Hata", "Toplu silme sırasında sorun oluştu.");
        }
        finally
        {
            if (_isProcessing) { _isProcessing = false; StateHasChanged(); }
            _writeLock.Release();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // TOPLU SEÇİM
    // ══════════════════════════════════════════════════════════════

    private void ToggleRowSelection(Guid id)
    {
        if (!_selectedIds.Remove(id)) _selectedIds.Add(id);
        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (_allSelected)
            _selectedIds.Clear();
        else
            foreach (var item in _allItems)
                _selectedIds.Add(item.Id);

        _allSelected = _allItems.Count > 0 && _allItems.All(i => _selectedIds.Contains(i.Id));
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _allSelected = false;
        StateHasChanged();
    }

    // ══════════════════════════════════════════════════════════════
    // YARDIMCI
    // ══════════════════════════════════════════════════════════════

    private async Task ShowModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"new bootstrap.Modal(document.getElementById('{id}')).show()");

    private async Task HideModal(string id) =>
        await JS.InvokeVoidAsync("eval",
            $"bootstrap.Modal.getInstance(document.getElementById('{id}'))?.hide()");

    private async Task Notify(string type, string title, string text)
    {
        if (_notificationRef == null) return;
        await _notificationRef.Launch(type, title, text, "https://picsum.photos/120");
    }

    private async Task LogError(string action, Exception ex)
    {
        try { await Logger.TakeIt(use?.Id, PAGE_TITLE, action, exception: ex.Message, stackTrace: ex.StackTrace); }
        catch { }
    }
}
