@* ============================================================
   UserAddress.razor
   ─────────────────────────────────────────────────────────────
   ✅ GlobalStateHub — anlık broadcast, debounce, RAM cache
   ✅ GlobalSecurityProvider — Country/State/Cities şifreli
   ✅ TakeLogs — tüm CRUD aksiyonları loglanır
   ✅ Ayrı Ekle / Düzenle / Sil modalleri
   ✅ Seçilenleri Sil → önce onay modali (sayı + liste)
   ✅ 5'li sayfalama
   ✅ Soft Delete (IsDeleted owned entity)
   ✅ IsDefault tekilliği — kullanıcı başına tek varsayılan adres
   ✅ Model: UserAddressMethod
   ============================================================ *@

@using api
@using api.tr
@using data
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ─── Breadcrumb ─── *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",        "Ana Sayfa",    "/"),
        ("fa fa-map-marker",  "Adresler",     "javascript:void(0)"),
        ("fa fa-list-alt",    PAGE_TITLE,     "javascript:void(0)")
    };
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ─── Toolbar ─── *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    <button class="btn btn-light btn-sm" @onclick="OpenAddModal" disabled="@_isLoading">
        <i class="fa fa-plus me-sm-1"></i>
        <span class="d-none d-sm-inline">Yeni Adres</span>
    </button>

    @if (_selectedIds.Any())
    {
        <div class="vr mx-1"></div>
        <span class="badge bg-light">@_selectedIds.Count seçili</span>

        <button class="btn btn-outline-light btn-sm border-0" @onclick="ClearSelection" title="Seçimi Temizle">
            <i class="fa fa-times"></i> Seçimi Temizle
        </button>

        <div class="vr mx-1"></div>

        <button class="btn btn-outline-danger btn-sm border-0"
                @onclick="OpenBulkDeleteModal"
                disabled="@_isProcessing">
            <i class="fa fa-trash"></i> Seçilenleri Sil
        </button>
    }
</div>

@* ─── Arama ─── *@
<div class="input-group input-group-sm mb-2">
    <span class="input-group-text bg-transparent text-white">
        <i class="fa fa-search"></i>
    </span>
    <input type="text"
           class="form-control bg-transparent text-light"
           placeholder="Ara"
           value="@_searchTerm"
           @oninput="OnSearchInput" />
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
            <i class="fa fa-times"></i>
        </button>
    }
</div>

@* ─── İçerik ─── *@
@if (_isLoading && !_pagedItems.Any())
{
    <div class="text-center py-5">
        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
        <p class="mt-2 text-light small">Yükleniyor...</p>
    </div>
}
else if (!_isLoading && !_allItems.Any())
{
    <div class="text-center py-5 text-light">
        <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
        <p class="mb-0">Kayıt bulunmuyor.</p>
    </div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width:2rem;">
                        <input type="checkbox" class="form-check-input"
                               checked="@_allSelected"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th class="d-none d-md-table-cell" style="width:2.5rem;">#</th>
                                        <th class="text-center">Varsayılan</th>
                    <th>Adres Adı</th>
                    <th>Alıcı</th>
                    <th>Ülke</th>
                    <th>İl / Şehir</th>
                    <th class="d-none d-lg-table-cell">Tür</th>
                    <th class="d-none d-md-table-cell">Tarih</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = (_currentPage - 1) * PAGE_SIZE + 1;
                }
                @foreach (var item in _pagedItems)
                {
                    var isSelected = _selectedIds.Contains(item.Id);
                    <tr class="@(isSelected ? "table-active" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input"
                                   checked="@isSelected"
                                   @onchange="() => ToggleRowSelection(item.Id)" />
                        </td>
                        <td class="d-none d-md-table-cell text-light small">@(rowNo++)</td>
                        <td class="text-center">
                            <i class="fa @(item.IsDefault ? "fa-star text-warning" : "fa-star-o text-light")"
                               title="@(item.IsDefault ? "Varsayılan Adres" : "")"></i>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.AddressName</div>
                        </td>
                        <td>
                            <div class="small">@item.DeliveryReceiverFirstName @item.DeliveryReceiverLastName</div>
                            <div class="small text-light">@item.DeliveryReceiverPhoneCountryCode @item.DeliveryReceiverPhoneNumber</div>
                            <div class="small text-warning">@item.DeliveryReceiverEmail</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@(Decrypt(item.Country))</div>
                        </td>
                        <td>
                            <div class="small">@(Decrypt(item.State))</div>
                            <div class="small text-light">@(Decrypt(item.Cities))</div>
                        </td>
                        <td class="d-none d-lg-table-cell">
                            <span class="badge bg-primary small">@(string.IsNullOrEmpty(item.AddressType) ? "Boş" : item.AddressType == "Individual" ? "Bireysel" : item.AddressType == "Corporate" ? "Kurumsal" : "Boş")</span>
                        </td>
                        <td class="d-none d-md-table-cell text-nowrap">
                            <div class="small">@item.CreatedDate.ToString("dd.MM.yyyy") | @item.CreatedDate.ToString("HH:mm")</div>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => OpenEditModal(item)" title="Düzenle">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)" title="Sil">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── Sayfalama ─── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <small class="text-light">
            Toplam @_allItems.Count kayıt
            @if (_isLoading)
            {
                <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
            }
        </small>

        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                    </li>

                    @for (int p = 1; p <= _totalPages; p++)
                    {
                        var pg = p;
                        <li class="page-item @(_currentPage == pg ? "active" : "")">
                            <button class="page-link @(_currentPage == pg ? "" : "bg-dark text-light") border-secondary"
                                    @onclick="() => GoToPage(pg)">
                                @pg
                            </button>
                        </li>
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-light border-secondary"
                                @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — Ekle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="AddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-plus me-1"></i>Yeni Adres Ekle
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_addModel != null)
                {
                    <div class="row g-3">

                        @* ── Adres Bilgileri ── *@
                        <div class="col-12">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-bookmark me-1"></i>Adres Bilgileri</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Adres Adı</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Ev Adresim, İş Adresim..."
                                   @bind="_addModel.AddressName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-building me-1"></i>Adres Türü</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    @bind="_addModel.AddressType">
                                <option value="">Tür Seçiniz</option>
                                <option value="Individual">Bireysel</option>
                                <option value="Corporate">Kurumsal</option>
                            </select>
                        </div>

                        @* ── Alıcı Bilgileri ── *@
                        <div class="col-12 mt-2">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-user me-1"></i>Alıcı Bilgileri</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">Ad</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Alıcı adı"
                                   @bind="_addModel.DeliveryReceiverFirstName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">Soyad</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="Alıcı soyadı"
                                   @bind="_addModel.DeliveryReceiverLastName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-envelope me-1"></i>E-posta</label>
                            <input type="email"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="ornek@mail.com"
                                   @bind="_addModel.DeliveryReceiverEmail" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-phone me-1"></i>Telefon</label>
                            <div class="input-group input-group-sm">
                                <select class="form-select bg-dark text-white border-secondary"
                                        style="max-width:160px;"
                                        @bind="_addModel.DeliveryReceiverPhoneCountryCode">
                                    @foreach (var c in _countries)
                                    {
                                        <option value="@c.phonecode">@c.name @c.phonecode</option>
                                    }
                                </select>
                                <input type="text"
                                       class="form-control bg-dark text-white border-secondary"
                                       placeholder="5XX XXX XX XX"
                                       @bind="_addModel.DeliveryReceiverPhoneNumber" />
                            </div>
                        </div>

                        @* ── Konum Bilgileri ── *@
                        <div class="col-12 mt-2">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-map-marker me-1"></i>Konum Bilgileri</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addCountryId"
                                    @onchange="e => OnCountryChanged(e, true)">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addStateId"
                                    @onchange="e => OnStateChanged(e, true)"
                                    disabled="@(!_addStates.Any())">
                                <option value="0">@(_addStates.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _addStates)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_addModel.Cities"
                                    @onchange="e => OnCityChanged(e, true)"
                                    disabled="@(!_addCities.Any())">
                                <option value="">@(_addCities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _addCities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-home me-1"></i>Açık Adres</label>
                            <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                                      rows="3"
                                      placeholder="Mahalle, sokak, bina no, daire no..."
                                      @bind="_addModel.FullAddress"></textarea>
                        </div>

                        @* ── Ayarlar ── *@
                        <div class="col-12 mt-2">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-cog me-1"></i>Ayarlar</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="add_chkDefault" @bind="_addModel.IsDefault" />
                                <label class="form-check-label text-white-50" for="add_chkDefault">
                                    <i class="fa fa-star me-1 text-warning"></i>Varsayılan adres olarak ayarla
                                </label>
                            </div>
                        </div>

                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="AddAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-plus me-1"></i><span>Adres Ekle</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   MODAL — Düzenle (Ayrı Modal)
   ═══════════════════════════════════════════ *@
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content bg-dark border border-secondary"
             style="box-shadow:0 0 8px rgba(255,215,0,0.35);">

            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-white mb-0">
                    <i class="fa fa-pencil me-1"></i>Adres Düzenle
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2" onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size: 0.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width: 1px; opacity: 0.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2" data-bs-dismiss="modal" aria-label="Close" title="Kapat">
                        <i class="fa fa-times" style="font-size: 0.95rem;"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (_editModel != null)
                {
                    <div class="row g-3">

                        @* ── Adres Bilgileri ── *@
                        <div class="col-12">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-bookmark me-1"></i>Adres Bilgileri</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-tag me-1"></i>Adres Adı</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.AddressName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-building me-1"></i>Adres Türü</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    @bind="_editModel.AddressType">
                                <option value="">Boş</option>
                                <option value="Individual">Bireysel</option>
                                <option value="Corporate">Kurumsal</option>
                            </select>
                        </div>

                        @* ── Alıcı Bilgileri ── *@
                        <div class="col-12 mt-2">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-user me-1"></i>Alıcı Bilgileri</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">Ad</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.DeliveryReceiverFirstName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small">Soyad</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.DeliveryReceiverLastName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-envelope me-1"></i>E-posta</label>
                            <input type="email"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_editModel.DeliveryReceiverEmail" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white-50 small"><i class="fa fa-phone me-1"></i>Telefon</label>
                            <div class="input-group input-group-sm">
                                <select class="form-select bg-dark text-white border-secondary"
                                        style="max-width:160px;"
                                        @bind="_editModel.DeliveryReceiverPhoneCountryCode">
                                    @foreach (var c in _countries)
                                    {
                                        <option value="@c.phonecode">@c.name @c.phonecode</option>
                                    }
                                </select>

                                <input type="text"
                                       class="form-control bg-dark text-white border-secondary"
                                       @bind="_editModel.DeliveryReceiverPhoneNumber" />
                            </div>
                        </div>

                        @* ── Konum Bilgileri ── *@
                        <div class="col-12 mt-2">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-map-marker me-1"></i>Konum Bilgileri</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-flag me-1"></i>Ülke</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editCountryId"
                                    @onchange="e => OnCountryChanged(e, false)">
                                <option value="0">Ülke Seçiniz</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c.id">@c.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-signs me-1"></i>Eyalet / İl</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editStateId"
                                    @onchange="e => OnStateChanged(e, false)"
                                    disabled="@(!_editStates.Any())">
                                <option value="0">@(_editStates.Any() ? "İl Seçiniz" : "---")</option>
                                @foreach (var s in _editStates)
                                {
                                    <option value="@s.id">@s.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label text-white-50 small"><i class="fa fa-map-marker me-1"></i>Şehir</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    value="@_editModel.Cities"
                                    @onchange="e => OnCityChanged(e, false)"
                                    disabled="@(!_editCities.Any())">
                                <option value="">@(_editCities.Any() ? "Şehir Seçiniz" : "---")</option>
                                @foreach (var city in _editCities)
                                {
                                    <option value="@city.name">@city.name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-white-50 small"><i class="fa fa-home me-1"></i>Açık Adres</label>
                            <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                                      rows="3"
                                      @bind="_editModel.FullAddress"></textarea>
                        </div>

                        @* ── Ayarlar ── *@
                        <div class="col-12 mt-2">
                            <h6 class="text-white-50 small mb-0"><i class="fa fa-cog me-1"></i>Ayarlar</h6>
                            <hr class="border-secondary mt-1 mb-2" />
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="edit_chkDefault" @bind="_editModel.IsDefault" />
                                <label class="form-check-label text-white-50" for="edit_chkDefault">
                                    <i class="fa fa-star me-1 text-warning"></i>Varsayılan adres olarak ayarla
                                </label>
                            </div>
                        </div>

                    </div>
                }
            </div>

            <div class="modal-footer border-top border-secondary py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
                <button type="button" class="btn btn-warning btn-sm"
                        @onclick="UpdateAsync" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <i class="fa fa-spinner fa-spin me-1"></i><span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="fa fa-save me-1"></i><span>Değişiklikleri Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

