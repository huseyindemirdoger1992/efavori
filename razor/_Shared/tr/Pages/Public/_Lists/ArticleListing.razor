@* ============================================================
   ArticleListing.razor
   ─────────────────────────────────────────────────────────────
   ✅ Kart ızgarası (Bootstrap 5.3 + Font Awesome 4.7.0)
   ✅ Arama (debounce'lu — her tuş vuruşunda sorgu atılmaz)
   ✅ Sonsuz kaydırma — IntersectionObserver + "Daha Fazla Göster" yedek düğmesi
   ✅ KEYSET (SEEK) PAGINATION — OFFSET/Skip KULLANILMAZ.
      Milyonlarca makale olsa bile her sayfa sabit maliyetle (index seek) gelir.
   ✅ N+1 önleyici toplu medya çekimi
   NOT: namespace'i projenizin gerçek Razor component klasör yapısına göre
   düzenleyin (aşağıda örnek olarak razor.Public.Articles kullanıldı).
   ============================================================ *@
@using System.Threading
@using data
@using data.Articles
@using data._Shared
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject IJSRuntime JS

<div class="container-fluid py-4">

    @* ─── Başlık + Arama ─── *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0 text-light">
            @(_hasActiveSearch ? $"\"{_searchTerm}\" için Arama Sonuçları" : "Makaleler")
        </h1>

        <div class="input-group input-group-sm" style="max-width: 320px;">
            <span class="input-group-text bg-transparent border-secondary text-light">
                <i class="fa fa-search"></i>
            </span>
            <input type="text"
                   class="form-control bg-transparent text-light border-secondary"
                   placeholder="Makalelerde ara..."
                   value="@_searchTerm"
                   @oninput="OnSearchInput" />
            @if (_hasActiveSearch)
            {
                <button class="btn btn-outline-secondary" @onclick="ClearSearch" title="Aramayı Temizle">
                    <i class="fa fa-times"></i>
                </button>
            }
        </div>
    </div>

    @* ─── Kart Izgarası ─── *@
    @if (_isFirstLoad)
    {
        <div class="text-center py-5">
            <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
            <p class="mt-2 text-light small">Makaleler yükleniyor...</p>
        </div>
    }
    else if (!_items.Any())
    {
        <div class="text-center py-5 text-light">
            <i class="fa fa-file-text-o fa-3x mb-3 d-block"></i>
            <p class="mb-0">@(_hasActiveSearch ? "Aramanızla eşleşen makale bulunamadı." : "Henüz makale bulunmuyor.")</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in _items)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <a href="@GetArticleUrl(item)" class="text-decoration-none">
                        <div class="card h-100 bg-dark border-secondary article-card">
                            <div class="ratio ratio-16x9 bg-secondary bg-opacity-25">
                                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                {
                                    <img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" class="w-100 h-100" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100">
                                        <i class="fa fa-file-text-o fa-3x text-secondary"></i>
                                    </div>
                                }
                            </div>
                            <div class="card-body">
                                <h2 class="h6 card-title text-light mb-2">@item.Title</h2>
                                @if (!string.IsNullOrEmpty(item.ShortDescription))
                                {
                                    <p class="card-text text-body-secondary small mb-0 article-clamp">
                                        @item.ShortDescription
                                    </p>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-secondary d-flex justify-content-between align-items-center small text-secondary">
                                <span><i class="fa fa-calendar-o me-1"></i>@item.CreatedAt.ToString("dd.MM.yyyy")</span>
                                <span><i class="fa fa-eye me-1"></i>@(item.ViewCount ?? 0)</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @* ─── Sonsuz kaydırma tetikleyicisi / yedek "Daha Fazla" düğmesi ─── *@
        @if (_hasMore)
        {
            <div class="text-center mt-4" @ref="_sentinelRef">
                <button class="btn btn-outline-light btn-sm" @onclick="() => LoadNextPageAsync(false)" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span><i class="fa fa-spinner fa-spin me-1"></i>Yükleniyor...</span>
                    }
                    else
                    {
                        <span>Daha Fazla Göster</span>
                    }
                </button>
            </div>
        }
        else
        {
            <div class="text-center mt-4 text-secondary small">
                <i class="fa fa-check-circle me-1"></i>Tüm makaleler yüklendi.
            </div>
        }
    }
</div>

<style>
    .article-card {
        transition: transform .15s ease, border-color .15s ease;
    }

        .article-card:hover {
            transform: translateY(-2px);
            border-color: #6c757d !important;
        }

    .article-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    // Controller tarafından (?q= query string) başlangıç arama terimi olarak geçirilir
    [Parameter] public string? InitialQuery { get; set; }

    private const int PageSize = 24;

    // ─── Parametre ────────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }

    private sealed class ArticleCardDto
    {
        public Guid Id { get; set; }
        public string? Slug { get; set; }
        public string? Title { get; set; }
        public string? ShortDescription { get; set; }
        public Guid? FeaturedImage { get; set; }
        public string? CoverImageUrl { get; set; }
        public DateTime CreatedAt { get; set; }
        public int? ViewCount { get; set; }
    }

    private readonly List<ArticleCardDto> _items = new();

    private string _searchTerm = string.Empty;
    private bool _hasActiveSearch => !string.IsNullOrWhiteSpace(_searchTerm);

    private bool _isFirstLoad = true;
    private bool _isLoading;
    private bool _hasMore = true;

    // ── Keyset (seek) pagination imleci ──
    // OFFSET/Skip KULLANILMAZ: son yüklenen kaydın CreatedAt+Id değeri hatırlanır,
    // sıradaki sayfa "bundan sonrakiler" diye WHERE ile seek edilir.
    // Bu sayede 100. sayfa ile 100.000. sayfa arasında performans farkı OLMAZ.
    private DateTime? _cursorCreatedAt;
    private Guid? _cursorId;

    private CancellationTokenSource? _searchDebounceCts;

    private ElementReference _sentinelRef;
    private DotNetObjectReference<ArticleListing>? _dotNetRef;
    private bool _jsSetupDone;

    protected override async Task OnInitializedAsync()
    {
        _searchTerm = InitialQuery?.Trim() ?? string.Empty;
        await LoadNextPageAsync(reset: true);
        _isFirstLoad = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Yeni kartlar eklendikçe sentinel elemanı DOM'da yer değiştirir (en alta kayar),
        // bu yüzden her render sonrası gözlemciyi (idempotent şekilde) yeniden bağlıyoruz.
        if (_hasMore && !_isLoading)
        {
            await EnsureScrollObserverAsync();
        }
    }

    // ─────────────────────────────────────────────
    //  ARAMA (debounce'lu)
    // ─────────────────────────────────────────────
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;

        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token); // kullanıcı yazmayı bitirene kadar bekle
            if (token.IsCancellationRequested) return;
            await LoadNextPageAsync(reset: true);
        }
        catch (TaskCanceledException)
        {
            // Yeni bir tuş vuruşu geldi, bu arama iptal edildi — beklenen davranış
        }
    }

    private async Task ClearSearch()
    {
        _searchDebounceCts?.Cancel();
        _searchTerm = string.Empty;
        await LoadNextPageAsync(reset: true);
    }

    // ─────────────────────────────────────────────
    //  VERİ YÜKLEME — Keyset (Seek) Pagination
    // ─────────────────────────────────────────────
    private async Task LoadNextPageAsync(bool reset)
    {
        if (_isLoading) return;
        if (!reset && !_hasMore) return;

        _isLoading = true;
        if (reset)
        {
            _items.Clear();
            _cursorCreatedAt = null;
            _cursorId = null;
            _hasMore = true;
        }
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var query = db.Set<Article>().AsNoTracking()
                .Where(a => a.IsDeleted == null || a.IsDeleted.IsDeletedStatu == false);

            if (_hasActiveSearch)
            {
                var term = _searchTerm.Trim();
                // NOT: Büyük ölçekte (milyonlarca satır) LIKE '%...%' index kullanamaz ve yavaşlar.
                // Üretimde SQL Server Full-Text Search (CONTAINS/FREETEXT) index'i kurulup
                // bu sorgunun ona göre uyarlanması ŞİDDETLE önerilir.
                query = query.Where(a =>
                    EF.Functions.Like(a.Title!, $"%{term}%") ||
                    (a.Meta != null && a.Meta.FocusKeywords != null && EF.Functions.Like(a.Meta.FocusKeywords, $"%{term}%")));
            }

            query = query.OrderByDescending(a => a.CreatedAt).ThenByDescending(a => a.Id);

            if (_cursorCreatedAt.HasValue && _cursorId.HasValue)
            {
                var cCreatedAt = _cursorCreatedAt.Value;
                var cId = _cursorId.Value;

                // "Son gördüğün kayıttan sonrakiler" — klasik row-value seek deseni.
                // Article.cs üzerindeki [Index(CreatedAt, Id)] composite index'i sayesinde
                // bu WHERE koşulu index seek ile çalışır, full scan YAPMAZ.
                query = query.Where(a =>
                    a.CreatedAt < cCreatedAt ||
                    (a.CreatedAt == cCreatedAt && a.Id.CompareTo(cId) < 0));
            }

            var page = await query
                .Take(PageSize)
                .Select(a => new ArticleCardDto
                {
                    Id = a.Id,
                    Slug = a.Slug,
                    Title = a.Title,
                    ShortDescription = a.ShotDescription,
                    FeaturedImage = a.FeaturedImage,
                    CreatedAt = a.CreatedAt,
                    ViewCount = a.Interaction != null ? a.Interaction.ViewCount : null
                })
                .ToListAsync();

            // ── Kapak görsellerini TEK sorguda toplu çek (N+1 önlenir) ──
            var mediaIds = page.Where(p => p.FeaturedImage.HasValue)
                .Select(p => p.FeaturedImage!.Value)
                .Distinct()
                .ToList();

            if (mediaIds.Any())
            {
                var mediaMap = await db.Set<Media>().AsNoTracking()
                    .Where(m => mediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                    .ToDictionaryAsync(m => m.Id, m => m.FileUrl_Ratio_1_4 ?? m.FileUrl_Ratio_1_2 ?? m.FileUrl ?? "");

                foreach (var item in page)
                {
                    if (item.FeaturedImage.HasValue && mediaMap.TryGetValue(item.FeaturedImage.Value, out var url))
                        item.CoverImageUrl = url;
                }
            }

            if (page.Count < PageSize) _hasMore = false;

            if (page.Any())
            {
                var last = page[^1];
                _cursorCreatedAt = last.CreatedAt;
                _cursorId = last.Id;
            }

            _items.AddRange(page);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string GetArticleUrl(ArticleCardDto item)
    {
        var slugOrId = !string.IsNullOrWhiteSpace(item.Slug) ? item.Slug : item.Id.ToString();
        return $"/Public/_ArticleViewer/ArticleProfile/{slugOrId}";
    }

    // ─────────────────────────────────────────────
    //  SONSUZ KAYDIRMA — IntersectionObserver (JS interop)
    //  Ayrı bir .js dosyasına ihtiyaç duymadan, tek dosyalı component
    //  kültürüne uygun şekilde JS satır içi (inline eval) enjekte edilir.
    // ─────────────────────────────────────────────
    private async Task EnsureScrollObserverAsync()
    {
        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);

            if (!_jsSetupDone)
            {
                await JS.InvokeVoidAsync("eval", InfiniteScrollJsSetup);
                _jsSetupDone = true;
            }

            await JS.InvokeVoidAsync("efavoriArticleScrollObserve", _sentinelRef, _dotNetRef);
        }
        catch
        {
            // JS interop statik SSR (prerender) sırasında çalışmaz — sorun değil,
            // "Daha Fazla Göster" düğmesi zaten manuel yedek olarak her zaman çalışır.
        }
    }

    [JSInvokable]
    public async Task OnSentinelIntersected()
    {
        if (_isLoading || !_hasMore) return;
        await LoadNextPageAsync(reset: false);
    }

    private const string InfiniteScrollJsSetup = """
        if (!window.efavoriArticleScrollObserve) {
            window.__efavoriArticleObservers = new WeakMap();
            window.efavoriArticleScrollObserve = function (el, dotnetRef) {
                if (!el) return;
                if (window.__efavoriArticleObservers.has(el)) {
                    window.__efavoriArticleObservers.get(el).disconnect();
                }
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            dotnetRef.invokeMethodAsync('OnSentinelIntersected');
                        }
                    });
                }, { rootMargin: '600px 0px' });
                observer.observe(el);
                window.__efavoriArticleObservers.set(el, observer);
            };
        }
        """;

    public async ValueTask DisposeAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _dotNetRef?.Dispose();
        await ValueTask.CompletedTask;
    }
}
