@* ════════════════════════════════════════════════════════════════════════
   ProductListing.razor
   ─────────────────────────────────────────────────────────────────────────
   ✅ Sonsuz kaydırma (Infinite Scroll) — IntersectionObserver ile 24'er ürün
   ✅ Hover galeri — CSS-only 4 bölgeli görsel geçişi
   ✅ Recursive kategori ağacı — sonsuz seviyeli, canlı arama, boş kategori gizleme
   ✅ Sabit filtre paneli (masaüstü sticky, mobil offcanvas)
   ✅ Hızlı Bakış (Quick View) modalı — %90 şeffaf, mobil uyumlu
   ✅ Mağaza Detay modalı — Leaflet.js harita + yol tarifi (düzeltildi)
   ✅ Favorilere Ekle, Karşılaştır, Paylaş, Hızlı Bakış aksiyon butonları
   ✅ Kargo, fiyat, marka, puan filtreleri
   ✅ Genişletilmiş arama (ad, marka, SKU, barkod, açıklama)
   ✅ Responsive: mobil / tablet / masaüstü
   ✅ IDbContextFactory + AsNoTracking + CancellationToken
   ✅ GlobalStateHub broadcast, TakeLogs loglama
   ✅ IAsyncDisposable, SemaphoreSlim
   ✅ Marka: sayfa yüklenişinde rastgele 100, 3+ karakter debounce 500ms arama
   ✅ Rastgele ürün yükleme (her batch), çift yükleme sorunu çözüldü
   ✅ Sepete Ekle / Hızlı Al butonları (ürün kartı + Hızlı Bakış)
   ✅ product-actions her zaman görünür
   ✅ custom-select-container mobil-dostu dropdown
   ✅ Ürün yönlendirmesi: /Public/_Viewer/ProductProfile/{Slug}

   VERİ MODELİ NOTU:
   - Products.BrandId → Brands tablosu (join)
   - SKU/Barcode → ProductVariants (IsDefault=true)
   - Slug → ProductSeo tablosu
   - Kategori → ProductCategories junction tablosu
   - Fiyat → ProductPrices (EffectiveTo==null, varsayılan varyant)
   - Kapak görseli → Products.CoverMediaId → Media tablosu
   - Galeri → ItemGallery (ItemType="Product", ItemId=ProductId)
   - InteractionCounts: ViewCount, LikeCount, ShareCount, BookmarkCount
   - IsDeleted.IsDeletedStatu / DeletedAtDate
   ════════════════════════════════════════════════════════════════════════ *@

@using api
@using api.tr
@using data
@using data._Shared
@using data._Product
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using System.Text

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ═══════════════════════════════════════════════════════════════
   BREADCRUMB
   ═══════════════════════════════════════════════════════════════ *@
@{
    var roads = new List<(string icon, string Name, string Url)>
    {
        ("fa fa-home",          "Ana Sayfa",    "/"),
        ("fa fa-shopping-bag",  "Ürünler",      "javascript:void(0)")
    };

    if (_selectedCategory != null)
    {
        var breadcrumbPath = BuildCategoryBreadcrumb(_selectedCategory.Id);
        foreach (var bc in breadcrumbPath)
        {
            roads.Add(("fa fa-angle-right", bc.Name ?? "—", "javascript:void(0)"));
        }
    }
}
<razor._Shared.BreadCrumbLinksUrl roads="roads" />

@* ═══════════════════════════════════════════════════════════════
   MOBİL FİLTRE BUTONU
   ═══════════════════════════════════════════════════════════════ *@
<div class="d-lg-none mb-3 d-flex gap-2">
    <button class="btn btn-outline-info btn-sm flex-fill"
            @onclick="() => _mobileFilterOpen = true">
        <i class="fa fa-sliders me-1"></i>Filtreler
        @if (HasActiveFilter())
        {
            <span class="badge bg-info text-dark ms-1">@ActiveFilterCount()</span>
        }
    </button>
    <div class="btn-group btn-group-sm">
        <button class="btn @(_viewMode == ViewMode.Grid ? "btn-info" : "btn-outline-secondary")"
                @onclick="() => _viewMode = ViewMode.Grid" title="Izgara">
            <i class="fa fa-th"></i>
        </button>
        <button class="btn @(_viewMode == ViewMode.List ? "btn-info" : "btn-outline-secondary")"
                @onclick="() => _viewMode = ViewMode.List" title="Liste">
            <i class="fa fa-th-list"></i>
        </button>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   ANA YAPI — 2 SÜTUN (masaüstü) / TEK SÜTUN (mobil)
   ═══════════════════════════════════════════════════════════════ *@
<div class="row g-3">

    @* ─── SOL: FİLTRE PANELİ (masaüstü — sticky) ─── *@
    <div class="col-lg-3 d-none d-lg-block">
        <div class="filter-panel-sticky">
            @FilterPanelContent()
        </div>
    </div>

    @* ─── SAĞ: ÜRÜN ALANI ─── *@
    <div class="col-lg-9">

        @* ─── Üst Toolbar: Arama + Sıralama + Görünüm ─── *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">

            @* Arama *@
            <div class="input-group input-group-sm flex-fill" style="min-width:200px; max-width:480px;">
                <span class="input-group-text bg-transparent border-secondary text-white">
                    <i class="fa fa-search"></i>
                </span>
                <input type="text"
                       class="form-control bg-transparent text-light border-secondary"
                       placeholder="Ürün adı, marka, SKU, barkod veya açıklama ara…"
                       value="@_searchTerm"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSearch">
                        <i class="fa fa-times"></i>
                    </button>
                }
            </div>

            @* Sıralama — Revize: Mobil-dostu custom dropdown (Madde 7) *@
            <div class="custom-sort-dropdown position-relative" @onfocusout="() => _sortDropdownOpen = false">
                <button class="btn btn-sm bg-dark text-light border-secondary d-flex align-items-center gap-2"
                        style="min-width:160px;"
                        @onclick="() => _sortDropdownOpen = !_sortDropdownOpen">
                    <i class="fa fa-sort text-info" style="font-size:.75rem;"></i>
                    <span class="flex-fill text-start small">@GetSortLabel(_sortOrder)</span>
                    <i class="fa fa-chevron-down text- light" style="font-size:.6rem;"></i>
                </button>
                @if (_sortDropdownOpen)
                {
                    <div class="custom-sort-menu">
                        @foreach (var opt in _sortOptions)
                        {
                            var o = opt;
                            <button class="custom-sort-item @(o.Value == _sortOrder ? "active" : "")"
                                    @onclick="() => SelectSortOption(o.Value)">
                                <i class="fa @o.Icon text-info me-2" style="font-size:.7rem; width:14px;"></i>
                                @o.Label
                            </button>
                        }
                    </div>
                }
            </div>

            @* Sonuç bilgisi *@
            <span class="text-light small ms-auto d-none d-md-inline">
                <i class="fa fa-cubes me-1"></i>@_totalCount ürün
                @if (_isLoading)
                {
                    <i class="fa fa-spinner fa-spin ms-1 text-info"></i>
                }
            </span>

            @* Görünüm (masaüstü) *@
            <div class="btn-group btn-group-sm d-none d-lg-flex">
                <button class="btn @(_viewMode == ViewMode.Grid ? "btn-info" : "btn-outline-secondary")"
                        @onclick="() => _viewMode = ViewMode.Grid" title="Izgara">
                    <i class="fa fa-th"></i>
                </button>
                <button class="btn @(_viewMode == ViewMode.List ? "btn-info" : "btn-outline-secondary")"
                        @onclick="() => _viewMode = ViewMode.List" title="Liste">
                    <i class="fa fa-th-list"></i>
                </button>
            </div>
        </div>

        @* ─── Aktif Filtre Etiketleri ─── *@
        @if (HasActiveFilter())
        {
            <div class="d-flex flex-wrap gap-1 mb-3">
                @if (_selectedCategory != null)
                {
                    <span class="badge bg-info bg-opacity-25 text-info border border-info">
                        <i class="fa fa-folder-open me-1"></i>@_selectedCategory.Name
                        <button class="btn-close btn-close-white ms-1" style="font-size:.55rem;"
                                @onclick="() => { _selectedCategory = null; _ = ResetAndReload(); }"></button>
                    </span>
                }
                @if (_filterMinPrice.HasValue || _filterMaxPrice.HasValue)
                {
                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning">
                        <i class="fa fa-try me-1"></i>
                        @(_filterMinPrice?.ToString("N0") ?? "0") — @(_filterMaxPrice?.ToString("N0") ?? "∞") ₺
                        <button class="btn-close btn-close-white ms-1" style="font-size:.55rem;"
                                @onclick="() => { _filterMinPrice = null; _filterMaxPrice = null; _ = ResetAndReload(); }"></button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(_filterBrand))
                {
                    <span class="badge bg-secondary bg-opacity-50 text-light border border-secondary">
                        <i class="fa fa-bookmark me-1"></i>@_filterBrand
                        <button class="btn-close btn-close-white ms-1" style="font-size:.55rem;"
                                @onclick="() => { _filterBrand = null; _ = ResetAndReload(); }"></button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(_searchTerm))
                {
                    <span class="badge bg-light bg-opacity-10 text-light border border-secondary">
                        <i class="fa fa-search me-1"></i>"@_searchTerm"
                        <button class="btn-close btn-close-white ms-1" style="font-size:.55rem;"
                                @onclick="ClearSearch"></button>
                    </span>
                }
                <button class="btn btn-outline-danger btn-sm" @onclick="ClearAllFilters">
                    <i class="fa fa-times me-1"></i>Tümünü Temizle
                </button>
            </div>
        }

        @* ─── ÜRÜN GRID ─── *@
        @if (!_products.Any() && !_isLoading)
        {
            <div class="text-center py-5 text-light">
                <i class="fa fa-search fa-3x mb-3 d-block text- light"></i>
                <h5 class="mb-2">Ürün bulunamadı</h5>
                <p class="text- light small mb-3">Arama veya filtre kriterlerinize uygun ürün bulunamadı.</p>
                @if (HasActiveFilter())
                {
                    <button class="btn btn-outline-info btn-sm" @onclick="ClearAllFilters">
                        <i class="fa fa-refresh me-1"></i>Filtreleri Temizle
                    </button>
                }
            </div>
        }
        else
        {
            @if (_viewMode == ViewMode.Grid)
            {
                <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
                    @foreach (var product in _products)
                    {
                        <div class="col">
                            @ProductCardGrid(product)
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var product in _products)
                    {
                        @ProductCardList(product)
                    }
                </div>
            }
        }

        @* ─── Yükleniyor göstergesi ─── *@
        @if (_isLoading)
        {
            <div class="text-center py-4">
                <div class="d-flex align-items-center justify-content-center gap-2 text-info">
                    <i class="fa fa-spinner fa-spin fa-lg"></i>
                    <span class="small">Ürünler yükleniyor…</span>
                </div>
            </div>
        }

        @* ─── Infinite Scroll Sentinel ─── *@
        @if (_hasMore && !_isLoading)
        {
            <div id="scrollSentinel" class="py-2"></div>
        }

        @* ─── Tüm ürünler yüklendi ─── *@
        @if (!_hasMore && _products.Any())
        {
            <div class="text-center py-3">
                <small class="text- light">
                    <i class="fa fa-check-circle me-1"></i>Tüm ürünler gösterildi (@_products.Count / @_totalCount)
                </small>
            </div>
        }
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   MOBİL FİLTRE OFFCANVAS
   ═══════════════════════════════════════════════════════════════ *@
@if (_mobileFilterOpen)
{
    <div class="offcanvas-backdrop show" @onclick="() => _mobileFilterOpen = false"></div>
    <div class="offcanvas offcanvas-start show" style="width:85%; max-width:360px; background:var(--bs-dark);">
        <div class="offcanvas-header border-bottom border-secondary py-2">
            <h6 class="offcanvas-title text-light mb-0">
                <i class="fa fa-sliders me-2"></i>Filtreler
            </h6>
            <button class="btn-close btn-close-white" @onclick="() => _mobileFilterOpen = false"></button>
        </div>
        <div class="offcanvas-body p-2">
            @FilterPanelContent()
        </div>
        <div class="offcanvas-footer border-top border-secondary p-2">
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm flex-fill" @onclick="ClearAllFilters">
                    <i class="fa fa-eraser me-1"></i>Temizle
                </button>
                <button class="btn btn-info btn-sm flex-fill" @onclick="() => _mobileFilterOpen = false">
                    <i class="fa fa-check me-1"></i>Uygula (@_totalCount ürün)
                </button>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   HIZLI BAKIŞ (QUICK VIEW) MODALI — Madde 5: Sepete Ekle + Hızlı Al butonları eklendi
   ═══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="QuickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border border-info"
             style="background:rgba(20,20,30,0.75); backdrop-filter:blur(12px); box-shadow:0 0 40px rgba(13,202,240,0.15);">
            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-info mb-0">
                    <i class="fa fa-eye me-1"></i>Hızlı Bakış
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size:.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width:1px; opacity:.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2"
                            data-bs-dismiss="modal" title="Kapat">
                        <i class="fa fa-times" style="font-size:.95rem;"></i>
                    </button>
                </div>
            </div>
            <div class="modal-body p-3">
                @if (_quickViewProduct != null)
                {
                    var qp = _quickViewProduct;
                    <div class="row g-3">
                        @* Sol: Görsel Galeri *@
                        <div class="col-md-6">
                            <div class="position-relative rounded-3 overflow-hidden bg-black"
                                 style="aspect-ratio:1;">
                                @if (qp.ImageUrls.Any())
                                {
                                    <img src="@qp.ImageUrls[_quickViewImageIndex]"
                                         alt="@qp.Name"
                                         class="w-100 h-100"
                                         style="object-fit:contain;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text- light">
                                        <i class="fa fa-picture-o fa-3x"></i>
                                    </div>
                                }
                            </div>
                            @if (qp.ImageUrls.Count > 1)
                            {
                                <div class="d-flex gap-2 mt-2 overflow-auto pb-1">
                                    @for (int i = 0; i < qp.ImageUrls.Count; i++)
                                    {
                                        var idx = i;
                                        <div class="rounded border @(idx == _quickViewImageIndex ? "border-info" : "border-secondary") overflow-hidden flex-shrink-0"
                                             style="width:56px; height:56px; cursor:pointer; opacity:@(idx == _quickViewImageIndex ? "1" : "0.6");"
                                             @onclick="() => _quickViewImageIndex = idx">
                                            <img src="@qp.ImageUrls[idx]" alt="" class="w-100 h-100" style="object-fit:cover;" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @* Sağ: Ürün Bilgileri *@
                        <div class="col-md-6">

                            @* Mağaza *@
                            @if (!string.IsNullOrEmpty(qp.StoreName))
                            {
                                <div class="d-flex align-items-center gap-2 mb-3 p-2 rounded border border-secondary bg-dark bg-opacity-50">
                                    <i class="fa fa-building text-info"></i>
                                    <button class="btn btn-link btn-sm text-info text-decoration-none p-0"
                                            @onclick="() => OpenStoreModal(qp.StoreId)">
                                        @(qp.StoreName?.Length > 16 ? qp.StoreName.Substring(0, 16) + "..." : qp.StoreName)
                                    </button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(qp.BrandName))
                            {
                                <span class="badge bg-secondary bg-opacity-50 small mb-2">@qp.BrandName</span>
                            }
                            <h5 class="text-light mb-2 lh-sm">@qp.Name</h5>
                            <hr />
                            @* Kısa Açıklama *@
                            @if (!string.IsNullOrWhiteSpace(qp.ShortDescription))
                            {
                                <div class="mb-3">
                                    <p class="text-light small mb-0 lh-base" style="max-height:8rem; overflow-y:auto;">
                                        @qp.ShortDescription
                                    </p>
                                </div>
                            }

                            @* SKU / Barkod *@
                            <div class="d-flex gap-3 text- light small mb-3">
                                @if (!string.IsNullOrEmpty(qp.Sku))
                                {
                                    <span><i class="fa fa-tag me-1"></i>SKU: @qp.Sku</span>
                                }
                                @if (!string.IsNullOrEmpty(qp.Barcode))
                                {
                                    <span><i class="fa fa-barcode me-1"></i>@qp.Barcode</span>
                                }
                            </div>

                            @* Beğeni + Görüntülenme *@
                            <div class="d-flex align-items-center gap-3 mb-3 text- light small">
                                <span><i class="fa fa-heart text-danger me-1"></i>@qp.LikeCount beğeni</span>
                                <span><i class="fa fa-eye me-1"></i>@qp.ViewCount görüntülenme</span>
                            </div>

                            @* Fiyat *@
                            <div class="mb-3">
                                @if (qp.DiscountedPrice.HasValue && qp.DiscountedPrice < qp.Price)
                                {
                                    var discountPercent = qp.Price > 0
                                        ? (int)Math.Round(100 - (qp.DiscountedPrice.Value / qp.Price.Value * 100))
                                        : 0;
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fs-4 fw-bold text-info">
                                            @qp.DiscountedPrice?.ToString("N2") @CurrencySymbol(qp.Currency)
                                        </span>
                                        <del class="text- light">@qp.Price?.ToString("N2") @CurrencySymbol(qp.Currency)</del>
                                        <span class="badge bg-danger">%@discountPercent</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="fs-4 fw-bold text-info">
                                        @qp.Price?.ToString("N2") @CurrencySymbol(qp.Currency)
                                    </span>
                                }
                            </div>

                        </div>

                        @* Aksiyon Butonları — Madde 5: Sepete Ekle + Hızlı Al eklendi *@
                        <div class="col-12">
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-info btn-sm flex-fill"
                                        @onclick="() => OnAddToCart(qp.Id)">
                                    <i class="fa fa-shopping-cart me-1"></i>Sepete Ekle
                                </button>
                                <button class="btn btn-success btn-sm flex-fill"
                                        @onclick="() => OnQuickBuy(qp.Id)">
                                    <i class="fa fa-bolt me-1"></i>Hızlı Al
                                </button>
                            </div>
                            <div class="d-flex gap-2 flex-wrap mt-2">
                                <a href="/Public/_Viewer/ProductProfile/@qp.Slug"
                                   class="btn btn-outline-info btn-sm flex-fill">
                                    <i class="fa fa-external-link me-1"></i>Ürüne Git
                                </a>
                                <button class="btn btn-outline-danger btn-sm" title="Favorilere Ekle"
                                        @onclick="() => ToggleFavorite(qp.Id)">
                                    <i class="fa @(_likedProductIds.Contains(qp.Id) ? "fa-heart" : "fa-heart-o")"></i>
                                </button>
                                <button class="btn btn-outline-warning btn-sm" title="Karşılaştır"
                                        @onclick="() => ToggleCompare(qp.Id)">
                                    <i class="fa fa-exchange"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   MAĞAZA DETAY MODALI — Madde 3: Harita ve Yol Tarifi düzeltildi
   ═══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="StoreDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-info"
             style="box-shadow:0 0 8px rgba(13,202,240,0.35);">
            <div class="modal-header border-bottom border-info py-2">
                <h6 class="modal-title text-info mb-0">
                    <i class="fa fa-building me-1"></i>Mağaza Bilgileri
                </h6>
                <div class="btn-group shadow-sm border border-secondary rounded" role="group">
                    <button type="button" class="btn btn-sm text-light border-0 py-1 px-2"
                            onclick="toggleModalFullscreen(this)" title="Tam Ekran">
                        <i class="fa fa-expand" style="font-size:.85rem;"></i>
                    </button>
                    <div class="border-start border-secondary my-1" style="width:1px; opacity:.5;"></div>
                    <button type="button" class="btn btn-sm text-danger border-0 py-1 px-2"
                            data-bs-dismiss="modal" title="Kapat">
                        <i class="fa fa-times" style="font-size:.95rem;"></i>
                    </button>
                </div>
            </div>
            <div class="modal-body p-3">
                @if (_storeDetail != null)
                {
                    var st = _storeDetail;
                    <div class="row g-3">
                        @* Mağaza Profili *@
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(_storeProfileUrl))
                                {
                                    <img src="@_storeProfileUrl" alt="@st.Name"
                                         class="rounded-circle border border-info"
                                         style="width:64px; height:64px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-info bg-opacity-25 d-flex align-items-center justify-content-center"
                                         style="width:64px; height:64px;">
                                        <i class="fa fa-building fa-2x text-info"></i>
                                    </div>
                                }
                                <div>
                                    <h5 class="text-light mb-1">@st.Name</h5>
                                    @if (!string.IsNullOrEmpty(st.Description))
                                    {
                                        <p class="text- light small mb-0">@st.Description</p>
                                    }
                                </div>
                            </div>
                        </div>

                        @* İletişim *@
                        @if (st.ContactInformation != null)
                        {
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small mb-0">
                                    <i class="fa fa-phone me-1"></i>Telefon
                                </label>
                                <div class="text-light">
                                    @(string.IsNullOrEmpty(st.ContactInformation.FullPhoneNumber) ? "—" : st.ContactInformation.FullPhoneNumber)
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small mb-0">
                                    <i class="fa fa-envelope me-1"></i>E-posta
                                </label>
                                <div class="text-light">
                                    @(string.IsNullOrEmpty(st.ContactInformation.Email) ? "—" : st.ContactInformation.Email)
                                </div>
                            </div>
                        }

                        @* Adres *@
                        @if (st.AddressInfo != null)
                        {
                            <div class="col-12">
                                <label class="form-label text-white-50 small mb-1">
                                    <i class="fa fa-map-marker me-1"></i>Adres
                                </label>
                                <div class="text-light small">
                                    @st.AddressInfo.Address,
                                    @st.AddressInfo.City / @st.AddressInfo.State / @st.AddressInfo.Country
                                    @if (!string.IsNullOrEmpty(st.AddressInfo.ZipCode))
                                    {
                                        <span class="text- light"> — @st.AddressInfo.ZipCode</span>
                                    }
                                </div>
                            </div>
                        }

                        @* Harita — Madde 3: Düzeltildi *@
                        @if (st.AddressInfo?.Latitude != null && st.AddressInfo?.Longitude != null)
                        {
                            <div class="col-12">
                                <div id="storeMap" class="rounded-3 border border-secondary"
                                     style="height:280px; width:100%;"></div>
                                <div class="d-flex gap-2 mt-2">
                                    @{
                                        var lat = st.AddressInfo.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                        var lng = st.AddressInfo.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    }
                                    <a href="https://www.google.com/maps/dir/?api=1&destination=@(lat),@(lng)"
                                       target="_blank" rel="noopener"
                                       class="btn btn-outline-info btn-sm">
                                        <i class="fa fa-location-arrow me-1"></i>Yol Tarifi Al
                                    </a>
                                    <a href="https://www.google.com/maps/search/?api=1&query=@(lat),@(lng)"
                                       target="_blank" rel="noopener"
                                       class="btn btn-light btn-sm">
                                        <i class="fa fa-map me-1"></i>Haritada Gör
                                    </a>
                                    @if (!string.IsNullOrEmpty(st.AddressInfo.GoogleMyBusinessAccountLink))
                                    {
                                        <a href="@st.AddressInfo.GoogleMyBusinessAccountLink"
                                           target="_blank" rel="noopener"
                                           class="btn btn-outline-secondary btn-sm">
                                            <i class="fa fa-google me-1"></i>Google İşletme
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_storeLoading)
                {
                    <div class="text-center py-4">
                        <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
                    </div>
                }
            </div>
            <div class="modal-footer border-top border-info py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left me-1"></i>Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   PAYLAŞ MODALI
   ═══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="ShareModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content bg-dark border border-secondary">
            <div class="modal-header border-bottom border-secondary py-2">
                <h6 class="modal-title text-light mb-0">
                    <i class="fa fa-share-alt me-1"></i>Paylaş
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                @if (_shareProduct != null)
                {
                    var shareUrl = $"{NavigationManager.BaseUri}Public/_Viewer/ProductProfile/{_shareProduct.Slug}";
                    <div class="d-flex justify-content-center gap-3 mb-3">
                        <a href="https://api.whatsapp.com/send?text=@Uri.EscapeDataString(shareUrl)"
                           target="_blank" rel="noopener"
                           class="btn btn-outline-success btn-lg rounded-circle" style="width:52px; height:52px;"
                           title="WhatsApp">
                            <i class="fa fa-whatsapp"></i>
                        </a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(shareUrl)"
                           target="_blank" rel="noopener"
                           class="btn btn-outline-primary btn-lg rounded-circle" style="width:52px; height:52px;"
                           title="Facebook">
                            <i class="fa fa-facebook"></i>
                        </a>
                        <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(shareUrl)"
                           target="_blank" rel="noopener"
                           class="btn btn-outline-info btn-lg rounded-circle" style="width:52px; height:52px;"
                           title="X (Twitter)">
                            <i class="fa fa-twitter"></i>
                        </a>
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control bg-transparent text-light border-secondary"
                               value="@shareUrl" readonly />
                        <button class="btn btn-outline-info" @onclick="() => CopyToClipboard(shareUrl)" title="Kopyala">
                            <i class="fa fa-copy"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   KARŞILAŞTIRMA ÇUBUĞU (sabit alt bar) — Madde 8: Yapı korundu
   ═══════════════════════════════════════════════════════════════ *@
@if (_compareProductIds.Any())
{
    <div class="compare-bar">
        <div class="container-fluid">
            <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-exchange text-warning"></i>
                    <span class="text-light small fw-semibold">Karşılaştırma: @_compareProductIds.Count ürün</span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _compareProductIds.Clear()">
                        <i class="fa fa-times me-1"></i>Temizle
                    </button>
                    <button class="btn btn-warning btn-sm" disabled="@(_compareProductIds.Count < 2)">
                        <i class="fa fa-exchange me-1"></i>Karşılaştır
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   RENDER FRAGMENTS
   ═══════════════════════════════════════════════════════════════ *@

@* ─── FİLTRE PANELİ İÇERİĞİ ─── *@
@{
    RenderFragment FilterPanelContent() => @<div class="filter-inner">

        @* — Kategori Ağacı — *@
        <div class="filter-section mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2 cursor-pointer"
                 @onclick="() => _categoryPanelOpen = !_categoryPanelOpen">
                <span class="fw-semibold text-light small">
                    <i class="fa fa-folder-open me-1 text-info"></i>Kategoriler
                </span>
                <i class="fa fa-chevron-@(_categoryPanelOpen ? "up" : "down") text- light small"></i>
            </div>
            @if (_categoryPanelOpen)
            {
                <div class="mb-2">
                    <input type="text"
                           class="form-control form-control-sm bg-transparent text-light border-secondary"
                           placeholder="Kategori ara…"
                           value="@_categorySearchTerm"
                           @oninput="OnCategorySearch" />
                </div>
                <div style="max-height:280px; overflow-y:auto;" class="pe-1 category-tree">
                    @if (_categoryTree != null && _categoryTree.Any())
                    {
                        @foreach (var node in _categoryTree)
                        {
                            @CategoryNode(node, 0)
                        }
                    }
                    else
                    {
                        <small class="text- light">Kategori bulunamadı</small>
                    }
                </div>
            }
        </div>

        @* — Fiyat Aralığı — *@
        <div class="filter-section mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2 cursor-pointer"
                 @onclick="() => _pricePanelOpen = !_pricePanelOpen">
                <span class="fw-semibold text-light small">
                    <i class="fa fa-try me-1 text-info"></i>Fiyat Aralığı
                </span>
                <i class="fa fa-chevron-@(_pricePanelOpen ? "up" : "down") text- light small"></i>
            </div>
            @if (_pricePanelOpen)
            {
                <div class="d-flex gap-2 align-items-center">
                    <input type="number" class="form-control form-control-sm bg-transparent text-light border-secondary"
                           placeholder="Min" value="@_filterMinPrice"
                           @onchange="e => { _filterMinPrice = ParseDecimal(e); }" />
                    <span class="text- light">—</span>
                    <input type="number" class="form-control form-control-sm bg-transparent text-light border-secondary"
                           placeholder="Max" value="@_filterMaxPrice"
                           @onchange="e => { _filterMaxPrice = ParseDecimal(e); }" />
                </div>
                <button class="btn btn-outline-info btn-sm w-100 mt-2" @onclick="() => _ = ResetAndReload()">
                    <i class="fa fa-check me-1"></i>Uygula
                </button>
            }
        </div>

        @* — Marka Filtresi — Madde 1: Debounce 500ms, 3+ karakter arama *@
        <div class="filter-section mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2 cursor-pointer"
                 @onclick="() => _brandPanelOpen = !_brandPanelOpen">
                <span class="fw-semibold text-light small">
                    <i class="fa fa-bookmark me-1 text-info"></i>Marka
                </span>
                <i class="fa fa-chevron-@(_brandPanelOpen ? "up" : "down") text- light small"></i>
            </div>
            @if (_brandPanelOpen)
            {
                <div class="position-relative mb-2">
                    <input type="text"
                           class="form-control form-control-sm bg-transparent text-light border-secondary"
                           placeholder="Marka ara (min 3 karakter)…"
                           value="@_brandSearchTerm"
                           @oninput="OnBrandSearchInput" />
                    @if (_brandSearching)
                    {
                        <div class="position-absolute" style="right:8px; top:50%; transform:translateY(-50%);">
                            <i class="fa fa-spinner fa-spin text-info" style="font-size:.7rem;"></i>
                        </div>
                    }
                </div>
                <div style="max-height:200px; overflow-y:auto;" class="pe-1">
                    @{
                        var filteredBrands = _displayBrands;
                    }
                    @foreach (var brand in filteredBrands)
                    {
                        var b = brand;
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="radio" name="brandFilter"
                                   id="@($"brand_{b.Id}")"
                                   checked="@(_filterBrand == b.Name)"
                                   @onchange="() => { _filterBrand = b.Name; _ = ResetAndReload(); }" />
                            <label class="form-check-label text-light small"
                                   for="@($"brand_{b.Id}")">@b.Name</label>
                        </div>
                    }
                    @if (!filteredBrands.Any())
                    {
                        <small class="text- light">
                            @((_brandSearchTerm?.Length ?? 0) > 0 && (_brandSearchTerm?.Length ?? 0) < 3
                                ? "En az 3 karakter girin…"
                                : "Marka bulunamadı")
                        </small>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_filterBrand))
                {
                    <button class="btn btn-link btn-sm text- light p-0 mt-1"
                            @onclick="() => { _filterBrand = null; _ = ResetAndReload(); }">
                        <i class="fa fa-times me-1"></i>Temizle
                    </button>
                }
            }
        </div>
    </div>;
}

@* ─── KATEGORİ DÜĞÜMÜ (Recursive) ─── *@
@{
    RenderFragment CategoryNode(CategoryTreeNode node, int depth) => @<text>
        @{
            var isSelected = _selectedCategory?.Id == node.Id;
            var hasChildren = node.Children.Any();
            var isExpanded = _expandedCategoryIds.Contains(node.Id);
            var isVisible = string.IsNullOrEmpty(_categorySearchTerm) ||
                            (node.Name ?? "").Contains(_categorySearchTerm, StringComparison.OrdinalIgnoreCase) ||
                            node.Children.Any(c => MatchesCategorySearch(c));

            if (!isVisible) return;
        }
        <div style="padding-left:@(depth * 14)px;">
            <div class="d-flex align-items-center gap-1 py-1 rounded category-item @(isSelected ? "category-active" : "")">
                @if (hasChildren)
                {
                    <button class="btn btn-sm p-0 text- light border-0" style="width:18px; font-size:.7rem;"
                            @onclick:stopPropagation
                            @onclick="() => ToggleCategoryExpand(node.Id)">
                        <i class="fa fa-caret-@(isExpanded ? "down" : "right")"></i>
                    </button>
                }
                else
                {
                    <span style="width:18px;"></span>
                }
                <button class="btn btn-sm p-0 text-start text-light border-0 flex-fill text-truncate small"
                        @onclick="() => SelectCategory(node)"
                        title="@node.Name">
                    @node.Name
                </button>
                @if (node.ProductCount > 0)
                {
                    <span class="badge bg-secondary bg-opacity-50 small" style="font-size:.65rem;">@node.ProductCount</span>
                }
            </div>
            @if (hasChildren && isExpanded)
            {
                @foreach (var child in node.Children)
                {
                    @CategoryNode(child, depth + 1)
                }
            }
        </div>
    </text>;
}

@* ─── ÜRÜN KARTI (GRID modu) — Madde 4,6,9,10: Butonlar, actions görünür, favori, slug düzeltmesi ─── *@
@{
    RenderFragment ProductCardGrid(ProductCardDto p) => @<div class="product-card h-100 d-flex flex-column">
        @{
            var imgCount = Math.Min(p.ImageUrls.Count, 4);
            var hasGallery = imgCount > 1;
        }
        @if (!string.IsNullOrEmpty(p.StoreName))
        {
            <div class="mt-1">
                <center>
                    <button class="btn btn-sm p-0 text-light store-link"
                            @onclick:stopPropagation @onclick="() => OpenStoreModal(p.StoreId)"
                            title="Mağaza detayları">
                        <i class="fa fa-shopping-bag me-1" style="font-size:.65rem;"></i>
                        <span style="font-size:.72rem;">
                            @(p.StoreName?.Length > 16 ? p.StoreName.Substring(0, 16) + "..." : p.StoreName)
                        </span>
                    </button>
                </center>
            </div>
        }
        @* Görsel Alanı — Hover Galeri *@
        <div class="text-decoration-none">
            <div class="product-media position-relative overflow-hidden rounded-top-3">
                <a href="/Public/_Viewer/ProductProfile/@p.Slug">
                    @for (int i = 0; i < Math.Max(1, imgCount); i++)
                    {
                        var imgIdx = i;
                        var imgUrl = i < p.ImageUrls.Count ? p.ImageUrls[i] : null;
                        <div class="gallery-img @(imgIdx == 0 ? "gallery-img-active" : "")" data-idx="@imgIdx">
                            @if (!string.IsNullOrEmpty(imgUrl))
                            {
                                <img src="@imgUrl" alt="@p.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 bg-dark text- light">
                                    <i class="fa fa-picture-o fa-2x"></i>
                                </div>
                            }
                        </div>
                    }

                    @if (hasGallery)
                    {
                        <div class="gallery-zones">
                            @for (int z = 0; z < imgCount; z++)
                            {
                                <div class="gallery-zone" data-zone="@z"
                                     style="left:@(z * (100.0 / imgCount))%; width:@(100.0 / imgCount)%;"></div>
                            }
                        </div>
                        <div class="gallery-dots">
                            @for (int d = 0; d < imgCount; d++)
                            {
                                <span class="gallery-dot @(d == 0 ? "active" : "")" data-dot="@d"></span>
                            }
                        </div>
                    }
                </a>
                @* Aksiyon Butonları — Madde 6: Hep görünür, Madde 9: Favorilere Ekle *@
                <div class="product-actions">
                    <button class="action-btn @(_likedProductIds.Contains(p.Id) ? "liked" : "")"
                            title="Favorilere Ekle" @onclick:stopPropagation @onclick:preventDefault
                            @onclick="() => ToggleFavorite(p.Id)">
                        <i class="fa @(_likedProductIds.Contains(p.Id) ? "fa-heart" : "fa-heart-o")"></i>
                    </button>
                    <button class="action-btn @(_compareProductIds.Contains(p.Id) ? "compared" : "")"
                            title="Karşılaştır" @onclick:stopPropagation @onclick:preventDefault
                            @onclick="() => ToggleCompare(p.Id)">
                        <i class="fa fa-exchange"></i>
                    </button>
                    <button class="action-btn" title="Hızlı Bakış"
                            @onclick:stopPropagation @onclick:preventDefault
                            @onclick="() => OpenQuickView(p)">
                        <i class="fa fa-eye"></i>
                    </button>
                    <button class="action-btn" title="Paylaş"
                            @onclick:stopPropagation @onclick:preventDefault
                            @onclick="() => OpenShareModal(p)">
                        <i class="fa fa-share-alt"></i>
                    </button>
                </div>

                @if (p.DiscountedPrice.HasValue && p.Price.HasValue && p.DiscountedPrice < p.Price && p.Price > 0)
                {
                    var disc = (int)Math.Round(100 - (p.DiscountedPrice.Value / p.Price.Value * 100));
                    <span class="discount-badge">%@disc</span>
                }
            </div>
        </div>

        @* Bilgi Alanı — Madde 10: Slug düzeltmesi *@
        <div class="product-info p-2 flex-fill d-flex flex-column">
            @if (!string.IsNullOrEmpty(p.BrandName))
            {
                <div class="text- light small text-truncate mb-1" style="font-size:.7rem; letter-spacing:.03em;">
                    @p.BrandName.ToUpperInvariant()
                </div>
            }

            <a href="/Public/_Viewer/ProductProfile/@p.Slug"
               class="product-name" title="@p.Name">@p.Name</a>

            @* Beğeni *@
            <div class="d-flex align-items-center gap-1 mt-1">
                <i class="fa fa-heart-o text-danger" style="font-size:.6rem;"></i>
                <span class="text-danger" style="font-size:.7rem;">@p.LikeCount</span>
                <i class="fa fa-eye text-light ms-1" style="font-size:.6rem;"></i>
                <span class="text-light" style="font-size:.7rem;">@p.ViewCount</span>
            </div>

            @* Fiyat *@
            <div class="mt-2">
                @if (p.DiscountedPrice.HasValue && p.DiscountedPrice < p.Price)
                {
                    <div class="d-flex align-items-baseline gap-1 flex-wrap">
                        <span class="product-price-current">@p.DiscountedPrice?.ToString("N2") @CurrencySymbol(p.Currency)</span>
                        <del class="product-price-old">@p.Price?.ToString("N2") @CurrencySymbol(p.Currency)</del>
                    </div>
                }
                else
                {
                    <span class="product-price-current">@p.Price?.ToString("N2") @CurrencySymbol(p.Currency)</span>
                }
            </div>

            @* Madde 4: Sepete Ekle + Hızlı Al butonları *@
            <div class="mt-auto pt-2 d-flex gap-1">
                <button class="btn btn-info btn-sm flex-fill card-action-btn"
                        @onclick:stopPropagation @onclick="() => OnAddToCart(p.Id)">
                    <i class="fa fa-shopping-cart me-1"></i><span class="d-none d-sm-inline">Sepete Ekle</span><span class="d-sm-none">Sepet</span>
                </button>
                <button class="btn btn-success btn-sm card-action-btn"
                        @onclick:stopPropagation @onclick="() => OnQuickBuy(p.Id)">
                    <i class="fa fa-bolt" style="margin-left:5px;"></i>
                </button>
            </div>
        </div>
    </div>;
}

@* ─── ÜRÜN KARTI (LİSTE modu) — Madde 4,9,10: Butonlar, favori, slug düzeltmesi ─── *@
@{
    RenderFragment ProductCardList(ProductCardDto p) => @<div class="product-card-list d-flex rounded-3 overflow-hidden">
        <a href="/Public/_Viewer/ProductProfile/@p.Slug" class="flex-shrink-0 position-relative text-decoration-none" style="width:160px; min-height:160px;">
