    private async Task ResetAndReload()
    {
        _products.Clear();
        _loadedProductIds.Clear();
        _loadedBatches = 0;
        _hasMore = true;
        _totalCount = 0;
        await LoadProductsAsync();
    }

    private async Task ClearAllFilters()
    {
        _selectedCategory = null; _filterMinPrice = null; _filterMaxPrice = null;
        _filterBrand = null; _searchTerm = string.Empty;
        await ResetAndReload();
    }

    private bool HasActiveFilter() =>
        _selectedCategory != null || _filterMinPrice.HasValue || _filterMaxPrice.HasValue ||
        !string.IsNullOrEmpty(_filterBrand) || !string.IsNullOrEmpty(_searchTerm);

    private int ActiveFilterCount()
    {
        int c = 0;
        if (_selectedCategory != null) c++;
        if (_filterMinPrice.HasValue || _filterMaxPrice.HasValue) c++;
        if (!string.IsNullOrEmpty(_filterBrand)) c++;
        if (!string.IsNullOrEmpty(_searchTerm)) c++;
        return c;
    }

