        new("price_desc", "Fiyat: Yüksekten Düşüğe","fa-sort-amount-desc"),
        new("popular",    "En Popüler",             "fa-fire"),
        new("most_liked", "En Beğenilen",           "fa-heart"),
        new("name_asc",   "A-Z",                    "fa-sort-alpha-asc"),
        new("name_desc",  "Z-A",                    "fa-sort-alpha-desc")
    };

    // ─── Ürün Verileri ──────────────────────────────────────────
    private List<ProductCardDto> _products = new();
    private int _totalCount;
    private int _loadedBatches;
    private bool _hasMore = true;
    private HashSet<Guid> _loadedProductIds = new(); // Madde 2+11: Çift yükleme önleme

    // ─── Filtreler ──────────────────────────────────────────────
    private CategoriesTr? _selectedCategory;
    private decimal? _filterMinPrice;
    private decimal? _filterMaxPrice;
    private string? _filterBrand;

    // ─── Filtre Panel Durumları ──────────────────────────────────
    private bool _categoryPanelOpen = true;
    private bool _pricePanelOpen = true;
    private bool _brandPanelOpen = true;

    // ─── Kategori Ağacı ─────────────────────────────────────────
    private List<CategoryTreeNode> _categoryTree = new();
    private List<CategoriesTr> _allCategories = new();
    private Dictionary<int, int> _categoryProductCounts = new();
    private HashSet<int> _expandedCategoryIds = new();
    private string _categorySearchTerm = string.Empty;

    // ─── Marka Listesi — Madde 1: Rastgele 100 + debounce arama ─
    private List<BrandDto> _allBrandsCache = new(); // Veritabanından çekilen tam liste (arama için)
    private List<BrandDto> _displayBrands = new();  // Ekranda gösterilen markalar
    private string _brandSearchTerm = string.Empty;
    private bool _brandSearching;

    // ─── Beğeni / Karşılaştırma ──────────────────────────────────
    private HashSet<Guid> _likedProductIds = new();
    private HashSet<Guid> _compareProductIds = new();

    // ─── Hızlı Bakış ────────────────────────────────────────────
    private ProductCardDto? _quickViewProduct;
    private int _quickViewImageIndex;

    // ─── Paylaş ──────────────────────────────────────────────────
    private ProductCardDto? _shareProduct;

    // ─── Mağaza Detay ────────────────────────────────────────────
    private Store? _storeDetail;
    private string? _storeProfileUrl;
    private bool _storeLoading;

    // ─── JS Referansı ────────────────────────────────────────────
    private DotNetObjectReference<ProductListing>? _dotNetRef;

    // ═══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ — Madde 11: Çift yükleme düzeltildi
    // ═══════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;

        StateHub.OnDataChanged += HandleDataChanged;

        await LoadCategoriesAsync();
        await LoadBrandsAsync();
        await LoadProductsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ProductListingInterop.init", _dotNetRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;

        try { await JS.InvokeVoidAsync("ProductListingInterop.dispose"); } catch { }

        _dotNetRef?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        _searchCts?.Dispose();
        _brandSearchCts?.Dispose();
        _loadSemaphore.Dispose();

        GC.SuppressFinalize(this);
    }

    // ═══════════════════════════════════════════════════════════════
    // GLOBAL OLAY
    // ═══════════════════════════════════════════════════════════════

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || !_isInitialized) return;
        if (entityName != ENTITY_NAME && entityName != "Store" && entityName != "CategoriesTr" && entityName != "Brands") return;

        await InvokeAsync(async () =>
        {
            if (entityName == "CategoriesTr") await LoadCategoriesAsync();
            if (entityName == "Brands") await LoadBrandsAsync();
            await ResetAndReload();
            StateHasChanged();
        });
    }

    // ═══════════════════════════════════════════════════════════════
    // ÜRÜN YÜKLEME — Madde 2+11: Rastgele 24 ürün, çift yükleme yok
    // ═══════════════════════════════════════════════════════════════

    private async Task LoadProductsAsync(bool isNextBatch = false)
    {
        if (!await _loadSemaphore.WaitAsync(0)) return;
        try
        {
            _isLoading = true;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var token = _cts.Token;

            var query = db.Set<Products>().AsNoTracking()
                .Where(p => p.IsDeleted.IsDeletedStatu != true)
                .Where(p => p.IsActive);

            // Madde 2+11: Önceden yüklenmiş ürünleri hariç tut
            if (_loadedProductIds.Any())
            {
                var excludeIds = _loadedProductIds.ToList();
                query = query.Where(p => !excludeIds.Contains(p.Id));
            }

            var search = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();
            if (search != null)
            {
                var matchingBrandIds = await db.Set<Brands>().AsNoTracking()
                    .Where(b => b.Name != null && b.Name.Contains(search))
                    .Where(b => b.IsDeleted.IsDeletedStatu != true)
                    .Select(b => b.Id)
                    .ToListAsync(token);

                var matchingVariantProductIds = await db.Set<ProductVariants>().AsNoTracking()
                    .Where(v => (v.Sku != null && v.Sku.Contains(search)) ||
                                (v.Barcode != null && v.Barcode.Contains(search)))
                    .Where(v => v.IsDeleted.IsDeletedStatu != true)
                    .Select(v => v.ProductId)
                    .Distinct()
                    .ToListAsync(token);

                query = query.Where(p =>
                    (p.Name != null && p.Name.Contains(search)) ||
                    (p.ShortDescription != null && p.ShortDescription.Contains(search)) ||
                    (p.FullDescription != null && p.FullDescription.Contains(search)) ||
                    (p.Tags != null && p.Tags.Contains(search)) ||
                    (p.BrandId != null && matchingBrandIds.Contains(p.BrandId.Value)) ||
                    matchingVariantProductIds.Contains(p.Id));
            }

            if (_selectedCategory != null)
            {
                var descendantIds = GetDescendantCategoryIds(_selectedCategory.Id);
                descendantIds.Add(_selectedCategory.Id);

                var categoryProductIds = await db.Set<ProductCategories>().AsNoTracking()
                    .Where(pc => descendantIds.Contains(pc.CategoryId))
                    .Select(pc => pc.ProductId)
                    .Distinct()
                    .ToListAsync(token);

                query = query.Where(p => categoryProductIds.Contains(p.Id));
            }

            if (!string.IsNullOrEmpty(_filterBrand))
            {
                var brandId = _displayBrands.FirstOrDefault(b => b.Name == _filterBrand)?.Id
                              ?? _allBrandsCache.FirstOrDefault(b => b.Name == _filterBrand)?.Id;
                if (brandId.HasValue)
                    query = query.Where(p => p.BrandId == brandId.Value);
            }

            if (!isNextBatch)
            {
                _totalCount = await query.CountAsync(token);
            }

            // Madde 2: Rastgele sıralama — sıralama tercihi ne olursa olsun önce rastgele çek,
            // sonra in-memory sırala
            var rawProducts = await query
                .OrderBy(p => Guid.NewGuid())
                .Take(BATCH_SIZE)
                .Select(p => new
                {
                    p.Id,
                    p.Name,
                    p.ShortDescription,
                    p.BrandId,
                    p.StoreId,
                    p.CoverMediaId,
                    ViewCount = p.Interaction.ViewCount ?? 0,
                    LikeCount = p.Interaction.LikeCount ?? 0,
                    BookmarkCount = p.Interaction.BookmarkCount ?? 0
                })
                .ToListAsync(token);

            if (token.IsCancellationRequested) return;

            if (!rawProducts.Any())
            {
                _hasMore = false;
                return;
            }

            var productIds = rawProducts.Select(p => p.Id).ToList();
            var storeIds = rawProducts.Select(p => p.StoreId).Distinct().ToList();
            var brandIds = rawProducts.Where(p => p.BrandId.HasValue).Select(p => p.BrandId!.Value).Distinct().ToList();

            var storesList = await db.Set<Store>().AsNoTracking()
                .Where(s => storeIds.Contains(s.Id))
                .Select(s => new { s.Id, s.Name })
                .ToListAsync(token);
            var storeNames = storesList.GroupBy(s => s.Id).ToDictionary(g => g.Key, g => g.First().Name);

            var brandsList = await db.Set<Brands>().AsNoTracking()
                .Where(b => brandIds.Contains(b.Id))
                .Select(b => new { b.Id, b.Name })
                .ToListAsync(token);
            var brandNames = brandsList.GroupBy(b => b.Id).ToDictionary(g => g.Key, g => g.First().Name);

            var defaultVariants = await db.Set<ProductVariants>().AsNoTracking()
                .Where(v => productIds.Contains(v.ProductId) && v.IsDefault &&
                            v.IsDeleted.IsDeletedStatu != true)
                .Select(v => new { v.Id, v.ProductId, v.Sku, v.Barcode })
                .ToListAsync(token);

            var variantMap = defaultVariants
                .GroupBy(v => v.ProductId)
                .ToDictionary(g => g.Key, g => g.First());

            var variantIds = defaultVariants.Select(v => v.Id).ToList();

            var prices = await db.Set<ProductPrices>().AsNoTracking()
                .Where(pp => variantIds.Contains(pp.VariantId) && pp.EffectiveTo == null)
                .ToListAsync(token);

            var priceMap = new Dictionary<Guid, ProductPrices>();
            foreach (var dv in defaultVariants)
            {
                var variantPrices = prices.Where(pp => pp.VariantId == dv.Id).ToList();
                var best = variantPrices.FirstOrDefault(pp => pp.Currency == "TRY") ?? variantPrices.FirstOrDefault();
                if (best != null) priceMap[dv.ProductId] = best;
            }

            var seoRecords = await db.Set<ProductSeo>().AsNoTracking()
                .Where(s => productIds.Contains(s.ProductId))
                .Select(s => new { s.ProductId, s.Slug, s.CreatedAt })
                .ToListAsync(token);

            var slugs = seoRecords
                .GroupBy(s => s.ProductId)
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderByDescending(s => s.CreatedAt).FirstOrDefault()?.Slug ?? g.Key.ToString()
                );

            var coverMediaIds = rawProducts.Where(p => p.CoverMediaId.HasValue).Select(p => p.CoverMediaId!.Value).Distinct().ToList();
            var coverMediaMap = coverMediaIds.Any()
                ? await db.Set<Data.Media>().AsNoTracking()
                    .Where(m => coverMediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                    .ToDictionaryAsync(m => m.Id, m => m.FileUrl_Ratio_1_2 ?? m.FileUrl_Ratio_1_4 ?? m.FileUrl ?? "", token)
                : new Dictionary<Guid, string>();

            var galleryItems = await db.Set<ItemGallery>().AsNoTracking()
                .Where(ig => ig.ItemId.HasValue && productIds.Contains(ig.ItemId.Value) &&
                             ig.IsDelete != true &&
                             (ig.ItemType == "Product" || ig.ItemType == "ProductGallery"))
                .OrderBy(ig => ig.ItemAddDate)
                .ToListAsync(token);

            var galleryMediaIds = galleryItems.Where(ig => ig.MediaId.HasValue).Select(ig => ig.MediaId!.Value).Distinct().ToList();
            var galleryMediaMap = galleryMediaIds.Any()
                ? await db.Set<Data.Media>().AsNoTracking()
                    .Where(m => galleryMediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                    .ToDictionaryAsync(m => m.Id, m => m.FileUrl_Ratio_1_2 ?? m.FileUrl_Ratio_1_4 ?? m.FileUrl ?? "", token)
                : new Dictionary<Guid, string>();

            var newProducts = new List<ProductCardDto>();
            foreach (var rp in rawProducts)
            {
                var dto = new ProductCardDto
                {
                    Id = rp.Id,
                    Name = rp.Name ?? "—",
                    ShortDescription = rp.ShortDescription,
                    BrandName = rp.BrandId.HasValue && brandNames.TryGetValue(rp.BrandId.Value, out var bn) ? bn : null,
                    StoreId = rp.StoreId,
                    StoreName = storeNames.TryGetValue(rp.StoreId, out var sn) ? sn : null,
                    ViewCount = rp.ViewCount,
                    LikeCount = rp.LikeCount,
                    Slug = slugs.TryGetValue(rp.Id, out var slug) ? slug : rp.Id.ToString()
                };

                if (variantMap.TryGetValue(rp.Id, out var dv2))
                {
                    dto.Sku = dv2.Sku;
                    dto.Barcode = dv2.Barcode;
                }

                if (priceMap.TryGetValue(rp.Id, out var price))
                {
                    dto.Price = price.Price;
                    dto.DiscountedPrice = price.DiscountedPrice;
                    dto.Currency = price.Currency;
                }

                var images = new List<string>();
                if (rp.CoverMediaId.HasValue && coverMediaMap.TryGetValue(rp.CoverMediaId.Value, out var coverUrl))
                    images.Add(coverUrl);

                foreach (var gi in galleryItems.Where(ig => ig.ItemId == rp.Id && ig.MediaId.HasValue).Take(4))
                {
                    if (gi.MediaId.HasValue && galleryMediaMap.TryGetValue(gi.MediaId.Value, out var gUrl) && !images.Contains(gUrl))
                        images.Add(gUrl);
                    if (images.Count >= 4) break;
                }
                dto.ImageUrls = images;

                newProducts.Add(dto);
            }

            // Fiyat filtresi (in-memory)
            if (_filterMinPrice.HasValue || _filterMaxPrice.HasValue)
            {
                newProducts = newProducts.Where(p =>
                {
                    var effectivePrice = p.DiscountedPrice ?? p.Price ?? 0;
                    if (_filterMinPrice.HasValue && effectivePrice < _filterMinPrice.Value) return false;
                    if (_filterMaxPrice.HasValue && effectivePrice > _filterMaxPrice.Value) return false;
                    return true;
                }).ToList();
            }

            _products.AddRange(newProducts);

            // Madde 2+11: Yüklenen ürün ID'lerini kaydet
            foreach (var np in newProducts)
                _loadedProductIds.Add(np.Id);

            // Sıralama (in-memory) — fiyat sıralaması gibi durumlar için
            if (_sortOrder == "price_asc")
                _products = _products.OrderBy(p => p.DiscountedPrice ?? p.Price ?? decimal.MaxValue).ToList();
            else if (_sortOrder == "price_desc")
                _products = _products.OrderByDescending(p => p.DiscountedPrice ?? p.Price ?? 0).ToList();
            else if (_sortOrder == "popular")
                _products = _products.OrderByDescending(p => p.ViewCount).ToList();
            else if (_sortOrder == "most_liked")
                _products = _products.OrderByDescending(p => p.LikeCount).ToList();
            else if (_sortOrder == "name_asc")
                _products = _products.OrderBy(p => p.Name).ToList();
            else if (_sortOrder == "name_desc")
                _products = _products.OrderByDescending(p => p.Name).ToList();

            _loadedBatches++;
            _hasMore = rawProducts.Count == BATCH_SIZE && _products.Count < _totalCount;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await LogError("LoadProducts", ex);
            await Notify("danger", "Hata", "Ürünler yüklenirken sorun oluştu.");
        }
        finally
        {
            _isLoading = false;
            _loadSemaphore.Release();
            if (!_disposed) StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // KATEGORİ AĞACI
    // ═══════════════════════════════════════════════════════════════

    private async Task LoadCategoriesAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            _allCategories = await db.Set<CategoriesTr>().AsNoTracking().ToListAsync(_cts.Token);

            _categoryProductCounts = await db.Set<ProductCategories>().AsNoTracking()
                .Join(db.Set<Products>().AsNoTracking()
                        .Where(p => p.IsActive && (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true)),
                      pc => pc.ProductId, p => p.Id, (pc, p) => pc)
                .GroupBy(pc => pc.CategoryId)
                .Select(g => new { CategoryId = g.Key, Count = g.Count() })
                .ToDictionaryAsync(x => x.CategoryId, x => x.Count, _cts.Token);

            BuildCategoryTree();
        }
        catch (Exception ex) { await LogError("LoadCategories", ex); }
    }

    private void BuildCategoryTree()
    {
        var lookup = _allCategories.ToLookup(c => c.ParentCategoryId);
        List<CategoryTreeNode> BuildChildren(int? parentId)
        {
            return lookup[parentId]
                .Select(c => new CategoryTreeNode
                {
                    Id = c.Id,
                    Name = c.Name,
                    ParentId = c.ParentCategoryId,
                    Children = BuildChildren(c.Id)
                })
                .Select(n => { n.ProductCount = GetTotalProductCount(n); return n; })
                .Where(n => n.ProductCount > 0)
                .OrderBy(n => n.Name)
                .ToList();
        }
        _categoryTree = BuildChildren(null);
    }

    private int GetTotalProductCount(CategoryTreeNode node)
    {
        var count = _categoryProductCounts.GetValueOrDefault(node.Id, 0);
        foreach (var child in node.Children) count += GetTotalProductCount(child);
        return count;
    }

    private HashSet<int> GetDescendantCategoryIds(int parentId)
    {
        var result = new HashSet<int>();
        var lookup = _allCategories.ToLookup(c => c.ParentCategoryId);
        void Traverse(int pid) { foreach (var c in lookup[pid]) { result.Add(c.Id); Traverse(c.Id); } }
        Traverse(parentId);
        return result;
    }

    private List<CategoriesTr> BuildCategoryBreadcrumb(int categoryId)
    {
        var path = new List<CategoriesTr>();
        var dict = _allCategories.ToDictionary(c => c.Id);
        var current = dict.GetValueOrDefault(categoryId);
        while (current != null)
        {
            path.Insert(0, current);
            current = current.ParentCategoryId.HasValue ? dict.GetValueOrDefault(current.ParentCategoryId.Value) : null;
        }
        return path;
    }

    private bool MatchesCategorySearch(CategoryTreeNode node) =>
        string.IsNullOrEmpty(_categorySearchTerm) ||
        (node.Name ?? "").Contains(_categorySearchTerm, StringComparison.OrdinalIgnoreCase) ||
        node.Children.Any(c => MatchesCategorySearch(c));

    private void ToggleCategoryExpand(int id) { if (!_expandedCategoryIds.Remove(id)) _expandedCategoryIds.Add(id); }

    private async void SelectCategory(CategoryTreeNode node)
    {
        _selectedCategory = _allCategories.FirstOrDefault(c => c.Id == node.Id);
        _expandedCategoryIds.Add(node.Id);
        await ResetAndReload();
    }

    private void OnCategorySearch(ChangeEventArgs e)
    {
        _categorySearchTerm = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(_categorySearchTerm))
            _expandedCategoryIds = new HashSet<int>(_allCategories.Select(c => c.Id));
    }

    // ═══════════════════════════════════════════════════════════════
    // MARKA YÜKLEME — Madde 1: Rastgele 100 + debounce 500ms arama
    // ═══════════════════════════════════════════════════════════════

    private async Task LoadBrandsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

            // Madde 1: Rastgele 100 marka yükle
            _displayBrands = await db.Set<Brands>().AsNoTracking()
                .Where(b => b.IsDeleted == null || b.IsDeleted.IsDeletedStatu != true)
                .Where(b => b.Name != null && b.Name != "")
                .OrderBy(b => Guid.NewGuid())
                .Take(BRAND_INITIAL_COUNT)
                .Select(b => new BrandDto { Id = b.Id, Name = b.Name ?? "" })
                .ToListAsync(_cts.Token);

            // Alfabetik sıra ile göster
            _displayBrands = _displayBrands.OrderBy(b => b.Name).ToList();
        }
        catch (Exception ex) { await LogError("LoadBrands", ex); }
    }

    // Madde 1: Marka arama — 3+ karakter, 500ms debounce
    private async Task OnBrandSearchInput(ChangeEventArgs e)
    {
        _brandSearchTerm = e.Value?.ToString() ?? string.Empty;

        // 3 karakterden az ise arama yapma, rastgele listeyi göster
        if (string.IsNullOrWhiteSpace(_brandSearchTerm) || _brandSearchTerm.Length < BRAND_MIN_SEARCH_LENGTH)
        {
            _brandSearchCts?.Cancel();
            _brandSearching = false;
            // Eğer arama tamamen temizlendiyse rastgele listeyi tekrar yükle
            if (string.IsNullOrWhiteSpace(_brandSearchTerm))
            {
                await LoadBrandsAsync();
                StateHasChanged();
            }
            return;
        }

        // 500ms debounce
        _brandSearchCts?.Cancel();
        _brandSearchCts?.Dispose();
        _brandSearchCts = new CancellationTokenSource();
        var token = _brandSearchCts.Token;

        _brandSearching = true;
        StateHasChanged();

        try
        {
            await Task.Delay(BRAND_SEARCH_DELAY, token);
            if (token.IsCancellationRequested) return;

            await using var db = await DbFactory.CreateDbContextAsync(token);
            _displayBrands = await db.Set<Brands>().AsNoTracking()
                .Where(b => b.IsDeleted == null || b.IsDeleted.IsDeletedStatu != true)
                .Where(b => b.Name != null && b.Name.Contains(_brandSearchTerm))
                .OrderBy(b => b.Name)
                .Take(50)
                .Select(b => new BrandDto { Id = b.Id, Name = b.Name ?? "" })
                .ToListAsync(token);

            _brandSearching = false;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _brandSearching = false;
            await LogError("BrandSearch", ex);
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // ARAMA / FİLTRE / SIRALAMA
    // ═══════════════════════════════════════════════════════════════

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel(); _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(SEARCH_DELAY, token);
            if (!token.IsCancellationRequested) await ResetAndReload();
        }
        catch (OperationCanceledException) { }
    }

