    private void SetViewMode(string mode) => _viewMode = mode;
    private string GetGridClass() => _viewMode switch { "list" => "list-view", "compact" => "compact-view", _ => "" };
    private void NavigateToProduct(ProductCardDto p) => Nav.NavigateTo($"/urun/{p.Slug}");
    private void AddToCart(ProductCardDto p) { /* Cart service */ }
    private void BuyNow(ProductCardDto p) => Nav.NavigateTo($"/urun/{p.Slug}?buy=1");

    // ═══════════════════ PAGINATION ═══════════════════

    private async Task GoToPage(int page) { if (page < 1 || page > _totalPages) return; _currentPage = page; await LoadData(); }
    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (_totalPages <= 7) { for (int i = 1; i <= _totalPages; i++) pages.Add(i); }
        else
        {
            pages.Add(1);
            if (_currentPage > 3) pages.Add(-1);
            for (int i = Math.Max(2, _currentPage - 1); i <= Math.Min(_totalPages - 1, _currentPage + 1); i++) pages.Add(i);
            if (_currentPage < _totalPages - 2) pages.Add(-1);
            pages.Add(_totalPages);
        }
        return pages;
    }

    // ═══════════════════ SEARCH DEBOUNCE ═══════════════════

    private void OnSearchDebounce()
    {
        _searchDebounceTimer?.Stop(); _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new System.Timers.Timer(400);
        _searchDebounceTimer.Elapsed += async (s, e) =>
        { _searchDebounceTimer?.Stop(); await InvokeAsync(async () => { _currentPage = 1; await LoadData(); }); };
        _searchDebounceTimer.AutoReset = false; _searchDebounceTimer.Start();
    }

