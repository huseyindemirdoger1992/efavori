    private List<ProductCardDto> _products = new();
    private List<CategoryTreeNode> _categoryTree = new();
    private List<BrandFilterItem> _brandFilters = new();
    private List<AttributeFilterGroup> _attributeFilters = new();
    private HashSet<Guid> _favoriteIds = new();
    private List<ProductCardDto> _compareList = new();
    private bool _showCompareModal;

    // ─── Hover Gallery ───
    private Guid? _hoveredProductId;
    private Dictionary<Guid, int> _galleryIndexes = new();

