    // ═══════════════════ DATA LOADING ═══════════════════

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // ── Base Query ──
            var query = db.Set<Products>()
                .Where(p => p.IsActive
                    && p.PublishStatus == true
                    && (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true));

            // ── Search ──
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                var matchingBrandIds = await db.Set<Brands>()
                    .Where(b => b.Name != null && b.Name.ToLower().Contains(term))
                    .Select(b => b.Id).ToListAsync();

                var matchingVariantProductIds = await db.Set<ProductVariants>()
                    .Where(v => (v.Sku != null && v.Sku.ToLower().Contains(term))
                             || (v.Barcode != null && v.Barcode.ToLower().Contains(term)))
                    .Select(v => v.ProductId).Distinct().ToListAsync();

                query = query.Where(p =>
                    (p.Name != null && p.Name.ToLower().Contains(term))
                    || (p.Tags != null && p.Tags.ToLower().Contains(term))
                    || (p.ShortDescription != null && p.ShortDescription.ToLower().Contains(term))
                    || (p.BrandId.HasValue && matchingBrandIds.Contains(p.BrandId.Value))
                    || matchingVariantProductIds.Contains(p.Id));
            }

            // ── Category ──
            if (_selectedCategoryId.HasValue)
            {
                var catProductIds = await db.Set<ProductCategories>()
                    .Where(pc => pc.CategoryId == _selectedCategoryId.Value)
                    .Select(pc => pc.ProductId).ToListAsync();
                query = query.Where(p => catProductIds.Contains(p.Id));
            }

            // ── Brand ──
            var selectedBrands = _brandFilters.Where(b => b.IsSelected).Select(b => b.Id).ToList();
            if (selectedBrands.Any())
                query = query.Where(p => p.BrandId.HasValue && selectedBrands.Contains(p.BrandId.Value));

            // ── Discount ──
            if (_filterDiscounted)
            {
                var discountedIds = await db.Set<ProductPrices>()
                    .Where(pp => pp.EffectiveTo == null && pp.DiscountedPrice.HasValue && pp.DiscountedPrice < pp.Price)
                    .Select(pp => pp.ProductId).Distinct().ToListAsync();
                query = query.Where(p => discountedIds.Contains(p.Id));
            }

            // ── Rating ──
            if (_minRating.HasValue)
                query = query.Where(p => p.Interaction != null && (p.Interaction.LikeCount ?? 0) > 0);

            // ── Attribute Filters ──
            foreach (var af in _attributeFilters)
            {
                var selectedValues = af.Values.Where(v => v.IsSelected).Select(v => v.ValueId).ToList();
                if (selectedValues.Any())
                {
                    var matchIds = await db.Set<ProductVariantValues>()
                        .Where(pvv => pvv.AttributeId == af.AttributeId && selectedValues.Contains(pvv.AttributeValueId))
                        .Join(db.Set<ProductVariants>(), pvv => pvv.VariantId, pv => pv.Id, (pvv, pv) => pv.ProductId)
                        .Distinct().ToListAsync();
                    query = query.Where(p => matchIds.Contains(p.Id));
                }
            }

            // ── Count & Pages ──
            _totalCount = await query.CountAsync();
            _totalPages = (int)Math.Ceiling((double)_totalCount / _pageSize);
            if (_currentPage > _totalPages) _currentPage = Math.Max(1, _totalPages);

            // ── Sort ──
            IQueryable<Products> sortedQuery = _sortOrder switch
            {
                "newest" => query.OrderByDescending(p => p.CreatedAt),
                "rating_desc" => query.OrderByDescending(p => p.Interaction != null ? (p.Interaction.LikeCount ?? 0) : 0),
                "most_reviewed" => query.OrderByDescending(p => p.Interaction != null ? (p.Interaction.ViewCount ?? 0) : 0),
                _ => query.OrderByDescending(p => p.CreatedAt)
            };

            var pagedProducts = await sortedQuery
                .Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToListAsync();
            var productIds = pagedProducts.Select(p => p.Id).ToList();

            // ── Related Data ──
            var defaultVariants = await db.Set<ProductVariants>()
                .Where(v => productIds.Contains(v.ProductId) && v.IsDefault
                    && (v.IsDeleted == null || v.IsDeleted.IsDeletedStatu != true))
                .ToListAsync();
            var variantDict = defaultVariants.GroupBy(v => v.ProductId).ToDictionary(g => g.Key, g => g.First());

            var variantIds = defaultVariants.Select(v => v.Id).ToList();
            var currentPrices = await db.Set<ProductPrices>()
                .Where(pp => variantIds.Contains(pp.VariantId) && pp.EffectiveTo == null && pp.Currency == "TRY")
                .ToListAsync();
            var priceDict = currentPrices.GroupBy(pp => pp.ProductId).ToDictionary(g => g.Key, g => g.First());

            var stocks = await db.Set<ProductStocks>()
                .Where(s => productIds.Contains(s.ProductId))
                .GroupBy(s => s.ProductId)
                .Select(g => new { ProductId = g.Key, Total = g.Sum(s => s.Quantity) })
                .ToListAsync();
            var stockDict = stocks.ToDictionary(s => s.ProductId, s => s.Total);

            var brandIds = pagedProducts.Where(p => p.BrandId.HasValue).Select(p => p.BrandId!.Value).Distinct().ToList();
            var brands = await db.Set<Brands>().Where(b => brandIds.Contains(b.Id))
                .ToDictionaryAsync(b => b.Id, b => b.Name ?? "");

            var storeIds = pagedProducts.Select(p => p.StoreId).Distinct().ToList();
            var stores = await db.Set<Store>().Where(s => storeIds.Contains(s.Id))
                .ToDictionaryAsync(s => s.Id, s => s.Name ?? "");

            var primaryCats = await db.Set<ProductCategories>()
                .Where(pc => productIds.Contains(pc.ProductId) && pc.IsPrimary).ToListAsync();
            var catIds = primaryCats.Select(pc => pc.CategoryId).Distinct().ToList();
            var categories = await db.Set<CategoriesTr>().Where(c => catIds.Contains(c.Id))
                .ToDictionaryAsync(c => c.Id, c => c.Name ?? "");
            var productCatDict = primaryCats.ToDictionary(pc => pc.ProductId, pc => pc.CategoryId);

            var coverMediaIds = pagedProducts.Where(p => p.CoverMediaId.HasValue).Select(p => p.CoverMediaId!.Value).Distinct().ToList();
            var galleryItems = await db.Set<ItemGallery>()
                .Where(ig => productIds.Contains(ig.ItemId!.Value) && ig.ItemType == "ProductGallery" && ig.IsDelete != true)
                .ToListAsync();
            var allMediaIds = coverMediaIds
                .Union(galleryItems.Where(g => g.MediaId.HasValue).Select(g => g.MediaId!.Value)).Distinct().ToList();
            var medias = await db.Set<Data.Media>().Where(m => allMediaIds.Contains(m.Id))
                .ToDictionaryAsync(m => m.Id, m => m);

            var seoData = await db.Set<ProductSeo>().Where(s => productIds.Contains(s.ProductId))
                .ToDictionaryAsync(s => s.ProductId, s => s);

            // ── Build DTOs ──
            _products = pagedProducts.Select(p =>
            {
                var hasPrice = priceDict.TryGetValue(p.Id, out var price);
                var stock = stockDict.GetValueOrDefault(p.Id, 0);
                var coverUrl = p.CoverMediaId.HasValue && medias.TryGetValue(p.CoverMediaId.Value, out var coverMedia)
                    ? (coverMedia.FileUrl_Ratio_1_4 ?? coverMedia.FileUrl ?? "/img/placeholder.webp")
                    : "/img/placeholder.webp";

                var galleryUrls = galleryItems
                    .Where(g => g.ItemId == p.Id && g.MediaId.HasValue && medias.ContainsKey(g.MediaId.Value))
                    .OrderBy(g => g.ItemAddDate)
                    .Select(g => { var m = medias[g.MediaId!.Value]; return m.FileUrl_Ratio_1_4 ?? m.FileUrl ?? ""; })
                    .Where(u => !string.IsNullOrEmpty(u)).ToList();
                if (!galleryUrls.Contains(coverUrl)) galleryUrls.Insert(0, coverUrl);

                var discountPct = 0;
                if (hasPrice && price!.DiscountedPrice.HasValue && price.Price > 0 && price.DiscountedPrice < price.Price)
                    discountPct = (int)Math.Round((1 - (price.DiscountedPrice.Value / price.Price)) * 100);

                var catName = "";
                if (productCatDict.TryGetValue(p.Id, out var catId) && categories.TryGetValue(catId, out var cn))
                    catName = cn;

                return new ProductCardDto
                {
                    ProductId = p.Id,
                    Name = p.Name ?? "",
                    Slug = seoData.TryGetValue(p.Id, out var seo) ? (seo.Slug ?? p.Id.ToString()) : p.Id.ToString(),
                    BrandName = p.BrandId.HasValue && brands.TryGetValue(p.BrandId.Value, out var bn) ? bn : "",
                    StoreName = stores.GetValueOrDefault(p.StoreId, ""),
                    CategoryName = catName,
                    CoverUrl = coverUrl,
                    GalleryUrls = galleryUrls,
                    Price = hasPrice ? price!.Price : 0,
                    DiscountedPrice = hasPrice ? price!.DiscountedPrice : null,
                    Currency = hasPrice ? (price!.Currency ?? "TRY") : "TRY",
                    DiscountPercent = discountPct,
                    TotalStock = stock,
                    IsLowStock = stock > 0 && stock <= 5,
                    Rating = 0,
                    ReviewCount = 0,
                    FavoriteCount = p.Interaction?.BookmarkCount ?? 0,
                    SaleCount = 0,
                    IsNew = p.CreatedAt.HasValue && (DateTime.UtcNow - p.CreatedAt.Value).TotalDays <= 30,
                    IsBestseller = (p.Interaction?.ViewCount ?? 0) > 500,
                    HasFreeShipping = false,
                    HasFastDelivery = false,
                };
            }).ToList();

            // ── In-memory sorts ──
            _products = _sortOrder switch
            {
                "price_asc" => _products.OrderBy(p => p.DiscountedPrice ?? p.Price).ToList(),
                "price_desc" => _products.OrderByDescending(p => p.DiscountedPrice ?? p.Price).ToList(),
                "discount_desc" => _products.OrderByDescending(p => p.DiscountPercent).ToList(),
                "bestselling" => _products.OrderByDescending(p => p.SaleCount).ToList(),
                _ => _products
            };

            // ── In-memory price/stock filters ──
            if (_priceMin.HasValue) _products = _products.Where(p => (p.DiscountedPrice ?? p.Price) >= _priceMin.Value).ToList();
            if (_priceMax.HasValue) _products = _products.Where(p => (p.DiscountedPrice ?? p.Price) <= _priceMax.Value).ToList();
            if (_filterInStock && !_filterOutOfStock) _products = _products.Where(p => p.TotalStock > 0).ToList();
            else if (_filterOutOfStock && !_filterInStock) _products = _products.Where(p => p.TotalStock <= 0).ToList();

            await LoadFilterData(db);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"PLP LoadData Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadFilterData(_ApplicationConnectionDb db)
    {
        var catCounts = await db.Set<ProductCategories>()
            .Join(db.Set<Products>().Where(p => p.IsActive && p.PublishStatus == true
                && (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true)),
                pc => pc.ProductId, p => p.Id, (pc, p) => pc)
            .GroupBy(pc => pc.CategoryId)
            .Select(g => new { CategoryId = g.Key, Count = g.Count() }).ToListAsync();

        var allCats = await db.Set<CategoriesTr>().ToListAsync();
        var catCountDict = catCounts.ToDictionary(c => c.CategoryId, c => c.Count);

        _categoryTree = allCats.Where(c => c.ParentCategoryId == null).OrderBy(c => c.DepartmentName)
            .Select(dept => new CategoryTreeNode
            {
                Id = dept.Id,
                Name = dept.DepartmentName ?? dept.Name ?? "",
                ProductCount = catCountDict.GetValueOrDefault(dept.Id, 0),
                Children = allCats.Where(c => c.ParentCategoryId == dept.Id).OrderBy(c => c.Name)
                    .Select(sub => new CategoryTreeNode { Id = sub.Id, Name = sub.Name ?? "", ProductCount = catCountDict.GetValueOrDefault(sub.Id, 0) })
                    .Where(c => c.ProductCount > 0).ToList()
            }).Where(d => d.ProductCount > 0 || d.Children?.Any() == true).ToList();

        var brandCounts = await db.Set<Products>()
            .Where(p => p.IsActive && p.PublishStatus == true && p.BrandId.HasValue
                && (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true))
            .GroupBy(p => p.BrandId!.Value)
            .Select(g => new { BrandId = g.Key, Count = g.Count() }).ToListAsync();
        var brandIds2 = brandCounts.Select(b => b.BrandId).ToList();
        var brandNames = await db.Set<Brands>()
            .Where(b => brandIds2.Contains(b.Id) && (b.IsDeleted == null || b.IsDeleted.IsDeletedStatu != true))
            .ToDictionaryAsync(b => b.Id, b => b.Name ?? "");
        var selectedBrandIds = _brandFilters.Where(b => b.IsSelected).Select(b => b.Id).ToHashSet();
        _brandFilters = brandCounts.Where(bc => brandNames.ContainsKey(bc.BrandId)).OrderByDescending(bc => bc.Count)
            .Select(bc => new BrandFilterItem { Id = bc.BrandId, Name = brandNames[bc.BrandId], Count = bc.Count, IsSelected = selectedBrandIds.Contains(bc.BrandId) }).ToList();

        var filterableAttrs = await db.Set<ProductAttributes>()
            .Where(a => a.IsFilterable && a.IsActive && a.UserId == null
                && (a.IsDeleted == null || a.IsDeleted.IsDeletedStatu != true))
            .OrderBy(a => a.DisplayOrder).ToListAsync();

        var prevSelections = _attributeFilters
            .SelectMany(af => af.Values.Where(v => v.IsSelected).Select(v => (af.AttributeId, v.ValueId))).ToHashSet();

        _attributeFilters = new();
        foreach (var attr in filterableAttrs.Take(10))
        {
            var values = await db.Set<ProductAttributeValues>()
                .Where(v => v.AttributeId == attr.Id && v.IsActive
                    && (v.IsDeleted == null || v.IsDeleted.IsDeletedStatu != true) && v.UserId == null)
                .OrderBy(v => v.DisplayOrder).ToListAsync();
            if (!values.Any()) continue;

            var valueIds = values.Select(v => v.Id).ToList();
            var valueCounts = await db.Set<ProductVariantValues>()
                .Where(pvv => pvv.AttributeId == attr.Id && valueIds.Contains(pvv.AttributeValueId))
                .Join(db.Set<ProductVariants>().Where(pv => pv.IsActive && (pv.IsDeleted == null || pv.IsDeleted.IsDeletedStatu != true)),
                    pvv => pvv.VariantId, pv => pv.Id, (pvv, pv) => new { pvv.AttributeValueId, pv.ProductId })
                .Distinct().GroupBy(x => x.AttributeValueId)
                .Select(g => new { ValueId = g.Key, Count = g.Count() }).ToListAsync();
            var vcDict = valueCounts.ToDictionary(v => v.ValueId, v => v.Count);

            _attributeFilters.Add(new AttributeFilterGroup
            {
                AttributeId = attr.Id,
                AttributeName = attr.Name ?? "",
                Values = values.Where(v => vcDict.GetValueOrDefault(v.Id, 0) > 0)
                    .Select(v => new AttributeFilterValue
                    {
                        ValueId = v.Id,
                        ValueText = v.Value ?? "",
                        ColorHex = v.ColorHex,
                        Count = vcDict.GetValueOrDefault(v.Id, 0),
                        IsSelected = prevSelections.Contains((attr.Id, v.Id))
                    }).ToList()
            });
        }
    }

    // ═══════════════════ QUICK VIEW ═══════════════════

    private async Task OpenQuickView(ProductCardDto product)
    {
        _quickViewProduct = product; _qvGalleryIndex = 0; _qvQuantity = 1;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var mappings = await db.Set<ProductAttributeMappings>()
                .Where(m => m.ProductId == product.ProductId && m.IsVariantAttribute)
                .OrderBy(m => m.DisplayOrder).ToListAsync();

            _qvVariantGroups = new();
            foreach (var map in mappings)
            {
                var attr = await db.Set<ProductAttributes>().FindAsync(map.AttributeId);
                if (attr == null) continue;
                var variantValueIds = await db.Set<ProductVariantValues>()
                    .Where(pvv => pvv.AttributeId == map.AttributeId)
                    .Join(db.Set<ProductVariants>().Where(pv => pv.ProductId == product.ProductId && pv.IsActive),
                        pvv => pvv.VariantId, pv => pv.Id, (pvv, pv) => pvv.AttributeValueId)
                    .Distinct().ToListAsync();
                var values = await db.Set<ProductAttributeValues>()
                    .Where(v => variantValueIds.Contains(v.Id)).OrderBy(v => v.DisplayOrder).ToListAsync();
                _qvVariantGroups.Add(new VariantGroupDto
                {
                    AttributeId = map.AttributeId,
                    AttributeName = attr.Name ?? "",
                    Options = values.Select((v, idx) => new VariantOptionDto
                    { ValueId = v.Id, Value = v.Value ?? "", ColorHex = v.ColorHex, IsSelected = idx == 0 }).ToList()
                });
            }

            var specs = await db.Set<ProductSpecifications>()
                .Where(s => s.ProductId == product.ProductId).OrderBy(s => s.DisplayOrder).ToListAsync();
            var specAttrIds = specs.Where(s => s.AttributeId.HasValue).Select(s => s.AttributeId!.Value).Distinct().ToList();
            var specAttrs = await db.Set<ProductAttributes>().Where(a => specAttrIds.Contains(a.Id))
                .ToDictionaryAsync(a => a.Id, a => a.Name ?? "");
            var specValueIds = specs.Where(s => s.AttributeValueId.HasValue).Select(s => s.AttributeValueId!.Value).Distinct().ToList();
            var specValues = await db.Set<ProductAttributeValues>().Where(v => specValueIds.Contains(v.Id))
                .ToDictionaryAsync(v => v.Id, v => v.Value ?? "");
            _qvSpecs = specs.Select(s => new SpecDto
            {
                Label = s.CustomName ?? (s.AttributeId.HasValue && specAttrs.TryGetValue(s.AttributeId.Value, out var an) ? an : ""),
                Value = s.CustomValue ?? (s.AttributeValueId.HasValue && specValues.TryGetValue(s.AttributeValueId.Value, out var av) ? av : "")
            }).Where(s => !string.IsNullOrEmpty(s.Label) && !string.IsNullOrEmpty(s.Value)).ToList();
        }
        catch (Exception ex) { Console.Error.WriteLine($"QuickView Error: {ex.Message}"); }
        StateHasChanged();
    }

    private void CloseQuickView() { _quickViewProduct = null; _qvVariantGroups = null; _qvSpecs = null; }
    private string GetQuickViewMainImage() =>
        _quickViewProduct?.GalleryUrls?.Count > _qvGalleryIndex
            ? _quickViewProduct.GalleryUrls[_qvGalleryIndex] : (_quickViewProduct?.CoverUrl ?? "/img/placeholder.webp");
    private void SetQvGalleryIndex(int idx) => _qvGalleryIndex = idx;
    private void QvIncreaseQty() { if (_qvQuantity < (_quickViewProduct?.TotalStock ?? 99)) _qvQuantity++; }
    private void QvDecreaseQty() { if (_qvQuantity > 1) _qvQuantity--; }
    private void SelectQvVariant(Guid attrId, Guid valueId)
    {
        var group = _qvVariantGroups?.FirstOrDefault(g => g.AttributeId == attrId);
        if (group != null) foreach (var opt in group.Options) opt.IsSelected = opt.ValueId == valueId;
    }

    // ═══════════════════ FILTERS ═══════════════════

    private async Task OnFilterChanged() { _currentPage = 1; await LoadData(); }
    private async Task OnSortChanged() { _currentPage = 1; await LoadData(); }
    private async Task OnPageSizeChanged() { _currentPage = 1; await LoadData(); }
    private async Task OnCategorySelect(int catId) { _selectedCategoryId = _selectedCategoryId == catId ? null : catId; _currentPage = 1; await LoadData(); }
    private async Task ToggleBrandFilter(Guid brandId)
    {
        var b = _brandFilters.FirstOrDefault(x => x.Id == brandId);
        if (b != null) b.IsSelected = !b.IsSelected;
        _currentPage = 1; await LoadData();
    }
    private async Task ToggleAttributeFilter(Guid attrId, Guid valueId)
    {
        var v = _attributeFilters.FirstOrDefault(g => g.AttributeId == attrId)?.Values.FirstOrDefault(x => x.ValueId == valueId);
        if (v != null) v.IsSelected = !v.IsSelected;
        _currentPage = 1; await LoadData();
    }
    private async Task ApplyPriceFilter() { _currentPage = 1; await LoadData(); }
    private async Task OnRatingFilter(int stars) { _minRating = _minRating == stars ? null : stars; _currentPage = 1; await LoadData(); }
    private async Task ClearAllFilters()
    {
        _selectedCategoryId = null; _priceMin = null; _priceMax = null;
        _filterInStock = false; _filterOutOfStock = false; _filterDiscounted = false;
        _filterFreeShipping = false; _filterFastDelivery = false; _minRating = null; _searchTerm = "";
        foreach (var b in _brandFilters) b.IsSelected = false;
        foreach (var af in _attributeFilters) foreach (var v in af.Values) v.IsSelected = false;
        _currentPage = 1; await LoadData();
    }
    private async Task RemoveFilter(string key)
    {
        if (key == "category") _selectedCategoryId = null;
        else if (key == "price") { _priceMin = null; _priceMax = null; }
        else if (key == "stock") { _filterInStock = false; _filterOutOfStock = false; }
        else if (key == "discount") _filterDiscounted = false;
        else if (key == "shipping") { _filterFreeShipping = false; _filterFastDelivery = false; }
        else if (key == "rating") _minRating = null;
        else if (key == "search") _searchTerm = "";
        else if (key.StartsWith("brand_") && Guid.TryParse(key[6..], out var bid))
        { var b = _brandFilters.FirstOrDefault(x => x.Id == bid); if (b != null) b.IsSelected = false; }
        else if (key.StartsWith("attr_"))
        {
            var parts = key[5..].Split('_');
            if (parts.Length == 2 && Guid.TryParse(parts[0], out var aId) && Guid.TryParse(parts[1], out var vId))
            { var v = _attributeFilters.FirstOrDefault(x => x.AttributeId == aId)?.Values.FirstOrDefault(x => x.ValueId == vId); if (v != null) v.IsSelected = false; }
        }
        _currentPage = 1; await LoadData();
    }
    private bool HasActiveFilters() =>
        _selectedCategoryId.HasValue || _priceMin.HasValue || _priceMax.HasValue
        || _filterInStock || _filterOutOfStock || _filterDiscounted
        || _filterFreeShipping || _filterFastDelivery || _minRating.HasValue
        || !string.IsNullOrWhiteSpace(_searchTerm)
        || _brandFilters.Any(b => b.IsSelected)
        || _attributeFilters.Any(af => af.Values.Any(v => v.IsSelected));
    private int GetActiveFilterCount()
    {
        int c = 0;
        if (_selectedCategoryId.HasValue) c++; if (_priceMin.HasValue || _priceMax.HasValue) c++;
        if (_filterInStock || _filterOutOfStock) c++; if (_filterDiscounted) c++;
        if (_filterFreeShipping || _filterFastDelivery) c++; if (_minRating.HasValue) c++;
        if (!string.IsNullOrWhiteSpace(_searchTerm)) c++;
        c += _brandFilters.Count(b => b.IsSelected);
        c += _attributeFilters.Sum(af => af.Values.Count(v => v.IsSelected));
        return c;
    }
    private List<FilterTag> GetActiveFilterTags()
    {
        var tags = new List<FilterTag>();
        if (!string.IsNullOrWhiteSpace(_searchTerm)) tags.Add(new("search", $"Arama: {_searchTerm}"));
        if (_selectedCategoryId.HasValue)
        {
            var catName = _categoryTree.SelectMany(d => (d.Children ?? new()).Prepend(d)).FirstOrDefault(c => c.Id == _selectedCategoryId)?.Name ?? "Kategori";
            tags.Add(new("category", catName));
        }
        foreach (var b in _brandFilters.Where(b => b.IsSelected)) tags.Add(new($"brand_{b.Id}", b.Name));
        if (_priceMin.HasValue || _priceMax.HasValue) tags.Add(new("price", $"Fiyat: {_priceMin?.ToString("N0") ?? "0"} - {_priceMax?.ToString("N0") ?? "∞"} ₺"));
        if (_filterDiscounted) tags.Add(new("discount", "İndirimli"));
        if (_filterInStock) tags.Add(new("stock", "Stokta Var"));
        if (_filterOutOfStock) tags.Add(new("stock", "Tükenmiş"));
        if (_filterFreeShipping) tags.Add(new("shipping", "Ücretsiz Kargo"));
        if (_filterFastDelivery) tags.Add(new("shipping", "Hızlı Teslimat"));
        if (_minRating.HasValue) tags.Add(new("rating", $"{_minRating}+ Yıldız"));
        foreach (var af in _attributeFilters)
            foreach (var v in af.Values.Where(v => v.IsSelected))
                tags.Add(new($"attr_{af.AttributeId}_{v.ValueId}", $"{af.AttributeName}: {v.ValueText}"));
        return tags;
    }

    // ═══════════════════ GALLERY ═══════════════════

    private void OnCardHover(Guid id) => _hoveredProductId = id;
    private void OnCardLeave(Guid id) => _hoveredProductId = null;
    private string GetCurrentGalleryImage(ProductCardDto p)
    { var idx = GetGalleryIndex(p.ProductId); return p.GalleryUrls?.Count > idx ? p.GalleryUrls[idx] : (p.CoverUrl ?? "/img/placeholder.webp"); }
    private int GetGalleryIndex(Guid id) => _galleryIndexes.GetValueOrDefault(id, 0);
    private void SetGalleryIndex(Guid id, int idx) => _galleryIndexes[id] = idx;
    private void GalleryNext(ProductCardDto p) { var c = GetGalleryIndex(p.ProductId); var mx = (p.GalleryUrls?.Count ?? 1) - 1; _galleryIndexes[p.ProductId] = c >= mx ? 0 : c + 1; }
    private void GalleryPrev(ProductCardDto p) { var c = GetGalleryIndex(p.ProductId); var mx = (p.GalleryUrls?.Count ?? 1) - 1; _galleryIndexes[p.ProductId] = c <= 0 ? mx : c - 1; }

    // ═══════════════════ FAVORITES ═══════════════════

    private bool IsFavorited(Guid id) => _favoriteIds.Contains(id);
    private void ToggleFavorite(Guid id) { if (!_favoriteIds.Add(id)) _favoriteIds.Remove(id); }

    // ═══════════════════ COMPARE ═══════════════════

    private void ToggleCompare(ProductCardDto p) { var e = _compareList.FirstOrDefault(c => c.ProductId == p.ProductId); if (e != null) _compareList.Remove(e); else if (_compareList.Count < 4) _compareList.Add(p); }
    private void RemoveFromCompare(Guid id) => _compareList.RemoveAll(c => c.ProductId == id);
    private void OpenCompareModal() { if (_compareList.Count >= 2) _showCompareModal = true; }
    private void CloseCompareModal() => _showCompareModal = false;

