@* ═══════════════════════════════════════════════════════════════
   JavaScript Interop — Minimal
   ═══════════════════════════════════════════════════════════════ *@
<script suppress-error="BL9992">
    window.ProductListingInterop = {
        _observer: null,
        _dotNetRef: null,
        _map: null,

        init: function (dotNetRef) {
            this._dotNetRef = dotNetRef;
            this._setupInfiniteScroll();
            this._setupHoverGallery();
        },

        dispose: function () {
            if (this._observer) { this._observer.disconnect(); this._observer = null; }
            if (this._map) { this._map.remove(); this._map = null; }
            this._dotNetRef = null;
        },

        _setupInfiniteScroll: function () {
            var self = this;
            var mo = new MutationObserver(function () {
                var sentinel = document.getElementById('scrollSentinel');
                if (sentinel && !sentinel._observed) {
                    sentinel._observed = true;
                    if (self._observer) self._observer.disconnect();
                    self._observer = new IntersectionObserver(function (entries) {
                        if (entries[0].isIntersecting && self._dotNetRef) {
                            self._dotNetRef.invokeMethodAsync('OnScrollSentinelVisible');
                        }
                    }, { rootMargin: '400px' });
                    self._observer.observe(sentinel);
                }
            });
            mo.observe(document.body, { childList: true, subtree: true });
        },

        _setupHoverGallery: function () {
            document.addEventListener('mouseover', function (e) {
                var zone = e.target.closest('.gallery-zone');
                if (!zone) return;
                var container = zone.closest('.product-media');
                if (!container) return;
                var idx = parseInt(zone.dataset.zone);
                container.querySelectorAll('.gallery-img').forEach(function (img, i) {
                    img.classList.toggle('gallery-img-active', i === idx);
                });
                container.querySelectorAll('.gallery-dot').forEach(function (dot, i) {
                    dot.classList.toggle('active', i === idx);
                });
            });

            document.addEventListener('mouseleave', function (e) {
                var card = e.target.closest('.product-media');
                if (!card || card.contains(e.relatedTarget)) return;
                card.querySelectorAll('.gallery-img').forEach(function (img, i) {
                    img.classList.toggle('gallery-img-active', i === 0);
                });
                card.querySelectorAll('.gallery-dot').forEach(function (dot, i) {
                    dot.classList.toggle('active', i === 0);
                });
            }, true);
        },

        // Madde 3: Harita düzeltmesi — modal shown olayını bekle, invalidateSize birden fazla çağır
        initStoreMap: function (lat, lng, title) {
            var self = this;
            var container = document.getElementById('storeMap');
            if (!container) return;

            // Önceki haritayı temizle
            if (self._map) {
                self._map.remove();
                self._map = null;
            }

            try {
                self._map = L.map('storeMap', {
                    center: [lat, lng],
                    zoom: 15,
                    scrollWheelZoom: true
                });

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap'
                }).addTo(self._map);

                L.marker([lat, lng]).addTo(self._map)
                    .bindPopup(title)
                    .openPopup();

                // Modal içindeki harita boyut sorununu çöz — birden fazla invalidateSize
                var m = self._map;
                setTimeout(function () { if (m) { m.invalidateSize(); m.setView([lat, lng], 15); } }, 300);
                setTimeout(function () { if (m) { m.invalidateSize(); } }, 600);
                setTimeout(function () { if (m) { m.invalidateSize(); } }, 1000);
            } catch (err) {
                console.error('Store map init error:', err);
            }
        }
    };
</script>
