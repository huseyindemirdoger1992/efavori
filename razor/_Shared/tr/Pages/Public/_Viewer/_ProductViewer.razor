    private async Task LoadReviewsAsync()
    {
        if (_product == null) return;
        _reviewsLoading = true;
        _reviewPage = 0;
        StateHasChanged();
        try
        {
            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);
            var productId = _product.Id;
            _reviewTotalCount = await db.Set<ProductReview>().AsNoTracking()
                .CountAsync(r => r.ProductId == productId &&
                                 (r.IsDeleted == null || r.IsDeleted.IsDeletedStatu != true), token);
            var parentReviews = await db.Set<ProductReview>().AsNoTracking()
                .Where(r => r.ProductId == productId &&
                            r.ParentReviewId == null &&
                            (r.IsDeleted == null || r.IsDeleted.IsDeletedStatu != true))
                .OrderByDescending(r => r.CreatedAt)
                .Skip(0).Take(REVIEW_PAGE_SIZE)
                .ToListAsync(token);
            var parentIds = parentReviews.Select(r => r.Id).ToList();
            var childReviews = parentIds.Any()
                ? await db.Set<ProductReview>().AsNoTracking()
                    .Where(r => r.ParentReviewId != null &&
                                parentIds.Contains(r.ParentReviewId.Value) &&
                                (r.IsDeleted == null || r.IsDeleted.IsDeletedStatu != true))
                    .OrderBy(r => r.CreatedAt).ToListAsync(token)
                : new List<ProductReview>();
            var userIds = parentReviews.Select(r => r.UserId).Concat(childReviews.Select(r => r.UserId)).Distinct().ToList();
            var userNames = userIds.Any()
                ? await db.Set<Users>().AsNoTracking()
                    .Where(u => userIds.Contains(u.Id))
                    .Select(u => new { u.Id, u.FirstName, u.LastName })
                    .ToDictionaryAsync(u => u.Id, u => $"{u.FirstName} {u.LastName}".Trim(), token)
                : new Dictionary<Guid, string>();
            string ResolveName(Guid userId) =>
                userNames.TryGetValue(userId, out var name) && !string.IsNullOrEmpty(name) ? name : "Kullanıcı";
            _reviewList = parentReviews.Select(r => new ReviewDisplayDto
            {
                Id = r.Id,
                UserId = r.UserId,
                UserDisplayName = ResolveName(r.UserId),
                CommentText = r.CommentText,
                ParentReviewId = null,
                CreatedAt = r.CreatedAt,
                Rating = Random.Shared.Next(30, 51) / 10.0,
                Children = childReviews.Where(c => c.ParentReviewId == r.Id).Select(c => new ReviewDisplayDto
                {
                    Id = c.Id,
                    UserId = c.UserId,
                    UserDisplayName = ResolveName(c.UserId),
                    CommentText = c.CommentText,
                    ParentReviewId = c.ParentReviewId,
                    CreatedAt = c.CreatedAt,
                    Children = new()
                }).ToList()
            }).ToList();
            var totalParents = await db.Set<ProductReview>().AsNoTracking()
                .CountAsync(r => r.ProductId == productId && r.ParentReviewId == null &&
                                 (r.IsDeleted == null || r.IsDeleted.IsDeletedStatu != true), token);
            _reviewHasMore = parentReviews.Count >= REVIEW_PAGE_SIZE && (_reviewPage + 1) * REVIEW_PAGE_SIZE < totalParents;
            _reviewsLoaded = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { await LogError("LoadReviews", ex); await Notify("danger", "Hata", "Yorumlar yüklenirken sorun oluştu."); }
        finally { _reviewsLoading = false; StateHasChanged(); }
    }

