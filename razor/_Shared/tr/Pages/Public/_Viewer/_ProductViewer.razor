            _isFollowingStore = false;
            _storeShipId = null;
            await Notify("info", "Engel", "Mağaza engeli kaldırıldı.");
            await Logger.TakeIt(use.Id, PAGE_TITLE, "StoreBlock", "unblock", _store?.Name);
        }
        catch (Exception ex) { await LogError("UnblockStore", ex); await Notify("danger", "Hata", "İşlem sırasında bir sorun oluştu."); }
        finally { _storeActionLoading = false; StateHasChanged(); }
    }

