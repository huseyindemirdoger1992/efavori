    // ─── SEO: İlgili/Benzer Ürünler ───────────────────────────────
    private List<RelatedProductDto> _relatedProducts = new();

    // ═══════════════════════════════════════════════════════════════
    // YAŞAM DÖNGÜSÜ
    // ═══════════════════════════════════════════════════════════════

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedProduct != null && SelectedProduct.Id != _loadedProductId)
        {
            _loadedProductId = SelectedProduct.Id;
            await LoadAllAsync();
        }
        else if (SelectedProduct == null && !_disposed)
        {
            _loading = false;
        }
    }

    protected override void OnInitialized()
    {
        StateHub.OnDataChanged += HandleDataChanged;
    }

    // ─── Zoom JS Enjeksiyonu ──────────────────────────────────────
    private bool _zoomJsInjected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_product != null && !_zoomJsInjected)
        {
            _zoomJsInjected = true;
            await JS.InvokeVoidAsync("eval", @"
(function(){
    if(window.__ppZoomInit) return;
    window.__ppZoomInit = true;

    function setup(){
        var box = document.getElementById('ppMediaMain');
        var lens = document.getElementById('ppZoomLens');
        var result = document.getElementById('ppZoomResult');
        if(!box || !lens || !result){ setTimeout(setup, 300); return; }

        var Z = 2;
        var MIN_Z = 2;
        var MAX_Z = 10;
        var on = false;

        function mobile(){ return window.innerWidth < 992; }

        /* ═══ DESKTOP: HOVER + SCROLL WHEEL ZOOM (2x–10x) ═══ */
        box.addEventListener('mouseenter', function(){
            if(mobile()) return;
            var img = box.querySelector('#ppMainImg');
            if(!img) return;
            on = true;
            var r = box.getBoundingClientRect();
            var rw = result.offsetWidth || r.width;
            var rh = result.offsetHeight || r.height;
            lens.style.width = (rw/Z)+'px';
            lens.style.height = (rh/Z)+'px';
            result.style.backgroundImage = 'url('+img.src+')';
            result.style.backgroundSize = (r.width*Z)+'px '+(r.height*Z)+'px';
            lens.style.opacity = '1';
            result.style.opacity = '1';
            result.style.visibility = 'visible';
            box.style.cursor = 'crosshair';
        });

        box.addEventListener('mousemove', function(e){
            if(!on || mobile()) return;
            var r = box.getBoundingClientRect();
            var lw = lens.offsetWidth, lh = lens.offsetHeight;
            var x = e.clientX - r.left - lw/2;
            var y = e.clientY - r.top - lh/2;
            x = Math.max(0, Math.min(x, r.width - lw));
            y = Math.max(0, Math.min(y, r.height - lh));
            lens.style.transform = 'translate('+x+'px,'+y+'px)';
            result.style.backgroundPosition = '-'+(x*Z)+'px -'+(y*Z)+'px';
        });

        box.addEventListener('mouseleave', function(){
            on = false;
            lens.style.opacity = '0';
            result.style.opacity = '0';
            result.style.visibility = 'hidden';
            box.style.cursor = '';
        });

        /* Scroll wheel ile zoom seviyesi ayarı (2x–10x) */
        box.addEventListener('wheel', function(e){
            if(mobile() || !on) return;
            e.preventDefault();
            var step = e.deltaY < 0 ? 0.5 : -0.5;
            Z = Math.max(MIN_Z, Math.min(MAX_Z, Z + step));

            var img = box.querySelector('#ppMainImg');
            if(!img) return;
            var r = box.getBoundingClientRect();
            var rw = result.offsetWidth || r.width;
            var rh = result.offsetHeight || r.height;
            lens.style.width = (rw/Z)+'px';
            lens.style.height = (rh/Z)+'px';
            result.style.backgroundSize = (r.width*Z)+'px '+(r.height*Z)+'px';

            /* Lens pozisyonunu yeniden hesapla */
            var ct = lens.style.transform;
            var m = ct.match(/translate\((.+?)px,\s*(.+?)px\)/);
            if(m){
                var lx = parseFloat(m[1]), ly = parseFloat(m[2]);
                var lw = lens.offsetWidth, lh = lens.offsetHeight;
                lx = Math.max(0, Math.min(lx, r.width - lw));
                ly = Math.max(0, Math.min(ly, r.height - lh));
                lens.style.transform = 'translate('+lx+'px,'+ly+'px)';
                result.style.backgroundPosition = '-'+(lx*Z)+'px -'+(ly*Z)+'px';
            }
        }, {passive:false});

        /* ═══ MOBİL: PINCH (2x–10x) + PAN + DOUBLE-TAP ═══ */
        var ts = {
            scale:1, sd:0, ss:1, pinch:false,
            panX:0, panY:0, lastPanX:0, lastPanY:0,
            panning:false, startX:0, startY:0
        };

        function dist(t){
            var dx=t[0].clientX-t[1].clientX, dy=t[0].clientY-t[1].clientY;
            return Math.sqrt(dx*dx+dy*dy);
        }

        function clampPan(img){
            if(ts.scale <= 1){ ts.panX=0; ts.panY=0; return; }
            var mxX = (ts.scale-1)*img.offsetWidth/2;
            var mxY = (ts.scale-1)*img.offsetHeight/2;
            ts.panX = Math.max(-mxX, Math.min(mxX, ts.panX));
            ts.panY = Math.max(-mxY, Math.min(mxY, ts.panY));
        }

        function applyMobileTransform(img){
            clampPan(img);
            img.style.transform = 'scale('+ts.scale+') translate('+(ts.panX/ts.scale)+'px,'+(ts.panY/ts.scale)+'px)';
            img.style.transformOrigin = 'center center';

            /* Zoom seviye göstergesi */
            var badge = document.getElementById('ppZoomBadge');
            if(badge){
                if(ts.scale > 1.05){
                    badge.textContent = 'x'+ts.scale.toFixed(1);
                    badge.style.opacity = '1';
                } else {
                    badge.style.opacity = '0';
                }
            }
        }

        function resetMobile(img){
            ts.scale=1; ts.panX=0; ts.panY=0;
            img.style.transform = '';
            img.style.transformOrigin = '';
            var badge = document.getElementById('ppZoomBadge');
            if(badge) badge.style.opacity = '0';
        }

        /* Double-tap algılama */
        var lastTap = 0;
        box.addEventListener('touchend', function(e){
            if(!mobile()) return;
            var img = box.querySelector('#ppMainImg');
            if(!img) return;

            if(e.touches.length === 0 && !ts.pinch){
                var now = Date.now();
                if(now - lastTap < 300){
                    e.preventDefault();
                    if(ts.scale > 1.05){ resetMobile(img); }
                    else { ts.scale = MIN_Z; ts.panX=0; ts.panY=0; applyMobileTransform(img); }
                    lastTap = 0;
                    return;
                }
                lastTap = now;
            }

            if(e.touches.length < 2){
                ts.pinch = false;
                if(ts.scale <= 1.05) resetMobile(img);
            }
            ts.panning = false;
        });

        box.addEventListener('touchstart', function(e){
            if(!mobile()) return;
            if(e.touches.length === 2){
                e.preventDefault();
                ts.pinch = true;
                ts.sd = dist(e.touches);
                ts.ss = ts.scale;
            } else if(e.touches.length === 1 && ts.scale > 1.05){
                ts.panning = true;
                ts.startX = e.touches[0].clientX;
                ts.startY = e.touches[0].clientY;
                ts.lastPanX = ts.panX;
                ts.lastPanY = ts.panY;
                e.preventDefault();
            }
        }, {passive:false});

        box.addEventListener('touchmove', function(e){
            if(!mobile()) return;
            var img = box.querySelector('#ppMainImg');
            if(!img) return;

            if(ts.pinch && e.touches.length === 2){
                e.preventDefault();
                ts.scale = Math.max(1, Math.min(MAX_Z, ts.ss*(dist(e.touches)/ts.sd)));
                applyMobileTransform(img);
            } else if(ts.panning && e.touches.length === 1 && ts.scale > 1.05){
                e.preventDefault();
                ts.panX = ts.lastPanX + (e.touches[0].clientX - ts.startX);
                ts.panY = ts.lastPanY + (e.touches[0].clientY - ts.startY);
                applyMobileTransform(img);
            }
        }, {passive:false});

        /* Görsel değiştiğinde mobil zoom sıfırla + masaüstü güncelle */
        var obs = new MutationObserver(function(muts){
            muts.forEach(function(m){
                if(m.type==='attributes' && m.attributeName==='src'){
                    var img = box.querySelector('#ppMainImg');
                    if(!img) return;
                    resetMobile(img);
                    if(on){
                        var r = box.getBoundingClientRect();
                        result.style.backgroundImage='url('+img.src+')';
                        result.style.backgroundSize=(r.width*Z)+'px '+(r.height*Z)+'px';
                    }
                }
            });
        });
        var tgt = box.querySelector('#ppMainImg');
        if(tgt) obs.observe(tgt, {attributes:true, attributeFilter:['src']});
    }

    setup();
    setInterval(function(){ var el=document.getElementById('ppMediaMain'); if(el && !el.__ppZ){ el.__ppZ=true; window.__ppZoomInit=false; setup(); } }, 1000);
})();
");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        StateHub.OnDataChanged -= HandleDataChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        _loadSemaphore.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task HandleDataChanged(string entityName)
    {
        if (_disposed || _product == null) return;
        if (entityName != "Products" && entityName != "ProductPrices" && entityName != "ProductStocks" && entityName != "Store" && entityName != "StoreShip" && entityName != "ProductReview")
            return;
        await InvokeAsync(async () => { await LoadAllAsync(); StateHasChanged(); });
    }

    // ═══════════════════════════════════════════════════════════════
    // ANA YÜKLEME
    // ═══════════════════════════════════════════════════════════════

    private async Task LoadAllAsync()
    {
        if (SelectedProduct == null) { _loading = false; return; }
        if (!await _loadSemaphore.WaitAsync(0)) return;

        try
        {
            _loading = true;
            StateHasChanged();

            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);

            // 1) Ürünü tazele
            _product = await db.Set<Products>().AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == SelectedProduct.Id &&
                                          x.IsActive &&
                                          x.IsDeleted.IsDeletedStatu != true, token)
                       ?? SelectedProduct;

            var productId = _product.Id;

            // Görüntülenme logla
            await Logger.TakeIt(use?.Id, PAGE_TITLE, "ProductView", "details", _product.Name);

            // ─── Ziyaret geçmişi kaydet ───
            try
            {
                var seoRecordId = await db.Set<ProductSeo>().AsNoTracking()
                    .Where(s => s.ProductId == productId)
                    .OrderByDescending(s => s.CreatedAt)
                    .Select(s => (Guid?)s.Id)
                    .FirstOrDefaultAsync(token);

                db.Set<ProductHistory>().Add(new ProductHistory
                {
                    UserId = use?.Id,
                    ProductId = productId,
                    ProductSlug = seoRecordId
                });

                await db.Set<Products>()
                    .Where(p => p.Id == productId)
                    .ExecuteUpdateAsync(s => s.SetProperty(
                        p => p.InteractionCounts.ViewCount,
                        p => (p.InteractionCounts.ViewCount ?? 0) + 1
                    ), token);

                await db.SaveChangesAsync(token);
            }
            catch { /* Ziyaret kaydı başarısız olursa sayfa akışını bozma */ }

            // 2) Slug (SEO)
            _slug = await db.Set<ProductSeo>().AsNoTracking()
                .Where(s => s.ProductId == productId)
                .OrderByDescending(s => s.CreatedAt)
                .Select(s => s.Slug)
                .FirstOrDefaultAsync(token) ?? productId.ToString();

            // 3) Marka
            if (_product.BrandId.HasValue)
            {
                _brandName = await db.Set<Brands>().AsNoTracking()
                    .Where(b => b.Id == _product.BrandId.Value)
                    .Select(b => b.Name)
                    .FirstOrDefaultAsync(token);
            }

            // 4) Mağaza
            _store = await db.Set<Store>().AsNoTracking()
                .FirstOrDefaultAsync(s => s.Id == _product.StoreId, token);
            _storeProfileUrl = _store?.ProfileCoverGallery?.ProfileImagePath;

            // 4b) Mağaza galeri görselleri
            if (_store != null)
                await LoadStoreGalleryAsync(db, _store.Id, token);

            // 4c) Mağaza takip/engel durumu
            if (_store != null && use != null && _store.UserId.HasValue)
                await LoadStoreShipStatusAsync(db, token);

            // 5) Kategori breadcrumb
            await LoadBreadcrumbAsync(db, productId, token);

            // 6) Varyantlar + değerleri
            await LoadVariantsAsync(db, productId, token);

            // 7) Görseller
            await LoadImagesAsync(db, productId, token);

            // 8) Spesifikasyonlar
            await LoadSpecificationsAsync(db, productId, token);

            // 9) Harici medya
            _externalMedias = await db.Set<ProductExternalMedias>().AsNoTracking()
                .Where(em => em.ProductId == productId)
                .OrderBy(em => em.DisplayOrder)
                .ToListAsync(token);

            // 10) Seçili varyanta göre fiyat & stok
            await RefreshSelectedVariantDataAsync(db, token);

            // 11) Yorum sayısı (sekme badge için)
            _reviewTotalCount = await db.Set<ProductReview>().AsNoTracking()
                .CountAsync(r => r.ProductId == productId &&
                                 (r.IsDeleted == null || r.IsDeleted.IsDeletedStatu != true), token);

            // 12) Döviz kuru
            MoneyExchangeRate = await db.Set<MoneyExchangeRate>()
                .AsNoTracking()
                .OrderByDescending(m => m.CreatedAt)
                .FirstOrDefaultAsync(token);

            // 13) SEO: İlgili ürünler
            await LoadRelatedProductsAsync(db, productId, token);

            // 14) SEO: Ortalama puan (eğer puanlama verisi varsa)
            await LoadAverageRatingAsync(db, productId, token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await LogError("LoadAll", ex);
            await Notify("danger", "Hata", "Ürün bilgileri yüklenirken sorun oluştu.");
        }
        finally
        {
            _loading = false;
            _loadSemaphore.Release();
            if (!_disposed) StateHasChanged();
        }
    }

    // ─── BREADCRUMB ──────────────────────────────────────────────
    private async Task LoadBreadcrumbAsync(_ApplicationConnectionDb db, Guid productId, CancellationToken token)
    {
        _breadcrumbCategories.Clear();

        var catId = await db.Set<ProductCategories>().AsNoTracking()
            .Where(pc => pc.ProductId == productId)
            .OrderByDescending(pc => pc.IsPrimary)
            .Select(pc => (int?)pc.CategoryId)
            .FirstOrDefaultAsync(token);

        if (catId == null) return;

        var allCats = await db.Set<CategoriesTr>().AsNoTracking()
            .ToDictionaryAsync(c => c.Id, c => c, token);

        var path = new List<CategoriesTr>();
        var current = allCats.GetValueOrDefault(catId.Value);
        var guard = 0;
        while (current != null && guard++ < 20)
        {
            path.Insert(0, current);
            current = current.ParentCategoryId.HasValue ? allCats.GetValueOrDefault(current.ParentCategoryId.Value) : null;
        }
        _breadcrumbCategories = path;
    }

    // ─── VARYANTLAR ──────────────────────────────────────────────
    private async Task LoadVariantsAsync(_ApplicationConnectionDb db, Guid productId, CancellationToken token)
    {
        var rawVariants = await db.Set<ProductVariants>().AsNoTracking()
            .Where(v => v.ProductId == productId &&
                        v.IsActive &&
                        v.IsDeleted.IsDeletedStatu != true)
            .OrderByDescending(v => v.IsDefault)
            .ThenBy(v => v.DisplayOrder)
            .Select(v => new { v.Id, v.Sku, v.Barcode, v.IsDefault })
            .ToListAsync(token);

        var variantIds = rawVariants.Select(v => v.Id).ToList();

        var variantValues = await db.Set<ProductVariantValues>().AsNoTracking()
            .Where(vv => variantIds.Contains(vv.VariantId))
            .ToListAsync(token);

        var attrIds = variantValues.Select(vv => vv.AttributeId).Distinct().ToList();
        var valueIds = variantValues.Select(vv => vv.AttributeValueId).Distinct().ToList();

        var attrs = await db.Set<ProductAttributes>().AsNoTracking()
            .Where(a => attrIds.Contains(a.Id))
            .Select(a => new { a.Id, a.Name, a.DisplayOrder })
            .ToListAsync(token);
        var attrNames = attrs.ToDictionary(a => a.Id, a => a);

        var vals = await db.Set<ProductAttributeValues>().AsNoTracking()
            .Where(av => valueIds.Contains(av.Id))
            .Select(av => new { av.Id, av.AttributeId, av.Value, av.ColorHex, av.DisplayOrder })
            .ToListAsync(token);
        var valInfo = vals.ToDictionary(v => v.Id, v => v);

        _variants = rawVariants.Select(v => new VariantInfo
        {
            VariantId = v.Id,
            Sku = v.Sku,
            Barcode = v.Barcode,
            IsDefault = v.IsDefault,
            ValuePairs = variantValues
                .Where(vv => vv.VariantId == v.Id)
                .Select(vv => (vv.AttributeId, vv.AttributeValueId))
                .ToList()
        }).ToList();

        _selectedVariant = _variants.FirstOrDefault(v => v.IsDefault) ?? _variants.FirstOrDefault();

        _selectedAttributeValues.Clear();
        if (_selectedVariant != null)
            foreach (var (aId, vId) in _selectedVariant.ValuePairs)
                _selectedAttributeValues[aId] = vId;

        _variantAttributes = attrIds
            .Select(aId =>
            {
                var groupValues = variantValues
                    .Where(vv => vv.AttributeId == aId)
                    .Select(vv => vv.AttributeValueId)
                    .Distinct()
                    .Select(vId => valInfo.TryGetValue(vId, out var vi)
                        ? new VariantValueItem { ValueId = vId, ValueName = vi.Value, ColorHex = vi.ColorHex, DisplayOrder = vi.DisplayOrder }
                        : new VariantValueItem { ValueId = vId, ValueName = "—" })
                    .OrderBy(x => x.DisplayOrder)
                    .ToList();

                return new VariantAttributeGroup
                {
                    AttributeId = aId,
                    AttributeName = attrNames.TryGetValue(aId, out var an) ? (an.Name ?? "Özellik") : "Özellik",
                    DisplayOrder = attrNames.TryGetValue(aId, out var an2) ? an2.DisplayOrder : 0,
                    Values = groupValues
                };
            })
            .Where(g => g.Values.Any())
            .OrderBy(g => g.DisplayOrder)
            .ToList();
    }

    // ─── GÖRSELLER ───────────────────────────────────────────────
    private async Task LoadImagesAsync(_ApplicationConnectionDb db, Guid productId, CancellationToken token)
    {
        var images = new List<string>();

        // Kapak görseli
        if (_product?.CoverMediaId != null)
        {
            var coverUrl = await db.Set<Data.Media>().AsNoTracking()
                .Where(m => m.Id == _product.CoverMediaId.Value && m.IsDeletedStatu != true)
                .Select(m => m.FileUrl ?? m.FileUrl_Ratio_1_2 ?? m.FileUrl)
                .FirstOrDefaultAsync(token);
            if (!string.IsNullOrEmpty(coverUrl)) images.Add(coverUrl);
        }

        // Genel galeri (ItemGallery)
        var galleryItems = await db.Set<ItemGallery>().AsNoTracking()
            .Where(ig => ig.ItemId == productId &&
                         ig.IsDelete != true &&
                         (ig.ItemType == "Product" || ig.ItemType == "ProductGallery"))
            .OrderBy(ig => ig.ItemAddDate)
            .Select(ig => ig.MediaId)
            .ToListAsync(token);

        var galleryMediaIds = galleryItems.Where(id => id.HasValue).Select(id => id!.Value).Distinct().ToList();
        if (galleryMediaIds.Any())
        {
            var galleryMedia = await db.Set<Data.Media>().AsNoTracking()
                .Where(m => galleryMediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                .ToDictionaryAsync(m => m.Id, m => m.FileUrl ?? m.FileUrl_Ratio_1_2 ?? m.FileUrl_Ratio_1_4 ?? "", token);

            foreach (var gid in galleryItems.Where(id => id.HasValue).Select(id => id!.Value))
                if (galleryMedia.TryGetValue(gid, out var url) && !string.IsNullOrEmpty(url) && !images.Contains(url))
                    images.Add(url);
        }

        // Varyant görsel grupları
        var variantGroups = await db.Set<ProductImageVariantGroups>().AsNoTracking()
            .Where(g => g.ProductId == productId)
            .Select(g => new { g.AttributeValueId, g.CoverMediaId })
            .ToListAsync(token);

        _variantGroupCovers.Clear();
        var groupMediaIds = variantGroups.Where(g => g.CoverMediaId.HasValue).Select(g => g.CoverMediaId!.Value).Distinct().ToList();
        if (groupMediaIds.Any())
        {
            var groupMedia = await db.Set<Data.Media>().AsNoTracking()
                .Where(m => groupMediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                .ToDictionaryAsync(m => m.Id, m => m.FileUrl ?? m.FileUrl_Ratio_1_2 ?? m.FileUrl_Ratio_1_4 ?? "", token);

            foreach (var g in variantGroups)
                if (g.CoverMediaId.HasValue && groupMedia.TryGetValue(g.CoverMediaId.Value, out var url))
                    _variantGroupCovers[g.AttributeValueId] = g.CoverMediaId;
        }

        _baseImages = images;
        _displayImages = images.Any() ? new List<string>(images) : new List<string>();
        _activeImageIndex = 0;
    }

    // ─── SPESİFİKASYONLAR ────────────────────────────────────────
    private async Task LoadSpecificationsAsync(_ApplicationConnectionDb db, Guid productId, CancellationToken token)
    {
        var specs = await db.Set<ProductSpecifications>().AsNoTracking()
            .Where(s => s.ProductId == productId)
            .OrderBy(s => s.DisplayOrder)
            .ToListAsync(token);

        var attrIds = specs.Where(s => s.AttributeId.HasValue).Select(s => s.AttributeId!.Value).Distinct().ToList();
        var valIds = specs.Where(s => s.AttributeValueId.HasValue).Select(s => s.AttributeValueId!.Value).Distinct().ToList();

        var attrNames = attrIds.Any()
            ? await db.Set<ProductAttributes>().AsNoTracking()
                .Where(a => attrIds.Contains(a.Id))
                .ToDictionaryAsync(a => a.Id, a => (Name: a.Name, Unit: a.Unit), token)
            : new Dictionary<Guid, (string? Name, string? Unit)>();

        var valNames = valIds.Any()
            ? await db.Set<ProductAttributeValues>().AsNoTracking()
                .Where(v => valIds.Contains(v.Id))
                .ToDictionaryAsync(v => v.Id, v => v.Value, token)
            : new Dictionary<Guid, string?>();

        _specifications = specs.Select(s =>
        {
            string name;
            string value;

            if (s.AttributeId.HasValue && attrNames.TryGetValue(s.AttributeId.Value, out var an))
            {
                name = an.Name ?? s.CustomName ?? "—";
                if (s.AttributeValueId.HasValue && valNames.TryGetValue(s.AttributeValueId.Value, out var vn))
                    value = vn ?? s.CustomValue ?? "—";
                else
                    value = s.CustomValue ?? "—";
                if (!string.IsNullOrEmpty(an.Unit)) value = $"{value} {an.Unit}";
            }
            else
            {
                name = s.CustomName ?? "—";
                value = s.CustomValue ?? "—";
            }

            return new SpecRow { Name = name, Value = value };
        }).ToList();
    }

    // ─── MAĞAZA GALERİ ───────────────────────────────────────────
    private async Task LoadStoreGalleryAsync(_ApplicationConnectionDb db, Guid storeId, CancellationToken token)
    {
        _storeGalleryImages.Clear();

        var galleryMediaIds = await db.Set<ItemGallery>().AsNoTracking()
            .Where(ig => ig.ItemId == storeId &&
                         ig.IsDelete != true &&
                         (ig.ItemType == "InShooting" || ig.ItemType == "OutShooting"))
            .OrderBy(ig => ig.ItemAddDate)
            .Select(ig => ig.MediaId)
            .Take(6)
            .ToListAsync(token);

        var mediaIds = galleryMediaIds.Where(id => id.HasValue).Select(id => id!.Value).Distinct().ToList();
        if (!mediaIds.Any()) return;

        var mediaUrls = await db.Set<Data.Media>().AsNoTracking()
            .Where(m => mediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
            .ToDictionaryAsync(m => m.Id, m => m.FileUrl_Ratio_1_4 ?? m.FileUrl_Ratio_1_8 ?? m.FileUrl ?? "", token);

        foreach (var mid in galleryMediaIds.Where(id => id.HasValue).Select(id => id!.Value))
            if (mediaUrls.TryGetValue(mid, out var url) && !string.IsNullOrEmpty(url))
                _storeGalleryImages.Add(url);
    }

    // ─── MAĞAZA TAKİP/ENGEL DURUMU ──────────────────────────────
    private async Task LoadStoreShipStatusAsync(_ApplicationConnectionDb db, CancellationToken token)
    {
        _isFollowingStore = false;
        _isStoreBlocked = false;
        _storeShipId = null;

        if (use == null || _store?.UserId == null) return;

        var ship = await db.Set<StoreShip>().AsNoTracking()
            .FirstOrDefaultAsync(s => s.RequestorId == use.Id &&
                                      s.ReceiverId == _store.UserId.Value &&
                                      (s.IsDeleted == null || s.IsDeleted.IsDeletedStatu != true), token);

        if (ship != null)
        {
            _storeShipId = ship.Id;
            _isStoreBlocked = ship.Block == true;
            _isFollowingStore = !_isStoreBlocked && ship.Status == true;
        }

        // Toplam takipçi sayısı
        _storeFollowerCount = await db.Set<StoreShip>().AsNoTracking()
            .CountAsync(s => s.ReceiverId == _store.UserId.Value &&
                             s.Status == true &&
                             s.Block != true &&
                             (s.IsDeleted == null || s.IsDeleted.IsDeletedStatu != true), token);
    }

    // ─── SEÇİLİ VARYANT → FİYAT & STOK ───────────────────────────
    private async Task RefreshSelectedVariantDataAsync(_ApplicationConnectionDb db, CancellationToken token)
    {
        if (_selectedVariant == null)
        {
            _currentPrice = null; _otherCurrencyPrices.Clear();
            _currentStockQty = 0; _hasStockData = false;
            return;
        }

        var variantId = _selectedVariant.VariantId;

        var prices = await db.Set<ProductPrices>().AsNoTracking()
            .Where(pp => pp.VariantId == variantId && pp.EffectiveTo == null)
            .Select(pp => new PriceInfo
            {
                Currency = pp.Currency,
                Price = pp.Price,
                DiscountedPrice = pp.DiscountedPrice
            })
            .ToListAsync(token);

        _currentPrice = prices.FirstOrDefault(p => p.Currency == "TRY") ?? prices.FirstOrDefault();
        _otherCurrencyPrices = prices.Where(p => p != _currentPrice).ToList();

        _currentDiscountPercent = 0;
        if (_currentPrice != null && _currentPrice.DiscountedPrice.HasValue &&
            _currentPrice.DiscountedPrice < _currentPrice.Price && _currentPrice.Price > 0)
        {
            _currentDiscountPercent = (int)Math.Round(100 - (_currentPrice.DiscountedPrice.Value / _currentPrice.Price * 100));
        }

        var stockRows = await db.Set<ProductStocks>().AsNoTracking()
            .Where(s => s.VariantId == variantId)
            .Select(s => new { s.Quantity, s.TrackStock, s.MaxOrderQuantity })
            .ToListAsync(token);

        _hasStockData = stockRows.Any(s => s.TrackStock);
        _currentStockQty = stockRows.Where(s => s.TrackStock).Sum(s => s.Quantity);
        _maxOrderQty = stockRows.Where(s => s.MaxOrderQuantity.HasValue).Select(s => s.MaxOrderQuantity).Min();

        if (_maxOrderQty.HasValue && _quantity > _maxOrderQty.Value) _quantity = _maxOrderQty.Value;
        if (_quantity < 1) _quantity = 1;
    }

    // ─── SEO: İLGİLİ ÜRÜNLER ─────────────────────────────────────
    private async Task LoadRelatedProductsAsync(_ApplicationConnectionDb db, Guid productId, CancellationToken token)
    {
        _relatedProducts.Clear();

        try
        {
            // Ürünün birincil kategorisini bul
            var primaryCatId = await db.Set<ProductCategories>().AsNoTracking()
                .Where(pc => pc.ProductId == productId)
                .OrderByDescending(pc => pc.IsPrimary)
                .Select(pc => (int?)pc.CategoryId)
                .FirstOrDefaultAsync(token);

            if (primaryCatId == null) return;

            // Aynı kategorideki diğer aktif ürünleri getir
            var relatedProductIds = await db.Set<ProductCategories>().AsNoTracking()
                .Where(pc => pc.CategoryId == primaryCatId.Value && pc.ProductId != productId)
                .Select(pc => pc.ProductId)
                .Distinct()
                .Take(12)
                .ToListAsync(token);

            if (!relatedProductIds.Any()) return;

            var relatedProducts = await db.Set<Products>().AsNoTracking()
                .Where(p => relatedProductIds.Contains(p.Id) &&
                            p.IsActive &&
                            (p.IsDeleted == null || p.IsDeleted.IsDeletedStatu != true))
                .Select(p => new { p.Id, p.Name, p.CoverMediaId })
                .Take(8)
                .ToListAsync(token);

            // Slug bilgilerini çek
            var rpIds = relatedProducts.Select(rp => rp.Id).ToList();
            var slugs = await db.Set<ProductSeo>().AsNoTracking()
                .Where(s => rpIds.Contains(s.ProductId))
                .GroupBy(s => s.ProductId)
                .Select(g => new { ProductId = g.Key, Slug = g.OrderByDescending(x => x.CreatedAt).First().Slug })
                .ToDictionaryAsync(x => x.ProductId, x => x.Slug, token);

            // Kapak görseli URL'lerini çek
            var coverMediaIds = relatedProducts
                .Where(rp => rp.CoverMediaId.HasValue)
                .Select(rp => rp.CoverMediaId!.Value)
                .Distinct()
                .ToList();

            var coverUrls = coverMediaIds.Any()
                ? await db.Set<Data.Media>().AsNoTracking()
                    .Where(m => coverMediaIds.Contains(m.Id) && m.IsDeletedStatu != true)
                    .ToDictionaryAsync(m => m.Id, m => m.FileUrl_Ratio_1_4 ?? m.FileUrl_Ratio_1_8 ?? m.FileUrl ?? "", token)
                : new Dictionary<Guid, string>();

            // İlgili ürünlerin varsayılan varyant fiyatlarını çek
            var relatedVariants = await db.Set<ProductVariants>().AsNoTracking()
                .Where(v => rpIds.Contains(v.ProductId) && v.IsActive && v.IsDefault)
                .Select(v => new { v.Id, v.ProductId })
                .ToListAsync(token);
            var rvIds = relatedVariants.Select(v => v.Id).ToList();

            var relatedPrices = rvIds.Any()
                ? await db.Set<ProductPrices>().AsNoTracking()
                    .Where(pp => rvIds.Contains(pp.VariantId) && pp.EffectiveTo == null && pp.Currency == "TRY")
                    .GroupBy(pp => pp.VariantId)
                    .Select(g => new { VariantId = g.Key, Price = g.First().DiscountedPrice ?? g.First().Price })
                    .ToDictionaryAsync(x => x.VariantId, x => x.Price, token)
                : new Dictionary<Guid, decimal>();

            var variantProductMap = relatedVariants.ToDictionary(v => v.Id, v => v.ProductId);

            _relatedProducts = relatedProducts.Select(rp =>
            {
                var slug = slugs.GetValueOrDefault(rp.Id, rp.Id.ToString());
                var coverUrl = rp.CoverMediaId.HasValue && coverUrls.TryGetValue(rp.CoverMediaId.Value, out var cu) ? cu : null;
                var variant = relatedVariants.FirstOrDefault(v => v.ProductId == rp.Id);
                decimal? price = variant != null && relatedPrices.TryGetValue(variant.Id, out var pr) ? pr : null;

                return new RelatedProductDto
                {
                    ProductId = rp.Id,
                    Name = rp.Name ?? "Ürün",
                    Slug = slug,
                    CoverImageUrl = coverUrl,
                    Price = price
                };
            }).ToList();
        }
        catch { /* İlgili ürünler yüklenemezse ana akışı bozma */ }
    }

