                       target="_blank" rel="noopener nofollow" class="btn btn-outline-primary btn-lg rounded-circle"
                       style="width:52px; height:52px;" title="Facebook" aria-label="Facebook ile paylaş"><i class="fa fa-facebook" aria-hidden="true"></i></a>
                    <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(shareUrl)"
                       target="_blank" rel="noopener nofollow" class="btn btn-outline-info btn-lg rounded-circle"
                       style="width:52px; height:52px;" title="X (Twitter)" aria-label="X ile paylaş"><i class="fa fa-twitter" aria-hidden="true"></i></a>
                </div>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control bg-transparent text-light border-secondary" value="@shareUrl" readonly aria-label="Paylaşım linki" />
                    <button class="btn btn-outline-info" @onclick="() => CopyToClipboard(shareUrl)" title="Kopyala" aria-label="Linki kopyala">
                        <i class="fa fa-copy" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    // ─── Sabitler ─────────────────────────────────────────────────
    private const string PAGE_TITLE = "Ürün İnceleme";
