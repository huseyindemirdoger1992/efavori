    private async Task ToggleFollowStore()
    {
        if (use == null || _store?.UserId == null || _storeActionLoading) return;
        _storeActionLoading = true;
        StateHasChanged();
        try
        {
            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);
            if (_isFollowingStore && _storeShipId.HasValue)
            {
                await db.Set<StoreShip>()
                    .Where(s => s.Id == _storeShipId.Value)
                    .ExecuteUpdateAsync(setters => setters
                        .SetProperty(s => s.IsDeleted!.IsDeletedStatu, true)
                        .SetProperty(s => s.IsDeleted!.DeletedAtDate, DateTime.UtcNow), token);
                _isFollowingStore = false;
                _storeShipId = null;
                _storeFollowerCount = Math.Max(0, _storeFollowerCount - 1);
                await Notify("info", "Takip", "Mağaza takipten çıkarıldı.");
            }
            else
            {
                var newShip = new StoreShip
                {
                    RequestorId = use.Id,
                    ReceiverId = _store.UserId.Value,
                    Status = true,
                    Block = false,
                    ActionDate = DateTime.UtcNow,
                    IsDeleted = new IsDeleted()
                };
                db.Set<StoreShip>().Add(newShip);
                await db.SaveChangesAsync(token);
                _storeShipId = newShip.Id;
                _isFollowingStore = true;
                _storeFollowerCount++;
                await Notify("success", "Takip", "Mağaza takip edilmeye başlandı!");
            }
            await Logger.TakeIt(use.Id, PAGE_TITLE, "StoreFollow",
                _isFollowingStore ? "follow" : "unfollow", _store.Name);
        }
        catch (Exception ex)
        {
            await LogError("ToggleFollowStore", ex);
            await Notify("danger", "Hata", "İşlem sırasında bir sorun oluştu.");
        }
        finally { _storeActionLoading = false; StateHasChanged(); }
    }

    private async Task BlockStore()
    {
        if (use == null || _store?.UserId == null || _storeActionLoading) return;
        _storeActionLoading = true;
        StateHasChanged();
        try
        {
            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);
            if (_storeShipId.HasValue)
            {
                await db.Set<StoreShip>()
                    .Where(s => s.Id == _storeShipId.Value)
                    .ExecuteUpdateAsync(setters => setters
                        .SetProperty(s => s.Block, true)
                        .SetProperty(s => s.Status, false)
                        .SetProperty(s => s.ActionDate, DateTime.UtcNow), token);
            }
            else
            {
                var newShip = new StoreShip
                {
                    RequestorId = use.Id,
                    ReceiverId = _store.UserId.Value,
                    Status = false,
                    Block = true,
                    ActionDate = DateTime.UtcNow,
                    IsDeleted = new IsDeleted()
                };
                db.Set<StoreShip>().Add(newShip);
                await db.SaveChangesAsync(token);
                _storeShipId = newShip.Id;
            }
            _isStoreBlocked = true;
            _isFollowingStore = false;
            if (_storeFollowerCount > 0) _storeFollowerCount--;
            await Notify("warning", "Engel", "Mağaza engellendi.");
            await Logger.TakeIt(use.Id, PAGE_TITLE, "StoreBlock", "block", _store.Name);
        }
        catch (Exception ex) { await LogError("BlockStore", ex); await Notify("danger", "Hata", "Engelleme sırasında bir sorun oluştu."); }
        finally { _storeActionLoading = false; StateHasChanged(); }
    }

    private async Task UnblockStore()
    {
        if (use == null || !_storeShipId.HasValue || _storeActionLoading) return;
        _storeActionLoading = true;
        StateHasChanged();
        try
        {
            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);
            await db.Set<StoreShip>()
                .Where(s => s.Id == _storeShipId.Value)
