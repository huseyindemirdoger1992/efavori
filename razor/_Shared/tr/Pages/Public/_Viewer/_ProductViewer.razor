    private void ChangeQuantity(int delta)
    {
        var next = _quantity + delta;
        if (next < 1) return;
        if (_maxOrderQty.HasValue && next > _maxOrderQty.Value) return;
        if (_hasStockData && next > _currentStockQty) return;
        _quantity = next;
    }

