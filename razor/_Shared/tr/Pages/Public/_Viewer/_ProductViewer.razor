                       style="width:52px; height:52px;" title="Facebook"><i class="fa fa-facebook"></i></a>
                    <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(shareUrl)"
                       target="_blank" rel="noopener" class="btn btn-outline-info btn-lg rounded-circle"
                       style="width:52px; height:52px;" title="X (Twitter)"><i class="fa fa-twitter"></i></a>
