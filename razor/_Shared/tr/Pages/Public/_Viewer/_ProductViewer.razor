<style>
    /* ═══ ZOOM SİSTEMİ (Amazon/eBay Tarzı — Masaüstü 2x–10x, Mobil Pinch 2x–10x) ═══ */
    .pp-zoom-wrapper {
        position: relative;
    }

    .pp-zoom-lens {
        position: absolute;
        top: 0;
        left: 0;
        border: 2px solid rgba(0,0,0,.15);
        background: rgba(255,255,255,.25);
        backdrop-filter: blur(1px);
        pointer-events: none;
        z-index: 10;
        opacity: 0;
        transition: opacity .15s ease;
        will-change: transform;
        box-shadow: 0 0 0 1px rgba(0,0,0,.06), inset 0 0 0 1px rgba(255,255,255,.3);
    }

    .pp-zoom-result {
        position: absolute;
        top: 0;
        left: calc(100% + 20px);
        width: 100%;
        aspect-ratio: 1 / 1;
        background-repeat: no-repeat;
        background-color: #ffffff;
        border: 1px solid rgba(0,0,0,.12);
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0,0,0,.15), 0 4px 16px rgba(0,0,0,.08);
        z-index: 1050;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .2s ease, visibility .2s ease;
    }

    /* Mobilde lens + result paneli gizle, yerine in-place pinch zoom çalışır */
    @@media (max-width: 991.98px) {
        .pp-zoom-result,
        .pp-zoom-lens {
            display: none !important;
        }
        /* Mobil zoom için touch-action ayarı — tarayıcı pinch'i ele geçirmesin */
        #ppMediaMain {
            touch-action: pan-x pan-y;
            overflow: hidden;
        }

        #ppMainImg {
            will-change: transform;
            transition: none;
        }
    }
</style>
