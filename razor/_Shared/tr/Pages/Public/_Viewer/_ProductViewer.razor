    // ─── SEO: YORUM RENDER HELPER — Review Microdata ─────────────
    private RenderFragment RenderReviewItem(ReviewDisplayDto review, int depth) => __builder =>
    {
        var marginStart = depth > 0 ? "ms-4 ps-3 border-start border-secondary border-opacity-25" : "";
        var isOwn = use != null && use.Id == review.UserId;
        var hasItemprop = depth == 0; // Sadece ana yorumlar itemprop alır

        <div class="mb-3 @marginStart"
             @(hasItemprop ? "itemprop=\" review\" itemscope itemtype=\"https://schema.org/Review\"" : "" )>
            @if (hasItemprop)
            {
                <meta itemprop="datePublished" content="@review.CreatedAt.ToString("yyyy-MM-dd")" />
                @if (review.Rating.HasValue && review.Rating > 0)
                {
                    <div itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating" class="d-none">
                        <meta itemprop="ratingValue" content="@review.Rating.Value" />
                        <meta itemprop="bestRating" content="5" />
                    </div>
                }
            }

            <div class="d-flex gap-2">
                @* Avatar *@
                <div class="flex-shrink-0">
                    <div class="rounded-circle d-flex align-items-center justify-content-center @(isOwn ? "bg-info bg-opacity-25" : "bg-secondary bg-opacity-25")"
                         style="width:36px; height:36px;">
                        <i class="fa fa-user @(isOwn ? "text-info" : "text-white-50")" style="font-size:.8rem;" aria-hidden="true"></i>
                    </div>
                </div>

                @* İçerik *@
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="text-light small fw-semibold"
                              @(hasItemprop ? "itemprop=\" author\" itemscope itemtype=\"https://schema.org/Person\"" : "" )>
                            @if (hasItemprop)
                            {
                                <span itemprop="name">@review.UserDisplayName</span>
                            }
                            else
                            {
                                @review.UserDisplayName
                            }
                        </span>
                        @if (isOwn)
                        {
                            <span class="badge bg-info bg-opacity-25 text-info" style="font-size:.6rem;">Siz</span>
                        }
                        <time class="text-white-50" style="font-size:.7rem;" datetime="@review.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                            @FormatReviewDate(review.CreatedAt)
                        </time>
                    </div>

                    @* Puan yıldızları (varsa) *@
                    @if (review.Rating.HasValue && review.Rating > 0)
                    {
                        <div class="mb-1">
                            @for (int star = 1; star <= 5; star++)
                            {
                                <i class="fa @(star <= review.Rating.Value ? "fa-star text-warning" : "fa-star-o text-white-50")"
                                   style="font-size:.7rem;" aria-hidden="true"></i>
                            }
                        </div>
                    }

                    <p class="text-light small mb-2 lh-base" style="white-space:pre-line;"
                       @(hasItemprop ? "itemprop=\" reviewBody\"" : "" )>@review.CommentText</p>

                    @* Aksiyon butonları *@
                    <div class="d-flex gap-2">
                        @if (use != null && depth == 0)
                        {
                            <button class="btn btn-link btn-sm text-white-50 text-decoration-none p-0"
                                    @onclick="() => StartReply(review.Id)">
                                <i class="fa fa-reply me-1" style="font-size:.75rem;" aria-hidden="true"></i>
                                <span style="font-size:.75rem;">Yanıtla</span>
                            </button>
                        }
                        @if (isOwn)
                        {
                            <button class="btn btn-link btn-sm text-danger text-decoration-none p-0"
                                    @onclick="() => DeleteReview(review)"
                                    disabled="@(_deletingReviewId == review.Id)">
                                @if (_deletingReviewId == review.Id)
                                {
                                    <span class="spinner-border spinner-border-sm" style="width:.7rem; height:.7rem;"></span>
                                }
                                else
                                {
                                    <i class="fa fa-trash-o me-1" style="font-size:.75rem;" aria-hidden="true"></i>
                                }
                                <span style="font-size:.75rem;">Sil</span>
                            </button>
                        }
                    </div>

                    @* Yanıt formu *@
                    @if (_replyingToReviewId == review.Id && use != null)
                    {
                        <div class="mt-2">
                            <div class="d-flex gap-2">
                                <textarea class="form-control form-control-sm bg-dark bg-opacity-50 text-light border-secondary"
                                          rows="2" placeholder="Yanıtınızı yazın…"
                                          @bind="_replyText" @bind:event="oninput"
                                          maxlength="1000" aria-label="Yanıt metni"></textarea>
                            </div>
                            <div class="d-flex gap-2 mt-1">
                                <button class="btn btn-info btn-sm py-0 px-2" style="font-size:.75rem;"
                                        @onclick="() => SubmitReply(review.Id)"
                                        disabled="@(string.IsNullOrWhiteSpace(_replyText) || _replySubmitting)">
                                    @if (_replySubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" style="width:.6rem; height:.6rem;"></span>
                                    }
                                    <i class="fa fa-paper-plane me-1" aria-hidden="true"></i>Gönder
                                </button>
                                <button class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:.75rem;"
                                        @onclick="() => { _replyingToReviewId = null; _replyText = null; }">
                                    İptal
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Alt yorumlar (children) — sadece depth 0'da *@
            @if (depth == 0 && review.Children.Any())
            {
                @foreach (var child in review.Children.OrderBy(c => c.CreatedAt))
                {
                    @RenderReviewItem(child, 1)
                }
            }
        </div>
    };

    private static string FormatReviewDate(DateTime utcDate)
    {
        var local = utcDate.AddHours(3); // UTC+3 Türkiye
        var diff = DateTime.UtcNow - utcDate;
        if (diff.TotalMinutes < 1) return "Az önce";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} dk önce";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} saat önce";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} gün önce";
        return local.ToString("dd MMM yyyy HH:mm", new CultureInfo("tr-TR"));
    }

