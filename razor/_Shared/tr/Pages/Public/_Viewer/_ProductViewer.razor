    private static bool HasAnyWorkingDay(WorkingHours wh) =>
        wh.IsActiveMonday == true || wh.IsActiveTuesday == true || wh.IsActiveWednesday == true ||
        wh.IsActiveThursday == true || wh.IsActiveFriday == true || wh.IsActiveSaturday == true ||
        wh.IsActiveSunday == true;

    private static List<WorkingHourRow> GetWorkingHoursList(WorkingHours wh)
    {
        var today = (int)DateTime.Now.DayOfWeek; // 0=Pazar
        return new List<WorkingHourRow>
        {
            new("Pzt", wh.IsActiveMonday == true, wh.StartTimeMonday, wh.FinishTimeMonday, today == 1),
            new("Sal", wh.IsActiveTuesday == true, wh.StartTimeTuesday, wh.FinishTimeTuesday, today == 2),
            new("Çar", wh.IsActiveWednesday == true, wh.StartTimeWednesday, wh.FinishTimeWednesday, today == 3),
            new("Per", wh.IsActiveThursday == true, wh.StartTimeThursday, wh.FinishTimeThursday, today == 4),
            new("Cum", wh.IsActiveFriday == true, wh.StartTimeFriday, wh.FinishTimeFriday, today == 5),
            new("Cmt", wh.IsActiveSaturday == true, wh.StartTimeSaturday, wh.FinishTimeSaturday, today == 6),
            new("Paz", wh.IsActiveSunday == true, wh.StartTimeSunday, wh.FinishTimeSunday, today == 0),
        };
    }

    // ─── SOSYAL MEDYA YARDIMCI ──────────────────────────────────
    private static List<SocialLink> GetActiveSocials(ContactInformation ci)
    {
        var list = new List<SocialLink>();
        if (ci.IsActiveWhatsApp == true && !string.IsNullOrEmpty(ci.WhatsApp))
            list.Add(new("WhatsApp", "fa-whatsapp", $"https://wa.me/{ci.WhatsApp}"));
        if (ci.IsActiveInstagram == true && !string.IsNullOrEmpty(ci.Instagram))
            list.Add(new("Instagram", "fa-instagram", $"https://instagram.com/{ci.Instagram}"));
        if (ci.IsActiveFacebook == true && !string.IsNullOrEmpty(ci.Facebook))
            list.Add(new("Facebook", "fa-facebook", ci.Facebook));
        if (ci.IsActiveX == true && !string.IsNullOrEmpty(ci.X))
            list.Add(new("X", "fa-twitter", $"https://x.com/{ci.X}"));
        if (ci.IsActiveYouTube == true && !string.IsNullOrEmpty(ci.YouTube))
            list.Add(new("YouTube", "fa-youtube-play", ci.YouTube));
        if (ci.IsActiveLinkedin == true && !string.IsNullOrEmpty(ci.Linkedin))
            list.Add(new("LinkedIn", "fa-linkedin", ci.Linkedin));
        if (ci.IsActiveTikTok == true && !string.IsNullOrEmpty(ci.TikTok))
            list.Add(new("TikTok", "fa-music", $"https://tiktok.com/@{ci.TikTok}"));
        if (ci.IsActiveTelegram == true && !string.IsNullOrEmpty(ci.Telegram))
            list.Add(new("Telegram", "fa-telegram", $"https://t.me/{ci.Telegram}"));
        if (ci.IsActivePinterest == true && !string.IsNullOrEmpty(ci.Pinterest))
            list.Add(new("Pinterest", "fa-pinterest", ci.Pinterest));
        if (ci.IsActiveDiscord == true && !string.IsNullOrEmpty(ci.Discord))
            list.Add(new("Discord", "fa-commenting", ci.Discord));
        return list;
    }

