    private static bool HasAnyWorkingDay(WorkingHours wh) =>
        wh.IsActiveMonday == true || wh.IsActiveTuesday == true || wh.IsActiveWednesday == true ||
        wh.IsActiveThursday == true || wh.IsActiveFriday == true || wh.IsActiveSaturday == true ||
        wh.IsActiveSunday == true;

    private static List<WorkingHourRow> GetWorkingHoursList(WorkingHours wh)
    {
        var today = (int)DateTime.Now.DayOfWeek; // 0=Pazar
        return new List<WorkingHourRow>
        {
            new("Pzt", wh.IsActiveMonday == true, wh.StartTimeMonday, wh.FinishTimeMonday, today == 1),
            new("Sal", wh.IsActiveTuesday == true, wh.StartTimeTuesday, wh.FinishTimeTuesday, today == 2),
            new("Çar", wh.IsActiveWednesday == true, wh.StartTimeWednesday, wh.FinishTimeWednesday, today == 3),
            new("Per", wh.IsActiveThursday == true, wh.StartTimeThursday, wh.FinishTimeThursday, today == 4),
            new("Cum", wh.IsActiveFriday == true, wh.StartTimeFriday, wh.FinishTimeFriday, today == 5),
            new("Cmt", wh.IsActiveSaturday == true, wh.StartTimeSaturday, wh.FinishTimeSaturday, today == 6),
            new("Paz", wh.IsActiveSunday == true, wh.StartTimeSunday, wh.FinishTimeSunday, today == 0),
        };
    }

