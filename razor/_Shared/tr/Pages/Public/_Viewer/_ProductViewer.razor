    // ─── Parametreler ─────────────────────────────────────────────
    [Parameter] public Users? use { get; set; }
    [Parameter] public Products? SelectedProduct { get; set; }

    // ─── Yaşam döngüsü ────────────────────────────────────────────
    private bool _disposed;
    private bool _loading = true;
    private Guid _loadedProductId;

    private readonly CancellationTokenSource _cts = new();
    private readonly SemaphoreSlim _loadSemaphore = new(1, 1);
    private Notification? _notificationRef;

    // ─── Ürün Verisi ──────────────────────────────────────────────
    private Products? _product;
    private string? _slug;
    private string? _brandName;
    private Store? _store;
    private string? _storeProfileUrl;

    // ─── Mağaza Takip / Engel ─────────────────────────────────────
    private bool _isFollowingStore;
    private bool _isStoreBlocked;
    private int _storeFollowerCount;
    private bool _storeActionLoading;
    private Guid? _storeShipId;

    // ─── Mağaza Galeri ────────────────────────────────────────────
    private List<string> _storeGalleryImages = new();

    // ─── Döviz Kurları ────────────────────────────────────────────
    private MoneyExchangeRate? MoneyExchangeRate = null;

    // ─── Görseller ────────────────────────────────────────────────
    private List<string> _baseImages = new();
    private List<string> _displayImages = new();
    private int _activeImageIndex;

    // ─── Varyantlar ───────────────────────────────────────────────
    private List<VariantInfo> _variants = new();
    private VariantInfo? _selectedVariant;
    private List<VariantAttributeGroup> _variantAttributes = new();
    private Dictionary<Guid, Guid> _selectedAttributeValues = new();
    private Dictionary<Guid, Guid?> _variantGroupCovers = new();

    // ─── Fiyat / Stok ─────────────────────────────────────────────
    private PriceInfo? _currentPrice;
    private List<PriceInfo> _otherCurrencyPrices = new();
    private int _currentStockQty;
    private bool _hasStockData;
    private int? _maxOrderQty;
    private int _currentDiscountPercent;

    // ─── Spesifikasyonlar / Kategori / Harici medya ──────────────
    private List<SpecRow> _specifications = new();
    private List<CategoriesTr> _breadcrumbCategories = new();
    private List<ProductExternalMedias> _externalMedias = new();

    // ─── UI Durumu ────────────────────────────────────────────────
    private string _activeTab = "desc";
    private int _quantity = 1;
    private bool _isFavorite;
    private bool _isCompared;

    // ─── Yorumlar (ProductReview) ──────────────────────────────────
    private List<ReviewDisplayDto> _reviewList = new();
    private int _reviewTotalCount;
    private bool _reviewsLoading;
    private bool _reviewsLoaded;
    private bool _reviewHasMore;
    private int _reviewPage;
    private const int REVIEW_PAGE_SIZE = 20;
    private string? _newReviewText;
    private int _newReviewRating;
    private bool _reviewSubmitting;
    private Guid? _replyingToReviewId;
    private string? _replyText;
    private bool _replySubmitting;
    private Guid? _deletingReviewId;

    // ─── SEO: AggregateRating ─────────────────────────────────────
