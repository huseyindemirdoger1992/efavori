@* ════════════════════════════════════════════════════════════════════════
   _ProductViewer.razor  (SEO-Optimized Revision)
   ─────────────────────────────────────────────────────────────────────────
   Tekli ürün inceleme sayfası — Amazon / Trendyol / eBay tarzı profesyonel yapı.

   SEO İYİLEŞTİRMELERİ:
   ✅ SSR-dostu ilk render — SelectedProduct parametresinden temel bilgi
   ✅ <article itemscope itemtype="Product"> semantik kapsayıcı
   ✅ Microdata (itemprop) — name, image, description, offers, brand, sku, review
   ✅ <nav aria-label="Breadcrumb"> + <ol itemscope="BreadcrumbList">
   ✅ Offer schema — price, priceCurrency, availability, seller, itemCondition
   ✅ AggregateRating — yorum sayısı ve ortalama puan
   ✅ Review microdata — author, datePublished, reviewBody
   ✅ Benzersiz & açıklayıcı img alt metinleri
   ✅ Semantik HTML — <section>, <aside>, <figure>, <time>, <address>, <nav>
   ✅ İlgili ürünler bölümü
   ✅ Tek <h1> — ürün adı (itemprop="name")
   ✅ Mobil sabit satın alma çubuğu (aria etiketli)
   ✅ <meta itemprop="url"> — canonical URL referansı

   VERİ İLİŞKİLERİ:
   - Products (ana kayıt)            → Parametre olarak gelir (SelectedProduct)
   - Brands.Id          ← Products.BrandId
   - Store.Id           ← Products.StoreId
   - StoreShip           ← RequestorId/ReceiverId (takip/engel)
   - ProductSeo         ← ProductId (Slug, SeoTitle, SeoDescription)
   - ProductVariants    ← ProductId (varsayılan + tüm varyantlar, SKU/Barkod)
   - ProductVariantValues ← VariantId (Renk=Kırmızı, Beden=S kombinasyonları)
   - ProductAttributes / ProductAttributeValues (özellik adı/değeri çözümleme)
   - ProductPrices      ← VariantId, EffectiveTo==null (güncel fiyat, çoklu para birimi)
   - ProductStocks      ← VariantId (toplam stok = depo satırlarının toplamı)
   - ProductSpecifications ← ProductId (teknik özellik tablosu)
   - ProductCategories  ← ProductId → CategoriesTr (breadcrumb)
   - CoverMediaId       → Media (kapak görseli)
   - ItemGallery (ItemType="Product"/"ProductGallery", ItemId=ProductId) → Media (galeri)
   - ItemGallery (ItemType="InShooting"/"OutShooting", ItemId=StoreId) → Media (mağaza galeri)
   - ProductImageVariantGroups → değer bazlı varyant görseli (CoverMediaId)
   - ProductExternalMedias ← ProductId (video, 360, döküman)
   ════════════════════════════════════════════════════════════════════════ *@

@using api
@using api.tr
@using data
@using data._Shared
@using data._Product
@using data._Product.ProductHistory
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using System.Globalization

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@* ═══════════════════════════════════════════════════════════════
   SSR-DOSTU İLK RENDER
   SelectedProduct parametresi MVC Controller'dan gelir.
   Blazor Server ilk render'da _loading=true olsa bile,
   SelectedProduct mevcutsa temel ürün bilgisini SSR'da basarız.
   Botlar JS çalıştırmadan bu içeriği okuyabilir.
   ═══════════════════════════════════════════════════════════════ *@

@if (_loading && SelectedProduct != null)
{
    @* ─── SEO: YÜKLEME SIRASINDAKİ MİNİMAL İÇERİK ───
       Botlar için anlamlı HTML — SelectedProduct verisinden *@
    <article itemscope itemtype="https://schema.org/Product">
        <meta itemprop="url" content="@($"{NavigationManager.BaseUri}Public/_Viewer/ProductProfile/{SelectedProduct.Id}")" />
        <div class="container-fluid pt-3">
            <nav aria-label="Breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                    <li class="breadcrumb-item"><a href="/tr/Public/Home/Index">Ürünler</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@SelectedProduct.Name</li>
                </ol>
            </nav>
        </div>
        <div class="container-fluid pb-5">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="placeholder-glow">
                        <div class="placeholder col-12 rounded-3" style="height:420px;"></div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <h1 class="h4 text-light fw-semibold lh-base mb-2" itemprop="name">@SelectedProduct.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(SelectedProduct.ShortDescription))
                    {
                        <div itemprop="description">
                            <p class="text-light small mb-0 lh-base">@SelectedProduct.ShortDescription</p>
                        </div>
                    }
                    <div class="placeholder-glow mt-3">
                        <span class="placeholder col-5 mb-3"></span>
                        <span class="placeholder col-12 mb-2" style="height:48px;"></span>
                        <span class="placeholder col-7 mb-4"></span>
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="placeholder-glow">
                        <span class="placeholder col-12 mb-2" style="height:120px;"></span>
                    </div>
                </div>
            </div>
        </div>
    </article>
}
else if (_loading)
{
    @* ─── İSKELET YÜKLEME (SelectedProduct yok) ─── *@
    <div class="container-xxl py-4">
        <div class="placeholder-glow">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="placeholder col-12 rounded-3" style="height:420px;"></div>
                </div>
                <div class="col-lg-6">
                    <span class="placeholder col-4 mb-3"></span>
                    <span class="placeholder col-9 mb-2"></span>
                    <span class="placeholder col-7 mb-4"></span>
                    <span class="placeholder col-5 mb-3"></span>
                    <span class="placeholder col-12 mb-2" style="height:48px;"></span>
                </div>
            </div>
        </div>
    </div>
}
else if (_product == null)
{
    @* ─── ÜRÜN BULUNAMADI ─── *@
    <div class="container-xxl py-5 text-center text-light">
        <i class="fa fa-exclamation-triangle fa-3x text-warning mb-3 d-block" aria-hidden="true"></i>
        <h1 class="h4">Ürün bulunamadı</h1>
        <p class="text-light">Aradığınız ürün kaldırılmış veya yayından alınmış olabilir.</p>
        <a href="/Public/_Viewer/ProductListing" class="btn btn-info btn-sm mt-2">
            <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>Ürünlere Dön
        </a>
    </div>
}
else
{
    var p = _product;
    var productCanonicalUrl = $"{NavigationManager.BaseUri}Public/_Viewer/ProductProfile/{_slug}";

    @* ═══════════════════════════════════════════════════════════════
       SEO: ANA İÇERİK — <article> + Product Microdata
       JSON-LD zaten _Viewer.cs → _Layout.cshtml üzerinden <head>'de.
       Buradaki itemprop'lar "belt and suspenders" yaklaşımı.
       ═══════════════════════════════════════════════════════════════ *@
    <article itemscope itemtype="https://schema.org/Product">

        @* ─── Gizli meta verileri (botlar için) ─── *@
        <meta itemprop="url" content="@productCanonicalUrl" />
        @if (!string.IsNullOrEmpty(_slug))
        {
            <link itemprop="mainEntityOfPage" href="@productCanonicalUrl" />
        }

        @* ═══════════════════════════════════════════════════════════════
           SEO: BREADCRUMB — Semantik <nav> + BreadcrumbList Microdata
           ═══════════════════════════════════════════════════════════════ *@
        <div class="container-fluid pt-3">
            <nav aria-label="Breadcrumb">
                <ol class="breadcrumb mb-2" itemscope itemtype="https://schema.org/BreadcrumbList">
                    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <a href="/" itemprop="item"><span itemprop="name">Ana Sayfa</span></a>
                        <meta itemprop="position" content="1" />
                    </li>
                    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <a href="/tr/Public/Home/Index" itemprop="item"><span itemprop="name">Ürünler</span></a>
                        <meta itemprop="position" content="2" />
                    </li>
                    @{
                        int bcPos = 3;
                    }
                    @foreach (var bc in _breadcrumbCategories)
                    {
                        var pos = bcPos++;
                        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <span itemprop="name">@(bc.Name ?? "—")</span>
                            <meta itemprop="position" content="@pos" />
                        </li>
                    }
                    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <span itemprop="name">@p.Name</span>
                        <meta itemprop="position" content="@bcPos" />
                    </li>
                </ol>
            </nav>
        </div>

        <div class="container-fluid pb-5">
            <div class="row g-4">

                @* ═══════════════════════════════════════════════════════
                   SOL: GÖRSEL GALERİ (sticky) — <figure> + itemprop
                   ═══════════════════════════════════════════════════════ *@
                <div class="col-lg-5" style="overflow:visible;">
                    <div class="position-lg-sticky" style="top:80px; overflow:visible;">
                        <div class="row g-2" style="overflow:visible;">

                            @* Dikey küçük resimler (masaüstü) *@
                            @if (_displayImages.Count > 1)
                            {
                                <div class="col-2 d-none d-md-block">
                                    <div class="d-flex flex-column gap-2" role="listbox" aria-label="Ürün görselleri" style="max-height:520px; overflow-y:auto;">
                                        @for (int i = 0; i < _displayImages.Count; i++)
                                        {
                                            var idx = i;
                                            <div role="option"
                                                 aria-selected="@(idx == _activeImageIndex ? "true" : "false")"
                                                 class="border rounded-2 overflow-hidden @(idx == _activeImageIndex ? "border-info border-2" : "border-secondary")"
                                                 style="aspect-ratio:1; cursor:pointer; @(idx == _activeImageIndex ? "" : "opacity:.6;")"
                                                 @onclick="() => _activeImageIndex = idx"
                                                 @onmouseover="() => _activeImageIndex = idx">
                                                <img src="@_displayImages[idx]"
                                                     alt="@p.Name — görsel @(idx + 1) / @_displayImages.Count"
                                                     class="w-100 h-100" style="object-fit:cover;" loading="lazy"
                                                     width="80" height="80" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @* Ana görsel — <figure> ile sarmalı *@
                            <div class="@(_displayImages.Count > 1 ? "col-md-10" : "col-12")" style="overflow:visible;">
                                <figure class="pp-zoom-wrapper mb-0">
                                    <div class="position-relative bg-white rounded-3 overflow-hidden border border-secondary border-opacity-25"
                                         id="ppMediaMain"
                                         style="aspect-ratio:1;">
                                        @if (_displayImages.Any())
                                        {
                                            <img src="@_displayImages[_activeImageIndex]"
                                                 alt="@p.Name — ana ürün görseli"
                                                 itemprop="image"
                                                 class="w-100 h-100" id="ppMainImg" style="object-fit:contain;"
                                                 width="600" height="600" />
                                            <div class="pp-zoom-lens" id="ppZoomLens"></div>

                                            @* Mobil zoom seviye göstergesi *@
                                            <span id="ppZoomBadge"
                                                  class="badge bg-dark text-info position-absolute border border-info"
                                                  style="bottom:12px; left:12px; z-index:15; opacity:0;
                                                transition:opacity .2s ease; font-size:.75rem; pointer-events:none;"
                                                  aria-hidden="true">
                                                x2.0
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center h-100 text-light bg-dark">
                                                <i class="fa fa-picture-o fa-4x" aria-hidden="true"></i>
                                                <span class="visually-hidden">Ürün görseli mevcut değil</span>
                                            </div>
                                        }

                                        @* İndirim rozeti *@
                                        @if (_currentDiscountPercent > 0)
                                        {
                                            <span class="badge bg-danger position-absolute top-0 start-0 m-3 fs-6 px-3 py-2 rounded-pill">
                                                %@_currentDiscountPercent İndirim
                                            </span>
                                        }

                                        @* Favori (sağ üst) *@
                                        <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 shadow-sm"
                                                style="width:44px; height:44px;"
                                                @onclick="ToggleFavorite"
                                                title="@(_isFavorite ? "Favorilerden Çıkar" : "Favorilere Ekle")"
                                                aria-label="@(_isFavorite ? "Favorilerden Çıkar" : "Favorilere Ekle")"
                                                aria-pressed="@_isFavorite">
                                            <i class="fa @(_isFavorite ? "fa-heart text-danger" : "fa-heart-o text-dark")" aria-hidden="true"></i>
                                        </button>
                                    </div>

                                    @* Ek görselleri de itemprop="image" ile işaretle *@
                                    @if (_displayImages.Count > 1)
                                    {
                                        @for (int gi = 0; gi < _displayImages.Count; gi++)
                                        {
                                            if (gi != _activeImageIndex)
                                            {
                                                <meta itemprop="image" content="@_displayImages[gi]" />
                                            }
                                        }
                                    }

                                    @* Yakınlaştırılmış görsel paneli — masaüstünde hover ile görünür *@
                                    <div class="pp-zoom-result" id="ppZoomResult" aria-hidden="true"></div>
                                </figure>

                                @* Yatay küçük resimler (mobil) *@
                                @if (_displayImages.Count > 1)
                                {
                                    <div class="d-flex d-md-none gap-2 mt-2 overflow-auto pb-1" role="listbox" aria-label="Ürün görselleri">
                                        @for (int i = 0; i < _displayImages.Count; i++)
                                        {
                                            var idx = i;
                                            <div role="option"
                                                 aria-selected="@(idx == _activeImageIndex ? "true" : "false")"
                                                 class="border rounded-2 overflow-hidden flex-shrink-0 @(idx == _activeImageIndex ? "border-info border-2" : "border-secondary")"
                                                 style="width:64px; height:64px; cursor:pointer; @(idx == _activeImageIndex ? "" : "opacity:.6;")"
                                                 @onclick="() => _activeImageIndex = idx">
                                                <img src="@_displayImages[idx]"
                                                     alt="@p.Name — küçük görsel @(idx + 1)"
                                                     class="w-100 h-100" style="object-fit:cover;" loading="lazy"
                                                     width="64" height="64" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @* Harici Medya (Video / 360 / Döküman) *@
                        @if (_externalMedias.Any())
                        {
                            <div class="mt-3">
                                <h6 class="text-light small fw-semibold mb-2">
                                    <i class="fa fa-film me-1 text-info" aria-hidden="true"></i>Video &amp; Medya
                                </h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var em in _externalMedias)
                                    {
                                        var icon = em.MediaType switch
                                        {
                                            "VideoUrl" => "fa-youtube-play",
                                            "View360" => "fa-refresh",
                                            "Document" => "fa-file-pdf-o",
                                            _ => "fa-external-link"
                                        };
                                        <a href="@em.Url" target="_blank" rel="noopener"
                                           class="btn btn-outline-secondary btn-sm">
                                            <i class="fa @icon me-1" aria-hidden="true"></i>@(string.IsNullOrEmpty(em.Title) ? em.MediaType : em.Title)
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* ═══════════════════════════════════════════════════════
                   ORTA: ÜRÜN BİLGİLERİ + SATIN ALMA
                   ═══════════════════════════════════════════════════════ *@
                <section class="col-lg-5">

                    @* SEO: Marka — itemprop="brand" *@
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        @if (!string.IsNullOrEmpty(_brandName))
                        {
                            <a href="/Public/_Viewer/ProductListing?brand=@Uri.EscapeDataString(_brandName)"
                               class="badge bg-info bg-opacity-25 text-info border border-info text-decoration-none px-3 py-2"
                               itemprop="brand" itemscope itemtype="https://schema.org/Brand">
                                <i class="fa fa-bookmark me-1" aria-hidden="true"></i>
                                <span itemprop="name">@_brandName</span>
                            </a>
                        }
                        @if (_store != null)
                        {
                            <button class="btn btn-link btn-sm text-warning text-decoration-none p-0"
                                    @onclick="OpenStoreModal">
                                <i class="fa fa-building me-1" aria-hidden="true"></i>@_store.Name
                            </button>
                        }
                    </div>

                    @* SEO: Tek <h1> — itemprop="name" *@
                    <h1 class="h4 text-light fw-semibold lh-base mb-2" itemprop="name">@p.Name</h1>

                    @* SEO: KISA AÇIKLAMA — itemprop="description" *@
                    @if (!string.IsNullOrWhiteSpace(p.ShortDescription))
                    {
                        <div class="bg-dark bg-opacity-25 rounded-3 p-3" itemprop="description">
                            <p class="text-light small mb-0 lh-base">@p.ShortDescription</p>
                        </div>
                    }

                    @* Görüntülenme / Paylaşma / Tavsiye / SKU *@
                    <div class="d-flex align-items-center flex-wrap gap-3 text-light small mb-3 mt-3">

                        <table class="table table-bordered table-hover mb-0 text-center">
                            <tbody>
                                <tr>
                                    <td>
                                        <span><i class="fa fa-eye me-1" aria-hidden="true"></i>@(p.InteractionCounts?.ViewCount ?? 0) görüntülenme</span>
                                    </td>
                                    <td>
                                        <span><i class="fa fa-share-alt me-1" aria-hidden="true"></i>@(p.InteractionCounts?.ShareCount ?? 0) paylaşma</span>
                                    </td>
                                    <td>
                                        <span><i class="fa fa-users me-1" aria-hidden="true"></i>@(p.InteractionCounts?.RecommendCount ?? 0) tavsiye</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        @* SEO: SKU — itemprop="sku" *@
                        @if (!string.IsNullOrEmpty(_selectedVariant?.Sku))
                        {
                            <span><i class="fa fa-tag me-1" aria-hidden="true"></i>SKU: <span itemprop="sku">@_selectedVariant.Sku</span></span>
                        }
                        @if (!string.IsNullOrEmpty(_selectedVariant?.Barcode))
                        {
                            <span itemprop="gtin"><i class="fa fa-barcode me-1" aria-hidden="true"></i>@_selectedVariant.Barcode</span>
                        }
                    </div>

                    <hr class="border-secondary" />

                    <div class="card-body bg-light rounded-3">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0 text-center">
                                <thead class="table-dark text-light">
                                    <tr>
                                        <th><i class="fa fa-calendar" aria-hidden="true"></i><span class="visually-hidden">Tarih</span></th>
                                        <th><i class="fa fa-usd" aria-hidden="true"></i><span class="visually-hidden">USD</span></th>
                                        <th><i class="fa fa-eur" aria-hidden="true"></i><span class="visually-hidden">EUR</span></th>
                                        <th><i class="fa fa-try" aria-hidden="true"></i><span class="visually-hidden">TRY</span></th>
                                        <th><span class="fw-bold">₼</span><span class="visually-hidden">AZN</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@MoneyExchangeRate?.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@MoneyExchangeRate?.Dolar_Usd</td>
                                        <td>@MoneyExchangeRate?.Euro_Eur</td>
                                        <td>@MoneyExchangeRate?.Lira_Tl</td>
                                        <td>@MoneyExchangeRate?.Manat_Azn</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ═══════════════════════════════════════════════════
                       SEO: FİYAT + STOK — Offer Microdata
                       ═══════════════════════════════════════════════════ *@
                    <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 p-3 mb-3"
                         itemprop="offers" itemscope itemtype="https://schema.org/Offer">

                        @* Gizli meta: offer URL + para birimi + durum + koşul *@
                        <link itemprop="url" href="@productCanonicalUrl" />
                        <meta itemprop="itemCondition" content="https://schema.org/NewCondition" />

                        @* SEO: Stok durumu — <link itemprop="availability"> *@
                        @if (_currentStockQty > 0)
                        {
                            <link itemprop="availability" href="https://schema.org/InStock" />
                        }
                        else if (_hasStockData)
                        {
                            <link itemprop="availability" href="https://schema.org/OutOfStock" />
                        }

                        @* SEO: Satıcı — itemprop="seller" *@
                        @if (_store != null)
                        {
                            <div itemprop="seller" itemscope itemtype="https://schema.org/Organization" class="d-none">
                                <meta itemprop="name" content="@(_store.Name ?? "efavori Satıcı")" />
                            </div>
                        }

                        @if (_currentPrice != null)
                        {
                            var cur = CurrencySymbol(_currentPrice.Currency);
                            var isoCur = (_currentPrice.Currency ?? "TRY").ToUpperInvariant();
                            <meta itemprop="priceCurrency" content="@isoCur" />

                            @if (_currentPrice.DiscountedPrice.HasValue && _currentPrice.DiscountedPrice < _currentPrice.Price)
                            {
                                @* İndirimli fiyat *@
                                <meta itemprop="price" content="@_currentPrice.DiscountedPrice.Value.ToString("F2", CultureInfo.InvariantCulture)" />
                                <div class="d-flex align-items-baseline flex-wrap gap-2">
                                    <span class="display-6 fw-bold text-info mb-0">@_currentPrice.DiscountedPrice.Value.ToString("N2") @cur</span>
                                    <del class="text-light fs-5">@_currentPrice.Price.ToString("N2") @cur</del>
                                    <span class="badge bg-danger fs-6">%@_currentDiscountPercent</span>
                                </div>
                                <div class="text-success small mt-1">
                                    <i class="fa fa-arrow-down me-1" aria-hidden="true"></i>
                                    @((_currentPrice.Price - _currentPrice.DiscountedPrice.Value).ToString("N2")) @cur tasarruf ediyorsunuz
                                </div>
                            }
                            else
                            {
                                @* Normal fiyat *@
                                <meta itemprop="price" content="@_currentPrice.Price.ToString("F2", CultureInfo.InvariantCulture)" />
                                <span class="display-6 fw-bold text-info">@_currentPrice.Price.ToString("N2") @cur</span>
                            }

                            @* Diğer para birimleri *@
                            @if (_otherCurrencyPrices.Any())
                            {
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    @foreach (var op in _otherCurrencyPrices)
                                    {
                                        var ocur = CurrencySymbol(op.Currency);
                                        var oval = (op.DiscountedPrice ?? op.Price);
                                        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary">
                                            @oval.ToString("N2") @ocur
                                        </span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-light"><i class="fa fa-info-circle me-1" aria-hidden="true"></i>Fiyat bilgisi bulunmuyor</span>
                        }
                    </div>

                    @* ─── STOK DURUMU (görsel gösterge) ─── *@
                    <div class="mb-3">
                        @if (_currentStockQty > 0)
                        {
                            <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2">
                                <i class="fa fa-check-circle me-1" aria-hidden="true"></i>Stokta var
                                @if (_currentStockQty <= 10)
                                {
                                    <span class="ms-1">(son @_currentStockQty adet)</span>
                                }
                            </span>
                        }
                        else if (_hasStockData)
                        {
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-3 py-2">
                                <i class="fa fa-times-circle me-1" aria-hidden="true"></i>Stokta yok
                            </span>
                        }
                    </div>

                    @* ─── VARYANT SEÇİCİLER ─── *@
                    @if (_variantAttributes.Any())
                    {
                        @foreach (var attr in _variantAttributes)
                        {
                            <div class="mb-3">
                                <div class="text-light small fw-semibold mb-2">
                                    @attr.AttributeName:
                                    <span class="text-info">@GetSelectedValueName(attr.AttributeId)</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-label="@attr.AttributeName seçimi">
                                    @foreach (var val in attr.Values)
                                    {
                                        var v = val;
                                        var isSelected = _selectedAttributeValues.TryGetValue(attr.AttributeId, out var sv) && sv == v.ValueId;
                                        var isAvailable = IsCombinationAvailable(attr.AttributeId, v.ValueId);

                                        @if (!string.IsNullOrEmpty(v.ColorHex))
                                        {
                                            @* Renk kutucuğu *@
                                            <button class="btn p-0 rounded-circle border @(isSelected ? "border-info border-3" : "border-secondary") @(isAvailable ? "" : "opacity-50")"
                                                    style="width:40px; height:40px; background:@v.ColorHex;"
                                                    disabled="@(!isAvailable)"
                                                    @onclick="() => SelectVariantValue(attr.AttributeId, v.ValueId)"
                                                    title="@v.ValueName"
                                                    aria-label="@attr.AttributeName: @v.ValueName"
                                                    aria-pressed="@isSelected"
                                                    role="radio"></button>
                                        }
                                        else
                                        {
                                            @* Metin etiketi *@
                                            <button class="btn btn-sm @(isSelected ? "btn-info" : "btn-outline-secondary") @(isAvailable ? "" : "opacity-50 text-decoration-line-through")"
                                                    disabled="@(!isAvailable)"
                                                    @onclick="() => SelectVariantValue(attr.AttributeId, v.ValueId)"
                                                    aria-label="@attr.AttributeName: @v.ValueName"
                                                    aria-pressed="@isSelected"
                                                    role="radio">
                                                @v.ValueName
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="d-flex flex-column gap-4 mb-3">

                        @* ─── ANA AKSİYONLAR VE ADET SEÇİCİ ─── *@
                        <div class="d-flex flex-column flex-md-row align-items-stretch gap-3">

                            @* Adet Seçici *@
                            <div class="d-flex flex-column justify-content-center">
                                <div class="input-group" style="min-width: 16px; max-width: 200px;">
                                    <button class="btn btn-light text-danger" type="button"
                                            @onclick="() => ChangeQuantity(-1)" disabled="@(_quantity <= 1)"
                                            aria-label="Adeti azalt">
                                        <i class="fa fa-minus" aria-hidden="true"></i>
                                    </button>
                                    <input type="text" class="form-control text-center fw-bold bg-light text-light px-2"
                                           value="@_quantity" style="min-width: 32px;" readonly
                                           aria-label="Adet" />
                                    <button class="btn btn-light text-dark" type="button"
                                            @onclick="() => ChangeQuantity(1)"
                                            disabled="@(_maxOrderQty.HasValue && _quantity >= _maxOrderQty.Value)"
                                            aria-label="Adeti artır">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                    </button>
                                </div>
                                @if (_maxOrderQty.HasValue)
                                {
                                    <span class="text-muted small mt-1 text-center">(En fazla @_maxOrderQty)</span>
                                }
                            </div>

                            @* Ana Butonlar *@
                            <div class="flex-grow-1 d-flex flex-column flex-sm-row gap-2">
                                @if (string.Equals(p.ProductType, "External", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(p.ExternalUrl))
                                {
                                    <a href="@p.ExternalUrl" target="_blank" rel="noopener nofollow"
                                       class="btn btn-primary btn-lg w-100 shadow-sm d-flex align-items-center justify-content-center text-light">
                                        <i class="fa fa-external-link me-2" aria-hidden="true"></i>@(string.IsNullOrEmpty(p.ExternalButtonText) ? "Satıcıya Git" : p.ExternalButtonText)
                                    </a>
                                }
                                else
                                {
                                    @* Sepete Ekle *@
                                    <button class="btn btn-primary flex-fill shadow-sm d-flex align-items-center justify-content-center text-light"
                                            @onclick="OnAddToCart" disabled="@(_hasStockData && _currentStockQty <= 0)">
                                        <i class="fa fa-shopping-cart me-2" aria-hidden="true"></i>Sepete Ekle
                                    </button>

                                    @* Hemen Al *@
                                    <button class="btn btn-success flex-fill shadow-sm d-flex align-items-center justify-content-center text-light"
                                            @onclick="OnQuickBuy" disabled="@(_hasStockData && _currentStockQty <= 0)">
                                        <i class="fa fa-bolt me-2" aria-hidden="true"></i>Hemen Al
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </section>


                @* ═══════════════════════════════════════════════════════
                   SAĞ: MAĞAZA BİLGİ PANELİ — <aside> semantik
                   ═══════════════════════════════════════════════════════ *@
                <aside class="col-lg-2" aria-label="Mağaza bilgileri">
                    @if (_store != null)
                    {
                        var st = _store;
                        <div class="position-lg-sticky" style="top:80px;">
                            <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 p-3">

                                @* ─── Mağaza Profil Görseli + Adı ─── *@
                                <div class="text-center mb-3">
                                    @if (!string.IsNullOrEmpty(_storeProfileUrl))
                                    {
                                        <img src="@_storeProfileUrl" alt="@st.Name mağaza logosu"
                                             class="rounded-circle border border-info mb-2"
                                             style="width:72px; height:72px; object-fit:cover;"
                                             width="72" height="72" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-info bg-opacity-25 d-flex align-items-center justify-content-center mx-auto mb-2"
                                             style="width:72px; height:72px;">
                                            <i class="fa fa-building fa-2x text-info" aria-hidden="true"></i>
                                        </div>
                                    }
                                    <h6 class="text-light mb-0 small fw-semibold">@st.Name</h6>
                                    @if (!string.IsNullOrEmpty(st.Description))
                                    {
                                        <p class="text-white-50 mb-0" style="font-size:.7rem; line-height:1.3;">
                                            @(st.Description.Length > 80 ? st.Description.Substring(0, 80) + "…" : st.Description)
                                        </p>
                                    }
                                </div>

                                @* ─── Etkileşim Sayıları ─── *@
                                @if (st.Interaction != null)
                                {
                                    <div class="d-flex justify-content-around text-center mb-3 py-2 border-top border-bottom border-secondary border-opacity-25">
                                        <div>
                                            <div class="text-info fw-bold small">@(st.Interaction.ViewCount ?? 0)</div>
                                            <div class="text-white-50" style="font-size:.65rem;">Görüntülenme</div>
                                        </div>
                                        <div>
                                            <div class="text-info fw-bold small">@_storeFollowerCount</div>
                                            <div class="text-white-50" style="font-size:.65rem;">Takipçi</div>
                                        </div>
                                    </div>
                                }

                                @* ─── Takip / Engelle Butonları ─── *@
                                @if (use != null && st.UserId.HasValue && use.Id != st.UserId.Value)
                                {
                                    <div class="d-flex flex-column gap-2 mb-3">
                                        @if (_isStoreBlocked)
                                        {
                                            <button class="btn btn-outline-secondary btn-sm w-100"
                                                    @onclick="UnblockStore">
                                                <i class="fa fa-ban me-1" aria-hidden="true"></i>Engeli Kaldır
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn @(_isFollowingStore ? "btn-info" : "btn-outline-info") btn-sm w-100"
                                                    @onclick="ToggleFollowStore"
                                                    disabled="@_storeActionLoading">
                                                @if (_storeActionLoading)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                }
                                                else
                                                {
                                                    <i class="fa @(_isFollowingStore ? "fa-check" : "fa-plus") me-1" aria-hidden="true"></i>
                                                }
                                                @(_isFollowingStore ? "Takip Ediliyor" : "Mağazayı Takip Et")
                                            </button>

                                            <button class="btn btn-outline-danger btn-sm w-100"
                                                    @onclick="BlockStore"
                                                    disabled="@_storeActionLoading">
                                                <i class="fa fa-ban me-1" aria-hidden="true"></i>Engelle
                                            </button>
                                        }
                                    </div>
                                }

                                @* ─── Mağaza Galeri Görselleri ─── *@
                                @if (_storeGalleryImages.Any())
                                {
                                    <div class="mb-3">
                                        <div class="text-white-50 mb-1" style="font-size:.7rem; font-weight:600;">
                                            <i class="fa fa-picture-o me-1" aria-hidden="true"></i>Mağaza Görselleri
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var imgUrl in _storeGalleryImages.Take(6))
                                            {
                                                <div class="rounded-2 overflow-hidden border border-secondary border-opacity-50"
                                                     style="width:44px; height:44px;">
                                                    <img src="@imgUrl" alt="@st.Name — mağaza görseli"
                                                         class="w-100 h-100" style="object-fit:cover;" loading="lazy"
                                                         width="44" height="44" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @* ─── İletişim Bilgileri ─── *@
                                @if (st.ContactInformation != null)
                                {
                                    <address class="mb-3" style="font-style:normal;">
                                        @if (!string.IsNullOrEmpty(st.ContactInformation.Email) && st.ContactInformation.IsActiveEmail == true)
                                        {
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa fa-envelope text-info" style="font-size:.7rem; width:14px;" aria-hidden="true"></i>
                                                <a href="mailto:@st.ContactInformation.Email"
                                                   class="text-light text-decoration-none text-truncate" style="font-size:.75rem;">
                                                    @st.ContactInformation.Email
                                                </a>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(st.ContactInformation.UserWebSite) && st.ContactInformation.IsActiveUserWebSite == true)
                                        {
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa fa-globe text-info" style="font-size:.7rem; width:14px;" aria-hidden="true"></i>
                                                <a href="@st.ContactInformation.UserWebSite" target="_blank" rel="noopener"
                                                   class="text-light text-decoration-none text-truncate" style="font-size:.75rem;">
                                                    Web Sitesi
                                                </a>
                                            </div>
                                        }

                                        @* Sosyal Medya İkonları *@
                                        @{
                                            var socials = GetActiveSocials(st.ContactInformation);
                                        }
                                        @if (socials.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var s in socials)
                                                {
                                                    <a href="@s.Url" target="_blank" rel="noopener"
                                                       class="btn btn-outline-secondary btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center"
                                                       style="width:28px; height:28px;" title="@s.Platform"
                                                       aria-label="@s.Platform sayfasını ziyaret et">
                                                        <i class="fa @s.Icon" style="font-size:.7rem;" aria-hidden="true"></i>
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </address>
                                }

                                @* ─── Adres ─── *@
                                @if (st.AddressInfo != null && !string.IsNullOrEmpty(st.AddressInfo.City))
                                {
                                    <div class="mb-3">
                                        <div class="text-white-50 mb-1" style="font-size:.7rem; font-weight:600;">
                                            <i class="fa fa-map-marker me-1" aria-hidden="true"></i>Konum
                                        </div>
                                        <div class="text-light" style="font-size:.75rem; line-height:1.4;">
                                            @st.AddressInfo.City@(string.IsNullOrEmpty(st.AddressInfo.State) ? "" : $" / {st.AddressInfo.State}")@(string.IsNullOrEmpty(st.AddressInfo.Country) ? "" : $" / {st.AddressInfo.Country}")
                                        </div>
                                        @if (st.AddressInfo.Latitude != null && st.AddressInfo.Longitude != null)
                                        {
                                            var lat = st.AddressInfo.Latitude.Value.ToString(CultureInfo.InvariantCulture);
                                            var lng = st.AddressInfo.Longitude.Value.ToString(CultureInfo.InvariantCulture);
                                            <a href="https://www.google.com/maps/search/?api=1&query=@(lat),@(lng)"
                                               target="_blank" rel="noopener"
                                               class="text-info text-decoration-none" style="font-size:.7rem;">
                                                <i class="fa fa-external-link me-1" aria-hidden="true"></i>Haritada Gör
                                            </a>
                                        }
                                    </div>
                                }

                                @* ─── Çalışma Saatleri ─── *@
                                @if (st.WorkingHours != null && HasAnyWorkingDay(st.WorkingHours))
                                {
                                    <div class="mb-3">
                                        <div class="text-white-50 mb-1" style="font-size:.7rem; font-weight:600;">
                                            <i class="fa fa-clock-o me-1" aria-hidden="true"></i>Çalışma Saatleri
                                        </div>
                                        <div style="font-size:.7rem; line-height:1.6;">
                                            @foreach (var wh in GetWorkingHoursList(st.WorkingHours))
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span class="@(wh.IsToday ? "text-info fw-semibold" : "text-white-50")">@wh.Day</span>
                                                    <span class="@(wh.IsActive ? (wh.IsToday ? "text-info fw-semibold" : "text-light") : "text-white-50")">
                                                        @(wh.IsActive ? $"{wh.Start:HH\\:mm} - {wh.End:HH\\:mm}" : "Kapalı")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @* ─── Detay Butonu ─── *@
                                <button class="btn btn-outline-info btn-sm w-100" @onclick="OpenStoreModal">
                                    <i class="fa fa-info-circle me-1" aria-hidden="true"></i>Tüm Bilgiler
                                </button>
                            </div>
                        </div>
                    }
                </aside>

            </div>


            @* ─── AKSİYONLAR ─── *@
            <div class="col-lg-12 mt-3">
                <div class="d-flex flex-wrap gap-2 w-100" role="group" aria-label="Ürün aksiyonları">
                    <button class="btn btn-outline-danger btn-sm flex-fill d-flex align-items-center justify-content-center text-light" @onclick="ToggleFavorite">
                        <i class="fa @(_isFavorite ? "fa-heart text-danger" : "fa-heart-o text-light") me-2" aria-hidden="true"></i>Favori
                    </button>
                    <button class="btn btn-outline-info btn-sm flex-fill d-flex align-items-center justify-content-center text-light" @onclick="ToggleCompare">
                        <i class="fa fa-exchange text-light me-2" aria-hidden="true"></i>Karşılaştır
                    </button>
                    <button class="btn btn-outline-primary btn-sm flex-fill d-flex align-items-center justify-content-center text-light" @onclick="OpenShareModal">
                        <i class="fa fa-share-alt text-light me-2" aria-hidden="true"></i>Paylaş
                    </button>
                    <button class="btn btn-outline-success btn-sm flex-fill d-flex align-items-center justify-content-center text-light" @onclick="ToggleRecommendation">
                        <i class="fa fa-users text-light me-2" aria-hidden="true"></i>Tavsiye Et
                    </button>
                    <button class="btn btn-outline-warning btn-sm flex-fill d-flex align-items-center justify-content-center text-light" @onclick="ToggleAskTheSeller">
                        <i class="fa fa-comments-o text-light me-2" aria-hidden="true"></i>Satıcıya Sor
                    </button>
                    <button class="btn btn-outline-dark btn-sm flex-fill d-flex align-items-center justify-content-center text-light" @onclick="ToggleIsOnSale">
                        <i class="fa fa-bell-o text-light me-2" aria-hidden="true"></i>Fiyat Düşünce Haber Ver
                    </button>
                </div>
            </div>


            @* ─── GÜVEN ROZETLERİ ─── *@
            <div class="row g-2 text-center mt-3">
                <div class="col-4">
                    <div class="bg-light rounded-3 p-3 h-100 border border-dark shadow-sm d-flex flex-column align-items-center justify-content-center">
                        <i class="fa fa-truck fa-2x text-light mb-2" aria-hidden="true"></i>
                        <span class="text-light small fw-medium">Hızlı Kargo</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="bg-light rounded-3 p-3 h-100 border border-dark shadow-sm d-flex flex-column align-items-center justify-content-center">
                        <i class="fa fa-shield fa-2x text-light mb-2" aria-hidden="true"></i>
                        <span class="text-light small fw-medium">Güvenli Ödeme</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="bg-light rounded-3 p-3 h-100 border border-dark shadow-sm d-flex flex-column align-items-center justify-content-center">
                        <i class="fa fa-undo fa-2x text-light mb-2" aria-hidden="true"></i>
                        <span class="text-light small fw-medium">Kolay İade</span>
                    </div>
                </div>
            </div>

            @* ═══════════════════════════════════════════════════════════
               ALT SEKMELER: Açıklama / Özellikler / Mağaza / Yorumlar
               ═══════════════════════════════════════════════════════════ *@
            <div class="mt-5">
                <ul class="nav nav-tabs border-secondary" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(_activeTab == "desc" ? "active bg-dark text-info border-secondary" : "text-light")"
                                @onclick='() => _activeTab = "desc"'
                                role="tab" aria-selected="@(_activeTab == "desc")" id="tab-desc">
                            <i class="fa fa-align-left me-1" aria-hidden="true"></i>Ürün Açıklaması
                        </button>
                    </li>
                    @if (_specifications.Any())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == "specs" ? "active bg-dark text-info border-secondary" : "text-light")"
                                    @onclick='() => _activeTab = "specs"'
                                    role="tab" aria-selected="@(_activeTab == "specs")" id="tab-specs">
                                <i class="fa fa-list-ul me-1" aria-hidden="true"></i>Teknik Özellikler
                            </button>
                        </li>
                    }
                    @if (_store != null)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == "store" ? "active bg-dark text-info border-secondary" : "text-light")"
                                    @onclick='() => _activeTab = "store"'
                                    role="tab" aria-selected="@(_activeTab == "store")" id="tab-store">
                                <i class="fa fa-building me-1" aria-hidden="true"></i>Satıcı Bilgileri
                            </button>
                        </li>
                    }
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(_activeTab == "reviews" ? "active bg-dark text-info border-secondary" : "text-light")"
                                @onclick="ActivateReviewsTab"
                                role="tab" aria-selected="@(_activeTab == "reviews")" id="tab-reviews">
                            <i class="fa fa-comments me-1" aria-hidden="true"></i>Yorumlar
                            @if (_reviewTotalCount > 0)
                            {
                                <span class="badge bg-info bg-opacity-25 text-info ms-1">@_reviewTotalCount</span>
                            }
                        </button>
                    </li>
                </ul>

                <div class="bg-dark bg-opacity-25 rounded-bottom-3 border border-top-0 border-secondary border-opacity-25 p-4"
                     role="tabpanel">

                    @* ═══ AÇIKLAMA SEKMESİ ═══ *@
                    @if (_activeTab == "desc")
                    {
                        <section aria-labelledby="tab-desc">
                            @if (!string.IsNullOrWhiteSpace(p.FullDescription))
                            {
                                <div class="text-light lh-lg">@((MarkupString)SanitizeDescription(p.FullDescription))</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(p.ShortDescription))
                            {
                                <p class="text-light lh-lg mb-0">@p.ShortDescription</p>
                            }
                            else
                            {
                                <p class="text-light mb-0"><i class="fa fa-info-circle me-1" aria-hidden="true"></i>Bu ürün için açıklama girilmemiş.</p>
                            }

                            @* Etiketler *@
                            @if (!string.IsNullOrWhiteSpace(p.Tags))
                            {
                                <div class="mt-4">
                                    <h6 class="text-light small fw-semibold mb-2"><i class="fa fa-tags me-1 text-info" aria-hidden="true"></i>Etiketler</h6>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tag in p.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary">@tag</span>
                                        }
                                    </div>
                                </div>
                            }
                        </section>
                    }

                    @* ═══ ÖZELLİKLER SEKMESİ ═══ *@
                    @if (_activeTab == "specs")
                    {
                        <section aria-labelledby="tab-specs">
                            <div class="table-responsive">
                                <table class="table table-dark table-striped table-borderless mb-0">
                                    <tbody>
                                        @foreach (var spec in _specifications)
                                        {
                                            <tr>
                                                <th class="text-light fw-normal" style="width:40%;">@spec.Name</th>
                                                <td class="text-light fw-semibold">@spec.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }

                    @* ═══ MAĞAZA SEKMESİ ═══ *@
                    @if (_activeTab == "store" && _store != null)
                    {
                        <section aria-labelledby="tab-store">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                @if (!string.IsNullOrEmpty(_storeProfileUrl))
                                {
                                    <img src="@_storeProfileUrl" alt="@_store.Name mağaza profili"
                                         class="rounded-circle border border-info" style="width:64px; height:64px; object-fit:cover;"
                                         width="64" height="64" loading="lazy" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-info bg-opacity-25 d-flex align-items-center justify-content-center"
                                         style="width:64px; height:64px;">
                                        <i class="fa fa-building fa-2x text-info" aria-hidden="true"></i>
                                    </div>
                                }
                                <div>
                                    <h5 class="text-light mb-1">@_store.Name</h5>
                                    @if (!string.IsNullOrEmpty(_store.Description))
                                    {
                                        <p class="text-light small mb-0">@_store.Description</p>
                                    }
                                </div>
                            </div>
                            <button class="btn btn-outline-info btn-sm" @onclick="OpenStoreModal">
                                <i class="fa fa-info-circle me-1" aria-hidden="true"></i>Mağaza Detaylarını Gör
                            </button>
                        </section>
                    }

                    @* ═══════════════════════════════════════════════════════
                       SEO: YORUMLAR SEKMESİ — Review + AggregateRating Microdata
                       ═══════════════════════════════════════════════════════ *@
                    @if (_activeTab == "reviews")
                    {
                        <section aria-labelledby="tab-reviews">

                            @* SEO: AggregateRating (yorum sayısı varsa) *@
                            @if (_reviewTotalCount > 0)
                            {
                                <div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating" class="mb-3">
                                    <meta itemprop="reviewCount" content="@_reviewTotalCount" />
                                    @if (_averageRating > 0)
                                    {
                                        <meta itemprop="ratingValue" content="@_averageRating.ToString("F1", CultureInfo.InvariantCulture)" />
                                        <meta itemprop="bestRating" content="5" />
                                        <meta itemprop="worstRating" content="1" />
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            @for (int star = 1; star <= 5; star++)
                                            {
                                                <i class="fa @(star <= Math.Round(_averageRating) ? "fa-star text-warning" : "fa-star-o text-white-50")" aria-hidden="true"></i>
                                            }
                                            <span class="text-light small fw-semibold">@_averageRating.ToString("F1") / 5</span>
                                            <span class="text-white-50 small">(@_reviewTotalCount yorum)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-white-50 small mb-2">
                                            <i class="fa fa-comments me-1" aria-hidden="true"></i>@_reviewTotalCount yorum
                                        </div>
                                    }
                                </div>
                            }

                            @* ─── YORUM YAZMA FORMU ─── *@
                            @if (use != null)
                            {
                                <div class="mb-4">
                                    <h6 class="text-light fw-semibold mb-2">
                                        <i class="fa fa-pencil me-1 text-info" aria-hidden="true"></i>Yorum Yaz
                                    </h6>

                                    @* Puanlama yıldızları *@
                                    <div class="mb-2" role="radiogroup" aria-label="Ürün puanı">
                                        @for (int star = 1; star <= 5; star++)
                                        {
                                            var s = star;
                                            <button class="btn btn-link p-0 me-1"
                                                    @onclick="() => _newReviewRating = s"
                                                    aria-label="@s yıldız">
                                                <i class="fa @(s <= _newReviewRating ? "fa-star text-warning" : "fa-star-o text-white-50") fa-lg" aria-hidden="true"></i>
                                            </button>
                                        }
                                        @if (_newReviewRating > 0)
                                        {
                                            <span class="text-light small ms-1">@_newReviewRating / 5</span>
                                        }
                                    </div>

                                    <div class="d-flex gap-2">
                                        <div class="flex-shrink-0">
                                            <div class="rounded-circle bg-info bg-opacity-25 d-flex align-items-center justify-content-center"
                                                 style="width:40px; height:40px;">
                                                <i class="fa fa-user text-info" aria-hidden="true"></i>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1">
                                            <textarea class="form-control bg-dark bg-opacity-50 text-light border-secondary"
                                                      rows="3"
                                                      placeholder="Bu ürün hakkında görüşlerinizi paylaşın…"
                                                      @bind="_newReviewText"
                                                      @bind:event="oninput"
                                                      maxlength="2000"
                                                      aria-label="Yorum metni"></textarea>
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <span class="text-white-50 small">@(_newReviewText?.Length ?? 0) / 2000</span>
                                                <button class="btn btn-info btn-sm"
                                                        @onclick="SubmitNewReview"
                                                        disabled="@(string.IsNullOrWhiteSpace(_newReviewText) || _reviewSubmitting)">
                                                    @if (_reviewSubmitting)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                    }
                                                    <i class="fa fa-paper-plane me-1" aria-hidden="true"></i>Gönder
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <hr class="border-secondary" />
                            }
                            else
                            {
                                <div class="alert alert-secondary bg-dark bg-opacity-50 border-secondary text-light mb-4">
                                    <i class="fa fa-info-circle me-2 text-info" aria-hidden="true"></i>
                                    Yorum yapabilmek için lütfen <strong>giriş yapın</strong>.
                                </div>
                            }

                            @* ─── YORUM LİSTESİ — Review Microdata ─── *@
                            @if (_reviewsLoading)
                            {
                                <div class="text-center py-4">
                                    <span class="spinner-border spinner-border-sm text-info me-2"></span>
                                    <span class="text-light small">Yorumlar yükleniyor…</span>
                                </div>
                            }
                            else if (!_reviewList.Any())
                            {
                                <div class="text-center py-4">
                                    <i class="fa fa-comment-o fa-2x text-white-50 d-block mb-2" aria-hidden="true"></i>
                                    <span class="text-white-50">Henüz yorum yapılmamış. İlk yorumu siz yazın!</span>
                                </div>
                            }
                            else
                            {
                                @* Ana yorumlar (ParentReviewId == null) — her biri itemprop="review" *@
                                @foreach (var review in _reviewList.Where(r => r.ParentReviewId == null).OrderByDescending(r => r.CreatedAt))
                                {
                                    @RenderReviewItem(review, 0)
                                }

                                @* Daha fazla yükle *@
                                @if (_reviewHasMore)
                                {
                                    <div class="text-center mt-3">
                                        <button class="btn btn-outline-secondary btn-sm"
                                                @onclick="LoadMoreReviewsAsync"
                                                disabled="@_reviewsLoading">
                                            <i class="fa fa-refresh me-1" aria-hidden="true"></i>Daha Fazla Yorum Yükle
                                        </button>
                                    </div>
                                }
                            }
                        </section>
                    }
                </div>
            </div>

            @* ═══════════════════════════════════════════════════════════════
               SEO: İLGİLİ / BENZERİ ÜRÜNLER
               Arama motorları ve kullanıcılar için iç bağlantılar
               ═══════════════════════════════════════════════════════════════ *@
            @if (_relatedProducts.Any())
            {
                <section class="mt-5" aria-label="Benzer ürünler">
                    <h2 class="h5 text-light fw-semibold mb-3">
                        <i class="fa fa-th-large me-2 text-info" aria-hidden="true"></i>Benzer Ürünler
                    </h2>
                    <div class="row g-3">
                        @foreach (var rp in _relatedProducts.Take(8))
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <a href="/Public/_Viewer/ProductProfile/@rp.Slug"
                                   class="text-decoration-none">
                                    <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 overflow-hidden h-100">
                                        @if (!string.IsNullOrEmpty(rp.CoverImageUrl))
                                        {
                                            <div style="aspect-ratio:1;" class="overflow-hidden">
                                                <img src="@rp.CoverImageUrl" alt="@rp.Name — benzer ürün"
                                                     class="w-100 h-100" style="object-fit:cover;" loading="lazy"
                                                     width="300" height="300" />
                                            </div>
                                        }
                                        <div class="p-2">
                                            <h6 class="text-light small mb-1 text-truncate" style="line-height:1.4;">@rp.Name</h6>
                                            @if (rp.Price.HasValue)
                                            {
                                                <span class="text-info fw-bold small">@rp.Price.Value.ToString("N2") ₺</span>
                                            }
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </article>

    @* ═══════════════════════════════════════════════════════════════
       MOBİL SABİT SATIN ALMA ÇUBUĞU
       ═══════════════════════════════════════════════════════════════ *@
    <div class="d-lg-none fixed-bottom bg-dark border-top border-secondary p-2"
         style="z-index:1030;" role="toolbar" aria-label="Satın alma">
        <div class="d-flex align-items-center gap-2">
            <div class="flex-shrink-0">
                @if (_currentPrice != null)
                {
                    var cur = CurrencySymbol(_currentPrice.Currency);
                    var val = _currentPrice.DiscountedPrice ?? _currentPrice.Price;
                    <div class="text-info fw-bold">@val.ToString("N2") @cur</div>
                }
            </div>
            <button class="btn btn-info btn-sm flex-fill" @onclick="OnAddToCart"
                    disabled="@(_hasStockData && _currentStockQty <= 0)"
                    aria-label="Sepete ekle">
                <i class="fa fa-shopping-cart me-1" aria-hidden="true"></i>Sepete Ekle
            </button>
            <button class="btn btn-success btn-sm flex-fill" @onclick="OnQuickBuy"
                    disabled="@(_hasStockData && _currentStockQty <= 0)"
                    aria-label="Hemen al">
                <i class="fa fa-bolt me-1" aria-hidden="true"></i>Hemen Al
            </button>
        </div>
    </div>
}

