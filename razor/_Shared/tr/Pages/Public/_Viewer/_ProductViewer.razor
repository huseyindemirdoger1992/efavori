@* ════════════════════════════════════════════════════════════════════════
   ProductProfile.razor
   ─────────────────────────────────────────────────────────────────────────
   Tekli ürün inceleme sayfası — Amazon / Trendyol / eBay tarzı profesyonel yapı.
   ✅ Yalnızca Bootstrap 5.3 + Font Awesome 4.7.0 (özel CSS/JS YOK)
   ✅ IDbContextFactory + AsNoTracking + CancellationToken
   ✅ Navigation property kullanılmaz (ID bazlı join)
   ✅ Turkish UI / English variables, single-file Razor
   ✅ GlobalStateHub, TakeLogs, IAsyncDisposable, SemaphoreSlim

   VERİ İLİŞKİLERİ:
   - Products (ana kayıt)            → Parametre olarak gelir (SelectedProduct)
   - Brands.Id          ← Products.BrandId
   - Store.Id           ← Products.StoreId
   - ProductSeo         ← ProductId (Slug, SeoTitle, SeoDescription)
   - ProductVariants    ← ProductId (varsayılan + tüm varyantlar, SKU/Barkod)
   - ProductVariantValues ← VariantId (Renk=Kırmızı, Beden=S kombinasyonları)
   - ProductAttributes / ProductAttributeValues (özellik adı/değeri çözümleme)
   - ProductPrices      ← VariantId, EffectiveTo==null (güncel fiyat, çoklu para birimi)
   - ProductStocks      ← VariantId (toplam stok = depo satırlarının toplamı)
   - ProductSpecifications ← ProductId (teknik özellik tablosu)
   - ProductCategories  ← ProductId → CategoriesTr (breadcrumb)
   - CoverMediaId       → Media (kapak görseli)
   - ItemGallery (ItemType="Product"/"ProductGallery", ItemId=ProductId) → Media (galeri)
   - ProductImageVariantGroups → değer bazlı varyant görseli (CoverMediaId)
   - ProductExternalMedias ← ProductId (video, 360, döküman)
   ════════════════════════════════════════════════════════════════════════ *@

@using api
@using api.tr
@using data
@using data._Shared
@using data._Product
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@using System.Globalization

@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}

@implements IAsyncDisposable

<Notification @ref="_notificationRef" />

@if (_loading)
{
    @* ─── İSKELET YÜKLEME ─── *@
    <div class="container-xxl py-4">
        <div class="placeholder-glow">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="placeholder col-12 rounded-3" style="height:420px;"></div>
                </div>
                <div class="col-lg-6">
                    <span class="placeholder col-4 mb-3"></span>
                    <span class="placeholder col-9 mb-2"></span>
                    <span class="placeholder col-7 mb-4"></span>
                    <span class="placeholder col-5 mb-3"></span>
                    <span class="placeholder col-12 mb-2" style="height:48px;"></span>
                </div>
            </div>
        </div>
    </div>
}
else if (_product == null)
{
    @* ─── ÜRÜN BULUNAMADI ─── *@
    <div class="container-xxl py-5 text-center text-light">
        <i class="fa fa-exclamation-triangle fa-3x text-warning mb-3 d-block"></i>
        <h4>Ürün bulunamadı</h4>
        <p class="text- light">Aradığınız ürün kaldırılmış veya yayından alınmış olabilir.</p>
        <a href="/Public/_Viewer/ProductListing" class="btn btn-info btn-sm mt-2">
            <i class="fa fa-arrow-left me-1"></i>Ürünlere Dön
        </a>
    </div>
}
else
{
    var p = _product;

    @* ═══════════════════════════════════════════════════════════════
       BREADCRUMB
       ═══════════════════════════════════════════════════════════════ *@
    var roads = new List<(string icon, string Name, string Url)>
        {
            ("fa fa-home",         "Ana Sayfa", "/"),
            ("fa fa-shopping-bag", "Ürünler",   "/tr/Public/Home/Index")
        };
    foreach (var bc in _breadcrumbCategories)
        roads.Add(("null", bc.Name ?? "—", "javascript:void(0)"));
    @*roads.Add(("null", p.Name?.Length > 40 ? p.Name.Substring(0, 40) + "…" : p.Name ?? "Ürün", "javascript:void(0)"));*@
    <div class="container-fluid pt-3">
        <razor._Shared.BreadCrumbLinksUrl roads="roads" />
    </div>

    <div class="container-fluid pb-5">
        <div class="row g-4">

            @* ═══════════════════════════════════════════════════════
               SOL: GÖRSEL GALERİ (sticky)
               ═══════════════════════════════════════════════════════ *@
            <div class="col-lg-5">
                <div class="position-lg-sticky" style="top:80px;">
                    <div class="row g-2">

                        @* Dikey küçük resimler (masaüstü) *@
                        @if (_displayImages.Count > 1)
                        {
                            <div class="col-2 d-none d-md-block">
                                <div class="d-flex flex-column gap-2" style="max-height:520px; overflow-y:auto;">
                                    @for (int i = 0; i < _displayImages.Count; i++)
                                    {
                                        var idx = i;
                                        <div role="button"
                                             class="border rounded-2 overflow-hidden @(idx == _activeImageIndex ? "border-info border-2" : "border-secondary")"
                                             style="aspect-ratio:1; @(idx == _activeImageIndex ? "" : "opacity:.6;")"
                                             @onclick="() => _activeImageIndex = idx"
                                             @onmouseover="() => _activeImageIndex = idx">
                                            <img src="@_displayImages[idx]" alt="@p.Name görseli @(idx + 1)"
                                                 class="w-100 h-100" style="object-fit:cover;" loading="lazy" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* Ana görsel *@
                        <div class="@(_displayImages.Count > 1 ? "col-md-10" : "col-12")">
                            <div class="position-relative bg-white rounded-3 overflow-hidden border border-secondary border-opacity-25"
                                 style="aspect-ratio:1;">
                                @if (_displayImages.Any())
                                {
                                    <img src="@_displayImages[_activeImageIndex]" alt="@p.Name"
                                         class="w-100 h-100" style="object-fit:contain;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text- light bg-dark">
                                        <i class="fa fa-picture-o fa-4x"></i>
                                    </div>
                                }

                                @* İndirim rozeti *@
                                @if (_currentDiscountPercent > 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 fs-6 px-3 py-2 rounded-pill">
                                        %@_currentDiscountPercent İndirim
                                    </span>
                                }

                                @* Favori (sağ üst) *@
                                <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 shadow-sm"
                                        style="width:44px; height:44px;"
                                        @onclick="ToggleFavorite" title="Favorilere Ekle">
                                    <i class="fa @(_isFavorite ? "fa-heart text-danger" : "fa-heart-o text-dark")"></i>
                                </button>
                            </div>

                            @* Yatay küçük resimler (mobil) *@
                            @if (_displayImages.Count > 1)
                            {
                                <div class="d-flex d-md-none gap-2 mt-2 overflow-auto pb-1">
                                    @for (int i = 0; i < _displayImages.Count; i++)
                                    {
                                        var idx = i;
                                        <div role="button"
                                             class="border rounded-2 overflow-hidden flex-shrink-0 @(idx == _activeImageIndex ? "border-info border-2" : "border-secondary")"
                                             style="width:64px; height:64px; @(idx == _activeImageIndex ? "" : "opacity:.6;")"
                                             @onclick="() => _activeImageIndex = idx">
                                            <img src="@_displayImages[idx]" alt="" class="w-100 h-100" style="object-fit:cover;" loading="lazy" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Harici Medya (Video / 360 / Döküman) *@
                    @if (_externalMedias.Any())
                    {
                        <div class="mt-3">
                            <h6 class="text-light small fw-semibold mb-2">
                                <i class="fa fa-film me-1 text-info"></i>Video & Medya
                            </h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var em in _externalMedias)
                                {
                                    var icon = em.MediaType switch
                                    {
                                        "VideoUrl" => "fa-youtube-play",
                                        "View360" => "fa-refresh",
                                        "Document" => "fa-file-pdf-o",
                                        _ => "fa-external-link"
                                    };
                                    <a href="@em.Url" target="_blank" rel="noopener"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="fa @icon me-1"></i>@(string.IsNullOrEmpty(em.Title) ? em.MediaType : em.Title)
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ═══════════════════════════════════════════════════════
               SAĞ: ÜRÜN BİLGİLERİ + SATIN ALMA
               ═══════════════════════════════════════════════════════ *@
            <div class="col-lg-7">

                @* Marka + Mağaza *@
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    @if (!string.IsNullOrEmpty(_brandName))
                    {
                        <a href="/Public/_Viewer/ProductListing?brand=@Uri.EscapeDataString(_brandName)"
                           class="badge bg-info bg-opacity-25 text-info border border-info text-decoration-none px-3 py-2">
                            <i class="fa fa-bookmark me-1"></i>@_brandName
                        </a>
                    }
                    @if (_store != null)
                    {
                        <button class="btn btn-link btn-sm text-warning text-decoration-none p-0"
                                @onclick="OpenStoreModal">
                            <i class="fa fa-building me-1"></i>@_store.Name
                        </button>
                    }
                </div>

                @* Başlık *@
                <h1 class="h4 text-light fw-semibold lh-base mb-2">@p.Name</h1>

                @* ─── KISA AÇIKLAMA ─── *@
                @if (!string.IsNullOrWhiteSpace(p.ShortDescription))
                {
                    <div class="bg-dark bg-opacity-25 rounded-3 p-3">
                        <p class="text-light small mb-0 lh-base">@p.ShortDescription</p>
                    </div>
                }

                @* Beğeni / Görüntülenme / SKU *@
                <div class="d-flex align-items-center flex-wrap gap-3 text- light small mb-3 mt-3">
                    <span><i class="fa fa-heart text-danger me-1"></i>@(p.Interaction?.LikeCount ?? 0) beğeni</span>
                    <span><i class="fa fa-eye me-1"></i>@(p.Interaction?.ViewCount ?? 0) görüntülenme</span>
                    @if (!string.IsNullOrEmpty(_selectedVariant?.Sku))
                    {
                        <span><i class="fa fa-tag me-1"></i>SKU: @_selectedVariant.Sku</span>
                    }
                    @if (!string.IsNullOrEmpty(_selectedVariant?.Barcode))
                    {
                        <span><i class="fa fa-barcode me-1"></i>@_selectedVariant.Barcode</span>
                    }
                </div>

                <hr class="border-secondary" />

                @* ─── FİYAT KUTUSU ─── *@
                <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 p-3 mb-3">
                    @if (_currentPrice != null)
                    {
                        var cur = CurrencySymbol(_currentPrice.Currency);
                        @if (_currentPrice.DiscountedPrice.HasValue && _currentPrice.DiscountedPrice < _currentPrice.Price)
                        {
                            <div class="d-flex align-items-baseline flex-wrap gap-2">
                                <span class="display-6 fw-bold text-info mb-0">@_currentPrice.DiscountedPrice.Value.ToString("N2") @cur</span>
                                <del class="text- light fs-5">@_currentPrice.Price.ToString("N2") @cur</del>
                                <span class="badge bg-danger fs-6">%@_currentDiscountPercent</span>
                            </div>
                            <div class="text-success small mt-1">
                                <i class="fa fa-arrow-down me-1"></i>
                                @((_currentPrice.Price - _currentPrice.DiscountedPrice.Value).ToString("N2")) @cur tasarruf ediyorsunuz
                            </div>
                        }
                        else
                        {
                            <span class="display-6 fw-bold text-info">@_currentPrice.Price.ToString("N2") @cur</span>
                        }

                        @* Diğer para birimleri *@
                        @if (_otherCurrencyPrices.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var op in _otherCurrencyPrices)
                                {
                                    var ocur = CurrencySymbol(op.Currency);
                                    var oval = (op.DiscountedPrice ?? op.Price);
                                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary">
                                        @oval.ToString("N2") @ocur
                                    </span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text- light"><i class="fa fa-info-circle me-1"></i>Fiyat bilgisi bulunmuyor</span>
                    }
                </div>

                @* ─── STOK DURUMU ─── *@
                <div class="mb-3">
                    @if (_currentStockQty > 0)
                    {
                        <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2">
                            <i class="fa fa-check-circle me-1"></i>Stokta var
                            @if (_currentStockQty <= 10)
                            {
                                <span class="ms-1">(son @_currentStockQty adet)</span>
                            }
                        </span>
                    }
                    else if (_hasStockData)
                    {
                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-3 py-2">
                            <i class="fa fa-times-circle me-1"></i>Stokta yok
                        </span>
                    }
                </div>

                @* ─── VARYANT SEÇİCİLER ─── *@
                @if (_variantAttributes.Any())
                {
                    @foreach (var attr in _variantAttributes)
                    {
                        <div class="mb-3">
                            <div class="text-light small fw-semibold mb-2">
                                @attr.AttributeName:
                                <span class="text-info">@GetSelectedValueName(attr.AttributeId)</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var val in attr.Values)
                                {
                                    var v = val;
                                    var isSelected = _selectedAttributeValues.TryGetValue(attr.AttributeId, out var sv) && sv == v.ValueId;
                                    var isAvailable = IsCombinationAvailable(attr.AttributeId, v.ValueId);

                                    @if (!string.IsNullOrEmpty(v.ColorHex))
                                    {
                                        @* Renk kutucuğu *@
                                        <button class="btn p-0 rounded-circle border @(isSelected ? "border-info border-3" : "border-secondary") @(isAvailable ? "" : "opacity-50")"
                                                style="width:40px; height:40px; background:@v.ColorHex;"
                                                disabled="@(!isAvailable)"
                                                @onclick="() => SelectVariantValue(attr.AttributeId, v.ValueId)"
                                                title="@v.ValueName"></button>
                                    }
                                    else
                                    {
                                        @* Metin etiketi *@
                                        <button class="btn btn-sm @(isSelected ? "btn-info" : "btn-outline-secondary") @(isAvailable ? "" : "opacity-50 text-decoration-line-through")"
                                                disabled="@(!isAvailable)"
                                                @onclick="() => SelectVariantValue(attr.AttributeId, v.ValueId)">
                                            @v.ValueName
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                }

                @* ─── ADET SEÇİCİ ─── *@
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="text-light small fw-semibold">Adet:</span>
                    <div class="btn-group" role="group">
                        <button class="btn btn-secondary btn-sm" @onclick="() => ChangeQuantity(-1)"
                                disabled="@(_quantity <= 1)">
                            <i class="fa fa-minus"></i>
                        </button>
                        <span class="btn btn-outline-secondary btn-sm disabled text-light" style="min-width:48px;">@_quantity</span>
                        <button class="btn btn-secondary btn-sm" @onclick="() => ChangeQuantity(1)"
                                disabled="@(_maxOrderQty.HasValue && _quantity >= _maxOrderQty.Value)">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                    @if (_maxOrderQty.HasValue)
                    {
                        <span class="text- light small">(En fazla @_maxOrderQty adet)</span>
                    }
                </div>

                                @* ─── AKSİYON BUTONLARI ─── *@
                @if (string.Equals(p.ProductType, "External", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(p.ExternalUrl))
                {
                    @* Harici ürün *@
                    <a href="@p.ExternalUrl" target="_blank" rel="noopener"
                       class="btn btn-warning btn-lg w-100 mb-2">
                        <i class="fa fa-external-link me-2"></i>@(string.IsNullOrEmpty(p.ExternalButtonText) ? "Satıcıya Git" : p.ExternalButtonText)
                    </a>
                }
                else
                {
                    <div class="d-grid gap-2 d-md-flex mb-3">
                        <button class="btn btn-info btn-lg flex-fill" @onclick="OnAddToCart"
                                disabled="@(_hasStockData && _currentStockQty <= 0)">
                            <i class="fa fa-shopping-cart me-2"></i>Sepete Ekle
                        </button>
                        <button class="btn btn-success btn-lg flex-fill" @onclick="OnQuickBuy"
                                disabled="@(_hasStockData && _currentStockQty <= 0)">
                            <i class="fa fa-bolt me-2"></i>Hemen Al
                        </button>
                    </div>
                }
   

                @* ─── GÜVEN ROZETLERİ ─── *@
                <div class="row g-2 text-center mb-3">
                    <div class="col-4">
                        <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 p-2 h-100">
                            <i class="fa fa-truck fa-lg text-info d-block mb-1"></i>
                            <span class="text-light" style="font-size:.72rem;">Hızlı Kargo</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 p-2 h-100">
                            <i class="fa fa-shield fa-lg text-info d-block mb-1"></i>
                            <span class="text-light" style="font-size:.72rem;">Güvenli Ödeme</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 p-2 h-100">
                            <i class="fa fa-undo fa-lg text-info d-block mb-1"></i>
                            <span class="text-light" style="font-size:.72rem;">Kolay İade</span>
                        </div>
                    </div>
                </div>

                @* İkincil aksiyonlar *@
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-danger btn-sm flex-fill d-flex align-items-center justify-content-center" @onclick="ToggleFavorite">
                        <i class="fa @(_isFavorite ? "fa-heart" : "fa-heart-o") me-2"></i>Favori
                    </button>

                    <button class="btn btn-warning btn-sm flex-fill d-flex align-items-center justify-content-center" @onclick="ToggleCompare">
                        <i class="fa fa-exchange me-2"></i>Karşılaştır
                    </button>

                    <button class="btn btn-info btn-sm flex-fill d-flex align-items-center justify-content-center" @onclick="OpenShareModal">
                        <i class="fa fa-share-alt me-2"></i>Paylaş
                    </button>

                    <button class="btn btn-primary btn-sm flex-fill d-flex align-items-center justify-content-center" @onclick="ToggleRecommendation">
                        <i class="fa fa-thumbs-o-up me-2"></i>Tavsiye Et
                    </button>

                    <button class="btn btn-light btn-sm flex-fill d-flex align-items-center justify-content-center" @onclick="ToggleAskTheSeller">
                        <i class="fa fa-comments-o me-2"></i>Satıcıya Sor
                    </button>

                    <button class="btn btn-secondary btn-sm flex-fill d-flex align-items-center justify-content-center" @onclick="ToggleIsOnSale">
                        <i class="fa fa-bell-o me-2"></i>Fiyat Düşünce Haber Ver
                    </button>
                </div>        
            </div>
        </div>

        @* ═══════════════════════════════════════════════════════════
           ALT SEKMELER: Açıklama / Özellikler / Mağaza
           ═══════════════════════════════════════════════════════════ *@
        <div class="mt-5">
            <ul class="nav nav-tabs border-secondary" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == "desc" ? "active bg-dark text-info border-secondary" : "text-light")"
                            @onclick='() => _activeTab = "desc"'>
                        <i class="fa fa-align-left me-1"></i>Ürün Açıklaması
                    </button>
                </li>
                @if (_specifications.Any())
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == "specs" ? "active bg-dark text-info border-secondary" : "text-light")"
                                @onclick='() => _activeTab = "specs"'>
                            <i class="fa fa-list-ul me-1"></i>Teknik Özellikler
                        </button>
                    </li>
                }
                @if (_store != null)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == "store" ? "active bg-dark text-info border-secondary" : "text-light")"
                                @onclick='() => _activeTab = "store"'>
                            <i class="fa fa-building me-1"></i>Satıcı Bilgileri
                        </button>
                    </li>
                }
            </ul>

            <div class="bg-dark bg-opacity-25 rounded-bottom-3 border border-top-0 border-secondary border-opacity-25 p-4">

                @* AÇIKLAMA SEKMESİ *@
                @if (_activeTab == "desc")
                {
                    @if (!string.IsNullOrWhiteSpace(p.FullDescription))
                    {
                        <div class="text-light lh-lg">@((MarkupString)SanitizeDescription(p.FullDescription))</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(p.ShortDescription))
                    {
                        <p class="text-light lh-lg mb-0">@p.ShortDescription</p>
                    }
                    else
                    {
                        <p class="text- light mb-0"><i class="fa fa-info-circle me-1"></i>Bu ürün için açıklama girilmemiş.</p>
                    }

                    @* Etiketler *@
                    @if (!string.IsNullOrWhiteSpace(p.Tags))
                    {
                        <div class="mt-4">
                            <h6 class="text-light small fw-semibold mb-2"><i class="fa fa-tags me-1 text-info"></i>Etiketler</h6>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var tag in p.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary">@tag</span>
                                }
                            </div>
                        </div>
                    }
                }

                @* ÖZELLİKLER SEKMESİ *@
                @if (_activeTab == "specs")
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-striped table-borderless mb-0">
                            <tbody>
                                @foreach (var spec in _specifications)
                                {
                                    <tr>
                                        <th class="text- light fw-normal" style="width:40%;">@spec.Name</th>
                                        <td class="text-light fw-semibold">@spec.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* MAĞAZA SEKMESİ *@
                @if (_activeTab == "store" && _store != null)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(_storeProfileUrl))
                        {
                            <img src="@_storeProfileUrl" alt="@_store.Name"
                                 class="rounded-circle border border-info" style="width:64px; height:64px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-info bg-opacity-25 d-flex align-items-center justify-content-center"
                                 style="width:64px; height:64px;">
                                <i class="fa fa-building fa-2x text-info"></i>
                            </div>
                        }
                        <div>
                            <h5 class="text-light mb-1">@_store.Name</h5>
                            @if (!string.IsNullOrEmpty(_store.Description))
                            {
                                <p class="text- light small mb-0">@_store.Description</p>
                            }
                        </div>
                    </div>
                    <button class="btn btn-outline-info btn-sm" @onclick="OpenStoreModal">
                        <i class="fa fa-info-circle me-1"></i>Mağaza Detaylarını Gör
                    </button>
                }
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════════════
       MOBİL SABİT SATIN ALMA ÇUBUĞU
       ═══════════════════════════════════════════════════════════════ *@
    <div class="d-lg-none fixed-bottom bg-dark border-top border-secondary p-2"
         style="z-index:1030;">
        <div class="d-flex align-items-center gap-2">
            <div class="flex-shrink-0">
                @if (_currentPrice != null)
                {
                    var cur = CurrencySymbol(_currentPrice.Currency);
                    var val = _currentPrice.DiscountedPrice ?? _currentPrice.Price;
                    <div class="text-info fw-bold">@val.ToString("N2") @cur</div>
                }
            </div>
            <button class="btn btn-info btn-sm flex-fill" @onclick="OnAddToCart"
                    disabled="@(_hasStockData && _currentStockQty <= 0)">
                <i class="fa fa-shopping-cart me-1"></i>Sepete Ekle
            </button>
            <button class="btn btn-success btn-sm flex-fill" @onclick="OnQuickBuy"
                    disabled="@(_hasStockData && _currentStockQty <= 0)">
                <i class="fa fa-bolt me-1"></i>Hemen Al
            </button>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   MAĞAZA DETAY MODALI
   ═══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="StoreDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border border-info">
            <div class="modal-header border-bottom border-info py-2">
                <h6 class="modal-title text-info mb-0"><i class="fa fa-building me-1"></i>Mağaza Bilgileri</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                @if (_store != null)
                {
                    var st = _store;
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(_storeProfileUrl))
                                {
                                    <img src="@_storeProfileUrl" alt="@st.Name" class="rounded-circle border border-info"
                                         style="width:64px; height:64px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-info bg-opacity-25 d-flex align-items-center justify-content-center"
                                         style="width:64px; height:64px;">
                                        <i class="fa fa-building fa-2x text-info"></i>
                                    </div>
                                }
                                <div>
                                    <h5 class="text-light mb-1">@st.Name</h5>
                                    @if (!string.IsNullOrEmpty(st.Description))
                                    {
                                        <p class="text- light small mb-0">@st.Description</p>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (st.ContactInformation != null)
                        {
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small mb-0"><i class="fa fa-phone me-1"></i>Telefon</label>
                                <div class="text-light">@(string.IsNullOrEmpty(st.ContactInformation.FullPhoneNumber) ? "—" : st.ContactInformation.FullPhoneNumber)</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white-50 small mb-0"><i class="fa fa-envelope me-1"></i>E-posta</label>
                                <div class="text-light">@(string.IsNullOrEmpty(st.ContactInformation.Email) ? "—" : st.ContactInformation.Email)</div>
                            </div>
                        }

                        @if (st.AddressInfo != null)
                        {
                            <div class="col-12">
                                <label class="form-label text-white-50 small mb-1"><i class="fa fa-map-marker me-1"></i>Adres</label>
                                <div class="text-light small">
                                    @st.AddressInfo.Address,
                                    @st.AddressInfo.City / @st.AddressInfo.State / @st.AddressInfo.Country
                                    @if (!string.IsNullOrEmpty(st.AddressInfo.ZipCode))
                                    {
                                        <span class="text- light"> — @st.AddressInfo.ZipCode</span>
                                    }
                                </div>
                            </div>

                            @if (st.AddressInfo.Latitude != null && st.AddressInfo.Longitude != null)
                            {
                                var lat = st.AddressInfo.Latitude.Value.ToString(CultureInfo.InvariantCulture);
                                var lng = st.AddressInfo.Longitude.Value.ToString(CultureInfo.InvariantCulture);
                                <div class="col-12 d-flex gap-2">
                                    <a href="https://www.google.com/maps/dir/?api=1&destination=@(lat),@(lng)"
                                       target="_blank" rel="noopener" class="btn btn-outline-info btn-sm">
                                        <i class="fa fa-location-arrow me-1"></i>Yol Tarifi Al
                                    </a>
                                    <a href="https://www.google.com/maps/search/?api=1&query=@(lat),@(lng)"
                                       target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-map me-1"></i>Haritada Gör
                                    </a>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   PAYLAŞ MODALI
