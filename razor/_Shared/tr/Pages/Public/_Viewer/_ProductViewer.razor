    private async Task DeleteReview(ReviewDisplayDto review)
    {
        if (use == null || _deletingReviewId != null) return;
        _deletingReviewId = review.Id;
        StateHasChanged();
        try
        {
            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);
            var idsToDelete = new List<Guid> { review.Id };
            if (review.Children.Any()) idsToDelete.AddRange(review.Children.Select(c => c.Id));
            await db.Set<ProductReview>()
                .Where(r => idsToDelete.Contains(r.Id))
                .ExecuteUpdateAsync(setters => setters
                    .SetProperty(r => r.IsDeleted!.IsDeletedStatu, true)
                    .SetProperty(r => r.IsDeleted!.DeletedAtDate, DateTime.UtcNow), token);
            if (review.ParentReviewId == null)
            {
                _reviewList.RemoveAll(r => r.Id == review.Id);
                _reviewTotalCount -= (1 + review.Children.Count);
            }
            else
            {
                var parent = _reviewList.FirstOrDefault(r => r.Id == review.ParentReviewId);
                parent?.Children.RemoveAll(c => c.Id == review.Id);
                _reviewTotalCount--;
            }
            await Notify("info", "Yorum", "Yorum başarıyla silindi.");
            await Logger.TakeIt(use.Id, PAGE_TITLE, "ReviewDelete", "delete", review.Id.ToString());
        }
        catch (Exception ex) { await LogError("DeleteReview", ex); await Notify("danger", "Hata", "Yorum silinirken sorun oluştu."); }
        finally { _deletingReviewId = null; StateHasChanged(); }
    }

