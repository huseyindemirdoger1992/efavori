            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);
            await db.Set<Products>().Where(x => x.Id == SelectedProduct.Id)
                .ExecuteUpdateAsync(s => s.SetProperty(
                    p => p.InteractionCounts.RecommendCount,
                    p => (p.InteractionCounts.RecommendCount ?? 0) + 1), token);
            if (_product != null)
            {
                _product.InteractionCounts ??= new InteractionCounts();
                _product.InteractionCounts.RecommendCount = (_product.InteractionCounts.RecommendCount ?? 0) + 1;
