    private async Task SelectVariantValue(Guid attributeId, Guid valueId)
    {
        _selectedAttributeValues[attributeId] = valueId;

        var match = _variants.FirstOrDefault(v =>
            _selectedAttributeValues.All(sel =>
                v.ValuePairs.Any(pair => pair.AttributeId == sel.Key && pair.AttributeValueId == sel.Value)));

        if (match == null)
        {
            match = _variants
                .OrderByDescending(v => v.ValuePairs.Count(pair =>
                    _selectedAttributeValues.TryGetValue(pair.AttributeId, out var sv) && sv == pair.AttributeValueId))
                .FirstOrDefault();

            if (match != null)
            {
                foreach (var (aId, vId) in match.ValuePairs)
                    _selectedAttributeValues[aId] = vId;
            }
        }

        _selectedVariant = match;

        ApplyVariantImage(valueId);

        try
        {
            var token = _cts.Token;
            await using var db = await DbFactory.CreateDbContextAsync(token);
            await RefreshSelectedVariantDataAsync(db, token);
        }
        catch (Exception ex) { await LogError("SelectVariantValue", ex); }

        StateHasChanged();
    }

    private void ApplyVariantImage(Guid valueId)
    {
        if (_variantGroupCovers.TryGetValue(valueId, out var mediaId) && mediaId.HasValue)
        {
            _activeImageIndex = 0;
        }
    }

    private string GetSelectedValueName(Guid attributeId)
    {
        if (!_selectedAttributeValues.TryGetValue(attributeId, out var valueId)) return "";
        var grp = _variantAttributes.FirstOrDefault(a => a.AttributeId == attributeId);
        return grp?.Values.FirstOrDefault(v => v.ValueId == valueId)?.ValueName ?? "";
    }

    private bool IsCombinationAvailable(Guid attributeId, Guid valueId)
    {
        var hypothetical = new Dictionary<Guid, Guid>(_selectedAttributeValues) { [attributeId] = valueId };

        return _variants.Any(v =>
            hypothetical.All(sel =>
                v.ValuePairs.Any(pair => pair.AttributeId == sel.Key && pair.AttributeValueId == sel.Value)));
    }

