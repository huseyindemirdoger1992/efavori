@using System.Globalization
@using data
@code {
    [Parameter]
    public Users? _use { get; set; }
    _ApplicationConnectionDb db = new _ApplicationConnectionDb();
    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    public int GetTaskCategoryStructureCount(string CategoryStructure)
    {
        int info = 0;
        if (_use != null)
        {
            info = db.TaskCategories
.Where(x => x.CategoryStructure == CategoryStructure && x.IsDeleted.IsDeletedStatu != true && x.IsDeleted == null && x.UserId == _use.Id)
.ToList()
.Count();
        }
        return info;
    }
}

