@using razor._Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@code {
    [Parameter]
    public Users? _use { get; set; }
    string culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;

    [Parameter] public Users? CurrentUser { get; set; }

    #region Services
    [Inject] protected IDbContextFactory<_ApplicationConnectionDb> DbFactory { get; init; } = default!;
    [Inject] protected GlobalStateHub StateHub { get; init; } = default!;
    [Inject] protected IJSRuntime JS { get; init; } = default!;
    #endregion

    #region State Management
    private readonly CancellationTokenSource _cts = new();
    private readonly SemaphoreSlim _writeLock = new(1, 1);
    private bool _isLoading;
    private bool _isProcessing;
    private bool _OpenFramework = false;
    private CancellationTokenSource? _searchCts;
    #endregion

    #region Data Properties
    protected List<Users>? Users { get; set; } = new();

    // Görev Paneli verileri — GlobalStateHub cache üzerinden beslenir
    private List<TaskFramework> _taskFrameworks = new();
    private int _planningCount;
    private int _inProcessCount;
    private int _completedCount;

    string? UsersType = null;
    #endregion


    #region UI Helpers
    private Notification? notificationRef;

    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
    #endregion


    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        // GlobalStateHub event'lerine abone ol
        StateHub.OnDataChanged += HandleGlobalDataChange;

        // İlk veri yükleme
        await LoadData(null);
        await LoadSidebarSpecificData();
    }

    /// <summary>
    /// GLOBAL SİNYALİ YAKALA
    /// Başka bir kullanıcı veri eklerse/güncelleyerse burası tetiklenir
    /// </summary>
    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_isProcessing) return;

        var shouldRefreshUsers = entityName == "Users";
        var shouldRefreshSidebar = entityName is "TaskFramework" or "TaskCategories" or "Users";

        if (shouldRefreshUsers || shouldRefreshSidebar)
        {
            await InvokeAsync(async () =>
            {
                if (shouldRefreshUsers)
                    await LoadData(null);

                if (shouldRefreshSidebar)
                    await LoadSidebarSpecificData();

                StateHasChanged();
            });
        }
    }

    /// <summary>
    /// ✅ MEMORY LEAK ÖNLEMİ: Event subscription'ları ve kaynakları temizle
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        StateHub.OnDataChanged -= HandleGlobalDataChange;

        _searchCts?.Cancel();
        _searchCts?.Dispose();

        await _cts.CancelAsync();
        _cts.Dispose();

        _writeLock.Dispose();

        GC.SuppressFinalize(this);
    }

    #endregion


    #region Data Loading

    /// <summary>
    /// Kullanıcı listesi yükleme — Debounced
    /// </summary>
    protected virtual async Task LoadData(string? search)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(1000, token);

            if (_isLoading) return;

            _isLoading = true;
            StateHasChanged();

            var result = await StateHub.GetOrLoadAsync("DataViewer_Main", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query = db.Users.AsNoTracking().Where(u => u.IsActive == true);

                if (!string.IsNullOrWhiteSpace(search))
                {
                    query = query.Where(u =>
                        u.FirstName.Contains(search) ||
                        u.LastName.Contains(search));
                }

                var users = await query.OrderByDescending(u => u.RegistrationDate)
                                       .ToListAsync(token);
                return new { Users = users };
            }, token);

            if (result != null && !token.IsCancellationRequested)
            {
                Users = result.Users;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] LoadData: {ex.Message}");
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Sidebar'a özel verileri GlobalStateHub cache üzerinden yükle:
    /// - TaskFramework listesi
    /// - Görev durumu sayaçları (Planning / InProcess / Completed)
    /// </summary>
    private async Task LoadSidebarSpecificData()
    {
        if (_use == null) return;

        var userId = _use.Id;

        try
        {
            // TaskFramework listesini cache'den veya DB'den çek
            var frameworkResult = await StateHub.GetOrLoadAsync("Sidebar_TaskFramework", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
                return await db.TaskFramework.AsNoTracking().ToListAsync(_cts.Token);
            }, _cts.Token);

            _taskFrameworks = frameworkResult ?? new List<TaskFramework>();

            // Görev kategorisi sayaçlarını cache'den veya DB'den çek
            var countsResult = await StateHub.GetOrLoadAsync($"Sidebar_TaskCounts_{userId}", async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);

                var baseQuery = db.TaskCategories
                    .AsNoTracking()
                    .Where(x => x.UserId == userId && (x.IsDeleted == null || x.IsDeleted.IsDeletedStatu != true));

                var planning = await baseQuery.CountAsync(x => x.CategoryStructure == "PlanningTaskBoard", _cts.Token);
                var inProcess = await baseQuery.CountAsync(x => x.CategoryStructure == "InProcessTaskBoard", _cts.Token);
                var completed = await baseQuery.CountAsync(x => x.CategoryStructure == "CompletedTaskBoard", _cts.Token);

                return new { Planning = planning, InProcess = inProcess, Completed = completed };
            }, _cts.Token);

            if (countsResult != null)
            {
                _planningCount = countsResult.Planning;
                _inProcessCount = countsResult.InProcess;
                _completedCount = countsResult.Completed;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] LoadSidebarSpecificData: {ex.Message}");
        }
    }

    public void OpenFramework()
    {
        _OpenFramework = !_OpenFramework;
        StateHasChanged();
    }

    #endregion
}

