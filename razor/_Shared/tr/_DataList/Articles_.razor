@using System.Globalization
@using data
@using api
@using api.tr
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

<Notification @ref="notificationRef" />

@if (_isLoading && !_Articles.Any())
{
    <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-light mt-2 small">Yazılar yükleniyor...</p>
    </div>
}
else if (!_Articles.Any())
{
    <div class="col-12 text-center py-5">
        <i class="fa fa-paper-plane-o fa-3x text-light opacity-50 mb-3 d-block"></i>
        <p class="text-light small">Yazı bulunamadı.</p>
    </div>
}
else
{
    @foreach (Article item in _Articles.Take(_visibleCount))
    {
        <div class="col-12 col-sm-4 col-lg-3 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <img src="https://placehold.co/48x48/6c757d/ffffff?text=?"
                                 class="rounded-circle border border-2 border-white shadow-sm"
                                 width="50" height="50" alt="avatar">
                            <div>
                                <h6 class="mb-0 fw-bold text-light">@item.UserStoreId</h6>
                            </div>
                        </div>
                        <div class="text-light small">
                            <i class="fa fa-clock-o me-1"></i>
                            @* @(item.Meta?.CreatedAt?.ToString("dd.MM.yyyy") ?? "-") *@
                        </div>
                    </div>

                    <div class="post-content">
                        <h6 class="fw-bold mb-2">@item.Title</h6>
                        <p class="text-light lh-base mb-3">@item.Description</p>
                    </div>

                    <hr class="opacity-10">

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex gap-4">
                            <span class="text-warning small">
                                <i class="fa fa-eye me-1"></i>
                                <strong>@(item.Interaction?.ViewCount ?? 0)</strong>
                            </span>
                            <span class="text-danger small">
                                <i class="fa fa-heart-o me-1"></i>
                                <strong>@(item.Interaction?.LikeCount ?? 0)</strong>
                            </span>
                            <span class="text-info small">
                                <i class="fa fa-comment-o me-1"></i>
                                <strong>@(item.Interaction?.BookmarkCount ?? 0)</strong>
                            </span>
                        </div>
                        <button class="btn btn-sm text-light p-0">
                            <i class="fa fa-share-alt me-1"></i> Paylaş
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

    @if (_visibleCount < _Articles.Count)
    {
        <div class="col-12 text-center mt-3">
            <button class="btn btn-light btn-sm px-4" @onclick="LoadMore" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="fa fa-chevron-down me-1"></i>Daha Fazla Göster
                <span class="badge bg-light text-dark ms-1">
                    +@(Math.Min(PAGE_SIZE, _Articles.Count - _visibleCount))
                </span>
            </button>
        </div>
    }
}

@code {

    private const string PAGE = "DataManager";
    private const int PAGE_SIZE = 12;

    [Parameter] public Users? use { get; set; }
    [Parameter] public string? SearchWantedText { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;
    private bool _isLoading;
    private CancellationTokenSource? _searchCts;
    private bool _isProcessing;

    private int _visibleCount = PAGE_SIZE;

    private List<Article> _Articles { get; set; } = new();

    private Notification? notificationRef;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;
        await LoadData(null);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isInitialized) return;
        _visibleCount = PAGE_SIZE;
        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleGlobalDataChange;
        await _cts.CancelAsync();
        _cts.Dispose();
        GC.SuppressFinalize(this);
    }

    // ── Global broadcast handler ───────────────────────────────────────────────

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;
        if (entityName != "Wanted" && entityName != "Article") return;

        await InvokeAsync(async () =>
        {
            await LoadData(null);
            StateHasChanged();
        });
    }

    // ── Sayfalama ─────────────────────────────────────────────────────────────

    private void LoadMore()
    {
        _visibleCount += PAGE_SIZE;
        StateHasChanged();
    }

    // ── Veri yükleme ──────────────────────────────────────────────────────────

    protected virtual async Task LoadData(string? search)
    {
        if (use is null) return;

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(400, token);

            if (_isLoading) return;
            _isLoading = true;
            StateHasChanged();

            var cacheKey = $"data_Articles_{SearchWantedText ?? "all"}";

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query_Articles = db.Article
                    .AsNoTracking()
                    .Where(a => a.IsDeleted!.IsDeletedStatu != true);

                if (!string.IsNullOrWhiteSpace(SearchWantedText))
                {
                    var sw = SearchWantedText;
                    query_Articles = query_Articles.Where(a =>
                        a.Title.Contains(sw) ||
                        a.Description.Contains(sw));
                }

                if (!string.IsNullOrWhiteSpace(search))
                {
                    var s = search;
                    query_Articles = query_Articles.Where(a =>
                        a.Title.Contains(s) ||
                        a.Description.Contains(s));
                }

                var articles = await query_Articles
                    .ToListAsync(token);

                return new { Articles = articles };

            }, token);

            if (result != null && !token.IsCancellationRequested)
            {
                _Articles = result.Articles;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    // ── Yardımcı ──────────────────────────────────────────────────────────────

    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
}