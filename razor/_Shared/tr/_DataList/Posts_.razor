@using System.Globalization
@using data
@using api
@using api.tr
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

<Notification @ref="notificationRef" />

@if (_isLoading && !_Posts.Any())
{
    <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-light mt-2 small">Gönderiler yükleniyor...</p>
    </div>
}
else if (!_Posts.Any())
{
    <div class="col-12 text-center py-5">
        <i class="fa fa-th-large fa-3x text-light opacity-50 mb-3 d-block"></i>
        <p class="text-light small">Gönderi bulunamadı.</p>
    </div>
}
else
{
    @foreach (Posts item in _Posts.Take(_visibleCount))
    {
        <div class="col-12 col-sm-4 col-lg-3 col-xl-3">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-light">

                <div class="card-header bg-transparent border-0 pt-3 pb-0 px-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <div class="position-relative">
                                <img src="https://placehold.co/45x45/0d6efd/ffffff?text=?"
                                     class="rounded-circle border border-2 border-primary p-1"
                                     alt="avatar" width="45" height="45">
                                <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-2 border-dark rounded-circle"
                                      style="width:12px;height:12px;" title="Çevrimiçi"></span>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-light small">@item.UserStoreId</h6>
                                <small class="text-light opacity-75" style="font-size:0.7rem;">
                                    <i class="fa fa-clock-o me-1"></i>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                </small>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-light p-0" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa fa-ellipsis-h" style="margin-left:5px;"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 py-2"
                                           href="/profile/@item.UserStoreId">
                                        <i class="fa fa-user opacity-50"></i> Profile Git
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="#">
                                        <i class="fa fa-warning opacity-50"></i> Şikayet Et
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="card-body p-3">
                    <p class="text-light mb-3 small" style="font-size:0.9rem;line-height:1.5;">
                        @item.Content
                    </p>
                </div>

                <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                    <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                        <div class="text-light opacity-75 d-flex align-items-center gap-1">
                            <i class="fa fa-eye" style="font-size:0.8rem;"></i>
                            <span class="fw-bold" style="font-size:0.7rem;">
                                @(item.Interaction?.ViewCount ?? 0)
                            </span>
                        </div>
                        <a href="javascript:void(0)" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                            <i class="fa fa-heart-o" style="font-size:0.8rem;"></i>
                            <span class="fw-bold" style="font-size:0.7rem;">
                                @(item.Interaction?.LikeCount ?? 0)
                            </span>
                        </a>
                        <a href="javascript:void(0)" class="text-info text-decoration-none d-flex align-items-center gap-1">
                            <i class="fa fa-comment-o" style="font-size:0.8rem;"></i>
                            <span class="fw-bold" style="font-size:0.7rem;">
                                @* @(item.Interaction?.CommentCount ?? 0) *@
                            </span>
                        </a>
                        <a href="javascript:void(0)" class="text-warning text-decoration-none d-flex align-items-center gap-1">
                            <i class="fa fa-share-alt" style="font-size:0.8rem;"></i>
                            <span class="fw-bold" style="font-size:0.7rem;">
                                @(item.Interaction?.ShareCount ?? 0)
                            </span>
                        </a>
                        <a href="javascript:void(0)" class="text-light text-decoration-none opacity-75">
                            <i class="fa fa-bookmark-o" style="font-size:0.8rem;"></i>
                            <span class="fw-bold" style="font-size:0.7rem;">
                                @* @(item.Interaction?.SaveCount ?? 0) *@
                            </span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    }

    @if (_visibleCount < _Posts.Count)
    {
        <div class="col-12 text-center mt-3">
            <button class="btn btn-light btn-sm px-4" @onclick="LoadMore" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="fa fa-chevron-down me-1"></i>Daha Fazla Göster
                <span class="badge bg-light text-dark ms-1">
                    +@(Math.Min(PAGE_SIZE, _Posts.Count - _visibleCount))
                </span>
            </button>
        </div>
    }
}

@code {

    private const string PAGE = "DataManager";
    private const int PAGE_SIZE = 12;

    [Parameter] public Users? use { get; set; }
    [Parameter] public string? SearchWantedText { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;
    private bool _isLoading;
    private CancellationTokenSource? _searchCts;
    private bool _isProcessing;

    private int _visibleCount = PAGE_SIZE;

    private List<Posts> _Posts { get; set; } = new();

    private Notification? notificationRef;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;
        await LoadData(null);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isInitialized) return;
        _visibleCount = PAGE_SIZE;
        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleGlobalDataChange;
        await _cts.CancelAsync();
        _cts.Dispose();
        GC.SuppressFinalize(this);
    }

    // ── Global broadcast handler ───────────────────────────────────────────────

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;
        if (entityName != "Wanted" && entityName != "Posts") return;

        await InvokeAsync(async () =>
        {
            await LoadData(null);
            StateHasChanged();
        });
    }

    // ── Sayfalama ─────────────────────────────────────────────────────────────

    private void LoadMore()
    {
        _visibleCount += PAGE_SIZE;
        StateHasChanged();
    }

    // ── Veri yükleme ──────────────────────────────────────────────────────────

    protected virtual async Task LoadData(string? search)
    {
        if (use is null) return;

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(400, token);

            if (_isLoading) return;
            _isLoading = true;
            StateHasChanged();

            var cacheKey = $"data_Posts_{SearchWantedText ?? "all"}";

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query_Posts = db.Posts
                    .AsNoTracking()
                    .Where(p => p.IsDeleted!.IsDeletedStatu != true);

                // SearchWantedText filtresi — null-safe
                if (!string.IsNullOrWhiteSpace(SearchWantedText))
                {
                    var sw = SearchWantedText;
                    query_Posts = query_Posts.Where(p =>
                        p.Content.Contains(sw));
                }

                // Anlık arama filtresi
                if (!string.IsNullOrWhiteSpace(search))
                {
                    var s = search;
                    query_Posts = query_Posts.Where(p =>
                        p.Content.Contains(s));
                }

                var posts = await query_Posts
                    .OrderByDescending(p => p.CreatedDate)
                    .ToListAsync(token);

                return new { Posts = posts };

            }, token);

            if (result != null && !token.IsCancellationRequested)
            {
                _Posts = result.Posts;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    // ── Yardımcı ──────────────────────────────────────────────────────────────

    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
}