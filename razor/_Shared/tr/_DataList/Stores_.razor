@using System.Globalization
@using data
@using api
@using api.tr
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

<Notification @ref="notificationRef" />

@if (_isLoading && !_Store.Any())
{
    <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-light mt-2 small">Mağazalar yükleniyor...</p>
    </div>
}
else if (!_Store.Any())
{
    <div class="col-12 text-center py-5">
        <i class="fa fa-briefcase fa-3x text-light opacity-50 mb-3 d-block"></i>
        <p class="text-light small">Mağaza bulunamadı.</p>
    </div>
}
else
{
    @foreach (Store item in _Store.Take(_visibleCount))
    {
        <div class="col-12 col-sm-4 col-lg-3 col-xl-3">
            <div class="card border-0 shadow-sm h-100 overflow-hidden position-relative"
                 style="background: linear-gradient(rgba(32, 32, 32, 0.9), rgba(32, 32, 32, 0.9)), url('@(item.ProfileCoverGallery?.CoverImagePath ?? "https://efavori.com/_files/main/NoImage.png")') center/cover no-repeat; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);">

                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3 mb-4">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(item.ProfileCoverGallery?.ProfileImagePath) ? "https://efavori.com/_files/main/NoImage.png" : item.ProfileCoverGallery.ProfileImagePath)"
                                 class="rounded-3 border flex-shrink-0 shadow-sm"
                                 width="80" height="80" alt="Mağaza Logosu">
                        </div>
                    </div>

                    <p class="text-light small mb-3" style="line-height: 1.6;">
                        <div>
                            <h6 class="fw-bold mb-1 text-light">@item.Name</h6>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <span class="text-light small">
                                    <i class="fa fa-globe me-1 text-info"></i>
                                    @if (!string.IsNullOrEmpty(item.AddressInfo?.Country))
                                    {
                                        <text> > @item.AddressInfo.Country</text>
                                    }
                                    @if (!string.IsNullOrEmpty(item.AddressInfo?.State))
                                    {
                                        <text> > @item.AddressInfo.State</text>
                                    }
                                    @if (!string.IsNullOrEmpty(item.AddressInfo?.City))
                                    {
                                        <text> > @item.AddressInfo.City</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <hr />
                        @item.Description
                    </p>

                    <div class="mb-4">
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-bordered table-sm mb-0 text-left">
                                <thead class="bg-light text-light">
                                    <tr>
                                        <th class="py-2 fw-bold border-bottom" style="width: 40%;">
                                            Gün <i class="fa fa-calendar" aria-hidden="true"></i>
                                        </th>
                                        <th class="py-2 fw-bold border-bottom">
                                            Açılış <i class="fa fa-clock-o" aria-hidden="true"></i>
                                        </th>
                                        <th class="py-2 fw-bold border-bottom">
                                            Kapanış <i class="fa fa-clock-o" aria-hidden="true"></i>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="bg-light text-light">
                                    @if (item.WorkingHours?.IsActiveMonday == true)
                                    {
                                        <tr>
                                            <td class="fw-medium">Pazartesi</td>
                                            <td>@item.WorkingHours.StartTimeMonday?.ToString("HH:mm")</td>
                                            <td>@item.WorkingHours.FinishTimeMonday?.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="text-danger">
                                            <td class="fw-medium">Pazartesi</td>
                                            <td colspan="2" class="text-center"><i class="fa fa-times-circle me-1"></i>Kapalı</td>
                                        </tr>
                                    }
                                    @if (item.WorkingHours?.IsActiveTuesday == true)
                                    {
                                        <tr>
                                            <td class="fw-medium">Salı</td>
                                            <td>@item.WorkingHours.StartTimeTuesday?.ToString("HH:mm")</td>
                                            <td>@item.WorkingHours.FinishTimeTuesday?.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="text-danger">
                                            <td class="fw-medium">Salı</td>
                                            <td colspan="2" class="text-center"><i class="fa fa-times-circle me-1"></i>Kapalı</td>
                                        </tr>
                                    }
                                    @if (item.WorkingHours?.IsActiveWednesday == true)
                                    {
                                        <tr>
                                            <td class="fw-medium">Çarşamba</td>
                                            <td>@item.WorkingHours.StartTimeWednesday?.ToString("HH:mm")</td>
                                            <td>@item.WorkingHours.FinishTimeWednesday?.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="text-danger">
                                            <td class="fw-medium">Çarşamba</td>
                                            <td colspan="2" class="text-center"><i class="fa fa-times-circle me-1"></i>Kapalı</td>
                                        </tr>
                                    }
                                    @if (item.WorkingHours?.IsActiveThursday == true)
                                    {
                                        <tr>
                                            <td class="fw-medium">Perşembe</td>
                                            <td>@item.WorkingHours.StartTimeThursday?.ToString("HH:mm")</td>
                                            <td>@item.WorkingHours.FinishTimeThursday?.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="text-danger">
                                            <td class="fw-medium">Perşembe</td>
                                            <td colspan="2" class="text-center"><i class="fa fa-times-circle me-1"></i>Kapalı</td>
                                        </tr>
                                    }
                                    @if (item.WorkingHours?.IsActiveFriday == true)
                                    {
                                        <tr>
                                            <td class="fw-medium">Cuma</td>
                                            <td>@item.WorkingHours.StartTimeFriday?.ToString("HH:mm")</td>
                                            <td>@item.WorkingHours.FinishTimeFriday?.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="text-danger">
                                            <td class="fw-medium">Cuma</td>
                                            <td colspan="2" class="text-center"><i class="fa fa-times-circle me-1"></i>Kapalı</td>
                                        </tr>
                                    }
                                    @if (item.WorkingHours?.IsActiveSaturday == true)
                                    {
                                        <tr>
                                            <td class="fw-medium">Cumartesi</td>
                                            <td>@item.WorkingHours.StartTimeSaturday?.ToString("HH:mm")</td>
                                            <td>@item.WorkingHours.FinishTimeSaturday?.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="text-danger">
                                            <td class="fw-medium">Cumartesi</td>
                                            <td colspan="2" class="text-center"><i class="fa fa-times-circle me-1"></i>Kapalı</td>
                                        </tr>
                                    }
                                    @if (item.WorkingHours?.IsActiveSunday == true)
                                    {
                                        <tr>
                                            <td class="fw-medium">Pazar</td>
                                            <td>@item.WorkingHours.StartTimeSunday?.ToString("HH:mm")</td>
                                            <td>@item.WorkingHours.FinishTimeSunday?.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="text-danger">
                                            <td class="fw-medium">Pazar</td>
                                            <td colspan="2" class="text-center"><i class="fa fa-times-circle me-1"></i>Kapalı</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row g-0 border rounded-3 overflow-hidden mb-4">
                        <div class="col-4 border-end bg-light py-3 text-center">
                            <div class="fw-bold text-light mb-0">1,240</div>
                            <div class="text-muted small text-light fw-semibold" style="font-size: 0.65rem;">Ürün</div>
                        </div>
                        <div class="col-4 border-end bg-light py-3 text-center border-start">
                            <div class="fw-bold text-light mb-0">4.8 <i class="fa fa-star text-warning"></i></div>
                            <div class="text-muted small text-light fw-semibold" style="font-size: 0.65rem;">Puan</div>
                        </div>
                        <div class="col-4 bg-light py-3 text-center border-start">
                            <div class="fw-bold text-light mb-0">
                                @if (item.CreatedAt.HasValue)
                                {
                                    @((DateTime.UtcNow.Day - item.CreatedAt.Value.Day).ToString())
                                    <text> Gün</text>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                            <div class="text-muted small text-light fw-semibold" style="font-size: 0.65rem;">Deneyim</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/store/@item.Id" class="btn btn-primary btn-sm flex-grow-1 py-2 rounded-2 fw-medium border">
                            <i class="fa fa-shopping-bag me-2"></i>Mağazaya Git
                        </a>
                        <button class="btn btn-danger btn-sm px-2 rounded-2" title="Takip Et">
                            <i class="fa fa-heart-o"></i>
                        </button>
                        @if (item.ContactInformation?.IsActivePhoneNumber == true &&
                                                                                                     !string.IsNullOrEmpty(item.ContactInformation.FullPhoneNumber))
                        {
                            <a href="tel:@item.ContactInformation.FullPhoneNumber"
                                   class="btn btn-success btn-sm px-2 rounded-2" title="Telefon">
                                <i class="fa fa-phone"></i>
                            </a>
                        }
                        @if (item.ContactInformation?.IsActiveEmail == true &&
                                                                                                     !string.IsNullOrEmpty(item.ContactInformation.Email))
                        {
                            <a href="mailto:@item.ContactInformation.Email"
                                   class="btn btn-primary btn-sm px-2 rounded-2" title="E-posta">
                                <i class="fa fa-envelope-open-o"></i>
                            </a>
                        }
                        @if (item.AddressInfo?.Latitude.HasValue == true &&
                                                                                                     item.AddressInfo?.Longitude.HasValue == true)
                        {
                            <a href="https://www.google.com/maps?q=@item.AddressInfo.Latitude,@item.AddressInfo.Longitude"
                                   target="_blank"
                                   class="btn btn-warning btn-sm px-2 rounded-2" title="Konum">
                                <i class="fa fa-map-o"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_visibleCount < _Store.Count)
    {
        <div class="col-12 text-center mt-3">
            <button class="btn btn-light btn-sm px-4" @onclick="LoadMore" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="fa fa-chevron-down me-1"></i>Daha Fazla Göster
                <span class="badge bg-light text-dark ms-1">+@(Math.Min(PAGE_SIZE, _Store.Count - _visibleCount))</span>
            </button>
        </div>
    }
}

@code {

    private const string PAGE = "DataManager";
    private const int PAGE_SIZE = 12;

    [Parameter] public Users? use { get; set; }
    [Parameter] public string? SearchWantedText { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;
    private bool _isLoading;
    private CancellationTokenSource? _searchCts;
    private bool _isProcessing;

    private int _visibleCount = PAGE_SIZE;

    private List<Store> _Store { get; set; } = new();

    private Notification? notificationRef;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;
        await LoadData(null);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isInitialized) return;
        _visibleCount = PAGE_SIZE;
        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleGlobalDataChange;
        await _cts.CancelAsync();
        _cts.Dispose();
        GC.SuppressFinalize(this);
    }

    // ── Global broadcast handler ───────────────────────────────────────────────

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;
        if (entityName != "Wanted" && entityName != "Store") return;

        await InvokeAsync(async () =>
        {
            await LoadData(null);
            StateHasChanged();
        });
    }

    // ── Sayfalama ─────────────────────────────────────────────────────────────

    private void LoadMore()
    {
        _visibleCount += PAGE_SIZE;
        StateHasChanged();
    }

    // ── Veri yükleme ──────────────────────────────────────────────────────────

    protected virtual async Task LoadData(string? search)
    {
        if (use is null) return;

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(400, token);

            if (_isLoading) return;
            _isLoading = true;
            StateHasChanged();

            var cacheKey = $"data_Stores_{SearchWantedText ?? "all"}";

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query_Store = db.Stores
                    .AsNoTracking()
                    .Include(s => s.WorkingHours)       // ← TEK DEĞİŞİKLİK: bu satır eklendi
                    .Include(s => s.ProfileCoverGallery)
                    .Include(s => s.AddressInfo)
                    .Include(s => s.ContactInformation)
                    .Where(s => s.IsDeleted!.IsDeletedStatu != true);

                if (!string.IsNullOrWhiteSpace(SearchWantedText))
                {
                    var sw = SearchWantedText;
                    query_Store = query_Store.Where(s =>
                        s.Name.Contains(sw) ||
                        s.Description.Contains(sw));
                }

                if (!string.IsNullOrWhiteSpace(search))
                {
                    var s = search;
                    query_Store = query_Store.Where(x =>
                        x.Name.Contains(s) ||
                        x.Description.Contains(s));
                }

                var stores = await query_Store
                    .OrderByDescending(s => s.CreatedAt)
                    .ToListAsync(token);

                return new { Store = stores };

            }, token);

            if (result != null && !token.IsCancellationRequested)
            {
                _Store = result.Store;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    // ── Yardımcı ──────────────────────────────────────────────────────────────

    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
}
