@using System.Globalization
@using data
@using api
@using api.tr
@using Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using razor._Shared
@inject IDbContextFactory<_ApplicationConnectionDb> DbFactory
@inject GlobalStateHub StateHub
@inject IJSRuntime JS
@inject TakeLogs Logger

<Notification @ref="notificationRef" />

@if (_isLoading && !_Users.Any())
{
    <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-light mt-2 small">Kullanıcılar yükleniyor...</p>
    </div>
}
else if (!_Users.Any())
{
    <div class="col-12 text-center py-5">
        <i class="fa fa-users fa-3x text-light opacity-50 mb-3 d-block"></i>
        <p class="text-light small">Kullanıcı bulunamadı.</p>
    </div>
}
else
{
    @foreach (Users item in _Users.Take(_visibleCount))
    {
        var sentRequest = _FriendShip?.FirstOrDefault(fs =>
            fs.RequestorId == use.Id &&
            fs.ReceiverId == item.Id &&
            fs.IsDeleted?.IsDeletedStatu != true);

        var receivedRequest = _FriendShip?.FirstOrDefault(fs =>
            fs.RequestorId == item.Id &&
            fs.ReceiverId == use.Id &&
            fs.IsDeleted?.IsDeletedStatu != true);

        bool isFriend = (sentRequest?.Status == true) || (receivedRequest?.Status == true);
        bool isBlocked = (sentRequest?.Block == true) || (receivedRequest?.Block == true);
        bool isPending = sentRequest != null && sentRequest.Status == null && sentRequest.Block != true;
        bool isRejected = sentRequest?.Status == false;

        <div class="col-12 col-sm-4 col-lg-3 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="position-relative flex-shrink-0">
                            <img src="@(item.ProfileCoverGallery?.ProfileImagePath ?? "https://placehold.co/56x56/6c757d/ffffff?text=?")"
                                 class="rounded-circle border border-2 border-light shadow-sm"
                                 width="56" height="56" alt="@item.FirstName @item.LastName">
                            <span class="position-absolute bottom-0 end-0 bg-success border border-2 border-white rounded-circle"
                                  style="width:12px;height:12px;" title="Çevrimiçi"></span>
                        </div>
                        <div class="overflow-hidden">
                            <strong class="d-block text-truncate">@item.FirstName @item.LastName</strong>
                            <span class="text-light small d-block text-truncate">
                                <i class="fa fa-envelope-o me-1"></i>@item.ContactInformation?.Email
                            </span>
                            @if (item.DateOfBirth.HasValue)
                            {
                                <span class="badge bg-light text-light border small mt-1">
                                    <i class="fa fa-calendar-o me-1"></i>@item.DateOfBirth.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        @if (isBlocked)
                        {
                            <button class="btn btn-outline-secondary btn-sm flex-grow-1" disabled title="Bu kullanıcı bloklandı">
                                <i class="fa fa-ban me-1"></i>Bloklandı
                            </button>
                        }
                        else if (isFriend)
                        {
                            <button class="btn btn-success btn-sm flex-grow-1" disabled title="Zaten arkadaşsınız">
                                <i class="fa fa-check me-1"></i>Arkadaşsınız
                            </button>
                        }
                        else if (isPending)
                        {
                            <button class="btn btn-outline-danger btn-sm flex-grow-1"
                                    @onclick="() => CancelFriendShip(sentRequest!.Id)"
                                    title="Gönderilen isteği geri al">
                                <i class="fa fa-user-times me-1"></i>İsteği Geri Al
                            </button>
                        }
                        else if (isRejected)
                        {
                            <button class="btn btn-outline-primary btn-sm flex-grow-1"
                                    @onclick="() => AddFriendShip(item.Id)"
                                    title="Tekrar arkadaşlık isteği gönder">
                                <i class="fa fa-user-plus me-1"></i>Takip Et
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm flex-grow-1"
                                    @onclick="() => AddFriendShip(item.Id)"
                                    title="Arkadaşlık isteği gönder">
                                <i class="fa fa-user-plus me-1"></i>Takip Et
                            </button>
                        }

                        <a href="/profile/@item.Id" class="btn btn-light border btn-sm px-3" title="Profile Git">
                            <i class="fa fa-user-circle-o"></i>
                        </a>
                    </div>

                </div>
            </div>
        </div>
    }

    @if (_visibleCount < _Users.Count)
    {
        <div class="col-12 text-center mt-3">
            <button class="btn btn-light btn-sm px-4" @onclick="LoadMore" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="fa fa-chevron-down me-1"></i>Daha Fazla Göster
                <span class="badge bg-light text-dark ms-1">+@(Math.Min(PAGE_SIZE, _Users.Count - _visibleCount))</span>
            </button>
        </div>
    }
}

@code {

    private const string PAGE = "DataManager";
    private const int PAGE_SIZE = 12;

    [Parameter] public Users? use { get; set; }
    [Parameter] public string? SearchWantedText { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _isInitialized;
    private bool _isLoading;
    private CancellationTokenSource? _searchCts;
    private bool _isProcessing;

    private int _visibleCount = PAGE_SIZE;

    private List<Users> _Users { get; set; } = new();
    private List<FriendShip>? _FriendShip { get; set; } = new();

    private Notification? notificationRef;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (_disposed || _isInitialized) return;
        _isInitialized = true;
        StateHub.OnDataChanged += HandleGlobalDataChange;
        await LoadData(null);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isInitialized) return;
        _visibleCount = PAGE_SIZE; // filtre değişince sıfırla
        await LoadData(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        StateHub.OnDataChanged -= HandleGlobalDataChange;
        await _cts.CancelAsync();
        _cts.Dispose();
        GC.SuppressFinalize(this);
    }

    // ── Global broadcast handler ───────────────────────────────────────────────

    private async Task HandleGlobalDataChange(string entityName)
    {
        if (_disposed || !_isInitialized || _isProcessing) return;
        if (entityName != "Wanted" && entityName != "FriendShip") return;

        await InvokeAsync(async () =>
        {
            await LoadData(null);
            StateHasChanged();
        });
    }

    // ── Sayfalama ─────────────────────────────────────────────────────────────

    private void LoadMore()
    {
        _visibleCount += PAGE_SIZE;
        StateHasChanged();
    }

    // ── FriendShip işlemleri ──────────────────────────────────────────────────

    private async Task AddFriendShip(Guid targetUserId)
    {
        if (_disposed || !_isInitialized || _isProcessing || use is null) return;

        try
        {
            _isProcessing = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            var existing = await db.FriendShip
                .FirstOrDefaultAsync(x =>
                    x.RequestorId == use.Id &&
                    x.ReceiverId == targetUserId &&
                    x.IsDeleted!.IsDeletedStatu != true);

            if (existing is not null)
            {
                await ShowNotification("warning", "Zaten Gönderildi", "Bu kullanıcıya zaten istek gönderilmiş.", null);
                return;
            }

            var newFs = new FriendShip
            {
                Id = Guid.NewGuid(),
                RequestorId = use.Id,
                ReceiverId = targetUserId,
                Status = null,
                Block = null,
                CreatedAt = DateTime.UtcNow,
                ActionDate = null
            };

            db.FriendShip.Add(newFs);
            await db.SaveChangesAsync();

            StateHub.ClearCache($"data_Users_{SearchWantedText}");
            await StateHub.NotifyDataChanged("FriendShip");

            _FriendShip ??= new List<FriendShip>();
            _FriendShip.RemoveAll(x => x.RequestorId == use.Id && x.ReceiverId == targetUserId);
            _FriendShip.Add(newFs);

            StateHasChanged();
            await ShowNotification("success", "Gönderildi", "Arkadaşlık isteği gönderildi.", null);
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "AddFriendShip", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "İstek gönderilirken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task CancelFriendShip(Guid friendShipId)
    {
        if (_disposed || !_isInitialized || _isProcessing || use is null) return;

        try
        {
            _isProcessing = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            var fs = await db.FriendShip
                .FirstOrDefaultAsync(x =>
                    x.Id == friendShipId &&
                    x.RequestorId == use.Id);

            if (fs is null)
            {
                await ShowNotification("warning", "Bulunamadı", "İptal edilecek bir istek bulunamadı.", null);
                return;
            }

            fs.IsDeleted ??= new data._Shared.IsDeleted();
            fs.IsDeleted.IsDeletedStatu = true;
            fs.IsDeleted.DeletedAtDate = DateTime.UtcNow;

            await db.SaveChangesAsync();

            StateHub.ClearCache($"data_Users_{SearchWantedText}");
            await StateHub.NotifyDataChanged("FriendShip");

            var local = _FriendShip?.FirstOrDefault(x => x.Id == friendShipId);
            if (local is not null)
            {
                local.IsDeleted ??= new data._Shared.IsDeleted();
                local.IsDeleted.IsDeletedStatu = true;
                local.IsDeleted.DeletedAtDate = DateTime.UtcNow;
            }

            StateHasChanged();
            await ShowNotification("success", "Kaldırıldı", "Arkadaşlık isteği kaldırıldı.", null);
        }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "CancelFriendShip", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "İstek kaldırılırken bir sorun oluştu.", null);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    // ── Veri yükleme ──────────────────────────────────────────────────────────

    protected virtual async Task LoadData(string? search)
    {
        if (use is null) return;

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            if (!string.IsNullOrWhiteSpace(search))
                await Task.Delay(400, token); // debounce

            if (_isLoading) return;
            _isLoading = true;
            StateHasChanged();

            // SearchWantedText'e göre ayrı cache key — farklı aramalar çakışmasın
            var cacheKey = $"data_Users_{SearchWantedText ?? "all"}";

            var result = await StateHub.GetOrLoadAsync(cacheKey, async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync(token);

                var query_User = db.Users
                    .AsNoTracking()
                    .Where(u => u.IsActive == true && u.Id != use.Id);

                var query_FriendShip = db.FriendShip
                    .AsNoTracking()
                    .Where(u => u.IsDeleted!.IsDeletedStatu != true);

                // SearchWantedText filtresi — null-safe
                if (!string.IsNullOrWhiteSpace(SearchWantedText))
                {
                    var sw = SearchWantedText;
                    query_User = query_User.Where(u =>
                        u.FirstName.Contains(sw) ||
                        u.LastName.Contains(sw));
                }

                // Anlık arama filtresi (ileride kullanılabilir)
                if (!string.IsNullOrWhiteSpace(search))
                {
                    var s = search;
                    query_User = query_User.Where(u =>
                        u.FirstName.Contains(s) ||
                        u.LastName.Contains(s));
                }

                var users = await query_User
                    .OrderByDescending(u => u.RegistrationDate)
                    .ToListAsync(token);

                var friendShip = await query_FriendShip.ToListAsync(token);

                return new { Users = users, FriendShip = friendShip };

            }, token);

            if (result != null && !token.IsCancellationRequested)
            {
                _Users = result.Users;
                _FriendShip = result.FriendShip;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            await Logger.TakeIt(use?.Id, PAGE, "LoadData", exception: ex.Message, stackTrace: ex.StackTrace);
            await ShowNotification("danger", "Hata", "Veriler yüklenirken bir sorun oluştu.", null);
        }
        finally
        {
            if (token == _searchCts?.Token)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    // ── Yardımcı ──────────────────────────────────────────────────────────────

    private async Task ShowNotification(string type, string title, string text, string? image)
    {
        if (notificationRef is null) return;
        var imageUrl = string.IsNullOrWhiteSpace(image) ? "https://picsum.photos/120?" : image;
        await notificationRef.Launch(type, title, text, imageUrl);
    }
}