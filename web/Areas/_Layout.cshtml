                                    data-bs-toggle="collapse" data-bs-target="#@col.Id"
                                    aria-expanded="false" aria-controls="@col.Id">
                                <span><i class="fa @col.Icon text-light me-2" aria-hidden="true"></i>@col.Title</span>
                                <i class="fa fa-angle-down" aria-hidden="true"></i>
                            </button>
                            
                            @* Masaüstü Sütun Başlığı *@
                            <div class="d-none d-lg-block fw-semibold text-white mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                                <i class="fa @col.Icon text-light me-2" aria-hidden="true"></i>@col.Title
                            </div>

                            @* Link Listesi *@
                            <div class="collapse d-lg-block" id="@col.Id">
                                <ul class="list-unstyled small mb-0 pt-2 pt-lg-0 d-flex flex-column gap-2">
                                    @foreach (var link in col.Links)
                                    {
                                        <li>
                                            <a class="link-light link-opacity-75-hover text-decoration-none d-inline-block py-1" href="@link.Url">@link.Text</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

