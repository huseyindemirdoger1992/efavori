@using System.Security.Claims
@using data
@using System.Text.Encodings.Web
@using web.wwwroot
@using Microsoft.EntityFrameworkCore
@using System.Web
@using System.Text.Json;
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    // --- 1. DEĞİŞKEN BAŞLATMA (VARSAYILANLAR) ---
    string BackgroundImage = "/assets/images/bg-themes/1.png";
    string lang = "en";
    string TotalLang = "en_EN";
    string currentFooterText = "All rights reserved.";
    Users? use = null;
    var userEmail = User.FindFirstValue(ClaimTypes.Email);
    // --- 2. VERİ ÇEKME VE İŞLEME ---
    if (!string.IsNullOrEmpty(userEmail))
    {
        try
        {
            // Context kullanımı 'using' ile garanti altına alınmalı
            using (var db = new _ApplicationConnectionDb())
            {
                // Task'ı await ederek thread'i bloklamıyoruz
                use = await db.Users
                    .AsNoTracking() // Sadece okuma yaptığımız için performans artışı sağlar
                    .FirstOrDefaultAsync(u => u.ContactInformation.Email == userEmail);
                if (use != null)
                {
                    if (!string.IsNullOrEmpty(use.BackgroundImagePath))
                        BackgroundImage = use.BackgroundImagePath;
                    if (!string.IsNullOrEmpty(use.Language))
                    {
                        lang = use.Language.ToLower();
                        TotalLang = $"{lang}_{lang.ToUpper()}";
                    }
                    // --- BAŞARILI İŞLEM LOGU (Seçici Yaklaşım) ---
                    // Not: Her sayfa yüklemesinde log yerine, sadece önemli durumlarda log tutabilirsiniz
                    // Örnek: Session kontrolü ile günde 1 kez veya belirli sayfalarda
                    try
                    {
                        using (var dbLog = new _ApplicationConnectionDb())
                        {
                            var successLog = new Logs
                            {
                                Id = Guid.NewGuid(),
                                Title = "Layout Loaded Successfully",
                                Action = "FetchUserData_Success",
                                UserId = use.Id,
                                Exception = null, // Başarılı durumda exception yok
                                StackTrace = null,
                                Date = DateTime.UtcNow,
                                IpAddress = Context.Connection.RemoteIpAddress?.ToString() ?? "Unknown",
                                UserAgent = Context.Request.Headers["User-Agent"].ToString() ?? "Unknown",
                                RequestPath = Context.Request.Path,
                                Languages = Context.Request.Headers["Accept-Language"].ToString(),
                            };
                            await dbLog.Logs.AddAsync(successLog);
                            await dbLog.SaveChangesAsync();
                        }
                    }
                    catch
                    {
                        // Log kaydı başarısız olsa bile kullanıcı deneyimini etkilemesin
                    }
                }
                else
                {
                    // Örnek Guid listesi
                    List<Guid> guidList = new List<Guid> { Guid.NewGuid(), Guid.NewGuid() };
                    // Listeyi string'e çeviriyoruz
                    string jsonList = JsonSerializer.Serialize(guidList);
                    var cookieOptions = new CookieOptions
                    {
                        Expires = DateTimeOffset.UtcNow.AddDays(7), // Liste uzunsa süreyi çok uzun tutmamak iyidir
                        HttpOnly = true,
                        Secure = true,
                        SameSite = SameSiteMode.Lax,
                        Path = "/"
                    };
                    Context.Response.Cookies.Append("CardIds", jsonList, cookieOptions);
                    Context.Response.Cookies.Append("UserSettings", "", cookieOptions);
                }
            }
            // Sözlük tanımı (Dinamikleştirilebilir veya Cache'e alınabilir)
            var footerTexts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                { "az", "Bütün hüquqlar qorunur." },
                { "de", "Alle Rechte vorbehalten." },
                { "en", "All rights reserved." },
                { "es", "Todos los derechos reservados." },
                { "fr", "Tous droits réservés." },
                { "hi", "सर्वाधिकार सुरक्षित।" },
                { "pt", "Todos os direitos reservados." },
                { "ru", "Все права защищены." },
                { "tr", "Tüm hakları saklıdır." },
                { "zh", "版权所有。" }
            };
            currentFooterText = footerTexts.GetValueOrDefault(lang, footerTexts["en"]);
        }
        catch (Exception ex)
        {
            // --- 3. HATA YÖNETİMİ VE LOGLAMA (SİSTEMİ YAVAŞLATMADAN) ---
            try
            {
                using (var dbLog = new _ApplicationConnectionDb())
                {
                    var errorLog = new Logs
                    {
                        Id = Guid.NewGuid(),
                        Title = "Layout Data Error",
                        Action = "FetchUserData_Error",
                        UserId = use?.Id ?? Guid.Empty,
                        Exception = ex.Message,
                        StackTrace = ex.StackTrace,
                        Date = DateTime.UtcNow, // Global standart UTC'dir
                        IpAddress = Context.Connection.RemoteIpAddress?.ToString() ?? "Unknown",
                        UserAgent = Context.Request.Headers["User-Agent"].ToString() ?? "Unknown",
                        RequestPath = Context.Request.Path,
                        Languages = Context.Request.Headers["Accept-Language"].ToString(),
                    };
                    await dbLog.Logs.AddAsync(errorLog);
                    await dbLog.SaveChangesAsync();
                }
            }
            catch
            {
                // Veritabanı bile çökmüşse, kullanıcıya beyaz ekran göstermemek için sessiz kalıyoruz.
            }
        }
    }
}
<!doctype html>
<html lang="@lang">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    @* --- 1. Basic SEO and Authority --- *@
    <title>@ViewData["Title"] | efavori.com</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Manage your favorite content securely with efavori.com.")">
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "efavori, digital management, content planning")">
    <meta name="author" content="efavori.com">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <link rel="canonical" href="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    @* Multi-language support (lang variable defined above) *@
    <link rel="alternate" hreflang="@lang" href="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    <link rel="alternate" hreflang="x-default" href="@(Context.Request.Scheme + "://" + Context.Request.Host)/" />
    @* --- 2. Social Media (Open Graph & Twitter) --- *@
    <meta property="og:locale" content="@TotalLang">
    <meta property="og:type" content="website">
    <meta property="og:title" content="@ViewData["Title"] | efavori.com">
    <meta property="og:description" content="@(ViewData["Description"] ?? "Manage your favorite content securely with efavori.com.")">
    <meta property="og:url" content="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)">
    <meta property="og:site_name" content="efavori.com">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@ViewData["Title"]">
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "efavori.com content management.")">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://www.google-analytics.com">
    <link rel="icon" href="~/assets/images/favicon/32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/assets/images/favicon/180x180.png">
    <meta name="theme-color" content="#0000FF">
    @(await Html.RenderComponentAsync<Css>(RenderMode.Static))
</head>

<body class="bg-theme bg-theme1">
    <div class="wrapper">
        @(await Html.RenderComponentAsync<razor._Shared.tr.Sidebar.SideBarMenu>(RenderMode.Static, new { _use = use != null ? use : null }))
        @(await Html.RenderComponentAsync<razor._Shared.tr.Header.HeaderMenu>(RenderMode.Static, new { _use = use != null ? use : null }))
        <div class="page-wrapper">
            <div class="page-content">
                @RenderBody()
            </div>
        </div>
        <div class="overlay toggle-icon"></div>
        <a href="javaScript:;" class="back-to-top"><i class='bx bxs-up-arrow-alt'></i></a>
        <footer class="page-footer">
            <p class="mb-0">efavori.com © @DateTime.Now.Year. @currentFooterText</p>
        </footer>
    </div>
    @(await Html.RenderComponentAsync<razor._Shared.tr.Modals.LoginModals>(RenderMode.Static))
    @(await Html.RenderComponentAsync<Js>(RenderMode.Static))
    <base href="~/" />
    <script src="~/_framework/blazor.server.js"></script>
</body>
</html>