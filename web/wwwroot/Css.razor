<style>
    /* Radio butonunu gizle */
    .theme-picker input[type="radio"] {
        display: none;
    }

    /* Görsel kapsayıcısı */
    .theme-img-wrapper {
        position: relative;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        /* Görselin kendisi */
        .theme-img-wrapper img {
            width: 100%;
            height: auto;
            border-radius: 12px;
            border: 4px solid transparent;
            transition: all 0.3s ease;
        }

        /* Üzerine gelince hafif büyüme */
        .theme-img-wrapper:hover {
            transform: translateY(-3px);
        }

    /* SEÇİLİ DURUM: Görseli vurgula */
    .theme-picker input[type="radio"]:checked + .theme-img-wrapper img {
        border-color: #0d6efd; /* Sadece border ile seçim belirt */
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
    }

    /* Seçili Onay İkonu (Saf CSS) */
    .theme-picker input[type="radio"]:checked + .theme-img-wrapper::after {
        content: '✓';
        position: absolute;
        top: 10px;
        right: 15px;
        background: #0d6efd;
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
</style>


<style>
    /* Ana kart yapısı için varsayılan hafif gölge */
    .hover-actions {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: 0 2px 5px rgba(0,0,0,0.08); /* Hafif başlangıç gölgesi */
        border: 1px solid rgba(0,0,0,0.05); /* Çok ince bir kenarlık gölgeyi belirginleştirir */
    }

        /* Üzerine gelindiğinde (Hover) gölge derinleşir */
        .hover-actions:hover {
            transform: translateY(-8px); /* Biraz daha fazla yükselme */
            /* Katmanlı gölge efekti (daha gerçekçi durur) */
            box-shadow: 0 15px 30px rgba(0,0,0,0.12), 0 5px 15px rgba(0,0,0,0.06) !important;
        }

    /* Arka plan bulanıklığı ve koyuluğu */
    .backdrop-blur {
        backdrop-filter: blur(8px); /* Bulanıklık artırıldı */
        background: rgba(0,0,0,0.4);
        box-shadow: inset 0 0 10px rgba(0,0,0,0.1); /* İç gölge ile derinlik */
    }

    /* Koyu paneller için gölge (Örn: Resim üzerindeki yazı alanı) */
    .bg-dark-60 {
        background: rgba(0,0,0,0.65) !important;
        color: white;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.5); /* Yazıya da hafif gölge */
        box-shadow: 0 -4px 10px rgba(0,0,0,0.2); /* Panelin kendisine üstten gölge */
    }
</style>


<style>
    /* Tüm Card yapıları için dinamik hover efekti */
    .card, .glass-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); /* Yumuşak geçiş eğrisi */
        will-change: transform, box-shadow; /* Tarayıcı optimizasyonu */
    }

        .card:hover, .glass-card:hover {
            /* Hafif yukarı yükselme efekti */
            transform: translateY(-5px);
            /* Bootstrap gölge değişkeni ile cam efektini destekleyen derinlik */
            box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.175) !important;
            /* Eğer cam efekti kullanılıyorsa kenarlık parlaklığını artır */
            border-color: rgba(255, 255, 255, 0.3) !important;
        }

        /* Tıklama anında hafif basılma hissi (Opsiyonel) */
        .card:active, .glass-card:active {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
        }
</style>