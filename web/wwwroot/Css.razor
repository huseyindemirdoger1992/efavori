@* Tıklanan ve işlemde olan butonun efekt yapısı *@
<style>
    .btn.colored {
        position: relative;
        overflow: hidden;
        cursor: wait;
        background-size: 200% 100% !important;
        background-image: linear-gradient( to right, rgba(252, 186, 3, 0.1) 10%, rgba(233, 30, 99, 0.1) 20%, rgba(52, 152, 219, 0.1) 30%, rgba(177, 3, 252, 0.1) 40%, rgba(3, 252, 65, 0.1) 100% ) !important;
        animation: loading-shimmer 3s infinite linear;
    }

    @@keyframes loading-shimmer {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }
</style>

@* Tüm metinlerde 1px beyaz/siyah "black-line"|"white-line" kaplama *@
<style>
    /**
     * TEXT CONTOUR CSS (Class Based - 1px %50 Opacity)
     * ---------------------------------------------------------
     */

    /* 1. SİYAH KONTUR: .black-line sınıfına sahip olanlar */
    .black-line {
        /* %50 opaklıkta siyah (0,0,0,0.5) */
        --line-color: rgba(0, 0, 0, 0.5);
        text-shadow: 1px 1px 0 var(--line-color), -1px 1px 0 var(--line-color), 1px -1px 0 var(--line-color), -1px -1px 0 var(--line-color), 0px 1px 0 var(--line-color), 0px -1px 0 var(--line-color), 1px 0px 0 var(--line-color), -1px 0px 0 var(--line-color) !important;
    }

    /* 2. BEYAZ KONTUR: .white-line sınıfına sahip olanlar */
    .white-line {
        /* %50 opaklıkta beyaz (255,255,255,0.5) */
        --line-color: rgba(255, 255, 255, 0.5);
        text-shadow: 1px 1px 0 var(--line-color), -1px 1px 0 var(--line-color), 1px -1px 0 var(--line-color), -1px -1px 0 var(--line-color), 0px 1px 0 var(--line-color), 0px -1px 0 var(--line-color), 1px 0px 0 var(--line-color), -1px 0px 0 var(--line-color) !important;
    }

        /* 3. İÇ İÇE ELEMENT KORUMASI:
       Sınıfın içindeki tüm alt elementlerin gölgeyi miras almasını sağlar.
       Böylece 10 katman olsa bile kontur kalınlaşmaz.
    */
        .black-line *, .white-line * {
            text-shadow: inherit !important;
        }

        /* 4. FORM ELEMANLARI KORUMASI:
       Input ve butonlar bu sınıfların içinde olsa dahi gölge almazlar.
    */
        .black-line input, .black-line textarea, .black-line button, .black-line select,
        .white-line input, .white-line textarea, .white-line button, .white-line select {
            text-shadow: none !important;
        }

    /* 5. SEÇİM KORUMASI:
       Sadece ilgili class içindeki metin seçildiğinde kontur devam eder.
    */
    .black-line::selection, .black-line *::selection {
        text-shadow: inherit !important;
    }

    .white-line::selection, .white-line *::selection {
        text-shadow: inherit !important;
    }</style>