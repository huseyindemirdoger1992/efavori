@*Şifre Göster/Gizle*@
<script>
        document.addEventListener('DOMContentLoaded', function () {
        var toggle = document.querySelector('#show_hide_password .input-group-text');
        var input = document.querySelector('#inputChoosePassword');
        var icon = toggle.querySelector('i');

        toggle.addEventListener('click', function () {
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bx-hide');
                icon.classList.add('bx-show');
            } else {
                input.type = 'password';
                icon.classList.remove('bx-show');
                icon.classList.add('bx-hide');
            }
        });
    });
</script>

@* Oturum açma işlemini güvenli hale getirir *@
<script>
        window.submitLoginForm = (path, email, password) => {
        const form = document.createElement('form');
        form.method = 'post';
        form.action = path;

        const emailField = document.createElement('input');
        emailField.type = 'hidden';
        emailField.name = 'Email';
        emailField.value = email;
        form.appendChild(emailField);

        const passwordField = document.createElement('input');
        passwordField.type = 'hidden';
        passwordField.name = 'Password';
        passwordField.value = password;
        form.appendChild(passwordField);

        document.body.appendChild(form);
        form.submit();
    };
</script>

@* Görevler sayfasında başlangıç ile bitiş arasındaki zamanlayıcıyı günceller *@
<script>
    function updateTimers() {
        // Tüm timer elementlerini seç
        const timerElements = document.querySelectorAll('[data-start][data-target]');

        timerElements.forEach(timer => {
            const startStr = timer.getAttribute('data-start');
            const targetStr = timer.getAttribute('data-target');

            const startDate = new Date(startStr).getTime();
            const targetDate = new Date(targetStr).getTime();
            const now = new Date().getTime();

            const totalDuration = targetDate - startDate;
            const elapsed = now - startDate;
            const distance = targetDate - now;

            // Progress bar'ı ID üzerinden değil, timer'ın yanındaki/içindeki class üzerinden bul
            // Bu örnekte timer'ın bir üst kapsayıcısında progress bar arıyoruz
            const container = timer.parentElement;
            const progressBar = container.querySelector('.progress-bar');

            if (progressBar) {
                if (distance < 0) {
                    progressBar.style.width = '100%';
                    progressBar.classList.remove('bg-warning');
                    progressBar.classList.add('bg-dark');
                } else {
                    const progressPercent = Math.max(0, Math.min((elapsed / totalDuration) * 100, 100));
                    progressBar.style.width = progressPercent + '%';
                    progressBar.classList.remove('bg-dark');
                    progressBar.classList.add('bg-warning');
                }
            }

            // Yazı güncelleme
            if (distance < 0) {
                timer.innerHTML = "Süre Doldu";
                timer.classList.remove('text-dark');
                timer.classList.add('text-dark');
            } else {
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                timer.innerHTML = `${days}g ${hours}s ${minutes}d ${seconds}sn`;
            }
        });
    }

    setInterval(updateTimers, 1000);
    updateTimers();
</script>

@* Sidebar Arama Alanı *@
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.querySelector('.sidebar-wrapper input[type="text"]');
        const menuItems = document.querySelectorAll('#menu > li');

        // Özyinelemeli arama fonksiyonu
        function searchInMenuItem(element, searchTerm) {
            // Input içeren li'yi atla
            if (element.querySelector('input[type="text"]')) {
                return { hasMatch: false, visibleCount: 0 };
            }

            let hasMatch = false;
            let visibleCount = 0;

            // Ana menü başlığını kontrol et
            const menuTitle = element.querySelector(':scope > a > .menu-title');
            const menuText = element.querySelector(':scope > a');

            if (menuTitle && menuTitle.textContent.toLowerCase().includes(searchTerm)) {
                hasMatch = true;
            } else if (menuText && menuText.textContent.toLowerCase().includes(searchTerm)) {
                hasMatch = true;
            }

            // Alt menü varsa kontrol et
            const subMenu = element.querySelector(':scope > ul');
            if (subMenu) {
                const subItems = subMenu.querySelectorAll(':scope > li');

                subItems.forEach(function(subItem) {
                    // Alt öğeyi özyinelemeli olarak ara
                    const subResult = searchInMenuItem(subItem, searchTerm);

                    if (subResult.hasMatch) {
                        hasMatch = true;
                        subItem.style.display = '';
                        visibleCount++;

                        // Alt menüsü varsa aç
                        const subSubMenu = subItem.querySelector(':scope > ul');
                        if (subSubMenu) {
                            subItem.classList.add('mm-active');
                            subSubMenu.style.display = 'block';
                        }
                    } else {
                        subItem.style.display = 'none';
                    }
                });
            }

            return { hasMatch: hasMatch, visibleCount: visibleCount };
        }

        // Menüyü sıfırlama fonksiyonu
        function resetMenu(element) {
            element.style.display = '';
            element.classList.remove('mm-active');

            const subMenu = element.querySelector(':scope > ul');
            if (subMenu) {
                subMenu.style.display = '';
                const subItems = subMenu.querySelectorAll(':scope > li');
                subItems.forEach(function(subItem) {
                    resetMenu(subItem);
                });
            }
        }

        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase().trim();

            menuItems.forEach(function(menuItem) {
                // Arama inputunu içeren li'yi atla
                if (menuItem.querySelector('input[type="text"]')) {
                    return;
                }

                // Arama terimi boşsa tüm menüyü sıfırla
                if (searchTerm === '') {
                    resetMenu(menuItem);
                    return;
                }

                // Ana menü başlığını kontrol et
                const menuTitle = menuItem.querySelector('.menu-title');
                let showAllSubs = false;

                if (menuTitle && menuTitle.textContent.toLowerCase().includes(searchTerm)) {
                    showAllSubs = true;
                }

                if (showAllSubs) {
                    // Ana menü eşleşirse tüm alt öğeleri göster
                    menuItem.style.display = '';
                    const allSubItems = menuItem.querySelectorAll('li');
                    allSubItems.forEach(function(subItem) {
                        subItem.style.display = '';
                    });

                    const subMenu = menuItem.querySelector(':scope > ul');
                    if (subMenu) {
                        menuItem.classList.add('mm-active');
                        subMenu.style.display = 'block';

                        // Tüm alt menüleri de aç
                        const nestedMenus = subMenu.querySelectorAll('li.has-arrow');
                        nestedMenus.forEach(function(nested) {
                            nested.classList.add('mm-active');
                            const nestedUl = nested.querySelector('ul');
                            if (nestedUl) {
                                nestedUl.style.display = 'block';
                            }
                        });
                    }
                } else {
                    // Özyinelemeli arama yap
                    const result = searchInMenuItem(menuItem, searchTerm);

                    if (result.hasMatch) {
                        menuItem.style.display = '';
                        const subMenu = menuItem.querySelector(':scope > ul');
                        if (subMenu) {
                            menuItem.classList.add('mm-active');
                            subMenu.style.display = 'block';
                        }
                    } else {
                        menuItem.style.display = 'none';
                    }
                }
            });
        });
    });
</script>


@* Tüm seçenekler için (Select Option) aram çubuğu *@
<script>
    function initializeSearchableSelect() {
        document.querySelectorAll('select.form-select').forEach(select => {
            if (select.nextElementSibling?.classList.contains('custom-select-container')) return;

            const container = document.createElement('div');
            container.className = 'dropdown custom-select-container';

            const button = document.createElement('div');
            button.className = 'form-select bg-light cursor-pointer fa-select';
            button.innerHTML = select.options[select.selectedIndex]?.text || 'Seçiniz';

            const menu = document.createElement('div');
            menu.className = 'dropdown-menu w-100 shadow p-0';
            menu.style.maxHeight = '250px';
            menu.style.overflowY = 'auto';

            // Revize 1: Sticky Search (Arka plan beyaz, ikonlar arkada kalır)
            const searchDiv = document.createElement('div');
            searchDiv.style = "position:sticky; top:0; z-index:10; background:light; padding:5px; border-bottom:1px solid #ddd;";

            const searchInput = document.createElement('input');
            searchInput.type = 'text';
            searchInput.placeholder = 'Ara...';
            searchInput.className = 'form-control form-control-sm';
            searchDiv.appendChild(searchInput);
            menu.appendChild(searchDiv);

            const listContainer = document.createElement('div');
            menu.appendChild(listContainer);

            const updateOptions = (filter = '') => {
                listContainer.innerHTML = '';
                Array.from(select.options).forEach(opt => {
                    if (opt.text.toLowerCase().includes(filter.toLowerCase())) {
                        const item = document.createElement('div');
                        item.className = 'dropdown-item py-2 cursor-pointer fa-select';
                        item.innerHTML = opt.text;

                        item.onclick = () => {
                            select.value = opt.value;
                            button.innerHTML = opt.text;
                            // Revize 2: Seçim yapıldığında aramayı temizle
                            searchInput.value = '';
                            menu.classList.remove('show');
                            select.dispatchEvent(new Event('change', { bubbles: true }));
                        };
                        listContainer.appendChild(item);
                    }
                });
            };

            button.onclick = (e) => {
                e.stopPropagation();
                const isOpen = menu.classList.toggle('show');
                if(isOpen) {
                    updateOptions();
                    setTimeout(() => searchInput.focus(), 50);
                }
            };

            searchInput.onclick = (e) => e.stopPropagation();
            searchInput.oninput = (e) => updateOptions(e.target.value);
            document.addEventListener('click', () => menu.classList.remove('show'));

            container.appendChild(button);
            container.appendChild(menu);

            // Revize 3: Gereksiz tüm görsel kodlar atıldı, sadece temel işlev kaldı.
            select.style.display = 'none';
            select.parentNode.insertBefore(container, select);
        });
    }

    // Blazor render süreci için ideal bekleme
    setTimeout(initializeSearchableSelect, 500);
</script>

@* Modal tam ekran yapma veya küçültme *@
<script>
    function toggleModalFullscreen(button) {
        const modalDialog = button.closest('.modal-dialog');
        const icon = button.querySelector('i');

        // Modern geçiş efekti için stil enjekte et
        modalDialog.style.transition = "all 0.35s cubic-bezier(0.25, 1, 0.5, 1)";

        if (modalDialog.classList.contains('modal-lg')) {
            // Tam ekrana geçiş
            modalDialog.classList.remove('modal-lg');
            modalDialog.classList.add('modal-fullscreen');

            // Yumuşak ikon değişimi efekti
            icon.style.transform = "scale(0.8)";
            setTimeout(() => {
                icon.classList.replace('fa-expand', 'fa-compress');
                icon.style.transform = "scale(1)";
            }, 150);

        } else {
            // Eski haline dönüş
            modalDialog.classList.remove('modal-fullscreen');
            modalDialog.classList.add('modal-lg');

            // Yumuşak ikon değişimi efekti
            icon.style.transform = "scale(0.8)";
            setTimeout(() => {
                icon.classList.replace('fa-compress', 'fa-expand');
                icon.style.transform = "scale(1)";
            }, 150);
        }
    }
</script>

@* Sayfa geçiş Egekti *@
<script>
    // 1. SAYFAYA GİRİŞ: Bulanıklıktan normale geçiş
    window.addEventListener('load', function() {
        const overlay = document.getElementById('page-transition-overlay');
        if (overlay) {
            // Yarım saniye bekleyip efekti kaldıralım (daha yumuşak bir geçiş için)
            setTimeout(() => {
                overlay.classList.add('loaded');
            }, 100);
        }
    });

    // 2. SAYFADAN ÇIKIŞ: Normalden bulanıklığa geçiş (Link tıklama)
    document.addEventListener('click', function (e) {
        const link = e.target.closest('a');

        if (link) {
            const href = link.getAttribute('href');
            const target = link.getAttribute('target');

            if (href &&
                !href.startsWith('#') &&
                !href.startsWith('javascript:') &&
                link.hostname === window.location.hostname &&
                target !== '_blank') {

                const overlay = document.getElementById('page-transition-overlay');
                if (overlay) {
                    e.preventDefault();
                    const targetUrl = link.href;

                    // 'loaded' class'ını geri alarak bulanıklığı başlatıyoruz
                    overlay.classList.remove('loaded');

                    setTimeout(() => {
                        window.location.href = targetUrl;
                    }, 500);
                }
            }
        }
    });
</script>
