<script>
    // Sayfa yüklendiğinde butonu kontrol et (Event listener'ı güvenli bağla)
    document.addEventListener('DOMContentLoaded', function() {
        const submitBtn = document.querySelector('.BtnSubmit');
        const submitForm = document.querySelector('.FormSubmit');

        if(submitBtn && submitForm) {
            submitBtn.addEventListener('click', function () {
                if (submitForm.checkValidity()) {
                    this.innerHTML = '<i class="fa fa-spinner fa-spin"></i> İşlem Devam Ediyor...';
                    this.disabled = true;
                    submitForm.submit();
                } else {
                    submitForm.reportValidity();
                }
            });
        }
    });
</script>

<script>
    function handleFiles(input) {
        const files = input.files;
        const maxSize = 128 * 1024 * 1024; // 128 MB
        const listContainer = document.getElementById('selectedFilesList');

        if(!listContainer) return;
        listContainer.innerHTML = '';

        for (let i = 0; i < files.length; i++) {
            const file = files[i];

            if (file.size > maxSize) {
                alert(`Dosya boyutu 128 MB'ı geçemez: ${file.name}`);
                input.value = '';
                listContainer.innerHTML = '';
                return;
            }

            const rowDiv = document.createElement('div');
            rowDiv.className = 'd-flex align-items-start mb-3 border p-2 rounded';

            const img = document.createElement('img');
            img.src = URL.createObjectURL(file);
            img.style.width = '100px';
            img.style.height = '100px';
            img.style.objectFit = 'cover';
            img.className = 'me-3';
            rowDiv.appendChild(img);

            const infoDiv = document.createElement('div');
            infoDiv.style.flex = '1';

            const nameLabel = document.createElement('label');
            nameLabel.innerText = 'Orj. Dosya Adı: ' + file.name;
            infoDiv.appendChild(nameLabel);

            const sizeLabel = document.createElement('div');
            sizeLabel.innerText = 'Boyut: ' + (file.size / 1024).toFixed(2) + ' KB';
            sizeLabel.className = 'mb-1';
            infoDiv.appendChild(sizeLabel);

            const renameInput = document.createElement('input');
            renameInput.type = 'text';
            renameInput.name = 'ResimAdi_' + i;
            renameInput.value = file.name.split('.').slice(0, -1).join('.');
            renameInput.className = 'form-control mt-1';
            infoDiv.appendChild(renameInput);

            rowDiv.appendChild(infoDiv);
            listContainer.appendChild(rowDiv);
        }
    }
</script>







<script>
    window.TableManager = {
        init: function (languageCode) {
            var code = languageCode ? languageCode.toLowerCase() : 'en';

            var langMap = {
                'az': 'az-AZ', 'de': 'de-DE', 'en': 'en-GB', 'es': 'es-ES',
                'fr': 'fr-FR', 'hi': 'hi', 'pt': 'pt-PT', 'ru': 'ru',
                'tr': 'tr', 'zh': 'zh-HANS'
            };

            var langFile = langMap[code] || 'tr';
            var langUrl = '//cdn.datatables.net/plug-ins/1.13.6/i18n/' + langFile + '.json';

            // Mevcut tabloyu güvenli bir şekilde yok et
            if ($.fn.DataTable.isDataTable('#example2')) {
                $('#example2').DataTable().destroy();
                // .empty() komutunu SİLDİK (çünkü başlıkları yok eder)
            }

            // Tabloyu başlat
            var table = $('#example2').DataTable({
                "searching": true,
                "paging": true,
                "ordering": true,
                "info": true,
                "lengthChange": false,
                "dom": '<"row"<"col-md-6"B><"col-md-6"f>>rtip',
                "buttons": ['copy', 'excel', 'pdf', 'print'],
                "language": {
                    "url": langUrl
                },
                "retrieve": true // Tablonun yeniden başlatılabilir olmasını sağlar
            });

            // Butonları taşı
            table.buttons().container()
                .appendTo('#example2_wrapper .col-md-6:eq(0)');
        }
    };
</script>




