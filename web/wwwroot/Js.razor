<script>
    window.setLanguageAndRedirect = function (langCode, newUrl) {
        var cookieValue = 'c=' + langCode + '|uic=' + langCode;
        var expires = new Date();
        expires.setFullYear(expires.getFullYear() + 1);
        document.cookie = '.Efavori.Culture=' + cookieValue + ';expires=' + expires.toUTCString() + ';path=/;SameSite=Lax;Secure';
        window.location.href = newUrl;
    }
</script>

